{
  "map": "UndeadRE01_04",
  "title": "Silverpine Sprint",
  "locale": "enUS",
  "order_note": "Sorted by recording id: C (cinematics), M (in-engine cutscenes), T (gameplay transmissions); unit barks follow their trigger group. Interleaving of C/M/T is not confirmed.",
  "lines": [
    {
      "n": 1,
      "id": "A1M4-T010-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "All right, Garek. You'll be alone on the track, trying to beat the other drivers' times.",
      "string_id": 2608,
      "speaker_string_id": 2829,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T010-GLIX.ogg"
    },
    {
      "n": 2,
      "id": "A1M4-T020-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Listen to my instructions, keep your eyes on the road, and let's win this thing!",
      "string_id": 2609,
      "speaker_string_id": 2830,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T020-GLIX.ogg"
    },
    {
      "n": 3,
      "id": "A1M4-T030-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Easy on the throttle, now...",
      "string_id": 2430,
      "speaker_string_id": 2833,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T030-GLIX.ogg"
    },
    {
      "n": 4,
      "id": "A1M4-T040-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "I said easy!",
      "string_id": 2618,
      "speaker_string_id": 2831,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T040-GLIX.ogg"
    },
    {
      "n": 5,
      "id": "A1M4-T050-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Ready... Set... GO!",
      "string_id": 2613,
      "speaker_string_id": 2832,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T050-GLIX.ogg"
    },
    {
      "n": 6,
      "id": "A1M4-T060-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Garek, you're breaking the vehicle!",
      "string_id": 2510,
      "speaker_string_id": 2815,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T060-GLIX.ogg"
    },
    {
      "n": 7,
      "id": "A1M4-T070-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "You have to stay on the road!",
      "string_id": 2497,
      "speaker_string_id": 2816,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T070-GLIX.ogg"
    },
    {
      "n": 8,
      "id": "A1M4-T080-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Triple caution! Triple caution!",
      "string_id": 2588,
      "speaker_string_id": 2817,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T080-GLIX.ogg"
    },
    {
      "n": 9,
      "id": "A1M4-T090-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Concentrate, Garek! Please!",
      "string_id": 2585,
      "speaker_string_id": 2818,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T090-GLIX.ogg"
    },
    {
      "n": 10,
      "id": "A1M4-T100-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Garek! Listen to my calls!",
      "string_id": 2584,
      "speaker_string_id": 2819,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T100-GLIX.ogg"
    },
    {
      "n": 11,
      "id": "A1M4-T110-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Garek, Garek, what are you doing, man?!",
      "string_id": 2583,
      "speaker_string_id": 2820,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T110-GLIX.ogg"
    },
    {
      "n": 12,
      "id": "A1M4-T120-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Murlocs! Look out!",
      "string_id": 2582,
      "speaker_string_id": 2821,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T120-GLIX.ogg"
    },
    {
      "n": 13,
      "id": "A1M4-T130-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Abomination on the road!",
      "string_id": 2835,
      "speaker_string_id": 2834,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T130-GLIX.ogg"
    },
    {
      "n": 14,
      "id": "A1M4-T140-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Right, right!",
      "string_id": 2581,
      "speaker_string_id": 2822,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T140-GLIX.ogg"
    },
    {
      "n": 15,
      "id": "A1M4-T150-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Right turn ahead!",
      "string_id": 2580,
      "speaker_string_id": 2823,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T150-GLIX.ogg"
    },
    {
      "n": 16,
      "id": "A1M4-T160-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Turn right, Garek!",
      "string_id": 2579,
      "speaker_string_id": 2824,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T160-GLIX.ogg"
    },
    {
      "n": 17,
      "id": "A1M4-T170-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Left, left!",
      "string_id": 2578,
      "speaker_string_id": 2825,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T170-GLIX.ogg"
    },
    {
      "n": 18,
      "id": "A1M4-T180-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Left turn coming up!",
      "string_id": 2577,
      "speaker_string_id": 2826,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T180-GLIX.ogg"
    },
    {
      "n": 19,
      "id": "A1M4-T190-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "To the left, Garek!",
      "string_id": 2576,
      "speaker_string_id": 2827,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T190-GLIX.ogg"
    },
    {
      "n": 20,
      "id": "A1M4-T200-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Home stretch! Into the finish, Garek!",
      "string_id": 2605,
      "speaker_string_id": 2828,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T200-GLIX.ogg"
    },
    {
      "n": 21,
      "id": "A1M4-T210-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "We won?! We won! Never doubted you for a second!",
      "string_id": 2836,
      "speaker_string_id": 2837,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T210-GLIX.ogg"
    },
    {
      "n": 22,
      "id": "A1M4-T220-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Not bad for an amateur. I guess.",
      "string_id": 2838,
      "speaker_string_id": 2839,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T220-GLIX.ogg"
    },
    {
      "n": 23,
      "id": "A1M4-T230-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Well... any race you can walk away from, yeah?",
      "string_id": 2840,
      "speaker_string_id": 2841,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T230-GLIX.ogg"
    }
  ]
}