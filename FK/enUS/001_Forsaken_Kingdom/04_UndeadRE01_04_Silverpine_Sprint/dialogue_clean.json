{
  "map": "UndeadRE01",
  "title": "Silverpine Sprint",
  "locale": "enUS",
  "note": "Blizzard's order from conversation.json (trigger groups as listed, lines by conversationOrder).",
  "lines": [
    {
      "speaker": "Glix",
      "text": "All right, Garek. You'll be alone on the track, trying to beat the other drivers' times.",
      "metadata": {
        "string_id": 2608,
        "speaker_string_id": 2829,
        "dialogue_id": "A1M4-T010-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Listen to my instructions, keep your eyes on the road, and let's win this thing!",
      "metadata": {
        "string_id": 2609,
        "speaker_string_id": 2830,
        "dialogue_id": "A1M4-T020-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Easy on the throttle, now...",
      "metadata": {
        "string_id": 2430,
        "speaker_string_id": 2833,
        "dialogue_id": "A1M4-T030-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "I said easy!",
      "metadata": {
        "string_id": 2618,
        "speaker_string_id": 2831,
        "dialogue_id": "A1M4-T040-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Ready... Set... GO!",
      "metadata": {
        "string_id": 2613,
        "speaker_string_id": 2832,
        "dialogue_id": "A1M4-T050-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Garek, you're breaking the vehicle!",
      "metadata": {
        "string_id": 2510,
        "speaker_string_id": 2815,
        "dialogue_id": "A1M4-T060-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "You have to stay on the road!",
      "metadata": {
        "string_id": 2497,
        "speaker_string_id": 2816,
        "dialogue_id": "A1M4-T070-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Triple caution! Triple caution!",
      "metadata": {
        "string_id": 2588,
        "speaker_string_id": 2817,
        "dialogue_id": "A1M4-T080-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Concentrate, Garek! Please!",
      "metadata": {
        "string_id": 2585,
        "speaker_string_id": 2818,
        "dialogue_id": "A1M4-T090-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Garek! Listen to my calls!",
      "metadata": {
        "string_id": 2584,
        "speaker_string_id": 2819,
        "dialogue_id": "A1M4-T100-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Garek, Garek, what are you doing, man?!",
      "metadata": {
        "string_id": 2583,
        "speaker_string_id": 2820,
        "dialogue_id": "A1M4-T110-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Murlocs! Look out!",
      "metadata": {
        "string_id": 2582,
        "speaker_string_id": 2821,
        "dialogue_id": "A1M4-T120-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Abomination on the road!",
      "metadata": {
        "string_id": 2835,
        "speaker_string_id": 2834,
        "dialogue_id": "A1M4-T130-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Right, right!",
      "metadata": {
        "string_id": 2581,
        "speaker_string_id": 2822,
        "dialogue_id": "A1M4-T140-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Right turn ahead!",
      "metadata": {
        "string_id": 2580,
        "speaker_string_id": 2823,
        "dialogue_id": "A1M4-T150-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Turn right, Garek!",
      "metadata": {
        "string_id": 2579,
        "speaker_string_id": 2824,
        "dialogue_id": "A1M4-T160-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Left, left!",
      "metadata": {
        "string_id": 2578,
        "speaker_string_id": 2825,
        "dialogue_id": "A1M4-T170-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Left turn coming up!",
      "metadata": {
        "string_id": 2577,
        "speaker_string_id": 2826,
        "dialogue_id": "A1M4-T180-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "To the left, Garek!",
      "metadata": {
        "string_id": 2576,
        "speaker_string_id": 2827,
        "dialogue_id": "A1M4-T190-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Home stretch! Into the finish, Garek!",
      "metadata": {
        "string_id": 2605,
        "speaker_string_id": 2828,
        "dialogue_id": "A1M4-T200-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "We won?! We won! Never doubted you for a second!",
      "metadata": {
        "string_id": 2836,
        "speaker_string_id": 2837,
        "dialogue_id": "A1M4-T210-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Not bad for an amateur. I guess.",
      "metadata": {
        "string_id": 2838,
        "speaker_string_id": 2839,
        "dialogue_id": "A1M4-T220-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Well... any race you can walk away from, yeah?",
      "metadata": {
        "string_id": 2840,
        "speaker_string_id": 2841,
        "dialogue_id": "A1M4-T230-GLIX"
      }
    }
  ]
}