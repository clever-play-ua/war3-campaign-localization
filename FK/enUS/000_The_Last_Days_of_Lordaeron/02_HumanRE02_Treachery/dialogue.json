      "n": 101,
      "id": "HRE02-T670-RIVENDARE",
      "scene": "TRANSMISSIONS.The Final Order.Transmission Escape RivendareShout Q",
      "speaker": "Baron Rivendare",
      "text": "You cannot escape your fate. All of Lordaeron will fall to the Scourge!",
      "string_id": 2338,
      "speaker_string_id": 2401,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-T670-RIVENDARE.ogg"
