{
  "map": "UndeadRE01_04",
  "title": "Silverpine Sprint",
  "locale": "plPL",
  "order_note": "Sorted by recording id: C (cinematics), M (in-engine cutscenes), T (gameplay transmissions); unit barks follow their trigger group. Interleaving of C/M/T is not confirmed.",
  "lines": [
    {
      "n": 1,
      "id": "A1M4-T010-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "No dobra, Gareku. Ruszasz na tor sam i starasz się pobić wyniki innych.",
      "string_id": 2608,
      "speaker_string_id": 2829,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T010-GLIX.ogg"
    },
    {
      "n": 2,
      "id": "A1M4-T020-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Słuchaj moich instrukcji, trzymaj się drogi, a uda nam się to wygrać!",
      "string_id": 2609,
      "speaker_string_id": 2830,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T020-GLIX.ogg"
    },
    {
      "n": 3,
      "id": "A1M4-T030-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Teraz lekko dodaj gazu...",
      "string_id": 2430,
      "speaker_string_id": 2833,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T030-GLIX.ogg"
    },
    {
      "n": 4,
      "id": "A1M4-T040-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Spokojnie!",
      "string_id": 2618,
      "speaker_string_id": 2831,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T040-GLIX.ogg"
    },
    {
      "n": 5,
      "id": "A1M4-T050-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Na miejsca... gotowi... START!",
      "string_id": 2613,
      "speaker_string_id": 2832,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T050-GLIX.ogg"
    },
    {
      "n": 6,
      "id": "A1M4-T060-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Gareku, niszczysz pojazd!",
      "string_id": 2510,
      "speaker_string_id": 2815,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T060-GLIX.ogg"
    },
    {
      "n": 7,
      "id": "A1M4-T070-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Trzymaj się drogi!",
      "string_id": 2497,
      "speaker_string_id": 2816,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T070-GLIX.ogg"
    },
    {
      "n": 8,
      "id": "A1M4-T080-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Uważniej! Uważniej!",
      "string_id": 2588,
      "speaker_string_id": 2817,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T080-GLIX.ogg"
    },
    {
      "n": 9,
      "id": "A1M4-T090-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Skup się, Garek! Proszę!",
      "string_id": 2585,
      "speaker_string_id": 2818,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T090-GLIX.ogg"
    },
    {
      "n": 10,
      "id": "A1M4-T100-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Gareku! Słuchaj, co mówię!",
      "string_id": 2584,
      "speaker_string_id": 2819,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T100-GLIX.ogg"
    },
    {
      "n": 11,
      "id": "A1M4-T110-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Garek, co ty wyprawiasz?!",
      "string_id": 2583,
      "speaker_string_id": 2820,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T110-GLIX.ogg"
    },
    {
      "n": 12,
      "id": "A1M4-T120-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Uważaj! Murloki!",
      "string_id": 2582,
      "speaker_string_id": 2821,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T120-GLIX.ogg"
    },
    {
      "n": 13,
      "id": "A1M4-T130-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Bestia na drodze!",
      "string_id": 2835,
      "speaker_string_id": 2834,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T130-GLIX.ogg"
    },
    {
      "n": 14,
      "id": "A1M4-T140-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "W prawo!",
      "string_id": 2581,
      "speaker_string_id": 2822,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T140-GLIX.ogg"
    },
    {
      "n": 15,
      "id": "A1M4-T150-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Przed tobą zakręt w prawo!",
      "string_id": 2580,
      "speaker_string_id": 2823,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T150-GLIX.ogg"
    },
    {
      "n": 16,
      "id": "A1M4-T160-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "W prawo, Garek!",
      "string_id": 2579,
      "speaker_string_id": 2824,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T160-GLIX.ogg"
    },
    {
      "n": 17,
      "id": "A1M4-T170-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "W lewo!",
      "string_id": 2578,
      "speaker_string_id": 2825,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T170-GLIX.ogg"
    },
    {
      "n": 18,
      "id": "A1M4-T180-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Przed tobą zakręt w lewo!",
      "string_id": 2577,
      "speaker_string_id": 2826,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T180-GLIX.ogg"
    },
    {
      "n": 19,
      "id": "A1M4-T190-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "W lewo, Garek!",
      "string_id": 2576,
      "speaker_string_id": 2827,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T190-GLIX.ogg"
    },
    {
      "n": 20,
      "id": "A1M4-T200-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Ostatnia prosta! Oby do mety!",
      "string_id": 2605,
      "speaker_string_id": 2828,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T200-GLIX.ogg"
    },
    {
      "n": 21,
      "id": "A1M4-T210-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Wygraliśmy?! Wygraliśmy! Ani przez chwilę nie wątpiłem!",
      "string_id": 2836,
      "speaker_string_id": 2837,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T210-GLIX.ogg"
    },
    {
      "n": 22,
      "id": "A1M4-T220-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Nieźle jak na amatora. Tak myślę.",
      "string_id": 2838,
      "speaker_string_id": 2839,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T220-GLIX.ogg"
    },
    {
      "n": 23,
      "id": "A1M4-T230-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Cóż... każdy mecz jest udany, jeśli się go przeżyje, nie?",
      "string_id": 2840,
      "speaker_string_id": 2841,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T230-GLIX.ogg"
    }
  ]
}