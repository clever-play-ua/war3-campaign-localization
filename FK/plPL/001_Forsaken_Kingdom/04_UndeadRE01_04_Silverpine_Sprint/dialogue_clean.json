{
  "map": "UndeadRE01",
  "title": "Silverpine Sprint",
  "locale": "plPL",
  "note": "Blizzard's order from conversation.json (trigger groups as listed, lines by conversationOrder).",
  "lines": [
    {
      "speaker": "Glix",
      "text": "No dobra, Gareku. Ruszasz na tor sam i starasz się pobić wyniki innych.",
      "metadata": {
        "string_id": 2608,
        "speaker_string_id": 2829,
        "dialogue_id": "A1M4-T010-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Słuchaj moich instrukcji, trzymaj się drogi, a uda nam się to wygrać!",
      "metadata": {
        "string_id": 2609,
        "speaker_string_id": 2830,
        "dialogue_id": "A1M4-T020-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Teraz lekko dodaj gazu...",
      "metadata": {
        "string_id": 2430,
        "speaker_string_id": 2833,
        "dialogue_id": "A1M4-T030-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Spokojnie!",
      "metadata": {
        "string_id": 2618,
        "speaker_string_id": 2831,
        "dialogue_id": "A1M4-T040-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Na miejsca... gotowi... START!",
      "metadata": {
        "string_id": 2613,
        "speaker_string_id": 2832,
        "dialogue_id": "A1M4-T050-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Gareku, niszczysz pojazd!",
      "metadata": {
        "string_id": 2510,
        "speaker_string_id": 2815,
        "dialogue_id": "A1M4-T060-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Trzymaj się drogi!",
      "metadata": {
        "string_id": 2497,
        "speaker_string_id": 2816,
        "dialogue_id": "A1M4-T070-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Uważniej! Uważniej!",
      "metadata": {
        "string_id": 2588,
        "speaker_string_id": 2817,
        "dialogue_id": "A1M4-T080-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Skup się, Garek! Proszę!",
      "metadata": {
        "string_id": 2585,
        "speaker_string_id": 2818,
        "dialogue_id": "A1M4-T090-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Gareku! Słuchaj, co mówię!",
      "metadata": {
        "string_id": 2584,
        "speaker_string_id": 2819,
        "dialogue_id": "A1M4-T100-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Garek, co ty wyprawiasz?!",
      "metadata": {
        "string_id": 2583,
        "speaker_string_id": 2820,
        "dialogue_id": "A1M4-T110-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Uważaj! Murloki!",
      "metadata": {
        "string_id": 2582,
        "speaker_string_id": 2821,
        "dialogue_id": "A1M4-T120-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Bestia na drodze!",
      "metadata": {
        "string_id": 2835,
        "speaker_string_id": 2834,
        "dialogue_id": "A1M4-T130-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "W prawo!",
      "metadata": {
        "string_id": 2581,
        "speaker_string_id": 2822,
        "dialogue_id": "A1M4-T140-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Przed tobą zakręt w prawo!",
      "metadata": {
        "string_id": 2580,
        "speaker_string_id": 2823,
        "dialogue_id": "A1M4-T150-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "W prawo, Garek!",
      "metadata": {
        "string_id": 2579,
        "speaker_string_id": 2824,
        "dialogue_id": "A1M4-T160-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "W lewo!",
      "metadata": {
        "string_id": 2578,
        "speaker_string_id": 2825,
        "dialogue_id": "A1M4-T170-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Przed tobą zakręt w lewo!",
      "metadata": {
        "string_id": 2577,
        "speaker_string_id": 2826,
        "dialogue_id": "A1M4-T180-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "W lewo, Garek!",
      "metadata": {
        "string_id": 2576,
        "speaker_string_id": 2827,
        "dialogue_id": "A1M4-T190-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Ostatnia prosta! Oby do mety!",
      "metadata": {
        "string_id": 2605,
        "speaker_string_id": 2828,
        "dialogue_id": "A1M4-T200-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Wygraliśmy?! Wygraliśmy! Ani przez chwilę nie wątpiłem!",
      "metadata": {
        "string_id": 2836,
        "speaker_string_id": 2837,
        "dialogue_id": "A1M4-T210-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Nieźle jak na amatora. Tak myślę.",
      "metadata": {
        "string_id": 2838,
        "speaker_string_id": 2839,
        "dialogue_id": "A1M4-T220-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Cóż... każdy mecz jest udany, jeśli się go przeżyje, nie?",
      "metadata": {
        "string_id": 2840,
        "speaker_string_id": 2841,
        "dialogue_id": "A1M4-T230-GLIX"
      }
    }
  ]
}