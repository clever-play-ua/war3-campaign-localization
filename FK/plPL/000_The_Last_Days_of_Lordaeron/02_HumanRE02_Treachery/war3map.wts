STRING 2079
// Sound/Dialogue/HumanRECamp/Human02re/HRE02-T040-GAREK.ogg
{
Looks like there's only one path forward.
}

STRING 2091
// Sound/Dialogue/HumanRECamp/Human02re/HRE02-T070-LANDEN.ogg
{
The cult must have followed us into the sewers. We need to keep moving!
}

STRING 2109
{
Blightweaver
}

STRING 2110
{
There will be no “path forward” for you!
}

STRING 2111
// Sound/Dialogue/HumanRECamp/Human02re/HRE02-T060-LANDEN.ogg
{
Everyone, to arms!
}

