{
  "map": "UndeadRE01_02",
  "title": "Capital Ruins",
  "locale": "esES",
  "order_note": "Sorted by recording id: C (cinematics), M (in-engine cutscenes), T (gameplay transmissions); unit barks follow their trigger group. Interleaving of C/M/T is not confirmed.",
  "lines": [
    {
      "n": 1,
      "id": "A1M2-M020-010-BANSHEE",
      "scene": "Initialization.DialogeReference",
      "speaker": "Marya",
      "text": "¡Mi amor! ¿Dónde está? ¡He de encontrarlo!",
      "string_id": 2016,
      "speaker_string_id": 2017,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-M020-010-BANSHEE.ogg"
    },
    {
      "n": 2,
      "id": "A1M2-M020-020-ANYA",
      "scene": "Initialization.DialogeReference",
      "speaker": "Anya",
      "text": "Está reviviendo su propia muerte. Uno de esos cadáveres errantes debe de ser su «amor».",
      "string_id": 2014,
      "speaker_string_id": 2015,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-M020-020-ANYA.ogg"
    },
    {
      "n": 3,
      "id": "A1M2-M020-030-ANYA",
      "scene": "Initialization.DialogeReference",
      "speaker": "Anya",
      "text": "Si ponemos fin a esta pantomima, quizá recupere la razón.",
      "string_id": 2012,
      "speaker_string_id": 2013,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-M020-030-ANYA.ogg"
    },
    {
      "n": 4,
      "id": "A1M2-M020-040-GAREK",
      "scene": "Initialization.DialogeReference",
      "speaker": "Garek",
      "text": "Comprendo. Démosle algo de paz.",
      "string_id": 2010,
      "speaker_string_id": 2011,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-M020-040-GAREK.ogg"
    },
    {
      "n": 5,
      "id": "A1M2-T010-ANYA",
      "scene": "Forsaken.Forsaken Leaderboard Create Q",
      "speaker": "Anya",
      "text": "Ve con cuidado, Garek. No todos los que se han librado del control de la Plaga son tan amistosos como nosotros.",
      "string_id": 1726,
      "speaker_string_id": 1727,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T010-ANYA.ogg"
    },
    {
      "n": 6,
      "id": "A1M2-T020-GAREK",
      "scene": "Forsaken.Forsaken Leaderboard Create Q",
      "speaker": "Garek",
      "text": "En otras palabras, que igual tenemos que defendernos, ¿no?",
      "string_id": 1735,
      "speaker_string_id": 1736,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T020-GAREK.ogg"
    },
    {
      "n": 7,
      "id": "A1M2-T030-ANYA",
      "scene": "Forsaken.Forsaken Leaderboard Create Q",
      "speaker": "Anya",
      "text": "Anda, qué avispado eres.",
      "string_id": 1746,
      "speaker_string_id": 1747,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T030-ANYA.ogg"
    },
    {
      "n": 8,
      "id": "A1M2-T040-ANYA",
      "scene": "Forsaken.Forsaken 01 Enter Q",
      "speaker": "Anya",
      "text": "¡Eh, vosotros! Sylvanas Brisaveloz os ofrece asilo en Entrañas. Id a las cloacas.",
      "string_id": 1755,
      "speaker_string_id": 1756,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T040-ANYA.ogg"
    },
    {
      "n": 9,
      "id": "A1M2-T050-GAREK",
      "scene": "Forsaken.Forsaken 01 Enter Q",
      "speaker": "Garek",
      "text": "Mmm... Me ha parecido obvio.",
      "string_id": 1766,
      "speaker_string_id": 1767,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T050-GAREK.ogg"
    },
    {
      "n": 10,
      "id": "A1M2-T060-ANYA",
      "scene": "Forsaken.Forsaken 01 Enter Q",
      "speaker": "Anya",
      "text": "¿Tienes que tentar al destino?",
      "string_id": 1777,
      "speaker_string_id": 1778,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T060-ANYA.ogg"
    },
    {
      "n": 11,
      "id": "A1M2-T061-ANYA",
      "scene": "Encounters.Encounter A Enter Q",
      "speaker": "Anya",
      "text": "La Plaga continúa acechando por estas ruinas y conspirando contra nosotros. Que no quede nadie con vida.",
      "string_id": 1982,
      "speaker_string_id": 1983,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T061-ANYA.ogg"
    },
    {
      "n": 12,
      "id": "A1M2-T070-SURVIVOR",
      "scene": "Forsaken.Forsaken 02 Enter Q",
      "speaker": "Superviviente renegado",
      "text": "¡Comer! ¡Necesito comer ya!",
      "string_id": 1786,
      "speaker_string_id": 1787,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T070-SURVIVOR.ogg"
    },
    {
      "n": 13,
      "id": "A1M2-T080-GAREK",
      "scene": "Forsaken.Forsaken 02 Unit Dies Q",
      "speaker": "Garek",
      "text": "No eran más que un hatajo de cuerpos descerebrados... Anya, si hubiese despertado en ese estado...",
      "string_id": 1795,
      "speaker_string_id": 1796,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T080-GAREK.ogg"
    },
    {
      "n": 14,
      "id": "A1M2-T090-ANYA",
      "scene": "Forsaken.Forsaken 02 Unit Dies Q",
      "speaker": "Anya",
      "text": "Te habría matado y habría permitido que Putress te despedazase. En marcha.",
      "string_id": 1804,
      "speaker_string_id": 1805,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T090-ANYA.ogg"
    },
    {
      "n": 15,
      "id": "A1M2-T100-ANYA",
      "scene": "Forsaken.Forsaken 04 Enter Q",
      "speaker": "Anya",
      "text": "¡Más invasores de la Plaga! Rápido, ¡ayuda a los renegados!",
      "string_id": 1863,
      "speaker_string_id": 1864,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T100-ANYA.ogg"
    },
    {
      "n": 16,
      "id": "A1M2-T110-ANYA",
      "scene": "Forsaken.Forsaken 04 Scourge Defeated Q",
      "speaker": "Anya",
      "text": "Ya estáis a salvo. Corred a las cloacas. La Dama Oscura os protegerá.",
      "string_id": 1894,
      "speaker_string_id": 1895,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T110-ANYA.ogg"
    },
    {
      "n": 17,
      "id": "A1M2-T120-BERND",
      "scene": "Forsaken.Forsaken 03 Enter Q",
      "speaker": "Bernd",
      "text": "¡Socorro! ¡Que alguien me ayude!",
      "string_id": 1813,
      "speaker_string_id": 1814,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T120-BERND.ogg"
    },
    {
      "n": 18,
      "id": "A1M2-T130-GAREK",
      "scene": "Forsaken.Forsaken 03 Enter Q",
      "speaker": "Garek",
      "text": "¡Sal de ahí!",
      "string_id": 1839,
      "speaker_string_id": 1840,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T130-GAREK.ogg"
    },
    {
      "n": 19,
      "id": "A1M2-T140-BERND",
      "scene": "Forsaken.Forsaken 03 Scourge Defeated Q",
      "speaker": "Bernd",
      "text": "¡Gracias! ¡Nos has salvado!",
      "string_id": 1845,
      "speaker_string_id": 1846,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T140-BERND.ogg"
    },
    {
      "n": 20,
      "id": "A1M2-T150-GAREK",
      "scene": "Forsaken.Forsaken 03 Scourge Defeated Q",
      "speaker": "Garek",
      "text": "Id a las cloacas. Lady Sylvanas brinda cobijo a todos los Renegados.",
      "string_id": 1854,
      "speaker_string_id": 1855,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T150-GAREK.ogg"
    },
    {
      "n": 21,
      "id": "A1M2-T160-BANSHEE",
      "scene": "Banshee.Banshee A Zombie Lover Q",
      "speaker": "Marya",
      "text": "Él... él ya no... Ya me acuerdo... Gracias.",
      "string_id": 1609,
      "speaker_string_id": 1610,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T160-BANSHEE.ogg"
    },
    {
      "n": 22,
      "id": "A1M2-T170-ANYA",
      "scene": "Banshee.Banshee A Zombie Lover Q",
      "speaker": "Anya",
      "text": "Has quedado libre de tu pasado. Ve a Entrañas. La Dama Oscura te recibirá con los brazos abiertos.",
      "string_id": 1616,
      "speaker_string_id": 1617,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T170-ANYA.ogg"
    },
    {
      "n": 23,
      "id": "A1M2-T180-BANSHEE",
      "scene": "Banshee.Banshee B Enter Q",
      "speaker": "Alexsia",
      "text": "¡Huid, niños! ¡Esa secta pretende matarnos a todos!",
      "string_id": 1625,
      "speaker_string_id": 1626,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T180-BANSHEE.ogg"
    },
    {
      "n": 24,
      "id": "A1M2-T190-BANSHEE",
      "scene": "Banshee.Banshee B Cultist Defeated Q",
      "speaker": "Alexsia",
      "text": "Muertos... Todos muertos...",
      "string_id": 1634,
      "speaker_string_id": 1635,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T190-BANSHEE.ogg"
    },
    {
      "n": 25,
      "id": "A1M2-T200-ANYA",
      "scene": "Banshee.Banshee B Cultist Defeated Q",
      "speaker": "Anya",
      "text": "Llora tanto como necesites. Cuando estés lista, un nuevo hogar te estará esperando en Entrañas.",
      "string_id": 1643,
      "speaker_string_id": 1644,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T200-ANYA.ogg"
    },
    {
      "n": 26,
      "id": "A1M2-T210-KAELYSTIA",
      "scene": "Banshee.Banshee C Enter Q",
      "speaker": "Kaelystia",
      "text": "¡¿Quién osa perturbar mi descanso?! ¡Mi fuego mágico te reducirá a cenizas!",
      "string_id": 1655,
      "speaker_string_id": 1656,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T210-KAELYSTIA.ogg"
    },
    {
      "n": 27,
      "id": "A1M2-T220-ANYA",
      "scene": "Banshee.Banshee C Dies Q",
      "speaker": "Anya",
      "text": "¡Basta ya! No somos quienes merecen tu ira. Únete a los Renegados y descarga tu rabia contra la Plaga.",
      "string_id": 1664,
      "speaker_string_id": 1665,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T220-ANYA.ogg"
    },
    {
      "n": 28,
      "id": "A1M2-T230-KAELYSTIA",
      "scene": "Banshee.Banshee C Dies Q",
      "speaker": "Kaelystia",
      "text": "Sí... sí, tienes razón. Gracias por ayudarme a ver con claridad.",
      "string_id": 1676,
      "speaker_string_id": 1677,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T230-KAELYSTIA.ogg"
    },
    {
      "n": 29,
      "id": "A1M2-T240-GAREK",
      "scene": "Forsaken.Forsaken Aftermath Enter Q",
      "speaker": "Garek",
      "text": "Qué destino tan aciago... Primero, que te conviertan en no-muerto y, después, despertar para sufrir los horrores de una nueva existencia.",
      "string_id": 1681,
      "speaker_string_id": 1682,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T240-GAREK.ogg"
    },
    {
      "n": 30,
      "id": "A1M2-T250-ANYA",
      "scene": "Forsaken.Forsaken Aftermath Enter Q",
      "speaker": "Anya",
      "text": "Esa es una forma de verlo. ¿Habrías preferido que te dejáramos pudrirte o aceptarás la oportunidad de una segunda vida?",
      "string_id": 1690,
      "speaker_string_id": 1691,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T250-ANYA.ogg"
    },
    {
      "n": 31,
      "id": "A1M2-T260-GAREK",
      "scene": "Forsaken.Forsaken Aftermath Enter Q",
      "speaker": "Garek",
      "text": "Cuesta decirlo. No tengo recuerdo alguno de la primera.",
      "string_id": 1699,
      "speaker_string_id": 1700,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T260-GAREK.ogg"
    },
    {
      "n": 32,
      "id": "A1M2-T270-ANYA",
      "scene": "Forsaken.Forsaken Aftermath Enter Q",
      "speaker": "Anya",
      "text": "Aunque no lo parezca, puede ser una bendición. Muchos recordamos nuestra muerte y lo que nos obligaron a hacer antes de recuperar el libre albedrío.",
      "string_id": 1708,
      "speaker_string_id": 1709,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T270-ANYA.ogg"
    },
    {
      "n": 33,
      "id": "A1M2-T280-ANYA",
      "scene": "Forsaken.Forsaken Aftermath Enter Q",
      "speaker": "Anya",
      "text": "Ojalá todos hubiésemos tenido la suerte de empezar de cero.",
      "string_id": 1713,
      "speaker_string_id": 1714,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T280-ANYA.ogg"
    },
    {
      "n": 34,
      "id": "A1M2-T300-ANYA",
      "scene": "Abomination.Abomination Human Base Enter Q",
      "speaker": "Anya",
      "text": "Los vivos merodean por estas ruinas. Hay que darles caza.",
      "string_id": 1934,
      "speaker_string_id": 1935,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T300-ANYA.ogg"
    },
    {
      "n": 35,
      "id": "A1M2-T301-SILVERHANDKNIGHT",
      "scene": "Abomination.Abomination Paladin Enter Q",
      "speaker": "Lucian forjado por la Luz",
      "text": "¡Más de esas viles alimañas! ¡Arded ante la Luz!",
      "string_id": 1943,
      "speaker_string_id": 1944,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T301-SILVERHANDKNIGHT.ogg"
    },
    {
      "n": 36,
      "id": "A1M2-T302-ANYA",
      "scene": "Abomination.Abomination Paladin Enter Q",
      "speaker": "Anya",
      "text": "¡Un paladín! ¡Acaba con él!",
      "string_id": 1958,
      "speaker_string_id": 1959,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T302-ANYA.ogg"
    },
    {
      "n": 37,
      "id": "A1M2-T310-GAREK",
      "scene": "Abomination.Abomination Paladin Dies Q",
      "speaker": "Garek",
      "text": "¿En serio a Keever no se le ocurría una forma menos peligrosa de hacer esto?",
      "string_id": 1967,
      "speaker_string_id": 1968,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T310-GAREK.ogg"
    },
    {
      "n": 38,
      "id": "A1M2-T320-ANYA",
      "scene": "Abomination.Abomination Garithos Picked Q",
      "speaker": "Anya",
      "text": "El gran mariscal Garithos, aborrecido por enemigos y aliados en igual medida. Nadie derramó lágrima alguna cuando Sylvanas ordenó su muerte.",
      "string_id": 1902,
      "speaker_string_id": 1903,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T320-ANYA.ogg"
    },
    {
      "n": 39,
      "id": "A1M2-T330-ANYA",
      "scene": "Abomination.Abomination Garithos Picked Q",
      "speaker": "Anya",
      "text": "Qué curioso que Keever quiera aprovechar sus restos. Igual ve en ello algún tipo de justicia.",
      "string_id": 1911,
      "speaker_string_id": 1912,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T330-ANYA.ogg"
    },
    {
      "n": 40,
      "id": "A1M2-T760-ANYA",
      "scene": "Ghoul.Ghoul Approached Q",
      "speaker": "Anya",
      "text": "¿Ese necrófago está... leyendo? Es imposible.",
      "string_id": 1530,
      "speaker_string_id": 1531,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T760-ANYA.ogg"
    },
    {
      "n": 41,
      "id": "A1M2-T770-GAREK",
      "scene": "Ghoul.Ghoul Flee Q",
      "speaker": "Garek",
      "text": "Mmm... Quizá podamos hacerlo salir de su escondite con unos libros.",
      "string_id": 1539,
      "speaker_string_id": 1540,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T770-GAREK.ogg"
    },
    {
      "n": 42,
      "id": "A1M2-T771-GAREK",
      "scene": "Ghoul.Ghoul Lure Item Dropped Q",
      "speaker": "Garek",
      "text": "Quizá tenga miedo de nosotros, vamos a darle un poco de espacio.",
      "string_id": 1562,
      "speaker_string_id": 1563,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T771-GAREK.ogg"
    },
    {
      "n": 43,
      "id": "A1M2-T772-ANYA",
      "scene": "Ghoul.Ghoul Lured Captured Q",
      "speaker": "Anya",
      "text": "Algo me dice que Keever encontrará un alma gemela en este.",
      "string_id": 2156,
      "speaker_string_id": 2157,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m2/A1M2-T772-ANYA.ogg"
    },
    {
      "n": 44,
      "id": "BansheeYesAttack2",
      "scene": "Tome Wraiths.Tome Wraiths GHOUL Activate Q",
      "speaker": "Ánima de los libros",
      "text": "¡Siente mi dolor!",
      "string_id": 1987,
      "speaker_string_id": 1988,
      "sound": "Units/Undead/Banshee/BansheeYesAttack2.flac"
    },
    {
      "n": 45,
      "id": "BansheeYesAttack3",
      "scene": "Tome Wraiths.Tome Wraiths INT Activate Q",
      "speaker": "Ánima de los libros",
      "text": "¡Tu alma arderá!",
      "string_id": 1992,
      "speaker_string_id": 1993,
      "sound": "Units/Undead/Banshee/BansheeYesAttack3.flac"
    },
    {
      "n": 46,
      "id": "BansheePissed1",
      "scene": "Tome Wraiths.Tome Wraiths STR Activate Q",
      "speaker": "Ánima de los libros",
      "text": "¡Que acabe este tormento!",
      "string_id": 1997,
      "speaker_string_id": 1998,
      "sound": "Units/Undead/Banshee/BansheePissed1.flac"
    },
    {
      "n": 47,
      "id": "BansheePissed2",
      "scene": "Tome Wraiths.Tome Wraiths AGI Activate Q",
      "speaker": "Ánima de los libros",
      "text": "¿Cuánto tiempo he de sufrir?",
      "string_id": 2000,
      "speaker_string_id": 2001,
      "sound": "Units/Undead/Banshee/BansheePissed2.flac"
    },
    {
      "n": 48,
      "id": "NecromancerWarcry1",
      "scene": "Encounters.Encounter B Enter Q",
      "speaker": "Nigromante",
      "text": "¡Todos serán míos al final!",
      "string_id": 1491,
      "speaker_string_id": 1492,
      "sound": "Units/Undead/Necromancer/NecromancerWarcry1.flac"
    },
    {
      "n": 49,
      "id": "U01Footman23",
      "scene": "Abomination.Abomination Human Engaged Q",
      "speaker": "Soldado raso",
      "text": "¡Matadlos!",
      "string_id": 1977,
      "speaker_string_id": 1978,
      "sound": "Sound/Dialogue/UndeadCampaign/Undead01/U01Footman23.flac"
    }
  ]
}