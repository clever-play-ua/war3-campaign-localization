STRING 2790
{
Schluss mit dieser Farce. Ich werde Euch mit Vergnügen ausbluten lassen!
}

STRING 2613
{
Was ist das für ein Ort?!
}

STRING 2617
{
Eindringlinge! Tötet sie alle!
}

STRING 2791
{
Zahnrad
}

STRING 2792
{
Zahnrad
