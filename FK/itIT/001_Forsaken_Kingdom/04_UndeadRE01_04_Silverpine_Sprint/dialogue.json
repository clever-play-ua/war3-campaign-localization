{
  "map": "UndeadRE01_04",
  "title": "Silverpine Sprint",
  "locale": "itIT",
  "order_note": "Sorted by recording id: C (cinematics), M (in-engine cutscenes), T (gameplay transmissions); unit barks follow their trigger group. Interleaving of C/M/T is not confirmed.",
  "lines": [
    {
      "n": 1,
      "id": "A1M4-T010-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Va bene, Garek. Sarai da solo sul percorso a cercare di battere il tempo degli altri piloti.",
      "string_id": 2608,
      "speaker_string_id": 2829,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T010-GLIX.ogg"
    },
    {
      "n": 2,
      "id": "A1M4-T020-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Ascolta le mie istruzioni, tieni gli occhi sulla strada e portiamo a casa il risultato!",
      "string_id": 2609,
      "speaker_string_id": 2830,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T020-GLIX.ogg"
    },
    {
      "n": 3,
      "id": "A1M4-T030-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Piano sull'acceleratore...",
      "string_id": 2430,
      "speaker_string_id": 2833,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T030-GLIX.ogg"
    },
    {
      "n": 4,
      "id": "A1M4-T040-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Ho detto di andare piano!",
      "string_id": 2618,
      "speaker_string_id": 2831,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T040-GLIX.ogg"
    },
    {
      "n": 5,
      "id": "A1M4-T050-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Pronti... Partenza... VIA!",
      "string_id": 2613,
      "speaker_string_id": 2832,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T050-GLIX.ogg"
    },
    {
      "n": 6,
      "id": "A1M4-T060-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Garek, stai distruggendo il veicolo!",
      "string_id": 2510,
      "speaker_string_id": 2815,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T060-GLIX.ogg"
    },
    {
      "n": 7,
      "id": "A1M4-T070-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Devi restare sul percorso!",
      "string_id": 2497,
      "speaker_string_id": 2816,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T070-GLIX.ogg"
    },
    {
      "n": 8,
      "id": "A1M4-T080-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Tripla attenzione! Tripla attenzione!",
      "string_id": 2588,
      "speaker_string_id": 2817,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T080-GLIX.ogg"
    },
    {
      "n": 9,
      "id": "A1M4-T090-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Concentrati, Garek! Ti prego!",
      "string_id": 2585,
      "speaker_string_id": 2818,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T090-GLIX.ogg"
    },
    {
      "n": 10,
      "id": "A1M4-T100-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Garek! Ascolta le mie istruzioni!",
      "string_id": 2584,
      "speaker_string_id": 2819,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T100-GLIX.ogg"
    },
    {
      "n": 11,
      "id": "A1M4-T110-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Garek, Garek, che stai facendo?!?",
      "string_id": 2583,
      "speaker_string_id": 2820,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T110-GLIX.ogg"
    },
    {
      "n": 12,
      "id": "A1M4-T120-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Murloc! Attenzione!",
      "string_id": 2582,
      "speaker_string_id": 2821,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T120-GLIX.ogg"
    },
    {
      "n": 13,
      "id": "A1M4-T130-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Abominio sulla strada!",
      "string_id": 2835,
      "speaker_string_id": 2834,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T130-GLIX.ogg"
    },
    {
      "n": 14,
      "id": "A1M4-T140-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Destra, destra!",
      "string_id": 2581,
      "speaker_string_id": 2822,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T140-GLIX.ogg"
    },
    {
      "n": 15,
      "id": "A1M4-T150-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Curva a destra avanti!",
      "string_id": 2580,
      "speaker_string_id": 2823,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T150-GLIX.ogg"
    },
    {
      "n": 16,
      "id": "A1M4-T160-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Gira a destra, Garek!",
      "string_id": 2579,
      "speaker_string_id": 2824,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T160-GLIX.ogg"
    },
    {
      "n": 17,
      "id": "A1M4-T170-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Sinistra, sinistra!",
      "string_id": 2578,
      "speaker_string_id": 2825,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T170-GLIX.ogg"
    },
    {
      "n": 18,
      "id": "A1M4-T180-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Curva a sinistra in arrivo!",
      "string_id": 2577,
      "speaker_string_id": 2826,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T180-GLIX.ogg"
    },
    {
      "n": 19,
      "id": "A1M4-T190-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "A sinistra, Garek!",
      "string_id": 2576,
      "speaker_string_id": 2827,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T190-GLIX.ogg"
    },
    {
      "n": 20,
      "id": "A1M4-T200-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Siamo quasi arrivati! Verso il traguardo, Garek!",
      "string_id": 2605,
      "speaker_string_id": 2828,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T200-GLIX.ogg"
    },
    {
      "n": 21,
      "id": "A1M4-T210-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Abbiamo vinto?!? Abbiamo vinto! Non ne ho dubitato nemmeno per un secondo!",
      "string_id": 2836,
      "speaker_string_id": 2837,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T210-GLIX.ogg"
    },
    {
      "n": 22,
      "id": "A1M4-T220-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Non male per un principiante, immagino.",
      "string_id": 2838,
      "speaker_string_id": 2839,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T220-GLIX.ogg"
    },
    {
      "n": 23,
      "id": "A1M4-T230-GLIX",
      "scene": "Files.VOStuff",
      "speaker": "Glix",
      "text": "Be'... Purché sia una gara da cui riesci ad andartene con le tue gambe, no?",
      "string_id": 2840,
      "speaker_string_id": 2841,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m4/A1M4-T230-GLIX.ogg"
    }
  ]
}