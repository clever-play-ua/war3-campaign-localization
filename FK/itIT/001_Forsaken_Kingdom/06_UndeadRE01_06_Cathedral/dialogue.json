{
  "map": "UndeadRE01_06",
  "title": "Cathedral",
  "locale": "itIT",
  "order_note": "Sorted by recording id: C (cinematics), M (in-engine cutscenes), T (gameplay transmissions); unit barks follow their trigger group. Interleaving of C/M/T is not confirmed.",
  "lines": [
    {
      "n": 1,
      "id": "A1M6-M010-010-ANYA",
      "scene": "Initialization.DialogueReference",
      "speaker": "Anya",
      "text": "Be', di sicuro non possiamo entrare dall'ingresso principale. Anche se uccidessimo tutte le guardie, riveleremmo subito la nostra presenza.",
      "string_id": 381,
      "speaker_string_id": 382,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01M6/A1M6-M010-010-ANYA.ogg"
    },
    {
      "n": 2,
      "id": "A1M6-M010-020-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "Potrebbe esserci un'entrata secondaria. Diamo un'occhiata.",
      "string_id": 397,
      "speaker_string_id": 398,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m6/A1M6-M010-020-GAREK.ogg"
    },
    {
      "n": 3,
      "id": "A1M6-T010-KNIGHT",
      "scene": "Transmissions.Front Door Transmission 01",
      "speaker": "Fante",
      "text": "Intrusi! Chiudete le porte!",
      "string_id": 291,
      "speaker_string_id": 292,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m6/A1M6-T010-KNIGHT.ogg"
    },
    {
      "n": 4,
      "id": "A1M6-T020-ANYA",
      "scene": "Transmissions.Front Door Transmission 02",
      "speaker": "Anya",
      "text": "Te l'ho detto che sarebbe successo. Speriamo ci sia davvero un'entrata secondaria.",
      "string_id": 303,
      "speaker_string_id": 304,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m6/A1M6-T020-ANYA.ogg"
    },
    {
      "n": 5,
      "id": "A1M6-T030-GAREK",
      "scene": "Transmissions.Side Path Transmission 01",
      "speaker": "Garek",
      "text": "Perché questi Paladini ci odiano così tanto? È solo perché siamo Non Morti?",
      "string_id": 310,
      "speaker_string_id": 311,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m6/A1M6-T030-GAREK.ogg"
    },
    {
      "n": 6,
      "id": "A1M6-T040-ANYA",
      "scene": "Transmissions.Side Path Transmission 01",
      "speaker": "Anya",
      "text": "È una ragione più che valida ai loro occhi. Ma in realtà, danno la colpa a noi per la caduta di Lordaeron.",
      "string_id": 313,
      "speaker_string_id": 314,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m6/A1M6-T040-ANYA.ogg"
    },
    {
      "n": 7,
      "id": "A1M6-T050-ANYA",
      "scene": "Transmissions.Side Path Transmission 01",
      "speaker": "Anya",
      "text": "Forse alcuni di loro combattono ancora per la giustizia, qualunque cosa significhi. Ma la maggior parte vuole solo vendetta.",
      "string_id": 317,
      "speaker_string_id": 318,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m6/A1M6-T050-ANYA.ogg"
    },
    {
      "n": 8,
      "id": "A1M6-T060-ANYA",
      "scene": "Transmissions.Wall Gap Transmission 01",
      "speaker": "Anya",
      "text": "Siamo dentro. Ora liberiamoci della Mano d'Argento.",
      "string_id": 322,
      "speaker_string_id": 323,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m6/A1M6-T060-ANYA.ogg"
    },
    {
      "n": 9,
      "id": "A1M6-T080-GAREK",
      "scene": "Transmissions.Holy Aura Transmission 01",
      "speaker": "Garek",
      "text": "Argh! Brucia!",
      "string_id": 332,
      "speaker_string_id": 333,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m6/A1M6-T080-GAREK.ogg"
    },
    {
      "n": 10,
      "id": "A1M6-T090-ANYA",
      "scene": "Transmissions.Holy Aura Transmission 01",
      "speaker": "Anya",
      "text": "È la Luce! Elimina i Sacerdoti, presto!",
      "string_id": 337,
      "speaker_string_id": 338,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m6/A1M6-T090-ANYA.ogg"
    },
    {
      "n": 11,
      "id": "A1M6-T100-COMMANDER",
      "scene": "Bossfight.Paladin Transmission 01 Initial Camera Steal",
      "speaker": "Paladino",
      "text": "Maledetti mostri! Come osate profanare questo terreno sacro?!",
      "string_id": 352,
      "speaker_string_id": 353,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01M6/A1M6-T100-COMMANDER.ogg"
    }
  ]
}