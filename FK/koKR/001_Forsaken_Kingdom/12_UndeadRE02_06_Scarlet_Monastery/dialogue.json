      "speaker_string_id": 480,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m5/A2M5-T220-SCARLETCRUSADER.ogg"
    },
    {
      "n": 45,
      "id": "A2M5-T230-LEONID",
      "scene": "Scarlet Crusade.Cannons.Scarlet Crusade Cannons Meat Wagons Bastion Q",
      "speaker": "리어니드",
      "text": "붉은십자군의 방어선이 단 하나만 남았다. 수도원이 눈앞이다!",
      "string_id": 474,
      "speaker_string_id": 475,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m5/A2M5-T230-LEONID.ogg"
    },
    {
