      "speaker_string_id": 491,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m5/A2M5-T190-SCARLETINQUISITOR.ogg"
    },
    {
      "n": 43,
      "id": "A2M5-T200-ANYA",
      "scene": "Scarlet Crusade.Inquisitors.Scarlet Crusade Inquisitors Defeated Q",
      "speaker": "안야",
      "text": "속이 다 시원하군. 이제 아군이 진군할 수 있겠어.",
      "string_id": 450,
      "speaker_string_id": 451,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m5/A2M5-T200-ANYA.ogg"
    },
    {
      "n": 44,
      "id": "A2M5-T220-SCARLETCRUSADER",
      "scene": "Scarlet Crusade.Cannons.Scarlet Crusade Cannons Approach Q",
      "speaker": "성전사 아토니우스",
      "text": "어림없는 소리! 네놈들의 공성도 끝이다!",
