{
  "map": "UndeadRE01",
  "title": "Silverpine Sprint",
  "locale": "esMX",
  "note": "Blizzard's order from conversation.json (trigger groups as listed, lines by conversationOrder).",
  "lines": [
    {
      "speaker": "Glix",
      "text": "Muy bien, Garek. Estarás solo en la pista. Tu meta es superar los tiempos de los demás pilotos.",
      "metadata": {
        "string_id": 2608,
        "speaker_string_id": 2829,
        "dialogue_id": "A1M4-T010-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Escucha mis instrucciones y mantén la vista en el camino. ¡Es hora de ganar!",
      "metadata": {
        "string_id": 2609,
        "speaker_string_id": 2830,
        "dialogue_id": "A1M4-T020-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "A ver, acelera de a poco...",
      "metadata": {
        "string_id": 2430,
        "speaker_string_id": 2833,
        "dialogue_id": "A1M4-T030-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Con cuidado!",
      "metadata": {
        "string_id": 2618,
        "speaker_string_id": 2831,
        "dialogue_id": "A1M4-T040-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "En sus marcas, listos... ¡FUERA!",
      "metadata": {
        "string_id": 2613,
        "speaker_string_id": 2832,
        "dialogue_id": "A1M4-T050-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Estás destrozando el vehículo, Garek!",
      "metadata": {
        "string_id": 2510,
        "speaker_string_id": 2815,
        "dialogue_id": "A1M4-T060-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡No te salgas del camino!",
      "metadata": {
        "string_id": 2497,
        "speaker_string_id": 2816,
        "dialogue_id": "A1M4-T070-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Ten el triple de cuidado!",
      "metadata": {
        "string_id": 2588,
        "speaker_string_id": 2817,
        "dialogue_id": "A1M4-T080-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Concéntrate, Garek! ¡Vamos!",
      "metadata": {
        "string_id": 2585,
        "speaker_string_id": 2818,
        "dialogue_id": "A1M4-T090-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Escucha lo que te digo, Garek!",
      "metadata": {
        "string_id": 2584,
        "speaker_string_id": 2819,
        "dialogue_id": "A1M4-T100-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Garek, Garek! ¡¿Qué diablos haces?!",
      "metadata": {
        "string_id": 2583,
        "speaker_string_id": 2820,
        "dialogue_id": "A1M4-T110-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Cuidado, múrlocs!",
      "metadata": {
        "string_id": 2582,
        "speaker_string_id": 2821,
        "dialogue_id": "A1M4-T120-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Abominación en el camino!",
      "metadata": {
        "string_id": 2835,
        "speaker_string_id": 2834,
        "dialogue_id": "A1M4-T130-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡A la derecha!",
      "metadata": {
        "string_id": 2581,
        "speaker_string_id": 2822,
        "dialogue_id": "A1M4-T140-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Gira a la derecha!",
      "metadata": {
        "string_id": 2580,
        "speaker_string_id": 2823,
        "dialogue_id": "A1M4-T150-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡A la derecha, Garek!",
      "metadata": {
        "string_id": 2579,
        "speaker_string_id": 2824,
        "dialogue_id": "A1M4-T160-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡A la izquierda!",
      "metadata": {
        "string_id": 2578,
        "speaker_string_id": 2825,
        "dialogue_id": "A1M4-T170-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Gira a la izquierda!",
      "metadata": {
        "string_id": 2577,
        "speaker_string_id": 2826,
        "dialogue_id": "A1M4-T180-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡A la izquierda, Garek!",
      "metadata": {
        "string_id": 2576,
        "speaker_string_id": 2827,
        "dialogue_id": "A1M4-T190-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡Es lo último! ¡Ya llegas, Garek!",
      "metadata": {
        "string_id": 2605,
        "speaker_string_id": 2828,
        "dialogue_id": "A1M4-T200-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "¡¿Ganamos?! ¡Ganamos! Jamás dudé de ti, ni un segundo.",
      "metadata": {
        "string_id": 2836,
        "speaker_string_id": 2837,
        "dialogue_id": "A1M4-T210-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Nada mal para un principiante, supongo.",
      "metadata": {
        "string_id": 2838,
        "speaker_string_id": 2839,
        "dialogue_id": "A1M4-T220-GLIX"
      }
    },
    {
      "speaker": "Glix",
      "text": "Bueno... puedes abandonar cualquier carrera, ¿eh?",
      "metadata": {
        "string_id": 2840,
        "speaker_string_id": 2841,
        "dialogue_id": "A1M4-T230-GLIX"
      }
    }
  ]
}