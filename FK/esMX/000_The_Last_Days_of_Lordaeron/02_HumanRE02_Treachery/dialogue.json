{
  "map": "HumanRE02",
  "title": "Treachery",
  "locale": "esMX",
  "order_note": "Sorted by recording id: C (cinematics), M (in-engine cutscenes), T (gameplay transmissions); unit barks follow their trigger group. Interleaving of C/M/T is not confirmed.",
  "lines": [
    {
      "n": 1,
      "id": "HRE02-C010-010-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "¡Maldición! ¿Cómo pudo suceder esto? La ciudad yace en ruinas...",
      "string_id": 2189,
      "speaker_string_id": 2190,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C010-010-GAREK.ogg"
    },
    {
      "n": 2,
      "id": "HRE02-C010-020-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Debemos concentrarnos. Esta gente cuenta con nosotros para que los llevemos a un lugar seguro.",
      "string_id": 2192,
      "speaker_string_id": 2193,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C010-020-LANDEN.ogg"
    },
    {
      "n": 3,
      "id": "HRE02-C010-030-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "Contaban con que los mantuviéramos a salvo, y fallamos.",
      "string_id": 2195,
      "speaker_string_id": 2196,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C010-030-GAREK.ogg"
    },
    {
      "n": 4,
      "id": "HRE02-C010-040-RIFLEMAN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Fusilero",
      "text": "¡Miren, sobrevivientes!",
      "string_id": 2198,
      "speaker_string_id": 2199,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C010-040-RIFLEMAN.ogg"
    },
    {
      "n": 5,
      "id": "HRE02-C010-050-FOOTMAN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Soldado",
      "text": "Nos separamos de nuestra unidad y nos perdimos aquí abajo, señor.",
      "string_id": 2766,
      "speaker_string_id": 2767,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C010-050-FOOTMAN.ogg"
    },
    {
      "n": 6,
      "id": "HRE02-C010-060-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Nos dirigimos hacia el túnel de salida. Ayúdennos a proteger a los civiles y todos podremos salir de aquí.",
      "string_id": 2204,
      "speaker_string_id": 2205,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C010-060-LANDEN.ogg"
    },
    {
      "n": 7,
      "id": "HRE02-C020-010-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "\"¡Ese es el Barón Rivendare\n, amo de Stratholme!\"",
      "string_id": 2238,
      "speaker_string_id": 2239,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C020-010-GAREK.ogg"
    },
    {
      "n": 8,
      "id": "HRE02-C020-020-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "¡Mi señor! Tenemos un grupo de civiles...",
      "raw": "[\"Scared\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]¡Mi señor! Tenemos un grupo de civiles...[/\"Scared\"]",
      "string_id": 2241,
      "speaker_string_id": 2242,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C020-020-LANDEN.ogg"
    },
    {
      "n": 9,
      "id": "HRE02-C020-030-RIVENDARE",
      "scene": "Initialization.DialogueReference",
      "speaker": "Barón Rivendare",
      "text": "Qué suerte. Tus sobrevivientes serán buenas incorporaciones a la Plaga.",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]Qué suerte. Tus sobrevivientes serán buenas incorporaciones a la Plaga.[/\"Angry\"]",
      "string_id": 2244,
      "speaker_string_id": 2245,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C020-030-RIVENDARE.ogg"
    },
    {
      "n": 10,
      "id": "HRE02-C020-040-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "¡Eres un sucio traidor, igual que Arthas!",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]¡Eres un sucio traidor, igual que Arthas![/\"Angry\"]",
      "string_id": 2247,
      "speaker_string_id": 2248,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C020-040-GAREK.ogg"
    },
    {
      "n": 11,
      "id": "HRE02-C020-050-RIVENDARE",
      "scene": "Initialization.DialogueReference",
      "speaker": "Barón Rivendare",
      "text": "Nuestro querido príncipe no es más que el instrumento de un plan mucho mayor. Uno que ayudé a tramar.",
      "raw": "[\"Happy\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]Nuestro querido príncipe no es más que el instrumento de un plan mucho mayor. Uno que ayudé a tramar.[/\"Happy\"]",
      "string_id": 2250,
      "speaker_string_id": 2251,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C020-050-RIVENDARE.ogg"
    },
    {
      "n": 12,
      "id": "HRE02-C020-060-RIVENDARE",
      "scene": "Initialization.DialogueReference",
      "speaker": "Barón Rivendare",
      "text": "Ahora este reino débil y patético morirá, y de su cadáver se alzará un ejército de los malditos.",
      "string_id": 2253,
      "speaker_string_id": 2254,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C020-060-RIVENDARE.ogg"
    },
    {
      "n": 13,
      "id": "HRE02-C020-070-RIVENDARE",
      "scene": "Initialization.DialogueReference",
      "speaker": "Barón Rivendare",
      "text": "Estas alimañas son indignas de mí. Elimínenlas y persigan al resto de los sobrevivientes.",
      "string_id": 2256,
      "speaker_string_id": 2257,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C020-070-RIVENDARE.ogg"
    },
    {
      "n": 14,
      "id": "HRE02-C030-010-RIVENDARE",
      "scene": "Initialization.DialogueReference",
      "speaker": "Barón Rivendare",
      "text": "Cuánta disposición para buscar la propia muerte. Qué anhelo de ser héroe.",
      "string_id": 2693,
      "speaker_string_id": 2694,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-010-RIVENDARE.ogg"
    },
    {
      "n": 15,
      "id": "HRE02-C030-020-RIVENDARE",
      "scene": "Initialization.DialogueReference",
      "speaker": "Barón Rivendare",
      "text": "¡Pero no eres nadie! Eres un cadáver en potencia más que servirá...",
      "string_id": 2710,
      "speaker_string_id": 2711,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-020-RIVENDARE.ogg"
    },
    {
      "n": 16,
      "id": "HRE02-C030-040-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "¡La barrera se debilitó! ¡Corre!",
      "string_id": 2719,
      "speaker_string_id": 2720,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-040-LANDEN.ogg"
    },
    {
      "n": 17,
      "id": "HRE02-C030-050-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "¡¿Qué?! ¡No, no te dejaré!",
      "string_id": 2728,
      "speaker_string_id": 2729,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-050-GAREK.ogg"
    },
    {
      "n": 18,
      "id": "HRE02-C030-060-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "¡Olvídate de mí! ¡Tienes que llevar a la gente a Andorhal!",
      "string_id": 2737,
      "speaker_string_id": 2738,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-060-LANDEN.ogg"
    },
    {
      "n": 19,
      "id": "HRE02-C030-070-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "Capitán, yo...",
      "string_id": 2746,
      "speaker_string_id": 2747,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-070-GAREK.ogg"
    },
    {
      "n": 20,
      "id": "HRE02-C030-080-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "¡Es una orden, demonios!",
      "string_id": 2755,
      "speaker_string_id": 2756,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-080-LANDEN.ogg"
    },
    {
      "n": 21,
      "id": "HRE02-C030-090-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "Que la luz lo acompañe, señor.",
      "string_id": 2764,
      "speaker_string_id": 2765,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-090-GAREK.ogg"
    },
    {
      "n": 22,
      "id": "HRE02-C030-100-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Vete, Garek. Y cumple con tu destino.",
      "string_id": 2775,
      "speaker_string_id": 2776,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-100-LANDEN.ogg"
    },
    {
      "n": 23,
      "id": "HRE02-C030-110-RIVENDARE",
      "scene": "Initialization.DialogueReference",
      "speaker": "Barón Rivendare",
      "text": "¡¿Creen que pueden escapar?! ¡Estas alcantarillas serán su tumba!",
      "string_id": 2783,
      "speaker_string_id": 2784,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-110-RIVENDARE.ogg"
    },
    {
      "n": 24,
      "id": "HRE02-C030-120-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "¡Por Lordaeron!",
      "string_id": 2786,
      "speaker_string_id": 2787,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-C030-120-LANDEN.ogg"
    },
    {
      "n": 25,
      "id": "HRE02-M010-010-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "¡Miren esto! ¿Cuánto hará que estas ratas cultistas merodean en las alcantarillas?",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]¡Miren esto! ¿Cuánto hará que estas ratas cultistas merodean en las alcantarillas?[/\"Angry\"]",
      "string_id": 2207,
      "speaker_string_id": 2208,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M010-010-GAREK.ogg"
    },
    {
      "n": 26,
      "id": "HRE02-M010-020-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Planear este golpe les debe haber tomado años. Nuestros amigos y vecinos...",
      "string_id": 2210,
      "speaker_string_id": 2211,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M010-020-LANDEN.ogg"
    },
    {
      "n": 27,
      "id": "HRE02-M010-030-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "Y pensar que esta podredumbre crecía bajo nuestros pies todo este tiempo...",
      "string_id": 2213,
      "speaker_string_id": 2214,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M010-030-GAREK.ogg"
    },
    {
      "n": 28,
      "id": "HRE02-M010-040-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Dejaremos a los civiles aquí mientras aseguramos el camino.",
      "string_id": 2216,
      "speaker_string_id": 2217,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M010-040-LANDEN.ogg"
    },
    {
      "n": 29,
      "id": "HRE02-M010-050-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Traben las puertas hasta que volvamos. Y si no lo hacemos...",
      "string_id": 2219,
      "speaker_string_id": 2220,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M010-050-LANDEN.ogg"
    },
    {
      "n": 30,
      "id": "HRE02-M010-060-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Que la Luz los acompañe.",
      "string_id": 2222,
      "speaker_string_id": 2223,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M010-060-LANDEN.ogg"
    },
    {
      "n": 31,
      "id": "HRE02-M015-010-LORDEARONSOLDIER",
      "scene": "Initialization.DialogueReference",
      "speaker": "Soldado",
      "text": "¡La guardia de la ciudad! ¡Sabía que había más sobrevivientes!",
      "string_id": 2225,
      "speaker_string_id": 2226,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M015-010-LORDEARONSOLDIER.ogg"
    },
    {
      "n": 32,
      "id": "HRE02-M015-020-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Nos acompaña un grupo de civiles. ¿Pueden abrir la puerta?",
      "string_id": 2228,
      "speaker_string_id": 2229,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M015-020-LANDEN.ogg"
    },
    {
      "n": 33,
      "id": "HRE02-M015-030-LORDEARONSOLDIER",
      "scene": "Initialization.DialogueReference",
      "speaker": "Soldado",
      "text": "No, señor. Esos malditos cultistas desarmaron el cabrestante. Deberán recuperar los engranajes robados.",
      "string_id": 2231,
      "speaker_string_id": 2232,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M015-030-LORDEARONSOLDIER.ogg"
    },
    {
      "n": 34,
      "id": "HRE02-M015-040-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "Parece que es hora de cazar cultistas.",
      "string_id": 2235,
      "speaker_string_id": 2236,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M015-040-GAREK.ogg"
    },
    {
      "n": 35,
      "id": "HRE02-M020-010-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "¡Todo el mundo, a la superficie!",
      "string_id": 2259,
      "speaker_string_id": 2260,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M020-010-LANDEN.ogg"
    },
    {
      "n": 36,
      "id": "HRE02-M020-020-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "No, capitán. Puede llevar a los sobrevivientes a Andorhal sin mí.",
      "string_id": 2262,
      "speaker_string_id": 2263,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M020-020-GAREK.ogg"
    },
    {
      "n": 37,
      "id": "HRE02-M020-030-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "\"No me iré mientras Rivendare\n aún respire.\"",
      "string_id": 2265,
      "speaker_string_id": 2266,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M020-030-GAREK.ogg"
    },
    {
      "n": 38,
      "id": "HRE02-M020-040-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Garek, esto es una locura. Es imposible que...",
      "raw": "[\"Surprised\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]Garek, esto es una locura. Es imposible que...[/\"Surprised\"]",
      "string_id": 2268,
      "speaker_string_id": 2269,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M020-040-LANDEN.ogg"
    },
    {
      "n": 39,
      "id": "HRE02-M020-050-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "La justicia no lo hallará salvo que alguien se la imparta. Si no es ahora, ¿cuándo?",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]La justicia no lo hallará salvo que alguien se la imparta. Si no es ahora, ¿cuándo?[/\"Angry\"]",
      "string_id": 2271,
      "speaker_string_id": 2272,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M020-050-GAREK.ogg"
    },
    {
      "n": 40,
      "id": "HRE02-M020-060-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Soldado, dejo estos civiles a su cargo.",
      "string_id": 2274,
      "speaker_string_id": 2275,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M020-060-LANDEN.ogg"
    },
    {
      "n": 41,
      "id": "HRE02-M020-070-LANDEN",
      "scene": "Initialization.DialogueReference",
      "speaker": "Landen",
      "text": "Hagámoslo rápido, teniente.",
      "string_id": 2277,
      "speaker_string_id": 2278,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M020-070-LANDEN.ogg"
    },
    {
      "n": 42,
      "id": "HRE02-M030-010-LORDEARONSOLDIER",
      "scene": "Initialization.DialogueReference",
      "speaker": "Soldado",
      "text": "¡Teniente Bandarion, sigue con vida! Pero... ¿y el capitán Landen?",
      "string_id": 2280,
      "speaker_string_id": 2281,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M030-010-LORDEARONSOLDIER.ogg"
    },
    {
      "n": 43,
      "id": "HRE02-M030-020-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "No... no lo logró.",
      "string_id": 2288,
      "speaker_string_id": 2289,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M030-020-GAREK.ogg"
    },
    {
      "n": 44,
      "id": "HRE02-M030-030-GAREK",
      "scene": "Initialization.DialogueReference",
      "speaker": "Garek",
      "text": "Debemos reagruparnos con Uther en Andorhal. En marcha.",
      "string_id": 2286,
      "speaker_string_id": 2287,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-M030-030-GAREK.ogg"
    },
    {
      "n": 45,
      "id": "HRE02-T010-LANDEN",
      "scene": "TRANSMISSIONS.The Sewers.Transmission Sewers Discover Q",
      "speaker": "Landen",
      "text": "Civiles, a la retaguardia. El resto, al frente.",
      "string_id": 2591,
      "speaker_string_id": 2592,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-T010-LANDEN.ogg"
    },
    {
      "n": 46,
      "id": "HRE02-T020-GAREK",
      "scene": "TRANSMISSIONS.The Sewers.Transmission Sewers FightContinues Q",
      "speaker": "Garek",
      "text": "Arthas sigue arrasando con la ciudad...",
      "string_id": 2599,
      "speaker_string_id": 2600,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-T020-GAREK.ogg"
    },
    {
      "n": 47,
      "id": "HRE02-T030-LANDEN",
      "scene": "TRANSMISSIONS.The Sewers.Transmission Sewers FightContinues Q",
      "speaker": "Landen",
      "text": "Si hallamos una salida, quizá podamos rescatar más sobrevivientes.",
      "string_id": 2601,
      "speaker_string_id": 2602,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-T030-LANDEN.ogg"
    },
    {
      "n": 48,
      "id": "HRE02-T040-GAREK",
      "scene": "TRANSMISSIONS.Ambush.Transmission Sewers Ambush Q",
      "speaker": "Garek",
      "text": "Parece que solo hay una salida.",
      "string_id": 2621,
      "speaker_string_id": 2622,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-T040-GAREK.ogg"
    },
    {
      "n": 49,
      "id": "HRE02-T050-BLIGHTWEAVER",
      "scene": "TRANSMISSIONS.Ambush.Transmission Sewers Ambush Q Attack",
      "speaker": "Añublidor",
      "text": "¡No habrá ninguna “salida” para ti!",
      "string_id": 2546,
      "speaker_string_id": 2547,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-T050-BLIGHTWEAVER.ogg"
    },
    {
      "n": 50,
      "id": "HRE02-T060-LANDEN",
      "scene": "TRANSMISSIONS.Ambush.Transmission Sewers Ambush Q Attack",
      "speaker": "Landen",
      "text": "¡A las armas!",
      "string_id": 2521,
      "speaker_string_id": 2522,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-T060-LANDEN.ogg"
    },
    {
      "n": 51,
      "id": "HRE02-T070-LANDEN",
      "scene": "TRANSMISSIONS.Ambush.Transmission Sewers Ambusher Dies Q",
      "speaker": "Landen",
      "text": "El culto debió seguirnos hasta las alcantarillas. ¡Tenemos que seguir avanzando!",
      "string_id": 2304,
      "speaker_string_id": 2379,
      "sound": "Sound/Dialogue/HumanRECamp/Human02re/HRE02-T070-LANDEN.ogg"
    },
    {
      "n": 52,
