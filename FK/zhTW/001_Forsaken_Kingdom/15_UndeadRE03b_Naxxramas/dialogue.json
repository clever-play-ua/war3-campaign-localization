      "speaker_string_id": 2961,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T840-KELTHUZAD.ogg"
    },
    {
      "n": 135,
      "id": "O01Cairne27",
      "scene": "Initialization.Dialogue Reference C040",
      "speaker": "希瓦娜斯",
      "text": "安雅已經告知我在納克薩瑪斯發生的事。",
      "string_id": 2016,
      "speaker_string_id": 2017,
      "sound": "Sound/Dialogue/OrcCampaign/Orc01/O01Cairne27.ogg"
    },
    {
      "n": 136,
      "id": "O01Cairne27",
      "scene": "Initialization.Dialogue Reference C040",
      "speaker": "希瓦娜斯",
      "text": "這場戰鬥…還有班達倫隊長的壯舉…讓我思慮甚多。",
      "string_id": 2009,
      "speaker_string_id": 2010,
      "sound": "Sound/Dialogue/OrcCampaign/Orc01/O01Cairne27.ogg"
    },
    {
      "n": 137,
      "id": "O01Cairne27",
      "scene": "Initialization.Dialogue Reference C040",
      "speaker": "希瓦娜斯",
      "text": "若不是因為加瑞克駕馭了聖光，以及銀色黎明加入我們的防線，被遺忘者恐怕已經滅亡了。",
      "string_id": 2006,
      "speaker_string_id": 2007,
      "sound": "Sound/Dialogue/OrcCampaign/Orc01/O01Cairne27.ogg"
    },
    {
      "n": 138,
      "id": "O01Cairne27",
      "scene": "Initialization.Dialogue Reference C040",
      "speaker": "希瓦娜斯",
      "text": "我們周遭的確充滿了各種活著和不死的敵人。然而，也可能有許多盟友等著我們去發掘…",
      "string_id": 2003,
      "speaker_string_id": 2004,
      "sound": "Sound/Dialogue/OrcCampaign/Orc01/O01Cairne27.ogg"
    },
    {
      "n": 139,
      "id": "O01Cairne27",
      "scene": "Initialization.Dialogue Reference C040",
      "speaker": "希瓦娜斯",
      "text": "…或許這座被遺忘者的王國無須孤軍奮鬥。",
      "string_id": 2001,
      "speaker_string_id": 2002,
      "sound": "Sound/Dialogue/OrcCampaign/Orc01/O01Cairne27.ogg"
    },
