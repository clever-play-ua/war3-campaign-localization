      "speaker_string_id": 2868,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T830-RIVENDARE.ogg"
    },
    {
      "n": 134,
      "id": "A3M2-T840-KELTHUZAD",
      "scene": "TRANSMISSIONS.Ascension.Transmission Boss Finale End KelThuzad Q",
      "speaker": "科爾蘇加德",
      "text": "這對我而言並非終局。但你們肯定到此為止了。",
