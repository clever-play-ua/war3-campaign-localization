{
  "map": "UndeadRE02_04",
  "title": "Dawns Watch",
  "locale": "zhTW",
  "order_note": "Sorted by recording id: C (cinematics), M (in-engine cutscenes), T (gameplay transmissions); unit barks follow their trigger group. Interleaving of C/M/T is not confirmed.",
  "lines": [
    {
      "n": 1,
      "id": "A2M4-C010-010-TYROSUS",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "泰羅索斯領主",
      "text": "天譴軍團找到我們了！銀色黎明，準備戰鬥！",
      "string_id": 411,
      "speaker_string_id": 412,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-010-TYROSUS.ogg"
    },
    {
      "n": 2,
      "id": "A2M4-C010-011-ANYA",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "安雅",
      "text": "我就知道事情會這樣！",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]我就知道事情會這樣！[/\"Angry\"]",
      "string_id": 852,
      "speaker_string_id": 851,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-011-ANYA.ogg"
    },
    {
      "n": 3,
      "id": "A2M4-C010-012-LEONID",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "萊尼德",
      "text": "泰羅索斯領主！這些被遺忘者由我看管。",
      "string_id": 854,
      "speaker_string_id": 853,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-012-LEONID.ogg"
    },
    {
      "n": 4,
      "id": "A2M4-C010-013-TYROSUS",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "泰羅索斯領主",
      "text": "萊尼德，感謝聖光，你回來了！至於那些不死族…",
      "raw": "[\"Surprised\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]萊尼德，感謝聖光，你回來了！至於那些不死族…[/\"Surprised\"]",
      "string_id": 856,
      "speaker_string_id": 855,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-013-TYROSUS.ogg"
    },
    {
      "n": 5,
      "id": "A2M4-C010-014-LEONID",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "萊尼德",
      "text": "他們都和我一樣。他們被血色十字軍襲擊了。",
      "string_id": 858,
      "speaker_string_id": 857,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-014-LEONID.ogg"
    },
    {
      "n": 6,
      "id": "A2M4-C010-020-TYROSUS",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "泰羅索斯領主",
      "text": "必須阻止那些瘋子。",
      "string_id": 505,
      "speaker_string_id": 506,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-020-TYROSUS.ogg"
    },
    {
      "n": 7,
      "id": "A2M4-C010-030-ANYA",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "安雅",
      "text": "你真的覺得我們會相信你們不是同一類人？",
      "string_id": 395,
      "speaker_string_id": 396,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-030-ANYA.ogg"
    },
    {
      "n": 8,
      "id": "A2M4-C010-040-TYROSUS",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "泰羅索斯領主",
      "text": "我們都曾經是白銀之手騎士。但那些想為羅德隆尋求復仇的人扭曲了教義，成為了血色十字軍。",
      "string_id": 509,
      "speaker_string_id": 510,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-040-TYROSUS.ogg"
    },
    {
      "n": 9,
      "id": "A2M4-C010-050-TYROSUS",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "泰羅索斯領主",
      "text": "而我們這些堅守真正聖光教誨的人，則是建立了銀色黎明。",
      "string_id": 513,
      "speaker_string_id": 514,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-050-TYROSUS.ogg"
    },
    {
      "n": 10,
      "id": "A2M4-C010-060-TYROSUS",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "泰羅索斯領主",
      "text": "唉，我們寡不敵眾。血色十字軍在修道院中持續壯大聲勢，我們難以在戰鬥中擊敗他們。",
      "string_id": 515,
      "speaker_string_id": 516,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-060-TYROSUS.ogg"
    },
    {
      "n": 11,
      "id": "A2M4-C010-070-GAREK",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "加瑞克",
      "text": "這座修道院…你能帶我們過去嗎？",
      "string_id": 460,
      "speaker_string_id": 461,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-070-GAREK.ogg"
    },
    {
      "n": 12,
      "id": "A2M4-C010-080-GAREK",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "加瑞克",
      "text": "你們或許沒有足夠的兵力攻入血色十字軍的要塞，但被遺忘者有。",
      "string_id": 469,
      "speaker_string_id": 470,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-080-GAREK.ogg"
    },
    {
      "n": 13,
      "id": "A2M4-C010-090-ANYA",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "安雅",
      "text": "你要我們介入他們的戰爭？",
      "string_id": 478,
      "speaker_string_id": 479,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-090-ANYA.ogg"
    },
    {
      "n": 14,
      "id": "A2M4-C010-091-GAREK",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "加瑞克",
      "text": "這場戰爭我們也會加入。血色十字軍絕對會再襲擊幽暗城。",
      "string_id": 860,
      "speaker_string_id": 859,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-091-GAREK.ogg"
    },
    {
      "n": 15,
      "id": "A2M4-C010-100-LEONID",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "萊尼德",
      "text": "我會帶你去找他們。但我不認為希瓦娜斯女士會相信銀色黎明。",
      "string_id": 487,
      "speaker_string_id": 488,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-100-LEONID.ogg"
    },
    {
      "n": 16,
      "id": "A2M4-C010-110-ANYA",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "安雅",
      "text": "她如果能信任你，都算你好運了。",
      "raw": "[\"Squint\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]她如果能信任你，都算你好運了。[/\"Squint\"]",
      "string_id": 496,
      "speaker_string_id": 497,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-110-ANYA.ogg"
    },
    {
      "n": 17,
      "id": "A2M4-C010-120-GAREK",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "加瑞克",
      "text": "就這麼說定了。願聖光指引我們。",
      "string_id": 501,
      "speaker_string_id": 502,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-C010-120-GAREK.ogg"
    },
    {
      "n": 18,
      "id": "A2M4-T010-LEONID",
      "scene": "Transmissions.Entry Transmission",
      "speaker": "萊尼德",
      "text": "銀色黎明不得不駐紮在巨魔領地中。我們必須一路殺去山上。",
      "string_id": 154,
      "speaker_string_id": 155,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-T010-LEONID.ogg"
    },
    {
      "n": 19,
      "id": "A2M4-T020-ARGENTDAWNCAPTIVE",
      "scene": "Transmissions.Survivor Soldier Transmission",
      "speaker": "步兵",
      "text": "萊尼德！巨魔擄走我們的巡守了！堡壘受到攻擊！",
      "string_id": 126,
      "speaker_string_id": 127,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-T020-ARGENTDAWNCAPTIVE.ogg"
    },
    {
      "n": 20,
      "id": "A2M4-T030-LEONID",
      "scene": "Transmissions.Survivor Soldier Transmission",
      "speaker": "萊尼德",
      "text": "什麼？！沒時間了！我們必須救出其他人，突破包圍！",
      "string_id": 146,
      "speaker_string_id": 147,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-T030-LEONID.ogg"
    },
    {
      "n": 21,
      "id": "A2M4-T060-LEONID",
      "scene": "Transmissions.Siege Transmission",
      "speaker": "萊尼德",
      "text": "聖光的恩典啊，我們趕上了！堡壘大門還沒被攻破！",
      "string_id": 258,
      "speaker_string_id": 259,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-T060-LEONID.ogg"
    },
    {
      "n": 22,
      "id": "A2M4-T070-GAREK",
      "scene": "Transmissions.Siege Transmission",
      "speaker": "加瑞克",
      "text": "他們撐不了太久的。我們必須立刻突破包圍！",
      "string_id": 260,
      "speaker_string_id": 261,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-T070-GAREK.ogg"
    },
    {
      "n": 23,
      "id": "A2M4-T080-LEONID",
      "scene": "Transmissions.Boss Defeated Transmission",
      "speaker": "萊尼德",
      "text": "突破包圍了，剩下的巨魔會逃竄到山裡。返回堡壘吧。",
      "string_id": 252,
      "speaker_string_id": 253,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-T080-LEONID.ogg"
    },
    {
      "n": 24,
      "id": "A2M4-T090-GAREK",
      "scene": "Transmissions.Introducing Leonid Transmission",
      "speaker": "加瑞克",
      "text": "該讓希瓦娜斯女士看看我們的進展了。",
      "string_id": 833,
      "speaker_string_id": 834,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-T090-GAREK.ogg"
    },
    {
      "n": 25,
      "id": "A2M4-T100-ANYA",
      "scene": "Transmissions.Introducing Leonid Transmission",
      "speaker": "安雅",
      "text": "萊尼德，你可別期待這裡會熱烈迎接你。不是每個被遺忘者都像我一樣寬容。",
      "string_id": 835,
      "speaker_string_id": 836,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre02m4/A2M4-T100-ANYA.ogg"
    },
    {
      "n": 26,
      "id": "FootmanReady1",
      "scene": "Argent Dawn Resuce.Rescue 1",
      "speaker": "步兵",
      "text": "準備行動！",
      "string_id": 912,
      "speaker_string_id": 911,
      "sound": "Units/Human/Footman/FootmanReady1.ogg"
    },
    {
      "n": 27,
      "id": "PriestYes1",
      "scene": "Argent Dawn Resuce.Rescue 2",
      "speaker": "牧師",
      "text": "我聽候差遣。",
      "string_id": 913,
      "speaker_string_id": 914,
      "sound": "Units/Human/Priest/PriestYes1.ogg"
    },
    {
      "n": 28,
      "id": "FootmanWhat4",
      "scene": "Argent Dawn Resuce.Rescue 3",
      "speaker": "步兵",
      "text": "下令吧。",
      "string_id": 915,
      "speaker_string_id": 916,
      "sound": "Units/Human/Footman/FootmanWhat4.ogg"
    },
    {
      "n": 29,
      "id": "RiflemanReady1",
      "scene": "Argent Dawn Resuce.Rescue 4",
      "speaker": "步槍兵",
      "text": "彈藥上膛，隨時上陣！",
      "string_id": 917,
      "speaker_string_id": 918,
      "sound": "Units/Human/Rifleman/RiflemanReady1.ogg"
    }
  ]
}