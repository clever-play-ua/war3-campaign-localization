{
  "map": "UndeadRE03b",
  "title": "Naxxramas",
  "locale": "zhCN",
  "order_note": "Sorted by recording id: C (cinematics), M (in-engine cutscenes), T (gameplay transmissions); unit barks follow their trigger group. Interleaving of C/M/T is not confirmed.",
  "lines": [
    {
      "n": 1,
      "id": "A3M2-C010-010-ILASTAR",
      "scene": "Initialization.Dialogue Reference C010",
      "speaker": "伊拉斯塔",
      "text": "你真让我失望，加瑞克。要不要我来帮忙找回一些记忆……",
      "string_id": 1495,
      "speaker_string_id": 1496,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C010-010-ILASTAR.ogg"
    },
    {
      "n": 2,
      "id": "A3M2-C010-060-GAREK",
      "scene": "Initialization.Dialogue Reference C010",
      "speaker": "加瑞克",
      "text": "不！从我的脑子里……滚出去……",
      "string_id": 1506,
      "speaker_string_id": 1507,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C010-060-GAREK.ogg"
    },
    {
      "n": 3,
      "id": "A3M2-C010-080-ILASTAR",
      "scene": "Initialization.Dialogue Reference C010",
      "speaker": "伊拉斯塔",
      "text": "这是怎么回事？你们在纳克萨玛斯各处安装了炸弹？",
      "raw": "[\"Squint\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]这是怎么回事？你们在纳克萨玛斯各处安装了炸弹？[/\"Squint\"]",
      "string_id": 1515,
      "speaker_string_id": 1516,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C010-080-ILASTAR.ogg"
    },
    {
      "n": 4,
      "id": "A3M2-C010-090-ANYA",
      "scene": "Initialization.Dialogue Reference C010",
      "speaker": "恩雅",
      "text": "住手！你们在干什么？！",
      "raw": "[\"Surprised\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]住手！你们在干什么？！[/\"Surprised\"]",
      "string_id": 1524,
      "speaker_string_id": 1525,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C010-090-ANYA.ogg"
    },
    {
      "n": 5,
      "id": "A3M2-C010-100-ILASTAR",
      "scene": "Initialization.Dialogue Reference C010",
      "speaker": "伊拉斯塔",
      "text": "我要碾碎你们那可悲的获胜希望。",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.55]我要碾碎你们那可悲的获胜希望。[/\"Angry\"]",
      "string_id": 1533,
      "speaker_string_id": 1534,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C010-100-ILASTAR.ogg"
    },
    {
      "n": 6,
      "id": "A3M2-C010-110-LEONID",
      "scene": "Initialization.Dialogue Reference C010",
      "speaker": "莱尼德",
      "text": "不！你这污秽的恶棍！",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.55]不！你这污秽的恶棍！[/\"Angry\"]",
      "string_id": 1542,
      "speaker_string_id": 1543,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C010-110-LEONID.ogg"
    },
    {
      "n": 7,
      "id": "A3M2-C010-140-ILASTAR",
      "scene": "Initialization.Dialogue Reference C010",
      "speaker": "伊拉斯塔",
      "text": "看来你们三个死脑筋就是不愿意为巫妖王效命。真是遗憾。",
      "raw": "[\"Squint\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]看来你们三个死脑筋就是不愿意为巫妖王效命。真是遗憾。[/\"Squint\"]",
      "string_id": 1551,
      "speaker_string_id": 1552,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C010-140-ILASTAR.ogg"
    },
    {
      "n": 8,
      "id": "A3M2-C010-150-ILASTAR",
      "scene": "Initialization.Dialogue Reference C010",
      "speaker": "伊拉斯塔",
      "text": "加瑞克，杀了他们，然后再杀了你自己。",
      "string_id": 1560,
      "speaker_string_id": 1561,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C010-150-ILASTAR.ogg"
    },
    {
      "n": 9,
      "id": "A3M2-C020-010-KELTHUZAD",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "克尔苏加德",
      "text": "看来我们的不速之客终于决定来觐见我了。",
      "raw": "[\"Squint\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]看来我们的不速之客终于决定来觐见我了。[/\"Squint\"]",
      "string_id": 1582,
      "speaker_string_id": 1583,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-010-KELTHUZAD.ogg"
    },
    {
      "n": 10,
      "id": "A3M2-C020-020-KELTHUZAD",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "克尔苏加德",
      "text": "真遗憾，你们来的并不是时候。我现在手头有很多事要忙……",
      "string_id": 1585,
      "speaker_string_id": 1586,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-020-KELTHUZAD.ogg"
    },
    {
      "n": 11,
      "id": "A3M2-C020-030-KELTHUZAD",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "克尔苏加德",
      "text": "忙着抹除幽暗城。",
      "string_id": 1625,
      "speaker_string_id": 1626,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-030-KELTHUZAD.ogg"
    },
    {
      "n": 12,
      "id": "A3M2-C020-040-LEONID",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "莱尼德",
      "text": "克尔苏加德！你要为你对洛丹伦犯下的罪行付出代价！",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.55]克尔苏加德！你要为你对洛丹伦犯下的罪行付出代价！[/\"Angry\"]",
      "string_id": 1633,
      "speaker_string_id": 1634,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-040-LEONID.ogg"
    },
    {
      "n": 13,
      "id": "A3M2-C020-050-ANYA",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "恩雅",
      "text": "还有奎尔萨拉斯的沦亡！",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.55]还有奎尔萨拉斯的沦亡！[/\"Angry\"]",
      "string_id": 1621,
      "speaker_string_id": 1622,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-050-ANYA.ogg"
    },
    {
      "n": 14,
      "id": "A3M2-C020-060-KELTHUZAD",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "克尔苏加德",
      "text": "真有趣。但你们这群乌合之众根本不值得我费心。",
      "raw": "[\"Squint\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]真有趣。但你们这群乌合之众根本不值得我费心。[/\"Squint\"]",
      "string_id": 3000,
      "speaker_string_id": 2999,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-060-KELTHUZAD.ogg"
    },
    {
      "n": 15,
      "id": "A3M2-C020-070-KELTHUZAD",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "克尔苏加德",
      "text": "瑞文戴尔！你也该出点力，处理掉这几只小害虫。",
      "string_id": 1611,
      "speaker_string_id": 1612,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-070-KELTHUZAD.ogg"
    },
    {
      "n": 16,
      "id": "A3M2-C020-080-GAREK",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "加瑞克",
      "text": "瑞文戴尔男爵……",
      "string_id": 1662,
      "speaker_string_id": 1663,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-080-GAREK.ogg"
    },
    {
      "n": 17,
      "id": "A3M2-C020-090-RIVENDARE",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "瑞文戴尔男爵",
      "text": "是你……胆敢在斯坦索姆咬了我一口的小老鼠。还真是踏破铁鞋无觅处啊。",
      "raw": "[\"Angry\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.55]是你……胆敢在斯坦索姆咬了我一口的小老鼠。还真是踏破铁鞋无觅处啊。[/\"Angry\"]",
      "string_id": 1664,
      "speaker_string_id": 1665,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-090-RIVENDARE.ogg"
    },
    {
      "n": 18,
      "id": "A3M2-C020-100-RIVENDARE",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "瑞文戴尔男爵",
      "text": "现在我可以跟你好好算算账了。",
      "raw": "[\"Happy\" type=quad v2=3 v3=3.0 easein=0.25 easeout=0.25]现在我可以跟你好好算算账了。[/\"Happy\"]",
      "string_id": 1673,
      "speaker_string_id": 1674,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-100-RIVENDARE.ogg"
    },
    {
      "n": 19,
      "id": "A3M2-C020-110-GAREK",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "加瑞克",
      "text": "我们的账早就算清了。这一次，我不是来复仇的。",
      "string_id": 1685,
      "speaker_string_id": 1686,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-110-GAREK.ogg"
    },
    {
      "n": 20,
      "id": "A3M2-C020-120-GAREK",
      "scene": "Initialization.Dialogue Reference C020",
      "speaker": "加瑞克",
      "text": "我是来这里保护被遗忘者的。",
      "string_id": 1694,
      "speaker_string_id": 1695,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C020-120-GAREK.ogg"
    },
    {
      "n": 21,
      "id": "A3M2-C030-010-ANYA",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "恩雅",
      "text": "现在要怎么办？没有炸弹，我们要如何摧毁那块水晶，不让它再发出下一击？",
      "string_id": 1705,
      "speaker_string_id": 1706,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-010-ANYA.ogg"
    },
    {
      "n": 22,
      "id": "A3M2-C030-020-GAREK",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "加瑞克",
      "text": "我们还有……另一个东西……威力足够将其摧毁。",
      "string_id": 1934,
      "speaker_string_id": 1935,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-020-GAREK.ogg"
    },
    {
      "n": 23,
      "id": "A3M2-C030-025-GAREK",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "加瑞克",
      "text": "圣光。",
      "string_id": 1950,
      "speaker_string_id": 1951,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-025-GAREK.ogg"
    },
    {
      "n": 24,
      "id": "A3M2-C030-030-ANYA",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "恩雅",
      "text": "不行。我不能让你活活被圣火吞没。",
      "raw": "[\"Surprised\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]不行。我不能让你活活被圣火吞没。[/\"Surprised\"]",
      "string_id": 1932,
      "speaker_string_id": 1933,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-030-ANYA.ogg"
    },
    {
      "n": 25,
      "id": "A3M2-C030-040-GAREK",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "加瑞克",
      "text": "恩雅，没有别的办法了。圣光需要我们……去保护那些还活着的人……可以这么说吧。",
      "string_id": 1920,
      "speaker_string_id": 1921,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-040-GAREK.ogg"
    },
    {
      "n": 26,
      "id": "A3M2-C030-050-GAREK",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "加瑞克",
      "text": "我们都……在活着时失去了很多珍视的人……又在成为亡灵后拥有了一些新的东西。我一定会保护它……不计一切代价。",
      "string_id": 1912,
      "speaker_string_id": 1913,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-050-GAREK.ogg"
    },
    {
      "n": 27,
      "id": "A3M2-C030-060-GAREK",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "加瑞克",
      "text": "这不是为了圣光……而是为了……被遗忘者。",
      "string_id": 1906,
      "speaker_string_id": 1907,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-060-GAREK.ogg"
    },
    {
      "n": 28,
      "id": "A3M2-C030-070-LEONID",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "莱尼德",
      "text": "我在从前认识很多圣骑士。但他们并不都是英雄。而你，加瑞克，我会永远记得你，尊敬你。",
      "string_id": 1892,
      "speaker_string_id": 1893,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-070-LEONID.ogg"
    },
    {
      "n": 29,
      "id": "A3M2-C030-080-LEONID",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "莱尼德",
      "text": "愿圣光与您同在，我的朋友。",
      "string_id": 1886,
      "speaker_string_id": 1887,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-080-LEONID.ogg"
    },
    {
      "n": 30,
      "id": "A3M2-C030-090-ANYA",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "恩雅",
      "text": "早知道我就让普特雷斯把你拆了当零件用。",
      "raw": "[\"Sad\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]早知道我就让普特雷斯把你拆了当零件用。[/\"Sad\"]",
      "string_id": 1876,
      "speaker_string_id": 1877,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-090-ANYA.ogg"
    },
    {
      "n": 31,
      "id": "A3M2-C030-100-GAREK",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "加瑞克",
      "text": "安雅，请守护幽暗城。我不会是……最后一个……刚刚苏醒，需要指引的人。",
      "raw": "[\"Happy\" type=quad v2=3 v3=3.0 easein=0.25 easeout=0.25]安雅，请守护幽暗城。我不会是……最后一个……刚刚苏醒，需要指引的人。[/\"Happy\"]",
      "string_id": 1866,
      "speaker_string_id": 1867,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-100-GAREK.ogg"
    },
    {
      "n": 32,
      "id": "A3M2-C030-110-ANYA",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "恩雅",
      "text": "嗯，你不是。多亏了你，被遗忘者能够存续下去了。",
      "raw": "[\"Sad\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]嗯，你不是。多亏了你，被遗忘者能够存续下去了。[/\"Sad\"]",
      "string_id": 1856,
      "speaker_string_id": 1857,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-110-ANYA.ogg"
    },
    {
      "n": 33,
      "id": "A3M2-C030-120-GAREK",
      "scene": "Initialization.Dialogue Reference C030",
      "speaker": "加瑞克",
      "text": "那才是真正的胜利。千万不要本末倒置了。",
      "raw": "[\"Happy\" type=quad v2=3 v3=3.0 easein=0.25 easeout=0.25]那才是真正的胜利。千万不要本末倒置了。[/\"Happy\"]",
      "string_id": 1844,
      "speaker_string_id": 1845,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-C030-120-GAREK.ogg"
    },
    {
      "n": 34,
      "id": "A3M2-M010-010-GAREK",
      "scene": "Initialization.Dialogue Reference M010",
      "speaker": "加瑞克",
      "text": "记住我们的计划。迅速突入浮空城，安装炸弹，然后回到空艇上再引爆。",
      "string_id": 1358,
      "speaker_string_id": 1359,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M010-010-GAREK.ogg"
    },
    {
      "n": 35,
      "id": "A3M2-M010-020-LEONID",
      "scene": "Initialization.Dialogue Reference M010",
      "speaker": "莱尼德",
      "text": "前方会遭遇激烈抵抗，做好准备。许多天灾军团的精英部队驻守在这些大厅里。",
      "string_id": 1367,
      "speaker_string_id": 1368,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M010-020-LEONID.ogg"
    },
    {
      "n": 36,
      "id": "A3M2-M010-030-ANYA",
      "scene": "Initialization.Dialogue Reference M010",
      "speaker": "恩雅",
      "text": "那被遗忘者也派出了精英部队来完成这个任务，也算是分庭抗礼了。",
      "string_id": 1376,
      "speaker_string_id": 1377,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M010-030-ANYA.ogg"
    },
    {
      "n": 37,
      "id": "A3M2-M010-040-ANYA",
      "scene": "Initialization.Dialogue Reference M010",
      "speaker": "恩雅",
      "text": "而且还有银色黎明的人。",
      "raw": "[\"Squint\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]而且还有银色黎明的人。[/\"Squint\"]",
      "string_id": 1385,
      "speaker_string_id": 1386,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M010-040-ANYA.ogg"
    },
    {
      "n": 38,
      "id": "A3M2-M010-050-LEONID",
      "scene": "Initialization.Dialogue Reference M010",
      "speaker": "莱尼德",
      "text": "我会尽我所能，证明自己配得上做你的战友。",
      "string_id": 1394,
      "speaker_string_id": 1395,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M010-050-LEONID.ogg"
    },
    {
      "n": 39,
      "id": "A3M2-M010-060-GAREK",
      "scene": "Initialization.Dialogue Reference M010",
      "speaker": "加瑞克",
      "text": "你已经证明了，莱尼德。现在我们走吧。",
      "string_id": 1403,
      "speaker_string_id": 1404,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M010-060-GAREK.ogg"
    },
    {
      "n": 40,
      "id": "A3M2-M020-010-GAREK",
      "scene": "Initialization.Dialogue Reference M020",
      "speaker": "加瑞克",
      "text": "不管这地方是用来干什么的，戒备实在是太森严了。我们安装最后一枚炸药吧。",
      "string_id": 1412,
      "speaker_string_id": 1413,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M020-010-GAREK.ogg"
    },
    {
      "n": 41,
      "id": "A3M2-M020-020-ILASTAR",
      "scene": "Initialization.Dialogue Reference M020",
      "speaker": "伊拉斯塔",
      "text": "是我听错了吗？难道那是加瑞克·班达隆？",
      "string_id": 1421,
      "speaker_string_id": 1422,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M020-020-ILASTAR.ogg"
    },
    {
      "n": 42,
      "id": "A3M2-M020-030-GAREK",
      "scene": "Initialization.Dialogue Reference M020",
      "speaker": "加瑞克",
      "text": "你是谁？你怎么会知道我的名字？",
      "raw": "[\"Surprised\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]你是谁？你怎么会知道我的名字？[/\"Surprised\"]",
      "string_id": 1430,
      "speaker_string_id": 1431,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M020-030-GAREK.ogg"
    },
    {
      "n": 43,
      "id": "A3M2-M020-040-ILASTAR",
      "scene": "Initialization.Dialogue Reference M020",
      "speaker": "伊拉斯塔",
      "text": "你不记得我了吗？",
      "raw": "[\"Happy\" type=quad v2=3 v3=3.0 easein=0.25 easeout=0.25]你不记得我了吗？[/\"Happy\"]",
      "string_id": 1439,
      "speaker_string_id": 1440,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M020-040-ILASTAR.ogg"
    },
    {
      "n": 44,
      "id": "A3M2-M020-045-ILASTAR",
      "scene": "Initialization.Dialogue Reference M020",
      "speaker": "伊拉斯塔",
      "text": "我是伊拉斯塔·咏风，而你赐给了我最大的恩惠。我的死亡。",
      "raw": "[\"Happy\" type=quad v2=3 v3=3.0 easein=0.25 easeout=0.25]我是伊拉斯塔·咏风，而你赐给了我最大的恩惠。我的死亡。[/\"Happy\"]",
      "string_id": 1448,
      "speaker_string_id": 1449,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M020-045-ILASTAR.ogg"
    },
    {
      "n": 45,
      "id": "A3M2-M020-050-GAREK",
      "scene": "Initialization.Dialogue Reference M020",
      "speaker": "伊拉斯塔",
      "text": "伊拉斯塔？你……你在说什么？",
      "raw": "[\"Surprised\" type=quad v2=0.5 v3=0.5 easein=0.45 easeout=0.45]伊拉斯塔？你……你在说什么？[/\"Surprised\"]",
      "string_id": 1457,
      "speaker_string_id": 1458,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M020-050-GAREK.ogg"
    },
    {
      "n": 46,
      "id": "A3M2-M020-060-ILASTAR",
      "scene": "Initialization.Dialogue Reference M020",
      "speaker": "伊拉斯塔",
      "text": "因为你，我重生为了亡灵。成为了执行巫妖王意志的工具！而现在，你应该也沐浴同样的荣光。",
      "string_id": 1466,
      "speaker_string_id": 1467,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M020-060-ILASTAR.ogg"
    },
    {
      "n": 47,
      "id": "A3M2-M020-070-ANYA",
      "scene": "Initialization.Dialogue Reference M020",
      "speaker": "恩雅",
      "text": "我一定会很享受用箭射穿你的喉咙。",
      "string_id": 1477,
      "speaker_string_id": 1478,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M020-070-ANYA.ogg"
    },
    {
      "n": 48,
      "id": "A3M2-M020-080-ILASTAR",
      "scene": "Initialization.Dialogue Reference M020",
      "speaker": "伊拉斯塔",
      "text": "加瑞克，你现在怎么结交了一群如此不堪的朋友。没关系。如果你不打算低头，那我就让你跪倒。",
      "raw": "[\"Happy\" type=quad v2=3 v3=3.0 easein=0.25 easeout=0.25]加瑞克，你现在怎么结交了一群如此不堪的朋友。没关系。如果你不打算低头，那我就让你跪倒。[/\"Happy\"]",
      "string_id": 1486,
      "speaker_string_id": 1487,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-M020-080-ILASTAR.ogg"
    },
    {
      "n": 49,
      "id": "A3M2-T010-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Arach AlwaysSpiders Q",
      "speaker": "加瑞克",
      "text": "为什么非得是蜘蛛呢？",
      "string_id": 2108,
      "speaker_string_id": 2928,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T010-GAREK.ogg"
    },
    {
      "n": 50,
      "id": "A3M2-T020-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Arach AlwaysSpiders Q",
      "speaker": "莱尼德",
      "text": "我们最该操心的东西很快就不是这些生物了。",
      "string_id": 2113,
      "speaker_string_id": 2114,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T020-LEONID.ogg"
    },
    {
      "n": 51,
      "id": "A3M2-T030-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Arach Gate Q NOT USED",
      "speaker": "恩雅",
      "text": "这里有些门似乎只能从一侧打开。我们得想办法绕过去。",
      "string_id": 2925,
      "speaker_string_id": 2142,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T030-ANYA.ogg"
    },
    {
      "n": 52,
      "id": "A3M2-T040-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Arach KillNerubian Q",
      "speaker": "加瑞克",
      "text": "杀死那只蛛魔，不要让它用蛛网黏住我们。",
      "string_id": 2927,
      "speaker_string_id": 2150,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T040-GAREK.ogg"
    },
    {
      "n": 53,
      "id": "A3M2-T050-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Arach FirstExplosive Q",
      "speaker": "莱尼德",
      "text": "我们应该在这里安装炸药。先肃清这片区域的敌人！",
      "string_id": 2945,
      "speaker_string_id": 2160,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T050-LEONID.ogg"
    },
    {
      "n": 54,
      "id": "A3M2-T060-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss CryptLord Start Q",
      "speaker": "恩雅",
      "text": "有埋伏！大家各自小心！",
      "string_id": 2141,
      "speaker_string_id": 2171,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T060-ANYA.ogg"
    },
    {
      "n": 55,
      "id": "A3M2-T070-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss CryptLord End Q",
      "speaker": "加瑞克",
      "text": "我们已经攻下了这个区域！快安装炸药，然后继续推进！",
      "string_id": 2149,
      "speaker_string_id": 2200,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T070-GAREK.ogg"
    },
    {
      "n": 56,
      "id": "A3M2-T080-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons MeatWagonAttack Q",
      "speaker": "莱尼德",
      "text": "浮空城的这个区域是用来组装血肉魔像和其他憎恶的。",
      "string_id": 2159,
      "speaker_string_id": 2224,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T080-LEONID.ogg"
    },
    {
      "n": 57,
      "id": "A3M2-T090-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons MeatWagonAttack Q",
      "speaker": "恩雅",
      "text": "那我们应该趁路过这里，把它们拆掉。",
      "string_id": 2170,
      "speaker_string_id": 2250,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T090-ANYA.ogg"
    },
    {
      "n": 58,
      "id": "A3M2-T100-DEATHGUARD",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons CagedPrisonerApproach Q",
      "speaker": "亡灵卫兵",
      "text": "班达隆队长，是你吗？！救救我们！",
      "string_id": 2180,
      "speaker_string_id": 2181,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T100-DEATHGUARD.ogg"
    },
    {
      "n": 59,
      "id": "A3M2-T110-DEATHGUARD",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons CagedPrisoner Q",
      "speaker": "亡灵卫兵",
      "text": "谢谢你，长官！天灾军团在下面的战斗中抓住了我们和其他一些俘虏。",
      "string_id": 2188,
      "speaker_string_id": 2189,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T110-DEATHGUARD.ogg"
    },
    {
      "n": 60,
      "id": "ForsakenDeathguard_Attack2",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons CagedPrisoner Q",
      "speaker": "亡灵卫兵",
      "text": "敌人终将灭亡！",
      "string_id": 3032,
      "speaker_string_id": 3031,
      "sound": "Units/Undead/ForsakenDeathguard/ForsakenDeathguard_Attack2.ogg"
    },
    {
      "n": 61,
      "id": "ForsakenDeathguard_Ready1",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons CagedPrisoner Q",
      "speaker": "亡灵卫兵",
      "text": "准备作战！",
      "string_id": 3033,
      "speaker_string_id": 3034,
      "sound": "Units/Undead/ForsakenDeathguard/ForsakenDeathguard_Ready1.ogg"
    },
    {
      "n": 62,
      "id": "ForsakenDeathguard_Warcry1",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons CagedPrisoner Q",
      "speaker": "亡灵卫兵",
      "text": "胜利属于希尔瓦娜斯！",
      "string_id": 3035,
      "speaker_string_id": 3036,
      "sound": "Units/Undead/ForsakenDeathguard/ForsakenDeathguard_Warcry1.ogg"
    },
    {
      "n": 63,
      "id": "A3M2-T120-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons CagedPrisoner Q",
      "speaker": "加瑞克",
      "text": "我们一定会找到他们，把他们解救出来。亡灵卫兵们，跟我们走！",
      "string_id": 2199,
      "speaker_string_id": 2325,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T120-GAREK.ogg"
    },
    {
      "n": 64,
      "id": "A3M2-T130-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons GateNotFromHere Q",
      "speaker": "莱尼德",
      "text": "我记得这扇门。开门的开关应该就在附近。",
      "string_id": 2881,
      "speaker_string_id": 2317,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T130-LEONID.ogg"
    },
    {
      "n": 65,
      "id": "A3M2-T140-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons MassArmy GateOpen Q",
      "speaker": "莱尼德",
      "text": "这样应该就开门了。而且听声音似乎有敌情。",
      "string_id": 2223,
      "speaker_string_id": 2336,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T140-LEONID.ogg"
    },
    {
      "n": 66,
      "id": "A3M2-T150-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons WhoIsKelThuzad Q",
      "speaker": "加瑞克",
      "text": "这座浮空城的主人，克尔苏加德……他是谁？",
      "string_id": 2466,
      "speaker_string_id": 2368,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T150-GAREK.ogg"
    },
    {
      "n": 67,
      "id": "A3M2-T160-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons WhoIsKelThuzad Q",
      "speaker": "莱尼德",
      "text": "就是将亡灵瘟疫散播到洛丹伦的通灵师。阿尔萨斯王子杀死了他，但后来又将他复活成为一名巫妖。",
      "string_id": 2991,
      "speaker_string_id": 2436,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T160-LEONID.ogg"
    },
    {
      "n": 68,
      "id": "A3M2-T170-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons WhoIsKelThuzad Q",
      "speaker": "恩雅",
      "text": "为了实现自己的阴谋，他屠杀了我的族人，还亵渎了太阳之井。克尔苏加德重生的背后，是我的王国的血债。",
      "string_id": 2249,
      "speaker_string_id": 2261,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T170-ANYA.ogg"
    },
    {
      "n": 69,
      "id": "A3M2-T180-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons WhoIsKelThuzad Q",
      "speaker": "恩雅",
      "text": "我绝不会允许幽暗城也落入他们手里。我在活着时辜负了我的同胞。现在为了保护被遗忘者，我愿意付出一切。",
      "string_id": 2260,
      "speaker_string_id": 2282,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T180-ANYA.ogg"
    },
    {
      "n": 70,
      "id": "A3M2-T190-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons CorpseTitan See Q",
      "speaker": "莱尼德",
      "text": "这里就是安装下一颗炸弹的位置。",
      "string_id": 2287,
      "speaker_string_id": 2288,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T190-LEONID.ogg"
    },
    {
      "n": 71,
      "id": "A3M2-T200-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cons CorpseTitan See Q",
      "speaker": "恩雅",
      "text": "那我们就解决掉那个怪物，完成任务。",
      "string_id": 2281,
      "speaker_string_id": 2305,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T200-ANYA.ogg"
    },
    {
      "n": 72,
      "id": "A3M2-T210-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss CorpseTitan End Q",
      "speaker": "加瑞克",
      "text": "真是个大家伙。大家都还好吧？",
      "string_id": 2295,
      "speaker_string_id": 2296,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T210-GAREK.ogg"
    },
    {
      "n": 73,
      "id": "A3M2-T220-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss CorpseTitan End Q",
      "speaker": "恩雅",
      "text": "还行吧。我们来安装炸弹，然后继续前进。",
      "string_id": 2304,
      "speaker_string_id": 2360,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T220-ANYA.ogg"
    },
    {
      "n": 74,
      "id": "A3M2-T230-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje UndeadOrcs Q",
      "speaker": "莱尼德",
      "text": "天灾军团居然也将兽人唤醒为亡灵了。他们应该会成为令人闻风丧胆的死亡骑士。",
      "string_id": 2316,
      "speaker_string_id": 2497,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T230-LEONID.ogg"
    },
    {
      "n": 75,
      "id": "A3M2-T240-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje GiantAttack Q",
      "speaker": "加瑞克",
      "text": "那只骷髅……真是巨大无比！",
      "string_id": 2324,
      "speaker_string_id": 2395,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T240-GAREK.ogg"
    },
    {
      "n": 76,
      "id": "A3M2-T250-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje GiantAttack Q",
      "speaker": "莱尼德",
      "text": "我觉得比拼蛮力的话，我们加一块都不是他的对手。必须智取。",
      "string_id": 2335,
      "speaker_string_id": 2516,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T250-LEONID.ogg"
    },
    {
      "n": 77,
      "id": "A3M2-T260-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje GiantGate Open Q",
      "speaker": "恩雅",
      "text": "这扇门需要钥匙才能打开。我打赌钥匙就在那只笨重的骷髅身上。",
      "string_id": 2359,
      "speaker_string_id": 2378,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T260-ANYA.ogg"
    },
    {
      "n": 78,
      "id": "A3M2-T280-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje GiantSkeletonHint Q",
      "speaker": "加瑞克",
      "text": "这片火焰……如果我们可以把那只骷髅困在里面，应该就能打败它。",
      "string_id": 2367,
      "speaker_string_id": 2467,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T280-GAREK.ogg"
    },
    {
      "n": 79,
      "id": "A3M2-T290-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje Giant Key Q",
      "speaker": "恩雅",
      "text": "守护者已经被消灭了。快，拿到它的钥匙，然后我们就能继续前进了。",
      "string_id": 2377,
      "speaker_string_id": 2413,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T290-ANYA.ogg"
    },
    {
      "n": 80,
      "id": "A3M2-T300-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje WarriorsVsRejects1 Q",
      "speaker": "莱尼德",
      "text": "天灾军团充分地展现出他们的堕落和邪恶。真希望我能用圣光将他们尽数歼灭。",
      "string_id": 2993,
      "speaker_string_id": 2542,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T300-LEONID.ogg"
    },
    {
      "n": 81,
      "id": "A3M2-T310-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje WarriorsVsRejects1 Q",
      "speaker": "加瑞克",
      "text": "圣光能照耀到这里吗？我们四周尽是死亡和黑暗。",
      "string_id": 2394,
      "speaker_string_id": 2486,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T310-GAREK.ogg"
    },
    {
      "n": 82,
      "id": "A3M2-T320-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje WarriorsVsRejects1 Q",
      "speaker": "莱尼德",
      "text": "没有圣光照耀不到的地方。我们只需要保持信仰。",
      "string_id": 2435,
      "speaker_string_id": 2561,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T320-LEONID.ogg"
    },
    {
      "n": 83,
      "id": "A3M2-T330-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Reje WarriorsVsRejects1 Q",
      "speaker": "恩雅",
      "text": "作为一个会被圣光烧成焦炭的人，你的说法还真是有胆。",
      "string_id": 2412,
      "speaker_string_id": 2444,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T330-ANYA.ogg"
    },
    {
      "n": 84,
      "id": "A3M2-T340-ZELIEK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss DeathKnight Start Q",
      "speaker": "瑟里耶克爵士",
      "text": "回头吧，入侵者！否则我将不得不杀死你！",
      "string_id": 2422,
      "speaker_string_id": 2423,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T340-ZELIEK.ogg"
    },
    {
      "n": 85,
      "id": "A3M2-T350-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss DeathKnight Start Q",
      "speaker": "莱尼德",
      "text": "瑟里耶克爵士……他曾经是一名白银之手圣骑士！",
      "string_id": 2429,
      "speaker_string_id": 2430,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T350-LEONID.ogg"
    },
    {
      "n": 86,
      "id": "A3M2-T360-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss DeathKnight Start Q",
      "speaker": "恩雅",
      "text": "而现在他挡在我们面前。",
      "string_id": 2443,
      "speaker_string_id": 2524,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T360-ANYA.ogg"
    },
    {
      "n": 87,
      "id": "A3M2-T370-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss DeathKnight LightAbilities Q",
      "speaker": "莱尼德",
      "text": "你居然以天灾亡灵之身操使圣光？这简直是亵渎！",
      "string_id": 2652,
      "speaker_string_id": 2653,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T370-LEONID.ogg"
    },
    {
      "n": 88,
      "id": "A3M2-T380-ZELIEK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss DeathKnight LightAbilities Q",
      "speaker": "瑟里耶克爵士",
      "text": "我祈祷圣光能将我摧毁。那样我就终于能从我主人的差遣下解脱了。",
      "string_id": 2464,
      "speaker_string_id": 2465,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T380-ZELIEK.ogg"
    },
    {
      "n": 89,
      "id": "A3M2-T390-ZELIEK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss DeathKnight End Q",
      "speaker": "瑟里耶克爵士",
      "text": "只有圣光……能将我从奴役中……解脱出来……",
      "string_id": 2476,
      "speaker_string_id": 2477,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T390-ZELIEK.ogg"
    },
    {
      "n": 90,
      "id": "A3M2-T400-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss DeathKnight End Q",
      "speaker": "加瑞克",
      "text": "即便以亡灵之身，他也能召唤圣光……",
      "string_id": 2485,
      "speaker_string_id": 2505,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T400-GAREK.ogg"
    },
    {
      "n": 91,
      "id": "A3M2-T410-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss DeathKnight End Q",
      "speaker": "莱尼德",
      "text": "天灾军团会再次将他唤醒，并继续将他的信仰歪曲成痛苦。瑟里耶克爵士不应沦落至如此悲惨的下场。",
      "string_id": 2496,
      "speaker_string_id": 2706,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T410-LEONID.ogg"
    },
    {
      "n": 92,
      "id": "A3M2-T420-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss PlagueBeast Start Q",
      "speaker": "加瑞克",
      "text": "那到底是什么鬼东西？",
      "string_id": 2504,
      "speaker_string_id": 2532,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T420-GAREK.ogg"
    },
    {
      "n": 93,
      "id": "A3M2-T430-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss PlagueBeast Start Q",
      "speaker": "莱尼德",
      "text": "又一场扭曲实验的产物。杀了它，这样我们才能安装下一枚炸弹。",
      "string_id": 2515,
      "speaker_string_id": 2882,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T430-LEONID.ogg"
    },
    {
      "n": 94,
      "id": "A3M2-T440-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss PlagueBeast End Q",
      "speaker": "恩雅",
      "text": "真是恶心的生物。我们快安装好炸弹，离这堆污物越远越好。",
      "string_id": 2523,
      "speaker_string_id": 2693,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T440-ANYA.ogg"
    },
    {
      "n": 95,
      "id": "A3M2-T450-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Plag Multigates1 Q",
      "speaker": "加瑞克",
      "text": "当心！",
      "string_id": 2531,
      "speaker_string_id": 2550,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T450-GAREK.ogg"
    },
    {
      "n": 96,
      "id": "A3M2-T460-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Plag Multigates2 Q",
      "speaker": "莱尼德",
      "text": "这些门由一连串开关所控制。我们必须按正确的顺序依次打开开关。",
      "string_id": 2541,
      "speaker_string_id": 2992,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T460-LEONID.ogg"
    },
    {
      "n": 97,
      "id": "A3M2-T470-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Arach SkyBarge Q NOT USED",
      "speaker": "恩雅",
      "text": "如果到了离开的时候，这扇门可以让我们回到空艇处。",
      "string_id": 2904,
      "speaker_string_id": 2724,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T470-ANYA.ogg"
    },
    {
      "n": 98,
      "id": "A3M2-T480-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cath CathedralEnter Q",
      "speaker": "加瑞克",
      "text": "这是什么？看上去像是一座教堂。",
      "string_id": 2549,
      "speaker_string_id": 2642,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T480-GAREK.ogg"
    },
    {
      "n": 99,
      "id": "A3M2-T490-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Cath CathedralEnter Q",
      "speaker": "莱尼德",
      "text": "天灾军团的渎神之举难道没有下限吗？",
      "string_id": 2560,
      "speaker_string_id": 2994,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T490-LEONID.ogg"
    },
    {
      "n": 100,
      "id": "A3M2-T500-ILASTAR",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar MindControl Anya Q",
      "speaker": "伊拉斯塔",
      "text": "黑暗游侠，像我一样接受真相吧。奎尔萨拉斯已经沦亡，太阳之井也已不复存在。天灾军团现在才是我们的未来！",
      "string_id": 2572,
      "speaker_string_id": 2573,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T500-ILASTAR.ogg"
    },
    {
      "n": 101,
      "id": "A3M2-T510-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar MindControl Anya Q",
      "speaker": "恩雅",
      "text": "我的未来是属于被遗忘者的！你的未来将注定烂在泥里！",
      "string_id": 2580,
      "speaker_string_id": 2581,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T510-ANYA.ogg"
    },
    {
      "n": 102,
      "id": "A3M2-T520-ILASTAR",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar MindControl Leonid Q",
      "speaker": "伊拉斯塔",
      "text": "莱尼德·巴萨罗梅，当年作为天灾军团的一员，你展现出了巨大的潜力。只可惜你居然选择与活人为伍，真是浪费天赋。",
      "string_id": 2590,
      "speaker_string_id": 2591,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T520-ILASTAR.ogg"
    },
    {
      "n": 103,
      "id": "A3M2-T530-LEONID",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar MindControl Leonid Q",
      "speaker": "莱尼德",
      "text": "银色黎明让我对圣光的信仰重获新生。他们的勇气定能击败你的黑暗主子！",
      "string_id": 2601,
      "speaker_string_id": 2602,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T530-LEONID.ogg"
    },
    {
      "n": 104,
      "id": "A3M2-T540-ILASTAR",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar ShadowClones Q",
      "speaker": "伊拉斯塔",
      "text": "你要面对的不是我，而是你自己的迟疑和软弱！",
      "string_id": 2611,
      "speaker_string_id": 2612,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T540-ILASTAR.ogg"
    },
    {
      "n": 105,
      "id": "A3M2-T550-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar ShadowClones Q",
      "speaker": "加瑞克",
      "text": "他们只是幻影！消灭他们，集中攻击伊拉斯塔！",
      "string_id": 2620,
      "speaker_string_id": 2621,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T550-GAREK.ogg"
    },
    {
      "n": 106,
      "id": "A3M2-T560-ILASTAR",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar HolyWrath Q",
      "speaker": "伊拉斯塔",
      "text": "这怎么可能？你怎么能引导圣光？！",
      "string_id": 2630,
      "speaker_string_id": 2631,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T560-ILASTAR.ogg"
    },
    {
      "n": 107,
      "id": "A3M2-T570-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar HolyWrath Q",
      "speaker": "加瑞克",
      "text": "没有圣光……照耀不到的地方。这一切……到此为止了！",
      "string_id": 2633,
      "speaker_string_id": 2634,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T570-GAREK.ogg"
    },
    {
      "n": 108,
      "id": "A3M2-T580-GAREK",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar AvatarOfLight Q",
      "speaker": "加瑞克",
      "text": "你……永远无法……掌控我们！",
      "string_id": 2641,
      "speaker_string_id": 2676,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T580-GAREK.ogg"
    },
    {
      "n": 109,
      "id": "A3M2-T590-ANYA",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar AvatarOfLight Q",
      "speaker": "恩雅",
      "text": "加瑞克！你会把自己烧成灰的！",
      "string_id": 2650,
      "speaker_string_id": 2651,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T590-ANYA.ogg"
    },
    {
      "n": 110,
      "id": "A3M2-T600-ILASTAR",
      "scene": "TRANSMISSIONS.The Necropolis.Transmission Boss Ilastar Phase4 End Q",
      "speaker": "伊拉斯塔",
      "text": "不！我怎么能被圣光吞没！",
      "string_id": 2662,
      "speaker_string_id": 2663,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T600-ILASTAR.ogg"
    },
    {
      "n": 111,
      "id": "A3M2-T610-GAREK",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen Discover Q",
      "speaker": "加瑞克",
      "text": "伊拉斯塔……我很抱歉引领你走向了这样的命运。",
      "string_id": 2683,
      "speaker_string_id": 2684,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T610-GAREK.ogg"
    },
    {
      "n": 112,
      "id": "A3M2-T620-ANYA",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen Discover Q",
      "speaker": "恩雅",
      "text": "我们现在要怎么办？我们已经没有摧毁纳克萨玛斯的手段了。",
      "string_id": 2692,
      "speaker_string_id": 2905,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T620-ANYA.ogg"
    },
    {
      "n": 113,
      "id": "A3M2-T630-GAREK",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen Discover Q",
      "speaker": "加瑞克",
      "text": "我们……必须要摧毁那枚水晶……不能让它再发出下一次攻击。而我也知道该如何做了。",
      "string_id": 2695,
      "speaker_string_id": 2696,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T630-GAREK.ogg"
    },
    {
      "n": 114,
      "id": "A3M2-T640-LEONID",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower1 Q",
      "speaker": "莱尼德",
      "text": "你和瑟里耶克爵士一样，能够引导圣光……这怎么可能？",
      "string_id": 2705,
      "speaker_string_id": 2998,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T640-LEONID.ogg"
    },
    {
      "n": 115,
      "id": "A3M2-T650-GAREK",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower1 Q",
      "speaker": "加瑞克",
      "text": "我……每一次呼唤圣光……都能感觉到灼烧。不过……它还是会……赐予我力量……",
      "string_id": 2714,
      "speaker_string_id": 2715,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T650-GAREK.ogg"
    },
    {
      "n": 116,
      "id": "A3M2-T660-ANYA",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower1 Q",
      "speaker": "恩雅",
      "text": "你不能再继续下去了，加瑞克。圣光会烧死你的。",
      "string_id": 2723,
      "speaker_string_id": 2926,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T660-ANYA.ogg"
    },
    {
      "n": 117,
      "id": "A3M2-T670-GAREK",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower1 Q",
      "speaker": "加瑞克",
      "text": "我只需要……再多坚持一段时间……直到能拯救被遗忘者……",
      "string_id": 2732,
      "speaker_string_id": 2733,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T670-GAREK.ogg"
    },
    {
      "n": 118,
      "id": "A3M2-T680-GAREK",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower2 Q",
      "speaker": "加瑞克",
      "text": "我记起来……所有事情了。我犯下的错误……我没能吸取的教训……",
      "string_id": 2740,
      "speaker_string_id": 2741,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T680-GAREK.ogg"
    },
    {
      "n": 119,
      "id": "A3M2-T690-ANYA",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower2 Q",
      "speaker": "恩雅",
      "text": "你必须要放下过往的一切。成为被遗忘者，意味着你有机会可以决定自己是谁。",
      "string_id": 2749,
      "speaker_string_id": 2750,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T690-ANYA.ogg"
    },
    {
      "n": 120,
      "id": "A3M2-T700-GAREK",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower2 Q",
      "speaker": "加瑞克",
      "text": "你说得对，恩雅……但现在我知道了自己过去是谁……让我明白了我想成为谁……以及我必须要怎么做……",
      "string_id": 3037,
      "speaker_string_id": 3038,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T700-GAREK.ogg"
    },
    {
      "n": 121,
      "id": "A3M2-T710-LEONID",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower3 Q",
      "speaker": "莱尼德",
      "text": "我们已经快到纳克萨玛斯的顶层了。相信我们很快就会见到克尔苏加德本人了。",
      "string_id": 2997,
      "speaker_string_id": 2753,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T710-LEONID.ogg"
    },
    {
      "n": 122,
      "id": "A3M2-T720-ANYA",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower3 Q",
      "speaker": "恩雅",
      "text": "他对人类和精灵都欠下了累累血债。现在，他还想要灭绝被遗忘者。我们绝不能让他得逞。",
      "string_id": 2769,
      "speaker_string_id": 2770,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T720-ANYA.ogg"
    },
    {
      "n": 123,
      "id": "A3M2-T730-GAREK",
      "scene": "TRANSMISSIONS.Ascension.Transmission Ascen AllThisPower3 Q",
      "speaker": "加瑞克",
      "text": "不论他们耍什么花样……被遗忘者一定要活下去。我发誓……以圣光的名义……",
      "string_id": 2772,
      "speaker_string_id": 2773,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T730-GAREK.ogg"
    },
    {
      "n": 124,
      "id": "A3M2-T740-KELTHUZAD",
      "scene": "TRANSMISSIONS.Ascension.Transmission Boss Finale Rivendare1 Q",
      "speaker": "克尔苏加德",
      "text": "你们的挣扎都是徒劳的。等我的水晶充能完毕，你们那珍贵的幽暗城将会变成一个硝烟弥漫的凹坑。",
      "string_id": 2782,
      "speaker_string_id": 2783,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T740-KELTHUZAD.ogg"
    },
    {
      "n": 125,
      "id": "A3M2-T750-GAREK",
      "scene": "TRANSMISSIONS.Ascension.Transmission Boss Finale Rivendare1 Q",
      "speaker": "加瑞克",
      "text": "我们绝不会……允许那样的事发生！",
      "string_id": 2793,
      "speaker_string_id": 2794,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T750-GAREK.ogg"
    },
    {
      "n": 126,
      "id": "A3M2-T760-GAREK",
      "scene": "TRANSMISSIONS.Ascension.Transmission Boss Finale Rivendare2 Q",
      "speaker": "加瑞克",
      "text": "圣光……在燃烧……",
      "string_id": 2801,
      "speaker_string_id": 2802,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T760-GAREK.ogg"
    },
    {
      "n": 127,
      "id": "A3M2-T770-RIVENDARE",
      "scene": "TRANSMISSIONS.Ascension.Transmission Boss Finale Rivendare2 Q",
      "speaker": "瑞文戴尔男爵",
      "text": "你还以为自己是圣骑士吗？我应该找张椅子坐下，欣赏你把自己烧死的过程！",
      "string_id": 2804,
      "speaker_string_id": 2805,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre03m2/A3M2-T770-RIVENDARE.ogg"
    },
    {
      "n": 128,
      "id": "A3M2-T780-RIVENDARE",
      "scene": "TRANSMISSIONS.Ascension.Transmission Boss Finale Rivendare3 Q",
      "speaker": "瑞文戴尔男爵",
      "text": "可悲的害虫！我是斯坦索姆的主人！面对我你毫无胜算。",
      "string_id": 2812,
      "speaker_string_id": 2813,
