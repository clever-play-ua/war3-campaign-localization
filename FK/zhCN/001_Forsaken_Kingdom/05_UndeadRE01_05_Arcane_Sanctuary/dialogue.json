{
  "map": "UndeadRE01_05",
  "title": "Arcane Sanctuary",
  "locale": "zhCN",
  "order_note": "Sorted by recording id: C (cinematics), M (in-engine cutscenes), T (gameplay transmissions); unit barks follow their trigger group. Interleaving of C/M/T is not confirmed.",
  "lines": [
    {
      "n": 1,
      "id": "A1M5-C010-010-GAREK",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "加瑞克",
      "text": "这是什么地方？",
      "string_id": 1143,
      "speaker_string_id": 1144,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-C010-010-GAREK.ogg"
    },
    {
      "n": 2,
      "id": "A1M5-C010-020-ANYA",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "恩雅",
      "text": "一个法师创造了一个口袋维度，用来存放他们的破烂。",
      "string_id": 1152,
      "speaker_string_id": 1153,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-C010-020-ANYA.ogg"
    },
    {
      "n": 3,
      "id": "A1M5-C010-030-ANYA",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "恩雅",
      "text": "不出所料，里面全是构造体守卫，也许还藏了很多陷阱。",
      "string_id": 1161,
      "speaker_string_id": 1162,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-C010-030-ANYA.ogg"
    },
    {
      "n": 4,
      "id": "A1M5-C010-040-ANYA",
      "scene": "Initialization.Dialogue Reference",
      "speaker": "恩雅",
      "text": "我们需要利用这些传送门在各个房间中穿行。希望最后能找到一些好东西，让我们不枉此行。",
      "string_id": 1169,
      "speaker_string_id": 1170,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-C010-040-ANYA.ogg"
    },
    {
      "n": 5,
      "id": "A1M5-T010-GAREK",
      "scene": "Transmissions.Inert Portal TMS Portal",
      "speaker": "加瑞克",
      "text": "这道传送门看上去已经陷入休眠。可能需要某种能量源才能启动。",
      "string_id": 848,
      "speaker_string_id": 849,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-T010-GAREK.ogg"
    },
    {
      "n": 6,
      "id": "A1M5-T020-GAREK",
      "scene": "Transmissions.Inert Portal TMS Orb",
      "speaker": "加瑞克",
      "text": "似乎这东西能安装在传送门的框架中。我打赌这就是我们需要的能量源。",
      "string_id": 873,
      "speaker_string_id": 874,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-T020-GAREK.ogg"
    },
    {
      "n": 7,
      "id": "A1M5-T030-ANYA",
      "scene": "Transmissions.Grid Puzzle TMS",
      "speaker": "恩雅",
      "text": "这群可恶的法师总喜欢耍些他们的小花招。我们只能原路返回了。",
      "string_id": 908,
      "speaker_string_id": 909,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-T030-ANYA.ogg"
    },
    {
      "n": 8,
      "id": "A1M5-T040-GAREK",
      "scene": "Transmissions.Beam Puzzle TMS",
      "speaker": "加瑞克",
      "text": "如果我们能移开挡路的障碍物，这道光束也许能启动下一道传送门。",
      "string_id": 950,
      "speaker_string_id": 951,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-T040-GAREK.ogg"
    },
    {
      "n": 9,
      "id": "A1M5-T050-ANYA",
      "scene": "Transmissions.Artifact Transmission Fake",
      "speaker": "恩雅",
      "text": "那只是个幻象！真正的神器一定藏在宝库的其他地方。",
      "string_id": 992,
      "speaker_string_id": 993,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-T050-ANYA.ogg"
    },
    {
      "n": 10,
      "id": "A1M5-T060-GAREK",
      "scene": "Transmissions.Artifact Transmission Fake",
      "speaker": "加瑞克",
      "text": "我们继续搜寻吧。",
      "string_id": 994,
      "speaker_string_id": 995,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-T060-GAREK.ogg"
    },
    {
      "n": 11,
      "id": "A1M5-T070-GAREK",
      "scene": "Transmissions.Artifact Transmission Real",
      "speaker": "加瑞克",
      "text": "看来这就是真正的神器了。",
      "string_id": 998,
      "speaker_string_id": 999,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-T070-GAREK.ogg"
    },
    {
      "n": 12,
      "id": "A1M5-T080-ANYA",
      "scene": "Transmissions.Artifact Transmission Real",
      "speaker": "恩雅",
      "text": "终于找到了。把这该死的东西拿回去给莱克斯顿吧。",
      "string_id": 1006,
      "speaker_string_id": 1007,
      "sound": "Sound/Dialogue/UndeadRECamp/Undeadre01m5/A1M5-T080-ANYA.ogg"
    }
  ]
}