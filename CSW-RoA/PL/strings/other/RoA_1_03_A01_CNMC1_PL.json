  },
  "#2e99c06ab2": {
    "hash": "2e99c06ab2",
    "en": "Basic long-ranged attacker. Can learn the Marksmanship, Improved Bows and Hippogryph Taming upgrades.|n|n|cffffcc00Attacks land and air units.|r",
    "tr": "Podstawowa jednostka o dużym zasięgu ataku. Może korzystać z ulepszeń Celność, Ulepszone łuki i Oswajanie hipogryfów.|n|n|cffffcc00Atakuje jednostki naziemne i powietrzne.|r"
  },
  "#53e2d051ee": {
