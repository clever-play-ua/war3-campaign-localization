  "ToD_A02_M06_MESS_001": {
    "hash": "d11ddfb1d4",
    "en": "|cff8080ffNEW HERO|r\nCho’gall is a powerful ogre mage, Initiate of the Fifth Circle of the Shadow Council and Chieftain of the Twilight's Hammer clan. He was spared execution alongside his master Gul’dan and must now prove his worth to the Horde. "
  },
  "ToD_A02_M06_MESS_002": {
    "hash": "f14ea55205",
    "en": "Choose the way"
  },
  "ToD_A02_M06_MESS_003": {
    "hash": "1a83754a32",
    "en": "Go Left"
  },
  "ToD_A02_M06_MESS_004": {
    "hash": "9b2a1a8efa",
    "en": "Go Right"
  },
  "ToD_A02_M06_MESS_005": {
    "hash": "af6c57c1d9",
    "en": "|cffff0000WARNING|r \nYou have chosen the north road. You cannot go to south now."
  },
  "ToD_A02_M06_MESS_006": {
    "hash": "6f765bf0a3",
    "en": "|cffff0000WARNING|r \nYou have chosen the south road. You cannot go to north now."
  },
  "ToD_A02_M06_MESS_007": {
    "hash": "a0829519f2",
    "en": "|c0000FF00Watch the clock, half of the night has passed.|r"
  },
  "ToD_A02_M06_MESS_008": {
    "hash": "6cdacc4994",
    "en": "|c00FF7F00You are running out of time! The sun rises in two hours!|r"
  },
  "ToD_A02_M06_MESS_009": {
    "hash": "c5a6425a0d",
    "en": "|c00FF7F00You are running out of time! The sun rises in an hour!|r"
  },
  "ToD_A02_M06_MESS_010": {
    "hash": "ba0863c273",
    "en": "|c00FF7F00You are running out of time! Sunrise is in half an hour!|r"
  },
  "ToD_A02_M06_MESS_011": {
    "hash": "6578adb555",
    "en": "|cffff0000You are running out of time! Sun has almost risen!|r"
  },
  "ToD_A02_M06_MESS_012": {
    "hash": "c26762d055",
    "en": "|cffffcc00MAIN QUEST FAILED|r\nYou are late, sun has risen, but Cho'gall had'nt reached the camp."
  },
  "ToD_A02_M06_MESS_014": {
    "hash": "37ab0b81ca",
    "en": "|cffffcc00SECRET FOUND|r\nSecret mission unlocked."
  },
