    "hash": "d5d7ab4d2e",
    "en": "|cffffcc00MAIN QUEST UPDATE|r",
    "tr": "|cffffcc00ГОЛОВНЕ ЗАВДАННЯ ОНОВЛЕНО|r"
  },
  "ToD_A02_M07_MESS_002": {
    "hash": "7eb8d71c23",
    "en": "|cffffcc00OPTIONAL QUEST UPDATE|r",
    "tr": "|cffffcc00ДОДАТКОВЕ ЗАВДАННЯ ОНОВЛЕНО|r"
  },
  "ToD_A02_M07_MESS_003": {
    "hash": "6dd9cd2c36",
    "en": "|cffff0000WARNING|r\nYou must build your base before Warchief arrives. Check the timer in the top right corner of the screen.",
    "tr": "|cffff0000УВАГА|r\r\nВи маєте звести табір до прибуття вождя. Слідкуйте за часом у верхньому правому куті екрану."
  },
  "ToD_A02_M07_MESS_004": {
    "hash": "530070f1e3",
    "en": "|cffff0000WARNING|r\nOne minute left before Warchief's arrival.",
    "tr": "|cffff0000УВАГА|r\r\nЛишилася лише хвилина до прибуття вождя."
  },
  "ToD_A02_M07_MESS_005": {
    "hash": "4b549c1ec0",
    "en": "|cffffcc00TECHTREE ALTERATION|r\nOrc Ranged Armory. In the Warmill you can find new upgrades for orcish spearthrowers. ",
    "tr": "|cffffcc00ДОСТУПНІ НОВІ ТЕХНОЛОГІЇ|r\r\nВійськова виробня - Тут ви можете покращити видобуток деревини та бойові навички окрів списометальників."
  },
  "ToD_A02_M07_MESS_006": {
    "hash": "13aebaa354",
    "en": "|cffffcc00TECHTREE UNLOCKED|r\nOgres. These mighty two-headed giants were sent by Cho'gall himself. They can be trained in the Ogre Mound. ",
    "tr": "|cffffcc0НОВІ ОДИНИЦІ ДОСТУПНІ|r\r\nОґри. Ці кремезі двоголові велетні були натреновані самим Чо'ґаллом. Їх можна тренувати у |cffffcc00«Пагорбі огрів»|r."
  },
  "ToD_A02_M07_MESS_007": {
    "hash": "573b24c78c",
    "en": "|cff8080ffNEW HEROES|r\nOrgrim Doomhammer, the mighty Warcheif of the Horde and the strongest Orcish warrior there is.",
    "tr": "|cff8080ffНОВІ ГЕРОЇ|r\r\nПід вашим контролем Орґрім Молот Згуби, могутній вождь Орди і наймагутніший орк воїн.\""
  },
  "ToD_A02_M07_MESS_008": {
    "hash": "9e3e7f9452",
    "en": "|cff32cd32HINT|r\nCastle Walls with grates are |cffd47832destructible|r.\nYour catapults can target walls of the castle with right mouse click.",
    "tr": "|cff32cd32ПІДКАЗКА|r\nСтіни замку з решітками можна |cffd47832зруйнувати|r.\nВіддайте наказ катапультам атакувати стіни, за допомогою правої кнопки миші."
  },
  "ToD_A02_M07_MESS_009": {
    "hash": "dd0f044af2",
    "en": "|cffffcc00Haul more Oil.|r",
    "tr": "|cffffcc00Потрібно більше нафти.|r"
  },
  "ToD_A02_M07_OBJE_001": {
