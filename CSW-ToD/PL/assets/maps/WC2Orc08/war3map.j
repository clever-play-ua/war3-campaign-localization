function Trig_Final_Cinematic_Actions takes nothing returns nothing
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    // //
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_Setup)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_FinalCin01, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_RaminDjawadi___Guldan)
    call TriggerSleepAction(2)
    // //
    call SetUnitAnimation(udg_FakeGuldan, "spell")
    call QueueUnitAnimationBJ(udg_FakeChogal, "stand")
    call AddSpecialEffectTargetUnitBJ("origin", udg_FakeGuldan, "Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl")
    set udg_SE_GulDanSpell=GetLastCreatedEffectBJ()
    // //
    // CinematicBegins
    // //
    // Runestone
    // PART I
    // //
    set udg_Bool_CinOutroOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_FinalCin02, udg_Player_Actual, 40.00, 0, 5.00, 100.00)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call DestroyEffectBJ(udg_SE_GulDanSpell)
    // //
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_FCSpellGulDanStart))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeGuldan, gg_unit_n60R_0003, 1.00)
    // //
    // The ritual has begun.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan20, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(( 6.00 - GetLastTransmissionDurationBJ() ))
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeChogal, "move", GetRectCenter(gg_rct_FCSpellChogall))
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeChogal, gg_unit_n60R_0003, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Transformation Starts
    // //
    call SetUnitAnimation(udg_FakeChogal, "spell")
    call QueueUnitAnimationBJ(udg_FakeChogal, "stand ready")
    // //
    call AddSpecialEffectTargetUnitBJ("overhead", udg_FakeChogal, "Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl")
    set udg_SE_OutroChogalBlinkEff=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(gg_unit_n60R_0003, "stand work")
    call AddLightningLoc("DRAM", GetUnitLoc(udg_Hero_Chogall), GetUnitLoc(gg_unit_n60R_0003))
    set udg_SE_EnergyDrain[1]=GetLastCreatedLightningBJ()
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call EnableTrigger(gg_trg_Final_Cinematic_ChogallSEMEdiator)
    call SetStackedSoundBJ(true, gg_snd_MagicLariatLoop1, gg_rct_RuneStoneCapture)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call DestroyEffectBJ(udg_SE_OutroChogalBlinkEff)
    // //
    call PlaySoundAtPointBJ(gg_snd_TidalGuardianWhat1, 75.00, GetRectCenter(gg_rct_RuneStoneFogGlow), 0)
    call SetUnitAnimation(udg_Unit_OgreFinalCinematicArr[1], "spell")
    call QueueUnitAnimationBJ(udg_Unit_OgreFinalCinematicArr[1], "stand ready")
    call AddSpecialEffectTargetUnitBJ("origin", udg_Unit_OgreFinalCinematicArr[1], "Abilities\\Spells\\Other\\Drain\\ManaDrainTarget.mdl")
    set udg_SE_RSManaDrainIN[1]=GetLastCreatedEffectBJ()
    call AddLightningLoc("DRAM", GetUnitLoc(udg_Unit_OgreFinalCinematicArr[1]), GetRectCenter(gg_rct_DrainManaPoint01))
    set udg_SE_EnergyDrain[2]=GetLastCreatedLightningBJ()
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
