//===========================================================================
// Trigger: On screen
//===========================================================================
function Trig_On_screen_Func002C takes nothing returns boolean
    if ( not ( udg_BoolCheat_VisibilityOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_On_screen_Actions takes nothing returns nothing
    if ( Trig_On_screen_Func002C() ) then
        set udg_BoolCheat_VisibilityOn=true
        call FogMaskEnableOff()
        call FogEnableOff()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_SECRET, "TRIGSTR_3156")
    else
        set udg_BoolCheat_VisibilityOn=false
        call FogMaskEnableOn()
        call FogEnableOn()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_SECRET, "TRIGSTR_3155")
    endif
endfunction

//===========================================================================
function InitTrig_On_screen takes nothing returns nothing
    set gg_trg_On_screen=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_On_screen, Player(0), "On screen", true)
    call TriggerAddAction(gg_trg_On_screen, function Trig_On_screen_Actions)
endfunction

