//===========================================================================
// Trigger: Runestone Ping
//===========================================================================
function Trig_Runestone_Ping_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQ_Runestone) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runestone_Ping_Func003001 takes nothing returns boolean
    return ( IsQuestItemCompleted(udg_QReq_DestroyCastle) == false )
endfunction

function Trig_Runestone_Ping_Func004001 takes nothing returns boolean
    return ( IsQuestItemCompleted(udg_QReq_SecureRunestone) == false )
endfunction

function Trig_Runestone_Ping_Actions takes nothing returns nothing
    if ( (IsQuestItemCompleted(udg_QReq_DestroyCastle) == false) ) then // INLINED!!
        call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, udg_Point_RunestonePing[1], 7.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    else
        call DoNothing()
    endif
    if ( (IsQuestItemCompleted(udg_QReq_SecureRunestone) == false) ) then // INLINED!!
        call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, udg_Point_RunestonePing[2], 7.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    else
        call DoNothing()
    endif
endfunction

