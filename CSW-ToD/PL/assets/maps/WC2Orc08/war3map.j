    if ( not ( IsUnitInGroup(GetAttackedUnitBJ(), udg_Group_Sharks) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SharkIsAttacked_Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('Awan', GetAttackedUnitBJ()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SharkIsAttacked_Actions takes nothing returns nothing
    if ( Trig_SharkIsAttacked_Func001C() ) then
        call UnitRemoveAbilityBJ('Awan', GetAttackedUnitBJ())
    else
    endif
endfunction

