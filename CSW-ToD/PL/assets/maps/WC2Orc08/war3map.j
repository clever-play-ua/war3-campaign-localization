//===========================================================================
function Trig_Intro_Cinematic_ZombieArises_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Unit_Villager ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_ZombieArises_Func003001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_ZombieArises_Func008001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_ZombieArises_Func013001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_ZombieArises_Func025001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_ZombieArises_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(2.34)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeGuldan, "spell")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "stand")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Zombie), "Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl")
    set udg_SE_RaiseZombie=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.65)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CreateNUnitsAtLoc(1, 'nzom', Player(1), GetRectCenter(gg_rct_Zombie), 135.00)
    set udg_Unit_VillagerZombie=GetLastCreatedUnit()
    // //
    call SetUnitAnimation(udg_Unit_VillagerZombie, "birth")
    call QueueUnitAnimationBJ(udg_Unit_VillagerZombie, "stand")
    call RemoveUnit(udg_Unit_Villager)
    // //
    call DestroyEffectBJ(udg_SE_VillagerDrain)
    call PlaySoundOnUnitBJ(gg_snd_GhoulWarcry1, 100, udg_Unit_VillagerZombie)
    call TriggerSleepAction(3.34)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillUnit(udg_Unit_VillagerZombie)
    call DestroyEffectBJ(udg_SE_RaiseZombie)
    // //
endfunction

