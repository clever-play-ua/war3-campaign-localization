function Trig_PlayerMarineAttackOrderPoint_Actions takes nothing returns nothing
    local integer landingrolldiceMain
    local integer landingrolldiceExp
    local integer landingrolldiceMur
    local integer landingrolldiceTown
    local integer landingrolldiceCaer
    // //
    set udg_BoardingTempUnit=GetOrderedUnit()
    set udg_TempPlayer=GetOwningPlayer(udg_BoardingTempUnit)
    set udg_TempInteger=GetConvertedPlayerId(udg_TempPlayer)
    set udg_TempIntegerId=GetIssuedOrderId()
    // //
    if ( Trig_PlayerMarineAttackOrderPoint_Func012C() ) then
        // //
        set udg_BoardingTempPoint=GetOrderPointLoc()
        // //
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func004C() ) then
            call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, udg_BoardingTempPoint, 1, bj_MINIMAPPINGSTYLE_FLASHY, 100.00, 0.00, 0.00)
        else
        endif
        // //
        // We check of out Boarding Temp Point exists in the Particular Regions
        // And if the Unit is in the same region or it has to reach it first
        // //
        // First batch is for cases when our attackers are not yet in the area for landing
        // //
        // We start with the attacking player own base area
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func012C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func012Func012Func001C() ) then
                set udg_AttackTempBoolean[udg_TempInteger]=true
            else
            endif
        else
        endif
        // //
        // Murloc Island
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func015C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func012Func015Func001C() ) then
                set udg_AttackTempBoolean[udg_TempInteger]=true
            else
            endif
        else
        endif
        // //
        // Darrowmere Town
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func018C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func012Func018Func001C() ) then
                set udg_AttackTempBoolean[udg_TempInteger]=true
            else
            endif
        else
        endif
        // //
        // Goldmine Expansion Shoreline
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func021C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func012Func021Func004C() ) then
                set udg_AttackTempBoolean[udg_TempInteger]=true
            else
            endif
        else
        endif
        // //
        // Orcs Main Base Area
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func024C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func012Func024Func004C() ) then
                set udg_AttackTempBoolean[udg_TempInteger]=true
            else
            endif
        else
        endif
        // //
        // Second Batch of checks is for cases when they are in the landing areas
        // //
        // Caer Darrow Base
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func029C() ) then
            // //
            set landingrolldiceCaer=GetRandomInt(1, 2)
            // //
            if landingrolldiceCaer == 1 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingCaerDarrow01)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingCaerDarrow01)
            else
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingCaerDarrow02)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingCaerDarrow02)
            endif
            // //
        else
        endif
        // //
        // Murloc Island
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func032C() ) then
            // //
            set landingrolldiceMur=GetRandomInt(1, 2)
            // //
            if landingrolldiceMur == 1 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingMurlocIsland01)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingMurlocIsland01)
            else
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingMurlocIsland02)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingMurlocIsland02)
            endif
            // //
        else
        endif
        // //
        // Darrowmere Town
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func035C() ) then
            // //
            set landingrolldiceTown=GetRandomInt(1, 3)
            // //
            if landingrolldiceTown == 1 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingDTown01)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingDTown01)
            elseif landingrolldiceTown == 2 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingDTown02)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingDTown02)
            else
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingDTown03)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingDTown03)
            endif
            // //
        else
        endif
        // //
        // Exmapnsion Area
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func038C() ) then
            // //
            set landingrolldiceExp=GetRandomInt(1, 3)
            // //
            if landingrolldiceExp == 1 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingSouthWest01)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingSouthWest01)
            elseif landingrolldiceExp == 2 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingSouthWest02)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingSouthWest02)
            else
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingSouthWest03)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingSouthWest03)
            endif
            // //
        else
        endif
        // //
        // Orc Base
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func041C() ) then
            // //
            set landingrolldiceMain=GetRandomInt(1, 4)
            // //
            if landingrolldiceMain == 1 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingNorth01)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingNorth01)
            elseif landingrolldiceMain == 2 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingNorth02)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingNorth02)
            elseif landingrolldiceMain == 3 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingNorth03)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingNorth03)
            else
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingNorth04)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingNorth04)
            endif
            // //
        else
        endif
        // //
        // Avoid Attacking Oil Rigs
        // //
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func045C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func012Func045Func001C() ) then
                set udg_Unit_PlayerSurfaceUnit=GroupPickRandomUnit(udg_Group_PlayerSurfaceStructures)
            else
            endif
            set udg_AttackOrderPointerX[udg_TempInteger]=GetUnitX(udg_Unit_PlayerSurfaceUnit)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetUnitY(udg_Unit_PlayerSurfaceUnit)
            if not IsUnitInRangeXY(udg_BoardingTempUnit, udg_AttackOrderPointerX[udg_TempInteger], udg_AttackOrderPointerY[udg_TempInteger], 1024) then
            set udg_AttackTempBoolean[udg_TempInteger]=true
            endif
        else
        endif
        // //
        // //
        // //
        // safety measure
        if ( Trig_PlayerMarineAttackOrderPoint_Func012Func050C() ) then
            if s__ForceBoarding_struct[GetUnitUserData(udg_BoardingTempUnit)] == 0 then
            call GroupAddUnitSimple(udg_BoardingTempUnit, udg_IdleMarines[udg_TempInteger])
            endif
        else
        endif
        // //
        // Check Process Ended
        set udg_AttackTempBoolean[udg_TempInteger]=false
        call RemoveLocation(udg_BoardingTempPoint)
        // //
    else
    endif
    // //
    set udg_BoardingTempUnit=null
endfunction

//===========================================================================
function InitTrig_PlayerMarineAttackOrderPoint takes nothing returns nothing
    set gg_trg_PlayerMarineAttackOrderPoint=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_PlayerMarineAttackOrderPoint, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddCondition(gg_trg_PlayerMarineAttackOrderPoint, Condition(function Trig_PlayerMarineAttackOrderPoint_Conditions))
    call TriggerAddAction(gg_trg_PlayerMarineAttackOrderPoint, function Trig_PlayerMarineAttackOrderPoint_Actions)
endfunction

