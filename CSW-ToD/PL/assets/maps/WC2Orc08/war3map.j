//===========================================================================
// Trigger: SetUpOilPatchCapacity
//===========================================================================
function Trig_SetUpOilPatchCapacity_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_OilPatchUnit=gg_unit_n60P_0005
    call s__OilPatch_setOilAmount(udg_OilPatchUnit , 8500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MANA, 8500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MAX_MANA, 8500)
    // //
    set udg_OilPatchUnit=gg_unit_n60P_0006
    call s__OilPatch_setOilAmount(udg_OilPatchUnit , 9500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MANA, 9500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MAX_MANA, 9500)
    // //
    set udg_OilPatchUnit=gg_unit_n60P_0007
    call s__OilPatch_setOilAmount(udg_OilPatchUnit , 10500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MANA, 10500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MAX_MANA, 10500)
    // //
    set udg_OilPatchUnit=null
    // //
endfunction

