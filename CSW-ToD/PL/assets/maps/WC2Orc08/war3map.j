    set gg_trg_Chogall_I_Crushing_Madness=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Chogall_I_Crushing_Madness, EVENT_PLAYER_UNIT_SPELL_EFFECT)
