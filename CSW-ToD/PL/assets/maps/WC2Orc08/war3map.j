endfunction

//===========================================================================
// Trigger: GrabTankersWhenOilRigIsBuild
//===========================================================================
function Trig_GrabTankersWhenOilRigIsBuild_Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetConstructedStructure()) == 'u002' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetConstructedStructure()) == 'u600' ) ) then
        return true
    endif
    return false
endfunction

function Trig_GrabTankersWhenOilRigIsBuild_Conditions takes nothing returns boolean
    if ( not Trig_GrabTankersWhenOilRigIsBuild_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_GrabTankersWhenOilRigIsBuild_Func005001003 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_GrabTankersWhenOilRigIsBuild_Func005A takes nothing returns nothing
    call IssueImmediateOrderBJ(GetEnumUnit(), "channel")
endfunction

function Trig_GrabTankersWhenOilRigIsBuild_Actions takes nothing returns nothing
    set udg_Point_OilPlatformTemp=GetUnitLoc(GetConstructedStructure())
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(512, udg_Point_OilPlatformTemp, Condition(function Trig_GrabTankersWhenOilRigIsBuild_Func005001003)), function Trig_GrabTankersWhenOilRigIsBuild_Func005A)
    // //
    call RemoveLocation(udg_Point_OilPlatformTemp)
endfunction

//===========================================================================
function InitTrig_GrabTankersWhenOilRigIsBuild takes nothing returns nothing
    set gg_trg_GrabTankersWhenOilRigIsBuild=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_GrabTankersWhenOilRigIsBuild, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
    call TriggerAddCondition(gg_trg_GrabTankersWhenOilRigIsBuild, Condition(function Trig_GrabTankersWhenOilRigIsBuild_Conditions))
    call TriggerAddAction(gg_trg_GrabTankersWhenOilRigIsBuild, function Trig_GrabTankersWhenOilRigIsBuild_Actions)
endfunction

//===========================================================================
// Trigger: OIlBarrelItemConsumed
//===========================================================================
function Trig_OIlBarrelItemConsumed_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'IBoO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OIlBarrelItemConsumed_Actions takes nothing returns nothing
    local unit u
    local texttag t= CreateTextTag()
    local real x
    local real y
    // //
    set u=GetManipulatingUnit()
    set x=GetUnitX(u)
    set y=GetUnitY(u)
    // //
    call SetTextTagText(t, ( "+" + I2S(100) ), 0.024)
    call SetTextTagPos(t, x, y, 75.00)
    call SetTextTagColor(t, 4, 19, 51, 255)
    call SetTextTagVelocity(t, 0.00, 0.04)
    call SetTextTagFadepoint(t, 1.50)
    call SetTextTagLifespan(t, 2.00)
    call SetTextTagPermanent(t, false)
    // //
    call playerAddOil(Player(0) , 100)
endfunction

//===========================================================================
function InitTrig_OIlBarrelItemConsumed takes nothing returns nothing
    set gg_trg_OIlBarrelItemConsumed=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OIlBarrelItemConsumed, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_OIlBarrelItemConsumed, Condition(function Trig_OIlBarrelItemConsumed_Conditions))
    call TriggerAddAction(gg_trg_OIlBarrelItemConsumed, function Trig_OIlBarrelItemConsumed_Actions)
endfunction

//===========================================================================
// Trigger: OilSpentForResearchC01
//===========================================================================
function Trig_OilSpentForResearchC01_Conditions takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R008', udg_Player_Actual) == 0 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetOrderedUnit()) == 'o60M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForResearchC01_Actions takes nothing returns nothing
    local sound OrcUI_InsufficientOill
    local string Sound_Path= "Sound\\Interface\\Warning\\Orc\\GruntNoOil1.mp3"
    // -------------------------------------
    // Check the Order to research the cannons
    if ( ( GetIssuedOrderId() == 1378889784 ) ) then
    // Check the amount of Oil for Player
    if (OilHarvest__playerOil[GetPlayerId((Player(0)))]) < 1000 then // INLINED!!
    // // UI Warning
    set OrcUI_InsufficientOill=CreateSound(Sound_Path, false, false, false, 1, 1, "DefaultEAXON")
    call SetSoundParamsFromLabel(OrcUI_InsufficientOill, "User Interface")
    call SetSoundVolume(OrcUI_InsufficientOill, 127)
    call SetSoundPitch(OrcUI_InsufficientOill, 1.0)
    call StartSound(OrcUI_InsufficientOill)
    call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_2687")
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(0) , - 1000)
    else
    // need to decrease the oil if there was enough of it and the train/upgrade started
    call playerAddOil(Player(0) , - 1000)
    endif
    endif
    // // leak cleaner
    call KillSoundWhenDone(OrcUI_InsufficientOill)
    set OrcUI_InsufficientOill=null
endfunction

//===========================================================================
function InitTrig_OilSpentForResearchC01 takes nothing returns nothing
    set gg_trg_OilSpentForResearchC01=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilSpentForResearchC01, Player(0), EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerAddCondition(gg_trg_OilSpentForResearchC01, Condition(function Trig_OilSpentForResearchC01_Conditions))
    call TriggerAddAction(gg_trg_OilSpentForResearchC01, function Trig_OilSpentForResearchC01_Actions)
endfunction

//===========================================================================
// Trigger: OilSpentForResearchC02
//===========================================================================
function Trig_OilSpentForResearchC02_Conditions takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R008', udg_Player_Actual) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetOrderedUnit()) == 'o60M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForResearchC02_Actions takes nothing returns nothing
    local sound OrcUI_InsufficientOill
    local string Sound_Path= "Sound\\Interface\\Warning\\Orc\\GruntNoOil1.mp3"
    // -------------------------------------
    // Check the Order to research the cannons
    if ( ( GetIssuedOrderId() == 1378889784 ) ) then
    // Check the amount of Oil for Player
    if (OilHarvest__playerOil[GetPlayerId((Player(0)))]) < 2000 then // INLINED!!
    // // UI Warning
    set OrcUI_InsufficientOill=CreateSound(Sound_Path, false, false, false, 1, 1, "DefaultEAXON")
    call SetSoundParamsFromLabel(OrcUI_InsufficientOill, "User Interface")
    call SetSoundVolume(OrcUI_InsufficientOill, 127)
    call SetSoundPitch(OrcUI_InsufficientOill, 1.0)
    call StartSound(OrcUI_InsufficientOill)
    call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_2686")
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(0) , - 2000)
    else
    // need to decrease the oil if there was enough of it and the train/upgrade started
    call playerAddOil(Player(0) , - 2000)
    endif
    endif
    // // leak cleaner
    call KillSoundWhenDone(OrcUI_InsufficientOill)
    set OrcUI_InsufficientOill=null
endfunction

