//===========================================================================
function Trig_Turtles_Update_Q_Actions takes nothing returns nothing
    // //
    call QuestItemSetDescriptionBJ(udg_QReq_LocateWarTurtles, ( BlzGetItemDescription(gg_item_IQL1_0293) + ( I2S(udg_Int_TurtlesLocatedCounter) + BlzGetItemExtendedTooltip(gg_item_IQL0_0292) ) ))
    // //
    set udg_newLine="\n"
    // //
    set udg_String_CompletedQuests=( BlzGetItemDescription(gg_item_IQL0_0292) + ( udg_newLine + GetItemName(gg_item_IQL0_0292) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemTooltip(gg_item_IQL0_0292) + ( I2S(udg_Int_TurtlesLocatedCounter) + BlzGetItemExtendedTooltip(gg_item_IQL0_0292) ) ) ) )
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

