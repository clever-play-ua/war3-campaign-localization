//===========================================================================
// Trigger: Defeat
//===========================================================================
function Trig_Defeat_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Defeat_Func004001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_Defeat_Func004001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Defeat_Func004001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Defeat_Func004A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_UserDefeatCondition)
endfunction

function Trig_Defeat_Func007001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_Defeat_Func007001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Defeat_Func007001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Defeat_Func007A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_UserDefeatCondition)
endfunction

function Trig_Defeat_Func009C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_UserDefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Defeat_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Defeat_Func004001002)), function Trig_Defeat_Func004A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Defeat_Func007001002)), function Trig_Defeat_Func007A)
    // //
    if ( Trig_Defeat_Func009C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call TriggerSleepAction(2)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_MISSIONFAILED, "TRIGSTR_3163")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call ClearSelectionForPlayer(udg_Player_Actual)
        call ConditionalTriggerExecute(gg_trg_OilUIHide)
        call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
        call TriggerSleepAction(1.00)
        call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_3164")
    else
    endif
    // //
    call GroupClear(udg_Group_UserDefeatCondition)
    // //
endfunction

//===========================================================================
function InitTrig_Defeat takes nothing returns nothing
    set gg_trg_Defeat=CreateTrigger()
    call DisableTrigger(gg_trg_Defeat)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Defeat, 2)
    call TriggerAddCondition(gg_trg_Defeat, Condition(function Trig_Defeat_Conditions))
    call TriggerAddAction(gg_trg_Defeat, function Trig_Defeat_Actions)
endfunction

//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func009C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func020C takes nothing returns boolean
    if ( not ( udg_Bool_SecretFound == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call StoreUnitBJ(udg_Hero_Guldan, "Guldan", "WC2Orc08", udg_Cache)
    // //
    call StoreUnitBJ(udg_Hero_Chogall, "Chogall", "WC2Orc08", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func009C() ) then
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc08", udg_Cache)
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_UtokBackup), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc08", udg_Cache)
    endif
    // //
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', udg_Player_Actual), "UtokLevel", "WC2Orc08", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc08", udg_Cache)
    // //
    call TriggerSleepAction(0.25)
    call SaveGameCacheBJ(udg_Cache)
    // //
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    if ( Trig_Next_Level_Prep_Func020C() ) then
        call ShowCustomCampaignButton(true, 13)
        call ShowCustomCampaignButton(true, 14)
        call SetNextLevelBJ("WC2Orc08s.w3x")
    else
        call ShowCustomCampaignButton(true, 14)
        call SetNextLevelBJ("WC2Orc09.w3x")
    endif
    // //
    call CustomVictoryBJ(udg_Player_Actual, true, true)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

//===========================================================================
// Trigger: Life Tap
//===========================================================================
function Trig_Life_Tap_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A64C' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Life_Tap_Func001C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) >= 21.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Life_Tap_Actions takes nothing returns nothing
    if ( Trig_Life_Tap_Func001C() ) then
        set udg_TempPoint=GetUnitLoc(GetTriggerUnit())
        call PlaySoundAtPointBJ(gg_snd_AbilityLifeTap, 100, GetUnitLoc(GetSpellAbilityUnit()), 0)
        call UnitDamageTargetBJ(GetTriggerUnit(), GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) * 0.20 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL)
        call SetUnitManaBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) * 0.20 ) ))
        call RemoveLocation(udg_TempPoint)
    else
    endif
endfunction

