    set gg_trg_Intro_Cinematic_ZombieArises=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Intro_Cinematic_ZombieArises, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Intro_Cinematic_ZombieArises, Condition(function Trig_Intro_Cinematic_ZombieArises_Conditions))
