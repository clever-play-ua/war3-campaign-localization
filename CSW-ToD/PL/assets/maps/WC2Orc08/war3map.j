//===========================================================================
function Trig_UtokLevelUp_Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokLevelUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_UtokLevelUp_Func002C() ) then
        call AddSpecialEffectTargetUnitBJ("origin", udg_SemiHero_Utok, "Abilities\\Spells\\Other\\Levelup\\Levelupcaster.mdx")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    call SetPlayerTechResearchedSwap('RUX2', ( GetPlayerTechCountSimple('RUX2', udg_Player_Actual) + 1 ), udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_UtokLevelChecker)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

