//===========================================================================
// Trigger: Intro Cinematic GuldanAnim
//===========================================================================
function Trig_Intro_Cinematic_GuldanAnim_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_GuldanAnim_Func004001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_GuldanAnim_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitTimeScalePercent(udg_FakeGuldan, 12.00)
    // //
    set udg_Point_Guldan=GetRectCenter(gg_rct_GuldanStaff)
    set udg_Point_Villager=GetUnitLoc(udg_Unit_Villager)
    // //
    set udg_SE_GuldanLightning=AddLightningEx("DRAL", true, GetLocationX(udg_Point_Guldan), GetLocationY(udg_Point_Guldan), GetLocationZ(udg_Point_Guldan), GetLocationX(udg_Point_Villager), GetLocationY(udg_Point_Villager), GetLocationZ(udg_Point_Villager))
    call MoveLightningEx(udg_SE_GuldanLightning, true, GetLocationX(udg_Point_Guldan), GetLocationY(udg_Point_Guldan), GetLocationZ(udg_Point_Guldan) + 50, GetLocationX(udg_Point_Villager), GetLocationY(udg_Point_Villager), GetLocationZ(udg_Point_Villager) + 50)
    // //
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Unit_Villager), "Abilities\\Spells\\Other\\Drain\\DrainTarget.mdl")
    set udg_SE_VillagerDrain=GetLastCreatedEffectBJ()
    // //
    call PlaySoundOnUnitBJ(gg_snd_LifeDrain, 70.00, gg_unit_U60B_0039)
    // //
endfunction

