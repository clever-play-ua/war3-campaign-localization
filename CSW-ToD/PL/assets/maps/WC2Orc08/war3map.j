    set gg_trg_Runestone_Ping=CreateTrigger()
    call DisableTrigger(gg_trg_Runestone_Ping)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Runestone_Ping, 60.00)
    call TriggerAddCondition(gg_trg_Runestone_Ping, Condition(function Trig_Runestone_Ping_Conditions))
    call TriggerAddAction(gg_trg_Runestone_Ping, function Trig_Runestone_Ping_Actions)
endfunction

