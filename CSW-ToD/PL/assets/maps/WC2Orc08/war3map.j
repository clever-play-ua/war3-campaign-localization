function Trig_Turtles_Completed_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call QuestItemSetDescriptionBJ(udg_QReq_LocateWarTurtles, "TRIGSTR_2574")
    call QuestItemSetCompletedBJ(udg_QReq_LocateWarTurtles, true)
    call QuestSetCompletedBJ(udg_OQ_Turtles, true)
    // //
    call DestroyLeaderboardBJ(udg_Leaderboard_QuestObjectives)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2511")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call SetPlayerUnitAvailableBJ('o604', true, udg_Player_Actual)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UNITAVAILABLE, "TRIGSTR_2525")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_Blackrock, 'o605', GetCameraTargetPositionLoc(), gg_snd_WC2Orc08Utok7, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    call QueuedTriggerAddBJ(gg_trg_UtokLevelUp, true)
endfunction

