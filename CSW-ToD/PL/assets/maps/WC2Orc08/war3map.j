//===========================================================================
function Trig_Turtles_UpdateCompleted_Func003Func001C takes nothing returns boolean
    if ( not ( IsTriggerQueuedBJ(gg_trg_Turtles_Update_Q) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Turtles_UpdateCompleted_Func003Func002Func001C takes nothing returns boolean
    if ( not ( IsTriggerQueuedBJ(gg_trg_Turtles_Completed_Q) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Turtles_UpdateCompleted_Func003Func002C takes nothing returns boolean
    if ( not ( udg_Int_TurtlesLocatedCounter == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Turtles_UpdateCompleted_Func003C takes nothing returns boolean
    if ( not ( udg_Int_TurtlesLocatedCounter < 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Turtles_UpdateCompleted_Actions takes nothing returns nothing
    set udg_Int_TurtlesLocatedCounter=( udg_Int_TurtlesLocatedCounter + 1 )
    call LeaderboardSetPlayerItemValueBJ(udg_Player_Actual, udg_Leaderboard_QuestObjectives, ( 6 - udg_Int_TurtlesLocatedCounter ))
    if ( Trig_Turtles_UpdateCompleted_Func003C() ) then
        if ( Trig_Turtles_UpdateCompleted_Func003Func001C() ) then
            call QueuedTriggerAddBJ(gg_trg_Turtles_Update_Q, true)
        else
        endif
    else
        if ( Trig_Turtles_UpdateCompleted_Func003Func002C() ) then
            if ( Trig_Turtles_UpdateCompleted_Func003Func002Func001C() ) then
                call QueuedTriggerAddBJ(gg_trg_Turtles_Completed_Q, true)
            else
            endif
        else
        endif
    endif
endfunction

