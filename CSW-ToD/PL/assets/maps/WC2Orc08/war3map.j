//===========================================================================
// Trigger: Midgame Cinematic Start
//===========================================================================
function Trig_Midgame_Cinematic_Start_Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'e60C' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'h60R' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'n605' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'o003' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'e9ZZ' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'h9ZZ' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'h9ZY' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Midgame_Cinematic_Start_Conditions takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_OQ_Turtles) == false ) ) then
        return false
    endif
    if ( not Trig_Midgame_Cinematic_Start_Func002C() ) then
        return false
    endif
    return true
endfunction

