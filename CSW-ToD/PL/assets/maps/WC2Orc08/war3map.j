    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetAttackedUnitBJ()) == udg_Player_Lordaeron ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetAttacker(), udg_Player_Lordaeron) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttackedUnitBJ()) == 'hSjM' ) ) then
        return false
    endif
    if ( not Trig_EnableExtraAttackForRangedMarine_Func010C() ) then
        return false
    endif
    return true
endfunction

