// Trigger: Midgame Cinematic Q
//===========================================================================
function Trig_Midgame_Cinematic_Q_Func032001 takes nothing returns boolean
    return ( udg_Bool_CinMidgameSkipped == true )
endfunction

function Trig_Midgame_Cinematic_Q_Func042001 takes nothing returns boolean
    return ( udg_Bool_CinMidgameSkipped == true )
endfunction

function Trig_Midgame_Cinematic_Q_Func049001 takes nothing returns boolean
    return ( udg_Bool_CinMidgameSkipped == true )
endfunction

function Trig_Midgame_Cinematic_Q_Func058001 takes nothing returns boolean
    return ( udg_Bool_CinMidgameSkipped == true )
endfunction

function Trig_Midgame_Cinematic_Q_Func065001 takes nothing returns boolean
    return ( udg_Bool_CinMidgameSkipped == true )
endfunction

function Trig_Midgame_Cinematic_Q_Func072001 takes nothing returns boolean
    return ( udg_Bool_CinMidgameSkipped == true )
endfunction

function Trig_Midgame_Cinematic_Q_Func081001 takes nothing returns boolean
    return ( udg_Bool_CinMidgameSkipped == true )
endfunction

function Trig_Midgame_Cinematic_Q_Func089001 takes nothing returns boolean
    return ( udg_Bool_CinMidgameSkipped == true )
endfunction

function Trig_Midgame_Cinematic_Q_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    call ConditionalTriggerExecute(gg_trg_Midgame_CInematic_Set_Up)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_TurtlesConversation01, udg_Player_Actual, 0)
    // //
    call CameraSetFocalDistance(180.00)
    call CameraSetDepthOfFieldScale(60.00)
    // //
    // //
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_ChogallDefaultStart))
    // //
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_FakeGuldan, 0, 0, 90)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call PlaySoundBJ(gg_snd_WC3OrcDefeat)
    // //
    // Cinematic Started
    // //
    set udg_Bool_CinMidgameOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_TurtlesConversation02, udg_Player_Actual, 5.00, 0, 2.00, 100.00)
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeGuldan), GetRectCenter(gg_rct_ChogallDefaultStart)) / GetUnitMoveSpeed(udg_FakeGuldan) ))
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingTimed(udg_FakeGuldan, 156.12, 0.15)
    call SetUnitLookAt(udg_FakeGuldan, "bone_head", udg_FakeUtok, 0, 0, 90)
    // //
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    // //
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Standard One")
    // The Stormreaver Clan dispatched War Turtles to aid us against the Alliance navy... why are they not here?
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan17, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Shrug One")
    call QueueUnitAnimationBJ(udg_FakeUtok, "Cinematic Standard Three")
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Listening One")
    // These rivers are ill suited for the great beasts of the Southern Seas... they must have been slowed down and lost track of our ships...
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc08Utok4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_TurtlesConversation03, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Frustrated One")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "Cinematic Standard one")
    // Enough excuses! You will find our turtles, Scratcher, or I will report your failure to the Warchief myself...
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan18, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Headnod One")
    call QueueUnitAnimationBJ(udg_FakeUtok, "Cinematic Listening one")
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Listening One")
    // I will find them, Gul’dan.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc08Utok5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    // //
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Agree One")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "Cinematic Listening one")
    // See to it that you do.. it would be a shame if your title has made you weak in the face of true labour, Overseer...
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan19, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_TurtlesConversation04B, Player(0), 12.00, 0, 3.00, 100.00)
    // //
    call ResetUnitLookAt(udg_FakeGuldan)
    // //
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_GuldanIntro03))
    // //
    call TriggerSleepAction(2)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_WC3OrcDefeat, true)
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Angry One")
    call QueueUnitAnimationBJ(udg_FakeUtok, "Cinematic Listening one")
    // That warlock is starting to vex me greatly...
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc08Utok6, bj_TIMETYPE_ADD, 0, true)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Midgame_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Midgame_Cinematic_Q takes nothing returns nothing
    set gg_trg_Midgame_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Midgame_Cinematic_Q, function Trig_Midgame_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Midgame CInematic Set Up
//===========================================================================
function Trig_Midgame_CInematic_Set_Up_Func006A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenTroops)
endfunction

function Trig_Midgame_CInematic_Set_Up_Func009001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false )
endfunction

function Trig_Midgame_CInematic_Set_Up_Func009002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenTroops)
endfunction

function Trig_Midgame_CInematic_Set_Up_Func013001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_Midgame_CInematic_Set_Up_Func013001002002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Midgame_CInematic_Set_Up_Func013001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitHiddenBJ(GetFilterUnit()) == false)) // INLINED!!
endfunction

function Trig_Midgame_CInematic_Set_Up_Func013002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenTroops)
endfunction

function Trig_Midgame_CInematic_Set_Up_Func016C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_SemiHero_Utok) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Midgame_CInematic_Set_Up_Func018C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Guldan) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Hero_Guldan) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Midgame_CInematic_Set_Up_Func020C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Chogall) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Hero_Chogall) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Midgame_CInematic_Set_Up_Func023002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Midgame_CInematic_Set_Up_Func024002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Midgame_CInematic_Set_Up_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ConditionalTriggerExecute(gg_trg_SetCinematicVeryCloseFog)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_HidingUnitsMidgameCin), function Trig_Midgame_CInematic_Set_Up_Func006A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_LordaeronNavy, Condition(function Trig_Midgame_CInematic_Set_Up_Func009001002)), function Trig_Midgame_CInematic_Set_Up_Func009002)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_Midgame_CInematic_Set_Up_Func013001002)), function Trig_Midgame_CInematic_Set_Up_Func013002)
    // //
    // //
    if ( Trig_Midgame_CInematic_Set_Up_Func016C() ) then
        call GroupAddUnitSimple(udg_SemiHero_Utok, udg_Group_HiddenTroops)
    else
    endif
    // //
    if ( Trig_Midgame_CInematic_Set_Up_Func018C() ) then
        call GroupAddUnitSimple(udg_Hero_Guldan, udg_Group_HiddenTroops)
    else
    endif
    // //
    if ( Trig_Midgame_CInematic_Set_Up_Func020C() ) then
        call GroupAddUnitSimple(udg_Hero_Chogall, udg_Group_HiddenTroops)
    else
    endif
    // //
    // //
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Midgame_CInematic_Set_Up_Func023002)
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Midgame_CInematic_Set_Up_Func024002)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokStart), 290.42)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeGuldan, GetRectCenter(gg_rct_UtokLooksAtGuldan), GetRectCenter(gg_rct_UtokStart))
    call PauseUnitBJ(false, udg_FakeGuldan)
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Midgame_CInematic_Set_Up takes nothing returns nothing
    set gg_trg_Midgame_CInematic_Set_Up=CreateTrigger()
    call TriggerAddAction(gg_trg_Midgame_CInematic_Set_Up, function Trig_Midgame_CInematic_Set_Up_Actions)
endfunction

//===========================================================================
// Trigger: Midgame Cinematic Skipped
//===========================================================================
function Trig_Midgame_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinMidgameOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Midgame_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinMidgameSkipped=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_Midgame_Cinematic_Cleanup)
    call StopSoundBJ(gg_snd_WC3OrcDefeat, false)
    call StopSoundBJ(gg_snd_WC2Orc08Utok4, false)
    call StopSoundBJ(gg_snd_WC2Orc08Utok5, false)
    call StopSoundBJ(gg_snd_WC2Orc08Utok6, false)
    call StopSoundBJ(gg_snd_WC2Orc08Guldan17, false)
    call StopSoundBJ(gg_snd_WC2Orc08Guldan18, false)
    call StopSoundBJ(gg_snd_WC2Orc08Guldan19, false)
endfunction

//===========================================================================
function InitTrig_Midgame_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Midgame_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Midgame_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Midgame_Cinematic_Skipped, Condition(function Trig_Midgame_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Midgame_Cinematic_Skipped, function Trig_Midgame_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Midgame Cinematic Cleanup
//===========================================================================
function Trig_Midgame_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Midgame_Cinematic_Cleanup_Func016002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Midgame_Cinematic_Cleanup_Func017002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Midgame_Cinematic_Cleanup_Func020002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Midgame_Cinematic_Cleanup_Func023002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Midgame_Cinematic_Cleanup_Func029C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Midgame_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Midgame_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set udg_Bool_CinMidgameOn=false
    call ConditionalTriggerExecute(gg_trg_ResetFogToCurrentWeather)
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(udg_VarCurrentCamera), 0)
    call TriggerSleepAction(0.10)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Midgame_Cinematic_Cleanup_Func016002)
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Midgame_Cinematic_Cleanup_Func017002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_LordaeronNavy), function Trig_Midgame_Cinematic_Cleanup_Func020002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Lordaeron), function Trig_Midgame_Cinematic_Cleanup_Func023002)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Midgame_Cinematic_Cleanup_Func029C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    call QueuedTriggerRemoveBJ(gg_trg_Midgame_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    // //
    call TriggerExecute(gg_trg_Turtles_Discover)
endfunction

//===========================================================================
function InitTrig_Midgame_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Midgame_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Midgame_Cinematic_Cleanup, function Trig_Midgame_Cinematic_Cleanup_Actions)
endfunction

