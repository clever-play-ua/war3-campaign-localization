    set gg_trg_AI_P10_Transports_Availiable_Checker=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_AI_P10_Transports_Availiable_Checker, 60.00)
    call TriggerAddCondition(gg_trg_AI_P10_Transports_Availiable_Checker, Condition(function Trig_AI_P10_Transports_Availiable_Checker_Conditions))
