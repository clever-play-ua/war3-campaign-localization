//===========================================================================
// Trigger: Runestone Update Runestone
//===========================================================================
function Trig_Runestone_Update_Runestone_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Guldan ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runestone_Update_Runestone_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call PlaySoundAtPointBJ(gg_snd_Orescue, 100, GetRectCenter(gg_rct_RuneStoneCapture), 0)
    // //
    call SetUnitColor(gg_unit_ncp2_0038, PLAYER_COLOR_RED)
    call SetUnitColor(gg_unit_n60R_0003, PLAYER_COLOR_RED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Runestone, udg_Player_Lordaeron, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Runestone, udg_Player_LordaeronNavy, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Runestone, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Runestone, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    // //
    // Need somehow to nerf the enemy
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_RuneStoneCapture), "CSW\\Doodads\\Cinematic\\OrcCircleOfPower\\WCIICircleOfPower.mdx")
    set udg_SE_RuneStoneCaptured=GetLastCreatedEffectBJ()
    // //
    set udg_Bool_RunestoneSecured=true
    call DestroyMinimapIcon(udg_MinimapIcon_QuestRunestone_RS)
    // //
    call ConditionalTriggerExecute(gg_trg_Runestone_Update_Completed)
endfunction

//===========================================================================
function InitTrig_Runestone_Update_Runestone takes nothing returns nothing
    set gg_trg_Runestone_Update_Runestone=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Runestone_Update_Runestone, gg_rct_RuneStoneCapture)
    call TriggerAddCondition(gg_trg_Runestone_Update_Runestone, Condition(function Trig_Runestone_Update_Runestone_Conditions))
    call TriggerAddAction(gg_trg_Runestone_Update_Runestone, function Trig_Runestone_Update_Runestone_Actions)
endfunction

