    set gg_trg_Init_04_Environment=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_04_Environment, function Trig_Init_04_Environment_Actions)
endfunction

//===========================================================================
// Trigger: Init 05 Quests
//===========================================================================
function Trig_Init_05_Quests_Actions takes nothing returns nothing
    // //
    // MAIN QUEST: RUNESTONE
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_2983", "TRIGSTR_2984", "ReplaceableTextures\\CommandButtons\\BTNRunestone.dds")
    set udg_MQ_Runestone=GetLastCreatedQuestBJ()
    // //
    call CreateQuestItemBJ(udg_MQ_Runestone, "TRIGSTR_2985")
    set udg_QReq_DestroyCastle=GetLastCreatedQuestItemBJ()
    // //
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, GetRectCenter(gg_rct_PathingBlockerCastle), 512.00)
    set udg_VisMod_DestroyCastle=GetLastCreatedFogModifier()
    // //
    call CreateQuestItemBJ(udg_MQ_Runestone, "TRIGSTR_2986")
    set udg_QReq_SecureRunestone=GetLastCreatedQuestItemBJ()
    // //
    // OPTIONAL QUEST: LOST TURTLES
    // //
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2980", "TRIGSTR_2981", "ReplaceableTextures\\CommandButtons\\BTNSeaTurtleGreenGargantuan.blp")
    set udg_OQ_Turtles=GetLastCreatedQuestBJ()
    // //
    call CreateQuestItemBJ(udg_OQ_Turtles, "TRIGSTR_2982")
    set udg_QReq_LocateWarTurtles=GetLastCreatedQuestItemBJ()
    // //
endfunction

