//===========================================================================
// Trigger: AIP10 Start
//===========================================================================
function Trig_AIP10_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_TransportationConfig)
    // //
    call SetPlayerStateBJ(udg_Player_Lordaeron, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(udg_Player_Lordaeron, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call playerAddOil(Player(9) , 100000)
    call SetPlayerStateBJ(udg_Player_Lordaeron, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerStateBJ(udg_Player_Lordaeron, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    // //
    call EnableTrigger(gg_trg_AIP10_Gold)
    call EnableTrigger(gg_trg_AIP10_Lumber)
    // //
    call StartCampaignAI(udg_Player_Lordaeron, "CSW\\Scripts\\ToDScripts\\WC2Orc08\\WC2Orc08P10AllianceAI.ai")
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P10_Start_Attack_Command)
endfunction

