//===========================================================================
// Trigger: Intro Set Up
//===========================================================================
function Trig_Intro_Set_Up_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call CreateNUnitsAtLoc(1, 'e001', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DummyArcherTarget01), bj_UNIT_FACING)
    set udg_Unit_DummyArcherTargetArr[1]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'e001', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DummyArcherTarget02), bj_UNIT_FACING)
    set udg_Unit_DummyArcherTargetArr[2]=GetLastCreatedUnit()
    // //
    call SetUnitAnimation(gg_unit_o60D_0031, "stand work")
    call SetUnitAnimation(gg_unit_o60D_0030, "stand work")
    call SetUnitAnimation(gg_unit_o614_0015, "stand work")
    call SetUnitAnimation(gg_unit_n60R_0003, "stand")
    call SetUnitAnimation(gg_unit_n001_0016, "sleep")
    // //
    call SetUnitMoveSpeed(gg_unit_o61D_0315, 100.00)
    call BlzSetUnitRealFieldBJ(gg_unit_o61D_0315, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call IssuePointOrderLocBJ(gg_unit_o61D_0315, "patrol", GetRectCenter(gg_rct_OgrePatrol))
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", gg_unit_o61D_0315)
    // //
    // //
    call BlzSetUnitWeaponRealFieldBJ(gg_unit_h625_0332, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 4.00)
    call BlzSetUnitWeaponRealFieldBJ(gg_unit_h625_0026, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 4.00)
    call BlzSetUnitWeaponRealFieldBJ(gg_unit_h625_0333, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 4.00)
    call IssueTargetOrderBJ(gg_unit_h625_0332, "attack", udg_Unit_DummyArcherTargetArr[1])
    call IssueTargetOrderBJ(gg_unit_h625_0333, "attack", udg_Unit_DummyArcherTargetArr[2])
    // //
    // //
    call SetUnitPathing(gg_unit_nwc2_0336, false)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'nvil', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_NecroExperiment), GetUnitLoc(gg_unit_U60B_0039))
    set udg_Unit_Villager=GetLastCreatedUnit()
    call SetUnitLifeBJ(udg_Unit_Villager, 100.00)
    // //
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60S_0035, GetRectCenter(gg_rct_Juggernaurt_Intro02), GetRectCenter(gg_rct_Juggernaurt_Intro01))
    call SetUnitScalePercent(gg_unit_o60S_0035, 170.00, 170.00, 170.00)
    // //
    call SetUnitBlendTimeBJ(gg_unit_n001_0016, 0.25)
    // //
    call TriggerSleepAction(0.01)
    // //
    call ShowUnitHide(udg_SemiHero_Utok)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    // //
    call ShowUnitHide(udg_Hero_Chogall)
    call PauseUnitBJ(true, udg_Hero_Chogall)
    // //
    call ShowUnitHide(udg_Hero_Guldan)
    call PauseUnitBJ(true, udg_Hero_Guldan)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokIntro00), GetUnitLoc(gg_unit_h625_0026))
    call SetUnitPositionLocFacingBJ(udg_FakeGuldan, GetRectCenter(gg_rct_IntroGuldanStarts), bj_UNIT_FACING)
    // //
endfunction

//===========================================================================
function InitTrig_Intro_Set_Up takes nothing returns nothing
    set gg_trg_Intro_Set_Up=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Set_Up, function Trig_Intro_Set_Up_Actions)
endfunction

