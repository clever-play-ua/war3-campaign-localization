//===========================================================================
// Trigger: Intro Cinematic Cleanup
//===========================================================================
function Trig_Intro_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func078C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
        call DestroyEffectBJ(udg_SE_IntroPriestCastArr[1])
        call DestroyEffectBJ(udg_SE_IntroPriestCastArr[2])
        call DestroyEffectBJ(udg_SE_IntroPriestCastArr[3])
    endif
    // ----------------------------------------
    call DisableTrigger(gg_trg_Intro_Cinematic_GuldanAnim)
    call DisableTrigger(gg_trg_Intro_Cinematic_GuldanTurn)
    call DisableTrigger(gg_trg_Intro_Cinematic_ChogallTurn)
    call DisableTrigger(gg_trg_Intro_Cinematic_UtokA)
    call DisableTrigger(gg_trg_Intro_Cinematic_UtokB)
    call DisableTrigger(gg_trg_Intro_Cinematic_UtokC)
    // //
    set udg_Bool_CinIntroOn=false
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call ShowUnitShow(udg_SemiHero_Utok)
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_UtokStart), bj_UNIT_FACING)
    call SetUnitOwner(udg_SemiHero_Utok, udg_Player_Actual, false)
    call SetUnitAnimation(udg_SemiHero_Utok, "Cinematic Writing One")
    // //
    call ShowUnitShow(udg_Hero_Chogall)
    call PauseUnitBJ(false, udg_Hero_Chogall)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Chogall, GetRectCenter(gg_rct_ChogallDefaultStart), GetRectCenter(gg_rct_GuldanDefaultStart))
    call SetUnitOwner(udg_Hero_Chogall, udg_Player_Actual, false)
    // //
    call ShowUnitShow(udg_Hero_Guldan)
    call PauseUnitBJ(false, udg_Hero_Guldan)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Guldan, GetRectCenter(gg_rct_GuldanDefaultStart), GetRectCenter(gg_rct_ChogallDefaultStart))
    call SetUnitOwner(udg_Hero_Guldan, udg_Player_Actual, false)
    // //
    call DestroyEffectBJ(udg_SE_VillagerEffect)
    call SetUnitScalePercent(gg_unit_o60S_0035, 140.00, 140.00, 140.00)
    call DestroyLightningBJ(udg_SE_GuldanLightning)
    // //
    call ConditionalTriggerExecute(gg_trg_ResetFogToCurrentWeather)
    // //
    call ResetUnitAnimation(gg_unit_o60D_0030)
    call ResetUnitAnimation(gg_unit_o60D_0031)
    call ResetUnitAnimation(gg_unit_o614_0015)
    // //
    // //
    call IssueImmediateOrderBJ(gg_unit_o60D_0031, "autoharvestgold")
    call IssueImmediateOrderBJ(gg_unit_o60D_0030, "autoharvestlumber")
    // //
    call IssueImmediateOrderBJ(gg_unit_o61D_0315, "stop")
    call SetUnitPositionLocFacingBJ(gg_unit_o61D_0315, GetRectCenter(gg_rct_OgreStartPosition), bj_UNIT_FACING)
    call SetUnitMoveSpeed(gg_unit_o61D_0315, GetUnitDefaultMoveSpeed(gg_unit_o61D_0315))
    call BlzSetUnitRealFieldBJ(gg_unit_o61D_0315, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", gg_unit_o61D_0315)
    // //
    call SetUnitAnimation(gg_unit_n001_0016, "sleep")
    // //
    call BlzSetUnitWeaponRealFieldBJ(gg_unit_h625_0332, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 1.80)
    call BlzSetUnitWeaponRealFieldBJ(gg_unit_h625_0026, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 1.80)
    call BlzSetUnitWeaponRealFieldBJ(gg_unit_h625_0333, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0, 1.80)
    // //
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60S_0035, GetRectCenter(gg_rct_Juggernaurt_Intro01), GetRectCenter(gg_rct_Trap))
    // //
    call CreateFogModifierRadiusLocBJ(false, udg_Player_Actual, FOG_OF_WAR_MASKED, GetRectCenter(gg_rct_ChoGallIntro), 2048.00)
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_GameCamera), 0)
    call TriggerSleepAction(0.01)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call ConditionalTriggerExecute(gg_trg_SetUpOilPatchCapacity)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    // //
    call ConditionalTriggerExecute(gg_trg_Creating_and_Setting_Weather)
    // ----------------------------------------
    call SelectUnitForPlayerSingle(udg_Hero_Guldan, udg_Player_Actual)
    // //
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func078C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    // StartGame
    call ConditionalTriggerExecute(gg_trg_Runestone_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

