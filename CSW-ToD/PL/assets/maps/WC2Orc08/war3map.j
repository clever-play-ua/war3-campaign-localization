//===========================================================================
// Trigger: Init 01 Players
//===========================================================================
function Trig_Init_01_Players_Actions takes nothing returns nothing
    // //
    // Player User
    // //
    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[0]
    set udg_Player_Actual=Player(0)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_264")
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 2000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 2000)
    call playerAddOil(Player(0) , 1000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_NAVY, true)
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 15.00)
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Player_Actual)
    // //
    // Runestone
    // //
    set udg_Player_Runestone=Player(1)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_Runestone)
    call SetPlayerColorBJ(udg_Player_Runestone, PLAYER_COLOR_LIGHT_BLUE, true)
    // //
    // Wildhammer
    // //
    set udg_Player_Wildhammer=Player(22)
    // //
    // Lordaeron
    // //
    set udg_Player_Lordaeron=Player(9)
    call SetPlayerHandicapXPBJ(udg_Player_Lordaeron, 25.00)
    call SetPlayerAbilityAvailableBJ(false, 'A65B', udg_Player_Lordaeron)
    call SetPlayerTechResearchedSwap('R016', 1, udg_Player_Lordaeron)
    call SetPlayerColorBJ(udg_Player_Lordaeron, PLAYER_COLOR_SNOW, true)
    // //
    set udg_Player_LordaeronNavy=Player(8)
    call SetPlayerColorBJ(udg_Player_LordaeronNavy, PLAYER_COLOR_SNOW, true)
    call SetPlayerAbilityAvailableBJ(false, 'A65B', udg_Player_LordaeronNavy)
    call SetPlayerTechResearchedSwap('R016', 1, udg_Player_LordaeronNavy)
    // //
    // Castle is set to be DIfferent Player to no confuse the AI controller of the Lordaeron players
    set udg_Player_Castle=Player(14)
    call SetPlayerColorBJ(udg_Player_Castle, PLAYER_COLOR_SNOW, true)
    call SetPlayerTechResearchedSwap('R00L', 1, udg_Player_Castle)
    // //
    call ForceAddPlayerSimple(udg_Player_Castle, udg_PlayerGroup_PlayerAlliance)
    call ForceAddPlayerSimple(udg_Player_Lordaeron, udg_PlayerGroup_PlayerAlliance)
    call ForceAddPlayerSimple(udg_Player_LordaeronNavy, udg_PlayerGroup_PlayerAlliance)
    // //
    call SetForceAllianceStateBJ(udg_PlayerGroup_PlayerActual, udg_PlayerGroup_PlayerAlliance, bj_ALLIANCE_UNALLIED)
    call SetForceAllianceStateBJ(udg_PlayerGroup_PlayerAlliance, udg_PlayerGroup_PlayerActual, bj_ALLIANCE_UNALLIED)
    // //
    // Cinematics
    // //
    set udg_Player_Blackrock=Player(12)
    call SetPlayerColorBJ(udg_Player_Blackrock, PLAYER_COLOR_RED, true)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_Blackrock)
    // //
    set udg_Player_TwilightHammer=Player(3)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_TwilightHammer)
    // //
    call EnableCreepSleepBJ(false)
    // //
    // Alliances
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Blackrock, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Blackrock, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammer, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_TwilightHammer, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_LordaeronNavy, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_LordaeronNavy, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Runestone, udg_Player_Lordaeron, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Runestone, udg_Player_LordaeronNavy, bj_ALLIANCE_ALLIED)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_06a_Hard)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Normal)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Easy)
    // //
endfunction

