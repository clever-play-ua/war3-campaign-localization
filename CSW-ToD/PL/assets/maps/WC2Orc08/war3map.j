//===========================================================================
// Trigger: Final Cinematic Skipped
//===========================================================================
function Trig_Final_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinOutroSkipped=true
    set udg_Bool_CinematicSkipped=true
    call StopSoundBJ(gg_snd_mus_60_ogremines_b, false)
    call StopSoundBJ(gg_snd_RaminDjawadi___Guldan, false)
    call StopSoundBJ(gg_snd_WC2Orc08Guldan20, false)
    call StopSoundBJ(gg_snd_WC2Orc08Guldan21, false)
    call StopSoundBJ(gg_snd_WC2Orc08Guldan22, false)
    call StopSoundBJ(gg_snd_WC2Orc08Guldan23, false)
    call StopSoundBJ(gg_snd_WC2Orc08Guldan24, false)
    call StopSoundBJ(gg_snd_WC2Orc08Guldan25, false)
    call StopSoundBJ(gg_snd_WC2Orc08Doomhammer1, false)
    call StopSoundBJ(gg_snd_WC2Orc08Doomhammer2, false)
    call StopSoundBJ(gg_snd_WC2Orc08Doomhammer3, false)
    call StopSoundBJ(gg_snd_WC2Orc08ChoGall6, false)
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Final_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Final_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Final_Cinematic_Skipped, Condition(function Trig_Final_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Final_Cinematic_Skipped, function Trig_Final_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Final Cinematic OgreMagiTransform
//===========================================================================
function Trig_Final_Cinematic_OgreMagiTransform_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Final_Cinematic_RandomSEOgre)
    // //
    call DestroyEffectBJ(udg_SE_RSManaDrainIN[1])
    call DestroyLightningBJ(udg_SE_EnergyDrain[2])
    call ResetUnitAnimation(udg_Unit_OgreFinalCinematicArr[1])
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Unit_OgreFinalCinematicArr[1]), "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_OgreTransformation=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    call ReplaceUnitBJ(udg_Unit_OgreFinalCinematicArr[1], 'n002', bj_UNIT_STATE_METHOD_RELATIVE)
    call TriggerSleepAction(0.50)
    call DestroyEffectBJ(udg_SE_OgreTransformation)
    // //
    call DestroyEffectBJ(udg_SE_RSManaDrainIN[2])
    call DestroyLightningBJ(udg_SE_EnergyDrain[3])
    call ResetUnitAnimation(udg_Unit_OgreFinalCinematicArr[2])
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Unit_OgreFinalCinematicArr[2]), "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_OgreTransformation=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    call ReplaceUnitBJ(udg_Unit_OgreFinalCinematicArr[2], 'n002', bj_UNIT_STATE_METHOD_RELATIVE)
    call TriggerSleepAction(0.50)
    call DestroyEffectBJ(udg_SE_OgreTransformation)
    // //
    call DestroyEffectBJ(udg_SE_RSManaDrainIN[3])
    call DestroyLightningBJ(udg_SE_EnergyDrain[4])
    call ResetUnitAnimation(udg_Unit_OgreFinalCinematicArr[3])
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Unit_OgreFinalCinematicArr[3]), "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_OgreTransformation=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    call ReplaceUnitBJ(udg_Unit_OgreFinalCinematicArr[3], 'n002', bj_UNIT_STATE_METHOD_RELATIVE)
    call TriggerSleepAction(0.50)
    call DestroyEffectBJ(udg_SE_OgreTransformation)
    // //
    call DestroyEffectBJ(udg_SE_RSManaDrainIN[4])
    call DestroyLightningBJ(udg_SE_EnergyDrain[5])
    call ResetUnitAnimation(udg_Unit_OgreFinalCinematicArr[4])
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Unit_OgreFinalCinematicArr[4]), "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_OgreTransformation=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    call ReplaceUnitBJ(udg_Unit_OgreFinalCinematicArr[4], 'n002', bj_UNIT_STATE_METHOD_RELATIVE)
    call TriggerSleepAction(0.50)
    call DestroyEffectBJ(udg_SE_OgreTransformation)
    // //
    call DestroyEffectBJ(udg_SE_RSManaDrainIN[5])
    call DestroyLightningBJ(udg_SE_EnergyDrain[6])
    call ResetUnitAnimation(udg_Unit_OgreFinalCinematicArr[5])
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Unit_OgreFinalCinematicArr[5]), "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_OgreTransformation=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    call ReplaceUnitBJ(udg_Unit_OgreFinalCinematicArr[5], 'n002', bj_UNIT_STATE_METHOD_RELATIVE)
    call TriggerSleepAction(0.50)
    call DestroyEffectBJ(udg_SE_OgreTransformation)
    // //
    call DestroyEffectBJ(udg_SE_RSManaDrainIN[6])
    call DestroyLightningBJ(udg_SE_EnergyDrain[7])
    call ResetUnitAnimation(udg_Unit_OgreFinalCinematicArr[6])
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Unit_OgreFinalCinematicArr[6]), "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_OgreTransformation=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    call ReplaceUnitBJ(udg_Unit_OgreFinalCinematicArr[6], 'n002', bj_UNIT_STATE_METHOD_RELATIVE)
    call TriggerSleepAction(0.50)
    call DestroyEffectBJ(udg_SE_OgreTransformation)
    // //
