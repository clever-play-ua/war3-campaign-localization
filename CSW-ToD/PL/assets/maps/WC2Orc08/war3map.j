    call PlaySoundAtPointBJ(gg_snd_ShimmeringPortalEntrance, 100, GetRectCenter(gg_rct_CastRune01), 0)
    // //
    call CreateNUnitsAtLoc(1, 'o61N', udg_Player_Actual, GetRectCenter(gg_rct_CastRune01), bj_UNIT_FACING)
    set udg_Unit_RuneArr[1]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_RuneArr[1], "birth")
    call QueueUnitAnimationBJ(udg_Unit_RuneArr[1], "stand")
    // //
    call CreateNUnitsAtLoc(1, 'o61N', udg_Player_Actual, GetRectCenter(gg_rct_CastRune03), bj_UNIT_FACING)
    set udg_Unit_RuneArr[2]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_RuneArr[2], "birth")
    call QueueUnitAnimationBJ(udg_Unit_RuneArr[2], "stand")
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // OgreRepeats
    call SetUnitFacingToFaceLocTimed(udg_Unit_OgreMagiApprentice, GetRectCenter(gg_rct_CastRune01), 1.00)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_OgreMagiApprentice, "spell")
    call QueueUnitAnimationBJ(udg_Unit_OgreMagiApprentice, "stand")
    // //
    call TriggerSleepAction(1.17)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundAtPointBJ(gg_snd_ShimmeringPortalEntrance, 100, GetRectCenter(gg_rct_CastRune02), 0)
    // //
    call CreateNUnitsAtLoc(1, 'o61N', udg_Player_Actual, GetRectCenter(gg_rct_CastRune02), bj_UNIT_FACING)
    set udg_Unit_RuneArr[3]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_RuneArr[3], "birth")
    call QueueUnitAnimationBJ(udg_Unit_RuneArr[3], "stand")
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueTargetOrderBJ(udg_Unit_PigKeeper, "attack", udg_Unit_Pig)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueImmediateOrderBJ(udg_Unit_PigKeeper, "stop")
    call IssuePointOrderLocBJ(udg_Unit_Pig, "move", GetRectCenter(gg_rct_CastRune02))
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_Unit_Pig), GetRectCenter(gg_rct_CastRune02)) / GetUnitMoveSpeed(udg_Unit_Pig) ))
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillUnit(udg_Unit_RuneArr[3])
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ExplodeUnitBJ(udg_Unit_Pig)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillUnit(udg_Unit_RuneArr[3])
    // //
    // Chogal Reports to Guldan
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_FinalCin09ChogallReports, udg_Player_Actual, 12.00, 0, 3.00, 100.00)
    // //
    call KillUnit(udg_Unit_RuneArr[3])
    // //
    call IssuePointOrderLocBJ(udg_Unit_OgreMagiApprentice, "move", GetRandomLocInRect(gg_rct_Bunch_Of_Ogres_Mages))
    // //
    call SetUnitFacingToFaceLocTimed(udg_FakeChogal, GetRectCenter(gg_rct_GuldanAltarFinal02), 1.50)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillUnit(udg_Unit_RuneArr[2])
    call KillUnit(udg_Unit_RuneArr[1])
    // //
    call SetUnitLookAt(udg_FakeChogal, "bone_head", udg_FakeGuldan, 0, 0, 90)
    call SetUnitAnimationWithRarity(udg_FakeChogal, "stand", RARITY_FREQUENT)
    // //
    set udg_Bool_OgresMumblingOn=false
    // //
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_CastRune01))
    call SetUnitFacingToFaceLocTimed(udg_FakeChogal, GetRectCenter(gg_rct_CastRune01), ( DistanceBetweenPoints(GetUnitLoc(udg_FakeGuldan), GetRectCenter(gg_rct_CastRune01)) / GetUnitMoveSpeed(udg_FakeGuldan) ))
    // //
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_FakeChogal)
    // //
    // |cffffcc00Cho:|r These new Ogre-magi are very impressive master. |n|cffffcc00Gall:|r Their cunning and cruelty is now comparible only with yours!
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogal, 0, gg_snd_WC2Orc08ChoGall6, bj_TIMETYPE_ADD, 0, false)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeGuldan), GetRectCenter(gg_rct_CastRune01)) / GetUnitMoveSpeed(udg_FakeGuldan) ))
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingTimed(udg_FakeGuldan, 270.00, 0.50)
    // //
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc08ChoGall6) - ( DistanceBetweenPoints(GetRectCenter(gg_rct_GuldanAltarFinal02), GetRectCenter(gg_rct_CastRune01)) / GetUnitMoveSpeed(udg_FakeGuldan) ) ))
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_mus_60_ogremines_b, true)
    // //
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Agree One")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "Cinematic Listening One")
    // Good as I exactly planned for.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan25, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

//===========================================================================
function InitTrig_Final_Cinematic takes nothing returns nothing
    set gg_trg_Final_Cinematic=CreateTrigger()
    call TriggerAddAction(gg_trg_Final_Cinematic, function Trig_Final_Cinematic_Actions)
endfunction

//===========================================================================
// Trigger: Final Cinematic Setup
//===========================================================================
function Trig_Final_Cinematic_Setup_Func009001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Final_Cinematic_Setup_Func009001002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false )
endfunction

function Trig_Final_Cinematic_Setup_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false)) // INLINED!!
endfunction

function Trig_Final_Cinematic_Setup_Func009002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_Setup_Func012002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_Setup_Func014002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_Setup_Func017001002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Final_Cinematic_Setup_Func017002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_Setup_Func091C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Guldan) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_Setup_Func093C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Chogall) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_LordaeronNavy, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_LordaeronNavy, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CaerDarrow01, Condition(function Trig_Final_Cinematic_Setup_Func009001002)), function Trig_Final_Cinematic_Setup_Func009002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_LordaeronNavy), function Trig_Final_Cinematic_Setup_Func012002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Lordaeron), function Trig_Final_Cinematic_Setup_Func014002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CampOnShore, Condition(function Trig_Final_Cinematic_Setup_Func017001002)), function Trig_Final_Cinematic_Setup_Func017002)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    // Create Actors
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre00), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[1]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre01), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[2]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre02), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[3]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre03), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[4]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre04), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[5]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre05), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[6]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre06), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[7]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre07), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[8]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre08), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[9]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre09), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[10]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre10), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[11]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre11), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[12]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre12), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[13]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre13), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[14]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre14), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[15]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FCSpellOgre15), GetRectCenter(gg_rct_FCSpellChogall))
    set udg_Unit_OgreFinalCinematicArr[16]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OgreCin)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=15
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'n001', udg_Player_Actual, GetRandomLocInRect(gg_rct_Bunch_Of_Ogres), GetRandomDirectionDeg())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_AltarOgreIN)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call TriggerSleepAction(0.01)
    // //
    if ( Trig_Final_Cinematic_Setup_Func091C() ) then
        call ShowUnitHide(udg_Hero_Guldan)
    else
    endif
    // //
    if ( Trig_Final_Cinematic_Setup_Func093C() ) then
        call ShowUnitHide(udg_Hero_Chogall)
    else
    endif
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeGuldan, GetRectCenter(gg_rct_FCSpellChogall), GetUnitLoc(gg_unit_n60R_0003))
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeChogal, GetRectCenter(gg_rct_FCSpellChogallStart), GetUnitLoc(gg_unit_n60R_0003))
    // //
endfunction

