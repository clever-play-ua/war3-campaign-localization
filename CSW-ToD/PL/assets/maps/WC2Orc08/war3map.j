function Trig_IndexTransports_Conditions takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[udg_UDex] == 'h60P' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_Lordaeron ) ) then
        return false
    endif
    return true
endfunction

function Trig_IndexTransports_Actions takes nothing returns nothing
    call s__IndexShipCargo_onIndex(udg_UDexUnits[udg_UDex])
endfunction

