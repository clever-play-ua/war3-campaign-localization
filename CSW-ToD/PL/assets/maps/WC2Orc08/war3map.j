//*
//*  Map Configuration
//*
//***************************************************************************

function config takes nothing returns nothing
    call SetMapName("TRIGSTR_001")
    call SetMapDescription("TRIGSTR_373")
    call SetPlayers(6)
    call SetTeams(6)
    call SetGamePlacement(MAP_PLACEMENT_USE_MAP_SETTINGS)

    call DefineStartLocation(0, - 7744.0, 9536.0)
    call DefineStartLocation(1, 2432.0, - 1728.0)
    call DefineStartLocation(2, 10112.0, - 5312.0)
    call DefineStartLocation(3, 704.0, - 64.0)
    call DefineStartLocation(4, 5952.0, 2432.0)
    call DefineStartLocation(5, - 5696.0, 320.0)

    // Player setup
    call InitCustomPlayerSlots()
    call InitCustomTeams()
    call InitAllyPriorities()
endfunction




