//===========================================================================
// Trigger: TRReturnAndRecycle
//===========================================================================
function Trig_TRReturnAndRecycle_Func001Func001Func006C takes nothing returns boolean
    return true
endfunction

function Trig_TRReturnAndRecycle_Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_IdleTransports[GetConvertedPlayerId(udg_Player_Lordaeron)]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_QueuedTransports[GetConvertedPlayerId(udg_Player_Lordaeron)]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_DepartedTransports[GetConvertedPlayerId(udg_Player_Lordaeron)]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TRReturnAndRecycle_Func001Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TRReturnAndRecycle_Func001A takes nothing returns nothing
    if ( Trig_TRReturnAndRecycle_Func001Func001C() ) then
        call RecycleGuardPosition(GetEnumUnit())
        // Covering Repair case here
        if ( (true) ) then // INLINED!!
            // Covering Repair case here
        else
        endif
    else
    endif
    if ( Trig_TRReturnAndRecycle_Func001Func002C() ) then
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_LordTransShipReturnAwait)
    else
    endif
endfunction

function Trig_TRReturnAndRecycle_Actions takes nothing returns nothing
    call ForGroupBJ(udg_Group_LordTransShipReturnAwait, function Trig_TRReturnAndRecycle_Func001A)
endfunction

//===========================================================================
function InitTrig_TRReturnAndRecycle takes nothing returns nothing
    set gg_trg_TRReturnAndRecycle=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_TRReturnAndRecycle, GetRandomReal(1.50, 3.00))
    call TriggerAddAction(gg_trg_TRReturnAndRecycle, function Trig_TRReturnAndRecycle_Actions)
endfunction

