//===========================================================================
// Trigger: OilSpentForHumanTransport
//
// Transport Ship
//===========================================================================
function Trig_OilSpentForHumanTransport_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetTrainedUnitType() == 'h60P' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForHumanTransport_Func018C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForHumanTransport_Actions takes nothing returns nothing
    // -------------------------------------
    // Check the amount of Oil for Player
    if (OilHarvest__playerOil[GetPlayerId((Player(8)))]) < 500 then // INLINED!!
    // // UI Warning
    // No need for it for computer driven player
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(8) , - 500)
    else
    // need to decrease the oil if there was enough of it and ship started to build
    call playerAddOil(Player(8) , - 500)
    endif
    // //
    if ( Trig_OilSpentForHumanTransport_Func018C() ) then
        call DisplayTextToForce(udg_PlayerGroup_PlayerActual, ( "Lordaeron ma obecnie: " + I2S((OilHarvest__playerOil[GetPlayerId((Player(8)))])) + " jednostek ropy" )) // INLINED!!
    else
    endif
endfunction

//===========================================================================
function InitTrig_OilSpentForHumanTransport takes nothing returns nothing
    set gg_trg_OilSpentForHumanTransport=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilSpentForHumanTransport, Player(8), EVENT_PLAYER_UNIT_TRAIN_START)
    call TriggerAddCondition(gg_trg_OilSpentForHumanTransport, Condition(function Trig_OilSpentForHumanTransport_Conditions))
