function Trig_Init_02_Units_Func073001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'nShP' )
endfunction

function Trig_Init_02_Units_Func073A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_Sharks)
endfunction

function Trig_Init_02_Units_Func076A takes nothing returns nothing
    call UnitAddAbilityBJ('Awan', GetEnumUnit())
endfunction

function Trig_Init_02_Units_Actions takes nothing returns nothing
    // Remove Editor Dummies
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(23)), function Trig_Init_02_Units_Func003A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Init_02_Units_Func006001002)), function Trig_Init_02_Units_Func006A)
    // //
    call ForGroupBJ(udg_Group_HiddenTurtles, function Trig_Init_02_Units_Func008002)
    call ForGroupBJ(udg_Group_HiddenTurtles, function Trig_Init_02_Units_Func009002)
    // /
    set udg_Hero_ElfMage=gg_unit_H003_0262
    call RemoveGuardPosition(udg_Hero_ElfMage)
    // /
    call RemoveGuardPosition(gg_unit_n605_0095)
    // /
    call RemoveGuardPosition(gg_unit_e000_0339)
    call RemoveGuardPosition(gg_unit_e000_0365)
    // /
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Wildhammer), function Trig_Init_02_Units_Func020002)
    // /
    call ForGroupBJ(udg_Group_WildhammerDwarves, function Trig_Init_02_Units_Func022002)
    call ForGroupBJ(udg_Group_WildhammerDwarves, function Trig_Init_02_Units_Func023002)
    // /
    // Neutrals
    call IssuePointOrderLocBJ(gg_unit_nrog_0318, "patrol", GetRectCenter(gg_rct_RoguePatrol))
    // /
    call UnitAddAbilityBJ('Anl1', gg_unit_u003_0176)
    call UnitAddAbilityBJ('Anl1', gg_unit_u003_0280)
    // /
    // //
    // Hide Murlocks that will ambush player
    // //
    call ShowUnitHide(gg_unit_nmrl_0071)
    call ShowUnitHide(gg_unit_nmfs_0074)
    call ShowUnitHide(gg_unit_nmrl_0204)
    call ShowUnitHide(gg_unit_nmrl_0203)
    call ShowUnitHide(gg_unit_nmrl_0205)
    call ShowUnitHide(gg_unit_nmrl_0252)
    call ShowUnitHide(gg_unit_nmrl_0253)
    call ShowUnitHide(gg_unit_nmrr_0254)
    call ShowUnitHide(gg_unit_nmrl_0255)
    call ShowUnitHide(gg_unit_nmrl_0210)
    call ShowUnitHide(gg_unit_nspb_0371)
    // //
    call SetUnitInvulnerable(gg_unit_nten_0369, true)
    call SetUnitInvulnerable(gg_unit_ntn2_0370, true)
    // //
    call SetUnitAnimation(gg_unit_nvil_0404, "stand work")
    call SetUnitAnimation(gg_unit_nvl2_0403, "stand work")
    // //
    call ConditionalTriggerExecute(gg_trg_VillagerWalking)
    // //
    // //
    call RemoveGuardPosition(gg_unit_n605_0095)
    // //
    // //
    call ShowUnitHide(gg_unit_hAFS_0302)
    call ShowUnitHide(gg_unit_hAFS_0295)
    // //
    set udg_UnitType_BanditSpawnArr[1]='nban'
    set udg_UnitType_BanditSpawnArr[2]='nbrg'
    set udg_UnitType_BanditSpawnArr[3]='nrog'
    set udg_UnitType_BanditSpawnArr[4]='nass'
    set udg_UnitType_BanditSpawnArr[5]='nenf'
    // //
    // Sharks
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(Player(PLAYER_NEUTRAL_AGGRESSIVE), Condition(function Trig_Init_02_Units_Func070001002)), function Trig_Init_02_Units_Func070A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(Player(PLAYER_NEUTRAL_AGGRESSIVE), Condition(function Trig_Init_02_Units_Func073001002)), function Trig_Init_02_Units_Func073A)
    // //
    // //
    call ForGroupBJ(udg_Group_Sharks, function Trig_Init_02_Units_Func076A)
    // //
    // //
    // //
    // //
    // //
endfunction

