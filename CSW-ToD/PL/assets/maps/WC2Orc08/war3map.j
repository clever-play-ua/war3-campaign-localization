function Trig_AI_P09_Defeated_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_LordaeronNavy ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P09_Defeated_Func002Func001001001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60X' )
endfunction

function Trig_AI_P09_Defeated_Func002Func001001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P09_Defeated_Func002Func001001001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h60X'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P09_Defeated_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(udg_Player_LordaeronNavy, Condition(function Trig_AI_P09_Defeated_Func002Func001001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P09_Defeated_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_AI_P09_Defeated_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_AI_P09_Gold)
        call DisableTrigger(gg_trg_AI_P09_Lumber)
        call ConditionalTriggerExecute(gg_trg_AI_P09_Stop_Attack_Command)
        call ConditionalTriggerExecute(gg_trg_AI_P09_Defeat_Command)
    else
    endif
endfunction

