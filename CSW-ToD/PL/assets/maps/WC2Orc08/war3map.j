    set gg_trg_Turtles_Discover=CreateTrigger()
    call TriggerAddAction(gg_trg_Turtles_Discover, function Trig_Turtles_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Turtles Discover Q
//===========================================================================
function Trig_Turtles_Discover_Q_Actions takes nothing returns nothing
    // //
    call CreateLeaderboardBJ(GetPlayersAll(), "TRIGSTR_2999")
    set udg_Leaderboard_QuestObjectives=GetLastCreatedLeaderboard()
    // //
    call LeaderboardAddItemBJ(udg_Player_Actual, udg_Leaderboard_QuestObjectives, "TRIGSTR_3000", ( 6 - udg_Int_TurtlesLocatedCounter ))
    call LeaderboardSetPlayerItemLabelColorBJ(udg_Player_Actual, udg_Leaderboard_QuestObjectives, 100, 80, 20, 0)
    call LeaderboardSetPlayerItemValueColorBJ(udg_Player_Actual, udg_Leaderboard_QuestObjectives, 100, 80, 20, 0)
    call LeaderboardSetPlayerItemStyleBJ(udg_Player_Actual, udg_Leaderboard_QuestObjectives, true, true, false)
    call LeaderboardDisplayBJ(true, udg_Leaderboard_QuestObjectives)
    // //
    call QuestSetDiscoveredBJ(udg_OQ_Turtles, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3002")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_3001")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

