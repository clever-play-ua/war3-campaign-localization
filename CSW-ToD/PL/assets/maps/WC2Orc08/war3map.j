function Trig_AI_P09_Attacker_Being_Attacked_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_AI_P09_Attacker_Being_Attacked_Func003C() ) then
        call ForGroupBJ(udg_G_P09_Attacker, function Trig_AI_P09_Attacker_Being_Attacked_Func003Func001A)
        call PolledWait(6.00)
        call ForGroupBJ(udg_G_P09_Attacker, function Trig_AI_P09_Attacker_Being_Attacked_Func003Func004A)
    else
        if ( Trig_AI_P09_Attacker_Being_Attacked_Func003Func005C() ) then
            call ForGroupBJ(udg_G_P09_Attacker, function Trig_AI_P09_Attacker_Being_Attacked_Func003Func005Func001A)
            call PolledWait(6.00)
            call ForGroupBJ(udg_G_P09_Attacker, function Trig_AI_P09_Attacker_Being_Attacked_Func003Func005Func004A)
        else
        endif
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction

