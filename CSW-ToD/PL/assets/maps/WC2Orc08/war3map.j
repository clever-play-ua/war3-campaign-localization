//===========================================================================
function Trig_Runestone_Update_Completed_Func001C takes nothing returns boolean
    if ( not ( udg_Bool_CastleDestroyed == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_RunestoneSecured == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runestone_Update_Completed_Actions takes nothing returns nothing
    if ( Trig_Runestone_Update_Completed_Func001C() ) then
        call QueuedTriggerAddBJ(gg_trg_Runestone_Completed_Q, true)
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerAddBJ(gg_trg_Final_Cinematic, true)
    else
        call QueuedTriggerAddBJ(gg_trg_Runestone_Update_Q, true)
    endif
endfunction

