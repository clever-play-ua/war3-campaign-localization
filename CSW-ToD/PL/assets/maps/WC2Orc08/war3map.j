// Trigger: Light Snow Begin
//===========================================================================
function Trig_Light_Snow_Begin_Actions takes nothing returns nothing
    // //
    call AddWeatherEffectSaveLast(GetEntireMapRect(), 'SNls')
    set udg_Weather_SnowLight=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_SnowLight, true)
    set udg_Bool_SnowLightActive=true
    // //
    set udg_Bool_Snowing=true
    // //
    call TriggerExecute(gg_trg_SnowIn)
    // //
    call StartTimerBJ(udg_Timer_WeatherSnowLightDur, false, GetRandomReal(udg_Real_WeatherSnowLightDurBot, udg_Real_WeatherSnowLightDurTop))
endfunction

//===========================================================================
function InitTrig_Light_Snow_Begin takes nothing returns nothing
    set gg_trg_Light_Snow_Begin=CreateTrigger()
    call TriggerAddAction(gg_trg_Light_Snow_Begin, function Trig_Light_Snow_Begin_Actions)
endfunction

//===========================================================================
// Trigger: Light Snow End
//===========================================================================
function Trig_Light_Snow_End_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_SnowLightActive == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_Snow_End_Actions takes nothing returns nothing
    call EnableWeatherEffect(udg_Weather_SnowLight, false)
    call RemoveWeatherEffectBJ(udg_Weather_SnowLight)
    set udg_Bool_SnowLightActive=false
    set udg_Bool_Snowing=false
    call TriggerExecute(gg_trg_SnowOut)
    call StartTimerBJ(udg_Timer_WeatherChangePause, false, GetRandomReal(udg_Real_WeatherChangeBot, udg_Real_WeatherChangeTop))
endfunction

//===========================================================================
function InitTrig_Light_Snow_End takes nothing returns nothing
    set gg_trg_Light_Snow_End=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Light_Snow_End, udg_Timer_WeatherSnowLightDur)
    call TriggerAddCondition(gg_trg_Light_Snow_End, Condition(function Trig_Light_Snow_End_Conditions))
    call TriggerAddAction(gg_trg_Light_Snow_End, function Trig_Light_Snow_End_Actions)
endfunction

