//===========================================================================
// Trigger: Runestone Discover
//===========================================================================
function Trig_Runestone_Discover_Func005Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runestone_Discover_Func005C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runestone_Discover_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call UnitAddAbilityBJ('ADRs', gg_unit_n60R_0003)
    // //
    if ( Trig_Runestone_Discover_Func005C() ) then
        call SetUnitAbilityLevelSwapped('ADRs', gg_unit_n60R_0003, 3)
    else
        if ( Trig_Runestone_Discover_Func005Func003C() ) then
            call SetUnitAbilityLevelSwapped('ADRs', gg_unit_n60R_0003, 2)
        else
            call SetUnitAbilityLevelSwapped('ADRs', gg_unit_n60R_0003, 1)
        endif
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P09_Start)
    call ConditionalTriggerExecute(gg_trg_AIP10_Start)
    // //
    call QueuedTriggerAddBJ(gg_trg_Runestone_Discover_Q, true)
endfunction

//===========================================================================
function InitTrig_Runestone_Discover takes nothing returns nothing
    set gg_trg_Runestone_Discover=CreateTrigger()
    call TriggerAddAction(gg_trg_Runestone_Discover, function Trig_Runestone_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Runestone Discover Q
//===========================================================================
function Trig_Runestone_Discover_Q_Actions takes nothing returns nothing
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_249")
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_RuneStoneCapture), 512.00)
    set udg_VisMod_CaptureRuneStone=GetLastCreatedFogModifier()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_RuneStoneCapture), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_QuestRunestone_RS=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_PathingBlockerCastle), bj_CAMPPINGSTYLE_PRIMARY)
    set udg_MinimapIcon_QuestRunestone_CS=GetLastCreatedMinimapIcon()
    // //
    call TriggerSleepAction(0.50)
    call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_RuneStoneFogGlow), 1, bj_MINIMAPPINGSTYLE_SIMPLE, 0.00, 100, 0.00)
    call TriggerSleepAction(0.50)
    // //
    call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_PathingBlockerCastle), 1, bj_MINIMAPPINGSTYLE_SIMPLE, 0.00, 100, 0.00)
    call TriggerSleepAction(0.50)
    // //
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_RuneStoneCapture))
    // //
    call TriggerSleepAction(( bj_QUEUE_DELAY_QUEST - 1.50 ))
    call EnableTrigger(gg_trg_Runestone_Ping)
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, Player(13), 'U60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc08Guldan12, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call EnableTrigger(gg_trg_Defeat)
    call QueuedTriggerAddBJ(gg_trg_Guldan_Hint_Q, true)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Runestone_Discover_Q takes nothing returns nothing
    set gg_trg_Runestone_Discover_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Runestone_Discover_Q, function Trig_Runestone_Discover_Q_Actions)
endfunction

