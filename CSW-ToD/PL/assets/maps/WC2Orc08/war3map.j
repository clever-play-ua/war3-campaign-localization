function Trig_Glittering_Prizes_Actions takes nothing returns nothing
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(Player(0), PLAYER_STATE_RESOURCE_GOLD) + 5000 ))
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, ( GetPlayerState(Player(0), PLAYER_STATE_RESOURCE_LUMBER) + 5000 ))
