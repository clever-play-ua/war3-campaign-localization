    if ( ( IsUnitType(GetAttacker(), UNIT_TYPE_ANCIENT) == true ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'h000' ) ) then
        return true
    endif
    return false
