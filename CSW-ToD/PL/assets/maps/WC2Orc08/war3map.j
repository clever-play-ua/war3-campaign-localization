//===========================================================================
function Trig_Turtles_Discover_Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() != MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Turtles_Discover_Func005002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Turtles_Discover_Func006002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Turtles_Discover_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    if ( Trig_Turtles_Discover_Func003C() ) then
        // Players feedback was that this is annoying so I decided to turn it off
    else
    endif
    // //
    call ForGroupBJ(udg_Group_HiddenTurtles, function Trig_Turtles_Discover_Func005002)
    call ForGroupBJ(udg_Group_HiddenTurtles, function Trig_Turtles_Discover_Func006002)
    // //
    call EnableTrigger(gg_trg_Turtles_Located01)
    call EnableTrigger(gg_trg_Turtles_Located02)
    call EnableTrigger(gg_trg_Turtles_Located03)
    call EnableTrigger(gg_trg_Turtles_Located04)
    call EnableTrigger(gg_trg_Turtles_Located05)
    call EnableTrigger(gg_trg_Turtles_Located06)
    // //
    call QueuedTriggerAddBJ(gg_trg_Turtles_Discover_Q, true)
    // //
endfunction

