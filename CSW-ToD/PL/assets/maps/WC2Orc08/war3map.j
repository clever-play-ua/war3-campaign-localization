//===========================================================================
// Trigger: Runestone Update Q
//===========================================================================
function Trig_Runestone_Update_Q_Func001Func001C takes nothing returns boolean
    if ( not ( udg_Bool_RunestoneSecured == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runestone_Update_Q_Func001C takes nothing returns boolean
    if ( not ( udg_Bool_CastleDestroyed == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runestone_Update_Q_Actions takes nothing returns nothing
    if ( Trig_Runestone_Update_Q_Func001C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_DestroyCastle, true)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_2989")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    else
        if ( Trig_Runestone_Update_Q_Func001Func001C() ) then
            call QuestItemSetCompletedBJ(udg_QReq_SecureRunestone, true)
            call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_2992")
            call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
            call SetSpeechVolumeGroupsBJ()
            call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, Player(13), 'o61D', GetCameraTargetPositionLoc(), gg_snd_WC2Orc10THgrunt3, bj_TIMETYPE_ADD, 0, true)
            call VolumeGroupResetBJ()
        else
        endif
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
endfunction

