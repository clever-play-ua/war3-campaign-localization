//===========================================================================
// Trigger: Utok WildhammersFound Secret
//===========================================================================
function Trig_Utok_WildhammersFound_Secret_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    return true
endfunction

function Trig_Utok_WildhammersFound_Secret_Func004002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Utok_WildhammersFound_Secret_Func005002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Utok_WildhammersFound_Secret_Func007002 takes nothing returns nothing
    call UnitShareVisionBJ(true, GetEnumUnit(), udg_Player_Actual)
endfunction

function Trig_Utok_WildhammersFound_Secret_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_SecretFound=true
    // //
    call ForGroupBJ(udg_Group_WildhammerDwarves, function Trig_Utok_WildhammersFound_Secret_Func004002)
    call ForGroupBJ(udg_Group_WildhammerDwarves, function Trig_Utok_WildhammersFound_Secret_Func005002)
    // //
    call ForGroupBJ(udg_Group_WildhammerDwarves, function Trig_Utok_WildhammersFound_Secret_Func007002)
    // //
    call SetUnitInvulnerable(gg_unit_nten_0369, false)
    call SetUnitInvulnerable(gg_unit_ntn2_0370, false)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_WildhammersDetected), 1.00)
    call TriggerSleepAction(1.00)
    call QueuedTriggerAddBJ(gg_trg_Utok_WildhammersFound_Secret_Q, true)
endfunction

//===========================================================================
function InitTrig_Utok_WildhammersFound_Secret takes nothing returns nothing
    set gg_trg_Utok_WildhammersFound_Secret=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Utok_WildhammersFound_Secret, gg_rct_WildhammersDetected)
    call TriggerAddCondition(gg_trg_Utok_WildhammersFound_Secret, Condition(function Trig_Utok_WildhammersFound_Secret_Conditions))
    call TriggerAddAction(gg_trg_Utok_WildhammersFound_Secret, function Trig_Utok_WildhammersFound_Secret_Actions)
endfunction

//===========================================================================
// Trigger: Utok WildhammersFound Secret Q
//
// What! we’re being attacked by the Green-skin savages! defend the camp laddies!
// Wildhammer Dwarves? What are they doing here?
//===========================================================================
function Trig_Utok_WildhammersFound_Secret_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_wAxT_0314, 'wAxT', gg_snd_WC2Orc08Wildhammer1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_Blackrock, 'o605', GetCameraTargetPositionLoc(), gg_snd_WC2Orc08Utok8, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_SECRET, "TRIGSTR_3003")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

