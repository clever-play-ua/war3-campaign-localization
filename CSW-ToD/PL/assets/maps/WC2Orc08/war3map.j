    if ( not ( udg_Bool_P10AttacksUser == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_P10TransportsAvailiable == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P10_Transports_Availiable_Checker_Func009Func002C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P10_Transports_Availiable_Checker_Func009C takes nothing returns boolean
    if ( not ( udg_Bool_P10AttacksUser == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_P10TransportsAvailiable == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P10_Transports_Availiable_Checker_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    if ( Trig_AI_P10_Transports_Availiable_Checker_Func004C() ) then
        set udg_Bool_P10TransportsAvailiable=false
        if ( Trig_AI_P10_Transports_Availiable_Checker_Func004Func003C() ) then
            call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3176")
        else
        endif
    else
        set udg_Bool_P10TransportsAvailiable=true
    endif
    // //
    // //
    if ( Trig_AI_P10_Transports_Availiable_Checker_Func007C() ) then
        call ConditionalTriggerExecute(gg_trg_AI_P10_Stop_Attack_Command)
        if ( Trig_AI_P10_Transports_Availiable_Checker_Func007Func002C() ) then
            call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3177")
        else
        endif
    else
    endif
    // //
    if ( Trig_AI_P10_Transports_Availiable_Checker_Func009C() ) then
        call ConditionalTriggerExecute(gg_trg_AI_P10_Start_Attack_Command)
        if ( Trig_AI_P10_Transports_Availiable_Checker_Func009Func002C() ) then
            call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3178")
        else
        endif
    else
    endif
    // //
endfunction

