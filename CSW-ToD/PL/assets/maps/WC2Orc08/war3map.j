    set gg_trg_Guldan_I_Chaos_Bolt_Effect=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Guldan_I_Chaos_Bolt_Effect, EVENT_PLAYER_UNIT_SPELL_EFFECT)
