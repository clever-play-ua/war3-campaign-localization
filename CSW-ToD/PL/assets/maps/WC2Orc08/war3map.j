// Trigger: DeindexPassengers
//===========================================================================
function Trig_DeindexPassengers_Func010C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hFAM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hEAM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hBAM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hKAM' ) ) then
        return true
    endif
    return false
endfunction

function Trig_DeindexPassengers_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_Lordaeron ) ) then
        return false
    endif
    if ( not Trig_DeindexPassengers_Func010C() ) then
        return false
    endif
    return true
endfunction

function Trig_DeindexPassengers_Actions takes nothing returns nothing
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_IdleMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarinesAdditional[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_UnitsInCargo)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P10ArchersMarine)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P10BallistasMarine)
endfunction

//===========================================================================
function InitTrig_DeindexPassengers takes nothing returns nothing
    set gg_trg_DeindexPassengers=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_DeindexPassengers, "udg_DeathEvent", EQUAL, 1.00)
    call TriggerRegisterVariableEvent(gg_trg_DeindexPassengers, "udg_UnitIndexEvent", EQUAL, 2.00)
    call TriggerAddCondition(gg_trg_DeindexPassengers, Condition(function Trig_DeindexPassengers_Conditions))
    call TriggerAddAction(gg_trg_DeindexPassengers, function Trig_DeindexPassengers_Actions)
endfunction

//===========================================================================
// Trigger: BoardingOrder
//===========================================================================
function Trig_BoardingOrder_Func003Func004C takes nothing returns boolean
    if ( not ( udg_BoardingOrderTimerCount[udg_TempInteger] >= udg_BoardingOrderTimerInterval ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Func003Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[udg_TempInteger]) <= 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Func003Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[udg_TempInteger]) <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_IdleMarines[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_IdleTransports[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Actions takes nothing returns nothing
    set udg_TempPlayer=udg_Player_Lordaeron
    set udg_TempInteger=GetConvertedPlayerId(udg_Player_Lordaeron)
    if ( Trig_BoardingOrder_Func003C() ) then
        set udg_BoardingOrderTimerCount[udg_TempInteger]=( udg_BoardingOrderTimerCount[udg_TempInteger] + udg_BoardingOrderTimerPeriod )
        if ( Trig_BoardingOrder_Func003Func004C() ) then
            set udg_BoardingOrderTimerCount[udg_TempInteger]=0.00
            call BoardingFunc(udg_TempInteger)
        else
        endif
        if ( Trig_BoardingOrder_Func003Func005C() ) then
            call GroupClear(udg_QueuedMarines[udg_TempInteger])
        else
        endif
        if ( Trig_BoardingOrder_Func003Func006C() ) then
            call GroupClear(udg_QueuedTransports[udg_TempInteger])
        else
        endif
    else
        set udg_BoardingOrderTimerCount[udg_TempInteger]=0.00
    endif
endfunction

//===========================================================================
function InitTrig_BoardingOrder takes nothing returns nothing
    set gg_trg_BoardingOrder=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_BoardingOrder, udg_BoardingOrderTimer)
    call TriggerAddAction(gg_trg_BoardingOrder, function Trig_BoardingOrder_Actions)
endfunction

//===========================================================================
// Trigger: DetectSeaLoading
//===========================================================================
function Trig_DetectSeaLoading_Conditions takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[GetUnitUserData(udg_CargoTransportUnit[udg_UDex])] == 'h60P' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_Lordaeron ) ) then
        return false
    endif
    return true
endfunction

function Trig_DetectSeaLoading_Actions takes nothing returns nothing
    local integer i= 0
    local integer size= 0
    local unit FoG
    local integer fb= s__ForceBoarding_struct[GetUnitUserData(udg_UDexUnits[udg_UDex])]
    local integer isc= s__IndexShipCargo_struct[GetUnitUserData(udg_CargoTransportUnit[udg_UDex])]
    // //
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_IdleMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupAddUnitSimple(udg_UDexUnits[udg_UDex], udg_UnitsInCargo)
    // //
    set s__IndexShipCargo_xC[isc]=GetUnitX(udg_CargoTransportUnit[udg_UDex])
    set s__IndexShipCargo_yC[isc]=GetUnitY(udg_CargoTransportUnit[udg_UDex])
    // Commented out code might be needed if some units will have heal autocast
    // //
    // Safeguard against the units that are stuck in heal autocast
    // Add unit types in conditions for config
    // Temporary Off
    // //
    set s__ForceBoarding_isLoaded[fb]=true
    set FoG=null
endfunction

//===========================================================================
function InitTrig_DetectSeaLoading takes nothing returns nothing
    set gg_trg_DetectSeaLoading=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_DetectSeaLoading, "udg_CargoEvent", EQUAL, 1.00)
    call TriggerAddCondition(gg_trg_DetectSeaLoading, Condition(function Trig_DetectSeaLoading_Conditions))
    call TriggerAddAction(gg_trg_DetectSeaLoading, function Trig_DetectSeaLoading_Actions)
endfunction

//===========================================================================
// Trigger: DetectSeaUnloading
//===========================================================================
function Trig_DetectSeaUnloading_Conditions takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[GetUnitUserData(udg_CargoTransportUnit[udg_UDex])] == 'h60P' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_Lordaeron ) ) then
        return false
    endif
    return true
endfunction

function Trig_DetectSeaUnloading_Actions takes nothing returns nothing
    call DeindexCargoFunc(udg_CargoTransportUnit[udg_UDex] , udg_UDexUnits[udg_UDex])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_UnitsInCargo)
endfunction

//===========================================================================
function InitTrig_DetectSeaUnloading takes nothing returns nothing
    set gg_trg_DetectSeaUnloading=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_DetectSeaUnloading, "udg_CargoEvent", EQUAL, 2.00)
    call TriggerAddCondition(gg_trg_DetectSeaUnloading, Condition(function Trig_DetectSeaUnloading_Conditions))
    call TriggerAddAction(gg_trg_DetectSeaUnloading, function Trig_DetectSeaUnloading_Actions)
endfunction

//===========================================================================
// Trigger: PlayerMarineLandingOrder
//===========================================================================
function Trig_PlayerMarineLandingOrder_Conditions takes nothing returns boolean
    if ( not ( udg_LandingWarfareHasRan[GetConvertedPlayerId(udg_Player_Lordaeron)] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_PlayerMarineLandingOrder_Func003Func002A takes nothing returns nothing
    local integer isc
    set isc=s__IndexShipCargo_struct[GetUnitUserData(GetEnumUnit())]
    if IsUnitInRangeXY(GetEnumUnit(), s__IndexShipCargo_xC[isc], s__IndexShipCargo_yC[isc], udg_DepartureDetectionRange) then
    call IssuePointOrderById(GetEnumUnit(), 851986, udg_AttackOrderPointerX[udg_TempInteger], udg_AttackOrderPointerY[udg_TempInteger])
    else
    call IssuePointOrderLocBJ(GetEnumUnit(), "unloadall", udg_TempPointM)
    endif
endfunction

function Trig_PlayerMarineLandingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_DepartedTransports[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PlayerMarineLandingOrder_Actions takes nothing returns nothing
    set udg_TempInteger=GetConvertedPlayerId(udg_Player_Lordaeron)
    set udg_LandingWarfareHasRan[udg_TempInteger]=true
    if ( Trig_PlayerMarineLandingOrder_Func003C() ) then
        set udg_TempPointM=Location(udg_AttackOrderPointerX[udg_TempInteger], udg_AttackOrderPointerY[udg_TempInteger])
        call ForGroupBJ(udg_DepartedTransports[udg_TempInteger], function Trig_PlayerMarineLandingOrder_Func003Func002A)
        call RemoveLocation(udg_TempPointM)
    else
    endif
    set udg_LandingWarfareHasRan[udg_TempInteger]=false
endfunction

//===========================================================================
function InitTrig_PlayerMarineLandingOrder takes nothing returns nothing
    set gg_trg_PlayerMarineLandingOrder=CreateTrigger()
    call TriggerAddCondition(gg_trg_PlayerMarineLandingOrder, Condition(function Trig_PlayerMarineLandingOrder_Conditions))
    call TriggerAddAction(gg_trg_PlayerMarineLandingOrder, function Trig_PlayerMarineLandingOrder_Actions)
endfunction

//===========================================================================
// Trigger: P10 Special Marine Unit Indexer
//===========================================================================
function Trig_P10_Special_Marine_Unit_Indexer_Func004C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hEAM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hBAM' ) ) then
        return true
    endif
    return false
endfunction

function Trig_P10_Special_Marine_Unit_Indexer_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_Lordaeron ) ) then
        return false
    endif
    if ( not Trig_P10_Special_Marine_Unit_Indexer_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_P10_Special_Marine_Unit_Indexer_Func001C takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[udg_UDex] == 'hEAM' ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10_Special_Marine_Unit_Indexer_Func002C takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[udg_UDex] == 'hBAM' ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10_Special_Marine_Unit_Indexer_Actions takes nothing returns nothing
    if ( Trig_P10_Special_Marine_Unit_Indexer_Func001C() ) then
        call GroupAddUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P10ArchersMarine)
    else
    endif
    if ( Trig_P10_Special_Marine_Unit_Indexer_Func002C() ) then
        call GroupAddUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P10BallistasMarine)
    else
    endif
endfunction

//===========================================================================
function InitTrig_P10_Special_Marine_Unit_Indexer takes nothing returns nothing
    set gg_trg_P10_Special_Marine_Unit_Indexer=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_P10_Special_Marine_Unit_Indexer, "udg_UnitIndexEvent", EQUAL, 1.00)
    call TriggerAddCondition(gg_trg_P10_Special_Marine_Unit_Indexer, Condition(function Trig_P10_Special_Marine_Unit_Indexer_Conditions))
