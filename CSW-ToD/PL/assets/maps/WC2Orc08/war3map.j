//===========================================================================
// Trigger: AI P09 Start
//===========================================================================
function Trig_AI_P09_Start_Func005Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P09_Start_Func005C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P09_Start_Func013002 takes nothing returns nothing
    call IssueTargetOrderBJ(GetEnumUnit(), "smart", gg_unit_u600_0171)
endfunction

function Trig_AI_P09_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerStateBJ(udg_Player_LordaeronNavy, PLAYER_STATE_RESOURCE_GOLD, 3000)
    call SetPlayerStateBJ(udg_Player_LordaeronNavy, PLAYER_STATE_RESOURCE_LUMBER, 3000)
    if ( Trig_AI_P09_Start_Func005C() ) then
        call playerAddOil(Player(8) , 200000)
    else
        if ( Trig_AI_P09_Start_Func005Func003C() ) then
            call playerAddOil(Player(8) , 150000)
        else
            call playerAddOil(Player(8) , 100000)
        endif
    endif
    call SetPlayerStateBJ(udg_Player_LordaeronNavy, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerStateBJ(udg_Player_LordaeronNavy, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    // //
    call EnableTrigger(gg_trg_AI_P09_Gold)
    call EnableTrigger(gg_trg_AI_P09_Lumber)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_LordaeronNavy, 'h600'), function Trig_AI_P09_Start_Func013002)
    // //
    call StartCampaignAI(udg_Player_LordaeronNavy, "CSW\\Scripts\\ToDScripts\\WC2Orc08\\WC2Orc08P09AllianceNavalAI.ai")
    // //
    call StartTimerBJ(udg_Timer_P08OilChecker, true, 1.00)
endfunction

//===========================================================================
