function InitTrig_Runestone_Update_Q takes nothing returns nothing
    set gg_trg_Runestone_Update_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Runestone_Update_Q, function Trig_Runestone_Update_Q_Actions)
endfunction

