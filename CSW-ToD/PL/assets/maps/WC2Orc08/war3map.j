function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Set_Up)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01, udg_Player_Actual, 0)
    call TriggerSleepAction(0.50)
    // //
    // Cinematic Starts
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro02B, udg_Player_Actual, 11.00, 0.00, 6.00, 100.00)
    // //
    call PlaySoundBJ(gg_snd_DarkAgents)
    call TriggerSleepAction(1.00)
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_UtokIntro01))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, udg_SemiHero_Utok)
    call IssueTargetOrderBJ(gg_unit_h625_0026, "attack", udg_Unit_DummyArcherTargetArr[1])
    // //
    // //
    set udg_Bool_CinIntroOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call TriggerSleepAction(13.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Todo - Improve condition
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeUtok), GetRectCenter(gg_rct_UtokIntro03)) / GetUnitMoveSpeed(udg_FakeUtok) ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Guldan Experiments
    // //
    call SetUnitFacingTimed(udg_FakeGuldan, 306.42, 1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_NecroExperiment03C, udg_Player_Actual, 0.00)
    call CameraSetFocalDistance(180.00)
    call CameraSetDepthOfFieldScale(60.00)
    // //
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_GuldanAnim)
    call SetUnitAnimation(udg_FakeGuldan, "Spell")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "Cinematic Listening One")
    // //
    call SetUnitAnimation(udg_Unit_Villager, "morph")
    set udg_SE_VillagerEffect=GetLastCreatedEffectBJ()
    // //
    call TriggerSleepAction(2.40)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitTimeScalePercent(udg_FakeGuldan, 100.00)
    call DestroyEffectBJ(udg_SE_VillagerEffect)
    call DestroyLightningBJ(udg_SE_GuldanLightning)
    // //
    call KillUnit(udg_Unit_Villager)
    // //
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingTimed(udg_FakeGuldan, 237.88, 0.75)
    call SetUnitFacingTimed(udg_FakeUtok, 325.04, 0.00)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_NecroExperiment05, udg_Player_Actual, 4.00, 0, 1.00, 100.00)
    // //
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    call TriggerSleepAction(0.75)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Frustrated One")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "Cinematic Listening One")
    // Arrgh...another failed experiment!
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan1, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(3.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_NecroExperimentClose, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc08Guldan1) + ( GetSoundDurationBJ(gg_snd_WC2Orc08Guldan2) + ( GetSoundDurationBJ(gg_snd_WC2Orc08Guldan3) + ( GetSoundDurationBJ(gg_snd_WC2Orc08Guldan4) + ( GetSoundDurationBJ(gg_snd_WC2Orc08Guldan5) + ( GetSoundDurationBJ(gg_snd_WC2Orc08Utok1) + ( GetSoundDurationBJ(gg_snd_WC2Orc08Utok2) + 0.00 ) ) ) ) ) ) ), 0, 1.00, 100.00)
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc08Guldan1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingTimed(udg_FakeGuldan, 188.75, 0.50)
    call SetUnitLookAt(udg_FakeGuldan, "bone_head", udg_FakeUtok, 0, 0, 90)
    // //
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Angry One")
    call QueueUnitAnimationBJ(udg_FakeUtok, "Cinematic Listening One")
    // How many prisoners must you waste on these despicable tests, Warlock?
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc08Utok1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Shrug One")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "Cinematic Listening One")
    // Aaaaah, the Warchief’s little pet, are you too soft to appreciate my craftsmanship? Do these sights make your stomach turn?
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Wave One")
    call QueueUnitAnimationBJ(udg_FakeUtok, "Cinematic Listening One")
    // Surely the Warchief does not tolerate these vile acts! I will be repo...
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc08Utok2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Wave One")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "Cinematic Listening One")
    // The Warchief himself set me to purpose, and all that I do here is done in his name and with his blessing...
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Were you not his plaything, I would have repurposed that witless soul of yours long ago...
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Standard One")
    // Now, return to your ‘scratching' and leave me to my work, I am expecting someone!
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc08Guldan5, bj_TIMETYPE_ADD, 0, true)
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Listening One")
    // //
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Angry One")
    call QueueUnitAnimationBJ(udg_FakeUtok, "Cinematic Listening One")
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_UtokStart))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley101, 100, udg_SemiHero_Utok)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ShowUnitHide(udg_SemiHero_Utok)
    // //
    // ChogalArrives
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ResetUnitLookAt(udg_FakeGuldan)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Mountains, udg_Player_Actual, 0.00)
    call CameraSetFocalDistance(200.00)
    call CameraSetDepthOfFieldScale(60.00)
    // //
    call ConditionalTriggerExecute(gg_trg_SetCinematicMountainsFog)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'nsea', udg_Player_Actual, GetRectCenter(gg_rct_IntroSeal01), GetRectCenter(gg_rct_IntroSeal02))
    set udg_Unit_Seal=GetLastCreatedUnit()
    call UnitRemoveAbilityBJ('Awan', udg_Unit_Seal)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call IssuePointOrderLocBJ(gg_unit_o60S_0035, "move", GetRectCenter(gg_rct_Juggernaurt_Intro01))
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60S_0035, GetRectCenter(gg_rct_Juggernaurt_Intro03), GetRectCenter(gg_rct_Juggernaurt_Intro01))
    call SetUnitMoveSpeed(gg_unit_o60S_0035, GetUnitDefaultMoveSpeed(gg_unit_o60S_0035))
    call IssuePointOrderLocBJ(gg_unit_o60S_0035, "move", GetRectCenter(gg_rct_Juggernaurt_Intro01))
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Juggernaurt_B, udg_Player_Actual, 0.00)
    call CameraSetFocalDistance(180.00)
    call CameraSetDepthOfFieldScale(55.00)
    // //
    call TriggerSleepAction(0.20)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.80, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // ToDO - either removel leaks or change the wait condition
    // //
    call TriggerSleepAction(( ( DistanceBetweenPoints(GetUnitLoc(gg_unit_o60S_0035), GetRectCenter(gg_rct_Juggernaurt_Intro01)) / GetUnitMoveSpeed(gg_unit_o60S_0035) ) - 2.00 ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_Unit_Seal, "move", GetRectCenter(gg_rct_IntroSeal02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundBJ(gg_snd_Dock01)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ExplodeUnitBJ(udg_Unit_Seal)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueImmediateOrderBJ(gg_unit_o60S_0035, "stop")
    call ConditionalTriggerExecute(gg_trg_SetCinematicCloseFog)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_GuldanIntro04, Player(0), 7.00, 4.00, 1.00, 100.00)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeChogal, GetRectCenter(gg_rct_ChogalUnloads), GetRectCenter(gg_rct_ChogallIntro01))
    call ShowUnitShow(udg_FakeChogal)
    call PlaySoundOnUnitBJ(gg_snd_Loading, 100, udg_FakeChogal)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeChogal, "move", GetRectCenter(gg_rct_ChogallIntro01))
    call PlaySoundOnUnitBJ(gg_snd_CS_H01a_Arthas_walk_a, 100, udg_Hero_Chogall)
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // //
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_GuldanIntro03))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, udg_Hero_Guldan)
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_GuldanTurn)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_ChogallTurn)
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_ChogallIntro01, udg_FakeChogal) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Chogall and GulDan Talking
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Dialoque)
    // //
    call TriggerSleepAction(11.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GuldanSpeaks, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_GuldanSpeaks02, udg_Player_Actual, 25.00)
    // //
    call TriggerSleepAction(10.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(14.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // RuneStone
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IslandView, udg_Player_Actual, 0)
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call ResetUnitLookAt(udg_FakeGuldan)
    call SetUnitPositionLocFacingBJ(udg_FakeGuldan, GetRectCenter(gg_rct_GulDanIntro01), 315.00)
    call SetUnitPositionLocFacingBJ(udg_FakeChogal, GetRectCenter(gg_rct_ChoGallIntro), 325.00)
    // //
    call SetUnitAnimationWithRarity(udg_FakeChogal, "stand", RARITY_FREQUENT)
    // //
    call ConditionalTriggerExecute(gg_trg_SetCinematicDefaultFog)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_RuneStone01, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(gg_unit_n60R_0003, "stand work")
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_RuneStone02, udg_Player_Actual, 11.00, 0, 1.00, 100.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call AddSpecialEffectTargetUnitBJ("hand, right", gg_unit_hmpr_0018, "Abilities\\Spells\\Human\\SpellSteal\\SpellStealTarget.mdl")
    set udg_SE_IntroPriestCastArr[1]=GetLastCreatedEffectBJ()
    call SetUnitAnimation(gg_unit_hmpr_0018, "attack spell")
    call QueueUnitAnimationBJ(gg_unit_hmpr_0018, "stand")
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call DestroyEffectBJ(udg_SE_IntroPriestCastArr[1])
    // //
    call AddSpecialEffectTargetUnitBJ("hand, right", gg_unit_hmpr_0029, "Abilities\\Spells\\Human\\SpellSteal\\SpellStealTarget.mdl")
    set udg_SE_IntroPriestCastArr[2]=GetLastCreatedEffectBJ()
    call SetUnitAnimation(gg_unit_hmpr_0029, "attack spell")
    call QueueUnitAnimationBJ(gg_unit_hmpr_0029, "stand")
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call DestroyEffectBJ(udg_SE_IntroPriestCastArr[2])
    // //
    call AddSpecialEffectTargetUnitBJ("hand, right", gg_unit_hmpr_0317, "Abilities\\Spells\\Human\\SpellSteal\\SpellStealTarget.mdl")
    set udg_SE_IntroPriestCastArr[3]=GetLastCreatedEffectBJ()
    call SetUnitAnimation(gg_unit_hmpr_0317, "attack spell")
    call QueueUnitAnimationBJ(gg_unit_hmpr_0317, "stand")
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call DestroyEffectBJ(udg_SE_IntroPriestCastArr[3])
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GuldanIntro06, udg_Player_Actual, 0.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // Cliff
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_GuldanIntro07, udg_Player_Actual, 10.00, 0.00, 1.00, 100.00)
    call TriggerSleepAction(34.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Cinematic Ends
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

