//===========================================================================
// Trigger: Final Cinematic AltarTransformation
//===========================================================================
function Trig_Final_Cinematic_AltarTransformation_Conditions takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_AltarOgreIN) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_AltarTransformation_Func002A takes nothing returns nothing
    set udg_Unit_AltarTransformationOgre=GetEnumUnit()
    call IssuePointOrderLocBJ(udg_Unit_AltarTransformationOgre, "move", GetRectCenter(gg_rct_OgreAltarEntrance))
    call GroupRemoveUnitSimple(udg_Unit_AltarTransformationOgre, udg_Group_AltarOgreIN)
endfunction

function Trig_Final_Cinematic_AltarTransformation_Func004001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_OgreAltarEntrance, udg_Unit_AltarTransformationOgre) == true )
endfunction

function Trig_Final_Cinematic_AltarTransformation_Func007001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_OgreAltarTransform, udg_Unit_AltarTransformationOgre) == true )
endfunction

function Trig_Final_Cinematic_AltarTransformation_Func026Func002Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_AltarTransformation_Func026Func002C takes nothing returns boolean
    if ( not ( GetRandomPercentageBJ() >= 75.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_AltarTransformation_Func026C takes nothing returns boolean
    if ( not ( udg_Bool_OgresMumblingOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_AltarTransformation_Func032001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_OgreAltarEntrance, udg_Unit_AltarTransformationOgreB) == true )
endfunction

function Trig_Final_Cinematic_AltarTransformation_Actions takes nothing returns nothing
    call ForGroupBJ(GetRandomSubGroup(1, udg_Group_AltarOgreIN), function Trig_Final_Cinematic_AltarTransformation_Func002A)
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_OgreAltarEntrance, udg_Unit_AltarTransformationOgre) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
    endloop
    call IssuePointOrderLocBJ(udg_Unit_AltarTransformationOgre, "move", GetRectCenter(gg_rct_OgreAltarTransform))
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_OgreAltarTransform, udg_Unit_AltarTransformationOgre) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
    endloop
    call BlzSpecialEffectAddSubAnimation(udg_SE_CinematicAltar, SUBANIM_TYPE_WORK)
    call BlzPlaySpecialEffect(udg_SE_CinematicAltar, ANIM_TYPE_STAND)
    call PlaySoundAtPointBJ(gg_snd_AltarOfStormsWhat1, 100, GetRectCenter(gg_rct_OgreAltarTransform), 150.00)
    // //
    call TriggerSleepAction(0.50)
    // //
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Unit_AltarTransformationOgre), "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_OgreTransformation=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    // //
    call ReplaceUnitBJ(udg_Unit_AltarTransformationOgre, 'n002', bj_UNIT_STATE_METHOD_RELATIVE)
    set udg_Unit_AltarTransformationOgreB=GetLastReplacedUnitBJ()
    set udg_Unit_AltarTransformationOgre=null
    // //
    call GroupAddUnitSimple(udg_Unit_AltarTransformationOgreB, udg_Group_AltarOgreOut)
    // //
    call SetUnitPathing(udg_Unit_AltarTransformationOgreB, false)
    // //
    if ( Trig_Final_Cinematic_AltarTransformation_Func026C() ) then
        if ( Trig_Final_Cinematic_AltarTransformation_Func026Func002C() ) then
            if ( Trig_Final_Cinematic_AltarTransformation_Func026Func002Func001C() ) then
                call PlaySoundAtPointBJ(gg_snd_TaurenPissed1, 100, GetRectCenter(gg_rct_OgreAltarTransform), 100.00)
            else
                call PlaySoundAtPointBJ(gg_snd_TaurenPissed2, 100, GetRectCenter(gg_rct_OgreAltarTransform), 100.00)
            endif
        else
        endif
    else
    endif
    // //
    call TriggerSleepAction(1.00)
    call IssuePointOrderLocBJ(udg_Unit_AltarTransformationOgreB, "move", GetRectCenter(gg_rct_OgreAltarEntrance))
    call DestroyEffectBJ(udg_SE_OgreTransformation)
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_OgreAltarEntrance, udg_Unit_AltarTransformationOgreB) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
    endloop
    call IssuePointOrderLocBJ(udg_Unit_AltarTransformationOgreB, "move", GetRandomLocInRect(gg_rct_Bunch_Of_Ogres_Mages))
    // //
    call TriggerSleepAction(2.00)
    // //
    call BlzSpecialEffectClearSubAnimations(udg_SE_CinematicAltar)
    call BlzPlaySpecialEffect(udg_SE_CinematicAltar, ANIM_TYPE_STAND)
    // //
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

