//===========================================================================
// Trigger: AI P09 Oil
//
// If the enemy player doesnt have oil rigs and its oil reserves less than 700, no sense in continue attacking.
// P 09 Ship construction will be restricted by amount of oil to  prevent difficulty snowballing on later phase of the game
//===========================================================================
function Trig_AI_P09_Oil_Func007A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P09OilRigs)
endfunction

function Trig_AI_P09_Oil_Func018C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P09_Oil_Actions takes nothing returns nothing
    local integer p09OilRigs
    // //
    call GroupClear(udg_Group_P09OilRigs)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_LordaeronNavy, 'u600'), function Trig_AI_P09_Oil_Func007A)
    // //
    set p09OilRigs=CountUnitsInGroup(udg_Group_P09OilRigs)
    // //
    if (OilHarvest__playerOil[GetPlayerId((Player(8)))]) < 700 and p09OilRigs == 0 then // INLINED!!
    call PauseTimerBJ(true, udg_Timer_P08OilChecker)
    call ConditionalTriggerExecute(gg_trg_AI_P09_Stop_Attack_Command)
    call DisableTrigger(gg_trg_OilSpentForHumanTransport)
    call DisableTrigger(gg_trg_OilSpentForElvenDestroyer)
    call DisableTrigger(gg_trg_OilSpentForBattleship)
    call DisableTrigger(gg_trg_OilSpentForSubmarine)
    if ( Trig_AI_P09_Oil_Func018C() ) then
        call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3183")
    else
    endif
    endif
    // //
    call GroupClear(udg_Group_P09OilRigs)
endfunction

