function Trig_LevelCapPlayer01_Func002C takes nothing returns boolean
    if ( not ( GetLevelingUnit() == udg_Hero_Guldan ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero_Guldan) == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LevelCapPlayer01_Func003C takes nothing returns boolean
    if ( not ( GetLevelingUnit() == udg_Hero_Chogall ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero_Chogall) == 7 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LevelCapPlayer01_Actions takes nothing returns nothing
    if ( Trig_LevelCapPlayer01_Func002C() ) then
        call SuspendHeroXPBJ(false, udg_Hero_Guldan)
    else
    endif
    if ( Trig_LevelCapPlayer01_Func003C() ) then
        call SuspendHeroXPBJ(false, udg_Hero_Chogall)
    else
    endif
endfunction

