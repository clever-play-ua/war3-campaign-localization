    if ( not ( GetDyingUnit() == gg_unit_h61A_0004 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runestone_Update_Castle_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CastleDestroyed=true
    call DestroyMinimapIcon(udg_MinimapIcon_QuestRunestone_CS)
    call ConditionalTriggerExecute(gg_trg_Runestone_Update_Completed)
endfunction

