//===========================================================================
// Trigger: Init 04 Environment
//===========================================================================
function Trig_Init_04_Environment_Actions takes nothing returns nothing
    call SetTimeOfDay(12)
    call SetSkyModel("Environment\\Sky\\LordaeronWinterSky\\LordaeronWinterSky.mdl")
    // //
    call KillDestructable(gg_dest_B000_6606)
    // //
    call SetDestructableOccluderHeight(gg_dest_B60L_4215, 300.00)
    call SetDestructableOccluderHeight(gg_dest_B60L_4214, 300.00)
    call SetDestructableOccluderHeight(gg_dest_B60L_4213, 300.00)
    // //
    call ConditionalTriggerExecute(gg_trg_SetCinematicDefaultFog)
    call SetDayNightModels("csw\\environment\\dnc\\LordaeronWinter\\dnclordaeronwinterterrain.mdx", "csw\\environment\\dnc\\LordaeronWinter\\dnclordaeronwinterunit.mdx")
    // //
    call AddWeatherEffectSaveLast(gg_rct_RuneStoneFogGlow, 'FDbh')
    set udg_Weather_RuneStoneFog=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_RuneStoneFog, true)
    call SetUnitAnimation(gg_unit_n60R_0003, "stand work")
    // //
    set udg_Point_RunestonePing[1]=GetRectCenter(gg_rct_PathingBlockerCastle)
    // //
    set udg_Point_RunestonePing[2]=GetRectCenter(gg_rct_RuneStoneCapture)
    // //
    set udg_Point_WaterfallVisibility=GetRectCenter(gg_rct_WaterFallVisibilityCircle)
    // //
    call SetItemVisibleBJ(false, gg_item_IQL0_0292)
    call SetItemVisibleBJ(false, gg_item_IQL1_0293)
    // //
    set udg_Point_SpawnFakeChogall=GetRectCenter(gg_rct_SpawnFakeChogall)
    set udg_Point_SpawnFakeGuldan=GetRectCenter(gg_rct_SpawnFakeGuldan)
    set udg_Point_SpawnFakeOrgrim=GetRectCenter(gg_rct_SpawnFakeOrgrim)
    set udg_Point_SpawnFakeUtok=GetRectCenter(gg_rct_SpawnFakeUtok)
    // //
    set udg_Real_WeatherChangeBot=60.00
    set udg_Real_WeatherChangeTop=180.00
    // //
    set udg_Real_WeatherSnowLightDurBot=60.00
    set udg_Real_WeatherSnowLightDurTop=120.00
    // //
    set udg_Real_WeatherSnowHeavyDurBot=240.00
    set udg_Real_WeatherSnowHeavyDurTop=360.00
    // //
endfunction

