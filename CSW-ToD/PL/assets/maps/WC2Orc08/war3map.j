//===========================================================================
// Trigger: AI P10 Defeated
//===========================================================================
function Trig_AI_P10_Defeated_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Lordaeron ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P10_Defeated_Func009001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h616' )
endfunction

function Trig_AI_P10_Defeated_Func009001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P10_Defeated_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h616'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P10_Defeated_Func009002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P10AIDefeatCondition)
endfunction

function Trig_AI_P10_Defeated_Func012001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_AI_P10_Defeated_Func012001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P10_Defeated_Func012001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P10_Defeated_Func012002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P10AIDefeatCondition)
endfunction

function Trig_AI_P10_Defeated_Func014C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P10AIDefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P10_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_P10AIDefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P10_Defeated_Func009001002)), function Trig_AI_P10_Defeated_Func009002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P10_Defeated_Func012001002)), function Trig_AI_P10_Defeated_Func012002)
    // //
    if ( Trig_AI_P10_Defeated_Func014C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_AIP10_Gold)
        call DisableTrigger(gg_trg_AIP10_Lumber)
        call DisableTrigger(gg_trg_AI_P10_Transports_Availiable_Checker)
        call ConditionalTriggerExecute(gg_trg_AI_P10_Stop_Attack_Command)
        call ConditionalTriggerExecute(gg_trg_AI_P10_Defeat_Command)
    else
    endif
    // //
    call GroupClear(udg_Group_P10AIDefeatCondition)
    // //
endfunction

//===========================================================================
function InitTrig_AI_P10_Defeated takes nothing returns nothing
    set gg_trg_AI_P10_Defeated=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AI_P10_Defeated, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AI_P10_Defeated, Condition(function Trig_AI_P10_Defeated_Conditions))
    call TriggerAddAction(gg_trg_AI_P10_Defeated, function Trig_AI_P10_Defeated_Actions)
endfunction

