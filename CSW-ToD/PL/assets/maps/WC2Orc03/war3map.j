//===========================================================================
function Trig_Init_02_Units_Func005A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Init_02_Units_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Load_Heroes)
    set udg_Int_BattleshipsRemaining=3
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(23)), function Trig_Init_02_Units_Func005A)
    // //
    call RemoveGuardPosition(gg_unit_o60O_0034)
    call RemoveGuardPosition(gg_unit_o60O_0033)
    call SetUnitAnimation(gg_unit_o60O_0046, "cinematic trapped")
    call SetUnitAnimation(gg_unit_o60O_0047, "cinematic trapped")
    call SetUnitInvulnerable(gg_unit_o60O_0046, true)
    call SetUnitInvulnerable(gg_unit_o60O_0047, true)
    call AddUnitAnimationPropertiesBJ(true, "alternate", gg_unit_nvil_0000)
    call ShowUnitHide(gg_unit_h615_0027)
    // Armada First Destroyer
    set udg_Armada_DestroyerCreatePoint[1]=GetRectCenter(gg_rct_Armada_Destroyer1_Create)
    set udg_Armada_DestroyerCreatePoint[2]=GetRectCenter(gg_rct_Armada_Destroyer2_Create)
    set udg_Armada_DestroyerCreatePoint[3]=GetRectCenter(gg_rct_Armada_Destroyer3_Create)
    set udg_Armada_DestroyerCreatePoint[4]=GetRectCenter(gg_rct_Armada_Destroyer4_Create)
    set udg_Armada_DestroyerTargetPoint[1]=GetRectCenter(gg_rct_Armada_Destroyer1_Target)
    set udg_Armada_DestroyerTargetPoint[2]=GetRectCenter(gg_rct_Armada_Destroyer2_Target)
    set udg_Armada_DestroyerTargetPoint[3]=GetRectCenter(gg_rct_Armada_Destroyer3_Target)
    set udg_Armada_DestroyerTargetPoint[4]=GetRectCenter(gg_rct_Armada_Destroyer4_Target)
endfunction

