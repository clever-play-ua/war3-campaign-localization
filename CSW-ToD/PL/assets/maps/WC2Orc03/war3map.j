function Trig_Final_Cinematic_Q_Func018A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_CinNeutrals)
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_Q_Func021001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == Player(1) )
endfunction

function Trig_Final_Cinematic_Q_Func021001002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'e60C' )
endfunction

function Trig_Final_Cinematic_Q_Func021001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == Player(1)), (GetUnitTypeId(GetFilterUnit()) == 'e60C')) // INLINED!!
endfunction

function Trig_Final_Cinematic_Q_Func021002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_Q_Func024001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false )
endfunction

function Trig_Final_Cinematic_Q_Func024001002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) != 'o605' )
endfunction

function Trig_Final_Cinematic_Q_Func024001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false), (GetUnitTypeId(GetFilterUnit()) != 'o605')) // INLINED!!
endfunction

function Trig_Final_Cinematic_Q_Func024002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_Q_Func027002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_Q_Func029002 takes nothing returns nothing
    call ShowDestructableBJ(true, GetEnumDestructable())
endfunction

function Trig_Final_Cinematic_Q_Func030002 takes nothing returns nothing
    call ShowDestructableBJ(true, GetEnumDestructable())
endfunction

