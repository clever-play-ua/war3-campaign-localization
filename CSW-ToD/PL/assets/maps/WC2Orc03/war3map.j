//===========================================================================
function Trig_UtokLevelUpChecker_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_OQ_Alliance) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_OQ_OilWars) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_OQ_Southshore) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokLevelUpChecker_Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokLevelUpChecker_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_UtokLevelUpChecker_Func002C() ) then
        call AddSpecialEffectTargetUnitBJ("origin", udg_SemiHero_Utok, "Abilities\\Spells\\Other\\Levelup\\Levelupcaster.mdx")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    call SetPlayerTechResearchedSwap('RUX2', ( GetPlayerTechCountSimple('RUX2', Player(0)) + 1 ), Player(0))
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

