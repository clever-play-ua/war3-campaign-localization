function Trig_Alliance_Discover_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetAttacker()) == udg_Player_Alliance ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttacker()) != 'hFrK' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Alliance_Discover_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_Alliance_Discover_Q, true)
endfunction

