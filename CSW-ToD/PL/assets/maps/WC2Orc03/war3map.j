//===========================================================================
// Trigger: Armada BuildOilRigs
//===========================================================================
function Trig_Armada_BuildOilRigs_Func003C takes nothing returns boolean
    if ( not ( udg_Int_MQArmada_PlatformsBuild <= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_BuildOilRigs_Func005Func001Func001C takes nothing returns boolean
    if ( not ( udg_Int_MQArmada_PlatformsBuild == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_BuildOilRigs_Func005Func001C takes nothing returns boolean
    if ( not ( udg_PlayerOil >= udg_Int_QuestOilTargetAmount ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_BuildOilRigs_Func005C takes nothing returns boolean
    if ( not ( udg_Int_MQArmada_PlatformsBuild >= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_BuildOilRigs_Actions takes nothing returns nothing
    set udg_Int_MQArmada_PlatformsBuild=( udg_Int_MQArmada_PlatformsBuild + 1 )
    // Update LeaderBoard
    if ( Trig_Armada_BuildOilRigs_Func003C() ) then
        call LeaderboardSetPlayerItemValueBJ(Player(1), udg_Leaderboard_QuestObjectives, udg_Int_MQArmada_PlatformsBuild)
    else
    endif
    // Update Quests
    if ( Trig_Armada_BuildOilRigs_Func005C() ) then
        if ( Trig_Armada_BuildOilRigs_Func005Func001C() ) then
            call DisableTrigger(gg_trg_AllUnitsDead_Defeat)
            call QueuedTriggerAddBJ(gg_trg_Armada_Completed_Q, true)
        else
            if ( Trig_Armada_BuildOilRigs_Func005Func001Func001C() ) then
                call QueuedTriggerAddBJ(gg_trg_Armada_Update2_Q, true)
            else
                call DoNothing()
            endif
        endif
    else
        call QueuedTriggerAddBJ(gg_trg_Armada_Update2_Q, true)
    endif
endfunction

