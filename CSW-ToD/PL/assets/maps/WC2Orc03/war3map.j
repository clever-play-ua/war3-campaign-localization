//===========================================================================
// Trigger: Armada OilPatch4Hauled
//===========================================================================
function Trig_Armada_OilPatch4Hauled_Func006001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n60P' )
endfunction

function Trig_Armada_OilPatch4Hauled_Func006001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Armada_OilPatch4Hauled_Func006001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'n60P'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Armada_OilPatch4Hauled_Func006A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_TempOPCheckerA)
endfunction

function Trig_Armada_OilPatch4Hauled_Func009001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n60P' )
endfunction

function Trig_Armada_OilPatch4Hauled_Func009001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Armada_OilPatch4Hauled_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'n60P'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Armada_OilPatch4Hauled_Func009A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_TempOPCheckerB)
endfunction

function Trig_Armada_OilPatch4Hauled_Func011Func004Func006C takes nothing returns boolean
    if ( ( IsUnitAliveBJ(gg_unit_u600_0026) == true ) ) then
        return true
    endif
    if ( ( CountUnitsInGroup(udg_Group_TempOPCheckerB) != 0 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Armada_OilPatch4Hauled_Func011Func004C takes nothing returns boolean
    if ( not Trig_Armada_OilPatch4Hauled_Func011Func004Func006C() ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_OilPatch4Hauled_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_TempOPCheckerA) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_OilPatch4Hauled_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_TempOPCheckerA)
    call GroupClear(udg_Group_TempOPCheckerB)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_OilSplat04, Condition(function Trig_Armada_OilPatch4Hauled_Func006001002)), function Trig_Armada_OilPatch4Hauled_Func006A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_OilSplat05, Condition(function Trig_Armada_OilPatch4Hauled_Func009001002)), function Trig_Armada_OilPatch4Hauled_Func009A)
    // //
    if ( Trig_Armada_OilPatch4Hauled_Func011C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DestroyFogModifier(udg_VisMod_ArmadaOil_Array[4])
        call DestroyMinimapIcon(udg_MinimapIcon_OilPatches_Array[4])
        if ( Trig_Armada_OilPatch4Hauled_Func011Func004C() ) then
            call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, udg_Armada_PingPoint[5], 512.00)
            set udg_VisMod_ArmadaOil_Array[5]=GetLastCreatedFogModifier()
            call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, udg_Armada_PingPoint[5], 6.00)
            call CampaignMinimapIconLocBJ(udg_Armada_PingPoint[5], bj_CAMPPINGSTYLE_PRIMARY)
            set udg_MinimapIcon_OilPatches_Array[5]=GetLastCreatedMinimapIcon()
        else
        endif
    else
    endif
    // //
    call GroupClear(udg_Group_TempOPCheckerA)
    call GroupClear(udg_Group_TempOPCheckerB)
    // //
endfunction

//===========================================================================
function InitTrig_Armada_OilPatch4Hauled takes nothing returns nothing
    set gg_trg_Armada_OilPatch4Hauled=CreateTrigger()
    call TriggerRegisterUnitEvent(gg_trg_Armada_OilPatch4Hauled, gg_unit_u600_0005, EVENT_UNIT_DEATH)
    call TriggerAddAction(gg_trg_Armada_OilPatch4Hauled, function Trig_Armada_OilPatch4Hauled_Actions)
endfunction

