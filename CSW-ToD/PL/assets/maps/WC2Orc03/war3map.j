    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundAtPointBJ(gg_snd_SecretFound, 100, GetUnitLoc(GetDyingUnit()), 40.00)
    call TriggerSleepAction(1.00)
    call QueuedTriggerAddBJ(gg_trg_OilWar_Discover_Q, true)
endfunction

//===========================================================================
