    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL0_0149) + ( I2S(udg_Int_MQArmada_PlatformsBuild) + GetItemName(gg_item_IQL0_0149) ) ) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL1_0148) + ( udg_String_QuestOilWarsAmountText + BlzGetItemTooltip(gg_item_IQL1_0148) ) ) ) )
    // //
    call QuestMessageBJ(bj_FORCE_PLAYER[0], bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
