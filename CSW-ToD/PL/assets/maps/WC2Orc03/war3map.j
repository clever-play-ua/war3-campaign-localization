function Trig_ShipRepair_Hint_Q_Actions takes nothing returns nothing
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_HINT, "TRIGSTR_2634")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_ShipRepair_Hint_Q takes nothing returns nothing
    set gg_trg_ShipRepair_Hint_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_ShipRepair_Hint_Q, function Trig_ShipRepair_Hint_Q_Actions)
endfunction

//===========================================================================
// Trigger: OilTanker Hint
//===========================================================================
function Trig_OilTanker_Hint_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTrainedUnit()) == 'h001' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilTanker_Hint_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(2.00)
    call QueuedTriggerAddBJ(gg_trg_OilTanker_Hint_Q, true)
endfunction

//===========================================================================
function InitTrig_OilTanker_Hint takes nothing returns nothing
    set gg_trg_OilTanker_Hint=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilTanker_Hint, Player(0), EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_OilTanker_Hint, Condition(function Trig_OilTanker_Hint_Conditions))
    call TriggerAddAction(gg_trg_OilTanker_Hint, function Trig_OilTanker_Hint_Actions)
endfunction

//===========================================================================
// Trigger: OilTanker Hint Q
//===========================================================================
function Trig_OilTanker_Hint_Q_Actions takes nothing returns nothing
    call CreateBuildCommandButtonEffectBJ('u002')
    set udg_ButtonFlashEffect[1]=GetLastCreatedCommandButtonEffectBJ()
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_HINT, "TRIGSTR_2635")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_OilTanker_Hint_Q takes nothing returns nothing
    set gg_trg_OilTanker_Hint_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_OilTanker_Hint_Q, function Trig_OilTanker_Hint_Q_Actions)
endfunction

//===========================================================================
// Trigger: OilPlatform BtnFlash On
//===========================================================================
function Trig_OilPlatform_BtnFlash_On_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructingStructure()) == 'u002' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilPlatform_BtnFlash_On_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DestroyCommandButtonEffect(udg_ButtonFlashEffect[1])
endfunction

//===========================================================================
function InitTrig_OilPlatform_BtnFlash_On takes nothing returns nothing
    set gg_trg_OilPlatform_BtnFlash_On=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilPlatform_BtnFlash_On, Player(0), EVENT_PLAYER_UNIT_CONSTRUCT_START)
    call TriggerAddCondition(gg_trg_OilPlatform_BtnFlash_On, Condition(function Trig_OilPlatform_BtnFlash_On_Conditions))
    call TriggerAddAction(gg_trg_OilPlatform_BtnFlash_On, function Trig_OilPlatform_BtnFlash_On_Actions)
endfunction

//===========================================================================
// Trigger: OilPlatform BtnFlash Off
//===========================================================================
function Trig_OilPlatform_BtnFlash_Off_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructingStructure()) == 'o60V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilPlatform_BtnFlash_Off_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DestroyCommandButtonEffect(udg_ButtonFlashEffect[2])
    call TriggerSleepAction(1.00)
    call DestroyCommandButtonEffect(udg_ButtonFlashEffect[3])
endfunction

//===========================================================================
function InitTrig_OilPlatform_BtnFlash_Off takes nothing returns nothing
    set gg_trg_OilPlatform_BtnFlash_Off=CreateTrigger()
