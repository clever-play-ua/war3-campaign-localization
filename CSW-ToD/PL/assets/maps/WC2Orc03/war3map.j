//===========================================================================
function Trig_BuildingsReviveRain_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_Raining == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BuildingsReviveRain_Func004001002001001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_BuildingsReviveRain_Func004001002001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o60P' )
endfunction

function Trig_BuildingsReviveRain_Func004001002001002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'e000' )
endfunction

function Trig_BuildingsReviveRain_Func004001002001002 takes nothing returns boolean
    return GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'o60P'), (GetUnitTypeId(GetFilterUnit()) == 'e000')) // INLINED!!
endfunction

function Trig_BuildingsReviveRain_Func004001002001 takes nothing returns boolean
    return GetBooleanOr((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'o60P'), (GetUnitTypeId(GetFilterUnit()) == 'e000')))) // INLINED!!
endfunction

function Trig_BuildingsReviveRain_Func004001002002 takes nothing returns boolean
    return ( GetUnitStateSwap(UNIT_STATE_LIFE, GetFilterUnit()) < ( 0.75 * GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetFilterUnit()) ) )
endfunction

function Trig_BuildingsReviveRain_Func004001002 takes nothing returns boolean
    return GetBooleanAnd((GetBooleanOr((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'o60P'), (GetUnitTypeId(GetFilterUnit()) == 'e000'))))), (GetUnitStateSwap(UNIT_STATE_LIFE, GetFilterUnit()) < ( 0.75 * GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetFilterUnit()) ))) // INLINED!!
endfunction

function Trig_BuildingsReviveRain_Func004A takes nothing returns nothing
    call SetUnitLifeBJ(GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + 1.00 ))
endfunction

function Trig_BuildingsReviveRain_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_BuildingsReviveRain_Func004001002)), function Trig_BuildingsReviveRain_Func004A)
endfunction

