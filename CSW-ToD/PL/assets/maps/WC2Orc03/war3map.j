//===========================================================================
// Trigger: BarrelExplode
//===========================================================================
function Trig_BarrelExplode_Conditions takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'LTex' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BarrelExplode_Func002002 takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_BarrelExplode_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnumDestructablesInRectAll(gg_rct_BarrelExplode, function Trig_BarrelExplode_Func002002)
endfunction

//===========================================================================
function InitTrig_BarrelExplode takes nothing returns nothing
    set gg_trg_BarrelExplode=CreateTrigger()
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_BarrelExplode, gg_rct_BarrelExplode)
    call TriggerAddCondition(gg_trg_BarrelExplode, Condition(function Trig_BarrelExplode_Conditions))
    call TriggerAddAction(gg_trg_BarrelExplode, function Trig_BarrelExplode_Actions)
endfunction

//===========================================================================
// Trigger: TurtleEggSpawn
//===========================================================================
function Trig_TurtleEggSpawn_Conditions takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'B62T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_TurtleEggSpawn_Func002C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TurtleEggSpawn_Actions takes nothing returns nothing
    set udg_Point_TurtleSpawnTemp=GetDestructableLoc(GetDyingDestructable())
    if ( Trig_TurtleEggSpawn_Func002C() ) then
        call CreateNUnitsAtLoc(1, 'ntrh', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Point_TurtleSpawnTemp, GetRandomDirectionDeg())
    else
    endif
    call RemoveLocation(udg_Point_TurtleSpawnTemp)
endfunction

//===========================================================================
function InitTrig_TurtleEggSpawn takes nothing returns nothing
    set gg_trg_TurtleEggSpawn=CreateTrigger()
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_TurtleEggSpawn, gg_rct_TurtleEggsA)
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_TurtleEggSpawn, gg_rct_TurtleEggsB)
    call TriggerAddCondition(gg_trg_TurtleEggSpawn, Condition(function Trig_TurtleEggSpawn_Conditions))
    call TriggerAddAction(gg_trg_TurtleEggSpawn, function Trig_TurtleEggSpawn_Actions)
endfunction

