function Trig_Alliance_Completed_Func008A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_AllianceEnemies)
endfunction

function Trig_Alliance_Completed_Func010C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_AllianceEnemies) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Alliance_Completed_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_AllianceEnemies)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Alliance_secret_Camp, Condition(function Trig_Alliance_Completed_Func005001002)), function Trig_Alliance_Completed_Func005A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_BeachCamp, Condition(function Trig_Alliance_Completed_Func008001002)), function Trig_Alliance_Completed_Func008A)
    // //
    if ( Trig_Alliance_Completed_Func010C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call ConditionalTriggerExecute(gg_trg_AI_P02_Defeated)
        call QueuedTriggerAddBJ(gg_trg_Alliance_Completed_Q, true)
        call QueuedTriggerAddBJ(gg_trg_UtokLevelUpChecker, true)
    else
    endif
    // //
    // //
    call GroupClear(udg_Group_AllianceEnemies)
    // //
endfunction

