    call TriggerAddCondition(gg_trg_Alliance_Discover, Condition(function Trig_Alliance_Discover_Conditions))
    call TriggerAddAction(gg_trg_Alliance_Discover, function Trig_Alliance_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Alliance Discover Q
//===========================================================================
function Trig_Alliance_Discover_Q_Actions takes nothing returns nothing
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, Player(20), 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc03Rend10, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call QuestSetDiscoveredBJ(udg_OQ_Alliance, true)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2611")
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

