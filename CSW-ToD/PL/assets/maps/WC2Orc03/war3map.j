//===========================================================================
// Trigger: Init 05 Quests
//===========================================================================
function Trig_Init_05_Quests_Actions takes nothing returns nothing
    // MAIN QUEST: SUPPLYING THE ARMADA
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_2554", "TRIGSTR_2555", "ReplaceableTextures\\CommandButtons\\BTNGatherOil.dds")
    set udg_MQ_Armada=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQ_Armada, "TRIGSTR_2556")
    set udg_QReq_Armada_BuildShipyard=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQ_Armada, "TRIGSTR_2557")
    set udg_QReq_Armada_BuildOilPlatform=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQ_Armada, ( BlzGetItemExtendedTooltip(gg_item_IQL3_0150) + ( udg_String_QuestOilWarsAmountText + BlzGetItemTooltip(gg_item_IQL1_0148) ) ))
    set udg_QReq_Armada_GatherOil=GetLastCreatedQuestItemBJ()
    // OPTIONAL QUEST: ALLIANCE TROOPS
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2608", "TRIGSTR_2609", "ReplaceableTextures\\CommandButtons\\BTNHumanCaptureFlag.blp")
    set udg_OQ_Alliance=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQ_Alliance, "TRIGSTR_2610")
    set udg_QReq_Alliance_DestroyCamp=GetLastCreatedQuestItemBJ()
    // OPTIONAL QUEST: OIL WAR
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2636", "TRIGSTR_2637", "ReplaceableTextures\\CommandButtons\\BTNWC2HumanOilRefinery.dds")
    set udg_OQ_OilWars=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQ_OilWars, "TRIGSTR_2638")
    set udg_QReq_OilWars_DestroyRefineries=GetLastCreatedQuestItemBJ()
    set udg_Int_RefineriesRemaining=2
    // OPTIONAL QUEST: SOUTHSHORE SQUADRON
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2612", "TRIGSTR_2613", "ReplaceableTextures\\CommandButtons\\BTNShip.blp")
    set udg_OQ_Southshore=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQ_Southshore, "TRIGSTR_2614")
    set udg_QReq_South_DestroyBattleships=GetLastCreatedQuestItemBJ()
endfunction

