//===========================================================================
// Trigger: Cliff01On
//===========================================================================
function Trig_Cliff01On_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(0) ) ) then
        return false
    endif
    if ( not ( udg_Bool_CliffVisibilityOn[1] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cliff01On_Actions takes nothing returns nothing
    set udg_Bool_CliffVisibilityOn[1]=true
    call UnitShareVisionBJ(true, gg_unit_h003_0043, Player(0))
    call EnableTrigger(gg_trg_Cliff01Off)
endfunction

//===========================================================================
function InitTrig_Cliff01On takes nothing returns nothing
    set gg_trg_Cliff01On=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Cliff01On, gg_rct_ExposeCliff01)
    call TriggerAddCondition(gg_trg_Cliff01On, Condition(function Trig_Cliff01On_Conditions))
    call TriggerAddAction(gg_trg_Cliff01On, function Trig_Cliff01On_Actions)
endfunction

//===========================================================================
// Trigger: Cliff01Off
//===========================================================================
function Trig_Cliff01Off_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CliffVisibilityOn[1] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cliff01Off_Func002Func001001001002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Cliff01Off_Func002Func001001001002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == Player(0) )
endfunction

function Trig_Cliff01Off_Func002Func001001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetOwningPlayer(GetFilterUnit()) == Player(0))) // INLINED!!
endfunction

function Trig_Cliff01Off_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_ExposeCliff01, Condition(function Trig_Cliff01Off_Func002Func001001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cliff01Off_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Cliff01Off_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call UnitShareVisionBJ(false, gg_unit_h003_0043, Player(0))
        set udg_Bool_CliffVisibilityOn[1]=false
    else
    endif
endfunction

