function Trig_OilWar_Discover_Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'h600' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'o61C' ) ) then
        return true
    endif
    return false
endfunction

function Trig_OilWar_Discover_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    if ( not Trig_OilWar_Discover_Func002C() ) then
        return false
    endif
    return true
endfunction

