//===========================================================================
// Trigger: Initialization
//===========================================================================
function Trig_Initialization_Actions takes nothing returns nothing
    call Preload("terrainart\\village\\village_dirt_diffuse.dds")
    call Preload("terrainart\\village\\village_dirtrough_diffuse.dds")
    call Preload("terrainart\\village\\village_grassshort_diffuse.dds")
    call Preload("terrainart\\village\\village_grassthick_diffuse.dds")
    call Preload("terrainart\\villagefall\\villagefall_grassshort_diffuse.dds")
    call Preload("terrainart\\ruins\\ruins_sand_diffuse.dds")
    call Preload("terrainart\\village\\village_crops_diffuse.dds")
    call Preload("terrainart\\village\\village_cobblepath_diffuse.dds")
    call Preload("terrainart\\village\\village_stonepath_diffuse.dds")
    call Preload("terrainart\\village\\village_rocks_diffuse.dds")
    call ConditionalTriggerExecute(gg_trg_Oil_Locale_Setup)
    call ConditionalTriggerExecute(gg_trg_FacialAnimationLoad)
    // **********
    call SetAllyColorFilterState(0)
    call EnableMinimapFilterButtons(false, false)
    call SetMaxCheckpointSaves(10)
    call ConditionalTriggerExecute(gg_trg_Init_01_Players)
    call ConditionalTriggerExecute(gg_trg_Init_03_Audio)
    call ConditionalTriggerExecute(gg_trg_Init_04_Environment)
    // **********
    call QueuedTriggerAddBJ(gg_trg_Intro_Cinematic_Q, true)
endfunction

//===========================================================================
function InitTrig_Initialization takes nothing returns nothing
    set gg_trg_Initialization=CreateTrigger()
    call TriggerAddAction(gg_trg_Initialization, function Trig_Initialization_Actions)
endfunction

//===========================================================================
// Trigger: Init 01 Players
//===========================================================================
function Trig_Init_01_Players_Actions takes nothing returns nothing
    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[0]
    call EnableOcclusionBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    set udg_Player_Actual=Player(0)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 450)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 300)
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 15.00)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_2553")
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(false, 'AHfC', udg_Player_Actual)
    // //
    set udg_Player_Trolls=Player(6)
    call SetPlayerAbilityAvailableBJ(false, 'A60C', udg_Player_Trolls)
    // //
    set udg_Player_Alliance=Player(1)
    call SetPlayerUnitAvailableBJ('h60S', false, udg_Player_Alliance)
    call SetPlayerColorBJ(udg_Player_Alliance, PLAYER_COLOR_SNOW, true)
    // //
    set udg_Player_BTG=Player(20)
    // //
    set udg_Player_AllianceNavy=Player(3)
    call SetPlayerColorBJ(udg_Player_AllianceNavy, PLAYER_COLOR_LIGHT_BLUE, true)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_AllianceNavy)
    // //
    set udg_Player_ZuljinCinematic=Player(2)
    // //
    call EnableCreepSleepBJ(false)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Alliance, udg_Player_AllianceNavy, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_AllianceNavy, udg_Player_Alliance, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_AllianceNavy, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_AllianceNavy, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Alliance, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Alliance, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BTG, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player_ZuljinCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_ZuljinCinematic, udg_Player_BTG, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_ZuljinCinematic, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_ZuljinCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_ZuljinCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_ZuljinCinematic, udg_Player_Trolls, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Alliance, udg_Player_Trolls, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_Alliance, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_BTG, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player_Trolls, bj_ALLIANCE_NEUTRAL)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_06a_Hard)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Normal)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Easy)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_05_Quests)
endfunction

