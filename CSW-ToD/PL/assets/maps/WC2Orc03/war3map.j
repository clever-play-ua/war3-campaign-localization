// Trigger: Armada Discover
//===========================================================================
function Trig_Armada_Discover_Actions takes nothing returns nothing
    call IssuePointOrderLocBJ(gg_unit_h600_0019, "move", GetRectCenter(gg_rct_OilSplat04))
    call IssuePointOrderLocBJ(gg_unit_h600_0069, "move", GetRectCenter(gg_rct_OilSplat05))
    // //
    call RescueUnitBJ(gg_unit_o60O_0034, Player(0), false)
    call RescueUnitBJ(gg_unit_o60O_0033, Player(0), false)
    // //
    call SetUnitOwner(udg_Hero_Zuljin, udg_Player_Actual, false)
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P02_Ground_Start)
    call ConditionalTriggerExecute(gg_trg_AI_P04_Naval_Start)
    // //
    call ConditionalTriggerExecute(gg_trg_Creating_and_Setting_Weather)
    // //
    call EnableTrigger(gg_trg_AllUnitsDead_Defeat)
    // //
    call QueuedTriggerAddBJ(gg_trg_Armada_Discover_Q, true)
    // //
endfunction

//===========================================================================
function InitTrig_Armada_Discover takes nothing returns nothing
    set gg_trg_Armada_Discover=CreateTrigger()
    call TriggerAddAction(gg_trg_Armada_Discover, function Trig_Armada_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Armada Discover Q
//===========================================================================
function Trig_Armada_Discover_Q_Actions takes nothing returns nothing
    set udg_newLine="\n"
    call CreateLeaderboardBJ(bj_FORCE_PLAYER[0], "TRIGSTR_2570")
    set udg_Leaderboard_QuestObjectives=GetLastCreatedLeaderboard()
    call LeaderboardAddItemBJ(Player(0), udg_Leaderboard_QuestObjectives, "TRIGSTR_2571", 0)
    call LeaderboardAddItemBJ(Player(1), udg_Leaderboard_QuestObjectives, "TRIGSTR_2572", 0)
    call LeaderboardSetLabelColorBJ(udg_Leaderboard_QuestObjectives, 100, 80, 20.00, 0)
    call LeaderboardSetValueColorBJ(udg_Leaderboard_QuestObjectives, 100, 80.00, 20.00, 0)
    call LeaderboardSetStyleBJ(udg_Leaderboard_QuestObjectives, true, true, true, false)
    call ConditionalTriggerExecute(gg_trg_QuestBoardStatusCheck)
    // //
    set udg_Armada_PingPoint[1]=GetUnitLoc(gg_unit_n60P_0003)
    set udg_Armada_PingPoint[2]=GetUnitLoc(gg_unit_n60P_0002)
    set udg_Armada_PingPoint[3]=GetUnitLoc(gg_unit_n60P_0006)
    set udg_Armada_PingPoint[4]=GetUnitLoc(gg_unit_u600_0005)
    set udg_Armada_PingPoint[5]=GetUnitLoc(gg_unit_u600_0026)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateFogModifierRadiusLocBJ(true, Player(0), FOG_OF_WAR_VISIBLE, udg_Armada_PingPoint[GetForLoopIndexA()], 512.00)
        set udg_VisMod_ArmadaOil_Array[GetForLoopIndexA()]=GetLastCreatedFogModifier()
        call CampaignMinimapIconLocBJ(udg_Armada_PingPoint[GetForLoopIndexA()], bj_CAMPPINGSTYLE_PRIMARY)
        set udg_MinimapIcon_OilPatches_Array[GetForLoopIndexA()]=GetLastCreatedMinimapIcon()
        call PingMinimapLocForForce(bj_FORCE_PLAYER[0], udg_Armada_PingPoint[GetForLoopIndexA()], 6.00)
        call SetCameraQuickPositionLocForPlayer(Player(0), udg_Armada_PingPoint[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call ConditionalTriggerExecute(gg_trg_Armada_Ping)
    // //
    set udg_String_CompletedQuests=( GetItemName(gg_item_IQL1_0148) + ( udg_newLine + BlzGetItemDescription(gg_item_IQL0_0149) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL0_0149) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL0_0149) + ( I2S(udg_Int_MQArmada_PlatformsBuild) + GetItemName(gg_item_IQL0_0149) ) ) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL1_0148) + ( udg_String_QuestOilWarsAmountText + BlzGetItemTooltip(gg_item_IQL1_0148) ) ) ) )
    // //
    call QuestMessageBJ(bj_FORCE_PLAYER[0], bj_QUESTMESSAGE_DISCOVERED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(bj_FORCE_PLAYER[0], bj_QUESTMESSAGE_HINT, "TRIGSTR_2573")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Armada_Discover_Q takes nothing returns nothing
    set gg_trg_Armada_Discover_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Armada_Discover_Q, function Trig_Armada_Discover_Q_Actions)
endfunction

