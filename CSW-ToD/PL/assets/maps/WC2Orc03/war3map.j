    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerOilRigs)
endfunction

function Trig_Armada_Defeat_NoOil_Func009001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'u600' )
endfunction

function Trig_Armada_Defeat_NoOil_Func009001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Armada_Defeat_NoOil_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'u600'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Armada_Defeat_NoOil_Func009002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_EnemyOilRigs)
endfunction

function Trig_Armada_Defeat_NoOil_Func011Func008Func002Func002C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Defeat_NoOil_Func011Func008Func002C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Defeat_NoOil_Func011Func008C takes nothing returns boolean
    if ( not ( udg_PlayerOil < udg_Int_QuestOilTargetAmount ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_OQ_OilWars) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Defeat_NoOil_Func011Func010C takes nothing returns boolean
    if ( not ( udg_Int_MQArmada_PlatformsBuild < 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Defeat_NoOil_Func011Func012Func006C takes nothing returns boolean
    if ( ( udg_Bool_MQArmadaOilAmountFailed == true ) ) then
        return true
    endif
    if ( ( udg_Bool_MQArmadaRigsAmountFail == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Armada_Defeat_NoOil_Func011Func012C takes nothing returns boolean
    if ( not Trig_Armada_Defeat_NoOil_Func011Func012Func006C() ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Defeat_NoOil_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_FreeOilPatches) == 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Group_EnemyOilRigs) == 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Group_PlayerOilRigs) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Defeat_NoOil_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Armada_Defeat_NoOil_Func003001002)), function Trig_Armada_Defeat_NoOil_Func003002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Armada_Defeat_NoOil_Func006001002)), function Trig_Armada_Defeat_NoOil_Func006002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Armada_Defeat_NoOil_Func009001002)), function Trig_Armada_Defeat_NoOil_Func009002)
    // //
    if ( Trig_Armada_Defeat_NoOil_Func011C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_PlayerOil=(OilHarvest___playerOil[GetPlayerId((Player(0)))]) // INLINED!!
        // // Defeat is happening if the player has no option to build 4 platforms OR no way to get the desired amount of Oil //
        // // Defeat Condition 1 - insufficient Oil
        if ( Trig_Armada_Defeat_NoOil_Func011Func008C() ) then
            set udg_Bool_MQArmadaOilAmountFailed=true
            if ( Trig_Armada_Defeat_NoOil_Func011Func008Func002C() ) then
                call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_FAILED, "TRIGSTR_2766")
            else
                if ( Trig_Armada_Defeat_NoOil_Func011Func008Func002Func002C() ) then
                    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_FAILED, "TRIGSTR_2765")
                else
                    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_FAILED, "TRIGSTR_2764")
                endif
            endif
        else
        endif
        // // Defeat Condition 2 - no availiable oil patches in the map
        if ( Trig_Armada_Defeat_NoOil_Func011Func010C() ) then
            set udg_Bool_MQArmadaRigsAmountFail=true
            call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_FAILED, "TRIGSTR_2763")
        else
        endif
        // // Defeat Condition Check
        if ( Trig_Armada_Defeat_NoOil_Func011Func012C() ) then
            call QuestSetFailedBJ(udg_MQ_Armada, true)
            set udg_GameOver=true
            call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
            call TriggerSleepAction(2.00)
            call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_2767")
        else
        endif
    else
    endif
    // //
    call GroupClear(udg_Group_FreeOilPatches)
    call GroupClear(udg_Group_PlayerOilRigs)
    call GroupClear(udg_Group_EnemyOilRigs)
    // //
endfunction

//===========================================================================
function InitTrig_Armada_Defeat_NoOil takes nothing returns nothing
    set gg_trg_Armada_Defeat_NoOil=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Armada_Defeat_NoOil, 2)
    call TriggerAddAction(gg_trg_Armada_Defeat_NoOil, function Trig_Armada_Defeat_NoOil_Actions)
endfunction

