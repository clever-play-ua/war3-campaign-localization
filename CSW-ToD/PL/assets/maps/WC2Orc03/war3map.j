//===========================================================================
// Trigger: Armada Ping
//
// Needs Update to fit new Oil System
//===========================================================================
function Trig_Armada_Ping_Conditions takes nothing returns boolean
    if ( not ( IsQuestItemCompleted(udg_QReq_Armada_BuildOilPlatform) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Ping_Func003001 takes nothing returns boolean
    return ( IsQuestItemCompleted(udg_QReq_Armada_BuildOilPlatform) == true )
endfunction

function Trig_Armada_Ping_Func005Func001001 takes nothing returns boolean
    return ( udg_Bool_MQArmada_PlatformsBuild[5] == false )
endfunction

function Trig_Armada_Ping_Func005C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Armada_OilPatch4Hauled) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Ping_Actions takes nothing returns nothing
    call TriggerSleepAction(60.00)
    if ( (IsQuestItemCompleted(udg_QReq_Armada_BuildOilPlatform) == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    if ( Trig_Armada_Ping_Func005C() ) then
        if ( (udg_Bool_MQArmada_PlatformsBuild[5] == false) ) then // INLINED!!
            call PingMinimapLocForForceEx(bj_FORCE_PLAYER[0], udg_Armada_PingPoint[5], 7.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
        else
            call DoNothing()
        endif
    else
    endif
    call TriggerSleepAction(60.00)
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

