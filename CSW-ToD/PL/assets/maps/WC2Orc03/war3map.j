//===========================================================================
function Trig_QuestBoardStatusCheck_Func001Func003C takes nothing returns boolean
    if ( ( LeaderboardHasPlayerItemBJ(udg_Leaderboard_QuestObjectives, Player(0)) == true ) ) then
        return true
    endif
    if ( ( LeaderboardHasPlayerItemBJ(udg_Leaderboard_QuestObjectives, Player(1)) == true ) ) then
        return true
    endif
    if ( ( LeaderboardHasPlayerItemBJ(udg_Leaderboard_QuestObjectives, Player(2)) == true ) ) then
        return true
    endif
    if ( ( LeaderboardHasPlayerItemBJ(udg_Leaderboard_QuestObjectives, Player(9)) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_QuestBoardStatusCheck_Func001C takes nothing returns boolean
    if ( not Trig_QuestBoardStatusCheck_Func001Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_QuestBoardStatusCheck_Actions takes nothing returns nothing
    if ( Trig_QuestBoardStatusCheck_Func001C() ) then
        call LeaderboardDisplayBJ(true, udg_Leaderboard_QuestObjectives)
    else
        call LeaderboardDisplayBJ(false, udg_Leaderboard_QuestObjectives)
    endif
endfunction

