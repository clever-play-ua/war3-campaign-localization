    return ( GetUnitTypeId(GetFilterUnit()) == 'h001' )
endfunction

function Trig_AllUnitsDead_Defeat_Func023001002002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AllUnitsDead_Defeat_Func023001002002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == Player(0) )
endfunction

function Trig_AllUnitsDead_Defeat_Func023001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetOwningPlayer(GetFilterUnit()) == Player(0))) // INLINED!!
endfunction

function Trig_AllUnitsDead_Defeat_Func023001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h001'), (GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetOwningPlayer(GetFilterUnit()) == Player(0))))) // INLINED!!
endfunction

function Trig_AllUnitsDead_Defeat_Func023002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_OillDefeatConditionCheck[1])
endfunction

function Trig_AllUnitsDead_Defeat_Func025Func009C takes nothing returns boolean
    if ( ( CountUnitsInGroup(udg_Group_OillDefeatConditionCheck[0]) == 0 ) ) then
        return true
    endif
    if ( ( CountUnitsInGroup(udg_Group_OillDefeatConditionCheck[1]) == 0 ) ) then
        return true
    endif
    return false
endfunction

function Trig_AllUnitsDead_Defeat_Func025C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_DefeatConditionCheck) == 0 ) ) then
        return false
    endif
    if ( not Trig_AllUnitsDead_Defeat_Func025Func009C() ) then
        return false
    endif
    return true
endfunction

function Trig_AllUnitsDead_Defeat_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_DefeatConditionCheck)
    call GroupClear(udg_Group_OillDefeatConditionCheck[0])
    call GroupClear(udg_Group_OillDefeatConditionCheck[1])
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_AllUnitsDead_Defeat_Func008001002)), function Trig_AllUnitsDead_Defeat_Func008002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_AllUnitsDead_Defeat_Func011001002)), function Trig_AllUnitsDead_Defeat_Func011002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_AllUnitsDead_Defeat_Func014001002)), function Trig_AllUnitsDead_Defeat_Func014002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_AllUnitsDead_Defeat_Func017001002)), function Trig_AllUnitsDead_Defeat_Func017002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_AllUnitsDead_Defeat_Func020001002)), function Trig_AllUnitsDead_Defeat_Func020002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_AllUnitsDead_Defeat_Func023001002)), function Trig_AllUnitsDead_Defeat_Func023002)
    // //
    if ( Trig_AllUnitsDead_Defeat_Func025C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_GameOver=true
        call QuestSetFailedBJ(udg_MQ_Armada, true)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_FAILED, "TRIGSTR_2755")
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
        call TriggerSleepAction(2.00)
        call CustomDefeatBJ(Player(0), "TRIGSTR_2756")
    else
    endif
    // //
    // //
    call GroupClear(udg_Group_DefeatConditionCheck)
    call GroupClear(udg_Group_OillDefeatConditionCheck[0])
    call GroupClear(udg_Group_OillDefeatConditionCheck[1])
    // //
endfunction

//===========================================================================
function InitTrig_AllUnitsDead_Defeat takes nothing returns nothing
    set gg_trg_AllUnitsDead_Defeat=CreateTrigger()
    call DisableTrigger(gg_trg_AllUnitsDead_Defeat)
    call TriggerRegisterTimerEventPeriodic(gg_trg_AllUnitsDead_Defeat, 2)
    call TriggerAddCondition(gg_trg_AllUnitsDead_Defeat, Condition(function Trig_AllUnitsDead_Defeat_Conditions))
    call TriggerAddAction(gg_trg_AllUnitsDead_Defeat, function Trig_AllUnitsDead_Defeat_Actions)
endfunction

