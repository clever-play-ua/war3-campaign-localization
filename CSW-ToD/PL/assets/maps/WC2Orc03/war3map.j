//===========================================================================
// Trigger: Shipyard Hint Q
//===========================================================================
function Trig_Shipyard_Hint_Q_Actions takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ(true, 'A610', udg_Player_Actual)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_2631")
    // //
    call CreateCommandButtonEffectBJ('A610', "bearform")
    set udg_ButtonFlashEffect[2]=GetLastCreatedCommandButtonEffectBJ()
    call TriggerSleepAction(1.00)
    call CreateBuildCommandButtonEffectBJ('o60V')
    set udg_ButtonFlashEffect[3]=GetLastCreatedCommandButtonEffectBJ()
    call TriggerSleepAction(1.00)
    call TriggerSleepAction(( bj_QUEUE_DELAY_HINT - 2.00 ))
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_HINT, "TRIGSTR_2632")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_OilPatches_Warning)
endfunction

