    call ConditionalTriggerExecute(gg_trg_AI_P04_Eligible_to_Attack)
    call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_QuestObjectives, 1)
    call QueuedTriggerAddBJ(gg_trg_Armada_Update1_Q, true)
    if ( Trig_Armada_Update1_Func007C() ) then
        set udg_Armada_ShipyardLocation=1
    else
        if ( Trig_Armada_Update1_Func007Func001C() ) then
            set udg_Armada_ShipyardLocation=2
        else
            if ( Trig_Armada_Update1_Func007Func001Func001C() ) then
                set udg_Armada_ShipyardLocation=3
            else
                set udg_Armada_ShipyardLocation=4
            endif
        endif
