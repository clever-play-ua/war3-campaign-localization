    call DisableTrigger(GetTriggeringTrigger())
    loop
        exitwhen ( (RectContainsUnit(gg_rct_GruntCin01, udg_SemiHero_Utok) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
