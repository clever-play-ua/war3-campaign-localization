//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func015C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    call StopSoundBJ(gg_snd_WC3OrcVictory, true)
    call CinematicFilterGenericBJ(2, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100, 100, 100, 100, 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    call SetUnitOwner(udg_Hero_Rend, Player(0), false)
    call TriggerSleepAction(0.10)
    call ShowUnitShow(udg_Hero_Zuljin)
    call ShowUnitShow(udg_Hero_Rend)
    call ShowUnitShow(udg_SemiHero_Utok)
    call TriggerSleepAction(0.10)
    // ///
    call StoreUnitBJ(udg_Hero_Rend, "Rend", "WC2Orc03", udg_Cache)
    // ///
    call StoreUnitBJ(udg_Hero_Zuljin, "ZulJeen", "WC2Orc03", udg_Cache)
    // ///
    if ( Trig_Next_Level_Prep_Func015C() ) then
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc03", udg_Cache)
    else
        call CreateNUnitsAtLoc(1, 'o605', Player(0), GetRectCenter(gg_rct_UtokCacheBackUpIfDead), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc03", udg_Cache)
    endif
    // ///
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', Player(0)), "UtokLevel", "WC2Orc03", udg_Cache)
    // ///
    call StoreBooleanBJ(true, "Completed", "WC2Orc03", udg_Cache)
    // ///
    call TriggerSleepAction(0.10)
    // ///
    call SaveGameCacheBJ(udg_Cache)
    // Original map transition
    call ShowCustomCampaignButton(true, 5)
    call SetNextLevelBJ("WC2Orc04.w3x")
    call TriggerSleepAction(0.10)
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CustomVictoryBJ(Player(0), true, true)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

