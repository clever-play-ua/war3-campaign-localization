    set gg_trg_Armada_Update2_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Armada_Update2_Q, function Trig_Armada_Update2_Q_Actions)
endfunction

//===========================================================================
// Trigger: Armada Destroyer Hint Q
//===========================================================================
function Trig_Armada_Destroyer_Hint_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60R', Player(6), udg_Armada_DestroyerCreatePoint[udg_Armada_ShipyardLocation], udg_Armada_DestroyerTargetPoint[udg_Armada_ShipyardLocation])
    set udg_Unit_ArmadaDestroyer=GetLastCreatedUnit()
    call UnitShareVisionBJ(true, udg_Unit_ArmadaDestroyer, udg_Player_Actual)
    call SetUnitColor(udg_Unit_ArmadaDestroyer, PLAYER_COLOR_RED)
    call ResetToGameCameraForPlayer(Player(0), 0)
    call SmartCameraPanBJ(Player(0), udg_Armada_DestroyerTargetPoint[udg_Armada_ShipyardLocation], 1.00)
    call IssuePointOrderLocBJ(udg_Unit_ArmadaDestroyer, "move", udg_Armada_DestroyerTargetPoint[udg_Armada_ShipyardLocation])
    call PolledWait(2.50)
    call PlaySoundOnUnitBJ(gg_snd_WC2TrollDestroyerPissed2, 100, udg_Unit_ArmadaDestroyer)
    call PolledWait(1.00)
    call RescueUnitBJ(udg_Unit_ArmadaDestroyer, Player(0), true)
    call PolledWait(1.00)
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], Player(2), 'O60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc03Zuljin4, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestMessageBJ(bj_FORCE_PLAYER[0], bj_QUESTMESSAGE_UNITACQUIRED, "TRIGSTR_531")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

