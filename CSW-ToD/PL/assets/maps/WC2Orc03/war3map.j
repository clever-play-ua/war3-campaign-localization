    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_Alliance ) ) then
        return false
    endif
    if ( not Trig_AI_P02_Attacker_Deindex_Func003C() ) then
        return false
    endif
    return true
endfunction

