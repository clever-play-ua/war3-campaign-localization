//===========================================================================
// Trigger: OilSpentForTrollDestoryer
//===========================================================================
function Trig_OilSpentForTrollDestoryer_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetOrderedUnit()) == 'o60V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForTrollDestoryer_Actions takes nothing returns nothing
    local sound OrcUI_InsufficientOill
    local string Sound_Path= "Sound\\Interface\\Warning\\Orc\\GruntNoOil1.mp3"
    // //
    // Check the Order to train the ship
    if ( ( GetIssuedOrderId() == 1865822290 ) ) then
    // Check the amount of Oil for Player
    if (OilHarvest___playerOil[GetPlayerId((Player(0)))]) < 700 then // INLINED!!
    // // // UI Warning
    set OrcUI_InsufficientOill=CreateSound(Sound_Path, false, false, false, 1, 1, "DefaultEAXON")
    call SetSoundParamsFromLabel(OrcUI_InsufficientOill, "User Interface")
    call SetSoundVolume(OrcUI_InsufficientOill, 127)
    call SetSoundPitch(OrcUI_InsufficientOill, 1.0)
    call StartSound(OrcUI_InsufficientOill)
    call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_2461")
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(0) , - 700)
    else
    // need to decrease the oil if there was enough of it and ship started to build
    call playerAddOil(Player(0) , - 700)
    endif
    endif
    // // // leak cleaner
    call KillSoundWhenDone(OrcUI_InsufficientOill)
    set OrcUI_InsufficientOill=null
endfunction

