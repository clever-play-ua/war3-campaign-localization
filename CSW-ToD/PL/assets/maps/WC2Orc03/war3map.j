    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func117001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func124001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func126001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call DestroyLeaderboardBJ(udg_Leaderboard_QuestObjectives)
    call ConditionalTriggerExecute(gg_trg_OilTextHide)
    call CinematicModeBJ(true, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    set udg_Bool_CinOutroOn=true
    call SetDoodadAnimationRectBJ("stand", 'D64K', gg_rct_WallpaperOutro)
    call SetPlayerAllianceStateBJ(Player(0), Player(1), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(1), Player(0), bj_ALLIANCE_NEUTRAL)
    call SetTerrainFogExBJ(0, 1000, 8500.00, 0, 34.00, 49.00, 52.00)
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Final_Cinematic_Q_Func018A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Final_Cinematic_Q_Func021001002)), function Trig_Final_Cinematic_Q_Func021002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_FinalCinWharf, Condition(function Trig_Final_Cinematic_Q_Func024001002)), function Trig_Final_Cinematic_Q_Func024002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(1024.00, GetRectCenter(gg_rct_OilSplat01)), function Trig_Final_Cinematic_Q_Func027002)
    // //
    call EnumDestructablesInRectAll(gg_rct_OilBarrels02, function Trig_Final_Cinematic_Q_Func029002)
    call EnumDestructablesInRectAll(gg_rct_OilBarrels01, function Trig_Final_Cinematic_Q_Func030002)
    // //
    call CreateNUnitsAtLoc(1, 'o60V', Player(0), GetRectCenter(gg_rct_FinalCinWharfBuilding), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'u002', Player(0), GetRectCenter(gg_rct_OilSplat01), bj_UNIT_FACING)
    set udg_Unit_OilRigFinalCin=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h001', Player(0), GetRectCenter(gg_rct_TankerFin), 315.00)
    set udg_Unit_TankerFinalCin=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_TankerFinalCin)
    call SetUnitAnimation(udg_Unit_OilRigFinalCin, "stand work")
    // //
    // Hide real herous in order not to interfier with fake actors
    // //
    if ( Trig_Final_Cinematic_Q_Func042C() ) then
        call ShowUnitHide(udg_Hero_Zuljin)
    else
    endif
    if ( Trig_Final_Cinematic_Q_Func043C() ) then
        call ShowUnitHide(udg_SemiHero_Utok)
    else
    endif
    if ( Trig_Final_Cinematic_Q_Func044C() ) then
        call ShowUnitHide(udg_Hero_Rend)
    else
    endif
    // //
    // CreateActors
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'ORbC', Player(20), GetRectCenter(gg_rct_RendFinal), GetRectCenter(gg_rct_OilSplat01))
    set udg_FakeRend=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'OZcN', Player(0), GetRectCenter(gg_rct_ZuljinFinal), GetRectCenter(gg_rct_OilSplat01))
    set udg_FakeZuljin=GetLastCreatedUnit()
    // //
    call SetUnitColor(udg_FakeZuljin, PLAYER_COLOR_CYAN)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o605', Player(0), GetRectCenter(gg_rct_UtokFinal), GetRectCenter(gg_rct_OilSplat01))
    set udg_FakeUtok=GetLastCreatedUnit()
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic writing one")
    // //
    // CreateShips
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts01), 0.00)
    set udg_Unit_ArmadaShipArray[1]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts02), 0.00)
    set udg_Unit_ArmadaShipArray[2]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts03), 0.00)
    set udg_Unit_ArmadaShipArray[3]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts04), 0.00)
    set udg_Unit_ArmadaShipArray[4]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts05), 0.00)
    set udg_Unit_ArmadaShipArray[5]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts06), 0.00)
    set udg_Unit_ArmadaShipArray[6]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts07), 0.00)
    set udg_Unit_ArmadaShipArray[7]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts08), 0.00)
    set udg_Unit_ArmadaShipArray[8]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts09), 0.00)
    set udg_Unit_ArmadaShipArray[9]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts10), 0.00)
    set udg_Unit_ArmadaShipArray[10]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts11), 0.00)
    set udg_Unit_ArmadaShipArray[11]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'odes', Player(0), GetRectCenter(gg_rct_ArmadaShipStarts12), 0.00)
    set udg_Unit_ArmadaShipArray[12]=GetLastCreatedUnit()
    // //
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_ShipsMovement)
    // //
    // apply camera
    call CameraSetupApplyForPlayer(true, gg_cam_Final01, Player(0), 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // CinematicStarted
    call PlaySoundBJ(gg_snd_WC3OrcVictory)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundOnUnitBJ(gg_snd_AltarofDepthswhat1, 100, udg_Unit_OilRigFinalCin)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_OilRigFinalCin, "stand")
    call ShowUnitShow(udg_Unit_TankerFinalCin)
    call AddUnitAnimationPropertiesBJ(true, "gold", udg_Unit_TankerFinalCin)
    call UnitAddAbilityBJ('A62Y', udg_Unit_TankerFinalCin)
    call IssuePointOrderLocBJ(udg_Unit_TankerFinalCin, "move", GetRectCenter(gg_rct_FinalCinWharfBuilding))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final03, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc03Rend15) + 7.00 ))
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc03Rend15, bj_TIMETYPE_ADD, 0, true)
    // //
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(7.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

