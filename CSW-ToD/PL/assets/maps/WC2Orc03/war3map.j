function InitTrig_Intro_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Cleanup, function Trig_Intro_Cinematic_Cleanup_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic RendMovement
//===========================================================================
function Trig_Intro_Cinematic_RendMovement_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_RendMovement_Func011001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_RendMovement_Func020001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_RendMovement_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundBJ(gg_snd_CS_BG_Camp)
    call SetUnitMoveSpeed(udg_FakeRend, 300.00)
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_RendStart), GetRectCenter(gg_rct_RendCin01))
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_RendCin02))
    call IssuePointOrderLocBJ(udg_Unit_BlackToothGruntArray[1], "move", GetRectCenter(gg_rct_BlackTooh01Fire))
    call IssuePointOrderLocBJ(udg_Unit_BlackToothGruntArray[2], "move", GetRectCenter(gg_rct_BlackTooh02Fire))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, udg_Hero_Rend)
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeRend), GetRectCenter(gg_rct_RendCin02)) / GetUnitMoveSpeed(udg_FakeRend) ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_RendCin02B), GetRectCenter(gg_rct_RendCin03))
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeRend)
    call SetUnitMoveSpeed(udg_FakeRend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_RendCin03))
    call IssuePointOrderLocBJ(udg_SemiHero_Utok, "move", GetRectCenter(gg_rct_GruntCin01))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley2, 100, udg_SemiHero_Utok)
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeRend), GetRectCenter(gg_rct_RendCin03)) / GetUnitMoveSpeed(udg_FakeRend) ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingToFaceLocTimed(udg_SemiHero_Utok, GetRectCenter(gg_rct_RendCin03), 0.50)
    call SetUnitMoveSpeed(udg_FakeRend, GetUnitDefaultMoveSpeed(udg_FakeRend))
endfunction

