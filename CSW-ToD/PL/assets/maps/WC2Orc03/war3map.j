//===========================================================================
// Trigger: Intro Cinematic Setup
//===========================================================================
function Trig_Intro_Cinematic_Setup_Func004A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_CinNeutrals)
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01, Player(0), 0)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Intro_Cinematic_Setup_Func004A)
    call IssueTargetOrderBJ(gg_unit_o60D_0031, "harvest", gg_unit_n60M_0007)
    call IssueTargetOrderBJ(gg_unit_o60D_0030, "harvest", gg_unit_n60M_0007)
    call ShowUnitHide(gg_unit_o60O_0034)
    call ShowUnitHide(gg_unit_o60O_0033)
    call SetUnitOwner(udg_Hero_Zuljin, Player(2), true)
    call ShowUnitHide(udg_Hero_Rend)
    // //
    call CreateNUnitsAtLoc(1, 'ORbC', udg_Player_BTG, GetRectCenter(gg_rct_GruntCin01), 9.31)
    set udg_FakeRend=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'OZcN', udg_Player_Trolls, GetRectCenter(gg_rct_ZulJeenStart), 187.62)
    set udg_FakeZuljin=GetLastCreatedUnit()
    call SetUnitColor(udg_FakeZuljin, PLAYER_COLOR_CYAN)
    call ShowUnitHide(udg_FakeZuljin)
    // //
    // //
    call ShowUnitHide(udg_Hero_Zuljin)
    call ShowUnitHide(gg_unit_h60O_0093)
    // //
    // //
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.25)
    call SetUnitBlendTimeBJ(udg_Hero_Zuljin, 0.50)
    // //
    call SetUnitBlendTimeBJ(udg_SemiHero_Utok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_SemiHero_Utok)
    call SetUnitMoveSpeed(udg_SemiHero_Utok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_SemiHero_Utok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_BTG, GetRectCenter(gg_rct_BlackTooh01Start), bj_UNIT_FACING)
    set udg_Unit_BlackToothGruntArray[1]=GetLastCreatedUnit()
    call SetUnitMoveSpeed(udg_Unit_BlackToothGruntArray[1], 100.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_BlackToothGruntArray[1], UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_Unit_BlackToothGruntArray[1])
    // //
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_BTG, GetRectCenter(gg_rct_BlackTooh02Start), bj_UNIT_FACING)
    set udg_Unit_BlackToothGruntArray[2]=GetLastCreatedUnit()
    call SetUnitMoveSpeed(udg_Unit_BlackToothGruntArray[2], 100.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_BlackToothGruntArray[2], UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_Unit_BlackToothGruntArray[2])
    // //
    set udg_Unit_IntroFakeBoat=gg_unit_hFrK_0151
    call SetUnitMoveSpeed(udg_Unit_IntroFakeBoat, 100.00)
    call SetUnitColor(udg_Unit_IntroFakeBoat, PLAYER_COLOR_BLUE)
    // //
    call SetTerrainFogExBJ(0, 1000, 4500.00, 0, 34.00, 49.00, 52.00)
endfunction

