//===========================================================================
// Trigger: Intro Cinematic Skipped
//===========================================================================
function Trig_Intro_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    set udg_Bool_CinematicSkipped=true
    set udg_Bool_CinIntroOn=false
    call StopSoundBJ(gg_snd_OrcCinematicThemeA, false)
    call StopSoundBJ(gg_snd_WC2Orc03Rend1, false)
    call StopSoundBJ(gg_snd_WC2Orc03Rend2, false)
    call StopSoundBJ(gg_snd_WC2Orc03Rend3, false)
    call StopSoundBJ(gg_snd_WC2Orc03Rend4, false)
    call StopSoundBJ(gg_snd_WC2Orc03Rend5, false)
    call StopSoundBJ(gg_snd_WC2Orc03Rend6, false)
    call StopSoundBJ(gg_snd_WC2Orc03Rend7, false)
    call StopSoundBJ(gg_snd_WC2Orc03Rend8, false)
    call StopSoundBJ(gg_snd_WC2Orc03Rend9, false)
    call StopSoundBJ(gg_snd_WC2Orc03ZulJin1, false)
    call StopSoundBJ(gg_snd_WC2Orc03ZulJin2, false)
    call StopSoundBJ(gg_snd_WC2Orc03ZulJin3, false)
    call StopSoundBJ(gg_snd_WC2Orc03Utok1, false)
    call StopSoundBJ(gg_snd_WC2Orc03Utok2, false)
    call StopSoundBJ(gg_snd_WC2Orc03Utok3, false)
    call StopSoundBJ(gg_snd_WC2Orc03Utok4, false)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Intro_Cinematic_Skipped, Condition(function Trig_Intro_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_Skipped, function Trig_Intro_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Cleanup
//===========================================================================
function Trig_Intro_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func028A takes nothing returns nothing
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_CinNeutrals)
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_Cleanup_Func056C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinIntroOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call RemoveUnit(udg_FakeRend)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_RendCin04), GetRectCenter(gg_rct_ZulJeen))
    call ShowUnitShow(udg_Hero_Rend)
    call ShowUnitShow(gg_unit_o60O_0034)
    call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_GruntCin02), GetRectCenter(gg_rct_ZulJeen))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60O_0034, GetRectCenter(gg_rct_TrollCin03), GetRectCenter(gg_rct_ZulJeen))
    call ShowUnitShow(gg_unit_o60O_0033)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60O_0033, GetRectCenter(gg_rct_TrollCin02), GetRectCenter(gg_rct_ZulJeen))
    call RemoveUnit(udg_FakeZuljin)
    call ShowUnitShow(udg_Hero_Zuljin)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Zuljin, GetRectCenter(gg_rct_ZulJeen), GetRectCenter(gg_rct_RendCin04))
    call RemoveUnit(udg_Unit_ElfAmbush)
    call RemoveUnit(gg_unit_h60O_0093)
    call RemoveUnit(udg_Unit_BlackToothGruntArray[1])
    call RemoveUnit(udg_Unit_BlackToothGruntArray[2])
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o619', Player(20), GetRectCenter(gg_rct_BlackTooh01Killed), 0.00)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o619', Player(20), GetRectCenter(gg_rct_BlackTooh02Killed), 0.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GameCamera, udg_Player_Actual, 0)
    call TriggerSleepAction(0.50)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_GameCamera), 0)
    // //
    call ForGroupBJ(udg_Group_CinNeutrals, function Trig_Intro_Cinematic_Cleanup_Func028A)
    // //
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_Wallpaper)
    call TriggerExecute(gg_trg_DawnFogLoop)
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', false, false)
    call RemoveUnit(udg_Unit_IntroFakeBoat)
    call IssuePointOrderLocBJ(gg_unit_h600_0070, "move", GetRectCenter(gg_rct_OilSplat05))
    call IssuePointOrderLocBJ(gg_unit_h600_0071, "move", GetRectCenter(gg_rct_OilSplat04))
    call RemoveUnit(udg_FakeRend)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_RendCin04), GetRectCenter(gg_rct_ZulJeen))
    call ShowUnitShow(udg_Hero_Rend)
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", udg_SemiHero_Utok)
    call ResetUnitAnimation(udg_Hero_Zuljin)
    call ResetUnitLookAt(udg_Hero_Zuljin)
    call SetUnitMoveSpeed(udg_SemiHero_Utok, 270.00)
    call BlzSetUnitRealFieldBJ(udg_SemiHero_Utok, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call SetUnitBlendTimeBJ(udg_SemiHero_Utok, 0.15)
    call SetUnitBlendTimeBJ(udg_Hero_Zuljin, 0.15)
    // //
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 450)
    // //
    call ConditionalTriggerExecute(gg_trg_SetUpOilPatches)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilTextShow)
    call SelectUnitForPlayerSingle(udg_Hero_Rend, Player(0))
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func056C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Armada_Discover)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

