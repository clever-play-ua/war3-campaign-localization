function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    // //
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ConditionalTriggerExecute(gg_trg_OilTextHide)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call CinematicModeBJ(true, GetPlayersAll())
    call TriggerSleepAction(0.50)
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Setup)
    // //
    call PlaySoundBJ(gg_snd_OrcCinematicThemeA)
    call SetSoundVolumeBJ(gg_snd_OrcCinematicThemeA, 60.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinIntroOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    // OrcCamp
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Talk01, Player(0), 11.00, 4.00, 1.00, 100.00)
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_RendMovement)
    loop
        exitwhen ( (RectContainsUnit(gg_rct_GruntCin01, udg_SemiHero_Utok) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_IntroSpeech)
    call TriggerSleepAction(4.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Talk02, Player(0), ( 1 + ( GetSoundDurationBJ(gg_snd_WC2Orc03Utok1) + ( GetSoundDurationBJ(gg_snd_WC2Orc03Rend1) + ( GetSoundDurationBJ(gg_snd_WC2Orc03Rend2) + ( 1 + ( GetSoundDurationBJ(gg_snd_WC2Orc03Rend3) + GetSoundDurationBJ(gg_snd_WC2Orc03Rend4) ) ) ) ) ) ))
    // //
    call TriggerSleepAction(( 0.00 + ( GetSoundDurationBJ(gg_snd_WC2Orc03Utok1) + ( GetSoundDurationBJ(gg_snd_WC2Orc03Rend1) + ( GetSoundDurationBJ(gg_snd_WC2Orc03Rend2) + ( GetSoundDurationBJ(gg_snd_WC2Orc03Rend3) + GetSoundDurationBJ(gg_snd_WC2Orc03Rend4) ) ) ) ) ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // OilPatch
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_OilPatch01, Player(0), 0.00)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_OilPatch02, Player(0), 5.00, 0, 1.00, 100.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundAtPointBJ(gg_snd_DenOfShadowsWhat1, 100.00, GetRectCenter(gg_rct_OilSplat01), 150.00)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPathing(udg_Unit_IntroFakeBoat, false)
    call IssuePointOrderLocBJ(udg_Unit_IntroFakeBoat, "move", GetRectCenter(gg_rct_FakeElfBoatTarget))
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitMoveSpeed(udg_FakeRend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitPathing(udg_FakeRend, false)
    call IssuePointOrderLocBJ(udg_Unit_BlackToothGruntArray[1], "move", GetRectCenter(gg_rct_BlackTooh01Killed))
    call IssuePointOrderLocBJ(udg_Unit_BlackToothGruntArray[2], "move", GetRectCenter(gg_rct_BlackTooh02Killed))
    call IssuePointOrderLocBJ(udg_SemiHero_Utok, "move", GetRectCenter(gg_rct_GruntCin02))
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_RendCin04))
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Talk02, Player(0), 0.00)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Talk04B, Player(0), 5.00, 0, 1.00, 100.00)
    // //
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_CS_BG_Camp)
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    // //
    // Approaching ambush
    // //
    // OrcCamp
    // //
    loop
        exitwhen ( (udg_Bool_IntroUtokDone == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // ElvenSpy
    // //
    call PlaySoundOnUnitBJ(gg_snd_FreakyForest1, 100, gg_unit_h60O_0093)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Elves01B, Player(0), 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeRend, gg_unit_h60O_0093, 0.50)
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc03Rend7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Elves02B, Player(0), 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PlaySoundOnUnitBJ(gg_snd_FreakyForest101, 100, gg_unit_h60O_0093)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceLocTimed(udg_SemiHero_Utok, GetRectCenter(gg_rct_ElvenAmbush), 0.25)
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_SemiHero_Utok, 0, gg_snd_WC2Orc03Utok4, bj_TIMETYPE_ADD, 0, false)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // TrollsHelp
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeZuljin, GetRectCenter(gg_rct_ZulJeenStart), GetRectCenter(gg_rct_ElvenAmbush))
    call ShowUnitShow(gg_unit_o60O_0034)
    call ShowUnitShow(gg_unit_o60O_0033)
    call ShowUnitShow(udg_FakeZuljin)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Trolls01B, Player(0), 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call IssuePointOrderLocBJ(udg_FakeZuljin, "move", GetRectCenter(gg_rct_ZulJeen))
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ShowUnitShow(gg_unit_h60O_0093)
    call SetUnitColor(gg_unit_h60O_0093, PLAYER_COLOR_LIGHT_BLUE)
    call SetUnitVertexColorBJ(gg_unit_h60O_0093, 100, 100, 100, 35.00)
    call PlaySoundOnUnitBJ(gg_snd_ShadowMeld1, 100, gg_unit_h60O_0093)
    call AddSpecialEffectTargetUnitBJ("origin", gg_unit_h60O_0093, "Abilities\\Spells\\Undead\\Sleep\\SleepSpecialArt.mdl")
    call SetUnitTimeScalePercent(gg_unit_h60O_0093, 10.00)
    call SetUnitAnimation(gg_unit_h60O_0093, "Attack -2")
    // //
    call IssuePointOrderLocBJ(gg_unit_o60O_0034, "move", GetRectCenter(gg_rct_TrollCin03))
    call IssuePointOrderLocBJ(gg_unit_o60O_0033, "move", GetRectCenter(gg_rct_TrollCin02))
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Trolls02B, Player(0), 3.00, 0, 0.50, 100.00)
    // //
    call SetUnitAnimation(udg_FakeRend, "stand ready")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeZuljin, 0, gg_snd_WC2Orc03ZulJin1, bj_TIMETYPE_ADD, 0, false)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // KillingSpy
    // //
    call SetUnitTimeScalePercent(gg_unit_h60O_0093, 100.00)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call IssueTargetOrderBJ(gg_unit_h60O_0093, "attack", udg_Unit_BlackToothGruntArray[1])
    call IssueTargetOrderBJ(udg_FakeZuljin, "attack", gg_unit_h60O_0093)
    call SetUnitFacingToFaceUnitTimed(udg_FakeRend, udg_FakeZuljin, 0.50)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillUnit(udg_Unit_BlackToothGruntArray[1])
    call KillUnit(gg_unit_h60O_0093)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // AnotherSpy
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h60O', Player(0), GetRectCenter(gg_rct_ElvenAmbush), GetRectCenter(gg_rct_ZulJeen))
    set udg_Unit_ElfAmbush=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_ElfAmbush, PLAYER_COLOR_LIGHT_BLUE)
    call SetUnitVertexColorBJ(udg_Unit_ElfAmbush, 100, 100, 100, 35.00)
    call IssueTargetOrderBJ(udg_Unit_ElfAmbush, "attack", udg_Unit_BlackToothGruntArray[2])
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_SemiHero_Utok, "Cinematic Point One")
    call QueueUnitAnimationBJ(udg_SemiHero_Utok, "Cinematic Listening One")
    // //
    call SetUnitFacingToFaceLocTimed(udg_FakeZuljin, GetRectCenter(gg_rct_ElvenAmbush), 0.50)
    call IssueTargetOrderBJ(gg_unit_o60O_0034, "attack", udg_Unit_ElfAmbush)
    call IssueTargetOrderBJ(gg_unit_o60O_0033, "attack", udg_Unit_ElfAmbush)
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Hero_Rend, "Cinematic Listening One")
    call KillUnit(udg_Unit_BlackToothGruntArray[2])
    call KillUnit(udg_Unit_ElfAmbush)
    // //
    // Talking
    // //
    call SetUnitFacingToFaceLocTimed(udg_FakeZuljin, GetRectCenter(gg_rct_RendCin04), 0.25)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Trolls03, Player(0), 0.00)
    // //
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeRend, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc03Rend8, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeRend, "Cinematic Listening One")
    // //
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Standard One")
    call SetUnitLookAt(udg_FakeZuljin, "bone_head", udg_FakeRend, 0, 0, 90)
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeZuljin, 0, gg_snd_WC2Orc03ZulJin2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_GameCamera, Player(0), ( GetSoundDurationBJ(gg_snd_WC2Orc03ZulJin3) + ( GetSoundDurationBJ(gg_snd_WC2Orc03Rend9) + 2.00 ) ), 0, 1.00, 100.00)
    // //
    call SetUnitAnimation(udg_FakeZuljin, "cinematic angry one")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeZuljin, 0, gg_snd_WC2Orc03ZulJin3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeRend, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc03Rend9, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeRend, "Cinematic Listening One")
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ResetUnitAnimation(udg_FakeZuljin)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_OrcCinematicThemeA, true)
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

