    set gg_trg_On_screen=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_On_screen, Player(0), "On screen", true)
    call TriggerAddAction(gg_trg_On_screen, function Trig_On_screen_Actions)
endfunction

