function InitTrig_AI_P04_Oil takes nothing returns nothing
    set gg_trg_AI_P04_Oil=CreateTrigger()
    call DisableTrigger(gg_trg_AI_P04_Oil)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_AI_P04_Oil, udg_Timer_P04OilChecker)
    call TriggerAddAction(gg_trg_AI_P04_Oil, function Trig_AI_P04_Oil_Actions)
endfunction

