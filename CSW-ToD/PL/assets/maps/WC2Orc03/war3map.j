endfunction

//===========================================================================
// Trigger: OilWar Completed
//===========================================================================
function Trig_OilWar_Completed_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'o61C' ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilWar_Completed_Func002001 takes nothing returns boolean
    return ( IsQuestDiscovered(udg_OQ_OilWars) == true )
endfunction

function Trig_OilWar_Completed_Func019C takes nothing returns boolean
    if ( not ( udg_Int_RefineriesRemaining == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilWar_Completed_Actions takes nothing returns nothing
    local integer P04Oil
    loop
        exitwhen ( (IsQuestDiscovered(udg_OQ_OilWars) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    // //
    set P04Oil=( (OilHarvest___playerOil[GetPlayerId((Player(3)))]) / 8 ) // INLINED!!
    call playerAddOil(Player(0) , P04Oil)
    call playerAddOil(Player(3) , - P04Oil)
    // //
    set udg_AI_P04_Oil=P04Oil
    // //
    set udg_Int_RefineriesRemaining=( udg_Int_RefineriesRemaining - 1 )
    // //
    call LeaderboardSetPlayerItemValueBJ(Player(2), udg_Leaderboard_QuestObjectives, udg_Int_RefineriesRemaining)
    // //
    call QueuedTriggerAddBJ(gg_trg_OilWar_Completed_Q1, true)
    // //
    if ( Trig_OilWar_Completed_Func019C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call LeaderboardRemovePlayerItemBJ(Player(2), udg_Leaderboard_QuestObjectives)
        call ConditionalTriggerExecute(gg_trg_QuestBoardStatusCheck)
        call QueuedTriggerAddBJ(gg_trg_OilWar_Completed_Q2, true)
        call QueuedTriggerAddBJ(gg_trg_UtokLevelUpChecker, true)
    else
    endif
    // //
endfunction

