//===========================================================================
// Trigger: AI P04 Naval Start
//===========================================================================
function Trig_AI_P04_Naval_Start_Func006Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P04_Naval_Start_Func006C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P04_Naval_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerStateBJ(udg_Player_AllianceNavy, PLAYER_STATE_RESOURCE_GOLD, 10000)
    call SetPlayerStateBJ(udg_Player_AllianceNavy, PLAYER_STATE_RESOURCE_LUMBER, 10000)
    call SetPlayerStateBJ(udg_Player_AllianceNavy, PLAYER_STATE_RESOURCE_FOOD_CAP, ( GetPlayerState(udg_Player_AllianceNavy, PLAYER_STATE_RESOURCE_FOOD_CAP) + 100 ))
    // //
    if ( Trig_AI_P04_Naval_Start_Func006C() ) then
        call playerAddOil(Player(3) , 20000)
    else
        if ( Trig_AI_P04_Naval_Start_Func006Func003C() ) then
            call playerAddOil(Player(3) , 17500)
        else
            call playerAddOil(Player(3) , 15000)
        endif
    endif
    // //
    call EnableTrigger(gg_trg_AI_P04_Gold)
    call EnableTrigger(gg_trg_AI_P04_Lumber)
    call EnableTrigger(gg_trg_AI_P04_Oil)
    // //
    call StartCampaignAI(udg_Player_AllianceNavy, "CSW\\Scripts\\ToDScripts\\WC2Orc03\\WC2Orc03P04AllianceNavalAI.ai")
    // //
    call IssueTargetOrderBJ(gg_unit_h600_0019, "smart", gg_unit_u600_0005)
    call IssueTargetOrderBJ(gg_unit_h600_0071, "smart", gg_unit_u600_0005)
    // //
    call IssueTargetOrderBJ(gg_unit_h600_0069, "smart", gg_unit_u600_0026)
    call IssueTargetOrderBJ(gg_unit_h600_0070, "smart", gg_unit_u600_0026)
    // //
    call StartTimerBJ(udg_Timer_P04OilChecker, true, 1.00)
endfunction

//===========================================================================
function InitTrig_AI_P04_Naval_Start takes nothing returns nothing
    set gg_trg_AI_P04_Naval_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_P04_Naval_Start, function Trig_AI_P04_Naval_Start_Actions)
endfunction

