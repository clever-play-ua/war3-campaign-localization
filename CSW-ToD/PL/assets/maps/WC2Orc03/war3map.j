    call TriggerAddCondition(gg_trg_OilWar_Discover, Condition(function Trig_OilWar_Discover_Conditions))
    call TriggerAddAction(gg_trg_OilWar_Discover, function Trig_OilWar_Discover_Actions)
endfunction

//===========================================================================
// Trigger: OilWar Discover Q
//===========================================================================
function Trig_OilWar_Discover_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], Player(12), 'o605', GetCameraTargetPositionLoc(), gg_snd_WC2Orc03Utok7, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], Player(20), 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc03Rend13, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestSetDiscoveredBJ(udg_OQ_OilWars, true)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2436")
    // //
    call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_QuestObjectives, udg_Oil)
    // //
    call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_QuestObjectives, udg_Oil)
    call LeaderboardAddItemBJ(Player(2), udg_Leaderboard_QuestObjectives, "TRIGSTR_2760", udg_Int_RefineriesRemaining)
    call LeaderboardSetPlayerItemStyleBJ(Player(2), udg_Leaderboard_QuestObjectives, true, true, false)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(2), udg_Leaderboard_QuestObjectives, 100, 80, 20, 0)
    call LeaderboardSetPlayerItemValueColorBJ(Player(2), udg_Leaderboard_QuestObjectives, 100, 80, 20, 0)
    call ConditionalTriggerExecute(gg_trg_QuestBoardStatusCheck)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

