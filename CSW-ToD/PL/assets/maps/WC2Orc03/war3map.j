//===========================================================================
// Trigger: Load Rend
//===========================================================================
function Trig_Load_Rend_Func005C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc02", udg_Cache) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Rend_Actions takes nothing returns nothing
    call RestoreUnitLocFacingPointBJ("Rend", "WC2Orc02", udg_Cache, Player(0), GetRectCenter(gg_rct_GruntCin01), GetRectCenter(gg_rct_ZulJeen))
    set udg_Hero_Rend=GetLastRestoredUnitBJ()
    call SetUnitColor(udg_Hero_Rend, PLAYER_COLOR_COAL)
    // //
    if ( Trig_Load_Rend_Func005C() ) then
        call CreateNUnitsAtLocFacingLocBJ(1, 'O617', Player(0), GetRectCenter(gg_rct_GruntCin01), GetRectCenter(gg_rct_ZulJeen))
        set udg_Hero_Rend=GetLastCreatedUnit()
        call SetHeroLevelBJ(udg_Hero_Rend, 3, false)
        call SetUnitColor(udg_Hero_Rend, PLAYER_COLOR_COAL)
        call SelectHeroSkill(udg_Hero_Rend, 'AR9Q')
        call SelectHeroSkill(udg_Hero_Rend, 'A00O')
        call SelectHeroSkill(udg_Hero_Rend, 'A00N')
        call UnitAddItemByIdSwapped('I60B', udg_Hero_Rend)
    else
    endif
    // //
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, false)
    // //
endfunction

//===========================================================================
function InitTrig_Load_Rend takes nothing returns nothing
    set gg_trg_Load_Rend=CreateTrigger()
    call TriggerAddAction(gg_trg_Load_Rend, function Trig_Load_Rend_Actions)
endfunction

