    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc02", udg_Cache) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Utok_Actions takes nothing returns nothing
    if ( Trig_Load_Utok_Func001C() ) then
        set udg_SemiHero_Utok=gg_unit_o605_0032
        call SetPlayerTechResearchedSwap('RUX2', 2, Player(0))
    else
        call RemoveUnit(gg_unit_o605_0032)
        call SetPlayerTechResearchedSwap('RUX2', GetStoredIntegerBJ("UtokLevel", "WC2Orc02", udg_Cache), Player(0))
        call RestoreUnitLocFacingPointBJ("Utok", "WC2Orc02", udg_Cache, Player(0), GetRectCenter(gg_rct_UtokLoad), GetRectCenter(gg_rct_GruntCin01))
        set udg_SemiHero_Utok=GetLastRestoredUnitBJ()
    endif
endfunction

