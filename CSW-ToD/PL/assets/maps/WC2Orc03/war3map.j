function InitTrig_Armada_Ping takes nothing returns nothing
    set gg_trg_Armada_Ping=CreateTrigger()
    call TriggerAddCondition(gg_trg_Armada_Ping, Condition(function Trig_Armada_Ping_Conditions))
    call TriggerAddAction(gg_trg_Armada_Ping, function Trig_Armada_Ping_Actions)
endfunction

