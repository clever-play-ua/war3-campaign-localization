function InitTrig_Final_Cinematic_Q takes nothing returns nothing
    set gg_trg_Final_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Final_Cinematic_Q, function Trig_Final_Cinematic_Q_Actions)
endfunction

