    set gg_trg_OilWar_Completed=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OilWar_Completed, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_OilWar_Completed, Condition(function Trig_OilWar_Completed_Conditions))
    call TriggerAddAction(gg_trg_OilWar_Completed, function Trig_OilWar_Completed_Actions)
