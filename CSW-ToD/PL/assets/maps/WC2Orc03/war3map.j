//===========================================================================
// Trigger: Armada Update2 Q
//===========================================================================
function Trig_Armada_Update2_Q_Func006C takes nothing returns boolean
    if ( not ( udg_Int_MQArmada_PlatformsBuild < 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Update2_Q_Func008C takes nothing returns boolean
    if ( not ( udg_PlayerOil < udg_Int_QuestOilTargetAmount ) ) then
        return false
    endif
    return true
endfunction

function Trig_Armada_Update2_Q_Actions takes nothing returns nothing
    set udg_newLine="\n"
    set udg_String_CompletedQuests=( BlzGetItemDescription(gg_item_IQL1_0148) + ( udg_newLine + BlzGetItemDescription(gg_item_IQL0_0149) ) )
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL2_0144) ) )
    if ( Trig_Armada_Update2_Q_Func006C() ) then
        call QuestItemSetDescriptionBJ(udg_QReq_Armada_BuildOilPlatform, ( "Zbuduj platformy wiertnicze (wzniesiono " + ( I2S(udg_Int_MQArmada_PlatformsBuild) + GetItemName(gg_item_IQL0_0149) ) ))
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL0_0149) + ( I2S(udg_Int_MQArmada_PlatformsBuild) + GetItemName(gg_item_IQL0_0149) ) ) ) )
    else
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=4
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call DestroyMinimapIcon(udg_MinimapIcon_OilPatches_Array[GetForLoopIndexA()])
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call QuestItemSetDescriptionBJ(udg_QReq_Armada_BuildOilPlatform, "TRIGSTR_2644")
        call QuestItemSetCompletedBJ(udg_QReq_Armada_BuildOilPlatform, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL2_0144) ) )
    endif
    set udg_PlayerOil=(OilHarvest___playerOil[GetPlayerId((Player(0)))]) // INLINED!!
    if ( Trig_Armada_Update2_Q_Func008C() ) then
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL1_0148) + ( udg_String_QuestOilWarsAmountText + BlzGetItemTooltip(gg_item_IQL1_0148) ) ) ) )
    else
        call QuestItemSetCompletedBJ(udg_QReq_Armada_GatherOil, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL2_0144) + ( udg_String_QuestOilWarsAmountText + BlzGetItemDescription(gg_item_IQL2_0144) ) ) ) )
    endif
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

