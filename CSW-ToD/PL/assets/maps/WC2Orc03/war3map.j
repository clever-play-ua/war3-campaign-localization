function Trig_Init_04_Environment_Actions takes nothing returns nothing
    call MeleeStartingVisibility()
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_WallpaperOutro)
    call AddSpecialEffectTargetUnitBJ("overhead", gg_unit_nvil_0000, "Abilities\\Spells\\Other\\StrongDrink\\BrewmasterTarget.mdl")
    call EnumDestructablesInRectAll(gg_rct_OilBarrels01, function Trig_Init_04_Environment_Func004002)
    call EnumDestructablesInRectAll(gg_rct_OilBarrels02, function Trig_Init_04_Environment_Func005002)
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    set udg_FogMin=3000.00
    set udg_FogMax=12500.00
    call SetTerrainFogExBJ(0, udg_FogMin, udg_FogMax, 0.20, 21.56, 49.00, 68.00)
    call SetDoodadAnimationRectBJ("death", 'D000', GetPlayableMapRect())
    call SetItemVisibleBJ(false, gg_item_IQL2_0144)
    call SetItemVisibleBJ(false, gg_item_IQL1_0148)
    call SetItemVisibleBJ(false, gg_item_IQL0_0149)
    call SetItemVisibleBJ(false, gg_item_IQL3_0150)
