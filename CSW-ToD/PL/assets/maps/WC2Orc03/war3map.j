    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_FreeOilPatches)
endfunction

function Trig_Armada_Defeat_NoOil_Func006001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'u002' )
endfunction

function Trig_Armada_Defeat_NoOil_Func006001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Armada_Defeat_NoOil_Func006001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'u002'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

