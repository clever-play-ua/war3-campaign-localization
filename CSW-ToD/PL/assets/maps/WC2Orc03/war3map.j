function CreateAllDestructables takes nothing returns nothing
    local destructable d
    local trigger t
    local real life
    set gg_dest_B001_0956=BlzCreateDestructableWithSkin('B001', 4352.0, - 4384.0, 270.000, 1.276, 0, 'B001')
    set d=BlzCreateDestructableWithSkin('LTcr', 4352.0, - 5312.0, 192.548, 0.907, 1, 'LTcr')
    set t=CreateTrigger()
    call TriggerRegisterDeathEvent(t, d)
    call TriggerAddAction(t, function SaveDyingWidget)
    call TriggerAddAction(t, function Doodad003833_DropItems)
    set d=BlzCreateDestructableWithSkin('LTcr', - 5760.0, - 1472.0, 2.986, 0.907, 1, 'LTcr')
    set t=CreateTrigger()
    call TriggerRegisterDeathEvent(t, d)
    call TriggerAddAction(t, function SaveDyingWidget)
    call TriggerAddAction(t, function Doodad003832_DropItems)
endfunction

