//===========================================================================
// Trigger: AI P04 Defeated
//===========================================================================
function Trig_AI_P04_Defeated_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_AllianceNavy ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P04_Defeated_Func009001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60X' )
endfunction

function Trig_AI_P04_Defeated_Func009001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P04_Defeated_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h60X'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P04_Defeated_Func009A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P04Shipyards)
endfunction

function Trig_AI_P04_Defeated_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P04Shipyards) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P04_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_P04Shipyards)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_AllianceNavy, Condition(function Trig_AI_P04_Defeated_Func009001002)), function Trig_AI_P04_Defeated_Func009A)
    // //
    if ( Trig_AI_P04_Defeated_Func011C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_AI_P04_Gold)
        call DisableTrigger(gg_trg_AI_P04_Lumber)
        call TriggerExecute(gg_trg_AI_P04_Stop_Attack_Command)
        call PolledWait(2)
        call TriggerExecute(gg_trg_AI_P04_Defeat_Command)
    else
    endif
    // //
    call GroupClear(udg_Group_P04Shipyards)
    // //
endfunction

//===========================================================================
function InitTrig_AI_P04_Defeated takes nothing returns nothing
    set gg_trg_AI_P04_Defeated=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AI_P04_Defeated, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AI_P04_Defeated, Condition(function Trig_AI_P04_Defeated_Conditions))
    call TriggerAddAction(gg_trg_AI_P04_Defeated, function Trig_AI_P04_Defeated_Actions)
endfunction

