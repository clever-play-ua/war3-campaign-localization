//===========================================================================
function Trig_AI_P02_Ground_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerStateBJ(udg_Player_Alliance, PLAYER_STATE_RESOURCE_GOLD, 10000)
    call SetPlayerStateBJ(udg_Player_Alliance, PLAYER_STATE_RESOURCE_LUMBER, 10000)
    call SetPlayerStateBJ(udg_Player_Alliance, PLAYER_STATE_RESOURCE_FOOD_CAP, ( GetPlayerState(udg_Player_Alliance, PLAYER_STATE_RESOURCE_FOOD_CAP) + 100 ))
    // //
    call EnableTrigger(gg_trg_AI_P02_Gold)
    call EnableTrigger(gg_trg_AI_P02_Lumber)
    // //
    call StartCampaignAI(udg_Player_Alliance, "CSW\\Scripts\\ToDScripts\\WC2Orc03\\WC2Orc03P02AllianceAI.ai")
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P02_Start_Attack_Command)
    // //
endfunction

