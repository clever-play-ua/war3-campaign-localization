function InitTrig_Landing_UpdateCompleted_Q takes nothing returns nothing
    set gg_trg_Landing_UpdateCompleted_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Landing_UpdateCompleted_Q, function Trig_Landing_UpdateCompleted_Q_Actions)
endfunction

