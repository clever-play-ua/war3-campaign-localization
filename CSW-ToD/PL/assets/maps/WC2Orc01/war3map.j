//===========================================================================
function InitTrig_Fuel_Discover takes nothing returns nothing
    set gg_trg_Fuel_Discover=CreateTrigger()
    call TriggerAddAction(gg_trg_Fuel_Discover, function Trig_Fuel_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Fuel Discover Q
//===========================================================================
function Trig_Fuel_Discover_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_BTG, 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc01Rend6, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestSetDiscoveredBJ(udg_MQ_Fuel, true)
    // //
    call CreateQuestItemBJ(udg_MQ_Fuel, ( BlzGetItemDescription(gg_item_IQL6_0084) + ( udg_String_FuelRequiredGoldText + BlzGetItemDescription(gg_item_IQL3_0064) ) ))
    // //
    set udg_MQReq_Fuel_GatherGold=GetLastCreatedQuestItemBJ()
    // //
    call CreateQuestItemBJ(udg_MQ_Fuel, ( GetItemName(gg_item_IQL6_0084) + ( udg_String_FuelRequiredLumberText + BlzGetItemDescription(gg_item_IQL4_0065) ) ))
    // //
    set udg_MQReq_Fuel_HarvestLumber=GetLastCreatedQuestItemBJ()
    set udg_newLine="\n"
    // //
    set udg_String_CompletedQuests=( GetItemName(gg_item_IQL3_0064) + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL3_0064) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL3_0064) + ( udg_String_FuelRequiredGoldText + BlzGetItemDescription(gg_item_IQL3_0064) ) ) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL4_0065) + ( udg_String_FuelRequiredLumberText + BlzGetItemDescription(gg_item_IQL4_0065) ) ) ) )
    // //
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_DISCOVERED, udg_String_CompletedQuests)
    // //
    call LeaderboardAddItemBJ(Player(1), udg_Leaderboard_QuestObjectives, "TRIGSTR_2289", udg_Int_QuestFuel_GoldStash)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(1), udg_Leaderboard_QuestObjectives, 100.00, 80.00, 0.00, 0)
    call LeaderboardSetPlayerItemValueColorBJ(Player(1), udg_Leaderboard_QuestObjectives, 100.00, 100.00, 100.00, 0)
    // //
    call LeaderboardAddItemBJ(Player(2), udg_Leaderboard_QuestObjectives, "TRIGSTR_2290", udg_Int_QuestFuel_LumberStash)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(2), udg_Leaderboard_QuestObjectives, 100.00, 80.00, 0.00, 0)
    call LeaderboardSetPlayerItemValueColorBJ(Player(2), udg_Leaderboard_QuestObjectives, 100.00, 100.00, 100.00, 0)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call PanCameraToTimedLocForPlayer(udg_Actual_Player, GetRectCenter(gg_rct_Supply_Crates), 1.00)
    call TriggerSleepAction(1.00)
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_2291")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

