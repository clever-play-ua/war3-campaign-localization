//===========================================================================
// Trigger: First SignalFire TimerExpires
//===========================================================================
function Trig_First_SignalFire_TimerExpires_Func002C takes nothing returns boolean
    if ( not ( IsQuestItemCompleted(udg_MQReq_FirstBlood_PutOutSignal) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_SignalFire_TimerExpires_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_First_SignalFire_TimerExpires_Func002C() ) then
        call DisableTrigger(gg_trg_First_Update_SignalFire)
        call DestroyTimerDialogBJ(udg_Timerwindow)
        call QuestItemSetDescriptionBJ(udg_MQReq_FirstBlood_PutOutSignal, "TRIGSTR_2385")
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "TRIGSTR_2305")
        set udg_Bool_PutFireFailed=true
        // //
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=udg_Int_AdditionalFootman
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call CreateNUnitsAtLoc(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_SpwanFootman01), bj_UNIT_FACING)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_WolvesAttackAnchor)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        // //
        set bj_forLoopBIndex=1
        set bj_forLoopBIndexEnd=udg_Int_AdditionalFootman
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call CreateNUnitsAtLoc(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_SpwanFootman02), bj_UNIT_FACING)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_WolvesAttackAnchor)
            set bj_forLoopBIndex=bj_forLoopBIndex + 1
        endloop
        // //
    else
    endif
endfunction

