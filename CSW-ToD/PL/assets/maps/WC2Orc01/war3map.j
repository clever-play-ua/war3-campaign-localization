        return false
    endif
    if ( not ( GetOwningPlayer(GetConstructedStructure()) == udg_Actual_Player ) ) then
        return false
    endif
    return true
endfunction

function Trig_Landing_Update_Barracks_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
