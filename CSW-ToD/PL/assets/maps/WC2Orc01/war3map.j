    call SetPlayerUnitAvailableBJ('o60T', false, udg_Actual_Player)
    call SetPlayerUnitAvailableBJ('o60O', false, udg_Actual_Player)
    call SetPlayerUnitAvailableBJ('o60W', false, udg_Actual_Player)
    call SetPlayerUnitAvailableBJ('o60Z', false, udg_Actual_Player)
    call SetPlayerUnitAvailableBJ('o60P', false, udg_Actual_Player)
    // //
    call SetPlayerStateBJ(udg_Actual_Player, PLAYER_STATE_RESOURCE_GOLD, 100)
    call SetPlayerStateBJ(udg_Actual_Player, PLAYER_STATE_RESOURCE_LUMBER, 150)
    call SetPlayerHandicapXPBJ(udg_Actual_Player, 15.00)
    // //
    call SetPlayerStateBJ(udg_Player_Humans, PLAYER_STATE_RESOURCE_LUMBER, 1000)
    call SetPlayerStateBJ(udg_Player_Humans, PLAYER_STATE_RESOURCE_GOLD, 1000)
    // //
    // Alliances
    // //
    call SetPlayerAllianceStateBJ(udg_Actual_Player, udg_Player_Wolves, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Wolves, udg_Actual_Player, bj_ALLIANCE_UNALLIED)
    // //
    // //
    call SetPlayerAllianceStateBJ(udg_Actual_Player, udg_Player_BTG, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Actual_Player, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player_CinematicOrcs, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_CinematicOrcs, udg_Player_BTG, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_CinematicOrcs, udg_Actual_Player, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Actual_Player, udg_Player_CinematicOrcs, bj_ALLIANCE_ALLIED_VISION)
    // //
    call EnableCreepSleepBJ(false)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_06a_Hard)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Normal)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Easy)
    // //
endfunction

