// Trigger: GenericCinematicPrepOut
//===========================================================================
function Trig_GenericCinematicPrepOut_Func009002 takes nothing returns nothing
    call SetItemVisibleBJ(true, GetEnumItem())
endfunction

function Trig_GenericCinematicPrepOut_Actions takes nothing returns nothing
    call SelectGroupForPlayerBJ(udg_Group_Selection, udg_Actual_Player)
    call GroupClear(udg_Group_Selection)
    // //
    call CameraSetupApplyForPlayer(true, udg_VarCurrentCamera, udg_Actual_Player, 0.00)
    // //
    // //
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', false, false)
    // //
    call EnumItemsInRectBJ(GetPlayableMapRect(), function Trig_GenericCinematicPrepOut_Func009002)
    call ConditionalTriggerExecute(gg_trg_OilTextShow)
