function Trig_Humans_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinHumansOn=false
    // //
    // Fade Faster If Cinematic Skipped
    // //
    if ( Trig_Humans_Cinematic_Cleanup_Func006C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call ShowDestructableBJ(true, gg_dest_B61C_1509)
    call ShowDestructableBJ(true, gg_dest_LTba_1955)
    call ShowDestructableBJ(true, gg_dest_LTba_1954)
    call ShowDestructableBJ(true, gg_dest_LTba_1956)
    call ShowDestructableBJ(true, gg_dest_LTba_1958)
    call ShowDestructableBJ(true, gg_dest_LTba_1959)
    call ShowDestructableBJ(true, gg_dest_LTba_1957)
    call ShowDestructableBJ(true, gg_dest_LTcr_1961)
    call ShowDestructableBJ(true, gg_dest_LTcr_1962)
    call ShowDestructableBJ(true, gg_dest_LTcr_1960)
    // //
    // Manage Cinematic Actors
    // //
    call ShowUnitHide(udg_FakeUtok)
    call PauseUnitBJ(true, udg_FakeUtok)
    call SetUnitOwner(udg_FakeUtok, Player(PLAYER_NEUTRAL_PASSIVE), false)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Humans_Cinematic_Cleanup_Func025002)
    // //
    if ( Trig_Humans_Cinematic_Cleanup_Func027C() ) then
        call ShowUnitShow(udg_SemiHero_Utok)
    else
    endif
    // //
    if ( Trig_Humans_Cinematic_Cleanup_Func029C() ) then
        call StopSoundBJ(gg_snd_DarkAgents, false)
        call StopSoundBJ(gg_snd_WC2Orc01Captain1, false)
        call StopSoundBJ(gg_snd_WC2Orc01Captain2, false)
        call StopSoundBJ(gg_snd_WC2Orc01Captain3, false)
        call StopSoundBJ(gg_snd_WC2Orc01footman1, false)
        call StopSoundBJ(gg_snd_WC2Orc01footman2, false)
        call StopSoundBJ(gg_snd_WC2Orc01Footman3, false)
        call StopSoundBJ(gg_snd_WC2Orc01Utok2, false)
    else
    endif
    // //
    call RemoveUnit(udg_Unit_Footman01)
    call RemoveUnit(udg_Unit_Footman02)
    call RemoveUnit(udg_Unit_Footman03)
    call RemoveUnit(udg_Unit_Captain)
    // //
    call EnumDestructablesInRectAll(gg_rct_TreesBlockedWay, function Trig_Humans_Cinematic_Cleanup_Func036A)
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_Humans_Cinematic_Cleanup_Func038002)
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_Humans_Cinematic_Cleanup_Func039002)
    // //
    call TriggerSleepAction(0.50)
    call CreateNUnitsAtLocFacingLocBJ(1, 'hcth', udg_Player_Humans, GetRectCenter(gg_rct_Captain_Speak), udg_Point_PitfireHumanCamp)
    set udg_Unit_Captain=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_Footman05), GetRectCenter(gg_rct_Footman01))
    set udg_Unit_Footman01=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_Footman01), GetRectCenter(gg_rct_BoarStart))
    set udg_Unit_Footman02=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_Footman02), udg_Point_PitfireHumanCamp)
    set udg_Unit_Footman03=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_Footman03, "Cinematic sitting one")
    call SetUnitBlendTimeBJ(udg_Unit_Footman03, 0.15)
    // //
    if ( Trig_Humans_Cinematic_Cleanup_Func056C() ) then
        call CreateNUnitsAtLocFacingLocBJ(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_Footman06), GetRectCenter(gg_rct_Wolf01Start))
    else
    endif
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_TentB, Condition(function Trig_Humans_Cinematic_Cleanup_Func059001002)), function Trig_Humans_Cinematic_Cleanup_Func059A)
    // //
    call CreateNUnitsAtLoc(1, 'h620', udg_Player_Humans, GetRectCenter(gg_rct_TentB), bj_UNIT_FACING)
    set udg_Unit_TentB=GetLastCreatedUnit()
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_TentA, Condition(function Trig_Humans_Cinematic_Cleanup_Func065001002)), function Trig_Humans_Cinematic_Cleanup_Func065A)
    // //
    call CreateNUnitsAtLoc(1, 'h620', udg_Player_Humans, GetRectCenter(gg_rct_TentA), bj_UNIT_FACING)
    set udg_Unit_TentA=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_AdditionalFootman01), GetRectCenter(gg_rct_AdditionalFootman01Patrol))
    set udg_Unit_Footman04=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_Unit_Footman04)
    call BlzSetUnitRealFieldBJ(udg_Unit_Footman04, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_Unit_Footman04, 100.00)
    call IssuePointOrderLocBJ(udg_Unit_Footman04, "patrol", GetRectCenter(gg_rct_AdditionalFootman01Patrol))
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_AdditionalFootman02), udg_Point_PitfireHumanCamp)
    set udg_Unit_Footman05=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_Footman03), udg_Point_PitfireHumanCamp)
    set udg_Unit_Footman06=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_Footman06, "Cinematic Kneeling One")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_Footman04), udg_Point_PitfireHumanCamp)
    set udg_Unit_Footman07=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_Footman07, "Cinematic sitting one")
    // //
    call ShowUnitShow(gg_unit_h60K_0095)
    call ShowUnitShow(gg_unit_h60K_0096)
    call ShowUnitShow(gg_unit_h60K_0097)
    call ShowUnitShow(gg_unit_h60K_0094)
    call ShowUnitShow(gg_unit_h60K_0093)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Humans, 'h60K'), function Trig_Humans_Cinematic_Cleanup_Func095002)
    // //
    call IssueTargetDestructableOrder(gg_unit_h60K_0094, "attack", gg_dest_LTt4_0967)
    call IssueTargetDestructableOrder(gg_unit_h60K_0093, "attack", gg_dest_LTt4_0967)
    // //
    call EnableTrigger(gg_trg_TreeBridge_RestoreHP)
    call ResetToGameCameraForPlayer(udg_Actual_Player, 0)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    call CinematicModeBJ(false, GetPlayersAll())
    call LeaderboardDisplayBJ(true, udg_Leaderboard_QuestObjectives)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Humans_Cinematic_Cleanup_Func107C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Humans_Cinematic_Q)
    call TriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

//===========================================================================
function InitTrig_Humans_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Humans_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Humans_Cinematic_Cleanup, function Trig_Humans_Cinematic_Cleanup_Actions)
endfunction

