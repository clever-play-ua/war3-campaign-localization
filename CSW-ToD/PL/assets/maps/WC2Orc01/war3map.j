//===========================================================================
// Trigger: HumansKilledCinSetUp
//===========================================================================
function Trig_HumansKilledCinSetUp_Func005001002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) )
endfunction

function Trig_HumansKilledCinSetUp_Func006002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_HumansKilledCinSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_HumansKilledCinSetUp_Func005001002)), udg_Group_PausedUnits)
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_HumansKilledCinSetUp_Func006002)
    // //
    // //
    call SetUnitInvulnerable(udg_Unit_HumanShipAloc, false)
    call SetUnitInvulnerable(gg_unit_hdes_0016, false)
    call ShowUnitShow(gg_unit_o60P_0036)
    call PauseUnitBJ(false, gg_unit_o60P_0036)
    call PauseUnitBJ(false, gg_unit_hdes_0016)
    // //
    call CreateNUnitsAtLoc(1, 'o61W', udg_Actual_Player, GetRectCenter(gg_rct_OperationalGrunt), 225.00)
    set udg_Unit_CinOperationalGrunt=GetLastCreatedUnit()
    call SetUnitTimeScalePercent(udg_Unit_CinOperationalGrunt, 60.00)
    // //
endfunction

