//===========================================================================
// Trigger: HumansKilled Cinematic Cleanup
//===========================================================================
function Trig_HumansKilled_Cinematic_Cleanup_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumansKilled_Cinematic_Cleanup_Func011C takes nothing returns boolean
    if ( not ( udg_Bool_CinHumKilledSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumansKilled_Cinematic_Cleanup_Func013002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_HumansKilled_Cinematic_Cleanup_Func014002 takes nothing returns nothing
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_PausedUnits)
endfunction

function Trig_HumansKilled_Cinematic_Cleanup_Func031C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumansKilled_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Bool_CinHumKilledOn=false
    // //
    // Fade Faster If Cinematic Skipped
    // //
    if ( Trig_HumansKilled_Cinematic_Cleanup_Func007C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    // ----------------------------------------
    // //
    if ( Trig_HumansKilled_Cinematic_Cleanup_Func011C() ) then
        call StopSoundBJ(gg_snd_WC3OrcVictory, false)
        call StopSoundBJ(gg_snd_T02Grunt04901, false)
        call KillUnit(gg_unit_nbsp_0048)
        call KillUnit(gg_unit_hdes_0016)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'nbsp', udg_Player_Humans, GetUnitLoc(gg_unit_nbsp_0048), GetUnitFacing(gg_unit_nbsp_0048))
        call RemoveUnit(gg_unit_nbsp_0048)
    else
    endif
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_HumansKilled_Cinematic_Cleanup_Func013002)
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_HumansKilled_Cinematic_Cleanup_Func014002)
    // //
    call RemoveUnit(udg_Unit_CinOperationalGrunt)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'nbsp', udg_Player_Humans, GetUnitLoc(gg_unit_nbsp_0048), GetUnitFacing(gg_unit_nbsp_0048))
    // //
    call RemoveUnit(gg_unit_nbsp_0048)
    call RemoveUnit(gg_unit_o60P_0036)
    // //
    call ResetTerrainFogBJ()
    // //
    call ResetToGameCameraForPlayer(udg_Actual_Player, 0)
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    call CinematicModeBJ(false, GetPlayersAll())
    call LeaderboardDisplayBJ(true, udg_Leaderboard_QuestObjectives)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_HumansKilled_Cinematic_Cleanup_Func031C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_HumansKilled_Cinematic_Q)
    call TriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

//===========================================================================
function InitTrig_HumansKilled_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_HumansKilled_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_HumansKilled_Cinematic_Cleanup, function Trig_HumansKilled_Cinematic_Cleanup_Actions)
endfunction

//===========================================================================
// Trigger: OutroCinematic Q
//===========================================================================
function Trig_OutroCinematic_Q_Func034001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_OutroCinematic_Q_Func036001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_OutroCinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ClearSelectionForPlayer(udg_Actual_Player)
    // //
    call LeaderboardDisplayBJ(false, udg_Leaderboard_QuestObjectives)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_OutroCinSetUp)
    // //
    call PlaySoundBJ(gg_snd_WC3OrcVictory)
    call CameraSetupApplyForPlayer(true, gg_cam_Final01, udg_Actual_Player, 0)
    // //
    // Cinematic Started
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call SetSoundPositionLocBJ(gg_snd_CS_BG_Camp01, GetRectCenter(gg_rct_PeonsWorking), 0)
    // //
    set udg_Bool_CinOutroOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call ConditionalTriggerExecute(gg_trg_OutroCinematicPeonsworking)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_FinalBoatLoading, udg_Actual_Player, 15.50, 0, 2.00, 100.00)
    // //
    call SetUnitAnimation(udg_FakeRend, "stand victory")
    call QueueUnitAnimationBJ(udg_FakeRend, "stand victory")
    call QueueUnitAnimationBJ(udg_FakeRend, "stand")
    // ///
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc01Rend10, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(7.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // End of cinematic
    // //
    call StopSoundBJ(gg_snd_WC3OrcVictory, true)
    call DisableTrigger(gg_trg_OutroCinematicSkipped)
    call TriggerExecute(gg_trg_Next_Level_Prep)
endfunction

//===========================================================================
function InitTrig_OutroCinematic_Q takes nothing returns nothing
    set gg_trg_OutroCinematic_Q=CreateTrigger()
    call DisableTrigger(gg_trg_OutroCinematic_Q)
    call TriggerAddAction(gg_trg_OutroCinematic_Q, function Trig_OutroCinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: OutroCinSetUp
//===========================================================================
function Trig_OutroCinSetUp_Func029002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_OutroCinSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    // Hiding Gameplay Heroes
    // //
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', false, false)
    call ShowUnitHide(udg_Hero_Rend)
    call PauseUnitBJ(true, udg_Hero_Rend)
    // //
    call ShowUnitHide(udg_SemiHero_Utok)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    // //
    // Revoking Fake Actors
    // //
    call ShowUnitShow(udg_FakeRend)
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_UrukFinal), udg_Point_OutroPeonFacingPoint)
    // //
    call ShowUnitShow(udg_FakeUtok)
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokFinal), 318.97)
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeUtok)
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Writing One")
    // //
    // //
    call RemoveUnit(udg_Unit_CinematicTransportArr[1])
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60Q', udg_Player_CinematicOrcs, GetRectCenter(gg_rct_BoatFinal), GetRectCenter(gg_rct_Boat01))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_RED)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Wolves), function Trig_OutroCinSetUp_Func029002)
    // //
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61X', udg_Actual_Player, udg_Point_OutroPeonSpawnPointArr[1], udg_Point_OutroPeonFacingPoint)
    set udg_Unit_CinPeonOutro01=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61X', udg_Actual_Player, udg_Point_OutroPeonSpawnPointArr[1], udg_Point_OutroPeonFacingPoint)
    set udg_Unit_CinPeonOutro02=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61X', udg_Actual_Player, udg_Point_OutroPeonSpawnPointArr[2], udg_Point_OutroPeonFacingPoint)
    set udg_Unit_CinPeonOutro03=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61X', udg_Actual_Player, udg_Point_OutroPeonSpawnPointArr[2], udg_Point_OutroPeonFacingPoint)
    set udg_Unit_CinPeonOutro04=GetLastCreatedUnit()
    // //
endfunction

