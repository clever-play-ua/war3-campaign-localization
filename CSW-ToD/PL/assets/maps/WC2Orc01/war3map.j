    return GetBooleanOr((IsQuestCompleted(udg_OQ_Wolves) == true), (udg_GameOver == true)) // INLINED!!
endfunction

function Trig_WolfAttackRepeatingWave02A_Actions takes nothing returns nothing
    // ***Wave02***
    // FrostWolf
    // ***NorthDen***
    if ( Trig_WolfAttackRepeatingWave02A_Func005C() ) then
        if ( Trig_WolfAttackRepeatingWave02A_Func005Func001C() ) then
            call CreateNUnitsAtLoc(1, 'nwwf', udg_Player_Wolves, GetRectCenter(gg_rct_WolfLair), 270.00)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_WolvesAttackAnchor)
        else
        endif
    else
    endif
    // EastDen
    if ( Trig_WolfAttackRepeatingWave02A_Func007C() ) then
        if ( Trig_WolfAttackRepeatingWave02A_Func007Func001C() ) then
            call CreateNUnitsAtLoc(1, 'nwwf', udg_Player_Wolves, GetRectCenter(gg_rct_WolfLair02), 335.00)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_WolvesAttackAnchor)
        else
        endif
    else
    endif
    // WestDen
    if ( Trig_WolfAttackRepeatingWave02A_Func009C() ) then
        if ( Trig_WolfAttackRepeatingWave02A_Func009Func001C() ) then
            call CreateNUnitsAtLoc(1, 'nwwf', udg_Player_Wolves, GetRectCenter(gg_rct_WolfLair03), 0.00)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_WolvesAttackAnchor)
        else
        endif
    else
    endif
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call PolledWait(10.00)
    if ( (GetBooleanOr((IsQuestCompleted(udg_OQ_Wolves) == true), (udg_GameOver == true))) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call QueuedTriggerAddBJ(gg_trg_WolfAttackRepeatingWave02B, true)
endfunction

