//===========================================================================
// Trigger: Wolves Completed Q
//===========================================================================
function Trig_Wolves_Completed_Q_Func014C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wolves_Completed_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_BTG, 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc01Rend8, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call QuestItemSetCompletedBJ(udg_OQReq_Wolves_DestroyDens, true)
    call QuestSetCompletedBJ(udg_OQ_Wolves, true)
    call QuestMessageBJ(bj_FORCE_PLAYER[0], bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_112")
    // //
    call LeaderboardRemovePlayerItemBJ(Player(8), udg_Leaderboard_QuestObjectives)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    if ( Trig_Wolves_Completed_Q_Func014C() ) then
        call PauseUnitBJ(true, udg_SemiHero_Utok)
        call PanCameraToTimedLocForPlayer(udg_Actual_Player, GetUnitLoc(udg_SemiHero_Utok), 1.00)
        call PolledWait(1.00)
        call AddSpecialEffectTargetUnitBJ("origin", udg_SemiHero_Utok, "Abilities\\Spells\\Other\\Levelup\\Levelupcaster.mdx ")
        set udg_SE_UtokLevelUp=GetLastCreatedEffectBJ()
        call PolledWait(1.00)
        call DestroyEffectBJ(udg_SE_UtokLevelUp)
        call PauseUnitBJ(false, udg_SemiHero_Utok)
        call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    else
    endif
    // //
    call SetPlayerTechResearchedSwap('RUX2', 1, udg_Actual_Player)
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_HINT, "TRIGSTR_2259")
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

