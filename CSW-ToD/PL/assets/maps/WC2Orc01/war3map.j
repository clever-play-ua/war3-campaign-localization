    call TriggerRegisterTimerExpireEventBJ(gg_trg_First_SignalFire_TimerExpires, udg_Timer)
    call TriggerAddAction(gg_trg_First_SignalFire_TimerExpires, function Trig_First_SignalFire_TimerExpires_Actions)
