    return ( udg_Bool_CinHumKilledSkipped == true )
endfunction

function Trig_HumansKilled_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call LeaderboardDisplayBJ(false, udg_Leaderboard_QuestObjectives)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_HumansKilledCinSetUp)
    // //
    call SetTerrainFogExBJ(0, 1000, 5500.00, 0.50, 31.00, 49.00, 52.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Catapult, udg_Actual_Player, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Catapult02, udg_Actual_Player, 12.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_WC3OrcVictory)
    // //
    // //
    // CinematicStarted
    // //
    set udg_Bool_CinHumKilledOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    // Ship 1 Destroyed
    // //
    call SetUnitFacingToFaceUnitTimed(gg_unit_o60P_0036, gg_unit_hdes_0016, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_CinOperationalGrunt, "Attack 2")
    call QueueUnitAnimationBJ(udg_Unit_CinOperationalGrunt, "stand")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueTargetOrderBJ(gg_unit_o60P_0036, "attack", gg_unit_hdes_0016)
    call TriggerSleepAction(2.50)
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillUnit(gg_unit_hdes_0016)
    call PlaySoundAtPointBJ(gg_snd_BattleShipDeath1, 100, GetRectCenter(gg_rct_HumanShip), 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Ship 2 Destroyed
    // //
    call SetUnitFacingToFaceUnitTimed(udg_Unit_CinOperationalGrunt, gg_unit_nbsp_0048, 1.00)
    call SetUnitFacingToFaceUnitTimed(gg_unit_o60P_0036, gg_unit_nbsp_0048, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_CinOperationalGrunt, "Attack 2")
    call QueueUnitAnimationBJ(udg_Unit_CinOperationalGrunt, "stand")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueTargetOrderBJ(gg_unit_o60P_0036, "attack", gg_unit_nbsp_0048)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillUnit(gg_unit_nbsp_0048)
    call PlaySoundAtPointBJ(gg_snd_BattleShipDeath1, 100, GetRectCenter(gg_rct_HumanShip), 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Catapult03, udg_Actual_Player, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Catapult04, udg_Actual_Player, ( GetSoundDurationBJ(gg_snd_T02Grunt04901) + 3.00 ))
    // //
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // //
    call SetUnitAnimation(udg_Unit_CinOperationalGrunt, "stand victory")
    call QueueUnitAnimationBJ(udg_Unit_CinOperationalGrunt, "stand")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_CinOperationalGrunt, 0, gg_snd_T02Grunt04901, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinHumKilledSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call StopSoundBJ(gg_snd_WC3OrcVictory, true)
    // //
    // CinematicEnded
    // //
    call ConditionalTriggerExecute(gg_trg_HumansKilled_Cinematic_Cleanup)
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_HumansKilled_Cinematic_Q takes nothing returns nothing
    set gg_trg_HumansKilled_Cinematic_Q=CreateTrigger()
