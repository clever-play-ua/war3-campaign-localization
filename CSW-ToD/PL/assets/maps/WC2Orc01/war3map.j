endfunction

function Trig_Intro_Cinematic_Q_Func073001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func076001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func080001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func089001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func093001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01, udg_Actual_Player, 0)
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Setup)
    call IssuePointOrderLocBJ(udg_Unit_CinematicTransportArr[2], "move", GetRectCenter(gg_rct_FakeBOatDirection))
    // //
    call TriggerSleepAction(0.50)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro02, udg_Actual_Player, 11.00)
    // //
    set udg_Bool_CinematicSkipped=false
    set udg_Bool_CinIntroOn=true
    // //
    call PlaySoundBJ(gg_snd_Warcraft_II_Menu_Theme)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_BoatSounds)
    // //
    call TriggerSleepAction(7.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_Unit_CinematicTransportArr[1], "move", GetRectCenter(gg_rct_Boat02))
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroBoatA, udg_Actual_Player, 0.00)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_IntroBoatB, udg_Actual_Player, 12.00, 1.00, 2.00, 100.00)
    call SetTerrainFogExBJ(0, 1000, 5500.00, 0.50, 31.00, 49.00, 52.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    // BoatArrives
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_BoatSounds)
    call TriggerSleepAction(14.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_Grunt02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceLocTimed(udg_FakeUtok, GetRectCenter(gg_rct_IntroTargetPoint02), 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeUtok)
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Salute One")
    call QueueUnitAnimationBJ(udg_FakeUtok, "Cinematic Listening One")
    call PlaySoundOnUnitBJ(gg_snd_CS_H01b_Orc_gesture_v2, 100, udg_FakeUtok)
    call PlayDialogueFromSpeakerEx(GetPlayersAll(), udg_FakeUtok, 0, gg_snd_WC2Orc01Utok1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(GetPlayersAll(), udg_FakeRend, 0, gg_snd_WC2Orc01Rend1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro08, udg_Actual_Player, 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro09, udg_Actual_Player, 18.00, 1.00, 3.00, 100.00)
    // //
    call PlayDialogueFromSpeakerEx(GetPlayersAll(), udg_FakeRend, 0, gg_snd_WC2Orc01Rend2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(GetPlayersAll(), udg_FakeRend, 0, gg_snd_WC2Orc01Rend3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro10, udg_Actual_Player, 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro11, udg_Actual_Player, ( GetSoundDurationBJ(gg_snd_WC2Orc01Rend4) + GetSoundDurationBJ(gg_snd_WC2Orc01Rend5) ), 1.00, 3.00, 100.00)
    // //
    call PlayDialogueFromSpeakerEx(GetPlayersAll(), udg_FakeRend, 0, gg_snd_WC2Orc01Rend4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_Warcraft_II_Menu_Theme, true)
    call PlayDialogueFromSpeakerEx(GetPlayersAll(), udg_FakeRend, 0, gg_snd_WC2Orc01Rend5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // End of transmission
    call DisableTrigger(gg_trg_Intro_Cinematic_Skipped)
    call TriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Q takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Q=CreateTrigger()
    call DisableTrigger(gg_trg_Intro_Cinematic_Q)
    call TriggerAddAction(gg_trg_Intro_Cinematic_Q, function Trig_Intro_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Setup
//===========================================================================
function Trig_Intro_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    // Hide Gaemplay Units
    // //
    call ShowUnitHide(udg_Hero_Rend)
    call PauseUnitBJ(true, udg_Hero_Rend)
    // //
    call ShowUnitHide(udg_SemiHero_Utok)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    // //
    // Manage Actors
    // //
    call CreateNUnitsAtLoc(1, 'o605', udg_Actual_Player, GetRectCenter(gg_rct_CinIntroUtokStart), 346.26)
    set udg_FakeUtok=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'ORbC', udg_Actual_Player, GetRectCenter(gg_rct_IntroUnloadTransport), 109.66)
    set udg_FakeRend=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.50)
    call SetUnitOwner(udg_FakeRend, udg_Player_BTG, true)
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_IntroUnloadTransport), GetRectCenter(gg_rct_IntroTurningPoint01))
    call ShowUnitHide(udg_FakeRend)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Unit_CinematicTransportArr[1], GetRectCenter(gg_rct_Boat00), GetRectCenter(gg_rct_Boat01))
    call PauseUnitBJ(false, udg_Unit_CinematicTransportArr[1])
    call SetUnitPathing(udg_Unit_CinematicTransportArr[1], false)
    // //
    call SetUnitColor(udg_Unit_CinematicTransportArr[2], PLAYER_COLOR_RED)
    call SetUnitScalePercent(udg_Unit_CinematicTransportArr[2], 140.00, 140.00, 140.00)
    call PauseUnitBJ(false, udg_Unit_CinematicTransportArr[2])
    call SetUnitPathing(udg_Unit_CinematicTransportArr[2], false)
    // //
    call SetUnitAnimation(gg_unit_o61X_0009, "stand work")
    // //
    // Intro starts
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Setup takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Setup, function Trig_Intro_Cinematic_Setup_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Skipped
//===========================================================================
function Trig_Intro_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Intro_Cinematic_Skipped, Condition(function Trig_Intro_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_Skipped, function Trig_Intro_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Cleanup
//===========================================================================
function Trig_Intro_Cinematic_Cleanup_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func005C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func008C takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func054C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    // //
    set udg_Bool_CinIntroOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func005C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func008C() ) then
        call StopSoundBJ(gg_snd_Warcraft_II_Menu_Theme, false)
        call StopSoundBJ(gg_snd_WC2Orc01Utok1, false)
        call StopSoundBJ(gg_snd_WC2Orc01Rend1, false)
        call StopSoundBJ(gg_snd_WC2Orc01Rend2, false)
        call StopSoundBJ(gg_snd_WC2Orc01Rend3, false)
        call StopSoundBJ(gg_snd_WC2Orc01Rend4, false)
        call StopSoundBJ(gg_snd_WC2Orc01Rend5, false)
    else
    endif
    // //
    // Manage Cinematic Actors
    // //
    call ShowUnitHide(udg_FakeRend)
    call PauseUnitBJ(true, udg_FakeRend)
    call SetUnitOwner(udg_FakeRend, Player(PLAYER_NEUTRAL_PASSIVE), false)
    // //
    call ShowUnitHide(udg_FakeUtok)
    call PauseUnitBJ(true, udg_FakeUtok)
    call SetUnitOwner(udg_FakeUtok, Player(PLAYER_NEUTRAL_PASSIVE), false)
    // //
    // Restore Gameplay Units
    // //
    call SetUnitOwner(udg_Hero_Rend, udg_Actual_Player, false)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_RendDefaultPositionGame), GetRectCenter(gg_rct_Grunt02))
    call ShowUnitShow(udg_Hero_Rend)
    call PauseUnitBJ(false, udg_Hero_Rend)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_Grunt05), udg_Point_PigEscapes)
    call ShowUnitShow(udg_SemiHero_Utok)
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    // //
    call ResetToGameCameraForPlayer(Player(0), 0)
    call PanCameraToTimedLocForPlayer(Player(0), CameraSetupGetDestPositionLoc(gg_cam_Camp), 0)
    // //
    call ResetTerrainFogBJ()
    // //
    call ShowUnitShow(gg_unit_o619_0007)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o619_0007, GetRectCenter(gg_rct_Grunt02), GetRectCenter(gg_rct_IntroTargetPoint02))
    call ShowUnitShow(gg_unit_o619_0008)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o619_0008, GetRectCenter(gg_rct_Grunt04), GetRectCenter(gg_rct_WolfSpawn01))
    // //
    call SetUnitPositionLocFacingBJ(gg_unit_o61X_0009, GetRectCenter(gg_rct_PeonStartGame), bj_UNIT_FACING)
    call ResetUnitAnimation(gg_unit_o61X_0009)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Unit_CinematicTransportArr[1], GetRectCenter(gg_rct_Boat02), GetRectCenter(gg_rct_Boat00))
    call SetUnitFacingTimed(udg_Unit_CinematicTransportArr[1], 0.00, 1.50)
    // //
    call RemoveUnit(udg_Unit_CinematicTransportArr[2])
    // //
    call CinematicModeBJ(false, bj_FORCE_PLAYER[0])
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    call TriggerExecute(gg_trg_Cliff03On)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func054C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    // //
    call SelectUnitSingle(udg_Hero_Rend)
    call TriggerSleepAction(1.00)
    call TriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    call TriggerExecute(gg_trg_Landing_Discover)
    call PolledWait(60.00)
    call ConditionalTriggerExecute(gg_trg_Fuel_Discover)
    // //
    // //
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddCondition(gg_trg_Intro_Cinematic_Cleanup, Condition(function Trig_Intro_Cinematic_Cleanup_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_Cleanup, function Trig_Intro_Cinematic_Cleanup_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic BoatSounds
//===========================================================================
function Trig_Intro_Cinematic_BoatSounds_Func004001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_BoatSounds_Func007001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
