//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func001C takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func013C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    if ( Trig_Next_Level_Prep_Func001C() ) then
        call StopSoundBJ(gg_snd_WC2Orc01Rend10, false)
    else
    endif
    call ShowUnitShow(udg_Hero_Rend)
    call PauseUnitBJ(false, udg_Hero_Rend)
    call SetUnitOwner(udg_Hero_Rend, udg_Actual_Player, false)
    // //
    call InitGameCacheBJ("WC2Horde.w3v")
    set udg_Cache=GetLastCreatedGameCacheBJ()
    // //
    call TriggerSleepAction(0.10)
    // //
    call StoreUnitBJ(udg_Hero_Rend, "Rend", "WC2Orc01", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func013C() ) then
        call ShowUnitShow(udg_SemiHero_Utok)
        call PauseUnitBJ(false, udg_SemiHero_Utok)
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Actual_Player, GetRectCenter(gg_rct_Grunt02), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
    endif
    // //
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', udg_Actual_Player), "UtokLevel", "WC2Orc01", udg_Cache)
    call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc01", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc01", udg_Cache)
    // //
    call TriggerSleepAction(0.10)
    // //
    call SaveGameCacheBJ(udg_Cache)
    // Original map transition code
    call ShowCustomCampaignButton(true, 3)
    call SetNextLevelBJ("WC2orc02.w3x")
    // //
    call ConditionalTriggerExecute(gg_trg_Finalization)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

//===========================================================================
// Trigger: Finalization
//===========================================================================
function Trig_Finalization_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CinematicFilterGenericBJ(2.00, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100, 100, 100, 100, 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(3.00)
    set udg_Bool_CinOutroOn=false
    call RemoveUnit(udg_FakeRend)
    call RemoveUnit(udg_FakeUtok)
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CustomVictoryBJ(udg_Actual_Player, true, true)
endfunction

//===========================================================================
function InitTrig_Finalization takes nothing returns nothing
    set gg_trg_Finalization=CreateTrigger()
    call DisableTrigger(gg_trg_Finalization)
    call TriggerAddAction(gg_trg_Finalization, function Trig_Finalization_Actions)
endfunction

//===========================================================================
// Trigger: SetUpCinematicFrame
//
// By Insane Monster
//===========================================================================
function Trig_SetUpCinematicFrame_Actions takes nothing returns nothing
    // // Hide portrait during cinematic
    call BlzFrameSetVisible(BlzGetFrameByName("HDCinematicPortraitCover", 0), false)
    // // Remove the background by moving it (hiding does not work)
    call BlzFrameClearAllPoints(BlzGetFrameByName("HDCinematicBackground", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.0)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_TOPRIGHT, 0.0, 0.0)
    // // Set the cinematic dialogue text rectangle to the bottom center portion of the screen
    call BlzFrameClearAllPoints(BlzGetFrameByName("CinematicDialogueText", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.035)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.075)
    // // Set the cinematic speaker text rectangle to the bottom center portion of the screen (above dialogue text)
    call BlzFrameClearAllPoints(BlzGetFrameByName("CinematicSpeakerText", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.085)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.95)
    // // Set both cinematic speaker and cinematic dialogue text alignment to center
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicDialogueText", 0), TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicSpeakerText", 0), TEXT_JUSTIFY_BOTTOM, TEXT_JUSTIFY_CENTER)
endfunction

//===========================================================================
function InitTrig_SetUpCinematicFrame takes nothing returns nothing
    set gg_trg_SetUpCinematicFrame=CreateTrigger()
    call TriggerAddAction(gg_trg_SetUpCinematicFrame, function Trig_SetUpCinematicFrame_Actions)
endfunction

//===========================================================================
// Trigger: GenericCinematicPrepIn
//===========================================================================
function Trig_GenericCinematicPrepIn_Func005002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_Selection)
endfunction

function Trig_GenericCinematicPrepIn_Func013002 takes nothing returns nothing
    call SetItemVisibleBJ(false, GetEnumItem())
endfunction

function Trig_GenericCinematicPrepIn_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_OilTextHide)
    set udg_VarCurrentCamera=GetCurrentCameraSetup()
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Actual_Player), function Trig_GenericCinematicPrepIn_Func005002)
    call ClearSelectionForPlayer(udg_Actual_Player)
    // //
    call TriggerSleepAction(1.00)
    // //
    // //
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, true)
    // //
    call EnumItemsInRectBJ(GetPlayableMapRect(), function Trig_GenericCinematicPrepIn_Func013002)
    // //
endfunction

//===========================================================================
function InitTrig_GenericCinematicPrepIn takes nothing returns nothing
    set gg_trg_GenericCinematicPrepIn=CreateTrigger()
    call TriggerAddAction(gg_trg_GenericCinematicPrepIn, function Trig_GenericCinematicPrepIn_Actions)
endfunction

