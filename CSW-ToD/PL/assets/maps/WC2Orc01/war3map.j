    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func057001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func060001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func064001 takes nothing returns boolean
