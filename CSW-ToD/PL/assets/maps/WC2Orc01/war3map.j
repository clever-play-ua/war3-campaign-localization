//===========================================================================
// Trigger: Wolves Discover Q
//===========================================================================
function Trig_Wolves_Discover_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetDestructableInvulnerableBJ(gg_dest_B00C_1903, false)
    call SetDestructableInvulnerableBJ(gg_dest_B00C_2125, false)
    call SetDestructableInvulnerableBJ(gg_dest_B00C_2126, false)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Actual_Player, 'o61X', GetCameraTargetPositionLoc(), gg_snd_WC2Orc01Peon1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_BTG, 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc01Rend7, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call QuestSetDiscoveredBJ(udg_OQ_Wolves, true)
    call QuestMessageBJ(bj_FORCE_PLAYER[0], bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_104")
    // //
    call LeaderboardAddItemBJ(Player(8), udg_Leaderboard_QuestObjectives, "TRIGSTR_2416", udg_Int_QuestWolves_DensRemained)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(8), udg_Leaderboard_QuestObjectives, 100.00, 80.00, 0.00, 0)
    call LeaderboardSetPlayerItemValueColorBJ(Player(8), udg_Leaderboard_QuestObjectives, 100.00, 100.00, 100.00, 0)
    // //
    call TriggerSleepAction(( bj_QUEUE_DELAY_QUEST - 1 ))
    call PlaySoundAtPointBJ(gg_snd_DuskWolf, 100, GetRectCenter(gg_rct_OrcCamp), 0)
    call ConditionalTriggerExecute(gg_trg_WolvesAttackStart)
    call TriggerSleepAction(1.00)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

