    if ( not ( GetEnteringUnit() == gg_unit_o619_0007 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_IntroOrcsMoving_Func004Func002001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_Grunt01, gg_unit_o619_0008) == true )
endfunction

function Trig_Intro_Cinematic_IntroOrcsMoving_Func004Func003001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_IntroOrcsMoving_Func004Func005001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_IntroOrcsMoving_Func004Func008001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_IntroOrcsMoving_Func004C takes nothing returns boolean
    if ( not ( GetEnteringUnit() == gg_unit_o619_0008 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_IntroOrcsMoving_Actions takes nothing returns nothing
    if ( Trig_Intro_Cinematic_IntroOrcsMoving_Func002C() ) then
        call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_IntroTargetPoint02))
    else
    endif
    if ( Trig_Intro_Cinematic_IntroOrcsMoving_Func003C() ) then
        call IssuePointOrderLocBJ(gg_unit_o619_0007, "move", GetRectCenter(gg_rct_Grunt03))
        loop
            exitwhen ( (RectContainsUnit(gg_rct_Grunt03, gg_unit_o619_0007) == true) ) // INLINED!!
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
        endloop
        if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
        call TriggerSleepAction(0.50)
        if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
        call SetUnitFacingToFaceUnitTimed(gg_unit_o619_0007, udg_FakeUtok, 0.50)
        call TriggerSleepAction(0.50)
        if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
        call SetUnitAnimationWithRarity(gg_unit_o619_0007, "stand", RARITY_FREQUENT)
    else
    endif
    if ( Trig_Intro_Cinematic_IntroOrcsMoving_Func004C() ) then
        call IssuePointOrderLocBJ(gg_unit_o619_0008, "move", GetRectCenter(gg_rct_Grunt01))
        loop
            exitwhen ( (RectContainsUnit(gg_rct_Grunt01, gg_unit_o619_0008) == true) ) // INLINED!!
            call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
        endloop
        if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
        call TriggerSleepAction(0.50)
        if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
        call SetUnitFacingToFaceUnitTimed(gg_unit_o619_0008, udg_FakeUtok, 0.50)
        call TriggerSleepAction(0.50)
        if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
        call SetUnitAnimationWithRarity(gg_unit_o619_0008, "stand", RARITY_FREQUENT)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_IntroOrcsMoving takes nothing returns nothing
    set gg_trg_Intro_Cinematic_IntroOrcsMoving=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Intro_Cinematic_IntroOrcsMoving, gg_rct_IntroTurningPoint01)
    call TriggerAddCondition(gg_trg_Intro_Cinematic_IntroOrcsMoving, Condition(function Trig_Intro_Cinematic_IntroOrcsMoving_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_IntroOrcsMoving, function Trig_Intro_Cinematic_IntroOrcsMoving_Actions)
