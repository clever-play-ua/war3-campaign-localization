//===========================================================================
// Trigger: AllUnitsDead Defeat
//===========================================================================
function Trig_AllUnitsDead_Defeat_Func007001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_AllUnitsDead_Defeat_Func007001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AllUnitsDead_Defeat_Func007001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AllUnitsDead_Defeat_Func007A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerADefeatCond)
endfunction

function Trig_AllUnitsDead_Defeat_Func010001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_AllUnitsDead_Defeat_Func010001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AllUnitsDead_Defeat_Func010001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AllUnitsDead_Defeat_Func010A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerADefeatCond)
endfunction

function Trig_AllUnitsDead_Defeat_Func012Func002C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQ_Landing) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllUnitsDead_Defeat_Func012Func003C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQ_Fuel) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllUnitsDead_Defeat_Func012C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_PlayerADefeatCond) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllUnitsDead_Defeat_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call GroupClear(udg_Group_PlayerADefeatCond)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Actual_Player, Condition(function Trig_AllUnitsDead_Defeat_Func007001002)), function Trig_AllUnitsDead_Defeat_Func007A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Actual_Player, Condition(function Trig_AllUnitsDead_Defeat_Func010001002)), function Trig_AllUnitsDead_Defeat_Func010A)
    // //
    if ( Trig_AllUnitsDead_Defeat_Func012C() ) then
        set udg_GameOver=true
        if ( Trig_AllUnitsDead_Defeat_Func012Func002C() ) then
            call QuestSetFailedBJ(udg_MQ_Landing, true)
        else
        endif
        if ( Trig_AllUnitsDead_Defeat_Func012Func003C() ) then
            call QuestSetFailedBJ(udg_MQ_Fuel, true)
        else
        endif
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_FAILED, "TRIGSTR_2414")
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
        call TriggerSleepAction(2.00)
        call CustomDefeatBJ(udg_Actual_Player, "TRIGSTR_2415")
    else
    endif
    // //
    call GroupClear(udg_Group_PlayerADefeatCond)
    // //
endfunction

