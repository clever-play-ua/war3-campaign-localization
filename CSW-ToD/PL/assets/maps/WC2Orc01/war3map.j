//===========================================================================
// Trigger: Fuel UpdateCompleted Q
//===========================================================================
function Trig_Fuel_UpdateCompleted_Q_Func001Func008C takes nothing returns boolean
    if ( not ( udg_Int_QuestFuel_GoldStash >= udg_Int_QuestFuel_RequiredGold ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fuel_UpdateCompleted_Q_Func001Func009C takes nothing returns boolean
    if ( not ( udg_Int_QuestFuel_LumberStash >= udg_Int_QuestFuel_RequiredLumber ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fuel_UpdateCompleted_Q_Func001C takes nothing returns boolean
    if ( not ( udg_Int_QuestFuel_GoldStash >= udg_Int_QuestFuel_RequiredGold ) ) then
        return false
    endif
    if ( not ( udg_Int_QuestFuel_LumberStash >= udg_Int_QuestFuel_RequiredLumber ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fuel_UpdateCompleted_Q_Actions takes nothing returns nothing
    if ( Trig_Fuel_UpdateCompleted_Q_Func001C() ) then
        call LeaderboardRemovePlayerItemBJ(Player(1), udg_Leaderboard_QuestObjectives)
        call LeaderboardRemovePlayerItemBJ(Player(2), udg_Leaderboard_QuestObjectives)
        call QuestSetCompletedBJ(udg_MQ_Fuel, true)
        call QuestItemSetCompletedBJ(udg_MQReq_Fuel_GatherGold, true)
        call QuestItemSetCompletedBJ(udg_MQReq_Fuel_HarvestLumber, true)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2254")
    else
        set udg_newLine="\n"
        // //
        set udg_String_CompletedQuests=( GetItemName(gg_item_IQL1_0062) + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL3_0064) ) )
        // //
        if ( Trig_Fuel_UpdateCompleted_Q_Func001Func008C() ) then
            call LeaderboardRemovePlayerItemBJ(Player(1), udg_Leaderboard_QuestObjectives)
            call QuestItemSetCompletedBJ(udg_MQReq_Fuel_GatherGold, true)
            // //
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemDescription(gg_item_IQL5_0066) + ( udg_String_FuelRequiredGoldText + BlzGetItemTooltip(gg_item_IQL5_0066) ) ) ) )
            // //
        else
            // //
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL3_0064) + ( udg_String_FuelRequiredGoldText + BlzGetItemDescription(gg_item_IQL3_0064) ) ) ) )
            // //
        endif
        if ( Trig_Fuel_UpdateCompleted_Q_Func001Func009C() ) then
            call LeaderboardRemovePlayerItemBJ(Player(2), udg_Leaderboard_QuestObjectives)
            call QuestItemSetCompletedBJ(udg_MQReq_Fuel_HarvestLumber, true)
            // //
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemTooltip(gg_item_IQL4_0065) + ( udg_String_FuelRequiredLumberText + GetItemName(gg_item_IQL4_0065) ) ) ) )
            // //
        else
            // //
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL4_0065) + ( udg_String_FuelRequiredLumberText + BlzGetItemDescription(gg_item_IQL4_0065) ) ) ) )
            // //
        endif
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    endif
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

