//===========================================================================
// Trigger: First Discover
//===========================================================================
function Trig_First_Discover_Func002C takes nothing returns boolean
    if ( ( IsQuestItemCompleted(udg_MQReq_Fuel_GatherGold) == true ) ) then
        return true
    endif
    if ( ( IsQuestItemCompleted(udg_MQReq_Fuel_HarvestLumber) == true ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(gg_unit_n60O_0011) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_First_Discover_Conditions takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_MQ_FirstBlood) == false ) ) then
        return false
    endif
    if ( not Trig_First_Discover_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_First_Discover_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(10.00)
    call QueuedTriggerAddBJ(gg_trg_Humans_Cinematic_Q, true)
    call QueuedTriggerAddBJ(gg_trg_First_Discover_Q, true)
endfunction

//===========================================================================
function InitTrig_First_Discover takes nothing returns nothing
    set gg_trg_First_Discover=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_First_Discover, 1.00)
    call TriggerAddCondition(gg_trg_First_Discover, Condition(function Trig_First_Discover_Conditions))
    call TriggerAddAction(gg_trg_First_Discover, function Trig_First_Discover_Actions)
endfunction

//===========================================================================
// Trigger: First Discover Q
//===========================================================================
function Trig_First_Discover_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_TreeBridge_Activated)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_BTG, 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc01Rend9, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call StartTimerBJ(udg_Timer, false, udg_Int_QestFirstBlood_TimerValue)
    call CreateTimerDialogBJ(udg_Timer, "TRIGSTR_2286")
    // //
    set udg_Timerwindow=GetLastCreatedTimerDialogBJ()
    call CreateFogModifierRadiusLocBJ(true, udg_Actual_Player, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_BoneFire), 512.00)
    // //
    call PingMinimapLocForForce(bj_FORCE_PLAYER[0], GetRectCenter(gg_rct_BoneFire), 15.00)
    call CameraSetupApplyForPlayer(true, gg_cam_SignalFireAlarm, udg_Actual_Player, 1.00)
    // //
    call QuestSetDiscoveredBJ(udg_MQ_FirstBlood, true)
    // //
    call QuestMessageBJ(bj_FORCE_PLAYER[0], bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2287")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_2288")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    // //
    call EnableTrigger(gg_trg_First_Update_SignalFire)
    call PlaySoundBJ(gg_snd_Warning)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_First_Discover_Q takes nothing returns nothing
    set gg_trg_First_Discover_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_First_Discover_Q, function Trig_First_Discover_Q_Actions)
endfunction

//===========================================================================
// Trigger: First Update SignalFire
//===========================================================================
function Trig_First_Update_SignalFire_Conditions takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_MQ_FirstBlood) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Update_SignalFire_Func006Func018Func001C takes nothing returns boolean
    if ( not ( udg_Bool_PutFireFailed == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Update_SignalFire_Func006Func018C takes nothing returns boolean
    if ( not ( udg_Bool_FirstBlood_PutOutFire == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FirstBlood_ScoutsKilled == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Update_SignalFire_Func006Func019001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Actual_Player )
endfunction

function Trig_First_Update_SignalFire_Func006Func019001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_First_Update_SignalFire_Func006Func019001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Actual_Player), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_First_Update_SignalFire_Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_RectBoneFireOff, Condition(function Trig_First_Update_SignalFire_Func006Func019001001002))) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Update_SignalFire_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    if ( Trig_First_Update_SignalFire_Func006C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        // //
        call PauseTimerBJ(true, udg_Timer)
        call DestroyTimerDialogBJ(udg_Timerwindow)
        call TriggerSleepAction(1.00)
        call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_BoneFire), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl")
        set udg_SE_WaterBucket=GetLastCreatedEffectBJ()
        // //
        call PlaySoundAtPointBJ(gg_snd_BattleShipDeath1, 75.00, GetRectCenter(gg_rct_BoneFire), 0)
        call TriggerSleepAction(1.00)
        // //
        call KillDestructable(gg_dest_B617_1717)
        call TriggerSleepAction(1.00)
        call DestroyEffectBJ(udg_SE_WaterBucket)
        // //
        set udg_Bool_FirstBlood_PutOutFire=true
        // //
        if ( Trig_First_Update_SignalFire_Func006Func018C() ) then
            call QueuedTriggerAddBJ(gg_trg_HumansKilled_Cinematic_Q, true)
            call QueuedTriggerAddBJ(gg_trg_First_Completed_Q, true)
        else
            if ( Trig_First_Update_SignalFire_Func006Func018Func001C() ) then
                call QueuedTriggerAddBJ(gg_trg_First_Update_SignalFire_Q, true)
            else
            endif
        endif
    else
    endif
endfunction

