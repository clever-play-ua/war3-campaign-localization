//===========================================================================
// Trigger: Wolves DestroyDen1
//===========================================================================
function Trig_Wolves_DestroyDen1_Func009001003001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Wolves )
endfunction

function Trig_Wolves_DestroyDen1_Func009001003002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false )
endfunction

function Trig_Wolves_DestroyDen1_Func009001003 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Wolves), (IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false)) // INLINED!!
endfunction

function Trig_Wolves_DestroyDen1_Func009002 takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_Wolves_DestroyDen1_Func012002 takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_WolfLairEscapeCave01))
endfunction

function Trig_Wolves_DestroyDen1_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_WolfSpawn01), "Doodads\\Cinematic\\CavernDust\\CavernDust.mdl")
    set udg_SE_CavernDustArr[1]=GetLastCreatedEffectBJ()
    call CameraSetEQNoiseForPlayer(udg_Actual_Player, 2.00)
    call TriggerSleepAction(1.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(256.00, GetRectCenter(gg_rct_WolfSpawn01), Condition(function Trig_Wolves_DestroyDen1_Func009001003)), function Trig_Wolves_DestroyDen1_Func009002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_WolfLair, udg_Actual_Player), function Trig_Wolves_DestroyDen1_Func012002)
    // //
    call CreateDestructableLoc('LTrc', GetRectCenter(gg_rct_WolfLair), GetRandomDirectionDeg(), 1.60, 0)
    call SetDestructableInvulnerableBJ(GetLastCreatedDestructable(), true)
    // //
    set udg_Int_QuestWolves_DensRemained=( udg_Int_QuestWolves_DensRemained - 1 )
    call LeaderboardSetPlayerItemValueBJ(Player(8), udg_Leaderboard_QuestObjectives, udg_Int_QuestWolves_DensRemained)
    call TriggerSleepAction(1.00)
    call CameraClearNoiseForPlayer(udg_Actual_Player)
    call DestroyEffectBJ(udg_SE_CavernDustArr[1])
endfunction

//===========================================================================
function InitTrig_Wolves_DestroyDen1 takes nothing returns nothing
    set gg_trg_Wolves_DestroyDen1=CreateTrigger()
    call TriggerRegisterDeathEvent(gg_trg_Wolves_DestroyDen1, gg_dest_B00C_1903)
    call TriggerAddAction(gg_trg_Wolves_DestroyDen1, function Trig_Wolves_DestroyDen1_Actions)
endfunction

