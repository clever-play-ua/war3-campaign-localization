function Trig_Intro_Cinematic_BoatSounds_Func010001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_BoatSounds_Func013001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_BoatSounds_Func016001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_BoatSounds_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundOnUnitBJ(gg_snd_BoatYes1, 50.00, udg_Unit_CinematicTransportArr[1])
    call TriggerSleepAction(GetSoundDurationBJ(gg_snd_BoatYes1))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundOnUnitBJ(gg_snd_BoatYes2, 50.00, udg_Unit_CinematicTransportArr[1])
    call TriggerSleepAction(GetSoundDurationBJ(gg_snd_BoatYes2))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundOnUnitBJ(gg_snd_BoatWhat1, 50.00, udg_Unit_CinematicTransportArr[1])
    call TriggerSleepAction(GetSoundDurationBJ(gg_snd_BoatWhat1))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundOnUnitBJ(gg_snd_BoatWhat2, 50.00, udg_Unit_CinematicTransportArr[1])
    call TriggerSleepAction(GetSoundDurationBJ(gg_snd_BoatWhat2))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundOnUnitBJ(gg_snd_BoatWhat3, 50.00, udg_Unit_CinematicTransportArr[1])
    call TriggerSleepAction(GetSoundDurationBJ(gg_snd_BoatWhat3))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
endfunction

