function Trig_Init_01_Players_Actions takes nothing returns nothing
    set udg_Actual_Player=Player(0)
    call SetPlayerName(udg_Actual_Player, "TRIGSTR_2190")
    // //
    set udg_Player_BTG=Player(20)
    // //
