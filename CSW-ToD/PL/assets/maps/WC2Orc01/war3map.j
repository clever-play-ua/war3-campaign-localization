//===========================================================================
// Trigger: Wolves Cinematic Q
//===========================================================================
function Trig_Wolves_Cinematic_Q_Func025001 takes nothing returns boolean
    return ( udg_Bool_CinWolvesSkipped == true )
endfunction

function Trig_Wolves_Cinematic_Q_Func035001 takes nothing returns boolean
    return ( udg_Bool_CinWolvesSkipped == true )
endfunction

function Trig_Wolves_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call LeaderboardDisplayBJ(false, udg_Leaderboard_QuestObjectives)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, GetPlayersAll())
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_WolvesCinSetUp)
    call CameraSetupApplyForPlayer(true, gg_cam_Boar01, udg_Actual_Player, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Boar03, udg_Actual_Player, 7.00, 0, 1.00, 0)
    // //
    call IssuePointOrderLocBJ(gg_unit_nspp_0034, "move", GetRectCenter(gg_rct_BoarGo))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_Tension)
    // //
    set udg_Bool_CinWolvesOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_BG_Camp, 100, gg_unit_nspp_0034)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinWolvesSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundOnUnitBJ(gg_snd_QuillBoarWhat2, 100, gg_unit_nspp_0034)
    call SetUnitOwner(gg_unit_nspp_0034, Player(bj_PLAYER_NEUTRAL_VICTIM), false)
    call IssuePointOrderLocBJ(gg_unit_nspp_0034, "move", udg_Point_PigEscapes)
    call IssueTargetOrderBJ(gg_unit_nwwf_0028, "attack", gg_unit_nspp_0034)
    call IssueTargetOrderBJ(gg_unit_nwwf_0029, "attack", gg_unit_nspp_0034)
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, gg_unit_nwwf_0028)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinWolvesSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueTargetOrderBJ(gg_unit_nwwf_0030, "attack", gg_unit_nspp_0034)
    call SetUnitAnimation(gg_unit_nspp_0034, "death")
    // //
    call PauseUnitBJ(true, gg_unit_nspp_0034)
    call PlaySoundOnUnitBJ(gg_snd_QuillboarDeath, 100, gg_unit_nspp_0034)
    call StopSoundBJ(gg_snd_Tension, true)
    // //
    call ConditionalTriggerExecute(gg_trg_Wolves_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Wolves_Cinematic_Q takes nothing returns nothing
    set gg_trg_Wolves_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Wolves_Cinematic_Q, function Trig_Wolves_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: WolvesCinSetUp
//===========================================================================
function Trig_WolvesCinSetUp_Func005001002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) )
endfunction

function Trig_WolvesCinSetUp_Func006002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_WolvesCinSetUp_Func009002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_WolvesCinSetUp_Func011002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_WolvesCinSetUp_Func024002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_WolvesCinSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_WolvesCinSetUp_Func005001002)), udg_Group_PausedUnits)
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_WolvesCinSetUp_Func006002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_WolfCinHide, udg_Actual_Player), function Trig_WolvesCinSetUp_Func009002)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_WolvesCinSetUp_Func011002)
    // //
    call ShowUnitShow(gg_unit_nwwf_0030)
    call ShowUnitShow(gg_unit_nwwf_0029)
    call ShowUnitShow(gg_unit_nwwf_0028)
    call ShowUnitShow(gg_unit_nspp_0034)
    // //
    call SetUnitPositionLocFacingLocBJ(gg_unit_nspp_0034, GetRectCenter(gg_rct_BoarStart), udg_Point_PigEscapes)
    call SetUnitPositionLocFacingLocBJ(gg_unit_nwwf_0030, GetRectCenter(gg_rct_Wolf03Start), GetRectCenter(gg_rct_BoarStart))
    call SetUnitPositionLocFacingLocBJ(gg_unit_nwwf_0029, GetRectCenter(gg_rct_Wolf01Start), udg_Point_PigEscapes)
    call SetUnitPositionLocFacingLocBJ(gg_unit_nwwf_0028, GetRectCenter(gg_rct_Wolf02Start), udg_Point_PigEscapes)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Wolves), function Trig_WolvesCinSetUp_Func024002)
    // //
endfunction

//===========================================================================
function InitTrig_WolvesCinSetUp takes nothing returns nothing
    set gg_trg_WolvesCinSetUp=CreateTrigger()
    call TriggerAddAction(gg_trg_WolvesCinSetUp, function Trig_WolvesCinSetUp_Actions)
endfunction

//===========================================================================
// Trigger: Wolves Cinematic Skipped
//===========================================================================
function Trig_Wolves_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinWolvesOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wolves_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call StopSoundBJ(gg_snd_Tension, false)
    set udg_Bool_CinWolvesSkipped=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_Wolves_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Wolves_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Wolves_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Wolves_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Wolves_Cinematic_Skipped, Condition(function Trig_Wolves_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Wolves_Cinematic_Skipped, function Trig_Wolves_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Wolves Cinematic Cleanup
//===========================================================================
function Trig_Wolves_Cinematic_Cleanup_Func004C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wolves_Cinematic_Cleanup_Func006002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Wolves_Cinematic_Cleanup_Func008002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Wolves_Cinematic_Cleanup_Func009002 takes nothing returns nothing
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_PausedUnits)
endfunction

function Trig_Wolves_Cinematic_Cleanup_Func031C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wolves_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinWolvesOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Wolves_Cinematic_Cleanup_Func004C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Wolves_Cinematic_Cleanup_Func006002)
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_Wolves_Cinematic_Cleanup_Func008002)
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_Wolves_Cinematic_Cleanup_Func009002)
    // //
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_BONE, 'nspp', udg_Actual_Player, GetUnitLoc(gg_unit_nspp_0034), GetUnitFacing(gg_unit_nspp_0034))
    call RemoveUnit(gg_unit_nspp_0034)
    // //
    call SetUnitOwner(gg_unit_nwwf_0028, udg_Player_Wolves, true)
    call SetUnitOwner(gg_unit_nwwf_0030, udg_Player_Wolves, true)
    call SetUnitOwner(gg_unit_nwwf_0029, udg_Player_Wolves, true)
    call IssuePointOrderLocBJ(gg_unit_nwwf_0028, "attack", udg_Point_WolvesAttackAnchor)
    call IssuePointOrderLocBJ(gg_unit_nwwf_0030, "attack", udg_Point_WolvesAttackAnchor)
    call IssuePointOrderLocBJ(gg_unit_nwwf_0029, "attack", udg_Point_WolvesAttackAnchor)
    // //
    call ShowUnitShow(gg_unit_nwlt_0033)
    call ShowUnitShow(gg_unit_nwlt_0032)
    call ShowUnitShow(gg_unit_nwlt_0031)
    // //
    call ResetToGameCameraForPlayer(udg_Actual_Player, 0)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    call CinematicModeBJ(false, GetPlayersAll())
    call LeaderboardDisplayBJ(true, udg_Leaderboard_QuestObjectives)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Wolves_Cinematic_Cleanup_Func031C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Wolves_Cinematic_Q)
    call TriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

