//===========================================================================
// Trigger: PeonDies Sound
//===========================================================================
function Trig_PeonDies_Sound_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetAttackedUnitBJ()) == udg_Actual_Player ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_PEON) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetAttacker()) == udg_Player_Wolves ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetAttackedUnitBJ()) < 15.00 ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinHumansOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinHumKilledOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_PeonDies_Sound_Func008C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PeonDies_Sound_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_PeonDies_Sound_Func008C() ) then
        call PlaySoundBJ(gg_snd_WC2Orc01Peon2)
    else
        call PlaySoundBJ(gg_snd_WC2Orc01Peon3)
    endif
    call PolledWait(2)
    call EnableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_PeonDies_Sound takes nothing returns nothing
    set gg_trg_PeonDies_Sound=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_PeonDies_Sound, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_PeonDies_Sound, Condition(function Trig_PeonDies_Sound_Conditions))
