//===========================================================================
function Trig_Intro_Cinematic_Q_Func005001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func022001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func026001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func030001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func042001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Func046001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

