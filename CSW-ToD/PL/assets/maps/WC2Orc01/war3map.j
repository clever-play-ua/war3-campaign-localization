    set udg_Rend_TempPoint_Q=GetSpellTargetLoc()
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(256.00, udg_Rend_TempPoint_Q, Condition(function Trig_Rend_I_Rend_Func004001003)), function Trig_Rend_I_Rend_Func004A)
    //  
    call EnumDestructablesInCircleBJ(256.00, udg_Rend_TempPoint_Q, function Trig_Rend_I_Rend_Func006A)
    //  
    call RemoveLocation(udg_Rend_TempPoint_Q)
endfunction

