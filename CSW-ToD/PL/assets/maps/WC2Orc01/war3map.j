//===========================================================================
// Trigger: HumanTaunt Sound
//===========================================================================
function Trig_HumanTaunt_Sound_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetAttackedUnitBJ()) == udg_Player_Humans ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( GetAttackedUnitBJ() != udg_Unit_Captain ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumanTaunt_Sound_Func007001 takes nothing returns boolean
    return ( udg_Bool_CinHumKilledOn == true )
endfunction

function Trig_HumanTaunt_Sound_Func009Func001Func001Func001Func002C takes nothing returns boolean
    if ( not ( udg_Real_Chance > 80.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumanTaunt_Sound_Func009Func001Func001Func001C takes nothing returns boolean
    if ( not ( udg_Real_Chance > 64.00 ) ) then
        return false
    endif
    if ( not ( udg_Real_Chance <= 80.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumanTaunt_Sound_Func009Func001Func001C takes nothing returns boolean
    if ( not ( udg_Real_Chance > 48.00 ) ) then
        return false
    endif
    if ( not ( udg_Real_Chance <= 64.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumanTaunt_Sound_Func009Func001C takes nothing returns boolean
    if ( not ( udg_Real_Chance > 32.00 ) ) then
        return false
    endif
    if ( not ( udg_Real_Chance <= 48.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumanTaunt_Sound_Func009C takes nothing returns boolean
    if ( not ( udg_Real_Chance <= 32.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumanTaunt_Sound_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(1.00)
    if ( (udg_Bool_CinHumKilledOn == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    set udg_Real_Chance=GetRandomPercentageBJ()
    if ( Trig_HumanTaunt_Sound_Func009C() ) then
        call PlaySoundOnUnitBJ(gg_snd_FootmanWarcry1, 100, GetAttackedUnitBJ())
    else
        if ( Trig_HumanTaunt_Sound_Func009Func001C() ) then
            call PlaySoundOnUnitBJ(gg_snd_FootmanYesAttack3, 100, GetAttackedUnitBJ())
        else
            if ( Trig_HumanTaunt_Sound_Func009Func001Func001C() ) then
                call PlaySoundOnUnitBJ(gg_snd_O07FootmanA1101, 100, GetAttackedUnitBJ())
            else
                if ( Trig_HumanTaunt_Sound_Func009Func001Func001Func001C() ) then
                    call PlaySoundOnUnitBJ(gg_snd_FootmanYesAttack2, 100, GetAttackedUnitBJ())
                else
                    if ( Trig_HumanTaunt_Sound_Func009Func001Func001Func001Func002C() ) then
                        call DoNothing()
                    else
                    endif
                endif
            endif
        endif
    endif
endfunction

//===========================================================================
function InitTrig_HumanTaunt_Sound takes nothing returns nothing
    set gg_trg_HumanTaunt_Sound=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HumanTaunt_Sound, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_HumanTaunt_Sound, Condition(function Trig_HumanTaunt_Sound_Conditions))
    call TriggerAddAction(gg_trg_HumanTaunt_Sound, function Trig_HumanTaunt_Sound_Actions)
endfunction

