//===========================================================================
// Trigger: Landing UpdateCompleted Q
//===========================================================================
function Trig_Landing_UpdateCompleted_Q_Func001Func007C takes nothing returns boolean
    if ( not ( udg_Int_QuestLand_PigFarmsBuilt >= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Landing_UpdateCompleted_Q_Func001Func008C takes nothing returns boolean
    if ( not ( udg_Int_QuestLanding_BarracksCount >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Landing_UpdateCompleted_Q_Func001C takes nothing returns boolean
    if ( not ( udg_Int_QuestLanding_BarracksCount >= 1 ) ) then
        return false
    endif
    if ( not ( udg_Int_QuestLand_PigFarmsBuilt >= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Landing_UpdateCompleted_Q_Actions takes nothing returns nothing
    if ( Trig_Landing_UpdateCompleted_Q_Func001C() ) then
        call QuestSetCompletedBJ(udg_MQ_Landing, true)
        call QuestItemSetDescriptionBJ(udg_MQReq_Landing_BuildPigFarms, "TRIGSTR_2406")
        call QuestItemSetCompletedBJ(udg_MQReq_Landing_BuildBarracks, true)
        call QuestItemSetCompletedBJ(udg_MQReq_Landing_BuildPigFarms, true)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2256")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
        call PolledWait(10.00)
        call QueuedTriggerAddBJ(gg_trg_Wolves_Cinematic_Q, true)
    else
        set udg_newLine="\n"
        // //
        set udg_String_CompletedQuests=( GetItemName(gg_item_IQL1_0062) + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL1_0062) ) )
        // //
        if ( Trig_Landing_UpdateCompleted_Q_Func001Func007C() ) then
            call QuestItemSetDescriptionBJ(udg_MQReq_Landing_BuildPigFarms, "TRIGSTR_2296")
            call QuestItemSetCompletedBJ(udg_MQReq_Landing_BuildPigFarms, true)
            // //
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL2_0063) ) )
            // //
        else
            call QuestItemSetDescriptionBJ(udg_MQReq_Landing_BuildPigFarms, ( BlzGetItemExtendedTooltip(gg_item_IQL5_0066) + ( I2S(udg_Int_QuestLand_PigFarmsBuilt) + BlzGetItemTooltip(gg_item_IQL2_0063) ) ))
            // //
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL2_0063) + ( I2S(udg_Int_QuestLand_PigFarmsBuilt) + BlzGetItemTooltip(gg_item_IQL2_0063) ) ) ) )
            // //
        endif
        if ( Trig_Landing_UpdateCompleted_Q_Func001Func008C() ) then
            call QuestItemSetCompletedBJ(udg_MQReq_Landing_BuildBarracks, true)
            // //
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL1_0062) ) )
            // //
        else
            // //
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL1_0062) ) )
            // //
        endif
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    endif
endfunction

