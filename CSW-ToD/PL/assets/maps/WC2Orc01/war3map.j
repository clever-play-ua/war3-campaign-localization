//===========================================================================
// Trigger: HumansArrivalCinSetUp
//===========================================================================
function Trig_HumansArrivalCinSetUp_Func005001002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) )
endfunction

function Trig_HumansArrivalCinSetUp_Func006002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_HumansArrivalCinSetUp_Func009002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_HumansArrivalCinSetUp_Func012001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Actual_Player )
endfunction

function Trig_HumansArrivalCinSetUp_Func012001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_HumansArrivalCinSetUp_Func012001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Actual_Player), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_HumansArrivalCinSetUp_Func012002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_HumansArrivalCinSetUp_Func014002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_HumansArrivalCinSetUp_Func016C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_SemiHero_Utok) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumansArrivalCinSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_HumansArrivalCinSetUp_Func005001002)), udg_Group_PausedUnits)
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_HumansArrivalCinSetUp_Func006002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(1)), function Trig_HumansArrivalCinSetUp_Func009002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_HumanInvasionArea, Condition(function Trig_HumansArrivalCinSetUp_Func012001002)), function Trig_HumansArrivalCinSetUp_Func012002)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_HumansArrivalCinSetUp_Func014002)
    // //
    if ( Trig_HumansArrivalCinSetUp_Func016C() ) then
        call ShowUnitHide(udg_SemiHero_Utok)
    else
    endif
    // //
    call ShowUnitShow(udg_FakeUtok)
    call PauseUnitBJ(false, udg_FakeUtok)
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_HumansArrivalCinUtok), 153.91)
    call SetUnitOwner(udg_FakeUtok, udg_Actual_Player, false)
    call SetUnitAnimationWithRarity(udg_FakeUtok, "stand", RARITY_FREQUENT)
    // //
    call ShowUnitShow(gg_unit_nbsp_0048)
    call ShowUnitShow(gg_unit_hdes_0016)
    // //
    call ShowDestructableBJ(true, gg_dest_B005_1940)
    call ShowDestructableBJ(true, gg_dest_LTcr_1048)
    // //
    call ShowUnitShow(udg_Unit_Captain)
    call ShowUnitShow(udg_Unit_Footman01)
    call ShowUnitShow(udg_Unit_Footman02)
    call ShowUnitShow(udg_Unit_Footman03)
    // //
    call SetUnitAnimation(udg_Unit_Footman01, "Cinematic Sitting One")
    call SetUnitAnimation(udg_Unit_Footman02, "Cinematic Sitting One")
    call SetUnitAnimation(udg_Unit_Footman03, "Cinematic Sitting One")
    call SetUnitBlendTimeBJ(udg_Unit_Footman01, 0.25)
    call SetUnitBlendTimeBJ(udg_Unit_Footman02, 0.25)
    call SetUnitBlendTimeBJ(udg_Unit_Footman03, 0.25)
    call SetUnitBlendTimeBJ(udg_Unit_Captain, 0.25)
    call SetUnitAnimationWithRarity(udg_Unit_Captain, "stand", RARITY_FREQUENT)
endfunction

//===========================================================================
function InitTrig_HumansArrivalCinSetUp takes nothing returns nothing
    set gg_trg_HumansArrivalCinSetUp=CreateTrigger()
    call TriggerAddAction(gg_trg_HumansArrivalCinSetUp, function Trig_HumansArrivalCinSetUp_Actions)
endfunction

//===========================================================================
// Trigger: Humans Cinematic Skipped
//===========================================================================
function Trig_Humans_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinHumansOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Humans_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinHumansSkipped=true
    call ConditionalTriggerExecute(gg_trg_Humans_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Humans_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Humans_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Humans_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Humans_Cinematic_Skipped, Condition(function Trig_Humans_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Humans_Cinematic_Skipped, function Trig_Humans_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Humans Cinematic Cleanup
//===========================================================================
function Trig_Humans_Cinematic_Cleanup_Func006C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Humans_Cinematic_Cleanup_Func025002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Humans_Cinematic_Cleanup_Func027C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Humans_Cinematic_Cleanup_Func029C takes nothing returns boolean
    if ( not ( udg_Bool_CinHumansSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Humans_Cinematic_Cleanup_Func036Func001Func002C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B60S' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B60N' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return true
    endif
    return false
endfunction

