//===========================================================================
function Trig_HumanTaunt_SoundOn_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Humans ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumanTaunt_SoundOn_Func002C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_HumanTaunt_Sound) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HumanTaunt_SoundOn_Actions takes nothing returns nothing
    if ( Trig_HumanTaunt_SoundOn_Func002C() ) then
        call EnableTrigger(gg_trg_HumanTaunt_Sound)
    else
    endif
endfunction

