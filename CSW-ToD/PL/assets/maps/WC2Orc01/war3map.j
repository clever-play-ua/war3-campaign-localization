function Trig_WolfAttackRepeatingWave01A_Actions takes nothing returns nothing
    // ******Wave01******
    // FrostWolf
    // ***NorthDen***
    if ( Trig_WolfAttackRepeatingWave01A_Func006C() ) then
        if ( Trig_WolfAttackRepeatingWave01A_Func006Func001C() ) then
            call CreateNUnitsAtLoc(1, 'nwwf', udg_Player_Wolves, GetRectCenter(gg_rct_WolfLair), 270.00)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_WolvesAttackAnchor)
        else
        endif
    else
    endif
    // EastDen
    if ( Trig_WolfAttackRepeatingWave01A_Func008C() ) then
        if ( Trig_WolfAttackRepeatingWave01A_Func008Func001C() ) then
            call CreateNUnitsAtLoc(1, 'nwwf', udg_Player_Wolves, GetRectCenter(gg_rct_WolfLair02), 335.00)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_WolvesAttackAnchor)
        else
        endif
    else
    endif
    // WestDen
    if ( Trig_WolfAttackRepeatingWave01A_Func010C() ) then
        if ( Trig_WolfAttackRepeatingWave01A_Func010Func001C() ) then
            call CreateNUnitsAtLoc(1, 'nwwf', udg_Player_Wolves, GetRectCenter(gg_rct_WolfLair03), 0.00)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_WolvesAttackAnchor)
        else
        endif
    else
    endif
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call PolledWait(10.00)
    if ( (GetBooleanOr((IsQuestCompleted(udg_OQ_Wolves) == true), (udg_GameOver == true))) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call QueuedTriggerAddBJ(gg_trg_WolfAttackRepeatingWave01B, true)
endfunction

