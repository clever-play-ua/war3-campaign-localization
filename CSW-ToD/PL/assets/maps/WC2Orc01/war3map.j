function Trig_Humans_Cinematic_CaptainTurn_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinHumansOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_Unit_Captain ) ) then
        return false
    endif
    return true
endfunction

