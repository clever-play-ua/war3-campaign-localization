    if ( not ( GetUnitTypeId(GetTrainedUnit()) == 'o605' ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokRevival_Actions takes nothing returns nothing
    set udg_SemiHero_Utok=GetTrainedUnit()
endfunction

