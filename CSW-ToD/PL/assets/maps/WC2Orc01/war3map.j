    call SetPlayerOnScoreScreenBJ(false, udg_Player_Wolves)
    // //
    set udg_Player_Humans=Player(1)
    call SetPlayerColorBJ(udg_Player_Humans, PLAYER_COLOR_SNOW, true)
    // //
    set udg_Player_CinematicOrcs=Player(4)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicOrcs)
    // //
    // Resources and Tech
    // //
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Actual_Player)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Actual_Player)
    call SetPlayerAbilityAvailableBJ(false, 'A610', udg_Actual_Player)
    call SetPlayerFlagBJ(PLAYER_STATE_GIVES_BOUNTY, false, Player(PLAYER_NEUTRAL_AGGRESSIVE))
