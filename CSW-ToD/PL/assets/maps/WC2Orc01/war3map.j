function Trig_Humans_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call LeaderboardDisplayBJ(false, udg_Leaderboard_QuestObjectives)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_HumansArrivalCinSetUp)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Human00, Player(0), 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_DarkAgents)
    // //
    // CinematicStarted
    // //
    set udg_Bool_CinHumansOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Human01, udg_Actual_Player, ( GetSoundDurationBJ(gg_snd_WC2Orc01Captain1) + 2.00 ), 0.50, 1.00, 100.00)
    // //
    call SetUnitAnimation(udg_Unit_Captain, "Stand VIctory")
    call QueueUnitAnimationBJ(udg_Unit_Captain, "stand")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_Captain, 0, gg_snd_WC2Orc01Captain1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_Unit_Captain, "move", GetRectCenter(gg_rct_Captain_Speak))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_Unit_Footman01, "move", GetRectCenter(gg_rct_Footman04))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Human04, udg_Actual_Player, 8.00, 1.00, 2.00, 100.00)
    // //
    call PlaySoundBJ(gg_snd_CS_BG_Camp)
    call IssuePointOrderLocBJ(udg_Unit_Footman02, "move", GetRectCenter(gg_rct_Footman03))
    // //
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_Unit_Footman03, "move", GetRectCenter(gg_rct_Footman02))
    call PlaySoundBJ(gg_snd_CS_HU_2_Intro_Foley201)
    loop
        exitwhen ( (RectContainsUnit(gg_rct_Footman02, udg_Unit_Footman03) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceLocTimed(udg_Unit_Footman02, udg_Point_PitfireHumanCamp, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_Footman02, "Cinematic Wave One")
    call QueueUnitAnimationBJ(udg_Unit_Footman02, "Cinematic Stand")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundOnUnitBJ(gg_snd_MetalLightSliceMetal1, 100, udg_Unit_Footman03)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceLocTimed(udg_Unit_Footman01, udg_Point_PitfireHumanCamp, 1.00)
    call SetDoodadAnimationRectBJ("death", 'NOfp', gg_rct_Pitfire)
    call SetUnitLookAt(udg_Unit_Footman03, "bone_head", udg_Unit_Captain, 0, 0, 90)
    call SetUnitLookAt(udg_Unit_Footman03, "bone_chest", udg_Unit_Captain, 0, 0, 90)
    call SetUnitAnimation(udg_Unit_Footman03, "Cinematic Headnod One")
    call QueueUnitAnimationBJ(udg_Unit_Footman03, "Cinematic Listening One")
    call SetUnitLookAt(udg_Unit_Captain, "bone_head", udg_Unit_Footman03, 0, 0, 90)
    call SetUnitFacingToFaceUnitTimed(udg_Unit_Captain, udg_Unit_Footman03, 0.50)
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_Footman03, 0, gg_snd_WC2Orc01footman1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueBuildOrderByIdLocBJ(udg_Unit_Footman01, 'h620', GetRectCenter(gg_rct_TentB))
    call IssueBuildOrderByIdLocBJ(udg_Unit_Footman02, 'h620', GetRectCenter(gg_rct_TentA))
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Human03, udg_Actual_Player, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Human05, udg_Actual_Player, ( GetSoundDurationBJ(gg_snd_WC2Orc01Captain2) + ( GetSoundDurationBJ(gg_snd_WC2Orc01Captain3) + ( GetSoundDurationBJ(gg_snd_WC2Orc01footman2) + GetSoundDurationBJ(gg_snd_WC2Orc01Footman3) ) ) ))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_Unit_Footman02, udg_Unit_Captain, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_Footman02, "Cinematic Standard One")
    call SetUnitAnimation(udg_Unit_Footman02, "Cinematic Point One")
    call QueueUnitAnimationBJ(udg_Unit_Footman02, "Cinematic Listening One")
    // //
    call PlaySoundAtPointBJ(gg_snd_OrcBuildingBirthWhat1, 100, GetRectCenter(gg_rct_TentA), 0)
    call SetUnitLookAt(udg_Unit_Captain, "bone_head", udg_Unit_Footman02, 0, 0, 90)
    call SetUnitFacingToFaceUnitTimed(udg_Unit_Captain, udg_Unit_Footman02, 0.50)
    call SetUnitFacingToFaceUnitTimed(udg_Unit_Footman02, udg_Unit_Captain, 1.00)
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_Footman02, 0, gg_snd_WC2Orc01footman2, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitLookAt(udg_Unit_Footman02, "bone_head", udg_Unit_Captain, 0, 0, 90)
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc01footman2) - 1 ))
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_Footman02, "Cinematic Listening One")
    call PlaySoundAtPointBJ(gg_snd_OrcBuildingBirthWhat1, 100, GetRectCenter(gg_rct_TentA), 0)
    call SetUnitLookAt(udg_Unit_Captain, "bone_head", udg_Unit_Footman03, 0, 0, 90)
    call SetUnitFacingToFaceLocTimed(udg_Unit_Captain, GetRectCenter(gg_rct_Pitfire), 0.50)
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_Captain, 0, gg_snd_WC2Orc01Captain2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_Captain, 0, gg_snd_WC2Orc01Captain3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetDoodadAnimationRectBJ("stand", 'NOfp', gg_rct_Pitfire)
    call SetSoundPositionLocBJ(gg_snd_AshenvaleBrazierLoop1, udg_Point_PitfireHumanCamp, 0)
    call ResetUnitLookAt(udg_Unit_Footman03)
    call SetUnitFacingToFaceLocTimed(udg_Unit_Footman03, udg_Point_PitfireHumanCamp, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_Footman03, 0, gg_snd_WC2Orc01Footman3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // UtokSeeShips
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetTerrainFogExBJ(0, 1000, 5500.00, 0.50, 31.00, 49.00, 52.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_HumansAppear, udg_Actual_Player, 0)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // UtokSeeShips
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call SetCameraFieldForPlayer(udg_Actual_Player, CAMERA_FIELD_FIELD_OF_VIEW, 60.00, GetSoundDurationBJ(gg_snd_WC2Orc01Utok2))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(GetPlayersAll(), udg_FakeUtok, 0, gg_snd_WC2Orc01Utok2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinHumansSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_DarkAgents, true)
    // //
    call ConditionalTriggerExecute(gg_trg_Humans_Cinematic_Cleanup)
endfunction

