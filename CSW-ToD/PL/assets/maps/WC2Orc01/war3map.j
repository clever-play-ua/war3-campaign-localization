    if ( not ( GetEnteringUnit() == udg_FakeRend ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_IntroOrcsMoving_Func003Func002001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_Grunt03, gg_unit_o619_0007) == true )
endfunction

function Trig_Intro_Cinematic_IntroOrcsMoving_Func003Func003001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

