    call CreateFogModifierRadiusLocBJ(true, Player(0), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Pig_Farm), 256.00)
    call SetTimeOfDay(5.00)
    // //
    // InitLocations
    // //
    set udg_Point_PitfireHumanCamp=GetRectCenter(gg_rct_Pitfire)
    set udg_Point_PigEscapes=GetRectCenter(gg_rct_PigEscapes)
    set udg_Point_WolvesAttackAnchor=GetRectCenter(gg_rct_OrcCamp)
    set udg_Point_CreatePeons=GetRectCenter(gg_rct_CreatePeons)
    set udg_Point_OutroPeonFacingPoint=GetRectCenter(gg_rct_PeonFinal02)
    set udg_Point_OutroPeonWork=GetRectCenter(gg_rct_PeonFinal03)
    set udg_Point_OutroPeonSpawnPointArr[1]=GetRectCenter(gg_rct_PeonFinal01)
    set udg_Point_OutroPeonSpawnPointArr[2]=GetRectCenter(gg_rct_PeonFinal00)
    // //
    // Hide Localiztion Items
    // //
    call SetItemVisibleBJ(false, gg_item_IQL4_0065)
    call SetItemVisibleBJ(false, gg_item_IQL1_0062)
    call SetItemVisibleBJ(false, gg_item_IQL5_0066)
    call SetItemVisibleBJ(false, gg_item_IQL3_0064)
    call SetItemVisibleBJ(false, gg_item_IQL2_0063)
    call SetItemVisibleBJ(false, gg_item_IQL6_0084)
    // //
    // //
    // //
endfunction

