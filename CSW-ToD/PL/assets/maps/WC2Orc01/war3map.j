endfunction

//===========================================================================
// Trigger: Landing Update PigFarms
//===========================================================================
function Trig_Landing_Update_PigFarms_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'o60X' ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_MQ_Landing) == false ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetConstructedStructure()) == udg_Actual_Player ) ) then
        return false
    endif
    return true
endfunction

function Trig_Landing_Update_PigFarms_Func002C takes nothing returns boolean
    if ( not ( udg_Int_QuestLand_PigFarmsBuilt == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Landing_Update_PigFarms_Func003C takes nothing returns boolean
    if ( not ( udg_Int_QuestLand_PigFarmsBuilt == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Landing_Update_PigFarms_Func004C takes nothing returns boolean
    if ( not ( udg_Int_QuestLand_PigFarmsBuilt == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Landing_Update_PigFarms_Func005C takes nothing returns boolean
    if ( not ( udg_Int_QuestLand_PigFarmsBuilt == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Landing_Update_PigFarms_Actions takes nothing returns nothing
    set udg_Int_QuestLand_PigFarmsBuilt=( udg_Int_QuestLand_PigFarmsBuilt + 1 )
    if ( Trig_Landing_Update_PigFarms_Func002C() ) then
        call ShowUnitShow(gg_unit_npig_0002)
        call ShowUnitShow(gg_unit_npig_0003)
    else
    endif
    if ( Trig_Landing_Update_PigFarms_Func003C() ) then
        call ShowUnitShow(gg_unit_npig_0023)
        call ShowUnitShow(gg_unit_npig_0024)
    else
    endif
    if ( Trig_Landing_Update_PigFarms_Func004C() ) then
        call ShowUnitShow(gg_unit_npig_0025)
        call ShowUnitShow(gg_unit_npig_0022)
    else
    endif
    if ( Trig_Landing_Update_PigFarms_Func005C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call ShowUnitShow(gg_unit_npig_0019)
        call ShowUnitShow(gg_unit_npig_0020)
        call LeaderboardRemovePlayerItemBJ(Player(0), udg_Leaderboard_QuestObjectives)
    else
    endif
    call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_QuestObjectives, udg_Int_QuestLand_PigFarmsBuilt)
    call QueuedTriggerAddBJ(gg_trg_Landing_UpdateCompleted_Q, true)
    call TriggerSleepAction(1.00)
    call PlaySoundBJ(gg_snd_PigFarmWhat1)
endfunction

