    set gg_trg_Intro_Cinematic_BoatSounds=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_BoatSounds, function Trig_Intro_Cinematic_BoatSounds_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic BoatAboarding
//===========================================================================
function Trig_Intro_Cinematic_BoatAboarding_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Unit_CinematicTransportArr[1] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_BoatAboarding_Func004001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_BoatAboarding_Func008001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_BoatAboarding_Func013001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_BoatAboarding_Func020001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_BoatAboarding_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundAtPointBJ(gg_snd_Loading, 100, GetRectCenter(gg_rct_IntroUnloadTransport), 0)
    call ShowUnitShow(udg_FakeRend)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_IntroTurningPoint01))
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    call PlaySoundBJ(gg_snd_CS_BG_Camp)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_IntroDialogueA, udg_Actual_Player, 7.00, 1.00, 2.00, 100.00)
    call PlaySoundAtPointBJ(gg_snd_Loading01, 100, GetRectCenter(gg_rct_IntroUnloadTransport), 0)
    call SetUnitPositionLocFacingBJ(gg_unit_o619_0007, GetRectCenter(gg_rct_IntroUnloadTransport), 125.00)
    call ShowUnitShow(gg_unit_o619_0007)
    call IssuePointOrderLocBJ(gg_unit_o619_0007, "move", GetRectCenter(gg_rct_IntroTurningPoint01))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundAtPointBJ(gg_snd_Loading02, 100, GetRectCenter(gg_rct_IntroUnloadTransport), 0)
    call SetUnitPositionLocFacingBJ(gg_unit_o619_0008, GetRectCenter(gg_rct_IntroUnloadTransport), 125.00)
    call ShowUnitShow(gg_unit_o619_0008)
    call IssuePointOrderLocBJ(gg_unit_o619_0008, "move", GetRectCenter(gg_rct_IntroTurningPoint01))
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_BoatAboarding takes nothing returns nothing
    set gg_trg_Intro_Cinematic_BoatAboarding=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Intro_Cinematic_BoatAboarding, gg_rct_Boat02)
    call TriggerAddCondition(gg_trg_Intro_Cinematic_BoatAboarding, Condition(function Trig_Intro_Cinematic_BoatAboarding_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_BoatAboarding, function Trig_Intro_Cinematic_BoatAboarding_Actions)
endfunction

