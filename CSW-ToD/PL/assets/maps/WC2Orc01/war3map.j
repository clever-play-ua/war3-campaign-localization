//===========================================================================
// Trigger: Init 05 Quests
//===========================================================================
function Trig_Init_05_Quests_Actions takes nothing returns nothing
    // MAIN QUEST: LANDING
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_2220", "TRIGSTR_2221", "ReplaceableTextures\\CommandButtons\\BTNBasicStruct.blp")
    set udg_MQ_Landing=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQ_Landing, "TRIGSTR_2223")
    set udg_MQReq_Landing_BuildPigFarms=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQ_Landing, "TRIGSTR_2222")
    set udg_MQReq_Landing_BuildBarracks=GetLastCreatedQuestItemBJ()
    // MAIN QUEST: FUEL THE FIRES
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_2224", "TRIGSTR_2225", "ReplaceableTextures\\CommandButtons\\BTNGatherGold.blp")
    set udg_MQ_Fuel=GetLastCreatedQuestBJ()
    // MAIN QUEST: FIRST BLOOD
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_2237", "TRIGSTR_2238", "ReplaceableTextures\\CommandButtons\\BTNHumanCaptureFlag.blp")
    set udg_MQ_FirstBlood=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQ_FirstBlood, "TRIGSTR_2239")
    set udg_MQReq_FirstBlood_PutOutSignal=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQ_FirstBlood, "TRIGSTR_2240")
    set udg_MQReq_FirstBlood_KillScouts=GetLastCreatedQuestItemBJ()
    // OPTIONAL QUEST: WOLVES
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2230", "TRIGSTR_2231", "ReplaceableTextures\\CommandButtons\\BTNTimberWolf.blp")
    set udg_OQ_Wolves=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQ_Wolves, "TRIGSTR_2232")
    set udg_OQReq_Wolves_DestroyDens=GetLastCreatedQuestItemBJ()
    set udg_Int_QuestWolves_DensRemained=3
endfunction

