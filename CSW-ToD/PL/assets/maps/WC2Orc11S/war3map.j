//===========================================================================
// Trigger: AnasterianAlternateSummonCheckerLaunch
//
// This is safeguard for case when player usess chets or when player is sp efficient that wave 10 or 11 never reach the loa
//===========================================================================
function Trig_AnasterianAlternateSummonCheckerLaunch_Conditions takes nothing returns boolean
    if ( not ( udg_Int_Wave_Counter >= 9 ) ) then
        return false
    endif
    if ( not ( udg_Bool_Phase3 == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_AnasterianInBubble == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianAlternateSummonCheckerLaunch_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Bot) == 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Top) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianAlternateSummonCheckerLaunch_Actions takes nothing returns nothing
    call TriggerSleepAction(1.00)
    if ( Trig_AnasterianAlternateSummonCheckerLaunch_Func002C() ) then
        call EnableTrigger(gg_trg_AnasterianAlternateSummonCheckerLoop)
        call ConditionalTriggerExecute(gg_trg_AnasterianAlternateSummonCheckerLoop)
    else
    endif
endfunction

//===========================================================================
function InitTrig_AnasterianAlternateSummonCheckerLaunch takes nothing returns nothing
    set gg_trg_AnasterianAlternateSummonCheckerLaunch=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AnasterianAlternateSummonCheckerLaunch, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AnasterianAlternateSummonCheckerLaunch, Condition(function Trig_AnasterianAlternateSummonCheckerLaunch_Conditions))
    call TriggerAddAction(gg_trg_AnasterianAlternateSummonCheckerLaunch, function Trig_AnasterianAlternateSummonCheckerLaunch_Actions)
endfunction

//===========================================================================
// Trigger: AnasterianAlternateSummonCheckerLoop
//===========================================================================
function Trig_AnasterianAlternateSummonCheckerLoop_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_AnasterianInBubble == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001Func001Func002C takes nothing returns boolean
    if ( not ( udg_Bool_BotGoalEligible == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001Func001C takes nothing returns boolean
    if ( not ( udg_Bool_TopGoalEligible == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001Func002Func001C takes nothing returns boolean
    if ( not ( udg_Bool_BotGoalEligible == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001Func002C takes nothing returns boolean
    if ( not ( udg_Bool_TopGoalEligible == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001C takes nothing returns boolean
    if ( not ( udg_Bool_Phase1 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianAlternateSummonCheckerLoop_Func004C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Bot) == 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Top) == 0 ) ) then
        return false
    endif
    if ( not ( udg_Bool_AnasterianInBubble == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianAlternateSummonCheckerLoop_Actions takes nothing returns nothing
    call TriggerSleepAction(10.00)
    if ( Trig_AnasterianAlternateSummonCheckerLoop_Func004C() ) then
        if ( Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001C() ) then
            if ( Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001Func002C() ) then
                call DisableTrigger(GetTriggeringTrigger())
                set udg_Point_HelperSummonAnasterian=GetRectCenter(gg_rct_AnasterianDestorysEagleTemple)
                call CreateNUnitsAtLoc(1, 'u003', udg_Player_Elves, udg_Point_HelperSummonAnasterian, bj_UNIT_FACING)
                call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
                call RemoveLocation(udg_Point_HelperSummonAnasterian)
            else
                if ( Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001Func002Func001C() ) then
                    call DisableTrigger(GetTriggeringTrigger())
                    set udg_Point_HelperSummonAnasterian=GetRectCenter(gg_rct_AnasterianDestorysBearTemple)
                    call CreateNUnitsAtLoc(1, 'u003', udg_Player_Elves, udg_Point_HelperSummonAnasterian, bj_UNIT_FACING)
                    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
                    call RemoveLocation(udg_Point_HelperSummonAnasterian)
                else
                endif
            endif
        else
            if ( Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001Func001C() ) then
                call DisableTrigger(GetTriggeringTrigger())
                set udg_Point_HelperSummonAnasterian=GetRectCenter(gg_rct_AnasterianDestorysLynxTemple)
                call CreateNUnitsAtLoc(1, 'u003', udg_Player_Elves, udg_Point_HelperSummonAnasterian, bj_UNIT_FACING)
                call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
                call RemoveLocation(udg_Point_HelperSummonAnasterian)
            else
                if ( Trig_AnasterianAlternateSummonCheckerLoop_Func004Func001Func001Func002C() ) then
                    call DisableTrigger(GetTriggeringTrigger())
                    set udg_Point_HelperSummonAnasterian=GetRectCenter(gg_rct_LoaDragonhawkWalkZone)
                    call CreateNUnitsAtLoc(1, 'u003', udg_Player_Elves, udg_Point_HelperSummonAnasterian, bj_UNIT_FACING)
                    call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
                    call RemoveLocation(udg_Point_HelperSummonAnasterian)
                else
                endif
            endif
        endif
    else
    endif
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_AnasterianAlternateSummonCheckerLoop takes nothing returns nothing
    set gg_trg_AnasterianAlternateSummonCheckerLoop=CreateTrigger()
    call TriggerAddCondition(gg_trg_AnasterianAlternateSummonCheckerLoop, Condition(function Trig_AnasterianAlternateSummonCheckerLoop_Conditions))
    call TriggerAddAction(gg_trg_AnasterianAlternateSummonCheckerLoop, function Trig_AnasterianAlternateSummonCheckerLoop_Actions)
endfunction

//===========================================================================
// Trigger: AnasterianDestroysEagleTemple
//===========================================================================
function Trig_AnasterianDestroysEagleTemple_Func025C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Elves ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Humans ) ) then
        return true
    endif
    return false
endfunction

function Trig_AnasterianDestroysEagleTemple_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_Phase1 == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_TopGoalEligible == true ) ) then
        return false
    endif
    if ( not ( udg_Int_Wave_Counter >= 9 ) ) then
        return false
    endif
    if ( not Trig_AnasterianDestroysEagleTemple_Func025C() ) then
        return false
    endif
    if ( not ( udg_Bool_AnasterianInBubble == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianDestroysEagleTemple_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_MoveAnasterianToEagle)
    // //
    call ConditionalTriggerExecute(gg_trg_AnasterianBubbleOn)
    // //
    call QueuedTriggerAddBJ(gg_trg_WarningRetreatQ, true)
    call QueuedTriggerAddBJ(gg_trg_VOAnasterian02EagleQ, true)
