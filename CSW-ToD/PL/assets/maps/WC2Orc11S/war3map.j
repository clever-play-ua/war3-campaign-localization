function Trig_UlaTekCinematicQ_Func324001 takes nothing returns boolean
    return ( udg_UlatekCinematicSkipped == true )
endfunction

function Trig_UlaTekCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DestroyMinimapIcon(udg_MinimapIcon_Anasterian)
    call LeaderboardDisplayBJ(false, udg_Board_WavesCounter)
    // //
    if ( Trig_UlaTekCinematicQ_Func005C() ) then
        call PauseTimerBJ(true, udg_Timer_EnemySpawner)
        call TimerDialogDisplayBJ(false, udg_TimerWindowEnemySpawn)
    else
    endif
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_UlaTekCinematicQ_Func008A)
    // //
    // ///
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call ConditionalTriggerExecute(gg_trg_UlaTekCinematicSetUp)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_TharbekCin01, udg_Player_Actual, 0.00)
    call TriggerSleepAction(2.00)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // ///
    // ///
    set udg_UlatekCinematic=true
    set udg_InCinematic=true
    // TBD music and sound stuff here
    // ///
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ----------------------------------------------------------------------------------------
    // Scene 1: Tharbek
    // ----------------------------------------------------------------------------------------
    // ///
    call PlaySoundBJ(gg_snd_WC3OrcDefeat)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_TharbekCin02, udg_Player_Actual, 10.00)
    // ///
    call PauseUnitBJ(false, udg_U_UlaTekCinElvenCapt)
    call PauseUnitBJ(false, udg_FakeTharbek)
    call IssueTargetOrderBJ(udg_FakeTharbek, "attack", udg_U_UlaTekCinElvenCapt)
    call IssueTargetOrderBJ(udg_U_UlaTekCinElvenCapt, "attack", udg_FakeTharbek)
    // ///
    call TriggerSleepAction(3.00)
    if ( (udg_UlatekCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PauseUnitBJ(false, udg_FakeZuljin)
    call IssueTargetOrderBJ(udg_FakeZuljin, "attack", udg_U_UlaTekCinElvenCapt)
    // ///
    call TriggerSleepAction(0.50)
    if ( (udg_UlatekCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PauseUnitBJ(true, udg_U_UlaTekCinElvenCapt)
    call SetUnitInvulnerable(udg_U_UlaTekCinElvenCapt, true)
    call SetUnitAnimation(udg_U_UlaTekCinElvenCapt, "death")
    call SetUnitAnimation(udg_FakeTharbek, "cinematic injured one")
    // ///
    call IssuePointOrderLocBJ(udg_FakeZuljin, "move", GetRectCenter(gg_rct_TharbekCinZuljin02))
    // ///
    loop
        exitwhen ( (RectContainsUnit(gg_rct_TharbekCinZuljin02, udg_FakeZuljin) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_UlatekCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Tharbek Complains
    // ///
    call SetPlayerColorBJ(udg_Player_CinematicDummy, PLAYER_COLOR_MAROON, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc11STharbek_Final1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_UlatekCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Zuljin replies
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_TharbekCin03, udg_Player_Actual, 0.00)
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuljin, 0, gg_snd_WC2Orc11SZuljin_TharbekFarewell1, bj_TIMETYPE_ADD, 0, false)
