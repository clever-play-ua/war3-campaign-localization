//===========================================================================
// Trigger: EagleLoaSaved
//===========================================================================
function Trig_EagleLoaSaved_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_U_Loa_Eagle) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_EagleLoaSaved_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestItemSetCompletedBJ(udg_OQReqLoa[1], true)
    call RemoveGuardPosition(udg_U_Loa_Eagle)
    set udg_Point_LoaEscape=GetRectCenter(RectFromCenterSizeBJ(GetUnitLoc(udg_U_Loa_Eagle), 64.00, 64.00))
    call SetUnitInvulnerable(udg_U_Loa_Eagle, true)
    call UnitAddAbilityBJ('Aetl', udg_U_Loa_Eagle)
    call DestroyEffectBJ(udg_SE_LoaTeleportPrepare)
    call PauseUnitBJ(false, udg_U_Loa_Eagle)
    // //
    call AddSpecialEffectLocBJ(udg_Point_LoaEscape, "abilities\\spells\\special\\teleport\\teleportcaster.mdx")
    set udg_SE_LoaEscape=GetLastCreatedEffectBJ()
    call UnitAddItemByIdSwapped('stwp', udg_U_Loa_Eagle)
    set udg_Item_PortalEagle=GetLastCreatedItem()
    call UnitUseItemTarget(udg_U_Loa_Eagle, udg_Item_PortalEagle, gg_unit_nhcn_0332)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_CompletedQuestReqEagleLoaQ, true)
    call TriggerSleepAction(2)
    call DestroyEffectBJ(udg_SE_LoaEscape)
    call RemoveLocation(udg_Point_LoaEscape)
endfunction

