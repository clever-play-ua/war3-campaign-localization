//===========================================================================
// Trigger: TharbekSellsUnitQ
//===========================================================================
function Trig_TharbekSellsUnitQ_Func007Func002C takes nothing returns boolean
    if ( not ( udg_IntChanceTh == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TharbekSellsUnitQ_Func007C takes nothing returns boolean
    if ( not ( udg_IntChanceTh == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TharbekSellsUnitQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundAtPointBJ(gg_snd_Ability_Whiplash, 100.00, GetUnitLoc(udg_Tharbek), 0)
    call SetUnitAnimation(udg_Tharbek, "spell slam")
    call TriggerSleepAction(1.00)
    call ResetUnitAnimation(udg_Tharbek)
    set udg_IntChanceTh=GetRandomInt(1, 3)
    if ( Trig_TharbekSellsUnitQ_Func007C() ) then
        call QueuedTriggerAddBJ(gg_trg_VOTharbek02Q, true)
    else
        if ( Trig_TharbekSellsUnitQ_Func007Func002C() ) then
            call QueuedTriggerAddBJ(gg_trg_VOTharbek03Q, true)
        else
            call QueuedTriggerAddBJ(gg_trg_VOTharbek04Q, true)
        endif
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

