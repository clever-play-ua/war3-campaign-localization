function Trig_MidgameCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DestroyMinimapIcon(udg_MinimapIcon_Anasterian)
    call LeaderboardDisplayBJ(false, udg_Board_WavesCounter)
    // //
    if ( Trig_MidgameCinematicQ_Func005C() ) then
        call PauseTimerBJ(true, udg_Timer_EnemySpawner)
        call TimerDialogDisplayBJ(false, udg_TimerWindowEnemySpawn)
    else
    endif
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call SetSkyModel("Environment\\Sky\\BarrensSky\\BarrensSky.mdl")
    call ConditionalTriggerExecute(gg_trg_MidgameCinematicSetUp)
    call CameraSetupApplyForPlayer(true, gg_cam_PortalA01, udg_Player_Actual, 0)
    // //
    // //
    // Scene 1 - Portals
    // //
    call PlaySoundBJ(gg_snd_PursuitTheme)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_MidgameCinematic=true
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_PortalA02, udg_Player_Actual, 10.00)
    // //
    set bj_forLoopAIndex=4
    set bj_forLoopAIndexEnd=6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitAnimation(udg_U_MidCinSorcer[GetForLoopIndexA()], "stand channel")
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call ShowDestructableBJ(true, gg_dest_OTsp_3500)
    call PlaySoundBJ(gg_snd_ShimmeringPortalBirth)
    call SetDestructableAnimationBJ(gg_dest_OTsp_3500, "birth")
    call QueueDestructableAnimationBJ(gg_dest_OTsp_3500, "stand")
    // //
    call TriggerSleepAction(9.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_PortalB01, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_PortalB02, udg_Player_Actual, 10.00)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitAnimation(udg_U_MidCinSorcer[GetForLoopIndexA()], "stand channel")
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call ShowDestructableBJ(true, gg_dest_OTsp_3536)
    call PlaySoundBJ(gg_snd_ShimmeringPortalBirth)
    call SetDestructableAnimationBJ(gg_dest_OTsp_3536, "birth")
    call QueueDestructableAnimationBJ(gg_dest_OTsp_3536, "stand")
    // //
    call TriggerSleepAction(9.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    // Scene 2 - Zuljin
    // //
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidCinZuljinDestroyBridge01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_MidCinZuljinDestroyBridge02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc11SZuljin_RemainingTemples1) + 2.00 ))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeZuljin, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(GetPlayersAll(), udg_FakeZuljin, 0, gg_snd_WC2Orc11SZuljin_RemainingTemples1, bj_TIMETYPE_ADD, 0, true)
    call SetUnitAnimation(udg_FakeZuljin, "cinematic listening one")
    // //
    call SetUnitFacingTimed(udg_FakeZuljin, 158.61, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "attack")
    call QueueUnitAnimationBJ(udg_FakeZuljin, "cinematic listening one")
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillDestructable(gg_dest_DTlv_2287)
