//===========================================================================
// Trigger: InitEnv
//
// Use barrens sky for cinematics
// Lordaeron sky is default fiting the fog
// fog is blue
//===========================================================================
function Trig_InitEnv_Func032A takes nothing returns nothing
    call SetUnitAnimation(GetEnumUnit(), "death alternate")
endfunction

function Trig_InitEnv_Func038A takes nothing returns nothing
    call SetUnitAnimation(GetEnumUnit(), "death")
endfunction

function Trig_InitEnv_Actions takes nothing returns nothing
    call FogMaskEnableOff()
    call SetSkyModel("Environment\\Sky\\BarrensSky\\BarrensSky.mdl")
    call SetTerrainFogExBJ(0, 0.00, 5500.00, 0, 42.00, 50.00, 58.00)
    // ///
    call ShowDestructableBJ(false, gg_dest_OTsp_3500)
    call ShowDestructableBJ(false, gg_dest_OTsp_3536)
    call ShowDestructableBJ(false, gg_dest_BSP7_6850)
    call ShowDestructableBJ(false, gg_dest_OTsp_6851)
    // ///
    call ShowDestructableBJ(false, gg_dest_OTds_6976)
    call ShowDestructableBJ(false, gg_dest_OTds_6977)
    call ShowDestructableBJ(false, gg_dest_OTds_6974)
    call ShowDestructableBJ(false, gg_dest_OTds_6975)
    call SetItemVisibleBJ(false, gg_item_IQL1_0070)
    call SetItemVisibleBJ(false, gg_item_IQL0_0071)
    // ///
    // TurnOffFire
    // ///
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_VILLAGE_fog)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_VILLAGE_fog)
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_VILLAGE_fog)
    // ///
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_LoaEagleAlarm)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_LoaEagleAlarm)
    // ///
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_LoaBearAlarm)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_LoaBearAlarm)
    // ///
    // Open Tunnel Small Doors
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(PLAYER_NEUTRAL_PASSIVE), 'nSW2'), function Trig_InitEnv_Func032A)
    // ///
    // ///
    // Open Tunnel Big Doors
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(PLAYER_NEUTRAL_PASSIVE), 'nSZW'), function Trig_InitEnv_Func038A)
    // ///
    // Hide Bloodsplats
    // ///
    call SetDoodadAnimationRectBJ("death", 'Dzb1', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("death", 'Dzb1', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("death", 'Dzb1', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("death", 'Dzb1', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("death", 'Dzb1', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("death", 'Dzb1', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("death", 'Dzb2', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("death", 'Dzb2', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("death", 'Dzb2', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("death", 'Dzb2', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("death", 'Dzb2', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("death", 'Dzb2', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("death", 'Dzb3', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("death", 'Dzb3', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("death", 'Dzb3', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("death", 'Dzb3', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("death", 'Dzb3', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("death", 'Dzb3', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("death", 'Dzb4', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("death", 'Dzb4', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("death", 'Dzb4', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("death", 'Dzb4', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("death", 'Dzb4', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("death", 'Dzb4', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("death", 'Dzb5', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("death", 'Dzb5', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("death", 'Dzb5', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("death", 'Dzb5', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("death", 'Dzb5', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("death", 'Dzb5', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("death", 'Dzb6', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("death", 'Dzb6', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("death", 'Dzb6', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("death", 'Dzb6', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("death", 'Dzb6', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("death", 'Dzb6', gg_rct_BloodsplatsMini)
    // ///
    // ///
    call SetDoodadAnimationRectBJ("death", 'Dzb1', gg_rct_VILLAGE_fog)
    call SetDoodadAnimationRectBJ("death", 'Dzb2', gg_rct_VILLAGE_fog)
    call SetDoodadAnimationRectBJ("death", 'Dzb3', gg_rct_VILLAGE_fog)
    call SetDoodadAnimationRectBJ("death", 'Dzb4', gg_rct_VILLAGE_fog)
    call SetDoodadAnimationRectBJ("death", 'Dzb5', gg_rct_VILLAGE_fog)
    call SetDoodadAnimationRectBJ("death", 'Dzb6', gg_rct_VILLAGE_fog)
    // ///
    // ///
    // ///
    // ///
endfunction

