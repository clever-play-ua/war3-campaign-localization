//===========================================================================
// Trigger: TunnelSafetyEagle
//
// Prevent Enemy usig Tunnels
//===========================================================================
function Trig_TunnelSafetyEagle_Func003C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Elves ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Humans ) ) then
        return true
    endif
    return false
endfunction

function Trig_TunnelSafetyEagle_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_Phase1 == true ) ) then
        return false
    endif
    if ( not Trig_TunnelSafetyEagle_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_TunnelSafetyEagle_Actions takes nothing returns nothing
    call IssuePointOrderLocBJ(GetEnteringUnit(), "move", udg_GoalPoint_LoaTop)
endfunction

