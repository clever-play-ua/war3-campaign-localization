        return false
    endif
    return true
endfunction

function Trig_SavedLoaFixPosition_Func001Func005Func005C takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_U_Loa_Eagle ) ) then
        return false
    endif
    return true
endfunction

function Trig_SavedLoaFixPosition_Func001Func005C takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_U_Loa_DragonHawk ) ) then
        return false
    endif
    return true
endfunction

function Trig_SavedLoaFixPosition_Func001C takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_U_Loa_Lynx ) ) then
        return false
    endif
    return true
endfunction

function Trig_SavedLoaFixPosition_Actions takes nothing returns nothing
    if ( Trig_SavedLoaFixPosition_Func001C() ) then
        call SetUnitPositionLocFacingLocBJ(udg_U_Loa_Lynx, GetRectCenter(gg_rct_LoaLynxEscape), GetRectCenter(gg_rct_LoaSnake))
        call PauseUnitBJ(true, udg_U_Loa_Lynx)
        call UnitAddAbility(udg_U_Loa_Lynx, 'Aloc')
    else
        if ( Trig_SavedLoaFixPosition_Func001Func005C() ) then
            call SetUnitPositionLocFacingLocBJ(udg_U_Loa_DragonHawk, GetRectCenter(gg_rct_LoaDragonhawkEscape), GetRectCenter(gg_rct_LoaSnake))
            call PauseUnitBJ(true, udg_U_Loa_DragonHawk)
            call UnitAddAbility(udg_U_Loa_DragonHawk, 'Aloc')
        else
            if ( Trig_SavedLoaFixPosition_Func001Func005Func005C() ) then
                call SetUnitPositionLocFacingLocBJ(udg_U_Loa_Eagle, GetRectCenter(gg_rct_LoaEagleEscape), GetRectCenter(gg_rct_LoaSnake))
                call PauseUnitBJ(true, udg_U_Loa_Eagle)
                call UnitAddAbility(udg_U_Loa_Eagle, 'Aloc')
            else
                if ( Trig_SavedLoaFixPosition_Func001Func005Func005Func005C() ) then
                    call SetUnitPositionLocFacingLocBJ(udg_U_Loa_Bear, GetRectCenter(gg_rct_LoaBearEscape), GetRectCenter(gg_rct_LoaSnake))
                    call PauseUnitBJ(true, udg_U_Loa_Bear)
                    call UnitAddAbility(udg_U_Loa_Bear, 'Aloc')
                else
                    call DoNothing()
                endif
            endif
        endif
    endif
endfunction

