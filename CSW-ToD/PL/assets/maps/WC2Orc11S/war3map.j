function InitTrig_FireStormEagle takes nothing returns nothing
    set gg_trg_FireStormEagle=CreateTrigger()
    call TriggerAddCondition(gg_trg_FireStormEagle, Condition(function Trig_FireStormEagle_Conditions))
    call TriggerAddAction(gg_trg_FireStormEagle, function Trig_FireStormEagle_Actions)
