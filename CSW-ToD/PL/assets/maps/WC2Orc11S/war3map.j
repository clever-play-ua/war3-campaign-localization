    // //
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_CloseTunnels01, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_CloseTunels02, udg_Player_Actual, 5.00)
    call TriggerSleepAction(1.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundBJ(gg_snd_StoneBridgeRise)
    call SetUnitAnimation(gg_unit_nSZW_0001, "birth")
    call QueueUnitAnimationBJ(gg_unit_nSZW_0001, "stand")
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(gg_unit_nSZW_0004, "birth")
