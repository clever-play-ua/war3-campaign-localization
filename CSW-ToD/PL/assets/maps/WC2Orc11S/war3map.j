    if ( not ( IsUnitAliveBJ(udg_U_Loa_DragonHawk) == true ) ) then
        return false
    endif
    if ( not ( IsQuestItemCompleted(udg_OQReqLoa[4]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_FailedQuestReqLynxLoaQ_Func008C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_U_Loa_Eagle) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_U_Loa_DragonHawk) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_U_Loa_Bear) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_U_Loa_Lynx) == false ) ) then
        return false
    endif
    return true
endfunction

