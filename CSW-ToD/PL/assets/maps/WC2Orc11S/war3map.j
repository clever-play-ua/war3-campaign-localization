//===========================================================================
// Trigger: UTCinBoatRedirection
//===========================================================================
function Trig_UTCinBoatRedirection_Conditions takes nothing returns boolean
    if ( not ( udg_UlatekCinematic == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_U_CinBoat ) ) then
        return false
    endif
    return true
endfunction

function Trig_UTCinBoatRedirection_Func003001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_TharbekCinBoat02, udg_U_CinBoat) == true )
endfunction

function Trig_UTCinBoatRedirection_Func004001 takes nothing returns boolean
    return ( udg_UlatekCinematicSkipped == true )
endfunction

function Trig_UTCinBoatRedirection_Func006001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_TharbekCinBoat03, udg_U_CinBoat) == true )
endfunction

function Trig_UTCinBoatRedirection_Func007001 takes nothing returns boolean
    return ( udg_UlatekCinematicSkipped == true )
endfunction

function Trig_UTCinBoatRedirection_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call IssuePointOrderLocBJ(udg_U_CinBoat, "move", GetRectCenter(gg_rct_TharbekCinBoat02))
    loop
        exitwhen ( (RectContainsUnit(gg_rct_TharbekCinBoat02, udg_U_CinBoat) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_UlatekCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_U_CinBoat, "move", GetRectCenter(gg_rct_TharbekCinBoat03))
    loop
        exitwhen ( (RectContainsUnit(gg_rct_TharbekCinBoat03, udg_U_CinBoat) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_UlatekCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_U_CinBoat, "move", GetRectCenter(gg_rct_TharbekCinBoat04))
endfunction

//===========================================================================
function InitTrig_UTCinBoatRedirection takes nothing returns nothing
    set gg_trg_UTCinBoatRedirection=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_UTCinBoatRedirection, gg_rct_TharbekCinBoat01)
    call TriggerAddCondition(gg_trg_UTCinBoatRedirection, Condition(function Trig_UTCinBoatRedirection_Conditions))
    call TriggerAddAction(gg_trg_UTCinBoatRedirection, function Trig_UTCinBoatRedirection_Actions)
endfunction

