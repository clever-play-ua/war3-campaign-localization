function Trig_Troll_Wave_Top_Spawn_Func016C takes nothing returns boolean
    if ( not ( udg_Bool_Phase3 == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Troll_Wave_Top_Spawn_Actions takes nothing returns nothing
    // ///
    // T A R G E T S
    // ///
    if ( Trig_Troll_Wave_Top_Spawn_Func004C() ) then
        set udg_TempPoint_SpawnTop1_Troll=GetRectCenter(gg_rct_Troll_Spawn_Top_Left_1)
        set udg_TempPoint_SpawnTop2_Troll=GetRectCenter(gg_rct_Troll_Spawn_Top_Left_2)
    else
        if ( Trig_Troll_Wave_Top_Spawn_Func004Func003C() ) then
            set udg_TempPoint_SpawnTop1_Troll=GetRectCenter(gg_rct_Troll_Spawn_Top_Left_P2B)
            set udg_TempPoint_SpawnTop2_Troll=GetRectCenter(gg_rct_Troll_Spawn_Top_Left_P2A)
        else
            if ( Trig_Troll_Wave_Top_Spawn_Func004Func003Func001C() ) then
                set udg_TempPoint_SpawnTop1_Troll=GetRectCenter(gg_rct_Troll_Spawn_Top_Left_Ph3_B)
                set udg_TempPoint_SpawnTop2_Troll=GetRectCenter(gg_rct_Troll_Spawn_Top_Left_Ph3_A)
            else
            endif
        endif
    endif
    // ///
    // U N I T S
    // ///
    if ( Trig_Troll_Wave_Top_Spawn_Func008C() ) then
        // ///
        if ( Trig_Troll_Wave_Top_Spawn_Func008Func009C() ) then
            call CreateNUnitsAtLoc(udg_Int_TrollWaveMelleAmount, udg_UT_Troll_Melee, udg_Player_Amani, udg_TempPoint_SpawnTop1_Troll, 0.00)
            call RemoveGuardPosition(GetLastCreatedUnit())
            // ///
            call CreateNUnitsAtLoc(udg_Int_TrollWaveRangedAmount, udg_UT_Troll_Range, udg_Player_Amani, udg_TempPoint_SpawnTop2_Troll, 0.00)
            call RemoveGuardPosition(GetLastCreatedUnit())
        else
        endif
        // ///
    else
        call AddSpecialEffectLocBJ(udg_TempPoint_SpawnTop1_Troll, "Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl")
        set udg_SE_SummonLoaHelpTop=GetLastCreatedEffectBJ()
        // Default Tropps
        call CreateNUnitsAtLoc(1, 'zAtS', udg_Player_Actual, udg_TempPoint_SpawnTop1_Troll, 180.00)
        call SetUnitColor(GetLastRestoredUnitBJ(), PLAYER_COLOR_PURPLE)
        // Loa Help
        if ( Trig_Troll_Wave_Top_Spawn_Func008Func007C() ) then
            if ( Trig_Troll_Wave_Top_Spawn_Func008Func007Func002C() ) then
                call CreateNUnitsAtLoc(1, 'zAtB', udg_Player_Actual, udg_TempPoint_SpawnTop1_Troll, 180.00)
            else
            endif
            if ( Trig_Troll_Wave_Top_Spawn_Func008Func007Func003C() ) then
                call CreateNUnitsAtLoc(1, 'zAtL', udg_Player_Actual, udg_TempPoint_SpawnTop2_Troll, 180.00)
            else
            endif
            if ( Trig_Troll_Wave_Top_Spawn_Func008Func007Func004C() ) then
                call CreateNUnitsAtLoc(1, 'zAtD', udg_Player_Actual, udg_TempPoint_SpawnTop1_Troll, 180.00)
            else
            endif
            if ( Trig_Troll_Wave_Top_Spawn_Func008Func007Func005C() ) then
                call CreateNUnitsAtLoc(1, 'zAtE', udg_Player_Actual, udg_TempPoint_SpawnTop2_Troll, 180.00)
            else
            endif
        else
        endif
    endif
    // ///
    set udg_Bool_TopTrollDefenseDelpeted=false
    // G R O U P
    // ///
    call PolledWait(2.00)
    call DestroyEffectBJ(udg_SE_SummonLoaHelpTop)
    // ///
    if ( Trig_Troll_Wave_Top_Spawn_Func016C() ) then
        set bj_wantDestroyGroup=true
        call GroupAddGroup(GetUnitsInRectOfPlayer(udg_Region_GrapTrolls_Top, udg_Player_Amani), udg_WaveGroup_Top_Troll)
        call GroupPointOrderLocBJ(udg_WaveGroup_Top_Troll, "attack", udg_GoalPoint_TrollTop)
    else
        set bj_wantDestroyGroup=true
        call GroupAddGroup(GetUnitsInRectOfPlayer(udg_Region_GrapTrolls_Top, udg_Player_Actual), udg_WaveGroup_Top_Troll)
        call GroupRemoveUnitSimple(udg_HeroZuljin, udg_WaveGroup_Top_Troll)
        // Clean Up from worng Units
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(gg_rct_PH3TrollSpawnBot, Condition(function Trig_Troll_Wave_Top_Spawn_Func016Func007001002)), function Trig_Troll_Wave_Top_Spawn_Func016Func007002)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(gg_rct_PH3TrollSpawnBot, Condition(function Trig_Troll_Wave_Top_Spawn_Func016Func009001002)), function Trig_Troll_Wave_Top_Spawn_Func016Func009002)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(gg_rct_PH3TrollSpawnBot, Condition(function Trig_Troll_Wave_Top_Spawn_Func016Func011001002)), function Trig_Troll_Wave_Top_Spawn_Func016Func011002)
    endif
    // //
    call RemoveLocation(udg_TempPoint_SpawnTop1_Troll)
    call RemoveLocation(udg_TempPoint_SpawnTop2_Troll)
    // //
endfunction

