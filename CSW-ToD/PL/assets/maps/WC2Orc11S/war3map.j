endfunction

function Trig_MidgameCinematicCleanUp_Func063C takes nothing returns boolean
    if ( not ( udg_Bool_TimerStarted == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MidgameCinematicCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_MidgameCinematic=false
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call StopSoundBJ(gg_snd_PursuitTheme, false)
    call SetSkyModel(null)
    // ///
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call TriggerSleepAction(0.10)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_Phase2Init), 0)
    // ///
    call SetUnitAnimation(gg_unit_nSZW_0001, "stand")
    call SetUnitAnimation(gg_unit_nSZW_0004, "stand")
    call SetUnitAnimation(gg_unit_nSW2_0018, "stand")
    call SetUnitAnimation(gg_unit_nSW2_0017, "stand")
    // ///
    call WaygateActivateBJ(false, gg_unit_nSW2_0018)
    call WaygateActivateBJ(false, gg_unit_nSW2_0017)
    call WaygateActivateBJ(false, gg_unit_nSZW_0001)
    call WaygateActivateBJ(false, gg_unit_nSZW_0004)
    call UnitShareVisionBJ(false, gg_unit_nSW2_0017, udg_Player_Actual)
    call UnitShareVisionBJ(false, gg_unit_nSZW_0001, udg_Player_Actual)
    call UnitShareVisionBJ(false, gg_unit_nSZW_0004, udg_Player_Actual)
    call UnitShareVisionBJ(false, gg_unit_nSW2_0018, udg_Player_Actual)
    call BlzSetUnitName(gg_unit_nSZW_0001, GetItemName(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSZW_0004, GetItemName(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSW2_0018, GetItemName(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSW2_0017, GetItemName(gg_item_IQL0_0071))
    // //
    if ( Trig_MidgameCinematicCleanUp_Func033C() ) then
        call ForGroupBJ(udg_UG_EagleDefenders, function Trig_MidgameCinematicCleanUp_Func033Func001002)
    else
    endif
    // //
    // ///
    call ConditionalTriggerExecute(gg_trg_Phase2WavesData)
    // ///
    if ( Trig_MidgameCinematicCleanUp_Func038C() ) then
        call ShowDestructableBJ(true, gg_dest_OTsp_3500)
        call ShowDestructableBJ(true, gg_dest_OTsp_3536)
        call KillDestructable(gg_dest_B000_0002)
        call KillDestructable(gg_dest_DTlv_2287)
    else
    endif
    // ///
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=6
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call RemoveUnit(udg_U_MidCinSorcer[GetForLoopIndexB()])
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // ///
    call ShowUnitHide(udg_U_MidCinTroll)
    // ///
    call ForGroupBJ(udg_UG_HiddenUnits, function Trig_MidgameCinematicCleanUp_Func044002)
    call ForGroupBJ(udg_UG_HiddenUnits, function Trig_MidgameCinematicCleanUp_Func045002)
    call GroupClear(udg_UG_HiddenUnits)
    call PauseAllUnitsBJ(false)
    // ///
    call ShowUnitHide(udg_FakeZuljin)
    call SetUnitOwner(udg_FakeZuljin, Player(PLAYER_NEUTRAL_PASSIVE), true)
    // ///
    // ///
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call CinematicModeBJ(false, GetPlayersAll())
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // ///
    call LeaderboardDisplayBJ(true, udg_Board_WavesCounter)
    // ///
    if ( Trig_MidgameCinematicCleanUp_Func063C() ) then
        call PauseTimerBJ(false, udg_Timer_EnemySpawner)
        call TimerDialogDisplayBJ(true, udg_TimerWindowEnemySpawn)
    else
        call ConditionalTriggerExecute(gg_trg_StartTimer)
    endif
    // ///
    call QueuedTriggerRemoveBJ(gg_trg_MidgameCinematicQ)
    call EnableTrigger(gg_trg_AddIconForAnasterian)
    // ///
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    // ///
    // ///
    // ///
    // ///
    // ///
endfunction

