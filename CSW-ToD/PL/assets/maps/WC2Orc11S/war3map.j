    if ( not ( udg_Int_WavesRemaining == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_FailedQuestReqEagleLoaQ_Func007Func004C takes nothing returns boolean
    if ( ( IsQuestItemCompleted(udg_OQReqLoa[2]) == true ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(udg_U_Loa_Bear) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_FailedQuestReqEagleLoaQ_Func007C takes nothing returns boolean
    if ( not Trig_FailedQuestReqEagleLoaQ_Func007Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_FailedQuestReqEagleLoaQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(2.00)
    call DestroyMinimapIcon(udg_MinimapIconLoa[1])
    call QuestItemSetDescriptionBJ(udg_OQReqLoa[1], "TRIGSTR_640")
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_639")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    if ( Trig_FailedQuestReqEagleLoaQ_Func007C() ) then
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerAddBJ(gg_trg_MidgameCinematicQ, true)
    else
        if ( Trig_FailedQuestReqEagleLoaQ_Func007Func001C() ) then
            call ConditionalTriggerExecute(gg_trg_AnasterianAlternateSummonCheckerLaunch)
        else
        endif
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

