//===========================================================================
// Trigger: IncreateTrollDefenseAmountPh2
//===========================================================================
function Trig_IncreateTrollDefenseAmountPh2_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_Phase2 == true ) ) then
        return false
    endif
    if ( not ( udg_Int_Wave_Counter >= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_IncreateTrollDefenseAmountPh2_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Int_TrollWaveMelleAmount=( udg_Int_TrollWaveMelleAmount + 1 )
    set udg_Int_TrollWaveRangedAmount=( udg_Int_TrollWaveRangedAmount + 1 )
endfunction

//===========================================================================
function InitTrig_IncreateTrollDefenseAmountPh2 takes nothing returns nothing
    set gg_trg_IncreateTrollDefenseAmountPh2=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_IncreateTrollDefenseAmountPh2, udg_Timer_EnemySpawner)
    call TriggerAddCondition(gg_trg_IncreateTrollDefenseAmountPh2, Condition(function Trig_IncreateTrollDefenseAmountPh2_Conditions))
    call TriggerAddAction(gg_trg_IncreateTrollDefenseAmountPh2, function Trig_IncreateTrollDefenseAmountPh2_Actions)
endfunction

//===========================================================================
// Trigger: DiscoverMainQuest
//===========================================================================
function Trig_DiscoverMainQuest_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Display Messages
    set udg_Bool_Phase1=true
    call EnableTrigger(gg_trg_LoaGoalStatusChecker)
    // ////
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_320")
    // ////
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    // ////
    call CreateLeaderboardBJ(udg_PG_Horde, "TRIGSTR_688")
    set udg_Board_WavesCounter=GetLastCreatedLeaderboard()
    // ////
    call LeaderboardAddItemBJ(udg_Player_Actual, udg_Board_WavesCounter, "TRIGSTR_689", udg_Int_WavesRemaining)
    call LeaderboardSetPlayerItemStyleBJ(udg_Player_Actual, udg_Board_WavesCounter, true, true, false)
    call LeaderboardSetPlayerItemLabelColorBJ(udg_Player_Actual, udg_Board_WavesCounter, 100, 80, 20, 0)
    call LeaderboardSetPlayerItemValueColorBJ(udg_Player_Actual, udg_Board_WavesCounter, 100, 80, 20, 0)
    // ////
    call LeaderboardDisplayBJ(true, udg_Board_WavesCounter)
    // ////
    call ConditionalTriggerExecute(gg_trg_StartTimer)
    // ////
    call QueuedTriggerAddBJ(gg_trg_HintTunnelsQ, true)
    // ////
endfunction

//===========================================================================
function InitTrig_DiscoverMainQuest takes nothing returns nothing
    set gg_trg_DiscoverMainQuest=CreateTrigger()
    call TriggerAddAction(gg_trg_DiscoverMainQuest, function Trig_DiscoverMainQuest_Actions)
endfunction

//===========================================================================
// Trigger: UpdateMainQuest
//===========================================================================
function Trig_UpdateMainQuest_Func009C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_UpdateMainQuest_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // ////
    call CreateQuestItemBJ(udg_MQZulaman, "TRIGSTR_675")
    set udg_MQReqZulaman[2]=GetLastCreatedQuestItemBJ()
    // ////
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_674")
    // ////
    if ( Trig_UpdateMainQuest_Func009C() ) then
        call SetPlayerTechResearchedSwap('R013', 3, udg_Player_Humans)
        call SetPlayerTechResearchedSwap('R014', 3, udg_Player_Humans)
        call SetPlayerTechResearchedSwap('R013', 3, udg_Player_Elves)
        call SetPlayerTechResearchedSwap('R014', 3, udg_Player_Elves)
        call SetPlayerTechResearchedSwap('R00J', 3, udg_Player_Elves)
        call SetPlayerTechResearchedSwap('R00A', 3, udg_Player_Elves)
    else
    endif
    // ////
    call EnableTrigger(gg_trg_MainQuestCompleted)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_UpdateMainQuest takes nothing returns nothing
    set gg_trg_UpdateMainQuest=CreateTrigger()
    call TriggerAddAction(gg_trg_UpdateMainQuest, function Trig_UpdateMainQuest_Actions)
endfunction

//===========================================================================
// Trigger: MainQuestCompleted
//===========================================================================
function Trig_MainQuestCompleted_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_Phase3 == true ) ) then
        return false
    endif
    if ( not ( udg_Int_WavesRemaining == 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Bot) == 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Top) == 0 ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HeroZuljin) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestCompleted_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetCompletedBJ(udg_MQZulaman, true)
    call QueuedTriggerAddBJ(gg_trg_MainQuestCompletedQ, true)
endfunction

//===========================================================================
function InitTrig_MainQuestCompleted takes nothing returns nothing
    set gg_trg_MainQuestCompleted=CreateTrigger()
    call DisableTrigger(gg_trg_MainQuestCompleted)
    call TriggerRegisterTimerEventPeriodic(gg_trg_MainQuestCompleted, 2)
    call TriggerAddCondition(gg_trg_MainQuestCompleted, Condition(function Trig_MainQuestCompleted_Conditions))
    call TriggerAddAction(gg_trg_MainQuestCompleted, function Trig_MainQuestCompleted_Actions)
endfunction

//===========================================================================
// Trigger: MainQuestCompletedQ
//===========================================================================
function Trig_MainQuestCompletedQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // ////
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call DestroyLeaderboardBJ(udg_Board_WavesCounter)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_322")
    // ////
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call QueuedTriggerClearInactiveBJ()
    call ConditionalTriggerExecute(gg_trg_OutroCinematicQ)
endfunction

//===========================================================================
function InitTrig_MainQuestCompletedQ takes nothing returns nothing
    set gg_trg_MainQuestCompletedQ=CreateTrigger()
    call TriggerAddAction(gg_trg_MainQuestCompletedQ, function Trig_MainQuestCompletedQ_Actions)
endfunction

//===========================================================================
// Trigger: MainQuestFailed
//===========================================================================
function Trig_MainQuestFailed_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_Phase3 == true ) ) then
        return false
    endif
    if ( not ( GetDyingUnit() == udg_HeroZuljin ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestFailed_Func006C takes nothing returns boolean
    if ( not ( udg_Bool_TimerStarted == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestFailed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_OutroLoseGenerateCorpses)
    call QuestSetFailedBJ(udg_MQZulaman, true)
    // ////
    call DestroyLeaderboardBJ(udg_Board_WavesCounter)
    if ( Trig_MainQuestFailed_Func006C() ) then
        call PauseTimerBJ(true, udg_Timer_EnemySpawner)
        call TimerDialogDisplayBJ(false, udg_TimerWindowEnemySpawn)
    else
    endif
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_321")
    // ////
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerClearInactiveBJ()
    call ConditionalTriggerExecute(gg_trg_OutroCinematicQ)
endfunction

//===========================================================================
function InitTrig_MainQuestFailed takes nothing returns nothing
    set gg_trg_MainQuestFailed=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MainQuestFailed, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_MainQuestFailed, Condition(function Trig_MainQuestFailed_Conditions))
    call TriggerAddAction(gg_trg_MainQuestFailed, function Trig_MainQuestFailed_Actions)
endfunction

//===========================================================================
// Trigger: DiscoverLoaQuest
//===========================================================================
function Trig_DiscoverLoaQuest_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestSetDiscoveredBJ(udg_OQLoa, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_630")
    // ////
    call TriggerSleepAction(1.00)
    // ////
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_LoaEagle), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIconLoa[1]=GetLastCreatedMinimapIcon()
    // ////
    call TriggerSleepAction(1.00)
    // ////
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_LoaBear), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIconLoa[2]=GetLastCreatedMinimapIcon()
    // ////
    call TriggerSleepAction(1.00)
    // ////
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_LoaLynx), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIconLoa[3]=GetLastCreatedMinimapIcon()
    // ////
    call TriggerSleepAction(1.00)
    // ////
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_LoaDragonHawk), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIconLoa[4]=GetLastCreatedMinimapIcon()
    // ////
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // ////
endfunction

