//===========================================================================
// Trigger: CompletedQuestReqDragonHawkLoaQ
//===========================================================================
function Trig_CompletedQuestReqDragonHawkLoaQ_Func007Func006Func001Func001002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_WaveGroup_Top)
endfunction

function Trig_CompletedQuestReqDragonHawkLoaQ_Func007Func006Func001C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Bot) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CompletedQuestReqDragonHawkLoaQ_Func007Func006C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_U_Loa_Lynx) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_CompletedQuestReqDragonHawkLoaQ_Func007Func007C takes nothing returns boolean
    if ( ( IsQuestItemCompleted(udg_OQReqLoa[3]) == true ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(udg_U_Loa_Lynx) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_CompletedQuestReqDragonHawkLoaQ_Func007C takes nothing returns boolean
    if ( not Trig_CompletedQuestReqDragonHawkLoaQ_Func007Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_CompletedQuestReqDragonHawkLoaQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Int_NumberOfBurnedTemples=( udg_Int_NumberOfBurnedTemples + 1 )
    call DestroyMinimapIcon(udg_MinimapIconLoa[4])
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_651")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_AnasterianBubbleOff)
    if ( Trig_CompletedQuestReqDragonHawkLoaQ_Func007C() ) then
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerAddBJ(gg_trg_VOTrollCaptain02Q, true)
        call ConditionalTriggerExecute(gg_trg_QuestLoaCompleted)
    else
        call QueuedTriggerAddBJ(gg_trg_VOTrollCaptain01Q, true)
        // redirecting additional wave to another loa
        if ( Trig_CompletedQuestReqDragonHawkLoaQ_Func007Func006C() ) then
            if ( Trig_CompletedQuestReqDragonHawkLoaQ_Func007Func006Func001C() ) then
                call ConditionalTriggerExecute(gg_trg_StartTimer)
            else
                call ForGroupBJ(udg_WaveGroup_Bot, function Trig_CompletedQuestReqDragonHawkLoaQ_Func007Func006Func001Func001002)
                call GroupClear(udg_WaveGroup_Bot)
                call EnableTrigger(gg_trg_Elf_Wave_Resume__Attack)
            endif
        else
        endif
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_AnasterianAlternateSummonCheckerLaunch)
endfunction

