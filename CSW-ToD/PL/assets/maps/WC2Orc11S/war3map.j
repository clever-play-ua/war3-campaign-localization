function InitTrig_CompletedQuestReqDragonHawkLoaQ takes nothing returns nothing
    set gg_trg_CompletedQuestReqDragonHawkLoaQ=CreateTrigger()
    call TriggerAddAction(gg_trg_CompletedQuestReqDragonHawkLoaQ, function Trig_CompletedQuestReqDragonHawkLoaQ_Actions)
endfunction

