function InitTrig_DiscoverLoaQuest takes nothing returns nothing
    set gg_trg_DiscoverLoaQuest=CreateTrigger()
    call TriggerAddAction(gg_trg_DiscoverLoaQuest, function Trig_DiscoverLoaQuest_Actions)
endfunction

//===========================================================================
// Trigger: FailedQuestReqEagleLoa
//===========================================================================
function Trig_FailedQuestReqEagleLoa_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_U_Loa_Eagle ) ) then
        return false
    endif
    return true
endfunction

function Trig_FailedQuestReqEagleLoa_Func004C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_AnasterianDestorysEagleTemple, udg_HeroAnasterian) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FailedQuestReqEagleLoa_Func007Func002002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_WaveGroup_Bot)
endfunction

function Trig_FailedQuestReqEagleLoa_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_Phase1 == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_BotGoalEligible == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FailedQuestReqEagleLoa_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Int_CountDeadLoa=( udg_Int_CountDeadLoa + 1 )
    set udg_Int_NumberOfBurnedTemples=( udg_Int_NumberOfBurnedTemples + 1 )
    if ( Trig_FailedQuestReqEagleLoa_Func004C() ) then
        call DestroyTimerDialogBJ(udg_TimerWindowSaveLoa)
        call DestroyEffectBJ(udg_SE_LoaTeleportPrepare)
        call ShowDestructableBJ(false, gg_dest_OTds_6974)
        set udg_Bool_TempleBurning=false
        call DestroyEffectBJ(udg_SE_FireStorm)
    else
    endif
    call ConditionalTriggerExecute(gg_trg_AnasterianBubbleOff)
    // redirecting remaining wave to another loa
    if ( Trig_FailedQuestReqEagleLoa_Func007C() ) then
        call ForGroupBJ(udg_WaveGroup_Top, function Trig_FailedQuestReqEagleLoa_Func007Func002002)
        call GroupClear(udg_WaveGroup_Top)
        call EnableTrigger(gg_trg_Elf_Wave_Resume__Attack)
    else
        call TriggerExecute(gg_trg_MoveAnasterianToDefaultPosition)
    endif
    call QueuedTriggerAddBJ(gg_trg_FailedQuestReqEagleLoaQ, true)
endfunction

