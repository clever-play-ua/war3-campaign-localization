    if ( not ( IsUnitAliveBJ(udg_HeroZuljin) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_UlaTekCinematicCleanUp_Func089002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_UlaTekCinematicCleanUp_Func090002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_UlaTekCinematicCleanUp_Func105C takes nothing returns boolean
    if ( not ( udg_UlatekCinematicSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UlaTekCinematicCleanUp_Func123C takes nothing returns boolean
    if ( not ( udg_Bool_TimerStarted == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UlaTekCinematicCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QueuedTriggerRemoveBJ(gg_trg_UlaTekCinematicQ)
    set udg_UlatekCinematic=false
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call SetTimeOfDay(0.00)
    call UseTimeOfDayBJ(false)
    // ///
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_UlatekCinGenericCamera, udg_Player_Actual, 0)
    call DestroyEffectBJ(udg_SE_AltarRitual)
    call DestroyEffectBJ(udg_SE_AltarRitualFire)
    call DestroyEffectBJ(udg_SE_ZuljinRitual)
    call DestroyEffectBJ(udg_SE_ZuljinRitualBuff)
    call DestroyEffectBJ(udg_SE_ShadowFury)
    // ----------------------------------------------------------------------------------------
    // ///
    call SetUnitAnimation(gg_unit_nSZW_0002, "stand")
    call SetUnitAnimation(gg_unit_nSZW_0003, "stand")
    call SetUnitAnimation(gg_unit_nSW2_0030, "stand")
    call SetUnitAnimation(gg_unit_nSW2_0029, "stand")
    // ///
    call WaygateActivateBJ(false, gg_unit_nSW2_0029)
    call WaygateActivateBJ(false, gg_unit_nSW2_0030)
    call WaygateActivateBJ(false, gg_unit_nSZW_0002)
    call WaygateActivateBJ(false, gg_unit_nSZW_0003)
    call UnitShareVisionBJ(false, gg_unit_nSZW_0002, udg_Player_Actual)
    call UnitShareVisionBJ(false, gg_unit_nSZW_0003, udg_Player_Actual)
    call UnitShareVisionBJ(false, gg_unit_nSW2_0030, udg_Player_Actual)
    call UnitShareVisionBJ(false, gg_unit_nSW2_0029, udg_Player_Actual)
    call BlzSetUnitName(gg_unit_nSW2_0029, GetItemName(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSW2_0030, GetItemName(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSZW_0002, GetItemName(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSZW_0003, GetItemName(gg_item_IQL0_0071))
    // //
    call SetPlayerColorBJ(udg_Player_CinematicDummy, PLAYER_COLOR_CYAN, false)
    // //
    // Sound & Music
    // ----------------------------------------------------------------------------------------
    call StopSoundBJ(gg_snd_ZulAmanUlaTekTheme, false)
    call StopSoundBJ(gg_snd_WC3OrcDefeat, false)
    call StopSoundBJ(gg_snd_ZAUlaTekBlessing, false)
    call StopSoundBJ(gg_snd_ZAUlaTekSummon, false)
    call StopSoundBJ(gg_snd_WC2Orc11SZuljin_TharbekFarewell1, true)
    call StopSoundBJ(gg_snd_WC2Orc11SZuljin_CallingUlatek, true)
    call StopSoundBJ(gg_snd_WC2Orc11SZuljin_CallingUlatek2, true)
    call StopSoundBJ(gg_snd_WC2Orc11SZuljin_Empowered1, true)
    // ///
    call StopSoundBJ(gg_snd_WC2Orc11STharbek_Final1, true)
    call StopSoundBJ(gg_snd_WC2Orc11STharbek_Final2, true)
    // ///
    call StopSoundBJ(gg_snd_WC2Orc11SUlaTek1, true)
    // ///
    // ----------------------------------------------------------------------------------------
    // Clear Units
    // ----------------------------------------------------------------------------------------
    call ResetUnitLookAt(udg_FakeZuljin)
    call RemoveUnit(udg_FakeTharbek)
    call RemoveUnit(udg_U_CinBoat)
    call RemoveUnit(udg_U_MidCinTroll)
    call RemoveUnit(udg_U_UlaTekCinElvenCapt)
    call RemoveUnit(udg_U_UlaTekCinElvenFootman[1])
    call RemoveUnit(udg_U_UlaTekCinElvenFootman[2])
    call ShowUnitHide(udg_U_Loa_UlaTek)
    // ///
    if ( Trig_UlaTekCinematicCleanUp_Func070C() ) then
        call ReviveHeroLoc(udg_HeroZuljin, GetRectCenter(gg_rct_Cin_2_Zuljin_3), false)
    else
    endif
    call ShowUnitShow(udg_HeroZuljin)
    call SetUnitPositionLocFacingBJ(udg_HeroZuljin, GetRectCenter(gg_rct_Cin_2_Zuljin_3), 180.00)
    call ModifyGateBJ(bj_GATEOPERATION_CLOSE, gg_dest_B006_0327)
    // ///
    call SetPlayerAbilityAvailableBJ(true, 'A60C', udg_Player_Actual)
    // ///
    // ///
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_PURPLE, false)
    call SetPlayerTechResearchedSwap('Roch', 1, udg_Player_Actual)
    call SetUnitColor(udg_HeroZuljin, PLAYER_COLOR_PURPLE)
    // ///
    call UnitRemoveAbilityBJ('A63X', udg_HeroZuljin)
    // ///
    call BlzUnitDisableAbility(udg_U_Loa_Bear, 'AOae', false, false)
    call BlzUnitDisableAbility(udg_U_Loa_DragonHawk, 'AHab', false, false)
    call BlzUnitDisableAbility(udg_U_Loa_Eagle, 'AEar', false, false)
    call BlzUnitDisableAbility(udg_U_Loa_Lynx, 'AEah', false, false)
    // ///
    call ForGroupBJ(udg_UG_HiddenUnits, function Trig_UlaTekCinematicCleanUp_Func089002)
    call ForGroupBJ(udg_UG_HiddenUnits, function Trig_UlaTekCinematicCleanUp_Func090002)
    call GroupClear(udg_UG_HiddenUnits)
    call PauseAllUnitsBJ(false)
    // ///
    call SetUnitOwner(udg_FakeZuljin, Player(PLAYER_NEUTRAL_PASSIVE), false)
    call ShowUnitHide(udg_FakeZuljin)
    // ///
    call GroupRemoveGroup(udg_WaveGroup_Bot_Troll, udg_WaveGroup_Bot_Troll)
    call GroupRemoveGroup(udg_WaveGroup_Top_Troll, udg_WaveGroup_Top_Troll)
    // ///
    call ConditionalTriggerExecute(gg_trg_Phase3WavesData)
    // ///
    call ShowDestructableBJ(true, gg_dest_BSP7_6850)
    call ShowDestructableBJ(true, gg_dest_OTsp_6851)
    // ///
    if ( Trig_UlaTekCinematicCleanUp_Func105C() ) then
        call SetUnitInvulnerable(gg_unit_nhcn_0332, false)
        call KillUnit(gg_unit_nhcn_0332)
    else
    endif
    // ----------------------------------------------------------------------------------------
    // Weather
    // ----------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 0.00, 10000.00, 0, 42.00, 50.00, 58.00)
    call SetSkyModel(null)
    // ///
    // ///
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call CinematicModeBJ(false, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ----------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // ----------------------------------------------------------------------------------------
    // ///
    call LeaderboardDisplayBJ(true, udg_Board_WavesCounter)
    // ///
    if ( Trig_UlaTekCinematicCleanUp_Func123C() ) then
        call PauseTimerBJ(false, udg_Timer_EnemySpawner)
        call TimerDialogDisplayBJ(true, udg_TimerWindowEnemySpawn)
    else
        call ConditionalTriggerExecute(gg_trg_StartTimer)
    endif
    // ///
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    call TriggerSleepAction(2.00)
    // ///
    call UnitAddAbilityBJ('AUts', udg_HeroZuljin)
    call SetUnitAbilityLevelSwapped('AUts', udg_HeroZuljin, 3)
    call QueuedTriggerAddBJ(gg_trg_VOZuljin02Q, true)
    call QueuedTriggerAddBJ(gg_trg_UpdateMainQuest, true)
    call QueuedTriggerAddBJ(gg_trg_HintPriceZuljinQ, true)
    // ///
    // ///
    // ///
endfunction

