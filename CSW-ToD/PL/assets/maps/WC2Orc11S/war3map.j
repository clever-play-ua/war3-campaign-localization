    call TriggerSleepAction(1.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call KillDestructable(gg_dest_B000_0002)
    call PlaySoundBJ(gg_snd_CityBuildingDeath1)
    call TriggerSleepAction(1.00)
    if ( (udg_MidgameCinematicSkipped == true) ) then // INLINED!!
        return
