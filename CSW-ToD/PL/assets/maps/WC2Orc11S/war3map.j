function Trig_CompletedQuestReqEagleLoaQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Int_NumberOfBurnedTemples=( udg_Int_NumberOfBurnedTemples + 1 )
    call DestroyMinimapIcon(udg_MinimapIconLoa[1])
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_652")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_AnasterianBubbleOff)
    if ( Trig_CompletedQuestReqEagleLoaQ_Func007C() ) then
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerAddBJ(gg_trg_MidgameCinematicQ, true)
    else
        // redirecting additional wave to another loa
        if ( Trig_CompletedQuestReqEagleLoaQ_Func007Func003C() ) then
            if ( Trig_CompletedQuestReqEagleLoaQ_Func007Func003Func001C() ) then
                call ConditionalTriggerExecute(gg_trg_StartTimer)
            else
                call ForGroupBJ(udg_WaveGroup_Top, function Trig_CompletedQuestReqEagleLoaQ_Func007Func003Func001Func002002)
                call GroupClear(udg_WaveGroup_Top)
                call EnableTrigger(gg_trg_Elf_Wave_Resume__Attack)
            endif
        else
        endif
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_AnasterianAlternateSummonCheckerLaunch)
endfunction

