//===========================================================================
// Trigger: Phase2WavesData
//===========================================================================
function Trig_Phase2WavesData_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Int_WavesRemaining=10
    call LeaderboardSetPlayerItemValueBJ(udg_Player_Actual, udg_Board_WavesCounter, udg_Int_WavesRemaining)
    // ///
    set udg_Bool_Phase2=true
    // ///
    set udg_Int_Wave_Counter=0
    // ///
    call GroupAddUnitSimple(udg_HeroHalduron, udg_UG_HerousBench)
    call GroupAddUnitSimple(udg_HeroLorthemar, udg_UG_HerousBench)
    // ///
    call GroupRemoveUnitSimple(udg_HeroLiadrin, udg_WaveGroup_Top)
    call GroupRemoveUnitSimple(udg_HeroLiadrin, udg_WaveGroup_Bot)
    call SetUnitPositionLoc(udg_HeroLiadrin, GetRectCenter(gg_rct_ElvenHeroRevivePoint))
    call GroupRemoveUnitSimple(udg_HeroRommath, udg_WaveGroup_Top)
    call GroupRemoveUnitSimple(udg_HeroRommath, udg_WaveGroup_Bot)
    call SetUnitPositionLoc(udg_HeroRommath, GetRectCenter(gg_rct_ElvenHeroRevivePoint))
    call GroupRemoveUnitSimple(udg_HeroAnasterian, udg_WaveGroup_Bot)
    call GroupRemoveUnitSimple(udg_HeroAnasterian, udg_WaveGroup_Top)
    call SetUnitPositionLoc(udg_HeroAnasterian, GetRectCenter(gg_rct_ElvenHeroRevivePoint))
    // ///
    set udg_GoalPoint_TrollTop=GetRectCenter(gg_rct_LoaEagle)
    set udg_GoalPoint_TrollBottom=GetRectCenter(gg_rct_LoaBear)
    // ///
    set udg_GoalPoint_LoaTop=GetRectCenter(gg_rct_LoaLynx)
    set udg_GoalPoint_LoaBottom=GetRectCenter(gg_rct_LoaDragonHawk)
    // ///
    set udg_Region_GrapElves_Top=gg_rct_AnasterianDestorysEagleTemple
    set udg_Region_GrapElves_Bot=gg_rct_AnasterianDestorysBearTemple
    set udg_Region_GrapTrolls_Top=gg_rct_Troll_Spawn_Top_Left_Phase2
    set udg_Region_GrapTrolls_Bot=gg_rct_Troll_Spawn_Bot_Left_Phase2
    // ///
    // ///
    // ///
endfunction

//===========================================================================
function InitTrig_Phase2WavesData takes nothing returns nothing
    set gg_trg_Phase2WavesData=CreateTrigger()
    call TriggerAddAction(gg_trg_Phase2WavesData, function Trig_Phase2WavesData_Actions)
endfunction

//===========================================================================
// Trigger: Phase3WavesData
//===========================================================================
function Trig_Phase3WavesData_Func043C takes nothing returns boolean
    if ( not ( GetGameDifficulty() != MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    if ( not ( udg_Int_CountDeadLoa > 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Phase3WavesData_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Int_WavesRemaining=5
    call LeaderboardSetPlayerItemValueBJ(udg_Player_Actual, udg_Board_WavesCounter, udg_Int_WavesRemaining)
    // ///
    set udg_Bool_Phase3=true
    // ///
    set udg_Int_Wave_Counter=5
    set udg_Real_WaveAssemblyTime=30.00
    // ///
    call GroupAddUnitSimple(udg_Isenglof, udg_UG_HerousBench)
    // ///
    call GroupRemoveUnitSimple(udg_HeroLorthemar, udg_WaveGroup_Top)
    call GroupRemoveUnitSimple(udg_HeroLorthemar, udg_WaveGroup_Bot)
    call SetUnitPositionLoc(udg_HeroLorthemar, GetRectCenter(gg_rct_ElvenHeroRevivePoint))
    // ///
    call GroupRemoveUnitSimple(udg_HeroLiadrin, udg_WaveGroup_Top)
    call GroupRemoveUnitSimple(udg_HeroLiadrin, udg_WaveGroup_Bot)
    call SetUnitPositionLoc(udg_HeroLiadrin, GetRectCenter(gg_rct_ElvenHeroRevivePoint))
    // ///
    call GroupRemoveUnitSimple(udg_HeroRommath, udg_WaveGroup_Top)
    call GroupRemoveUnitSimple(udg_HeroRommath, udg_WaveGroup_Bot)
    call SetUnitPositionLoc(udg_HeroRommath, GetRectCenter(gg_rct_ElvenHeroRevivePoint))
    // ///
    call GroupRemoveUnitSimple(udg_HeroHalduron, udg_WaveGroup_Top)
    call GroupRemoveUnitSimple(udg_HeroHalduron, udg_WaveGroup_Bot)
    call SetUnitPositionLoc(udg_HeroHalduron, GetRectCenter(gg_rct_ElvenHeroRevivePoint))
    // ///
    call GroupRemoveUnitSimple(udg_HeroAnasterian, udg_WaveGroup_Bot)
    call GroupRemoveUnitSimple(udg_HeroAnasterian, udg_WaveGroup_Top)
    call SetUnitPositionLoc(udg_HeroAnasterian, GetRectCenter(gg_rct_ElvenHeroRevivePoint))
    // ///
    set udg_GoalPoint_LoaTop=GetRectCenter(gg_rct_LoaSnake)
    set udg_GoalPoint_LoaBottom=GetRectCenter(gg_rct_LoaSnake)
    // ///
    set udg_Region_GrapElves_Top=gg_rct_AnasterianDestorysLynxTemple
    set udg_Region_GrapElves_Bot=gg_rct_AnasterianDestorysDragonHawkTemple
    set udg_Region_GrapTrolls_Top=gg_rct_PH3TrollSpawnTop
    set udg_Region_GrapTrolls_Bot=gg_rct_PH3TrollSpawnBot
    // ///
    call SetUnitOwner(gg_unit_nmrk_0321, udg_Player_Amani, false)
    call SetUnitOwner(gg_unit_osld_0322, udg_Player_Amani, false)
    // ///
    if ( Trig_Phase3WavesData_Func043C() ) then
        call SetPlayerHandicapBJ(udg_Player_Elves, 75.00)
        call SetPlayerHandicapBJ(udg_Player_Humans, 75.00)
        call SetPlayerHandicapDamageBJ(udg_Player_Elves, 75.00)
        call SetPlayerHandicapDamageBJ(udg_Player_Humans, 75.00)
    else
    endif
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
endfunction

//===========================================================================
function InitTrig_Phase3WavesData takes nothing returns nothing
    set gg_trg_Phase3WavesData=CreateTrigger()
    call TriggerAddAction(gg_trg_Phase3WavesData, function Trig_Phase3WavesData_Actions)
endfunction

