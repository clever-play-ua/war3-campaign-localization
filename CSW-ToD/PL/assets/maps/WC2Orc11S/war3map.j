//===========================================================================
// Trigger: MoveAnasterianToDefaultPosition
//===========================================================================
function Trig_MoveAnasterianToDefaultPosition_Actions takes nothing returns nothing
    set udg_Point_Escape_Anasterian=GetRectCenter(RectFromCenterSizeBJ(GetUnitLoc(udg_HeroAnasterian), 64.00, 64.00))
    call AddSpecialEffectLocBJ(udg_Point_Escape_Anasterian, "abilities\\spells\\special\\teleport\\teleportcaster.mdx")
    set udg_SE_Escape_Anasterian=GetLastCreatedEffectBJ()
    call ResetUnitAnimation(udg_HeroAnasterian)
    call SetUnitPositionLoc(udg_HeroAnasterian, GetRectCenter(gg_rct_ElvenHeroRevivePoint))
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_HeroAnasterian)
    call SetUnitLifePercentBJ(udg_HeroAnasterian, 100)
    call SetUnitManaPercentBJ(udg_HeroAnasterian, 100)
    call TriggerSleepAction(1.00)
    call DestroyEffectBJ(udg_SE_Escape_Anasterian)
endfunction

