//===========================================================================
function Trig_FireStormEagle_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_TempleBurning == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireStormEagle_Func009001 takes nothing returns boolean
    return ( udg_Bool_TempleBurning == false )
endfunction

function Trig_FireStormEagle_Func012001 takes nothing returns boolean
    return ( udg_Bool_TempleBurning == false )
endfunction

function Trig_FireStormEagle_Func016001 takes nothing returns boolean
    return ( udg_Bool_TempleBurning == false )
endfunction

function Trig_FireStormEagle_Func019001 takes nothing returns boolean
    return ( udg_Bool_TempleBurning == false )
endfunction

function Trig_FireStormEagle_Actions takes nothing returns nothing
    // //
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_LoaEagle), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrike1.mdl")
    set udg_SE_FireStorm=GetLastCreatedEffectBJ()
    // //
    // //
    call TriggerSleepAction(2)
    if ( (udg_Bool_TempleBurning == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(2)
    if ( (udg_Bool_TempleBurning == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetDestructableAnimationBJ(gg_dest_OTds_6974, "stand")
    call TriggerSleepAction(2)
    if ( (udg_Bool_TempleBurning == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(2)
    if ( (udg_Bool_TempleBurning == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call DestroyEffectBJ(udg_SE_FireStorm)
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

