function Trig_UlaTekCinematicSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    set udg_Bool_Phase2=false
    call ShowDestructableBJ(false, gg_dest_OTds_6976)
    call ShowDestructableBJ(false, gg_dest_OTds_6977)
    // //
    call RemoveDestructable(gg_dest_Bz08_3437)
    call RemoveUnit(udg_Tharbek)
    call RemoveUnit(gg_unit_ngme_0104)
    // //
    call ForGroupBJ(udg_WaveGroup_Bot, function Trig_UlaTekCinematicSetUp_Func011002)
    call ForGroupBJ(udg_WaveGroup_Top, function Trig_UlaTekCinematicSetUp_Func012002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GrabTrollsLynx, Condition(function Trig_UlaTekCinematicSetUp_Func015001002)), function Trig_UlaTekCinematicSetUp_Func015A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GrabTrollsDH, Condition(function Trig_UlaTekCinematicSetUp_Func018001002)), function Trig_UlaTekCinematicSetUp_Func018A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_ActiveGameplayZone, Condition(function Trig_UlaTekCinematicSetUp_Func021001002)), function Trig_UlaTekCinematicSetUp_Func021A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_PASSIVE)), function Trig_UlaTekCinematicSetUp_Func024A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Phase2CleanUp, udg_Player_Elves), function Trig_UlaTekCinematicSetUp_Func027A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Phase2CleanUp, udg_Player_Humans), function Trig_UlaTekCinematicSetUp_Func030A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_UlatekTemple, udg_Player_Amani), function Trig_UlaTekCinematicSetUp_Func033A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_UlatekTemple, udg_Player_Tharbek), function Trig_UlaTekCinematicSetUp_Func036A)
    // //
    // //
    call ForGroupBJ(udg_UG_HiddenUnits, function Trig_UlaTekCinematicSetUp_Func039002)
    call ForGroupBJ(udg_UG_HiddenUnits, function Trig_UlaTekCinematicSetUp_Func040002)
    // //
    call PauseAllUnitsBJ(true)
    // //
    // ----------------------------------------------------------------------------------------
    // Weather
    // ----------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 1000.00, 10000.00, 0, 42.00, 50.00, 58.00)
    call SetSkyModel("Environment\\Sky\\BarrensSky\\BarrensSky.mdl")
    // ----------------------------------------------------------------------------------------
    // Create Fake Actors
    // ----------------------------------------------------------------------------------------
    // ///
    call RemoveDestructable(gg_dest_Bz08_3437)
    call ShowUnitHide(udg_HeroZuljin)
    // ///
    call ShowUnitShow(udg_FakeZuljin)
    call SetUnitPositionLocFacingLocBJ(udg_FakeZuljin, GetRectCenter(gg_rct_TharbekCinZuljin01), GetRectCenter(gg_rct_TharbekCinZuljin02))
    call PauseUnitBJ(true, udg_FakeZuljin)
    call SetUnitOwner(udg_FakeZuljin, udg_Player_Actual, true)
    // ///
    // ///
    call ShowUnitShow(udg_FakeTharbek)
    call SetUnitPositionLocFacingLocBJ(udg_FakeTharbek, GetRectCenter(gg_rct_TharbekCinTharbek01), GetRectCenter(gg_rct_TharbekCinCorpse03))
    call BlzSetUnitRealFieldBJ(udg_FakeTharbek, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call SetUnitMoveSpeed(udg_FakeTharbek, 270.00)
    call PauseUnitBJ(true, udg_FakeTharbek)
    // ----------------------------------------------------------------------------------------
    // Create Fake Actors
    // ----------------------------------------------------------------------------------------
    call CreateNUnitsAtLoc(1, 'ZAtU', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_2_UlaTek_1), 270.00)
    set udg_U_Loa_UlaTek=GetLastCreatedUnit()
    call SetUnitColor(udg_U_Loa_UlaTek, PLAYER_COLOR_PURPLE)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_U_Loa_UlaTek)
    call BlzSetUnitRealFieldBJ(udg_U_Loa_UlaTek, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    call SetUnitMoveSpeed(udg_U_Loa_UlaTek, 150.00)
    call ShowUnitHide(udg_U_Loa_UlaTek)
    // ///
    call SetUnitPositionLocFacingLocBJ(udg_U_MidCinTroll, GetRectCenter(gg_rct_Cin_2_Tharbek_1), GetRectCenter(gg_rct_Cin_2_Zuljin_2))
    call ShowUnitShow(udg_U_MidCinTroll)
    call PauseUnitBJ(false, udg_U_MidCinTroll)
    call PauseUnitBJ(false, udg_U_CinBoat)
    // ///
    call CreateNUnitsAtLoc(1, udg_UT_Elf_Footman, udg_Player_Elves, GetRectCenter(gg_rct_TharbekCinCorpse01), 45.00)
    set udg_U_UlaTekCinElvenFootman[1]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, udg_UT_Elf_Footman, udg_Player_Elves, GetRectCenter(gg_rct_TharbekCinCorpse02), 45.00)
    set udg_U_UlaTekCinElvenFootman[2]=GetLastCreatedUnit()
    call PauseUnitBJ(true, udg_U_UlaTekCinElvenFootman[1])
    call PauseUnitBJ(true, udg_U_UlaTekCinElvenFootman[2])
    call SetUnitInvulnerable(udg_U_UlaTekCinElvenFootman[1], true)
    call SetUnitInvulnerable(udg_U_UlaTekCinElvenFootman[2], true)
    call SetUnitAnimation(udg_U_UlaTekCinElvenFootman[1], "death")
    call SetUnitAnimation(udg_U_UlaTekCinElvenFootman[2], "death")
    // ///
    call CreateNUnitsAtLocFacingLocBJ(1, udg_UT_Elf_Captain, udg_Player_Elves, GetRectCenter(gg_rct_TharbekCinCorpse03), GetRectCenter(gg_rct_TharbekCinTharbek01))
    set udg_U_UlaTekCinElvenCapt=GetLastCreatedUnit()
    call PauseUnitBJ(true, udg_U_UlaTekCinElvenCapt)
    // ///
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_B006_0327)
    // ///
    call ShowUnitShow(gg_unit_nhcn_0332)
    // ///
    call BlzUnitDisableAbility(udg_U_Loa_Bear, 'AOae', true, true)
    call BlzUnitDisableAbility(udg_U_Loa_DragonHawk, 'AHab', true, true)
    call BlzUnitDisableAbility(udg_U_Loa_Eagle, 'AEar', true, true)
    call BlzUnitDisableAbility(udg_U_Loa_Lynx, 'AEah', true, true)
    // ///
    call SetPlayerAbilityAvailableBJ(false, 'A60C', udg_Player_Actual)
    // ///
endfunction

