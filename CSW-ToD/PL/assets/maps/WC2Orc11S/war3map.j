function Trig_OutroSetUp_Func057C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQZulaman) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OutroSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // ///
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    call SetTimeOfDay(0.00)
    call UseTimeOfDayBJ(false)
    // ///
    call RemoveUnit(udg_U_Loa_Bear)
    call RemoveUnit(udg_U_Loa_DragonHawk)
    call RemoveUnit(udg_U_Loa_Eagle)
    call RemoveUnit(udg_U_Loa_Lynx)
    call SetPlayerColorBJ(udg_Player_CinematicDummy, PLAYER_COLOR_TURQUOISE, false)
    // ///
    // ///
    call ForGroupBJ(udg_UG_SnakesCritters, function Trig_OutroSetUp_Func015A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Phase2CleanUp, udg_Player_Actual), function Trig_OutroSetUp_Func018A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_ActiveGameplayZone, udg_Player_Elves), function Trig_OutroSetUp_Func021A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_ActiveGameplayZone, udg_Player_Humans), function Trig_OutroSetUp_Func024A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_ActiveGameplayZone, udg_Player_Amani), function Trig_OutroSetUp_Func027A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_ActiveGameplayZone, udg_Player_Actual), function Trig_OutroSetUp_Func030A)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_VILLAGE_fog, udg_Player_Amani), function Trig_OutroSetUp_Func034A)
    // //
    call ForGroupBJ(udg_UG_AmaniVillageGroup, function Trig_OutroSetUp_Func036A)
    // ///
    call ForGroupBJ(udg_UG_HiddenUnits, function Trig_OutroSetUp_Func038002)
    // ///
    call ShowUnitHide(udg_U_Loa_Bear)
    call ShowUnitHide(udg_U_Loa_DragonHawk)
    call ShowUnitHide(udg_U_Loa_Eagle)
    call ShowUnitHide(udg_U_Loa_Lynx)
    call SetPlayerAbilityAvailableBJ(false, 'Ashm', udg_Player_Elves)
    call SetPlayerAbilityAvailableBJ(false, 'A60C', udg_Player_Actual)
    // ///
    call CreateNUnitsAtLoc(1, 'H61J', udg_Player_Humans, GetRectCenter(gg_rct_LocalizationItems), bj_UNIT_FACING)
    set udg_FakeIsenglof=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeIsenglof)
    call BlzSetUnitRealFieldBJ(udg_FakeIsenglof, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_FakeIsenglof, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeIsenglof, 0.25)
    call SetUnitAnimationWithRarity(udg_FakeIsenglof, "stand", RARITY_FREQUENT)
    // //
    call SetSoundVolumeBJ(gg_snd_BloodElfTheme01, 40.00)
    // ///
    if ( Trig_OutroSetUp_Func057C() ) then
        call SetSkyModel("Environment\\Sky\\BarrensSky\\BarrensSky.mdl")
        call SetTerrainFogExBJ(0, 1000.00, 5000.00, 0.05, 42.00, 50.00, 58.00)
        call ConditionalTriggerExecute(gg_trg_OutroWinGenerateCorpses)
        // //
        call ShowUnitHide(udg_HeroZuljin)
        // //
        call CameraSetupApplyForPlayer(true, gg_cam_OutroWin00, udg_Player_Actual, 0)
        // //
        call ShowUnitShow(udg_FakeZuljin)
        call UnitRemoveAbilityBJ('A60C', udg_FakeZuljin)
        call SetUnitOwner(udg_FakeZuljin, udg_Player_Actual, true)
        call SetUnitPositionLocFacingBJ(udg_FakeZuljin, GetRectCenter(gg_rct_LoaSnake), 180.00)
        // //
        call SetUnitPositionLocFacingBJ(udg_FakeAnasterian, GetRectCenter(gg_rct_OutroWinAnasterianStatic), 333.13)
        call SetUnitPositionLocFacingBJ(udg_FakeLorthemar, GetRectCenter(gg_rct_OutroLorthemar01), 29.49)
        call SetUnitPositionLocFacingBJ(udg_FakeIsenglof, GetRectCenter(gg_rct_OutroWinIsenglof01), 0.00)
        // //
        call CreateNUnitsAtLoc(1, 'zAtG', udg_Player_Amani, GetRectCenter(gg_rct_OutroCinTrollStart01), 180.00)
        set udg_OutroCinTroll[1]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'zAtG', udg_Player_Amani, GetRectCenter(gg_rct_OutroCinTrollStart02), 180.00)
        set udg_OutroCinTroll[2]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'zAtG', udg_Player_Amani, GetRectCenter(gg_rct_OutroCinTrollStart03), 180.00)
        set udg_OutroCinTroll[3]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'zAtG', udg_Player_Amani, GetRectCenter(gg_rct_OutroCinTrollStart04), 180.00)
        set udg_OutroCinTroll[4]=GetLastCreatedUnit()
        // //
        call CreateNUnitsAtLoc(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_OutroWinFootman01), 0.00)
        set udg_U_OutroCin_Footman[1]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'hhes', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinFootman02), 0.00)
        set udg_U_OutroCin_Footman[2]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_OutroWinFootman03), 0.00)
        set udg_U_OutroCin_Footman[3]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'h60K', udg_Player_Humans, GetRectCenter(gg_rct_OutroWinFootman04), 0.00)
        set udg_U_OutroCin_Footman[4]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'hhes', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinFootman05), 0.00)
        set udg_U_OutroCin_Footman[5]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'hhes', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinFootman06), 0.00)
        set udg_U_OutroCin_Footman[6]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'hhes', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinFootman07), 0.00)
        set udg_U_OutroCin_Footman[7]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'hhes', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinFootman08), 0.00)
        set udg_U_OutroCin_Footman[8]=GetLastCreatedUnit()
        // //
        call CreateNUnitsAtLoc(1, 'h60S', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinArcher01), 0.00)
        set udg_U_OutroCin_Archer[1]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'h60S', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinArcher02), 0.00)
        set udg_U_OutroCin_Archer[2]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'h60S', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinArcher03), 0.00)
        set udg_U_OutroCin_Archer[3]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'h60S', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinArcher04), 0.00)
        set udg_U_OutroCin_Archer[4]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'h60S', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinArcher05), 0.00)
        set udg_U_OutroCin_Archer[5]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'h60S', udg_Player_Elves, GetRectCenter(gg_rct_OutroWinArcher06), 0.00)
        set udg_U_OutroCin_Archer[6]=GetLastCreatedUnit()
        // //
        call SetUnitTimeScalePercent(udg_FakeAnasterian, 50.00)
        call SetUnitAnimationWithRarity(udg_FakeAnasterian, "stand", RARITY_FREQUENT)
        call ShowUnitShow(udg_FakeAnasterian)
        // //
        call ShowUnitShow(udg_FakeIsenglof)
        call ShowUnitShow(udg_FakeLorthemar)
        // //
    else
        // //
        call SetSkyModel("Environment\\Sky\\VillageFallSky\\VillageFallSky.mdl")
        call SetTerrainFogExBJ(0, 2500.00, 8500.00, 0.05, 98.00, 80.00, 25.00)
        call CameraSetupApplyForPlayer(true, gg_cam_ZuljinFlee01, udg_Player_Actual, 0)
        call SetUnitAnimation(gg_unit_nSZW_0002, "death")
        // //
        call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_FakeZuljin)
        call SetUnitBlendTimeBJ(udg_FakeZuljin, 0.15)
        call BlzSetUnitRealFieldBJ(udg_FakeZuljin, UNIT_RF_ANIMATION_WALK_SPEED, 320.00)
        call SetUnitMoveSpeed(udg_FakeZuljin, 320.00)
        // //
        call ShowUnitShow(udg_FakeZuljin)
        call SetUnitOwner(udg_FakeZuljin, Player(PLAYER_NEUTRAL_PASSIVE), false)
        call SetUnitColor(udg_FakeZuljin, PLAYER_COLOR_CYAN)
        call SetUnitPositionLocFacingBJ(udg_FakeZuljin, GetRectCenter(gg_rct_OutroLoseZuljinFlee01), 60.00)
        // //
        call SetDestructableInvulnerableBJ(gg_dest_B006_0327, false)
        call SetUnitPositionLocFacingBJ(udg_FakeAnasterian, GetRectCenter(gg_rct_LoaSnake), 0.00)
        call SetUnitPositionLocFacingBJ(udg_FakeLorthemar, GetRectCenter(gg_rct_OutroLoseLorthemar01), 144.61)
        call SetUnitPositionLocFacingBJ(udg_FakeIsenglof, GetRectCenter(gg_rct_OutroLoseIsenglof01), 0.00)
        // //
        call CreateNUnitsAtLoc(1, udg_UT_Elf_Captain, udg_Player_Elves, GetRectCenter(gg_rct_OutroCaptain), 0.00)
        set udg_U_OutroElfCaptain=GetLastCreatedUnit()
        // //
        call ShowUnitHide(udg_FakeIsenglof)
        // //
        call CreateNUnitsAtLoc(1, udg_UT_Elf_Ballista, udg_Player_Elves, GetRectCenter(gg_rct_OutroBallista), 0.00)
        set udg_U_OutroBallista=GetLastCreatedUnit()
        // //
        // //
    endif
    // ///
    // ///
    // ///
    call ShowUnitHide(gg_unit_nz02_0066)
    call ShowUnitHide(gg_unit_nz03_0068)
    call ShowUnitHide(gg_unit_nz02_0067)
    call ShowUnitHide(gg_unit_nz01_0069)
    // ///
    // ///
    // ///
    // ///
endfunction

