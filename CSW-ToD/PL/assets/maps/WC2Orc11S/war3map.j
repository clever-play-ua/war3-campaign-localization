//===========================================================================
// Trigger: InitPlayers
//===========================================================================
function Trig_InitPlayers_Func023A takes nothing returns nothing
    call SetPlayerTechResearchedSwap('R00T', 3, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R00S', 3, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R00W', 3, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R60K', 3, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R00Z', 1, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R010', 1, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R011', 1, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R00Q', 1, GetEnumPlayer())
endfunction

function Trig_InitPlayers_Func034A takes nothing returns nothing
    call SetPlayerTechResearchedSwap('R013', udg_Int_EnemyUpgradeLevel, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R014', udg_Int_EnemyUpgradeLevel, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R01A', udg_Int_EnemyUpgradeLevel, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R00A', udg_Int_EnemyUpgradeLevel, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R00J', udg_Int_EnemyUpgradeLevel, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('Rhpt', ( udg_Int_EnemyUpgradeLevel - 1 ), GetEnumPlayer())
    call SetPlayerTechResearchedSwap('Rhst', ( udg_Int_EnemyUpgradeLevel - 1 ), GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R00B', 1, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R00C', 1, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R00D', 1, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R017', 1, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R01B', 1, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R019', 1, GetEnumPlayer())
    call SetPlayerTechResearchedSwap('R018', 1, GetEnumPlayer())
endfunction

function Trig_InitPlayers_Actions takes nothing returns nothing
    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[0]
    call EnableOcclusionBJ(true, udg_PlayerGroup_PlayerActual)
    // ////
    // RemoveCinematic Dummies
    // ////
    // ////
    // User Player
    // ////
    set udg_Player_Amani=Player(10)
    set udg_Player_Actual=Player(0)
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 50.00)
    set udg_Player_Tharbek=Player(12)
    call ForceAddPlayerSimple(udg_Player_Amani, udg_PG_Horde)
    call ForceAddPlayerSimple(udg_Player_Actual, udg_PG_Horde)
    call ForceAddPlayerSimple(udg_Player_Tharbek, udg_PG_Horde)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_359")
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_CYAN, false)
    // ////
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_FOOD_CAP, 40)
    // ////
    call ForForce(udg_PG_Horde, function Trig_InitPlayers_Func023A)
    // ////
    // ////
    // Enemy Player
    // ////
    set udg_Player_Elves=Player(14)
    set udg_Player_Humans=Player(9)
    call ForceAddPlayerSimple(udg_Player_Elves, udg_PG_Alliance)
    call ForceAddPlayerSimple(udg_Player_Humans, udg_PG_Alliance)
    // ////
    call TriggerSleepAction(0.10)
    call ForForce(udg_PG_Alliance, function Trig_InitPlayers_Func034A)
    // ////
    set udg_Player_CinematicDummy=Player(23)
    // ////
    // Alliances
    // ////
    call SetPlayerAllianceStateBJ(udg_Player_Amani, udg_Player_Actual, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Amani, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Tharbek, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Tharbek, udg_Player_Actual, bj_ALLIANCE_ALLIED_VISION)
    // ////
    call SetPlayerAllianceStateBJ(udg_Player_Elves, udg_Player_Actual, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Humans, udg_Player_Actual, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Elves, udg_Player_Amani, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Humans, udg_Player_Amani, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Amani, udg_Player_Elves, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Amani, udg_Player_Humans, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Elves, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Humans, bj_ALLIANCE_UNALLIED_VISION)
    // ////
    call ConditionalTriggerExecute(gg_trg_InitUnits)
    call ConditionalTriggerExecute(gg_trg_LoadHeroes)
    // ////
    call ConditionalTriggerExecute(gg_trg_Easy)
    call ConditionalTriggerExecute(gg_trg_Normal)
    call ConditionalTriggerExecute(gg_trg_Hard)
    // ////
endfunction

