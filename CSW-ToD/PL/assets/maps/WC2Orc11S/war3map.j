//===========================================================================
// Trigger: OutroCleanUp
//===========================================================================
function Trig_OutroCleanUp_Func011C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQZulaman) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OutroCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // ///
    set udg_OutroCinematic=false
    // ///
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    if ( Trig_OutroCleanUp_Func011C() ) then
        call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
    else
        call ConditionalTriggerExecute(gg_trg_Defeat)
    endif
endfunction

