function Trig_IntroCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    // ///
    call CinematicModeBJ(true, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_1a, udg_Player_Actual, 0.00)
    call TriggerSleepAction(0.50)
    // ///
    call ConditionalTriggerExecute(gg_trg_IntroSetUp)
    // ///
    // ///
    set udg_IntroCinematic=true
    set udg_InCinematic=true
    call PlaySoundBJ(gg_snd_ZulAmanIntroTheme)
    // ///
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ----------------------------------------------------------------------------------------
    // Zul'Aman Showcase
    // ----------------------------------------------------------------------------------------
    if ( (udg_IntroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 4.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CameraSetFocalDistance(100.00)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cin_1_1b, Player(0), 12.00, 2.00, 0, 1.00)
    call TriggerSleepAction(6.00)
    if ( (udg_IntroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetFocalDistance(0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_2a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_2b, udg_Player_Actual, 15.00)
    call TriggerSleepAction(8.00)
    if ( (udg_IntroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_3a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_3b, udg_Player_Actual, 6.00)
    call TriggerSleepAction(4.00)
    if ( (udg_IntroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_4a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_4b, udg_Player_Actual, 6.00)
    call TriggerSleepAction(3.20)
    if ( (udg_IntroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_5a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_5b, udg_Player_Actual, 6.00)
    call TriggerSleepAction(3.00)
    if ( (udg_IntroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_6a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_6b, udg_Player_Actual, 5.00)
    call TriggerSleepAction(3.25)
    if ( (udg_IntroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_7a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_7b, udg_Player_Actual, 6.00)
    call TriggerSleepAction(4.50)
    if ( (udg_IntroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_9a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_9b, udg_Player_Actual, 20.00)
    call TriggerSleepAction(2.50)
    if ( (udg_IntroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(3.00)
