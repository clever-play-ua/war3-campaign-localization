//===========================================================================
function InitTrig_UlaTekCinematicZuljinControl takes nothing returns nothing
    set gg_trg_UlaTekCinematicZuljinControl=CreateTrigger()
    call DisableTrigger(gg_trg_UlaTekCinematicZuljinControl)
    call TriggerRegisterEnterRectSimple(gg_trg_UlaTekCinematicZuljinControl, gg_rct_Cin_2_Zuljin_2)
    call TriggerAddCondition(gg_trg_UlaTekCinematicZuljinControl, Condition(function Trig_UlaTekCinematicZuljinControl_Conditions))
    call TriggerAddAction(gg_trg_UlaTekCinematicZuljinControl, function Trig_UlaTekCinematicZuljinControl_Actions)
endfunction

//===========================================================================
// Trigger: OutroCinematicQ
//===========================================================================
function Trig_OutroCinematicQ_Func010C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQZulaman) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OutroCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call ConditionalTriggerExecute(gg_trg_OutroSetUp)
    // ///
    call TriggerSleepAction(2.00)
    if ( Trig_OutroCinematicQ_Func010C() ) then
        call ConditionalTriggerExecute(gg_trg_OutroWinCin)
    else
        call ConditionalTriggerExecute(gg_trg_OutroLoseCin)
    endif
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 4.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // ///
    set udg_OutroCinematic=true
    // ///
    // ///
    // ///
    // ///
endfunction

//===========================================================================
function InitTrig_OutroCinematicQ takes nothing returns nothing
    set gg_trg_OutroCinematicQ=CreateTrigger()
    call TriggerAddAction(gg_trg_OutroCinematicQ, function Trig_OutroCinematicQ_Actions)
endfunction

