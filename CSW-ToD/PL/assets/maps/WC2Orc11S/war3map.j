        return false
    endif
    return true
endfunction

function Trig_OutroWinGenerateCorpses_Actions takes nothing returns nothing
    // //
    set udg_UT_CinCorpse[1]=udg_UT_Elf_Footman
    set udg_UT_CinCorpse[2]=udg_UT_Elf_Knight
    set udg_UT_CinCorpse[3]=udg_UT_Elf_Mage
    set udg_UT_CinCorpse[4]=udg_UT_Elf_Priest
    set udg_UT_CinCorpse[5]=udg_UT_Elf_Ranger
    set udg_UT_CinCorpse[6]=udg_UT_HUM_Footman
    set udg_UT_CinCorpse[7]=udg_UT_HUM_Knight
    set udg_UT_CinCorpse[8]=udg_UT_Troll_Melee
    set udg_UT_CinCorpse[9]=udg_UT_Troll_Range
    set udg_UT_CinCorpse[10]=udg_UT_Elf_Archer
    // //
    set udg_Region_BigCorpses[1]=gg_rct_OutroWinCorpses01
    set udg_Region_BigCorpses[2]=gg_rct_OutroWinCorpses02
    set udg_Region_BigCorpses[3]=gg_rct_OutroWinCorpses03
    set udg_Region_BigCorpses[4]=gg_rct_OutroWinCorpses04
    set udg_Region_BigCorpses[5]=gg_rct_OutroWinCorpses05
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set bj_forLoopBIndex=1
        set bj_forLoopBIndexEnd=10
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            set udg_Int_D=1
            loop
                exitwhen udg_Int_D > 2
                set udg_Point_CorpsePoint=GetRandomLocInRect(udg_Region_BigCorpses[GetForLoopIndexA()])
                if ( Trig_OutroWinGenerateCorpses_Func019Func001Func001Func002C() ) then
                    set udg_Player_Corpse=udg_Player_Amani
                else
                    if ( Trig_OutroWinGenerateCorpses_Func019Func001Func001Func002Func001C() ) then
                        set udg_Player_Corpse=udg_Player_Humans
                    else
                        set udg_Player_Corpse=udg_Player_Elves
                    endif
                endif
                call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, udg_UT_CinCorpse[GetForLoopIndexB()], udg_Player_Corpse, udg_Point_CorpsePoint, GetRandomDirectionDeg())
                call RemoveLocation(udg_Point_CorpsePoint)
                set udg_Int_D=udg_Int_D + 1
            endloop
            set bj_forLoopBIndex=bj_forLoopBIndex + 1
        endloop
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    // //
    set udg_Region_SmallCorpses[1]=gg_rct_OutroWinCorpsesMini05
    set udg_Region_SmallCorpses[2]=gg_rct_OutroWinCorpsesMini06
    set udg_Region_SmallCorpses[3]=gg_rct_OutroWinCorpsesMini07
    set udg_Region_SmallCorpses[4]=gg_rct_OutroWinCorpsesMini08
    set udg_Region_SmallCorpses[5]=gg_rct_OutroWinCorpsesMini09
    set udg_Region_SmallCorpses[6]=gg_rct_OutroWinCorpsesMini10
    set udg_Region_SmallCorpses[7]=gg_rct_OutroWinCorpsesMini11
    set udg_Region_SmallCorpses[8]=gg_rct_OutroWinCorpsesMini12
    set udg_Region_SmallCorpses[9]=gg_rct_OutroWinCorpsesMini13
    set udg_Region_SmallCorpses[10]=gg_rct_OutroWinCorpsesMini14
    set udg_Region_SmallCorpses[11]=gg_rct_OutroWinCorpsesMini15
    // //
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=11
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set bj_forLoopBIndex=1
        set bj_forLoopBIndexEnd=2
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            set udg_Point_CorpsePoint=GetRandomLocInRect(udg_Region_SmallCorpses[GetForLoopIndexA()])
            set udg_Int_D=GetRandomInt(1, 10)
            if ( Trig_OutroWinGenerateCorpses_Func035Func001Func003C() ) then
                set udg_Player_Corpse=udg_Player_Amani
            else
                if ( Trig_OutroWinGenerateCorpses_Func035Func001Func003Func001C() ) then
                    set udg_Player_Corpse=udg_Player_Humans
                else
                    set udg_Player_Corpse=udg_Player_Elves
                endif
            endif
            call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, udg_UT_CinCorpse[udg_Int_D], udg_Player_Corpse, udg_Point_CorpsePoint, GetRandomDirectionDeg())
            call RemoveLocation(udg_Point_CorpsePoint)
            set bj_forLoopBIndex=bj_forLoopBIndex + 1
        endloop
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    // //
    // ///
    call SetDoodadAnimationRectBJ("stand", 'Dzb1', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("stand", 'Dzb1', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("stand", 'Dzb1', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("stand", 'Dzb1', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("stand", 'Dzb1', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("stand", 'Dzb1', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("stand", 'Dzb2', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("stand", 'Dzb2', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("stand", 'Dzb2', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("stand", 'Dzb2', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("stand", 'Dzb2', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("stand", 'Dzb2', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("stand", 'Dzb3', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("stand", 'Dzb3', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("stand", 'Dzb3', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("stand", 'Dzb3', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("stand", 'Dzb3', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("stand", 'Dzb3', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("stand", 'Dzb4', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("stand", 'Dzb4', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("stand", 'Dzb4', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("stand", 'Dzb4', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("stand", 'Dzb4', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("stand", 'Dzb4', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("stand", 'Dzb5', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("stand", 'Dzb5', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("stand", 'Dzb5', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("stand", 'Dzb5', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("stand", 'Dzb5', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("stand", 'Dzb5', gg_rct_BloodsplatsMini)
    // ///
    call SetDoodadAnimationRectBJ("stand", 'Dzb6', gg_rct_OutroWinCorpses01)
    call SetDoodadAnimationRectBJ("stand", 'Dzb6', gg_rct_OutroWinCorpses02)
    call SetDoodadAnimationRectBJ("stand", 'Dzb6', gg_rct_OutroWinCorpses03)
    call SetDoodadAnimationRectBJ("stand", 'Dzb6', gg_rct_OutroWinCorpses04)
    call SetDoodadAnimationRectBJ("stand", 'Dzb6', gg_rct_OutroWinCorpses05)
    call SetDoodadAnimationRectBJ("stand", 'Dzb6', gg_rct_BloodsplatsMini)
    // ///
    // //
    // //
    // //
endfunction

