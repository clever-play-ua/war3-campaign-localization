//===========================================================================
// Trigger: AnasterianBubbleOn
//===========================================================================
function Trig_AnasterianBubbleOn_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_AnasterianInBubble == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianBubbleOn_Actions takes nothing returns nothing
    set udg_Bool_AnasterianInBubble=true
    call AddSpecialEffectTargetUnitBJ("origin", udg_HeroAnasterian, "Abilities\\Spells\\Other\\AttackMarker\\AttackMarker.mdl")
    set udg_SE_AnasterianBubble=GetLastCreatedEffectBJ()
    call PauseUnitBJ(true, udg_HeroAnasterian)
    call PlayThematicMusicBJ("Doom")
    call SetUnitAnimation(udg_HeroAnasterian, "spell slam")
    call EnableTrigger(gg_trg_AnasterianGetsDamageAndTeleportsAway)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=30
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call QueueUnitAnimationBJ(udg_HeroAnasterian, "spell slam")
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_AnasterianBubbleOn takes nothing returns nothing
    set gg_trg_AnasterianBubbleOn=CreateTrigger()
    call TriggerAddCondition(gg_trg_AnasterianBubbleOn, Condition(function Trig_AnasterianBubbleOn_Conditions))
    call TriggerAddAction(gg_trg_AnasterianBubbleOn, function Trig_AnasterianBubbleOn_Actions)
endfunction

//===========================================================================
// Trigger: AnasterianBubbleOff
//===========================================================================
function Trig_AnasterianBubbleOff_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_AnasterianInBubble == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianBubbleOff_Actions takes nothing returns nothing
    set udg_Bool_AnasterianInBubble=false
    // //
    call SetUnitInvulnerable(udg_HeroAnasterian, false)
    call DestroyEffectBJ(udg_SE_AnasterianBubble)
    call PauseUnitBJ(false, udg_HeroAnasterian)
    // //
    call RemoveUnit(udg_DummyFireStormLich)
    // //
    call TriggerExecute(gg_trg_MoveAnasterianToDefaultPosition)
    call ConditionalTriggerExecute(gg_trg_StartTimer)
    call EndThematicMusicBJ()
endfunction

//===========================================================================
function InitTrig_AnasterianBubbleOff takes nothing returns nothing
    set gg_trg_AnasterianBubbleOff=CreateTrigger()
    call TriggerAddCondition(gg_trg_AnasterianBubbleOff, Condition(function Trig_AnasterianBubbleOff_Conditions))
    call TriggerAddAction(gg_trg_AnasterianBubbleOff, function Trig_AnasterianBubbleOff_Actions)
endfunction

//===========================================================================
// Trigger: AnasterianGetsDamageAndTeleportsAway
//===========================================================================
function Trig_AnasterianGetsDamageAndTeleportsAway_Conditions takes nothing returns boolean
    if ( not ( BlzGetEventDamageTarget() == udg_HeroAnasterian ) ) then
        return false
    endif
    if ( not ( GetUnitLifePercent(udg_HeroAnasterian) <= 15.00 ) ) then
        return false
    endif
    if ( not ( udg_Bool_AnasterianInBubble == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianGetsDamageAndTeleportsAway_Func005C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Spawn_Gate_Anasterian_Top_Ph1, udg_HeroAnasterian) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianGetsDamageAndTeleportsAway_Func007C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Spawn_Gate_Anasterian_Bot_Ph1, udg_HeroAnasterian) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianGetsDamageAndTeleportsAway_Func009C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Spawn_Gate_Anasterian_Top_Ph2, udg_HeroAnasterian) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianGetsDamageAndTeleportsAway_Func011C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_Spawn_Gate_Anasterian_Bot_Ph2, udg_HeroAnasterian) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnasterianGetsDamageAndTeleportsAway_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitInvulnerable(udg_HeroAnasterian, true)
    call PauseTimerBJ(true, udg_Timer_SaveLoa)
    // Eagle
    if ( Trig_AnasterianGetsDamageAndTeleportsAway_Func005C() ) then
        call TriggerExecute(gg_trg_CompletedQuestReqEagleLoa)
    else
    endif
    // Bear
    if ( Trig_AnasterianGetsDamageAndTeleportsAway_Func007C() ) then
        call TriggerExecute(gg_trg_CompletedQuestReqBearLoa)
    else
    endif
    // Lynx
    if ( Trig_AnasterianGetsDamageAndTeleportsAway_Func009C() ) then
        call TriggerExecute(gg_trg_CompletedQuestReqLynxLoa)
    else
    endif
    // DragonHawk
    if ( Trig_AnasterianGetsDamageAndTeleportsAway_Func011C() ) then
        call TriggerExecute(gg_trg_CompletedQuestReqDragonHawkLoa)
    else
    endif
    call ConditionalTriggerExecute(gg_trg_AnasterianBubbleOff)
endfunction

