    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(2.00)
    call DestroyMinimapIcon(udg_MinimapIconLoa[3])
    call QuestItemSetDescriptionBJ(udg_OQReqLoa[3], "TRIGSTR_645")
    call TriggerSleepAction(2.00)
    // //
    if ( Trig_FailedQuestReqLynxLoaQ_Func007C() ) then
        call QueuedTriggerAddBJ(gg_trg_VOTrollCaptain01Q, true)
    else
    endif
    if ( Trig_FailedQuestReqLynxLoaQ_Func008C() ) then
        call QueuedTriggerAddBJ(gg_trg_VOTrollCaptain02Q, true)
        call QueuedTriggerAddBJ(gg_trg_QuestLoaFailed, true)
    else
        if ( Trig_FailedQuestReqLynxLoaQ_Func008Func001C() ) then
            call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_646")
            call TriggerSleepAction(2.00)
            if ( Trig_FailedQuestReqLynxLoaQ_Func008Func001Func004C() ) then
                call ConditionalTriggerExecute(gg_trg_AnasterianAlternateSummonCheckerLaunch)
            else
            endif
        else
            call ConditionalTriggerExecute(gg_trg_QuestLoaCompleted)
        endif
    endif
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

