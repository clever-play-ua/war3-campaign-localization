function Trig_Elf_Wave_Spawn_Actions takes nothing returns nothing
    // TOP
    if ( Trig_Elf_Wave_Spawn_Func002C() ) then
        // ///
        // T A R G E T S
        // ///
        if ( Trig_Elf_Wave_Spawn_Func002Func004C() ) then
            set udg_TempPoint_SpawnTop1=GetRectCenter(gg_rct_Spawn_Gate_Elite_Top)
            set udg_TempPoint_SpawnTop2=GetRectCenter(gg_rct_Spawn_Gate_Melle_Top)
            set udg_TempPoint_SpawnTop3=GetRectCenter(gg_rct_Spawn_Gate_Ranged_Top)
        else
            if ( Trig_Elf_Wave_Spawn_Func002Func004Func001C() ) then
                set udg_TempPoint_SpawnTop1=GetRectCenter(gg_rct_Spawn_Gate_Elite_Top_Ph2)
                set udg_TempPoint_SpawnTop2=GetRectCenter(gg_rct_Spawn_Gate_Melle_Top_Ph2)
                set udg_TempPoint_SpawnTop3=GetRectCenter(gg_rct_Spawn_Gate_Ranged_Top_Ph2)
            else
                if ( Trig_Elf_Wave_Spawn_Func002Func004Func001Func001C() ) then
                    set udg_TempPoint_SpawnTop1=GetRectCenter(gg_rct_Spawn_Gate_Elite_Top_Ph3)
                    set udg_TempPoint_SpawnTop2=GetRectCenter(gg_rct_Spawn_Gate_Melle_Top_Ph3)
                    set udg_TempPoint_SpawnTop3=GetRectCenter(gg_rct_Spawn_Gate_Ranged_Top_Ph3)
                else
                endif
            endif
        endif
        // ///
        // U N I T S
        // ///
        // Leader
        if ( Trig_Elf_Wave_Spawn_Func002Func009C() ) then
            if ( Trig_Elf_Wave_Spawn_Func002Func009Func001C() ) then
                call CreateNUnitsAtLoc(1, udg_UT_Elf_Captain, udg_Player_Elves, udg_TempPoint_SpawnTop1, 0.00)
            else
                if ( Trig_Elf_Wave_Spawn_Func002Func009Func001Func001C() ) then
                    if ( Trig_Elf_Wave_Spawn_Func002Func009Func001Func001Func002C() ) then
                        call CreateNUnitsAtLoc(1, udg_UT_Elf_Knight, udg_Player_Elves, udg_TempPoint_SpawnTop1, 0.00)
                    else
                        call CreateNUnitsAtLoc(1, udg_UT_HUM_Knight, udg_Player_Humans, udg_TempPoint_SpawnTop1, 0.00)
                    endif
                else
                    call DoNothing()
                endif
            endif
        else
            if ( Trig_Elf_Wave_Spawn_Func002Func009Func002C() ) then
                // Hero
                call ForGroupBJ(GetRandomSubGroup(1, udg_UG_HerousBench), function Trig_Elf_Wave_Spawn_Func002Func009Func002Func003A)
            else
            endif
        endif
        // Footman
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=udg_Int_WaveFootmanAmount
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            // Roll A Dice for footman variation
            set udg_Int_EnemyUnitRoll=GetRandomInt(1, 2)
            if ( Trig_Elf_Wave_Spawn_Func002Func011Func003C() ) then
                set udg_UT_EnemyAttack_Footman=udg_UT_Elf_Footman
                set udg_Player_SpawnVariation=udg_Player_Elves
            else
                set udg_UT_EnemyAttack_Footman=udg_UT_HUM_Footman
                set udg_Player_SpawnVariation=udg_Player_Humans
            endif
            call CreateNUnitsAtLoc(1, udg_UT_EnemyAttack_Footman, udg_Player_SpawnVariation, udg_TempPoint_SpawnTop2, 0.00)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        // Ranged
        if ( Trig_Elf_Wave_Spawn_Func002Func013C() ) then
            call CreateNUnitsAtLoc(udg_Int_WaveArcherAmount, udg_UT_Elf_Archer, udg_Player_Elves, udg_TempPoint_SpawnTop2, 0.00)
        else
            if ( Trig_Elf_Wave_Spawn_Func002Func013Func001C() ) then
                call CreateNUnitsAtLoc(udg_Int_WaveArcherAmount, udg_UT_Elf_Ranger, udg_Player_Elves, udg_TempPoint_SpawnTop2, 0.00)
            else
                call DoNothing()
            endif
        endif
        // Priest
        if ( Trig_Elf_Wave_Spawn_Func002Func015C() ) then
            if ( Trig_Elf_Wave_Spawn_Func002Func015Func001C() ) then
                call CreateNUnitsAtLoc(udg_Int_WavePriestAmount, udg_UT_Elf_Priest, udg_Player_Elves, udg_TempPoint_SpawnTop2, 0.00)
            else
                if ( Trig_Elf_Wave_Spawn_Func002Func015Func001Func003C() ) then
                    if ( Trig_Elf_Wave_Spawn_Func002Func015Func001Func003Func001C() ) then
                        call CreateNUnitsAtLoc(udg_Int_WavePriestAmount, udg_UT_Elf_Priest, udg_Player_Elves, udg_TempPoint_SpawnTop2, 0.00)
                    else
                        call CreateNUnitsAtLoc(udg_Int_WavePriestAmount, udg_UT_Elf_Botanist, udg_Player_Elves, udg_TempPoint_SpawnTop2, 0.00)
                    endif
                else
                    call DoNothing()
                endif
            endif
        else
        endif
        // Caster
        if ( Trig_Elf_Wave_Spawn_Func002Func017C() ) then
            call CreateNUnitsAtLoc(udg_Int_WaveCasterAmount, udg_UT_Elf_Mage, udg_Player_Elves, udg_TempPoint_SpawnTop2, 0.00)
        else
        endif
        // Siege
        if ( Trig_Elf_Wave_Spawn_Func002Func019C() ) then
            call CreateNUnitsAtLoc(udg_Int_WaveSiegeAmount, udg_UT_Elf_Ballista, udg_Player_Elves, udg_TempPoint_SpawnTop3, 0.00)
        else
        endif
        // ///
        // G R O U P
        call PolledWait(0.50)
        // ///
        // //
        // //
        call DestroyGroup(udg_TempGroupElfSpawn)
        set udg_TempGroupElfSpawn=GetUnitsInRectMatching(udg_Region_GrapElves_Top, Condition(function Trig_Elf_Wave_Spawn_Func002Func031002002))
        call ForGroupBJ(udg_TempGroupElfSpawn, function Trig_Elf_Wave_Spawn_Func002Func032A)
        call DestroyGroup(udg_TempGroupElfSpawn)
        set udg_TempGroupElfSpawn=GetUnitsInRectMatching(udg_Region_GrapElves_Top, Condition(function Trig_Elf_Wave_Spawn_Func002Func034002002))
        call ForGroupBJ(udg_TempGroupElfSpawn, function Trig_Elf_Wave_Spawn_Func002Func035A)
        // //
        call PolledWait(0.50)
        call ForGroupBJ(udg_WaveGroup_Top, function Trig_Elf_Wave_Spawn_Func002Func038002)
        call GroupPointOrderLocBJ(udg_WaveGroup_Top, "attack", udg_GoalPoint_LoaTop)
        // //
        call RemoveLocation(udg_TempPoint_SpawnTop1)
        call RemoveLocation(udg_TempPoint_SpawnTop2)
        call RemoveLocation(udg_TempPoint_SpawnTop3)
        // //
        call EnableTrigger(gg_trg_ElvenWaveKilledTop)
        // ///
        // ///
    else
    endif
    // ///
    // BOTTOM
    // ///
    if ( Trig_Elf_Wave_Spawn_Func006C() ) then
        // ///
        // T A R G E T S
        // ///
        if ( Trig_Elf_Wave_Spawn_Func006Func004C() ) then
            set udg_TempPoint_SpawnBot1=GetRectCenter(gg_rct_Spawn_Gate_Elite_Bot)
            set udg_TempPoint_SpawnBot2=GetRectCenter(gg_rct_Spawn_Gate_Melle_Bot)
            set udg_TempPoint_SpawnBot3=GetRectCenter(gg_rct_Spawn_Gate_Ranged_Bot)
        else
            if ( Trig_Elf_Wave_Spawn_Func006Func004Func004C() ) then
                set udg_TempPoint_SpawnBot1=GetRectCenter(gg_rct_Spawn_Gate_Elite_Bot_Ph2)
                set udg_TempPoint_SpawnBot2=GetRectCenter(gg_rct_Spawn_Gate_Melle_Bot_Ph2)
                set udg_TempPoint_SpawnBot3=GetRectCenter(gg_rct_Spawn_Gate_Ranged_Bot_Ph2)
            else
                if ( Trig_Elf_Wave_Spawn_Func006Func004Func004Func004C() ) then
                    set udg_TempPoint_SpawnBot1=GetRectCenter(gg_rct_Spawn_Gate_Elite_Bot_Ph3)
                    set udg_TempPoint_SpawnBot2=GetRectCenter(gg_rct_Spawn_Gate_Melle_Bot_Ph3)
                    set udg_TempPoint_SpawnBot3=GetRectCenter(gg_rct_Spawn_Gate_Ranged_Bot_Ph3)
                else
                endif
            endif
        endif
        // ///
        // U N I T S
        // ///
        // Leader
        if ( Trig_Elf_Wave_Spawn_Func006Func009C() ) then
            if ( Trig_Elf_Wave_Spawn_Func006Func009Func001C() ) then
                call CreateNUnitsAtLoc(1, udg_UT_Elf_Captain, udg_Player_Elves, udg_TempPoint_SpawnBot1, 0.00)
            else
                if ( Trig_Elf_Wave_Spawn_Func006Func009Func001Func001C() ) then
                    if ( Trig_Elf_Wave_Spawn_Func006Func009Func001Func001Func002C() ) then
                        call CreateNUnitsAtLoc(1, udg_UT_Elf_Knight, udg_Player_Elves, udg_TempPoint_SpawnBot1, 0.00)
                    else
                        call CreateNUnitsAtLoc(1, udg_UT_HUM_Knight, udg_Player_Humans, udg_TempPoint_SpawnBot1, 0.00)
                    endif
                else
                    call DoNothing()
                endif
            endif
        else
            if ( Trig_Elf_Wave_Spawn_Func006Func009Func002C() ) then
                // Hero
                call ForGroupBJ(GetRandomSubGroup(1, udg_UG_HerousBench), function Trig_Elf_Wave_Spawn_Func006Func009Func002Func004A)
            else
            endif
        endif
        // Footman
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=udg_Int_WaveFootmanAmount
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            // Roll A Dice for footman variation
            set udg_Int_EnemyUnitRoll=GetRandomInt(1, 2)
            if ( Trig_Elf_Wave_Spawn_Func006Func011Func003C() ) then
                set udg_UT_EnemyAttack_Footman=udg_UT_Elf_Footman
                set udg_Player_SpawnVariation=udg_Player_Elves
            else
                set udg_UT_EnemyAttack_Footman=udg_UT_HUM_Footman
                set udg_Player_SpawnVariation=udg_Player_Humans
            endif
            call CreateNUnitsAtLoc(1, udg_UT_EnemyAttack_Footman, udg_Player_SpawnVariation, udg_TempPoint_SpawnBot2, 0.00)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        // Ranged
        if ( Trig_Elf_Wave_Spawn_Func006Func013C() ) then
            call CreateNUnitsAtLoc(udg_Int_WaveArcherAmount, udg_UT_Elf_Archer, udg_Player_Elves, udg_TempPoint_SpawnBot2, 0.00)
        else
            if ( Trig_Elf_Wave_Spawn_Func006Func013Func001C() ) then
                call CreateNUnitsAtLoc(udg_Int_WaveArcherAmount, udg_UT_Elf_Ranger, udg_Player_Elves, udg_TempPoint_SpawnBot2, 0.00)
            else
                call DoNothing()
            endif
        endif
        // Priest
        if ( Trig_Elf_Wave_Spawn_Func006Func015C() ) then
            if ( Trig_Elf_Wave_Spawn_Func006Func015Func001C() ) then
                call CreateNUnitsAtLoc(udg_Int_WavePriestAmount, udg_UT_Elf_Priest, udg_Player_Elves, udg_TempPoint_SpawnBot2, 0.00)
            else
                if ( Trig_Elf_Wave_Spawn_Func006Func015Func001Func003C() ) then
                    if ( Trig_Elf_Wave_Spawn_Func006Func015Func001Func003Func001C() ) then
                        call CreateNUnitsAtLoc(udg_Int_WavePriestAmount, udg_UT_Elf_Priest, udg_Player_Elves, udg_TempPoint_SpawnBot2, 0.00)
                    else
                        call CreateNUnitsAtLoc(udg_Int_WavePriestAmount, udg_UT_Elf_Botanist, udg_Player_Elves, udg_TempPoint_SpawnBot2, 0.00)
                    endif
                else
                    call DoNothing()
                endif
            endif
        else
        endif
        // Caster
        if ( Trig_Elf_Wave_Spawn_Func006Func017C() ) then
            call CreateNUnitsAtLoc(udg_Int_WaveCasterAmount, udg_UT_Elf_Mage, udg_Player_Elves, udg_TempPoint_SpawnBot2, 0.00)
        else
        endif
        // Siege
        if ( Trig_Elf_Wave_Spawn_Func006Func019C() ) then
            call CreateNUnitsAtLoc(1, udg_UT_Elf_Ballista, udg_Player_Elves, udg_TempPoint_SpawnBot3, 0.00)
        else
        endif
        // ///
        // G R O U P
        // ///
        call PolledWait(0.50)
        call DestroyGroup(udg_TempGroupElfSpawn)
        set udg_TempGroupElfSpawn=GetUnitsInRectMatching(udg_Region_GrapElves_Bot, Condition(function Trig_Elf_Wave_Spawn_Func006Func027002002))
        call ForGroupBJ(udg_TempGroupElfSpawn, function Trig_Elf_Wave_Spawn_Func006Func028A)
        // //
        call DestroyGroup(udg_TempGroupElfSpawn)
        set udg_TempGroupElfSpawn=GetUnitsInRectMatching(udg_Region_GrapElves_Bot, Condition(function Trig_Elf_Wave_Spawn_Func006Func033002002))
        call ForGroupBJ(udg_TempGroupElfSpawn, function Trig_Elf_Wave_Spawn_Func006Func034A)
        // //
        call PolledWait(0.50)
        call ForGroupBJ(udg_WaveGroup_Bot, function Trig_Elf_Wave_Spawn_Func006Func037002)
        call GroupPointOrderLocBJ(udg_WaveGroup_Bot, "attack", udg_GoalPoint_LoaBottom)
        // //
        call RemoveLocation(udg_TempPoint_SpawnBot1)
        call RemoveLocation(udg_TempPoint_SpawnBot2)
        call RemoveLocation(udg_TempPoint_SpawnBot3)
        // //
        call EnableTrigger(gg_trg_ElvenWaveKilledBottom)
        // ///
    else
    endif
    // ///
    call EnableTrigger(gg_trg_Elf_Wave_Resume__Attack)
    // ///
    call PolledWait(0.50)
    call ConditionalTriggerExecute(gg_trg_ColorChanger)
    // ///
    call PolledWait(10.00)
    // ///
    call TriggerExecute(gg_trg_Troll_Wave_Top_Spawn)
    call PolledWait(0.50)
    call TriggerExecute(gg_trg_Troll_Wave_Bottom_Spawn)
    // ///
    // ///
    // ///
    // ///
    // ///
endfunction

//===========================================================================
function InitTrig_Elf_Wave_Spawn takes nothing returns nothing
    set gg_trg_Elf_Wave_Spawn=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Elf_Wave_Spawn, udg_Timer_EnemySpawner)
    call TriggerAddAction(gg_trg_Elf_Wave_Spawn, function Trig_Elf_Wave_Spawn_Actions)
endfunction

//===========================================================================
// Trigger: ElvenWaveKilledTop
//===========================================================================
function Trig_ElvenWaveKilledTop_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Top) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ElvenWaveKilledTop_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_StartTimer)
endfunction

//===========================================================================
function InitTrig_ElvenWaveKilledTop takes nothing returns nothing
    set gg_trg_ElvenWaveKilledTop=CreateTrigger()
    call DisableTrigger(gg_trg_ElvenWaveKilledTop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_ElvenWaveKilledTop, GetRandomReal(1.00, 3.00))
    call TriggerAddCondition(gg_trg_ElvenWaveKilledTop, Condition(function Trig_ElvenWaveKilledTop_Conditions))
    call TriggerAddAction(gg_trg_ElvenWaveKilledTop, function Trig_ElvenWaveKilledTop_Actions)
endfunction

