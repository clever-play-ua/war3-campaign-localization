endfunction

function Trig_OutroLoseCinKillTrollsWithFire_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=6
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call ForGroupBJ(GetRandomSubGroup(1, udg_UG_RunningCivilians), function Trig_OutroLoseCinKillTrollsWithFire_Func002Func001A)
        call TriggerSleepAction(1.00)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
endfunction

