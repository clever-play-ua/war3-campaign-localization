function Trig_IntroSetUp_Func081A takes nothing returns nothing
    call SetUnitPathing(GetEnumUnit(), false)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", GetEnumUnit())
    call SetUnitMoveSpeed(GetEnumUnit(), 60.00)
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitTimeScalePercent(GetEnumUnit(), GetRandomReal(90.00, 100.00))
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_IntroSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // ----------------------------------------------------------------------------------------
    // Weather
    // ----------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 1000.00, 10000.00, 0, 42.00, 50.00, 58.00)
    call SetSkyModel("Environment\\Sky\\BarrensSky\\BarrensSky.mdl")
    call SetTimeOfDay(12)
    call UseTimeOfDayBJ(false)
    // ----------------------------------------------------------------------------------------
    // Create Fake Actors
    // ----------------------------------------------------------------------------------------
    call CreateNUnitsAtLoc(1, 'OZcN', udg_Player_Actual, GetRectCenter(gg_rct_Cin_1_Zuljin_1), 180.00)
    set udg_FakeZuljin=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuljin)
    call SetUnitBlendTimeBJ(udg_FakeZuljin, 1.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuljin, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_FakeZuljin, 100.00)
    call ShowUnitHide(udg_FakeZuljin)
    // ///
    call CreateNUnitsAtLoc(1, 'zAoT', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_1_Tharbek_1), 210.00)
    set udg_FakeTharbek=GetLastCreatedUnit()
    call SetUnitColor(udg_FakeTharbek, PLAYER_COLOR_RED)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeTharbek)
    call SetUnitBlendTimeBJ(udg_FakeTharbek, 0.50)
    call BlzSetUnitRealFieldBJ(udg_FakeTharbek, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_FakeTharbek, 100.00)
    call ShowUnitHide(udg_FakeTharbek)
    // ----------------------------------------------------------------------------------------
    call CreateNUnitsAtLoc(1, 'zAtG', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_1_Guard_1), 180.00)
    set udg_Unit_Cin1_Guard1=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_Cin1_Guard1, GetPlayerColor(Player(12)))
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_Cin1_Guard1)
    call SetUnitBlendTimeBJ(udg_Unit_Cin1_Guard1, 1.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_Cin1_Guard1, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_Unit_Cin1_Guard1, 100.00)
    call ShowUnitHide(udg_Unit_Cin1_Guard1)
    // ///
    call CreateNUnitsAtLoc(1, 'zAtG', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_1_Guard_2), 180.00)
    set udg_Unit_Cin1_Guard2=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_Cin1_Guard2, GetPlayerColor(Player(12)))
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_Cin1_Guard2)
    call SetUnitBlendTimeBJ(udg_Unit_Cin1_Guard2, 1.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_Cin1_Guard2, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_Unit_Cin1_Guard2, 100.00)
    call ShowUnitHide(udg_Unit_Cin1_Guard2)
    // ///
    call CreateNUnitsAtLoc(1, 'nftr', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_1_Troll_1), 180.00)
    set udg_Unit_Cin1_Troll1=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_Cin1_Troll1, GetPlayerColor(Player(15)))
    call SetUnitMoveSpeed(udg_Unit_Cin1_Troll1, 100.00)
    call ShowUnitHide(udg_Unit_Cin1_Troll1)
    // ///
    call CreateNUnitsAtLoc(1, 'zAtW', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_1_Troll_2), 180.00)
    set udg_Unit_Cin1_Troll2=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_Cin1_Troll2, GetPlayerColor(Player(10)))
    call SetUnitMoveSpeed(udg_Unit_Cin1_Troll2, 100.00)
    call ShowUnitHide(udg_Unit_Cin1_Troll2)
    // ///
    call CreateNUnitsAtLoc(1, 'nftt', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_1_Troll_3), 180.00)
    set udg_Unit_Cin1_Troll3=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_Cin1_Troll3, GetPlayerColor(Player(5)))
    call SetUnitMoveSpeed(udg_Unit_Cin1_Troll3, 100.00)
    call ShowUnitHide(udg_Unit_Cin1_Troll3)
    // ///
    call CreateNUnitsAtLoc(1, 'zAtW', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_1_Troll_4), 180.00)
    set udg_Unit_Cin1_Troll4=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_Cin1_Troll4, GetPlayerColor(Player(10)))
    call SetUnitMoveSpeed(udg_Unit_Cin1_Troll4, 100.00)
    call ShowUnitHide(udg_Unit_Cin1_Troll4)
    // ----------------------------------------------------------------------------------------
    call ShowUnitHide(udg_FakeRommath)
    call ShowUnitHide(udg_FakeHalduron)
    call ShowUnitHide(udg_FakeAnasterian)
    call ShowUnitHide(udg_FakeLorthemar)
    call ShowUnitHide(udg_FakeLiadrin)
    // ----------------------------------------------------------------------------------------
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_Cin_Elven_Army), function Trig_IntroSetUp_Func079A)
    // ----------------------------------------------------------------------------------------
    call ForGroupBJ(udg_TempGroup_CinArmy, function Trig_IntroSetUp_Func081A)
    // //
    // //
    call SetUnitAnimationWithRarity(udg_FakeAnasterian, "stand", RARITY_FREQUENT)
    // //
    // //
    call BlzUnitDisableAbility(udg_U_Loa_Bear, 'AOae', true, true)
    call BlzUnitDisableAbility(udg_U_Loa_DragonHawk, 'AHab', true, true)
    call BlzUnitDisableAbility(udg_U_Loa_Eagle, 'AEar', true, true)
    call BlzUnitDisableAbility(udg_U_Loa_Lynx, 'AEah', true, true)
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_IntroSetUp takes nothing returns nothing
    set gg_trg_IntroSetUp=CreateTrigger()
    call TriggerAddAction(gg_trg_IntroSetUp, function Trig_IntroSetUp_Actions)
endfunction

