//===========================================================================
function InitTrig_IntroCinematicQ takes nothing returns nothing
    set gg_trg_IntroCinematicQ=CreateTrigger()
    call TriggerAddAction(gg_trg_IntroCinematicQ, function Trig_IntroCinematicQ_Actions)
endfunction

//===========================================================================
// Trigger: IntroCinZuljinEntersDialogue
//===========================================================================
function Trig_IntroCinZuljinEntersDialogue_Conditions takes nothing returns boolean
    if ( not ( udg_IntroCinematic == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_FakeZuljin ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCinZuljinEntersDialogue_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitAnimation(udg_FakeZuljin, "cinematic standard one")
endfunction

//===========================================================================
function InitTrig_IntroCinZuljinEntersDialogue takes nothing returns nothing
    set gg_trg_IntroCinZuljinEntersDialogue=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_IntroCinZuljinEntersDialogue, gg_rct_Cin_1_Zuljin_1_Goal)
    call TriggerAddCondition(gg_trg_IntroCinZuljinEntersDialogue, Condition(function Trig_IntroCinZuljinEntersDialogue_Conditions))
    call TriggerAddAction(gg_trg_IntroCinZuljinEntersDialogue, function Trig_IntroCinZuljinEntersDialogue_Actions)
endfunction

//===========================================================================
// Trigger: IntroSkipped
//===========================================================================
function Trig_IntroSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_IntroCinematic == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_IntroCinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_IntroCleanUp)
    call StopSoundBJ(gg_snd_ZulamanTheme02, false)
    call StopSoundBJ(gg_snd_ZulAmanIntroTheme, false)
endfunction

//===========================================================================
function InitTrig_IntroSkipped takes nothing returns nothing
    set gg_trg_IntroSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_IntroSkipped, Player(0))
    call TriggerAddCondition(gg_trg_IntroSkipped, Condition(function Trig_IntroSkipped_Conditions))
    call TriggerAddAction(gg_trg_IntroSkipped, function Trig_IntroSkipped_Actions)
endfunction

//===========================================================================
// Trigger: IntroCleanUp
//===========================================================================
function Trig_IntroCleanUp_Func061A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_IntroCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_IntroCinematic=false
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_StartGameCamera, udg_Player_Actual, 0)
    call TriggerSleepAction(0.01)
    call CameraSetFocalDistance(0.00)
    // ///
    call TriggerSleepAction(0.01)
    call SetCameraBoundsToRectForPlayerBJ(Player(0), gg_rct_ActiveGameplayZone)
    call BlzChangeMinimapTerrainTex("Mimimap11S.tga")
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // ///
    // ----------------------------------------------------------------------------------------
    // Sound & Music
    // ----------------------------------------------------------------------------------------
    call StopSoundBJ(gg_snd_WC2Orc11SAnasterian1, true)
    call StopSoundBJ(gg_snd_WC2Orc11SAnasterian2, true)
    call StopSoundBJ(gg_snd_WC2Orc11SAnasterian3, true)
    call StopSoundBJ(gg_snd_WC2Orc11SAnasterian4, true)
    call StopSoundBJ(gg_snd_WC2Orc11SZuljin1, true)
    call StopSoundBJ(gg_snd_WC2Orc11SZuljin2, true)
    call StopSoundBJ(gg_snd_WC2Orc11SZuljin3, true)
    call StopSoundBJ(gg_snd_WC2Orc11STharbek1, true)
    // ///
    call StopSoundBJ(gg_snd_ZulAmanIntroTheme, true)
    call StopSoundBJ(gg_snd_CS_H01a_soldiers_cheer_006_LR_v3, false)
    call StopSoundBJ(gg_snd_TrollVictoryShouting, true)
    call StopSoundBJ(gg_snd_DwarfHorn, true)
    call StopSoundBJ(gg_snd_IceCrownRoundDoorRollingOpen, true)
    call StopSoundBJ(gg_snd_WalkArmorLoop, true)
    // ///
    // ----------------------------------------------------------------------------------------
    // Clear Units
    // ----------------------------------------------------------------------------------------
    call ShowUnitHide(udg_FakeZuljin)
    call SetUnitOwner(udg_FakeZuljin, Player(PLAYER_NEUTRAL_PASSIVE), true)
    call ShowUnitHide(udg_FakeTharbek)
    call ShowUnitHide(udg_FakeRommath)
    call ShowUnitHide(udg_FakeHalduron)
    call ShowUnitHide(udg_FakeAnasterian)
    call ShowUnitHide(udg_FakeLorthemar)
    call ShowUnitHide(udg_FakeLiadrin)
    // ///
    call BlzUnitDisableAbility(udg_U_Loa_Bear, 'AOae', false, false)
    call BlzUnitDisableAbility(udg_U_Loa_DragonHawk, 'AHab', false, false)
    call BlzUnitDisableAbility(udg_U_Loa_Eagle, 'AEar', false, false)
    call BlzUnitDisableAbility(udg_U_Loa_Lynx, 'AEah', false, false)
    // ///
    call ShowUnitShow(udg_HeroZuljin)
    call UnitAddItemByIdSwapped('IZUW', udg_HeroZuljin)
    // ///
    call RemoveUnit(udg_Unit_Cin1_Guard1)
    call RemoveUnit(udg_Unit_Cin1_Guard2)
    call RemoveUnit(udg_Unit_Cin1_Troll1)
    call RemoveUnit(udg_Unit_Cin1_Troll2)
    call RemoveUnit(udg_Unit_Cin1_Troll3)
    call RemoveUnit(udg_Unit_Cin1_Troll4)
    call ForGroupBJ(udg_TempGroup_CinArmy, function Trig_IntroCleanUp_Func061A)
    set bj_forLoopAIndex=0
    set bj_forLoopAIndexEnd=15
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveLocation(udg_Point_IntroCinGoalArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // ///
    call ModifyGateBJ(bj_GATEOPERATION_CLOSE, gg_dest_B006_1373)
    call UseTimeOfDayBJ(true)
    // ----------------------------------------------------------------------------------------
    // Weather
    // ----------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 0.00, 10000.00, 0, 42.00, 50.00, 58.00)
    call SetSkyModel(null)
    // ----------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call CinematicModeBJ(false, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // ///
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // Start Quests
    // ----------------------------------------------------------------------------------------
    call TriggerSleepAction(1.00)
    // ///
    // ///
    call SelectUnitForPlayerSingle(udg_HeroZuljin, udg_Player_Actual)
    // ///
    // ///
    call ConditionalTriggerExecute(gg_trg_DiscoverMainQuest)
    // ///
    // ///
    // ///
endfunction

//===========================================================================
function InitTrig_IntroCleanUp takes nothing returns nothing
    set gg_trg_IntroCleanUp=CreateTrigger()
    call TriggerAddAction(gg_trg_IntroCleanUp, function Trig_IntroCleanUp_Actions)
endfunction

