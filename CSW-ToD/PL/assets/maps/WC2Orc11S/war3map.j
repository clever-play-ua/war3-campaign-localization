            set dx=s__ConstructEvent__PeriodicData_cx[obj] - GetUnitX(s__ConstructEvent__PeriodicData_builder[obj])
            set dy=s__ConstructEvent__PeriodicData_cy[obj] - GetUnitY(s__ConstructEvent__PeriodicData_builder[obj])
