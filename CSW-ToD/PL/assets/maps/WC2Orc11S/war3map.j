function Trig_MidgameCinematicSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    set udg_Bool_Phase1=false
    call ShowDestructableBJ(false, gg_dest_OTds_6974)
    call ShowDestructableBJ(false, gg_dest_OTds_6975)
    // //
    call ForGroupBJ(udg_WaveGroup_Bot, function Trig_MidgameCinematicSetUp_Func007002)
    call ForGroupBJ(udg_WaveGroup_Top, function Trig_MidgameCinematicSetUp_Func008002)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_LoaEagleAlarm, Condition(function Trig_MidgameCinematicSetUp_Func012001002)), function Trig_MidgameCinematicSetUp_Func012A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_LoaEagleAlarm, Condition(function Trig_MidgameCinematicSetUp_Func015001002)), function Trig_MidgameCinematicSetUp_Func015A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_LoaBearAlarm, Condition(function Trig_MidgameCinematicSetUp_Func018001002)), function Trig_MidgameCinematicSetUp_Func018A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_LoaBearAlarm, Condition(function Trig_MidgameCinematicSetUp_Func021001002)), function Trig_MidgameCinematicSetUp_Func021A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Phase1CleanUp, Condition(function Trig_MidgameCinematicSetUp_Func024001002)), function Trig_MidgameCinematicSetUp_Func024A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Phase1CleanUp, udg_Player_Elves), function Trig_MidgameCinematicSetUp_Func027A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Phase1CleanUp, udg_Player_Humans), function Trig_MidgameCinematicSetUp_Func030A)
    // //
    call ForGroupBJ(udg_UG_HiddenUnits, function Trig_MidgameCinematicSetUp_Func032002)
    call ForGroupBJ(udg_UG_HiddenUnits, function Trig_MidgameCinematicSetUp_Func033002)
    // //
    call PauseAllUnitsBJ(true)
    // //
    call CreateNUnitsAtLoc(1, 'emow', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_PowerGenEagleTemple), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'emow', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_PowerGenBearTemple), bj_UNIT_FACING)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'hsor', udg_Player_Elves, GetRectCenter(gg_rct_MidSorcer01), GetRectCenter(gg_rct_LoaBear))
    set udg_U_MidCinSorcer[1]=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, 'hsor', udg_Player_Elves, GetRectCenter(gg_rct_MidSorcer02), GetRectCenter(gg_rct_LoaBear))
    set udg_U_MidCinSorcer[2]=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, 'hsor', udg_Player_Elves, GetRectCenter(gg_rct_MidSorcer03), GetRectCenter(gg_rct_LoaBear))
    set udg_U_MidCinSorcer[3]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'hsor', udg_Player_Elves, GetRectCenter(gg_rct_MidSorcer04), GetRectCenter(gg_rct_LoaEagle))
    set udg_U_MidCinSorcer[4]=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, 'hsor', udg_Player_Elves, GetRectCenter(gg_rct_MidSorcer05), GetRectCenter(gg_rct_LoaEagle))
    set udg_U_MidCinSorcer[5]=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, 'hsor', udg_Player_Elves, GetRectCenter(gg_rct_MidSorcer06), GetRectCenter(gg_rct_LoaEagle))
    set udg_U_MidCinSorcer[6]=GetLastCreatedUnit()
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuljin, GetRectCenter(gg_rct_MidCinZuljin), 234.96)
    call ShowUnitShow(udg_FakeZuljin)
    call SetUnitOwner(udg_FakeZuljin, udg_Player_Actual, true)
    // //
    call CreateNUnitsAtLoc(1, 'nftk', udg_Player_Amani, GetRectCenter(gg_rct_MidCinTroll), 90.00)
    set udg_U_MidCinTroll=GetLastCreatedUnit()
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

