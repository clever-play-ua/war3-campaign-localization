        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == udg_UT_Elf_Botanist ) ) then
        return true
    endif
    return false
endfunction

function Trig_ColorChanger_Func003Func004C takes nothing returns boolean
    if ( not Trig_ColorChanger_Func003Func004Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_ColorChanger_Func003Func005C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == udg_UT_Elf_Captain ) ) then
        return false
    endif
    return true
endfunction

function Trig_ColorChanger_Func003A takes nothing returns nothing
    if ( Trig_ColorChanger_Func003Func001C() ) then
        call SetUnitColor(GetEnumUnit(), PLAYER_COLOR_EMERALD)
    else
    endif
    if ( Trig_ColorChanger_Func003Func002C() ) then
        call SetUnitColor(GetEnumUnit(), PLAYER_COLOR_WHEAT)
    else
    endif
    if ( Trig_ColorChanger_Func003Func003C() ) then
        call SetUnitColor(GetEnumUnit(), PLAYER_COLOR_VIOLET)
    else
    endif
    if ( Trig_ColorChanger_Func003Func004C() ) then
        call SetUnitColor(GetEnumUnit(), PLAYER_COLOR_PEANUT)
    else
    endif
    if ( Trig_ColorChanger_Func003Func005C() ) then
        call SetUnitColor(GetEnumUnit(), PLAYER_COLOR_SNOW)
    else
    endif
endfunction

function Trig_ColorChanger_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Elves), function Trig_ColorChanger_Func003A)
    // //
    // //
endfunction

