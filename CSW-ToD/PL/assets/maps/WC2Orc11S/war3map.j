//===========================================================================
// Trigger: BountyForKilledUnit
//===========================================================================
function Trig_BountyForKilledUnit_Func017C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Humans ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Elves ) ) then
        return true
    endif
    return false
endfunction

function Trig_BountyForKilledUnit_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_Phase3 == false ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetKillingUnitBJ()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not Trig_BountyForKilledUnit_Func017C() ) then
        return false
    endif
    return true
endfunction

function Trig_BountyForKilledUnit_Func006Func001C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_BountyForKilledUnit_Func006Func002Func001C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_BountyForKilledUnit_Func006Func002Func002C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_BountyForKilledUnit_Func006Func002Func003C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == udg_UT_Elf_Captain ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == udg_UT_HUM_Captain ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == udg_UT_Elf_Knight ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == udg_UT_HUM_Knight ) ) then
        return true
    endif
    return false
endfunction

function Trig_BountyForKilledUnit_Func006Func002C takes nothing returns boolean
    if ( not Trig_BountyForKilledUnit_Func006Func002Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_BountyForKilledUnit_Func006C takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BountyForKilledUnit_Actions takes nothing returns nothing
    local effect SE_GoldDrop
    local location Point_GoldDrop
    set Point_GoldDrop=GetUnitLoc(GetDyingUnit())
    // //
    if ( Trig_BountyForKilledUnit_Func006C() ) then
        if ( Trig_BountyForKilledUnit_Func006Func001C() ) then
            call AdjustPlayerStateBJ(125, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
        else
            call AdjustPlayerStateBJ(100, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
        endif
    else
        if ( Trig_BountyForKilledUnit_Func006Func002C() ) then
            if ( Trig_BountyForKilledUnit_Func006Func002Func002C() ) then
                call AdjustPlayerStateBJ(100, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
            else
                call AdjustPlayerStateBJ(75, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
            endif
        else
            if ( Trig_BountyForKilledUnit_Func006Func002Func001C() ) then
                call AdjustPlayerStateBJ(75, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
            else
                call AdjustPlayerStateBJ(50, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
            endif
        endif
    endif
    // //
    call AddSpecialEffectLocBJ(Point_GoldDrop, "Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl")
    set SE_GoldDrop=GetLastCreatedEffectBJ()
    // //
    call TriggerSleepAction(4.00)
    // //
    call DestroyEffectBJ(SE_GoldDrop)
    call RemoveLocation(Point_GoldDrop)
    // //
endfunction

//===========================================================================
function InitTrig_BountyForKilledUnit takes nothing returns nothing
    set gg_trg_BountyForKilledUnit=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BountyForKilledUnit, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_BountyForKilledUnit, Condition(function Trig_BountyForKilledUnit_Conditions))
    call TriggerAddAction(gg_trg_BountyForKilledUnit, function Trig_BountyForKilledUnit_Actions)
endfunction

//===========================================================================
// Trigger: StartTimer
//===========================================================================
function Trig_StartTimer_Func003Func001C takes nothing returns boolean
    if ( not ( udg_Bool_Phase3 == false ) ) then
        return false
    endif
    if ( not ( udg_Int_Wave_Counter < 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartTimer_Func003Func002C takes nothing returns boolean
    if ( not ( udg_Bool_Phase3 == true ) ) then
        return false
    endif
    if ( not ( udg_Int_Wave_Counter <= 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartTimer_Func003C takes nothing returns boolean
    if ( Trig_StartTimer_Func003Func001C() ) then
        return true
    endif
    if ( Trig_StartTimer_Func003Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_StartTimer_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_TimerStarted == false ) ) then
        return false
    endif
    if ( not ( udg_Int_WavesRemaining != 0 ) ) then
        return false
    endif
    if ( not Trig_StartTimer_Func003C() ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_MQZulaman) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartTimer_Actions takes nothing returns nothing
    // ////
    call StartTimerBJ(udg_Timer_EnemySpawner, false, udg_Real_WaveAssemblyTime)
    // ////
    call CreateTimerDialogBJ(GetLastCreatedTimerBJ(), "TRIGSTR_634")
    set udg_TimerWindowEnemySpawn=GetLastCreatedTimerDialogBJ()
    // ////
    set udg_Bool_TimerStarted=true
    // ////
    // ////
endfunction

//===========================================================================
function InitTrig_StartTimer takes nothing returns nothing
    set gg_trg_StartTimer=CreateTrigger()
    call TriggerAddCondition(gg_trg_StartTimer, Condition(function Trig_StartTimer_Conditions))
    call TriggerAddAction(gg_trg_StartTimer, function Trig_StartTimer_Actions)
endfunction

//===========================================================================
// Trigger: DestroyTimerWindow
//===========================================================================
function Trig_DestroyTimerWindow_Func010C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Top_Troll) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DestroyTimerWindow_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_WaveGroup_Bot_Troll) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DestroyTimerWindow_Func015C takes nothing returns boolean
    if ( not ( udg_Bool_DebugFlag == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DestroyTimerWindow_Actions takes nothing returns nothing
    // ///
    call DestroyTimerDialogBJ(udg_TimerWindowEnemySpawn)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_WARNING, "TRIGSTR_635")
    set udg_Bool_TimerStarted=false
    // ///
    set udg_Int_Wave_Counter=( udg_Int_Wave_Counter + 1 )
    set udg_Int_WavesRemaining=( udg_Int_WavesRemaining - 1 )
    call LeaderboardSetPlayerItemValueBJ(udg_Player_Actual, udg_Board_WavesCounter, udg_Int_WavesRemaining)
    // ///
    if ( Trig_DestroyTimerWindow_Func010C() ) then
        set udg_Bool_TopTrollDefenseDelpeted=true
    else
    endif
    if ( Trig_DestroyTimerWindow_Func011C() ) then
        set udg_Bool_BotTrollDefenseDelpeted=true
    else
    endif
    // ///
    // ///
    // Debug
    if ( Trig_DestroyTimerWindow_Func015C() ) then
        call DisplayTextToForce(GetPlayersAll(), ( "Rozpoczęta fala:" + I2S(udg_Int_Wave_Counter) ))
    else
    endif
    // ///
    // Maks Wanted elven units to have different colors
    call TriggerSleepAction(0.50)
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
endfunction

//===========================================================================
function InitTrig_DestroyTimerWindow takes nothing returns nothing
    set gg_trg_DestroyTimerWindow=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_DestroyTimerWindow, udg_Timer_EnemySpawner)
    call TriggerAddAction(gg_trg_DestroyTimerWindow, function Trig_DestroyTimerWindow_Actions)
endfunction

