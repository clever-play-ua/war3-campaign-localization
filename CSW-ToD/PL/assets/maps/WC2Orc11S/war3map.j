function Trig_ZuljinDies_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_Phase3 == false ) ) then
        return false
    endif
    if ( not ( GetDyingUnit() == udg_HeroZuljin ) ) then
        return false
    endif
    return true
endfunction

function Trig_ZuljinDies_Func001C takes nothing returns boolean
    if ( not ( GetPlayerState(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD) < 425 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ZuljinDies_Func002C takes nothing returns boolean
    if ( not ( GetPlayerState(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER) < 100 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ZuljinDies_Actions takes nothing returns nothing
    if ( Trig_ZuljinDies_Func001C() ) then
        call AdjustPlayerStateBJ(425, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
    else
    endif
    if ( Trig_ZuljinDies_Func002C() ) then
        call AdjustPlayerStateBJ(100, udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER)
    else
    endif
endfunction

