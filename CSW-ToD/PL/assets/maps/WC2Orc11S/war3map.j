//===========================================================================
function Trig_Elf_Wave_Resume__Attack_Func002Func001Func001002 takes nothing returns nothing
    call IssuePointOrderLocBJ(GetEnumUnit(), "attack", GetUnitLoc(udg_HeroZuljin))
endfunction

function Trig_Elf_Wave_Resume__Attack_Func002Func001Func002002 takes nothing returns nothing
    call IssuePointOrderLocBJ(GetEnumUnit(), "attack", udg_GoalPoint_LoaTop)
endfunction

function Trig_Elf_Wave_Resume__Attack_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Bool_Phase3 == true ) ) then
