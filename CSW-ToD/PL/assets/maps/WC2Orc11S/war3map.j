endfunction

function Trig_InitUnits_Func080A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_UG_DragonHawkGuardians)
endfunction

function Trig_InitUnits_Func082A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_UG_DragonHawkGuardians)
endfunction

function Trig_InitUnits_Func085001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'zAtE' )
endfunction

function Trig_InitUnits_Func085A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_UG_EagleDefenders)
endfunction

function Trig_InitUnits_Actions takes nothing returns nothing
    // ///
    // Elven Herous
    // ///
    set udg_FakeRommath=gg_unit_ZARC_0442
    set udg_FakeHalduron=gg_unit_ZAHC_0161
    set udg_FakeAnasterian=gg_unit_ZAAC_0101
    set udg_FakeLorthemar=gg_unit_ZATC_0162
    set udg_FakeLiadrin=gg_unit_ZALC_0449
    // ///
    set udg_Tharbek=gg_unit_nmrc_0307
    // ///
    set udg_U_CinBoat=gg_unit_o60Q_0304
    call RemoveGuardPosition(udg_U_CinBoat)
    // ///
    set udg_U_Loa_Eagle=gg_unit_ZAtA_0013
    call LockGuardPosition(udg_U_Loa_Eagle)
    // ///
    set udg_U_Loa_Bear=gg_unit_ZAtN_0026
    call LockGuardPosition(udg_U_Loa_Bear)
    // ///
    set udg_U_Loa_Lynx=gg_unit_ZAtH_0121
    call LockGuardPosition(udg_U_Loa_Lynx)
    // ///
    set udg_U_Loa_DragonHawk=gg_unit_ZAtJ_0022
    call LockGuardPosition(udg_U_Loa_DragonHawk)
    // ///
    set udg_HeroRommath=gg_unit_ZARH_0323
    call GroupAddUnitSimple(udg_HeroRommath, udg_UG_HerousBench)
    set udg_HeroHalduron=gg_unit_ZAHH_0329
    set udg_HeroLorthemar=gg_unit_ZATH_0324
    set udg_HeroLiadrin=gg_unit_ZALH_0328
    call GroupAddUnitSimple(udg_HeroLiadrin, udg_UG_HerousBench)
    set udg_Isenglof=gg_unit_H61J_0059
    set udg_HeroAnasterian=gg_unit_ZAAH_0330
    // ///
    call SetDestructableInvulnerableBJ(gg_dest_B006_1373, true)
    call SetDestructableInvulnerableBJ(gg_dest_B006_0327, true)
    // ///
    // Neutrals
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_InitUnits_Func041001002)), function Trig_InitUnits_Func041A)
    // ///
    call ForGroupBJ(udg_UG_SnakesCritters, function Trig_InitUnits_Func043A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_NeutralMurlocks, Player(PLAYER_NEUTRAL_PASSIVE)), function Trig_InitUnits_Func046A)
    // ///
    // Tunnels
    // ///
    call BlzSetUnitName(gg_unit_nSW2_0018, BlzGetItemDescription(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSW2_0017, BlzGetItemDescription(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSW2_0029, BlzGetItemDescription(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSW2_0030, BlzGetItemDescription(gg_item_IQL0_0071))
    // ///
    call BlzSetUnitName(gg_unit_nSZW_0001, BlzGetItemTooltip(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSZW_0004, BlzGetItemExtendedTooltip(gg_item_IQL0_0071))
    call BlzSetUnitName(gg_unit_nSZW_0002, GetItemName(gg_item_IQL1_0070))
    call BlzSetUnitName(gg_unit_nSZW_0003, BlzGetItemDescription(gg_item_IQL1_0070))
    // ///
    call UnitShareVisionBJ(true, gg_unit_nSZW_0004, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_nSZW_0001, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_nSZW_0002, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_nSZW_0003, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_nSW2_0029, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_nSW2_0030, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_nSW2_0017, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_nSW2_0018, udg_Player_Actual)
    // ///
    // ///
    call TriggerSleepAction(0.10)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_DragonhawkGuardians, udg_Player_Amani), function Trig_InitUnits_Func078A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_DragonHawkNest01, udg_Player_Amani), function Trig_InitUnits_Func080A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_DragonHawkNest02, udg_Player_Amani), function Trig_InitUnits_Func082A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_LoaEagleAlarm, Condition(function Trig_InitUnits_Func085001002)), function Trig_InitUnits_Func085A)
    // ///
    // ///
    call SetUnitInvulnerable(gg_unit_nhcn_0332, true)
    // ///
    call SetUnitColor(gg_unit_nmrk_0321, PLAYER_COLOR_AQUA)
    call SetUnitColor(gg_unit_osld_0322, PLAYER_COLOR_AQUA)
    // ///
    call UnitAddAbilityBJ('Anl1', gg_unit_u003_0170)
    // ///
endfunction

