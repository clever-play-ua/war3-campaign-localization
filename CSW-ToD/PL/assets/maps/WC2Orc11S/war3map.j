//===========================================================================
// Trigger: DragonHawkLoaSaved
//===========================================================================
function Trig_DragonHawkLoaSaved_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_U_Loa_DragonHawk) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonHawkLoaSaved_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestItemSetCompletedBJ(udg_OQReqLoa[4], true)
    call RemoveGuardPosition(udg_U_Loa_DragonHawk)
    set udg_Point_LoaEscape=GetRectCenter(RectFromCenterSizeBJ(GetUnitLoc(udg_U_Loa_DragonHawk), 64.00, 64.00))
    call SetUnitInvulnerable(udg_U_Loa_DragonHawk, true)
    call UnitAddAbilityBJ('Aetl', udg_U_Loa_DragonHawk)
    call DestroyEffectBJ(udg_SE_LoaTeleportPrepare)
    call PauseUnitBJ(false, udg_U_Loa_DragonHawk)
    // //
    call AddSpecialEffectLocBJ(udg_Point_LoaEscape, "abilities\\spells\\special\\teleport\\teleportcaster.mdx")
    set udg_SE_LoaEscape=GetLastCreatedEffectBJ()
    call UnitAddItemByIdSwapped('stwp', udg_U_Loa_DragonHawk)
    set udg_Item_PortalDragonHawk=GetLastCreatedItem()
    call UnitUseItemTarget(udg_U_Loa_DragonHawk, udg_Item_PortalDragonHawk, gg_unit_nhcn_0332)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_CompletedQuestReqDragonHawkLoaQ, true)
    call TriggerSleepAction(2)
    call DestroyEffectBJ(udg_SE_LoaEscape)
    call RemoveLocation(udg_Point_LoaEscape)
endfunction

