    endif
    if ( ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Humans ) ) then
        return true
    endif
    return false
endfunction

function Trig_TunnelSafetyLynx_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_Phase2 == true ) ) then
        return false
    endif
    if ( not Trig_TunnelSafetyLynx_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_TunnelSafetyLynx_Func001Func002C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnteringUnit(), udg_WaveGroup_Top) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TunnelSafetyLynx_Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnteringUnit(), udg_WaveGroup_Bot) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TunnelSafetyLynx_Actions takes nothing returns nothing
    if ( Trig_TunnelSafetyLynx_Func001C() ) then
        call IssuePointOrderLocBJ(GetEnteringUnit(), "move", udg_GoalPoint_LoaBottom)
    else
        if ( Trig_TunnelSafetyLynx_Func001Func002C() ) then
            call IssuePointOrderLocBJ(GetEnteringUnit(), "move", udg_GoalPoint_LoaTop)
        else
        endif
    endif
endfunction

