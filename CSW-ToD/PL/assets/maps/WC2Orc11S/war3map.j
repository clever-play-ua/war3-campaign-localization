endfunction

function Trig_OutroWinCin_Actions takes nothing returns nothing
    // Trolls
    call PlaySoundBJ(gg_snd_ZulAmanVictoryTheme)
    // ///
    call PlaySoundBJ(gg_snd_OrcBurrowWhat1)
    call TriggerSleepAction(2.00)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetFocalDistance(150.00)
    // Open the Gate and send reinforcements
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_B006_0327)
    call PlaySoundBJ(gg_snd_IceCrownRoundDoorRollingOpen)
    // ///
    call TriggerSleepAction(2.00)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_OutroCinTroll[1], "move", GetRectCenter(gg_rct_OutroCinTroll01))
    call IssuePointOrderLocBJ(udg_OutroCinTroll[2], "move", GetRectCenter(gg_rct_OutroCinTroll02))
    call IssuePointOrderLocBJ(udg_OutroCinTroll[3], "move", GetRectCenter(gg_rct_OutroCinTroll03))
    call IssuePointOrderLocBJ(udg_OutroCinTroll[4], "move", GetRectCenter(gg_rct_OutroCinTroll04))
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin01, udg_Player_Actual, 6.00)
    // ///
    call TriggerSleepAction(1.00)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Debuff Zuljin
    call SetUnitAnimation(udg_FakeZuljin, "cinematic proud one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuljin, 0, gg_snd_WC2Orc11SZuljin_Outro1, bj_TIMETYPE_ADD, 0, false)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(5.00)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin02, udg_Player_Actual, 5.00)
    call TriggerSleepAction(4.70)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin03, udg_Player_Actual, 10.00)
    call TriggerSleepAction(9.50)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin04, udg_Player_Actual, 7.00)
    // //
    call ShowUnitHide(udg_FakeZuljin)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call ShowUnitHide(udg_OutroCinTroll[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call TriggerSleepAction(6.50)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin10, udg_Player_Actual, 6.00)
    call TriggerSleepAction(6.00)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Elves
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin05, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11SLorthemar_ifVictory1))
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeLorthemar, 0, gg_snd_WC2Orc11SLorthemar_ifVictory1, bj_TIMETYPE_ADD, 0, false)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_FakeLorthemar, "move", GetRectCenter(gg_rct_OutroLorthemar02))
    loop
        exitwhen ( (RectContainsUnit(gg_rct_OutroLorthemar02, udg_FakeLorthemar) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.25)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeLorthemar, udg_FakeAnasterian, 0.25)
    call TriggerSleepAction(0.25)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc11SLorthemar_ifVictory1, 5.00)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeLorthemar, udg_FakeIsenglof, 0.25)
    call TriggerSleepAction(0.25)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeLorthemar, "spell")
    call QueueUnitAnimationBJ(udg_FakeLorthemar, "stand")
    call TriggerSleepAction(2.10)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Isenglof Starts Walking
    call IssuePointOrderLocBJ(udg_FakeIsenglof, "move", GetRectCenter(gg_rct_OutroWinIsenglof02))
    call PlaySoundOnUnitBJ(gg_snd_WalkArmorLoop01, 100.00, udg_FakeIsenglof)
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeLorthemar, udg_FakeAnasterian, 0.25)
    call TriggerSleepAction(0.25)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimationWithRarity(udg_FakeLorthemar, "stand", RARITY_FREQUENT)
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc11SLorthemar_ifVictory1, 0)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin06a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin06, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11SAnasterian_final1))
    // ///
    call SetUnitAnimationWithRarity(udg_FakeAnasterian, "stand", RARITY_FREQUENT)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeAnasterian, 0, gg_snd_WC2Orc11SAnasterian_final1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin07, udg_Player_Actual, 0.00)
    // //
    call SetUnitLookAt(udg_FakeIsenglof, "bone_head", udg_FakeLorthemar, 0, 0, 110.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeLorthemar, 0, gg_snd_WC2Orc11SLorthemar_End1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitLookAt(udg_FakeLorthemar, "bone_head", udg_FakeIsenglof, 0, 0, 110.00)
    call SetUnitLookAt(udg_FakeAnasterian, "bone_head", udg_FakeIsenglof, 0, 0, 110.00)
    call SetUnitFacingToFaceUnitTimed(udg_FakeAnasterian, udg_FakeIsenglof, 0.50)
    call SetUnitAnimation(udg_FakeIsenglof, "cinematic stand")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeIsenglof, 0, gg_snd_WC2Orc11SIsenglof1, bj_TIMETYPE_SUB, 1.00, true)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin08, udg_Player_Actual, 0.00)
    // ///
    call SetUnitFacingToFaceUnitTimed(udg_FakeIsenglof, udg_FakeLorthemar, 0.50)
    call SetUnitLookAt(udg_FakeAnasterian, "bone_head", udg_FakeLorthemar, 0, 0, 110.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeLorthemar, 0, gg_snd_WC2Orc11SLorthemar_End2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin06, udg_Player_Actual, 0.00)
    // ///
    call SetUnitLookAt(udg_FakeAnasterian, "bone_head", udg_FakeIsenglof, 0, 0, 110.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeIsenglof, 0, gg_snd_WC2Orc11SIsenglof2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin09, udg_Player_Actual, 0.00)
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeIsenglof, 0, gg_snd_WC2Orc11SIsenglof3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin06, udg_Player_Actual, 0.00)
    // ///
    // ///
    call SetUnitLookAt(udg_FakeAnasterian, "bone_head", udg_FakeLorthemar, 0, 0, 110.00)
    call SetUnitLookAt(udg_FakeLorthemar, "bone_head", udg_FakeAnasterian, 0, 0, 110.00)
    call SetUnitLookAt(udg_FakeIsenglof, "bone_head", udg_FakeAnasterian, 0, 0, 110.00)
    call SetUnitFacingToFaceUnitTimed(udg_FakeIsenglof, udg_FakeAnasterian, 1.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeAnasterian, 0, gg_snd_WC2Orc11SAnasterian_final2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // ///
    call PlaySoundBJ(gg_snd_CS_H01a_soldiers_turn_a)
    call SetUnitAnimation(udg_FakeIsenglof, "cinematic salute one")
    call TriggerSleepAction(0.80)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeIsenglof, "cinematic salute exit one")
    call TriggerSleepAction(0.96)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call ResetUnitLookAt(udg_FakeIsenglof)
    call IssuePointOrderLocBJ(udg_FakeIsenglof, "move", GetRectCenter(gg_rct_OutroWinIsenglof01))
    call PlaySoundBJ(gg_snd_WalkArmorLoop)
    call TriggerSleepAction(1.00)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ResetUnitLookAt(udg_FakeAnasterian)
    call ResetUnitLookAt(udg_FakeLorthemar)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin05, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_OutroWin10, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11SAnasterian_final3))
    call StopSoundBJ(gg_snd_WalkArmorLoop, true)
    // ///
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeAnasterian, 0, gg_snd_WC2Orc11SAnasterian_final3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_OutroCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // ///
    call ConditionalTriggerExecute(gg_trg_OutroCleanUp)
    // ///
    // ///
endfunction

