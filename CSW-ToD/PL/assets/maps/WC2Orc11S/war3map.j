function InitTrig_FailedQuestReqEagleLoa takes nothing returns nothing
    set gg_trg_FailedQuestReqEagleLoa=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_FailedQuestReqEagleLoa, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_FailedQuestReqEagleLoa, Condition(function Trig_FailedQuestReqEagleLoa_Conditions))
    call TriggerAddAction(gg_trg_FailedQuestReqEagleLoa, function Trig_FailedQuestReqEagleLoa_Actions)
