function Trig_UlaTekCinematicUlatekControl_Conditions takes nothing returns boolean
    if ( not ( udg_UlatekCinematic == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_U_Loa_UlaTek ) ) then
        return false
    endif
    return true
endfunction

function Trig_UlaTekCinematicUlatekControl_Func004001 takes nothing returns boolean
    return ( udg_UlatekCinematicSkipped == true )
endfunction

function Trig_UlaTekCinematicUlatekControl_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(0.50)
    if ( (udg_UlatekCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssueImmediateOrderBJ(udg_U_Loa_UlaTek, "stop")
    call SetUnitAnimation(udg_U_Loa_UlaTek, "cinematic introduction one")
    call QueueUnitAnimationBJ(udg_U_Loa_UlaTek, "cinematic wave two")
    call QueueUnitAnimationBJ(udg_U_Loa_UlaTek, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_U_Loa_UlaTek, "cinematic wave two")
    call QueueUnitAnimationBJ(udg_U_Loa_UlaTek, "cinematic listening one")
endfunction

