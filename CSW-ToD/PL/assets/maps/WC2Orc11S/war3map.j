function Trig_LoaGoalStatusChecker_Actions takes nothing returns nothing
    // Top LOA Status Checker
    if ( Trig_LoaGoalStatusChecker_Func005C() ) then
        if ( Trig_LoaGoalStatusChecker_Func005Func001C() ) then
            set udg_Bool_TopGoalEligible=true
        else
            set udg_Bool_TopGoalEligible=false
        endif
    else
        if ( Trig_LoaGoalStatusChecker_Func005Func002C() ) then
            if ( Trig_LoaGoalStatusChecker_Func005Func002Func001C() ) then
                set udg_Bool_TopGoalEligible=true
            else
                set udg_Bool_TopGoalEligible=false
            endif
        else
            if ( Trig_LoaGoalStatusChecker_Func005Func002Func002C() ) then
                if ( Trig_LoaGoalStatusChecker_Func005Func002Func002Func001C() ) then
                    set udg_Bool_TopGoalEligible=true
                else
                    set udg_Bool_TopGoalEligible=false
                endif
            else
            endif
        endif
    endif
    // Bottom LOA Status Checker
    if ( Trig_LoaGoalStatusChecker_Func007C() ) then
        if ( Trig_LoaGoalStatusChecker_Func007Func001C() ) then
            set udg_Bool_BotGoalEligible=true
        else
            set udg_Bool_BotGoalEligible=false
        endif
    else
        if ( Trig_LoaGoalStatusChecker_Func007Func002C() ) then
            if ( Trig_LoaGoalStatusChecker_Func007Func002Func001C() ) then
                set udg_Bool_BotGoalEligible=true
            else
                set udg_Bool_BotGoalEligible=false
            endif
        else
            if ( Trig_LoaGoalStatusChecker_Func007Func002Func002C() ) then
                if ( Trig_LoaGoalStatusChecker_Func007Func002Func002Func001C() ) then
                    set udg_Bool_BotGoalEligible=true
                else
                    set udg_Bool_BotGoalEligible=false
                endif
            else
            endif
        endif
    endif
endfunction

