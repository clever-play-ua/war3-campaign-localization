function InitTrig_TharbekSellsUnitQ takes nothing returns nothing
    set gg_trg_TharbekSellsUnitQ=CreateTrigger()
    call TriggerAddAction(gg_trg_TharbekSellsUnitQ, function Trig_TharbekSellsUnitQ_Actions)
endfunction

