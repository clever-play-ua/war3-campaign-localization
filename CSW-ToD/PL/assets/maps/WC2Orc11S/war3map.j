function Trig_Normal_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Real_WaveAssemblyTime=45.00
    set udg_Real_ProtectLoaTime=60.00
    set udg_Int_EnemyUpgradeLevel=2
    call RemoveUnit(gg_unit_zAtB_0084)
    call RemoveUnit(gg_unit_zAtB_0158)
    call RemoveUnit(gg_unit_zAtW_0077)
    call RemoveUnit(gg_unit_zAtW_0079)
    // //
    call SetPlayerTechResearchedSwap('R013', 1, udg_Player_Humans)
    call SetPlayerTechResearchedSwap('R014', 1, udg_Player_Humans)
    // //
    call SetPlayerTechResearchedSwap('R013', 1, udg_Player_Elves)
    call SetPlayerTechResearchedSwap('R014', 1, udg_Player_Elves)
    call SetPlayerTechResearchedSwap('R00J', 1, udg_Player_Elves)
    call SetPlayerTechResearchedSwap('R00B', 1, udg_Player_Elves)
    call SetPlayerTechResearchedSwap('R01B', 1, udg_Player_Elves)
    call SetPlayerTechResearchedSwap('R018', 1, udg_Player_Elves)
    call SetPlayerTechResearchedSwap('R00A', 1, udg_Player_Elves)
    call SetPlayerTechResearchedSwap('Rhst', 1, udg_Player_Elves)
    call SetPlayerTechResearchedSwap('Rhpt', 1, udg_Player_Elves)
    // //
endfunction

