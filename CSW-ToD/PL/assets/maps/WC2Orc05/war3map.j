endfunction

function Trig_RetakeN_PitTrap01_Func022001003002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false), (IsUnitType(GetFilterUnit(), UNIT_TYPE_MECHANICAL) == false)))) // INLINED!!
endfunction

function Trig_RetakeN_PitTrap01_Func022001003 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false), (IsUnitType(GetFilterUnit(), UNIT_TYPE_MECHANICAL) == false)))))) // INLINED!!
endfunction

