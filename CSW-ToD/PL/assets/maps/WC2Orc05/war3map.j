    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_RetakeN_PitTrap01_Func027001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true )
endfunction

