function Trig_Intro_Cinematic_RotateMaim_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_FakeMaim ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_RotateMaim_Func003001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_RotateMaim_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingToFaceLocTimed(udg_FakeMaim, GetRectCenter(gg_rct_LoadZuluhed), 0.50)
endfunction

