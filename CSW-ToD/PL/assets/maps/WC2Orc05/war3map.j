        return false
    endif
    return true
endfunction

function Trig_Goblin_Cinematic_Setup_Func020002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Goblin_Cinematic_Setup_Func021002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Goblin_Cinematic_Setup_Func024A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Goblin_Cinematic_Setup_Func027002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Goblin_Cinematic_Setup_Func030002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), true)
endfunction

function Trig_Goblin_Cinematic_Setup_Func033002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_Goblin_Cinematic_Setup_Func035002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_Goblin_Cinematic_Setup_Func044A takes nothing returns nothing
    call SetUnitMoveSpeed(GetEnumUnit(), 220.00)
endfunction

function Trig_Goblin_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call AdjustPlayerStateBJ(1000, udg_Player_BlackRockCinematic, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(400, udg_Player_BlackRockCinematic, PLAYER_STATE_RESOURCE_LUMBER)
    // ///
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GoblinLab, Condition(function Trig_Goblin_Cinematic_Setup_Func008001002)), function Trig_Goblin_Cinematic_Setup_Func008002)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_GoblinCinHide01, udg_Player_Actual), function Trig_Goblin_Cinematic_Setup_Func011002)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GoblinCinHide02, Condition(function Trig_Goblin_Cinematic_Setup_Func014001002)), function Trig_Goblin_Cinematic_Setup_Func014002)
    // ///
    if ( Trig_Goblin_Cinematic_Setup_Func016C() ) then
        call GroupAddUnitSimple(udg_Hero_Maim, udg_Group_HiddenUnits)
    else
    endif
    if ( Trig_Goblin_Cinematic_Setup_Func017C() ) then
        call GroupAddUnitSimple(udg_Hero_Zuluhed, udg_Group_HiddenUnits)
    else
    endif
    if ( Trig_Goblin_Cinematic_Setup_Func018C() ) then
        call GroupAddUnitSimple(udg_SemiHero_Utok, udg_Group_HiddenUnits)
    else
    endif
    // ///
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Goblin_Cinematic_Setup_Func020002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Goblin_Cinematic_Setup_Func021002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'h001'), function Trig_Goblin_Cinematic_Setup_Func024A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Dwarves), function Trig_Goblin_Cinematic_Setup_Func027002)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Dwarves), function Trig_Goblin_Cinematic_Setup_Func030002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_BlackToothGrinCamp, udg_Player_BTGCinematic), function Trig_Goblin_Cinematic_Setup_Func033002)
    // ///
    call ForGroupBJ(udg_Group_DragonmawShips, function Trig_Goblin_Cinematic_Setup_Func035002)
    // //
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0031, GetRectCenter(gg_rct_GoblinCinTransport01Start), 0.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0032, GetRectCenter(gg_rct_GoblinCinTransport02Start), 0.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60R_0035, GetRectCenter(gg_rct_GoblinCinDestroyer03Start), 0.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60R_0037, GetRectCenter(gg_rct_GoblinCinDestroyer04Start), 0.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60R_0034, GetRectCenter(gg_rct_GoblinCinDestroyer02Start), 0.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60R_0036, GetRectCenter(gg_rct_GoblinCinDestroyer01Start), 0.00)
    // //
    call ForGroupBJ(udg_Group_DragonmawShips, function Trig_Goblin_Cinematic_Setup_Func044A)
    // //
    call CreateNUnitsAtLoc(1, 'n605', udg_Player_BlackRockCinematic, GetRectCenter(gg_rct_GoblinCinSubmarineStart), 45.00)
    set udg_Unit_EnemySubmarine=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'h000', udg_Player_BlackRockCinematic, GetRectCenter(gg_rct_GoblinCinZeppelinStart), 125.00)
    set udg_Unit_CinZeppelin=GetLastCreatedUnit()
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Unit_CinZeppelin, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Unit_CinZeppelin, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)
    // //
    call CreateNUnitsAtLoc(1, 'h609', udg_Player_BlackRockCinematic, GetRectCenter(gg_rct_GoblinCinGoblinUnload), 45.00)
    set udg_Unit_CinGoblinEngineer=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_CinGoblinEngineer)
    // //
    // invis platforms booked place for goblin lab
    call RemoveDestructable(gg_dest_OTip_11683)
    call RemoveDestructable(gg_dest_OTip_11684)
    call RemoveDestructable(gg_dest_OTip_11685)
    call RemoveDestructable(gg_dest_OTip_0262)
    call RemoveDestructable(gg_dest_OTip_0261)
    call RemoveDestructable(gg_dest_OTip_0263)
    call RemoveDestructable(gg_dest_OTip_0264)
    call RemoveDestructable(gg_dest_OTip_0266)
    call RemoveDestructable(gg_dest_OTip_0265)
    // //
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_GoblinCinZuluhed), 225.00)
    call SetUnitOwner(udg_FakeZuluhed, udg_Player_DragonmawCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_GobCinUtok01), 170.00)
    call SetUnitOwner(udg_FakeUtok, udg_Player_BlackRockCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // ///
    call ShowUnitHide(gg_unit_hFrK_0336)
    // ///
endfunction

