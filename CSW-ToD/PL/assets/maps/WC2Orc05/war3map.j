function Trig_DeindexPassengers_Func010C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hfSM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hSjM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hBaM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hKsM' ) ) then
        return true
    endif
    return false
endfunction

function Trig_DeindexPassengers_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_StromgardeGA ) ) then
        return false
    endif
    if ( not Trig_DeindexPassengers_Func010C() ) then
        return false
    endif
    return true
endfunction

function Trig_DeindexPassengers_Actions takes nothing returns nothing
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_IdleMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarinesAdditional[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_UnitsInCargo)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P13MarineBallistas)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P13MarineJaveliners)
endfunction

//===========================================================================
function InitTrig_DeindexPassengers takes nothing returns nothing
    set gg_trg_DeindexPassengers=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_DeindexPassengers, "udg_DeathEvent", EQUAL, 1.00)
    call TriggerRegisterVariableEvent(gg_trg_DeindexPassengers, "udg_UnitIndexEvent", EQUAL, 2.00)
    call TriggerAddCondition(gg_trg_DeindexPassengers, Condition(function Trig_DeindexPassengers_Conditions))
    call TriggerAddAction(gg_trg_DeindexPassengers, function Trig_DeindexPassengers_Actions)
endfunction

//===========================================================================
// Trigger: BoardingOrder
//===========================================================================
function Trig_BoardingOrder_Func003Func004C takes nothing returns boolean
    if ( not ( udg_BoardingOrderTimerCount[udg_TempInteger] >= udg_BoardingOrderTimerInterval ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Func003Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[udg_TempInteger]) <= 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Func003Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[udg_TempInteger]) <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_IdleMarines[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_IdleTransports[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Actions takes nothing returns nothing
    set udg_TempPlayer=udg_Player_StromgardeGA
    set udg_TempInteger=GetConvertedPlayerId(udg_Player_StromgardeGA)
    if ( Trig_BoardingOrder_Func003C() ) then
        set udg_BoardingOrderTimerCount[udg_TempInteger]=( udg_BoardingOrderTimerCount[udg_TempInteger] + udg_BoardingOrderTimerPeriod )
        if ( Trig_BoardingOrder_Func003Func004C() ) then
            set udg_BoardingOrderTimerCount[udg_TempInteger]=0.00
            call BoardingFunc(udg_TempInteger)
        else
        endif
        if ( Trig_BoardingOrder_Func003Func005C() ) then
            call GroupClear(udg_QueuedMarines[udg_TempInteger])
        else
        endif
        if ( Trig_BoardingOrder_Func003Func006C() ) then
            call GroupClear(udg_QueuedTransports[udg_TempInteger])
        else
        endif
    else
        set udg_BoardingOrderTimerCount[udg_TempInteger]=0.00
    endif
endfunction

