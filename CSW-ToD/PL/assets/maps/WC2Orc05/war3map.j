function Trig_Goblin_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_Goblin_Cinematic_Q_Func008002)
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call ConditionalTriggerExecute(gg_trg_Goblin_Cinematic_Setup)
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinCinShipsArrive, udg_Player_Actual, 0)
    call IssuePointOrderLocBJ(gg_unit_o60R_0035, "move", GetRectCenter(gg_rct_GoblinCinDestroyer03))
    call IssuePointOrderLocBJ(gg_unit_o60Q_0031, "move", GetRectCenter(gg_rct_GoblinCinTransport01))
    call IssuePointOrderLocBJ(gg_unit_o60Q_0032, "move", GetRectCenter(gg_rct_GoblinCinTransport02))
    call IssuePointOrderLocBJ(gg_unit_o60R_0037, "move", GetRectCenter(gg_rct_GoblinCinDestroyer03Start))
    call IssuePointOrderLocBJ(gg_unit_o60R_0034, "move", GetRectCenter(gg_rct_GoblinCinDestroyer02))
    call IssuePointOrderLocBJ(gg_unit_o60R_0036, "move", GetRectCenter(gg_rct_GoblinCinDestroyer01))
    call IssuePointOrderLocBJ(udg_Unit_EnemySubmarine, "move", GetRectCenter(gg_rct_GoblinCinSubmarineAttack))
    call PlaySoundBJ(gg_snd_OrcTheme)
    call TriggerSleepAction(1.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    set udg_Bool_CinGoblinOn=true
    // ///
    // Ships are floating
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinCinSubmarineAttack, udg_Player_Actual, 4.00)
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_GoblinCinSubmarineAttack, udg_Unit_EnemySubmarine) == true), (udg_Bool_CinGoblinSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // ///
    // Submarine attacks
    call PauseUnitBJ(true, gg_unit_o60R_0036)
    call PauseUnitBJ(true, gg_unit_o60R_0037)
    call IssueTargetOrderBJ(udg_Unit_EnemySubmarine, "attack", gg_unit_o60R_0036)
    // ///
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(gg_unit_o60Q_0031, "move", GetRectCenter(gg_rct_GoblinCinTransport01Escape))
    call IssuePointOrderLocBJ(gg_unit_o60Q_0032, "move", GetRectCenter(gg_rct_GoblinCinTransport02Escape))
    // ///
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_Actual, udg_Player_BTGCinematic, 0, GetCameraTargetPositionLoc(), gg_snd_WC2Orc05Maim_SubMarine1, bj_TIMETYPE_SUB, 2.00, true)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinCinZeppelin01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_SubmarineDestroyed, udg_Player_Actual, ( ( DistanceBetweenPoints(GetUnitLoc(udg_Unit_CinZeppelin), GetRectCenter(gg_rct_GoblinCinSubmarineAttack)) / GetUnitMoveSpeed(udg_Unit_CinZeppelin) ) + 1 ))
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Zepelin arrives
    // ///
    call IssuePointOrderLocBJ(udg_Unit_CinZeppelin, "move", GetRectCenter(gg_rct_GoblinCinSubmarineAttack))
    call PlaySoundOnUnitBJ(gg_snd_CS_orc3_outro_zepp, 100.00, udg_Unit_CinZeppelin)
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_GoblinCinSubmarineAttack, udg_Unit_CinZeppelin) == true), (udg_Bool_CinGoblinSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_Unit_CinZeppelin, 0, gg_snd_WC2Orc05Goblin_Submarine1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call TriggerSleepAction(2.00)
    call AddSpecialEffectTargetUnitBJ("origin", udg_Unit_CinZeppelin, "CSW\\Units\\Orc\\GoblinZeppelin\\WC2GoblinZeppelinCinEffect.mdx")
    set udg_SE_ZeppelinBomb=GetLastCreatedEffectBJ()
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_GoblinCinSubmarineAttack), "Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl")
    set udg_SE_SubmarineExplosion=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectZ(udg_SE_SubmarineExplosion, - 166.40)
    call KillUnit(udg_Unit_EnemySubmarine)
    call DestroyEffectBJ(udg_SE_ZeppelinBomb)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call DestroyEffectBJ(udg_SE_SubmarineExplosion)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinCinUnload, udg_Player_Actual, ( ( DistanceBetweenPoints(GetUnitLoc(udg_Unit_CinZeppelin), GetRectCenter(gg_rct_GoblinCinGoblin01)) / GetUnitMoveSpeed(udg_Unit_CinZeppelin) ) - 0.50 ))
    call IssuePointOrderLocBJ(udg_Unit_CinZeppelin, "move", GetRectCenter(gg_rct_GoblinCinGoblin01))
    call PlaySoundOnUnitBJ(gg_snd_CS_orc1x_vol_quest_intro_zepp_arrive, 100.00, udg_Unit_CinZeppelin)
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_GoblinCinGoblin01, udg_Unit_CinZeppelin) == true), (udg_Bool_CinGoblinSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Zepelin Unloads
    // ///
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_CinZeppelin, "spell")
    call QueueUnitAnimationBJ(udg_Unit_CinZeppelin, "stand")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ShowUnitShow(udg_Unit_CinGoblinEngineer)
    call PlaySoundAtPointBJ(gg_snd_Loading, 50.00, GetRectCenter(gg_rct_GoblinCinGoblin01), 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinGoblinEngineer, "move", GetRectCenter(gg_rct_GoblinCinGoblin02))
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_Unit_CinGoblinEngineer, 0, gg_snd_WC2Orc05Goblin_Zeppelin1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinCinTalk01, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc05Zuluhed_Submarine1))
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeZuluhed, 0, gg_snd_WC2Orc05Zuluhed_Submarine1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_Unit_CinGoblinEngineer, 0, gg_snd_WC2Orc05Goblin_Zeppelin2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssueBuildOrderByIdLocBJ(udg_Unit_CinGoblinEngineer, 'o000', GetRectCenter(gg_rct_GoblinLab))
    call SetUnitFacingToFaceLocTimed(udg_FakeZuluhed, GetRectCenter(gg_rct_GoblinLab), ( DistanceBetweenPoints(GetUnitLoc(udg_Unit_CinGoblinEngineer), GetRectCenter(gg_rct_GoblinLab)) / GetUnitMoveSpeed(udg_Unit_CinGoblinEngineer) ))
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinCinTalk02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc05Utok_Zepplin1) + 2.00 ))
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_OrcBuildingBirthWhat1)
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeUtok, 0, gg_snd_WC2Orc05Utok_Zepplin1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_OrcTheme, true)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Goblin_Cinematic_Cleanup)
endfunction

