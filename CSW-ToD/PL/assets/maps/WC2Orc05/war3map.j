//===========================================================================
// Trigger: RetakeS CatapultsAcquired
//===========================================================================
function Trig_RetakeS_CatapultsAcquired_Conditions takes nothing returns boolean
    if ( not ( IsUnitGroupDeadBJ(udg_Group_DwarvenAmbush) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeS_CatapultsAcquired_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_CatapultCameraPan), 1.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=2
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitInvulnerable(udg_Unit_CatapultsArr[GetForLoopIndexA()], false)
        call PauseUnitBJ(false, udg_Unit_CatapultsArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call IssuePointOrderLocBJ(udg_Unit_CatapultsArr[1], "move", GetRectCenter(gg_rct_Catapult01Aquired))
    call IssuePointOrderLocBJ(udg_Unit_CatapultsArr[2], "move", GetRectCenter(gg_rct_Catapult02Aquired))
    // //
    call PolledWait(2)
    // //
    call RescueUnitBJ(udg_Unit_CatapultsArr[1], udg_Player_Actual, false)
    call RescueUnitBJ(udg_Unit_CatapultsArr[2], udg_Player_Actual, false)
    // //
    call PolledWait(2)
    // //
    call DestroyGroup(udg_Group_DwarvenAmbush)
    call QueuedTriggerAddBJ(gg_trg_RetakeS_CatapultsAcquired_Hint_Q, true)
    call QueuedTriggerAddBJ(gg_trg_RetakeS_CatapultsScope_Hint_Q, true)
    // //
endfunction

