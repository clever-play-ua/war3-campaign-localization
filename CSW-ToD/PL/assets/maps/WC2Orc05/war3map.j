//===========================================================================
// Trigger: North Cinematic Cleanup
//===========================================================================
function Trig_North_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinNorthSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_North_Cinematic_Cleanup_Func011Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_North_Cinematic_Cleanup_Func011A takes nothing returns nothing
    if ( Trig_North_Cinematic_Cleanup_Func011Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_North_Cinematic_Cleanup_Func015A takes nothing returns nothing
    call SetItemVisibleBJ(true, GetEnumItem())
endfunction

function Trig_North_Cinematic_Cleanup_Func027C takes nothing returns boolean
    if ( not ( udg_Bool_CinNorthSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_North_Cinematic_Cleanup_Func044A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_North_Cinematic_Cleanup_Func052A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_North_Cinematic_Cleanup_Func056C takes nothing returns boolean
    if ( not ( udg_Bool_CinNorthSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_North_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinNorthOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_North_Cinematic_Cleanup_Func003C() ) then
        call CinematicFilterGenericBJ(1.00, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0.00, 100.00, 100.00, 100.00, 0.00)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call DisableTrigger(gg_trg_Cinematic_FadeCameraFocus)
    // ///
    call SetItemVisibleBJ(true, gg_item_I603_0319)
    call SetItemVisibleBJ(true, gg_item_I603_0324)
    // ///
    call DestructableRestoreLife(gg_dest_B00T_7845, GetDestructableMaxLife(gg_dest_B00T_7845), false)
    call EnumDestructablesInRectAll(gg_rct_KillBridgePB, function Trig_North_Cinematic_Cleanup_Func011A)
    // ///
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // ///
    call EnumItemsInRectBJ(gg_rct_HideCinItems, function Trig_North_Cinematic_Cleanup_Func015A)
    // ///
    call SetUnitPositionLocFacingLocBJ(udg_Unit_CatapultsArr[1], GetRectCenter(gg_rct_Catapult01Move), GetRectCenter(gg_rct_Catapult01Aquired))
    call SetUnitPositionLocFacingLocBJ(udg_Unit_CatapultsArr[2], GetRectCenter(gg_rct_Catapult02Move), GetRectCenter(gg_rct_Catapult02Aquired))
    call ResetUnitAnimation(udg_Unit_CatapultsArr[1])
    call ResetUnitAnimation(udg_Unit_CatapultsArr[2])
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61Y_0067, GetRectCenter(gg_rct_PeonChill02), GetRectCenter(gg_rct_Campfire))
    call ResetUnitAnimation(gg_unit_o61Y_0067)
    // ///
    call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_ObserationPost), 260.36)
    call SetUnitAnimation(udg_SemiHero_Utok, "cinematic scope one")
    // ///
    if ( Trig_North_Cinematic_Cleanup_Func027C() ) then
        call StopSoundBJ(gg_snd_Orc1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim_ObservationPost1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Utok_Telescope1, false)
    else
    endif
    // ///
    call UnitAddAbilityBJ('Andt', udg_SemiHero_Utok)
    call UnitAddAbilityBJ('YU51', udg_SemiHero_Utok)
    call UnitRemoveAbilityBJ('A642', udg_SemiHero_Utok)
    call UnitRemoveAbilityBJ('A641', udg_SemiHero_Utok)
    call UnitRemoveAbilityBJ('A025', udg_SemiHero_Utok)
    // ///
    // Give Access to Bridge
    call RemoveDestructable(gg_dest_YTpc_9451)
    call RemoveDestructable(gg_dest_YTpc_9452)
    // ///
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call CameraSetupApplyForPlayer(true, udg_Var_CurrentCamera, udg_Player_Actual, 0)
    // ///
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_North_Cinematic_Cleanup_Func044A)
    // ///
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    // ///
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupClear(udg_Group_SelectedUnits)
    // ///
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_North_Cinematic_Cleanup_Func052A)
    call GroupClear(udg_Group_HiddenUnits)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_North_Cinematic_Cleanup_Func056C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_North_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call PolledWait(2)
    call ConditionalTriggerExecute(gg_trg_RetakeS_DwarvenAmbush)
endfunction

//===========================================================================
function InitTrig_North_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_North_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_North_Cinematic_Cleanup, function Trig_North_Cinematic_Cleanup_Actions)
endfunction

//===========================================================================
// Trigger: North Cinematic UtokRedirect
//===========================================================================
function Trig_North_Cinematic_UtokRedirect_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinNorthOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_FakeUtok ) ) then
        return false
    endif
    return true
endfunction

function Trig_North_Cinematic_UtokRedirect_Func004001001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_EnterObserationPost, udg_FakeUtok) == true )
endfunction

function Trig_North_Cinematic_UtokRedirect_Func004001002 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_UtokRedirect_Func004001 takes nothing returns boolean
    return GetBooleanOr((RectContainsUnit(gg_rct_EnterObserationPost, udg_FakeUtok) == true), (udg_Bool_CinNorthSkipped == true)) // INLINED!!
endfunction

function Trig_North_Cinematic_UtokRedirect_Func005001 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_UtokRedirect_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_EnterObserationPost))
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_EnterObserationPost, udg_FakeUtok) == true), (udg_Bool_CinNorthSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_DoorSlam1)
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_ObserationPost), 260.36)
    call SetUnitAnimation(udg_FakeUtok, "cinematic scope one")
endfunction

//===========================================================================
function InitTrig_North_Cinematic_UtokRedirect takes nothing returns nothing
    set gg_trg_North_Cinematic_UtokRedirect=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_North_Cinematic_UtokRedirect, gg_rct_MidCinUtok02)
    call TriggerAddCondition(gg_trg_North_Cinematic_UtokRedirect, Condition(function Trig_North_Cinematic_UtokRedirect_Conditions))
    call TriggerAddAction(gg_trg_North_Cinematic_UtokRedirect, function Trig_North_Cinematic_UtokRedirect_Actions)
endfunction

