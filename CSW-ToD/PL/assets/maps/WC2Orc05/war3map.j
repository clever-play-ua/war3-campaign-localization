//===========================================================================
function Trig_Fortify_Discover_Q_Actions takes nothing returns nothing
    call CreateLeaderboardBJ(udg_PlayerGroup_Actual, "TRIGSTR_4021")
    set udg_Leaderboard_QuestObjectives=GetLastCreatedLeaderboard()
    call LeaderboardAddItemBJ(Player(0), udg_Leaderboard_QuestObjectives, "TRIGSTR_4022", 0)
    call LeaderboardAddItemBJ(Player(1), udg_Leaderboard_QuestObjectives, "TRIGSTR_4023", 0)
    call LeaderboardAddItemBJ(Player(2), udg_Leaderboard_QuestObjectives, "TRIGSTR_4024", 0)
    call LeaderboardAddItemBJ(Player(3), udg_Leaderboard_QuestObjectives, "TRIGSTR_4025", 0)
    call LeaderboardSetStyleBJ(udg_Leaderboard_QuestObjectives, true, true, false, true)
    call LeaderboardSetLabelColorBJ(udg_Leaderboard_QuestObjectives, 100, 80, 20, 0)
    call QuestSetDiscoveredBJ(udg_MQFortify, true)
    call QuestMessageBJ(udg_PlayerGroup_Actual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_4026")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    set udg_String_CheckpointPostfix="DunModr"
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
endfunction

