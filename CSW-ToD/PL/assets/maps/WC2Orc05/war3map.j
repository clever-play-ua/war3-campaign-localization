    endif
    if ( not ( udg_Bool_CinGoblinOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DawnFogLoop_Func007001 takes nothing returns boolean
    return ( udg_Real_FogMax >= 12500.00 )
endfunction

function Trig_DawnFogLoop_Actions takes nothing returns nothing
    if ( (udg_Real_FogMax >= 12500.00) ) then // INLINED!!
        call PauseTimerBJ(true, udg_Timer_Dawn)
    else
        call DoNothing()
    endif
    set udg_Real_FogMax=( udg_Real_FogMax + 100.00 )
    set udg_Real_FogMin=( udg_Real_FogMin + 100.00 )
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, 50.00, 50.00, 68.00)
endfunction

