//===========================================================================
// Trigger: LevelCap
//===========================================================================
function Trig_LevelCap_Func002C takes nothing returns boolean
    if ( not ( GetLevelingUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero_Zuluhed) == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LevelCap_Func003C takes nothing returns boolean
    if ( not ( GetLevelingUnit() == udg_Hero_Maim ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero_Maim) == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LevelCap_Actions takes nothing returns nothing
    if ( Trig_LevelCap_Func002C() ) then
        call SuspendHeroXPBJ(false, udg_Hero_Zuluhed)
    else
    endif
    if ( Trig_LevelCap_Func003C() ) then
        call SuspendHeroXPBJ(false, udg_Hero_Maim)
    else
    endif
endfunction

