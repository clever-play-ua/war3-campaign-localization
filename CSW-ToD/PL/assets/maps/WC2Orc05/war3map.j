function Trig_Fortify_UpdateCompleted_Func001C takes nothing returns boolean
    if ( not ( udg_Bool_StrongholdUpgraded == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_ShipyardBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FoundryBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_RefineryBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fortify_UpdateCompleted_Actions takes nothing returns nothing
    if ( Trig_Fortify_UpdateCompleted_Func001C() ) then
        call QueuedTriggerAddBJ(gg_trg_Fortify_Completed_Q, true)
        call QueuedTriggerAddBJ(gg_trg_Goblin_Cinematic_Q, true)
    else
        call QueuedTriggerAddBJ(gg_trg_Fortify_Update_Q, true)
    endif
endfunction

