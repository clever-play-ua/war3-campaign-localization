function InitTrig_Final_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Final_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Final_Cinematic_Cleanup, function Trig_Final_Cinematic_Cleanup_Actions)
endfunction

