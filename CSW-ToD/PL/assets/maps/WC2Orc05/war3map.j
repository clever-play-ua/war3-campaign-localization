    set gg_trg_South_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_South_Cinematic_Q, function Trig_South_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: South Cinematic Setup
//===========================================================================
function Trig_South_Cinematic_Setup_Func009001002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_South_Cinematic_Setup_Func009A takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_MoveTroopsHere))
endfunction

function Trig_South_Cinematic_Setup_Func012001002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_South_Cinematic_Setup_Func012A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_South_Cinematic_Setup_Func014A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_South_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call AdjustPlayerStateBJ(3200, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(2400, udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER)
    // ///
    // ///
    // HidePlayer1Units
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_South_Cinematic_Setup_Func009001002)), function Trig_South_Cinematic_Setup_Func009A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_South_Cinematic_Setup_Func012001002)), function Trig_South_Cinematic_Setup_Func012A)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_South_Cinematic_Setup_Func014A)
    // ///
    // Create Buildings
    // ///
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_QMDunModrIcon02), bj_UNIT_FACING)
    call IssueBuildOrderByIdLocBJ(GetLastCreatedUnit(), 'o614', GetRectCenter(gg_rct_QMDunModrIcon02))
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_WarMill), bj_UNIT_FACING)
    call IssueBuildOrderByIdLocBJ(GetLastCreatedUnit(), 'xW21', GetRectCenter(gg_rct_WarMill))
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Barracks), bj_UNIT_FACING)
    call IssueBuildOrderByIdLocBJ(GetLastCreatedUnit(), 'o610', GetRectCenter(gg_rct_Barracks))
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Farm02), bj_UNIT_FACING)
    call IssueBuildOrderByIdLocBJ(GetLastCreatedUnit(), 'o60X', GetRectCenter(gg_rct_Farm02))
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Farm01), bj_UNIT_FACING)
    call IssueBuildOrderByIdLocBJ(GetLastCreatedUnit(), 'o60X', GetRectCenter(gg_rct_Farm01))
    // ///
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.20)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Mid2CinZuluhed01), 45.00)
    call SetUnitOwner(udg_FakeZuluhed, udg_Player_DragonmawCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_Mid2CinRend01), 248.64)
    call SetUnitOwner(udg_FakeMaim, udg_Player_BTGCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMaim)
    call SetUnitMoveSpeed(udg_FakeMaim, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_Mid2CinUtok01), 120.00)
    call SetUnitOwner(udg_FakeUtok, udg_Player_BlackRockCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // ///
    call CreateNUnitsAtLoc(1, 'o60G', Player(20), GetRectCenter(gg_rct_Mid2CinGrunt01), 180.00)
    set udg_Unit_CinGrunt=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_Unit_CinGrunt, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_CinGrunt)
    call SetUnitMoveSpeed(udg_Unit_CinGrunt, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_CinGrunt, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // ///
endfunction

