        return false
    endif
    if ( not ( GetAttacker() != gg_unit_dIMn_0193 ) ) then
        return false
    endif
    if ( not ( GetAttacker() != gg_unit_dIMn_0194 ) ) then
        return false
    endif
    if ( not ( GetAttacker() != gg_unit_dIMn_0195 ) ) then
        return false
    endif
    if ( not ( GetAttacker() != gg_unit_dIMn_0196 ) ) then
        return false
    endif
    if ( not ( GetAttacker() != gg_unit_dIMn_0197 ) ) then
        return false
    endif
    return true
endfunction

