    return ( udg_Bool_CinDukeSkipped == true )
endfunction

function Trig_Duke_Cinematic_Q_Func040001 takes nothing returns boolean
    return ( udg_Bool_CinDukeSkipped == true )
endfunction

function Trig_Duke_Cinematic_Q_Func047001 takes nothing returns boolean
    return ( udg_Bool_CinDukeSkipped == true )
endfunction

function Trig_Duke_Cinematic_Q_Func054001 takes nothing returns boolean
    return ( udg_Bool_CinDukeSkipped == true )
endfunction

function Trig_Duke_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_Duke_Cinematic_Q_Func006002)
    // ///
    call ClearSelectionForPlayer(udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_Actual)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call ConditionalTriggerExecute(gg_trg_Duke_Cinematic_Set_Up)
    // //
    set udg_Bool_CinDukeOn=true
    // //
    call PlaySoundBJ(gg_snd_Tension)
    call CameraSetupApplyForPlayer(true, gg_cam_DukeArrives, udg_Player_Actual, 2.00)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundAtPointBJ(gg_snd_BattlenetDeath1A, 100, GetRectCenter(gg_rct_DukeArrves), 0)
    call SetDestructableAnimationBJ(gg_dest_B61H_1419, "morph")
    call QueueDestructableAnimationBJ(gg_dest_B61H_1419, "stand alternate")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DukeArrives02, udg_Player_Actual, 20.00)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ForGroupBJ(udg_Group_BossFootmen, function Trig_Duke_Cinematic_Q_Func030002)
    call ConditionalTriggerExecute(gg_trg_Duke_Cinematic_GuardsWalkOut)
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_DukeArrves, udg_Fake_Duke) == true), (udg_Bool_CinDukeSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Duke, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_Fake_Duke, 0, gg_snd_WC2Orc05Baradin_Bossfight1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Duke, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DukeArrives03, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeZuluhed, 0, gg_snd_WC2Orc05Zuluhed_BossFight1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DukeArrives02, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_Fake_Duke, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_Fake_Duke, 0, gg_snd_WC2Orc05Baradin_Bossfight2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Duke, "cinematic listening one")
    // //
    call ConditionalTriggerExecute(gg_trg_Duke_Cinematic_Cleanup)
endfunction

