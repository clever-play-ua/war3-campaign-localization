    set gg_trg_AI_P17_Attacker_Being_Attacked=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_AI_P17_Attacker_Being_Attacked, Player(16), EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_AI_P17_Attacker_Being_Attacked, Condition(function Trig_AI_P17_Attacker_Being_Attacked_Conditions))
