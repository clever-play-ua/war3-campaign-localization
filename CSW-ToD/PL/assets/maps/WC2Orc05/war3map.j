//===========================================================================
// Trigger: Partisans ExplodeBridge
//===========================================================================
function Trig_Partisans_ExplodeBridge_Func014Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'LTex' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Partisans_ExplodeBridge_Func014A takes nothing returns nothing
    if ( Trig_Partisans_ExplodeBridge_Func014Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Partisans_ExplodeBridge_Func025001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true )
endfunction

function Trig_Partisans_ExplodeBridge_Func025Func003C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Partisans_ExplodeBridge_Func025A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
    call PolledWait(1.00)
    if ( Trig_Partisans_ExplodeBridge_Func025Func003C() ) then
        call RemoveUnit(GetEnumUnit())
    else
    endif
endfunction

function Trig_Partisans_ExplodeBridge_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Set Visibility Modifier
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_WaterFallBridge), 1024.00)
    set udg_VisMod_Bridge02=GetLastCreatedFogModifier()
    // Pan Camera
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_WaterFallBridge), 1.00)
    call PolledWait(1.00)
    // Destroy
    call EnumDestructablesInRectAll(gg_rct_WaterFallBridge, function Trig_Partisans_ExplodeBridge_Func014A)
    call PolledWait(0.50)
    call KillDestructable(gg_dest_YT22_2619)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_WaterFallBridge), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    set udg_SE_Explosion03=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale(udg_SE_Explosion03, 2.00)
    call BlzSetSpecialEffectZ(udg_SE_Explosion03, 760.10)
    call DestroyFogModifier(udg_VisMod_Bridge02)
    call PolledWait(0.50)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_DyingUnderBridge, Condition(function Trig_Partisans_ExplodeBridge_Func025001002)), function Trig_Partisans_ExplodeBridge_Func025A)
    // //
    call DestroyEffectBJ(udg_SE_Explosion03)
endfunction

//===========================================================================
function InitTrig_Partisans_ExplodeBridge takes nothing returns nothing
    set gg_trg_Partisans_ExplodeBridge=CreateTrigger()
    call TriggerRegisterDeathEvent(gg_trg_Partisans_ExplodeBridge, gg_dest_LTex_3501)
    call TriggerRegisterDeathEvent(gg_trg_Partisans_ExplodeBridge, gg_dest_LTex_0334)
    call TriggerRegisterDeathEvent(gg_trg_Partisans_ExplodeBridge, gg_dest_LTex_0335)
    call TriggerRegisterDeathEvent(gg_trg_Partisans_ExplodeBridge, gg_dest_LTex_3535)
    call TriggerRegisterDeathEvent(gg_trg_Partisans_ExplodeBridge, gg_dest_LTex_3536)
    call TriggerAddAction(gg_trg_Partisans_ExplodeBridge, function Trig_Partisans_ExplodeBridge_Actions)
endfunction

//===========================================================================
// Trigger: Partisans SecretTunnel Open
//===========================================================================
function Trig_Partisans_SecretTunnel_Open_Func029A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_TunnelDwarves)
endfunction

function Trig_Partisans_SecretTunnel_Open_Func031002 takes nothing returns nothing
    call IssuePointOrderLocBJ(GetEnumUnit(), "attack", GetRandomLocInRect(gg_rct_UndergroundStairsTopExitOut2))
endfunction

function Trig_Partisans_SecretTunnel_Open_Func032C takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_OQPartisans) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Partisans_SecretTunnel_Open_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(1.33)
    call ShowUnitShow(gg_unit_nC2M_0370)
    call WaygateActivateBJ(true, gg_unit_nC2M_0370)
    // //
    call SetUnitAnimation(gg_unit_nC2M_0370, "death alternate")
    call SetDestructableAnimationBJ(gg_dest_B014_2601, "decay")
    call SetDestAnimationSpeedPercent(gg_dest_B014_2601, 6000.00)
    call CameraSetEQNoiseForPlayer(Player(0), 3)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_ExplosionEffect), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    set udg_SE_Explosion01=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectZ(udg_SE_Explosion01, 1247.95)
    call BlzSetSpecialEffectScale(udg_SE_Explosion01, 2.00)
    // //
    call PolledWait(2.00)
    call RemoveDestructable(gg_dest_B014_2601)
    call DestroyEffectBJ(udg_SE_Explosion01)
    // //
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // //
    call CreateNUnitsAtLoc(2, 'dIFo', udg_Player_Dwarves, GetRectCenter(gg_rct_UndergroundStairsSpawn), GetRandomDirectionDeg())
    call PolledWait(1.00)
    call CreateNUnitsAtLoc(2, 'dISc', udg_Player_Dwarves, GetRectCenter(gg_rct_UndergroundStairsSpawn), GetRandomDirectionDeg())
    call PolledWait(1.00)
    call CreateNUnitsAtLoc(3, 'dISc', udg_Player_Dwarves, GetRectCenter(gg_rct_UndergroundStairsSpawn), GetRandomDirectionDeg())
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_ExplosionEffect, udg_Player_Dwarves), function Trig_Partisans_SecretTunnel_Open_Func029A)
    // //
    call ForGroupBJ(udg_Group_TunnelDwarves, function Trig_Partisans_SecretTunnel_Open_Func031002)
    if ( Trig_Partisans_SecretTunnel_Open_Func032C() ) then
        call QueuedTriggerAddBJ(gg_trg_Partisans_SecretTunnel_Open_Q, true)
    else
    endif
    // ///
    call GroupRemoveGroup(udg_Group_TunnelDwarves, udg_Group_TunnelDwarves)
    call DestroyGroup(udg_Group_TunnelDwarves)
endfunction

//===========================================================================
function InitTrig_Partisans_SecretTunnel_Open takes nothing returns nothing
    set gg_trg_Partisans_SecretTunnel_Open=CreateTrigger()
    call TriggerRegisterDeathEvent(gg_trg_Partisans_SecretTunnel_Open, gg_dest_B014_2601)
    call TriggerAddAction(gg_trg_Partisans_SecretTunnel_Open, function Trig_Partisans_SecretTunnel_Open_Actions)
endfunction

