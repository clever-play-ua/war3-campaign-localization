//===========================================================================
function Trig_SpawnMurlocks_Func005C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nmh0' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nmh1' ) ) then
        return true
    endif
    return false
endfunction

function Trig_SpawnMurlocks_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() != MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    if ( not Trig_SpawnMurlocks_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_SpawnMurlocks_Actions takes nothing returns nothing
    set udg_Point_SpawnMurlock=GetUnitLoc(GetDyingUnit())
    call CreateNUnitsAtLoc(1, 'nmrl', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Point_SpawnMurlock, GetRandomDirectionDeg())
    call RemoveLocation(udg_Point_SpawnMurlock)
endfunction

