//===========================================================================
// Trigger: Init 05 Quests
//===========================================================================
function Trig_Init_05_Quests_Actions takes nothing returns nothing
    // //
    // MAIN QUEST: RETAKE DUN MODR
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3985", "TRIGSTR_3986", "ReplaceableTextures\\CommandButtons\\BTNHumanBarracks.blp")
    set udg_MQRetakeDunModr=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQRetakeDunModr, "TRIGSTR_3987")
    set udg_QReq_RetakeCaptureNorth=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQRetakeDunModr, "TRIGSTR_3988")
    set udg_QReq_RetakeCaptureSouth=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQRetakeDunModr, "TRIGSTR_3989")
    set udg_QReq_RetakeZuluhedSurvive=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQRetakeDunModr, "TRIGSTR_3990")
    set udg_QReq_RetakeMaimSurvive=GetLastCreatedQuestItemBJ()
    // //
    // MAIN QUEST: FORTIFY DUN MODR
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3991", "TRIGSTR_3992", "ReplaceableTextures\\CommandButtons\\BTNWC2Stronghold.dds")
    set udg_MQFortify=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQFortify, "TRIGSTR_3993")
    set udg_QReq_FortifyUpgradeStronghold=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQFortify, "TRIGSTR_3994")
    set udg_QReq_FortifyBuildShipyard=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQFortify, "TRIGSTR_3995")
    set udg_QReq_FortifyBuildFoundry=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQFortify, "TRIGSTR_3996")
    set udg_QReq_FortifyBuildRefinery=GetLastCreatedQuestItemBJ()
    // //
    // MAIN QUEST: DESTROY TOL BARAD
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3997", "TRIGSTR_3998", "ReplaceableTextures\\CommandButtons\\BTNCastle.blp")
    set udg_MQTolBarad=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQTolBarad, "TRIGSTR_3999")
    set udg_QReq_TolBaradDestroyKeep=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQTolBarad, "TRIGSTR_4000")
    set udg_QReq_TolBaradKillDuke=GetLastCreatedQuestItemBJ()
    // //
    // OPTIONAL QUEST: DWARVEN PARTISANS
    // //
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_4001", "TRIGSTR_4002", "ReplaceableTextures\\CommandButtons\\BTNRifleman.blp")
    set udg_OQPartisans=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQPartisans, "TRIGSTR_4003")
    set udg_QReq_DestroyPartisans=GetLastCreatedQuestItemBJ()
    // //
    // //
    // //
endfunction

