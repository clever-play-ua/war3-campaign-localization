//===========================================================================
// Trigger: Final Cinematic Cleanup
//===========================================================================
function Trig_Final_Cinematic_Cleanup_Func005C takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_Cleanup_Func009002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinOutroOn=false
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    if ( Trig_Final_Cinematic_Cleanup_Func005C() ) then
        call StopSoundBJ(gg_snd_Orc2, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim6, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim7, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim8, false)
        call StopSoundBJ(gg_snd_WC2Orc05Utok4, false)
        call StopSoundBJ(gg_snd_WC2Orc05Utok5, false)
        call StopSoundBJ(gg_snd_WC2Orc05Zuluhed4, false)
        call StopSoundBJ(gg_snd_WC2Orc05Zuluhed5, false)
    else
    endif
    call RemoveUnit(udg_FakeMaim)
    call RemoveUnit(udg_FakeUtok)
    call RemoveUnit(udg_FakeZuluhed)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Final_Cinematic_Cleanup_Func009002)
    call ConditionalTriggerExecute(gg_trg_NextLevelPrep)
endfunction

