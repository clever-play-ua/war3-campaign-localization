function Trig_TransportationLandingZoneConfig_Actions takes nothing returns nothing
    // //
    // Main Player Camp South
    set udg_Point_LandingMainOrcBase01=GetRectCenter(gg_rct_P13AssaultUnload03)
    set udg_Point_LandingMainOrcBase02=GetRectCenter(gg_rct_P13AssaultUnload04)
    // Main Player Camp North
    set udg_Point_LandingMainOrcBase03=GetRectCenter(gg_rct_P13AssaultUnload01)
    set udg_Point_LandingMainOrcBase04=GetRectCenter(gg_rct_P13AssaultUnload02)
    // //
    // Tol Barad
    set udg_Point_LandingStromgarde01=GetRectCenter(gg_rct_P13AssaultUnloadTolBarad01)
    set udg_Point_LandingStromgarde02=GetRectCenter(gg_rct_P13AssaultUnloadTolBarad02)
    // //
    // Expansion Goldmine A
    set udg_Point_LandingExpansionA01=GetRectCenter(gg_rct_P13AssaultUnloadExpGoldmine01)
    set udg_Point_LandingExpansionA02=GetRectCenter(gg_rct_P13AssaultUnloadExpGoldmine02)
    // //
endfunction

