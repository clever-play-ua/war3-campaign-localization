endfunction

//===========================================================================
function InitTrig_RetakeN_DrunkDwarves takes nothing returns nothing
    set gg_trg_RetakeN_DrunkDwarves=CreateTrigger()
    call TriggerRegisterUnitInRangeSimple(gg_trg_RetakeN_DrunkDwarves, 256, gg_unit_dIMn_0196)
    call TriggerRegisterUnitEvent(gg_trg_RetakeN_DrunkDwarves, gg_unit_dIMn_0196, EVENT_UNIT_ATTACKED)
    call TriggerRegisterUnitInRangeSimple(gg_trg_RetakeN_DrunkDwarves, 256, gg_unit_dIMn_0195)
    call TriggerRegisterUnitEvent(gg_trg_RetakeN_DrunkDwarves, gg_unit_dIMn_0195, EVENT_UNIT_ATTACKED)
    call TriggerRegisterUnitInRangeSimple(gg_trg_RetakeN_DrunkDwarves, 256, gg_unit_dIMn_0197)
    call TriggerRegisterUnitEvent(gg_trg_RetakeN_DrunkDwarves, gg_unit_dIMn_0197, EVENT_UNIT_ATTACKED)
    call TriggerRegisterUnitInRangeSimple(gg_trg_RetakeN_DrunkDwarves, 256, gg_unit_dIMn_0194)
    call TriggerRegisterUnitEvent(gg_trg_RetakeN_DrunkDwarves, gg_unit_dIMn_0194, EVENT_UNIT_ATTACKED)
    call TriggerRegisterUnitInRangeSimple(gg_trg_RetakeN_DrunkDwarves, 256, gg_unit_dIMn_0193)
    call TriggerRegisterUnitEvent(gg_trg_RetakeN_DrunkDwarves, gg_unit_dIMn_0193, EVENT_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_RetakeN_DrunkDwarves, Condition(function Trig_RetakeN_DrunkDwarves_Conditions))
    call TriggerAddAction(gg_trg_RetakeN_DrunkDwarves, function Trig_RetakeN_DrunkDwarves_Actions)
endfunction

