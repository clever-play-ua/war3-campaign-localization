//===========================================================================
// Trigger: Cinematic FadeCameraFocus
//===========================================================================
function Trig_Cinematic_FadeCameraFocus_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_FadeCameraFocus_Func002Func001C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cinematic_FadeCameraFocus_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=100
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Cinematic_FadeCameraFocus_Func002Func001C() ) then
            call CameraSetFocalDistance(udg_Real_FocalDistance)
            call CameraSetDepthOfFieldScale(udg_Real_DepthOfField)
            call TriggerSleepAction(0.05)
            set udg_Real_FocalDistance=( udg_Real_FocalDistance + 40.00 )
            set udg_Real_DepthOfField=( udg_Real_DepthOfField + 20.00 )
        else
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Cinematic_FadeCameraFocus takes nothing returns nothing
    set gg_trg_Cinematic_FadeCameraFocus=CreateTrigger()
    call TriggerAddCondition(gg_trg_Cinematic_FadeCameraFocus, Condition(function Trig_Cinematic_FadeCameraFocus_Conditions))
    call TriggerAddAction(gg_trg_Cinematic_FadeCameraFocus, function Trig_Cinematic_FadeCameraFocus_Actions)
endfunction

//===========================================================================
// Trigger: LaunchInGameMusic
//===========================================================================
function Trig_LaunchInGameMusic_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Maim_Recklessness_Bonus < 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LaunchInGameMusic_Actions takes nothing returns nothing
    call PlayMusicBJ(udg_Music_CurrentName)
    set udg_Int_C=1
    loop
        exitwhen udg_Int_C > 100
        if ( Trig_LaunchInGameMusic_Func002Func001C() ) then
            set udg_Music_CurrentVolume=( udg_Music_CurrentVolume + 1 )
            call SetMusicVolumeBJ(udg_Music_CurrentVolume)
            call TriggerSleepAction(0.02)
        else
        endif
        set udg_Int_C=udg_Int_C + 1
    endloop
endfunction

//===========================================================================
function InitTrig_LaunchInGameMusic takes nothing returns nothing
    set gg_trg_LaunchInGameMusic=CreateTrigger()
    call TriggerAddAction(gg_trg_LaunchInGameMusic, function Trig_LaunchInGameMusic_Actions)
endfunction

