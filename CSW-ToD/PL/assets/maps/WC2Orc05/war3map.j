function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_Actual)
    // ///
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Setup)
    call TriggerSleepAction(0.01)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_IntroSea, udg_Player_Actual, 0)
    // ///
    call IssuePointOrderLocBJ(gg_unit_o60Q_0031, "move", GetRectCenter(gg_rct_IntroTransportUnload01))
    call IssuePointOrderLocBJ(gg_unit_o60Q_0032, "move", GetRectCenter(gg_rct_IntroTransportUnload02))
    call IssuePointOrderLocBJ(gg_unit_o60R_0034, "move", GetRectCenter(gg_rct_IntroDestroyer01))
    call IssuePointOrderLocBJ(gg_unit_o60R_0035, "move", GetRectCenter(gg_rct_IntroDestroyer02))
    call IssuePointOrderLocBJ(gg_unit_o60R_0037, "move", GetRectCenter(gg_rct_IntroDestroyer04))
    call IssuePointOrderLocBJ(gg_unit_o60R_0036, "move", GetRectCenter(gg_rct_IntroDestroyer03))
    call PlaySoundOnUnitBJ(gg_snd_CS_Orc2x_Theramore_intro_Boats, 75.00, gg_unit_o60Q_0031)
    // ///
    call PlaySoundBJ(gg_snd_Orc3)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    // Cinematic Started
    set udg_Bool_CinIntroOn=true
    // ///
    // Ships Arrive
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_IntroShore, udg_Player_Actual, 5.00)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_LoadMaim))
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Maim Walks to Shore
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_IntroMaim01, udg_Player_Actual, 0)
    call PlaySoundBJ(gg_snd_CS_H01a_Uther_walks_003_LR_v3)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_IntroMaim02, udg_Player_Actual, ( DistanceBetweenPoints(GetUnitLoc(udg_FakeMaim), GetRectCenter(gg_rct_LoadMaim)) / GetUnitMoveSpeed(udg_FakeMaim) ))
    // ///
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_LoadMaim, udg_FakeMaim) == true), (udg_Bool_CinIntroSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Dialogue
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_IntroZuluhed, udg_Player_Actual, 0)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeZuluhed, 0, gg_snd_WC2Orc05Zuluhed1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeUtok, 0, gg_snd_WC2Orc05Utok1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroTalk, udg_Player_Actual, 0)
    call SetUnitAnimation(udg_FakeMaim, "cinematic frustrated one")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_IntroZuluhed, udg_Player_Actual, 0)
    // ///
    call SetUnitAnimation(udg_FakeUtok, "cinematic idea one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeUtok, 0, gg_snd_WC2Orc05Utok2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroMaimComplains, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_CantYouSee, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc05Maim2))
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeMaim, udg_FakeUtok, 0.50)
    call SetUnitAnimation(udg_FakeMaim, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic angry one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroZuluhed, udg_Player_Actual, 0)
    // //
    call StopSoundBJ(gg_snd_Orc3, true)
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeMaim, udg_Hero_Zuluhed, 0.50)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeZuluhed, 0, gg_snd_WC2Orc05Zuluhed2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // ///
    // Battle field
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr03, udg_Player_Actual, 0)
    call PlaySoundBJ(gg_snd_WC3OrcDefeat)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim3, bj_TIMETYPE_ADD, 0, false)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr04, udg_Player_Actual, 7.00)
    call TriggerSleepAction(7.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Dun Modr
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr01, udg_Player_Actual, 0)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr02, udg_Player_Actual, 8.00)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim4, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Talk
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_IntroTalk, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_IntroTalk02, udg_Player_Actual, ( 8.00 + ( GetSoundDurationBJ(gg_snd_WC2Orc05Zuluhed3) + 9.00 ) ))
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // ///
    call TriggerSleepAction(7.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // ///
    call StopSoundBJ(gg_snd_WC3OrcDefeat, true)
    // ///
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeZuluhed, 0, gg_snd_WC2Orc05Zuluhed3, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc05Zuluhed3) - 8.00 ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PlaySoundBJ(gg_snd_OrcX1)
    // ///
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_DragonmawUnload01)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_DragonmawUnload02)
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_UtokIntroWalk00))
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // ///
    // Tol Barad
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_IntroUtokScope, udg_Player_Actual, 0)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeUtok, 0, gg_snd_WC2Orc05Utok3, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_TolBaradIntro, udg_Player_Actual, 0)
    set udg_Real_FocalDistance=400.00
    set udg_Real_DepthOfField=200.00
    call SetCameraFieldForPlayer(udg_Player_Actual, CAMERA_FIELD_FIELD_OF_VIEW, 50.00, 4.00)
    call CameraSetSourceNoiseForPlayer(udg_Player_Actual, 20.00, 0.20)
    call CameraSetupApplyForPlayer(true, gg_cam_TolBaradIntro02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc05Utok3))
    call ConditionalTriggerExecute(gg_trg_Cinematic_FadeCameraFocus)
    // ///
    // TelescopeEffect
    // ///
    call CinematicFilterGenericBJ(1.00, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\Scope_Mask.blp", 100, 100, 100, 0.00, 100.00, 100.00, 100.00, 0.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call TriggerSleepAction(11.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Utok Walk Out Scene
    // ///
    call CinematicFilterGenericBJ(1.00, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0.00, 100.00, 100.00, 100.00, 0.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call DisableTrigger(gg_trg_Cinematic_FadeCameraFocus)
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CameraSetupApplyForPlayer(true, gg_cam_IntroLookAtDunModr, udg_Player_Actual, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_UtokIntroWalk01))
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    // //
    call StopSoundBJ(gg_snd_OrcX1, true)
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // ///
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Q takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Q, function Trig_Intro_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Setup
//===========================================================================
function Trig_Intro_Cinematic_Setup_Func046A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Intro_Cinematic_Setup_Func048Func001Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'n02F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Setup_Func048Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'o60G' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Setup_Func048A takes nothing returns nothing
    if ( Trig_Intro_Cinematic_Setup_Func048Func001C() ) then
        call SetUnitColor(GetEnumUnit(), PLAYER_COLOR_SNOW)
    else
        if ( Trig_Intro_Cinematic_Setup_Func048Func001Func003C() ) then
            call SetUnitColor(GetEnumUnit(), PLAYER_COLOR_SNOW)
        else
            call DoNothing()
        endif
    endif
endfunction

function Trig_Intro_Cinematic_Setup_Func050Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Setup_Func050A takes nothing returns nothing
    if ( Trig_Intro_Cinematic_Setup_Func050Func001C() ) then
        call SetUnitBlendTimeBJ(GetEnumUnit(), 0.25)
        call AddUnitAnimationPropertiesBJ(true, "cinematic", GetEnumUnit())
        call SetUnitMoveSpeed(GetEnumUnit(), 100.00)
        call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
        call ShowUnitHide(GetEnumUnit())
    else
    endif
endfunction

function Trig_Intro_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call UseTimeOfDayBJ(false)
    call SetTerrainFogExBJ(0, 2500.00, 8000.00, 0.05, 82.00, 63.00, 25.00)
    // ///
    // Postion Units
    // ///
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60R_0034, GetRectCenter(gg_rct_IntroDestroyerStart01), GetRectCenter(gg_rct_IntroDestroyer01))
    call SetUnitScalePercent(gg_unit_o60R_0034, 200.00, 200.00, 200.00)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60R_0035, GetRectCenter(gg_rct_IntroDestroyerStart02), GetRectCenter(gg_rct_IntroDestroyer02))
    call SetUnitScalePercent(gg_unit_o60R_0035, 200.00, 200.00, 200.00)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60R_0037, GetRectCenter(gg_rct_IntroDestroyerStart04), GetRectCenter(gg_rct_IntroDestroyer04))
    call SetUnitScalePercent(gg_unit_o60R_0037, 200.00, 200.00, 200.00)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60R_0036, GetRectCenter(gg_rct_IntroDestroyerStart03), GetRectCenter(gg_rct_IntroDestroyer03))
    call SetUnitScalePercent(gg_unit_o60R_0036, 200.00, 200.00, 200.00)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60Q_0031, GetRectCenter(gg_rct_IntroTransportStart01), GetRectCenter(gg_rct_IntroTransportUnload01))
    call SetUnitScalePercent(gg_unit_o60Q_0031, 160.00, 160.00, 160.00)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60Q_0032, GetRectCenter(gg_rct_IntroTransportStart02), GetRectCenter(gg_rct_IntroTransportUnload02))
    call SetUnitScalePercent(gg_unit_o60Q_0032, 160.00, 160.00, 160.00)
    call SetUnitAnimation(gg_unit_o61Y_0068, "stand work")
    // //
    // //
    call TriggerSleepAction(0.25)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeMaim, GetRectCenter(gg_rct_UtokIntroWalk01), GetRectCenter(gg_rct_IntroCinMaim))
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMaim)
    call SetUnitMoveSpeed(udg_FakeMaim, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitOwner(udg_FakeMaim, udg_Player_BTGCinematic, true)
    // //
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call TriggerSleepAction(0.25)
    // //
    // Hide Intro Units
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_HideIntroUnits, udg_Player_Actual), function Trig_Intro_Cinematic_Setup_Func046A)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Intro_Cinematic_Setup_Func048A)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Intro_Cinematic_Setup_Func050A)
    // //
    // //
    call ShowUnitHide(udg_Hero_Maim)
    call ShowUnitHide(udg_Hero_Zuluhed)
    call ShowUnitHide(udg_SemiHero_Utok)
    // //
    call SetItemVisibleBJ(false, gg_item_I603_0319)
    call SetItemVisibleBJ(false, gg_item_I603_0324)
    call ShowUnitHide(gg_unit_n61O_0133)
    // //
    // Catapult Corpses
    // //
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60P', udg_Player_Actual, GetRectCenter(gg_rct_Catapult01Fix), 46.16)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60P', udg_Player_Actual, GetRectCenter(gg_rct_Catapult02Fix), 21.16)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'hBaL', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DeadBallista), 186.04)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_RED)
    // //
    // Building Corpses
    // //
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o007', udg_Player_StromgardeGA, GetRectCenter(gg_rct_DeadTower), 352.00)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o002', udg_Player_StromgardeGA, GetRectCenter(gg_rct_DeadFarm), 270.00)
    call CreateDestructableLoc('B000', GetRectCenter(gg_rct_DeadFarm), 270.00, 1, 0)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'obar', udg_Player_StromgardeGA, GetRectCenter(gg_rct_DeadBarracks), 326.36)
    call CreateDestructableLoc('B000', GetRectCenter(gg_rct_DeadBarracks), 270.00, 1, 0)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o007', udg_Player_StromgardeGA, GetRectCenter(gg_rct_DeadTower2), 181.21)
    // //
    // //
    // //
    // //
endfunction

