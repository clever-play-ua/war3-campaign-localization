    set gg_trg_RetakeN_PitTrap01=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_RetakeN_PitTrap01, gg_rct_ItsATrap01)
    call TriggerAddCondition(gg_trg_RetakeN_PitTrap01, Condition(function Trig_RetakeN_PitTrap01_Conditions))
    call TriggerAddAction(gg_trg_RetakeN_PitTrap01, function Trig_RetakeN_PitTrap01_Actions)
endfunction

