//===========================================================================
// Trigger: RetakeN BusyPeon Patrol
//===========================================================================
function Trig_RetakeN_BusyPeon_Patrol_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQRetakeDunModr) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeN_BusyPeon_Patrol_Func001001 takes nothing returns boolean
    return ( udg_Int_BusyPeon >= 4 )
endfunction

function Trig_RetakeN_BusyPeon_Patrol_Func004001 takes nothing returns boolean
    return ( RectContainsUnit(udg_Region_BusyPeon[udg_Int_BusyPeon], udg_Unit_BusyPeon) == true )
endfunction

function Trig_RetakeN_BusyPeon_Patrol_Func007001 takes nothing returns boolean
    return ( IsQuestCompleted(udg_MQRetakeDunModr) == true )
endfunction

function Trig_RetakeN_BusyPeon_Patrol_Actions takes nothing returns nothing
    if ( (udg_Int_BusyPeon >= 4) ) then // INLINED!!
        set udg_Int_BusyPeon=1
    else
        set udg_Int_BusyPeon=( udg_Int_BusyPeon + 1 )
    endif
    call IssuePointOrderLocBJ(udg_Unit_BusyPeon, "move", udg_Point_BusyPeonTarget[udg_Int_BusyPeon])
    loop
        exitwhen ( (RectContainsUnit(udg_Region_BusyPeon[udg_Int_BusyPeon], udg_Unit_BusyPeon) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    // //
    call PolledWait(1.00)
    if ( (IsQuestCompleted(udg_MQRetakeDunModr) == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_BusyPeon, "stand work")
    call TriggerSleepAction(GetRandomReal(1.00, 5.00))
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_RetakeN_BusyPeon_Patrol takes nothing returns nothing
    set gg_trg_RetakeN_BusyPeon_Patrol=CreateTrigger()
    call TriggerAddCondition(gg_trg_RetakeN_BusyPeon_Patrol, Condition(function Trig_RetakeN_BusyPeon_Patrol_Conditions))
    call TriggerAddAction(gg_trg_RetakeN_BusyPeon_Patrol, function Trig_RetakeN_BusyPeon_Patrol_Actions)
endfunction

