    call UnitShareVisionBJ(true, GetEnumUnit(), udg_Player_Actual)
endfunction

function Trig_Duke_Cinematic_Set_Up_Func021C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Zuluhed) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Hero_Zuluhed) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Duke_Cinematic_Set_Up_Func023002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Duke_Cinematic_Set_Up_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call PauseUnitBJ(true, gg_unit_h60Y_0207)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StromgardeGA, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeGA, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StromgardeDef, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDef, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_TolBaradFire, Player(0)), function Trig_Duke_Cinematic_Set_Up_Func012A)
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_Duke_Cinematic_Set_Up_Func014A)
    // //
    call ForGroupBJ(udg_Group_BossArchers, function Trig_Duke_Cinematic_Set_Up_Func016002)
    call ForGroupBJ(udg_Group_BossArchers, function Trig_Duke_Cinematic_Set_Up_Func017002)
    call ForGroupBJ(udg_Group_BossArchers, function Trig_Duke_Cinematic_Set_Up_Func018002)
    // //
    // //
    if ( Trig_Duke_Cinematic_Set_Up_Func021C() ) then
        call GroupAddUnitSimple(udg_Hero_Zuluhed, udg_Group_HiddenUnits)
    else
    endif
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Duke_Cinematic_Set_Up_Func023002)
    // //
    call ShowUnitShow(gg_unit_hCan_0509)
    call PauseUnitBJ(false, gg_unit_hCan_0509)
    // //
    call ShowUnitShow(gg_unit_hCan_0258)
    call PauseUnitBJ(false, gg_unit_hCan_0258)
    // //
    call TriggerSleepAction(0.10)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_DukeMaim), 90.26)
    call SetUnitAnimation(udg_FakeMaim, "stand ready")
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_DukeZuluhed), 95.49)
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

