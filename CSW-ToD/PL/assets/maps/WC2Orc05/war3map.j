//===========================================================================
// Trigger: RetakeS UnlockDragonTomb
//===========================================================================
function Trig_RetakeS_UnlockDragonTomb_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call RemoveDestructable(gg_dest_B01K_9094)
    // //
    call SetUnitTimeScalePercent(gg_unit_njga_0162, 100)
    call ResetUnitAnimation(gg_unit_njga_0162)
    call SetUnitBlendTimeBJ(gg_unit_njga_0162, 0.15)
    call QueueUnitAnimationBJ(gg_unit_njga_0162, "stand")
    call ShowUnitShow(gg_unit_njga_0162)
    call PauseUnitBJ(false, gg_unit_njga_0162)
    // //
    call RemoveDestructable(gg_dest_B01L_9095)
    call SetUnitTimeScalePercent(gg_unit_njg1_0161, 100)
    call ResetUnitAnimation(gg_unit_njg1_0161)
    call SetUnitBlendTimeBJ(gg_unit_njg1_0161, 0.15)
    call QueueUnitAnimationBJ(gg_unit_njg1_0161, "stand")
    call ShowUnitShow(gg_unit_njg1_0161)
    call PauseUnitBJ(false, gg_unit_njg1_0161)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_B62R_8305, false)
endfunction

