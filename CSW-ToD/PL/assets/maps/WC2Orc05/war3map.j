function InitTrig_AI_P13_Defeated takes nothing returns nothing
    set gg_trg_AI_P13_Defeated=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AI_P13_Defeated, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AI_P13_Defeated, Condition(function Trig_AI_P13_Defeated_Conditions))
    call TriggerAddAction(gg_trg_AI_P13_Defeated, function Trig_AI_P13_Defeated_Actions)
endfunction

