function Trig_AI_P13_Transports_Availiable_Checker_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    if ( Trig_AI_P13_Transports_Availiable_Checker_Func004C() ) then
        set udg_Bool_P13TransportsAvailable=false
        if ( Trig_AI_P13_Transports_Availiable_Checker_Func004Func003C() ) then
            call DisplayTextToForce(udg_PlayerGroup_Actual, "TRIGSTR_4345")
        else
        endif
    else
        set udg_Bool_P13TransportsAvailable=true
    endif
    // //
    // //
    if ( Trig_AI_P13_Transports_Availiable_Checker_Func007C() ) then
        call ConditionalTriggerExecute(gg_trg_AI_P13_Stop_Attack_Command)
        if ( Trig_AI_P13_Transports_Availiable_Checker_Func007Func002C() ) then
            call DisplayTextToForce(udg_PlayerGroup_Actual, "TRIGSTR_4346")
        else
        endif
    else
    endif
    // //
    if ( Trig_AI_P13_Transports_Availiable_Checker_Func009C() ) then
        call ConditionalTriggerExecute(gg_trg_AI_P13_Start_Attack_Command)
        if ( Trig_AI_P13_Transports_Availiable_Checker_Func009Func002C() ) then
            call DisplayTextToForce(udg_PlayerGroup_Actual, "TRIGSTR_4347")
        else
        endif
    else
    endif
    // //
endfunction

