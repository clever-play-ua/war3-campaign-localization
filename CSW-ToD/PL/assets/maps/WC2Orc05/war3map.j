    set gg_trg_SpawnMurlocks=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpawnMurlocks, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_SpawnMurlocks, Condition(function Trig_SpawnMurlocks_Conditions))
