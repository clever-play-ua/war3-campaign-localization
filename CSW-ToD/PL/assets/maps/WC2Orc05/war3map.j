//===========================================================================
// Trigger: AI P06 Start
//===========================================================================
function Trig_AI_P06_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerStateBJ(udg_Player_Dwarves, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(udg_Player_Dwarves, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call SetPlayerStateBJ(udg_Player_Dwarves, PLAYER_STATE_FOOD_CAP_CEILING, 100)
    call SetPlayerStateBJ(udg_Player_Dwarves, PLAYER_STATE_RESOURCE_FOOD_CAP, 100)
    // //
    call EnableTrigger(gg_trg_AI_P06Gold)
    call EnableTrigger(gg_trg_AI_P06Lumber)
    // //
    call StartCampaignAI(udg_Player_Dwarves, "CSW\\Scripts\\ToDScripts\\WC2Orc05\\WC2Orc05P06DwarvesAI.ai")
    // //
endfunction

