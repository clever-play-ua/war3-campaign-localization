endfunction

function Trig_Duke_Cinematic_Cleanup_Func028A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_Duke_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinDukeOn=false
    // ///
    if ( Trig_Duke_Cinematic_Cleanup_Func004C() ) then
        call StopSoundBJ(gg_snd_Tension, false)
        call StopSoundBJ(gg_snd_WC2Orc05Zuluhed_BossFight1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Baradin_Bossfight1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Baradin_Bossfight2, false)
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
        // ///
        call SetUnitPositionLocFacingBJ(gg_unit_hfSt_0471, GetRectCenter(gg_rct_Guard01), bj_UNIT_FACING)
        call ShowUnitShow(gg_unit_hfSt_0471)
        call SetUnitPositionLocFacingBJ(gg_unit_hfSt_0472, GetRectCenter(gg_rct_Guard02), bj_UNIT_FACING)
        call ShowUnitShow(gg_unit_hfSt_0472)
        call SetUnitPositionLocFacingBJ(gg_unit_hfSt_0469, GetRectCenter(gg_rct_Guard03), bj_UNIT_FACING)
        call ShowUnitShow(gg_unit_hfSt_0469)
        call SetUnitPositionLocFacingBJ(gg_unit_hfSt_0470, GetRectCenter(gg_rct_Guard04), bj_UNIT_FACING)
        call ShowUnitShow(gg_unit_hfSt_0470)
        call SetUnitPositionLocFacingBJ(gg_unit_hfSt_0473, GetRectCenter(gg_rct_Guard05), bj_UNIT_FACING)
        call ShowUnitShow(gg_unit_hfSt_0473)
        call SetUnitPositionLocFacingBJ(gg_unit_hfSt_0474, GetRectCenter(gg_rct_Guard06), bj_UNIT_FACING)
        call ShowUnitShow(gg_unit_hfSt_0474)
        // ///
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
    endif
    // ///
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call SetUnitPositionLoc(udg_Hero_DukeBaradin, GetRectCenter(gg_rct_DukeArrves))
    call ShowUnitShow(udg_Hero_DukeBaradin)
    call PauseUnitBJ(false, udg_Hero_DukeBaradin)
    call BlzUnitDisableAbility(udg_Hero_DukeBaradin, 'AIad', false, false)
    // //
    call ForGroupBJ(udg_Group_BossFootmen, function Trig_Duke_Cinematic_Cleanup_Func013002)
    call ForGroupBJ(udg_Group_BossArchers, function Trig_Duke_Cinematic_Cleanup_Func014002)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DukeReset, udg_Player_Actual, 2.00)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Duke_Cinematic_Cleanup_Func018002)
    call GroupRemoveGroup(udg_Group_HiddenUnits, udg_Group_HiddenUnits)
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_Duke_Cinematic_Cleanup_Func021A)
    // //
    call GroupRemoveGroup(udg_Group_PausedUnits, udg_Group_PausedUnits)
    // //
    call PauseUnitBJ(false, gg_unit_h60Y_0207)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_TolBaradCatapults, Condition(function Trig_Duke_Cinematic_Cleanup_Func028001002)), function Trig_Duke_Cinematic_Cleanup_Func028A)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StromgardeGA, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeGA, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StromgardeDef, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDef, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    // //
    call DestroyMinimapIcon(udg_MinimapIcon_TolBarad[2])
    // //
    call CampaignMinimapIconUnitBJ(udg_Hero_DukeBaradin, bj_CAMPPINGSTYLE_BOSS)
    set udg_MinimapIcon_TolBarad[2]=GetLastCreatedMinimapIcon()
    // //
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupClear(udg_Group_SelectedUnits)
    // ///
    call QueuedTriggerRemoveBJ(gg_trg_Duke_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call QueuedTriggerAddBJ(gg_trg_Barad_DukeMaim_Q, true)
endfunction

