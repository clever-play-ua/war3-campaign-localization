function Trig_Catapult_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinCatapultSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Catapult_Cinematic_Cleanup_Func013C takes nothing returns boolean
    if ( not ( udg_Bool_CinCatapultSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Catapult_Cinematic_Cleanup_Func017Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'CTtr' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Catapult_Cinematic_Cleanup_Func017A takes nothing returns nothing
    if ( Trig_Catapult_Cinematic_Cleanup_Func017Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Catapult_Cinematic_Cleanup_Func018A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Catapult_Cinematic_Cleanup_Func019A takes nothing returns nothing
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Catapult_Cinematic_Cleanup_Func022A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Catapult_Cinematic_Cleanup_Func039C takes nothing returns boolean
    if ( not ( udg_Bool_CinCatapultSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Catapult_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinCatapultOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Catapult_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=2
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call IssueImmediateOrderBJ(udg_Unit_CatapultsArr[GetForLoopIndexA()], "stop")
        call SetUnitMoveSpeed(udg_Unit_CatapultsArr[GetForLoopIndexA()], GetUnitDefaultMoveSpeed(udg_Unit_CatapultsArr[GetForLoopIndexA()]))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitPositionLocFacingLocBJ(udg_Unit_CatapultsArr[1], GetRectCenter(gg_rct_Catapult01), GetRectCenter(gg_rct_CatapultTarget02))
    call SetUnitPositionLocFacingLocBJ(udg_Unit_CatapultsArr[2], GetRectCenter(gg_rct_Catapult02), GetRectCenter(gg_rct_CatapultTarget01))
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_WallpaperDoodad)
    // ///
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // ///
    // ///
    if ( Trig_Catapult_Cinematic_Cleanup_Func013C() ) then
        call StopSoundBJ(gg_snd_WC2Orc05Utok_Catapult1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Utok_Catapult2, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim_Catapult1, false)
        call StopSoundBJ(gg_snd_DarkAgents, false)
        call SetUnitAnimation(udg_Unit_CatapultsArr[2], "death")
        call SetUnitPositionLocFacingLocBJ(gg_unit_o61Y_0067, GetRectCenter(gg_rct_CatapultCinPeon02), GetRectCenter(gg_rct_Catapult02))
    else
    endif
    call PauseUnitBJ(true, udg_Unit_CatapultsArr[1])
    call SetUnitPathing(udg_Unit_CatapultsArr[1], true)
    call PauseUnitBJ(true, udg_Unit_CatapultsArr[2])
    call EnumDestructablesInRectAll(gg_rct_TreesCut, function Trig_Catapult_Cinematic_Cleanup_Func017A)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Catapult_Cinematic_Cleanup_Func018A)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Catapult_Cinematic_Cleanup_Func019A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Catapult_Cinematic_Cleanup_Func022A)
    // ///
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61Y_0066, GetRectCenter(gg_rct_PeonChill01), GetRectCenter(gg_rct_Campfire))
    call SetUnitAnimation(gg_unit_o61Y_0067, "stand work")
    // ///
    call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_CatapultCinUtok01), GetRectCenter(gg_rct_Catapult02))
    call ShowUnitShow(udg_SemiHero_Utok)
    call SetUnitAnimation(udg_SemiHero_Utok, "cinematic writing one")
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_CatapultsAfterCin, udg_Player_Actual, 0)
    // ///
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, Player(0))
    call GroupClear(udg_Group_SelectedUnits)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Catapult_Cinematic_Cleanup_Func039C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Catapult_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

