//===========================================================================
// Trigger: VisibilityControllerUALLOFF
//===========================================================================
function Trig_VisibilityControllerUALLOFF_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetVisibilityControllerOff(GetForLoopIndexA())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

