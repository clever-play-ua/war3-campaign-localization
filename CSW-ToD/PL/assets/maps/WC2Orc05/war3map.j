//===========================================================================
// Trigger: North Cinematic Q
//===========================================================================
function Trig_North_Cinematic_Q_Func007002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_SelectedUnits)
endfunction

function Trig_North_Cinematic_Q_Func028001001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_MidCinRend02, udg_FakeMaim) == true )
endfunction

function Trig_North_Cinematic_Q_Func028001002 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_Q_Func028001 takes nothing returns boolean
    return GetBooleanOr((RectContainsUnit(gg_rct_MidCinRend02, udg_FakeMaim) == true), (udg_Bool_CinNorthSkipped == true)) // INLINED!!
endfunction

function Trig_North_Cinematic_Q_Func029001 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_Q_Func032001 takes nothing returns boolean
