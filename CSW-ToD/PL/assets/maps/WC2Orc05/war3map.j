function Trig_Goblin_Cinematic_Cleanup_Func037A takes nothing returns nothing
    call SetUnitMoveSpeed(GetEnumUnit(), GetUnitDefaultMoveSpeed(GetEnumUnit()))
endfunction

function Trig_Goblin_Cinematic_Cleanup_Func038002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Goblin_Cinematic_Cleanup_Func039002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Goblin_Cinematic_Cleanup_Func049C takes nothing returns boolean
    if ( not ( udg_Bool_CinGoblinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinGoblinOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Goblin_Cinematic_Cleanup_Func004C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinCinReset, udg_Player_Actual, 0)
    // ///
    if ( Trig_Goblin_Cinematic_Cleanup_Func009C() ) then
        call DestroyEffectBJ(udg_SE_ZeppelinBomb)
        call StopSoundBJ(gg_snd_OrcTheme, false)
        call StopSoundBJ(gg_snd_WC2Orc05Zuluhed_Submarine1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Utok_Zepplin1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Goblin_Submarine1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Goblin_Zeppelin1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Goblin_Zeppelin2, false)
        call RemoveUnit(udg_Unit_EnemySubmarine)
        call SetUnitPositionLocFacingLocBJ(udg_Unit_CinZeppelin, GetRectCenter(gg_rct_GoblinCinGoblin01), GetRectCenter(gg_rct_GoblinCinZuluhed))
        call RemoveDestructable(gg_dest_OTip_11683)
        call RemoveDestructable(gg_dest_OTip_11684)
        call RemoveDestructable(gg_dest_OTip_11685)
        call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0031, GetRectCenter(gg_rct_GoblinCinTransport01Escape), 45.00)
        call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0032, GetRectCenter(gg_rct_GoblinCinTransport02Escape), 315.00)
        call SetUnitPositionLocFacingBJ(gg_unit_o60R_0035, GetRectCenter(gg_rct_GoblinCinDestroyer03), 0.00)
        call SetUnitPositionLocFacingBJ(gg_unit_o60R_0037, GetRectCenter(gg_rct_GoblinCinDestroyer03Start), 0.00)
        call SetUnitPositionLocFacingBJ(gg_unit_o60R_0034, GetRectCenter(gg_rct_GoblinCinDestroyer02), 0.00)
        call SetUnitPositionLocFacingBJ(gg_unit_o60R_0036, GetRectCenter(gg_rct_GoblinCinDestroyer01), 0.00)
    else
    endif
    if ( Trig_Goblin_Cinematic_Cleanup_Func010C() ) then
        call ShowUnitShow(udg_Unit_CinGoblinEngineer)
        call SetUnitPositionLoc(udg_Unit_CinGoblinEngineer, GetRectCenter(gg_rct_GoblinLab))
        call IssueBuildOrderByIdLocBJ(udg_Unit_CinGoblinEngineer, 'o000', GetRectCenter(gg_rct_GoblinLab))
    else
    endif
    call SetUnitInvulnerable(udg_Unit_CinGoblinEngineer, true)
    call PauseUnitBJ(false, gg_unit_o60R_0036)
    call PauseUnitBJ(false, gg_unit_o60R_0037)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GoblinLab, Condition(function Trig_Goblin_Cinematic_Cleanup_Func016001002)), function Trig_Goblin_Cinematic_Cleanup_Func016A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Dwarves), function Trig_Goblin_Cinematic_Cleanup_Func019002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Dwarves), function Trig_Goblin_Cinematic_Cleanup_Func021002)
    // ///
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call ShowUnitShow(gg_unit_hFrK_0336)
    call RemoveUnit(udg_Unit_CinZeppelin)
    call CreateNUnitsAtLoc(1, 'h000', udg_Player_Actual, GetRectCenter(gg_rct_GoblinCinGoblin01), 45.00)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_RED)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'h001'), function Trig_Goblin_Cinematic_Cleanup_Func030A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'h001'), function Trig_Goblin_Cinematic_Cleanup_Func032A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_DragonmawCinematic, Condition(function Trig_Goblin_Cinematic_Cleanup_Func035001002)), function Trig_Goblin_Cinematic_Cleanup_Func035A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_DragonmawCinematic, Condition(function Trig_Goblin_Cinematic_Cleanup_Func037001002)), function Trig_Goblin_Cinematic_Cleanup_Func037A)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Goblin_Cinematic_Cleanup_Func038002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Goblin_Cinematic_Cleanup_Func039002)
    call GroupClear(udg_Group_HiddenUnits)
    // ///
    call DestroyGroup(udg_Group_DragonmawShips)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupClear(udg_Group_SelectedUnits)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Goblin_Cinematic_Cleanup_Func049C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Goblin_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call ConditionalTriggerExecute(gg_trg_Barad_Discover)
endfunction

//===========================================================================
function InitTrig_Goblin_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Goblin_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Goblin_Cinematic_Cleanup, function Trig_Goblin_Cinematic_Cleanup_Actions)
endfunction

