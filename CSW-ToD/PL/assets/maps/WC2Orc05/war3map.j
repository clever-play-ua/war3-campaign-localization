endfunction

//===========================================================================
// Trigger: OilReturnForHumanDestroyer
//===========================================================================
function Trig_OilReturnForHumanDestroyer_Func001C takes nothing returns boolean
    if ( ( GetTrainedUnitType() == 'hFrK' ) ) then
        return true
    endif
    if ( ( GetTrainedUnitType() == 'h9Zz' ) ) then
        return true
    endif
    return false
endfunction

function Trig_OilReturnForHumanDestroyer_Conditions takes nothing returns boolean
    if ( not Trig_OilReturnForHumanDestroyer_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_OilReturnForHumanDestroyer_Actions takes nothing returns nothing
    call playerAddOil(Player(16) , 700)
endfunction

