    if ( not ( IsQuestCompleted(udg_MQRetakeDunModr) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BaseDestroyed_Defeat_Func005001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_BaseDestroyed_Defeat_Func005001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_BaseDestroyed_Defeat_Func005001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_BaseDestroyed_Defeat_Func005A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerDefeatCondition)
endfunction

function Trig_BaseDestroyed_Defeat_Func008001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_BaseDestroyed_Defeat_Func008001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_BaseDestroyed_Defeat_Func008001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_BaseDestroyed_Defeat_Func008A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerDefeatCondition)
endfunction

function Trig_BaseDestroyed_Defeat_Func010C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_PlayerDefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BaseDestroyed_Defeat_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_PlayerDefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_BaseDestroyed_Defeat_Func005001002)), function Trig_BaseDestroyed_Defeat_Func005A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_BaseDestroyed_Defeat_Func008001002)), function Trig_BaseDestroyed_Defeat_Func008A)
    // //
    if ( Trig_BaseDestroyed_Defeat_Func010C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QuestSetFailedBJ(udg_MQTolBarad, true)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_MISSIONFAILED, "TRIGSTR_4039")
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
        call TriggerSleepAction(1.00)
        call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_4038")
    else
    endif
    // //
    call GroupClear(udg_Group_PlayerDefeatCondition)
    // //
endfunction

