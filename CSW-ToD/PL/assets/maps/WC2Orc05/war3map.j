function InitTrig_AI_P06_Defeated takes nothing returns nothing
    set gg_trg_AI_P06_Defeated=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AI_P06_Defeated, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AI_P06_Defeated, Condition(function Trig_AI_P06_Defeated_Conditions))
    call TriggerAddAction(gg_trg_AI_P06_Defeated, function Trig_AI_P06_Defeated_Actions)
