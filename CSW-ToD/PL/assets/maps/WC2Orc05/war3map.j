endfunction

function Trig_Catapult_Cinematic_Setup_Func013001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o60P' )
endfunction

function Trig_Catapult_Cinematic_Setup_Func013A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Catapult_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call SetDoodadAnimationRectBJ("stand", 'D64K', gg_rct_WallpaperDoodad)
    // HidePlayer1Units
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Catapult_Cinematic_Setup_Func005001002)), function Trig_Catapult_Cinematic_Setup_Func005A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Catapult_Cinematic_Setup_Func007001002)), function Trig_Catapult_Cinematic_Setup_Func007A)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Catapult_Cinematic_Setup_Func008A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Catapult01Fix, Condition(function Trig_Catapult_Cinematic_Setup_Func011001002)), function Trig_Catapult_Cinematic_Setup_Func011A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Catapult02Fix, Condition(function Trig_Catapult_Cinematic_Setup_Func013001002)), function Trig_Catapult_Cinematic_Setup_Func013A)
    // ///
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=2
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call ShowUnitShow(udg_Unit_CatapultsArr[GetForLoopIndexA()])
        call PauseUnitBJ(false, udg_Unit_CatapultsArr[GetForLoopIndexA()])
        call SetUnitMoveSpeed(udg_Unit_CatapultsArr[GetForLoopIndexA()], 190.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitPositionLocFacingBJ(udg_Unit_CatapultsArr[1], GetRectCenter(gg_rct_Catapult01Fix), 44.42)
    call SetUnitPositionLocFacingBJ(udg_Unit_CatapultsArr[2], GetRectCenter(gg_rct_Catapult02Fix), 17.57)
    // ///
    call ResetUnitAnimation(gg_unit_o61Y_0066)
    call ResetUnitAnimation(gg_unit_o61Y_0067)
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_CatapultCinZuluhed001), 113.79)
    call SetUnitOwner(udg_FakeZuluhed, udg_Player_DragonmawCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_CatapultCinMaim01), 108.27)
    call SetUnitOwner(udg_FakeMaim, udg_Player_BTGCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMaim)
    call SetUnitMoveSpeed(udg_FakeMaim, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // ///
    call ShowUnitHide(udg_SemiHero_Utok)
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokScribesHere), 315.00)
    call SetUnitOwner(udg_FakeUtok, udg_Player_Actual, false)
    call SetUnitColor(udg_FakeUtok, PLAYER_COLOR_RED)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // ///
endfunction

