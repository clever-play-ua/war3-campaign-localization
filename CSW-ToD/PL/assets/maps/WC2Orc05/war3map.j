    set gg_trg_North_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_North_Cinematic_Q, function Trig_North_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: North Cinematic Setup
//===========================================================================
function Trig_North_Cinematic_Setup_Func008001002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_North_Cinematic_Setup_Func008A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_North_Cinematic_Setup_Func010A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_North_Cinematic_Setup_Func012A takes nothing returns nothing
    call SetItemVisibleBJ(false, GetEnumItem())
endfunction

function Trig_North_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // ///
    // ///
    // HidePlayer1Units
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_North_Cinematic_Setup_Func008001002)), function Trig_North_Cinematic_Setup_Func008A)
    // ///
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_North_Cinematic_Setup_Func010A)
    // ///
    call EnumItemsInRectBJ(gg_rct_HideCinItems, function Trig_North_Cinematic_Setup_Func012A)
    // ///
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_MidCinZuluhedChill), 292.64)
    call SetUnitOwner(udg_FakeZuluhed, udg_Player_DragonmawCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_MidCinRend01), 292.64)
    call SetUnitOwner(udg_FakeMaim, udg_Player_BTGCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMaim)
    call SetUnitMoveSpeed(udg_FakeMaim, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_MidCinUtok01), bj_UNIT_FACING)
    call SetUnitOwner(udg_FakeUtok, udg_Player_BlackRockCinematic, false)
    call SetUnitColor(udg_FakeUtok, PLAYER_COLOR_RED)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // ///
    // ///
    call SetItemVisibleBJ(false, gg_item_I603_0319)
    call SetItemVisibleBJ(false, gg_item_I603_0324)
endfunction

//===========================================================================
function InitTrig_North_Cinematic_Setup takes nothing returns nothing
    set gg_trg_North_Cinematic_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_North_Cinematic_Setup, function Trig_North_Cinematic_Setup_Actions)
endfunction

