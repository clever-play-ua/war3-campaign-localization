//===========================================================================
function Trig_AI_P17_Attacker_Being_Attacked_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetAttacker()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttackedUnitBJ()) == 'h9Zz' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P17_Attacker_Being_Attacked_Func004Func001Func002A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, 410)
endfunction

function Trig_AI_P17_Attacker_Being_Attacked_Func004Func001Func004A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, - 2147483238)
endfunction

function Trig_AI_P17_Attacker_Being_Attacked_Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_ANCIENT) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P17_Attacker_Being_Attacked_Func004Func003A takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(GetEnumUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)
endfunction

function Trig_AI_P17_Attacker_Being_Attacked_Func004Func005A takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(GetEnumUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
endfunction

function Trig_AI_P17_Attacker_Being_Attacked_Func004C takes nothing returns boolean
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_FLYING) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P17_Attacker_Being_Attacked_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_AI_P17_Attacker_Being_Attacked_Func004C() ) then
        call ForGroupBJ(udg_G_P17_Attacker, function Trig_AI_P17_Attacker_Being_Attacked_Func004Func003A)
        call TriggerSleepAction(6.00)
        call ForGroupBJ(udg_G_P17_Attacker, function Trig_AI_P17_Attacker_Being_Attacked_Func004Func005A)
    else
        if ( Trig_AI_P17_Attacker_Being_Attacked_Func004Func001C() ) then
            call ForGroupBJ(udg_G_P17_Attacker, function Trig_AI_P17_Attacker_Being_Attacked_Func004Func001Func002A)
            call TriggerSleepAction(6.00)
            call ForGroupBJ(udg_G_P17_Attacker, function Trig_AI_P17_Attacker_Being_Attacked_Func004Func001Func004A)
        else
        endif
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction

