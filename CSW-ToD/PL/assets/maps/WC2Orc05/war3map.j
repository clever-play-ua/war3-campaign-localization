function Trig_Init_02_Units_Actions takes nothing returns nothing
    // ///
    // RemoveDummies
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(23)), function Trig_Init_02_Units_Func004002)
    // ///
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 15.00)
    call EnableCreepSleepBJ(false)
    // ///
    // ShareVision
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_BlackToothGrinCamp, udg_Player_BTGCinematic), function Trig_Init_02_Units_Func012002)
    // ///
    // Player21 cannot be killed for a while
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_BlackToothGrinCamp, udg_Player_BTGCinematic), function Trig_Init_02_Units_Func016002)
    // ///
    call ForGroupBJ(udg_Group_BTGInvulnerableActors, function Trig_Init_02_Units_Func018002)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_DragonmawCinematic, Condition(function Trig_Init_02_Units_Func021001002)), function Trig_Init_02_Units_Func021A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_DragonmawCinematic, Condition(function Trig_Init_02_Units_Func023001002)), function Trig_Init_02_Units_Func023A)
    // ///
    // Water Elementals
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_WaterElementals, udg_Player_Elementals), function Trig_Init_02_Units_Func028A)
    // ///
    // WindElementals
    // ///
    call ShowUnitHide(gg_unit_n02Q_0147)
    call PauseUnitBJ(true, gg_unit_n02Q_0147)
    call ShowUnitHide(gg_unit_n02Q_0148)
    call PauseUnitBJ(true, gg_unit_n02Q_0148)
    call ShowUnitHide(gg_unit_n02Q_0149)
    call PauseUnitBJ(true, gg_unit_n02Q_0149)
    // ///
    // GolemsSleeping
    // ///
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_EarthRune01), "units\\creeps\\MossGolem\\MossGolem.mdl")
    set udg_SE_GolemArr[1]=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectYaw(udg_SE_GolemArr[1], 270.00)
    call BlzSetSpecialEffectColorByPlayer(udg_SE_GolemArr[1], Player(PLAYER_NEUTRAL_AGGRESSIVE))
    call BlzPlaySpecialEffect(udg_SE_GolemArr[1], ANIM_TYPE_SLEEP)
    // ///
    set udg_Unit_EarthGolem01=gg_unit_n02X_0132
    call SetUnitPositionLoc(udg_Unit_EarthGolem01, GetRectCenter(gg_rct_EarthRune01))
    call SetUnitAnimation(udg_Unit_EarthGolem01, "sleep")
    call ShowUnitHide(udg_Unit_EarthGolem01)
    // ///
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_EarthRune02), "units\\creeps\\DefenderGolem\\DefenderGolem.mdl")
    set udg_SE_GolemArr[2]=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectYaw(udg_SE_GolemArr[2], 270.00)
    call BlzSetSpecialEffectColorByPlayer(udg_SE_GolemArr[2], Player(PLAYER_NEUTRAL_AGGRESSIVE))
    call BlzPlaySpecialEffect(udg_SE_GolemArr[2], ANIM_TYPE_SLEEP)
    // ///
    set udg_Unit_EarthGolem02=gg_unit_n02W_0081
    call SetUnitPositionLoc(udg_Unit_EarthGolem02, GetRectCenter(gg_rct_EarthRune02))
    call SetUnitAnimation(udg_Unit_EarthGolem02, "sleep")
    call ShowUnitHide(udg_Unit_EarthGolem02)
    // ///
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_EarthRune03), "units\\creeps\\GuardianGolem\\GuardianGolem.mdl")
    set udg_SE_GolemArr[3]=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectYaw(udg_SE_GolemArr[3], 270.00)
    call BlzSetSpecialEffectColorByPlayer(udg_SE_GolemArr[3], Player(PLAYER_NEUTRAL_AGGRESSIVE))
    call BlzPlaySpecialEffect(udg_SE_GolemArr[3], ANIM_TYPE_SLEEP)
    // ///
    set udg_Unit_EarthGolem03=gg_unit_n02V_0186
    call SetUnitPositionLoc(udg_Unit_EarthGolem03, GetRectCenter(gg_rct_EarthRune03))
    call SetUnitAnimation(udg_Unit_EarthGolem03, "sleep")
    call ShowUnitHide(udg_Unit_EarthGolem03)
    // ///
    set udg_Unit_EarthGolem04=gg_unit_emtg_0331
    call SetUnitAnimation(udg_Unit_EarthGolem04, "death")
    call ShowUnitHide(udg_Unit_EarthGolem04)
    // ///
    // WoundedGrunts
    // ///
    call SetUnitAnimation(gg_unit_o60G_0040, "cinematic injured one")
    call SetUnitAnimation(gg_unit_o619_0015, "cinematic injured two")
    call SetUnitAnimation(gg_unit_o60G_0125, "cinematic injured one")
    call SetUnitAnimation(gg_unit_o60G_0326, "cinematic injured two")
    // ///
    // WorkinPeons
    // ///
    call SetUnitAnimation(gg_unit_o61Y_0066, "stand work")
    call SetUnitAnimation(gg_unit_o61Y_0067, "stand work")
    // ///
    // Catapults
    // ///
    set udg_Unit_CatapultsArr[1]=gg_unit_o60P_0038
    set udg_Unit_CatapultsArr[2]=gg_unit_o60P_0039
    call ShowUnitHide(udg_Unit_CatapultsArr[1])
    call ShowUnitHide(udg_Unit_CatapultsArr[2])
    call PauseUnitBJ(true, udg_Unit_CatapultsArr[1])
    call PauseUnitBJ(true, udg_Unit_CatapultsArr[2])
    // ///
    // Construction
    call SetUnitTimeScalePercent(gg_unit_oC51_0041, 10.00)
    call SetUnitAnimation(gg_unit_oC51_0041, "birth")
    // ///
    call SetUnitTimeScalePercent(gg_unit_o60V_0029, 10.00)
    call SetUnitAnimation(gg_unit_o60V_0029, "birth")
    // ///
    call SetUnitTimeScalePercent(gg_unit_o60X_0005, 10.00)
    call SetUnitAnimation(gg_unit_o60X_0005, "birth")
    // ///
    call SetUnitTimeScalePercent(gg_unit_o60X_0006, 10.00)
    call SetUnitAnimation(gg_unit_o60X_0006, "birth")
    // ///
    // DwarvesAmbush
    // ///
    call GroupAddUnitSimple(gg_unit_dIMn_0022, udg_Group_DwarvenAmbush)
    call GroupAddUnitSimple(gg_unit_dIMn_0023, udg_Group_DwarvenAmbush)
    call GroupAddUnitSimple(gg_unit_dIMn_0021, udg_Group_DwarvenAmbush)
    call GroupAddUnitSimple(gg_unit_dIMn_0203, udg_Group_DwarvenAmbush)
    call GroupAddUnitSimple(gg_unit_dIMn_0010, udg_Group_DwarvenAmbush)
    call GroupAddUnitSimple(gg_unit_dIMn_0191, udg_Group_DwarvenAmbush)
    // ///
    call ForGroupBJ(udg_Group_DwarvenAmbush, function Trig_Init_02_Units_Func121A)
    // ///
    // DrunkDwarves
    // ///
    call SetUnitAnimation(gg_unit_dIMn_0196, "sleep")
    call PauseUnitBJ(true, gg_unit_dIMn_0196)
    call AddSpecialEffectTargetUnitBJ("overhead", gg_unit_dIMn_0196, "Abilities\\Spells\\Other\\StrongDrink\\BrewmasterTarget.mdl")
    set udg_SE_DrunkenGazeArr[1]=GetLastCreatedEffectBJ()
    // ///
    call SetUnitAnimation(gg_unit_dIMn_0195, "sleep")
    call PauseUnitBJ(true, gg_unit_dIMn_0195)
    call AddSpecialEffectTargetUnitBJ("overhead", gg_unit_dIMn_0195, "Abilities\\Spells\\Other\\StrongDrink\\BrewmasterTarget.mdl")
    set udg_SE_DrunkenGazeArr[2]=GetLastCreatedEffectBJ()
    // ///
    call SetUnitAnimation(gg_unit_dIMn_0197, "sleep")
    call PauseUnitBJ(true, gg_unit_dIMn_0197)
    call AddSpecialEffectTargetUnitBJ("overhead", gg_unit_dIMn_0197, "Abilities\\Spells\\Other\\StrongDrink\\BrewmasterTarget.mdl")
    set udg_SE_DrunkenGazeArr[3]=GetLastCreatedEffectBJ()
    // ///
    call SetUnitAnimation(gg_unit_dIMn_0194, "sleep")
    call PauseUnitBJ(true, gg_unit_dIMn_0194)
    call AddSpecialEffectTargetUnitBJ("overhead", gg_unit_dIMn_0194, "Abilities\\Spells\\Other\\StrongDrink\\BrewmasterTarget.mdl")
    set udg_SE_DrunkenGazeArr[4]=GetLastCreatedEffectBJ()
    // ///
    call SetUnitAnimation(gg_unit_dIMn_0193, "sleep")
    call PauseUnitBJ(true, gg_unit_dIMn_0193)
    call AddSpecialEffectTargetUnitBJ("overhead", gg_unit_dIMn_0193, "Abilities\\Spells\\Other\\StrongDrink\\BrewmasterTarget.mdl")
    set udg_SE_DrunkenGazeArr[5]=GetLastCreatedEffectBJ()
    // ///
    // Bogs
    // ///
    call PauseUnitBJ(true, gg_unit_njga_0162)
    call SetUnitAnimation(gg_unit_njga_0162, "attack slam 2")
    call SetDestructableAnimationBJ(gg_dest_B01K_9094, "attack slam 2")
    // ///
    call PauseUnitBJ(true, gg_unit_njg1_0161)
    call SetDestructableAnimationBJ(gg_dest_B01L_9095, "attack slam 2")
    // ///
    call SetUnitAnimation(gg_unit_njg1_0161, "attack slam 2")
    // ///
    call SetUnitTimeScalePercent(gg_unit_njga_0162, 0.00)
    call SetDestAnimationSpeedPercent(gg_dest_B01K_9094, 0.00)
    call ShowUnitHide(gg_unit_njga_0162)
    // ///
    call SetUnitTimeScalePercent(gg_unit_njg1_0161, 0.00)
    call SetDestAnimationSpeedPercent(gg_dest_B01L_9095, 0.00)
    call ShowUnitHide(gg_unit_njg1_0161)
    // ///
    // Hide Dwarves
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_DwarvenCamp, udg_Player_Dwarves), function Trig_Init_02_Units_Func172A)
    // ///
    call ForGroupBJ(udg_Group_HiddenDwarves, function Trig_Init_02_Units_Func174002)
    call ForGroupBJ(udg_Group_HiddenDwarves, function Trig_Init_02_Units_Func175002)
    // ///
    // Hide Wolves
    // ///
    call ShowUnitHide(gg_unit_nwlt_0188)
    call ShowUnitHide(gg_unit_nwlg_0087)
    call ShowUnitHide(gg_unit_nwlt_0135)
    call ShowUnitHide(gg_unit_nwld_0189)
    // ///
    // ///
    // Busy Peon
    call BlzSetUnitName(gg_unit_o61Y_0068, BlzGetItemExtendedTooltip(gg_item_IQL2_0216))
    // ///
    // CannonsHoldPosition
    // ///
    call IssueImmediateOrderBJ(gg_unit_hCan_0352, "holdposition")
    call IssueImmediateOrderBJ(gg_unit_hCan_0354, "holdposition")
    call IssueImmediateOrderBJ(gg_unit_hCan_0353, "holdposition")
    call IssueImmediateOrderBJ(gg_unit_hCan_0361, "holdposition")
    call IssueImmediateOrderBJ(gg_unit_hCan_0327, "holdposition")
    call IssueImmediateOrderBJ(gg_unit_hBaL_0214, "holdposition")
    call IssueImmediateOrderBJ(gg_unit_hBaL_0108, "holdposition")
    // ///
    // Duke
    set udg_Hero_DukeBaradin=gg_unit_H00D_0329
    call BlzUnitDisableAbility(udg_Hero_DukeBaradin, 'AIad', true, true)
    // ///
    // This stronghold is for Player access to techtree when in the cinematic the player Black Rock (5) builds the goblin lab
    call ShowUnitHide(gg_unit_o613_0489)
    // ///
    // Slaughterhouse is used as cinematic scenery
    call ShowUnitHide(gg_unit_u004_0497)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_FinalCinFires, Player(PLAYER_NEUTRAL_PASSIVE)), function Trig_Init_02_Units_Func209002)
    // ///
    call ForGroupBJ(udg_Group_HangedTeam, function Trig_Init_02_Units_Func211002)
    call ForGroupBJ(udg_Group_HangedTeam, function Trig_Init_02_Units_Func212002)
    call ForGroupBJ(udg_Group_HangedTeam, function Trig_Init_02_Units_Func213002)
    call ForGroupBJ(udg_Group_HangedTeam, function Trig_Init_02_Units_Func214002)
    // ///
    // HideDuke
    call ShowUnitHide(udg_Hero_DukeBaradin)
    call PauseUnitBJ(true, udg_Hero_DukeBaradin)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_BossUnits, Condition(function Trig_Init_02_Units_Func221001002)), function Trig_Init_02_Units_Func221A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_BossUnits, Condition(function Trig_Init_02_Units_Func224001002)), function Trig_Init_02_Units_Func224A)
    // ///
    call RemoveGuardPosition(gg_unit_hCan_0509)
    call PauseUnitBJ(true, gg_unit_hCan_0509)
    call ShowUnitHide(gg_unit_hCan_0509)
    // ///
    call RemoveGuardPosition(gg_unit_hCan_0258)
    call PauseUnitBJ(true, gg_unit_hCan_0258)
    call ShowUnitHide(gg_unit_hCan_0258)
    // ///
    call SetUnitAnimation(gg_unit_nC2M_0370, "death alternate")
    call ShowUnitHide(gg_unit_nC2M_0370)
    call ShowUnitHide(gg_unit_nC1M_0369)
    // ///
    // Hardworking Peon
    // ///
    set udg_Unit_BusyPeon=gg_unit_o61Y_0068
    set udg_Region_BusyPeon[1]=gg_rct_CrazyPeon01
    set udg_Region_BusyPeon[2]=gg_rct_CrazyPeon02
    set udg_Region_BusyPeon[3]=gg_rct_CrazyPeon03
    set udg_Region_BusyPeon[4]=gg_rct_CrazyPeon04
    // ///
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Point_BusyPeonTarget[GetForLoopIndexA()]=GetRectCenter(udg_Region_BusyPeon[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // ///
    // ///
    set udg_Unit_VisibilityController[1]=gg_unit_h00C_0307
    set udg_Unit_VisibilityController[2]=gg_unit_h00C_0308
    set udg_Unit_VisibilityController[3]=gg_unit_h00C_0309
    set udg_Unit_VisibilityController[4]=gg_unit_h00C_0310
    set udg_Unit_VisibilityController[5]=gg_unit_h00C_0306
    set udg_Unit_VisibilityController[6]=gg_unit_h00C_0304
    set udg_Unit_VisibilityController[7]=gg_unit_h00C_0305
    set udg_Unit_VisibilityController[8]=gg_unit_h00C_0320
    set udg_Unit_VisibilityController[9]=gg_unit_h00C_0302
    set udg_Unit_VisibilityController[10]=gg_unit_h00C_0303
    set udg_Unit_VisibilityController[11]=gg_unit_h00C_0146
    set udg_Unit_VisibilityController[12]=gg_unit_h00C_0312
    set udg_Unit_VisibilityController[13]=gg_unit_h00C_0316
    set udg_Unit_VisibilityController[14]=gg_unit_h00C_0315
    set udg_Unit_VisibilityController[15]=gg_unit_h00C_0313
    set udg_Unit_VisibilityController[16]=gg_unit_h00C_0311
    set udg_Unit_VisibilityController[17]=gg_unit_h00C_0314
    set udg_Unit_VisibilityController[18]=gg_unit_h00C_0512
    // ///
    call ShowUnitHide(gg_unit_nnfm_0297)
    // ///
endfunction

