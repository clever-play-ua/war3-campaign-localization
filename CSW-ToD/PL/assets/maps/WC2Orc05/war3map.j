//===========================================================================
function Trig_Intro_Cinematic_Ship01Unload_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == gg_unit_o60Q_0031 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Ship01Unload_Func005001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Ship01Unload_Func009001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Ship01Unload_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call StopSoundBJ(gg_snd_CS_Orc2x_Theramore_intro_Boats, true)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(gg_unit_o60Q_0031, 46.39, 0.50)
    call PlaySoundAtPointBJ(gg_snd_Dock, 80.00, GetRectCenter(gg_rct_IntroTransportUnload01), 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
endfunction

