//===========================================================================
// Trigger: Barad GoblinLab
//===========================================================================
function Trig_Barad_GoblinLab_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetConstructedStructure()) == udg_Player_BlackRockCinematic ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'o000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Barad_GoblinLab_Func012001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o000' )
endfunction

function Trig_Barad_GoblinLab_Func012A takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_Barad_GoblinLab_Actions takes nothing returns nothing
    local unit b
    call DisableTrigger(GetTriggeringTrigger())
    set b=GetConstructedStructure()
    call IssuePointOrderLocBJ(udg_Unit_CinGoblinEngineer, "move", GetRectCenter(gg_rct_GoblinCinGoblinFinished))
    call QueuedTriggerAddBJ(gg_trg_Barad_GoblinLab_Hint_Q, true)
    call SetPlayerUnitAvailableBJ('o000', true, udg_Player_Actual)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GoblinLab, Condition(function Trig_Barad_GoblinLab_Func012001002)), function Trig_Barad_GoblinLab_Func012A)
    // //
    call PolledWait(2)
    call SetUnitPathing(udg_Unit_CinGoblinEngineer, false)
    call IssuePointOrderLocBJ(udg_Unit_CinGoblinEngineer, "move", GetRectCenter(gg_rct_GoblinLab))
    call PolledWait(2)
    call RemoveUnit(udg_Unit_CinGoblinEngineer)
    // //
    call RescueUnitBJ(b, udg_Player_Actual, false)
endfunction

