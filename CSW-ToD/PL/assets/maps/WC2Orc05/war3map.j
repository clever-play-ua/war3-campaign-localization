function Trig_Intro_Cinematic_ScopeUtok_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_FakeUtok ) ) then
        return false
    endif
    return true
endfunction

