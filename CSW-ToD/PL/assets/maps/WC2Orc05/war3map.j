function Trig_Intro_Cinematic_DragonmawUnload01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61V_0060, GetRectCenter(gg_rct_UnloadTransport01), GetRectCenter(gg_rct_IntroGrunt03))
    call ShowUnitShow(gg_unit_o61V_0060)
    call IssuePointOrderLocBJ(gg_unit_o61V_0060, "move", GetRectCenter(gg_rct_IntroGrunt03))
    // //
    call PlaySoundAtPointBJ(gg_snd_Loading, 80.00, GetRectCenter(gg_rct_UnloadTransport01), 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPositionLocFacingLocBJ(gg_unit_oWyh_0085, GetRectCenter(gg_rct_UnloadTransport01), GetRectCenter(gg_rct_IntroHunter03))
    call ShowUnitShow(gg_unit_oWyh_0085)
