//===========================================================================
// Trigger: LoadUtok
//===========================================================================
function Trig_LoadUtok_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc04", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_LoadUtok_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_LoadUtok_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Utok", "WC2Orc04", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_LoadUtok), GetRectCenter(gg_rct_LoadMaim))
        set udg_SemiHero_Utok=GetLastRestoredUnitBJ()
        call SetPlayerTechResearchedSwap('RUX2', GetStoredIntegerBJ("UtokLevel", "WC2Orc04", udg_Cache), udg_Player_Actual)
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_LoadUtok), GetRectCenter(gg_rct_LoadMaim))
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call SetPlayerTechResearchedSwap('RUX2', 4, udg_Player_Actual)
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_UtokLevelChecker)
    // //
    call SetUnitOwner(udg_SemiHero_Utok, udg_Player_BlackRockCinematic, true)
    call SetUnitBlendTimeBJ(udg_SemiHero_Utok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_SemiHero_Utok)
    call SetUnitMoveSpeed(udg_SemiHero_Utok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_SemiHero_Utok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call ShowUnitHide(udg_SemiHero_Utok)
    call SetUnitInvulnerable(udg_SemiHero_Utok, true)
endfunction

