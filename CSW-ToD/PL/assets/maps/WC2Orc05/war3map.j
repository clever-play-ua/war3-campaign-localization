    set gg_trg_Catapult_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Catapult_Cinematic_Cleanup, function Trig_Catapult_Cinematic_Cleanup_Actions)
endfunction

