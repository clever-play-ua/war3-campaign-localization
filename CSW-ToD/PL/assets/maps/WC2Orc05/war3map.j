endfunction

function Trig_RetakeN_PitTrap01_Func027A takes nothing returns nothing
    call UnitDamageTarget(null, GetEnumUnit(), 10.0, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, null)
    call AddSpecialEffectTargetUnitBJ("chest", GetEnumUnit(), "Objects\\Spawnmodels\\Other\\BeastmasterBlood\\BeastmasterBlood.mdl")
    call PlaySoundOnUnitBJ(gg_snd_GruntDeath5, 80.00, GetEnumUnit())
endfunction

function Trig_RetakeN_PitTrap01_Func031A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_RetakeN_PitTrap01_Func037Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B019' ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeN_PitTrap01_Func037A takes nothing returns nothing
    if ( Trig_RetakeN_PitTrap01_Func037Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

