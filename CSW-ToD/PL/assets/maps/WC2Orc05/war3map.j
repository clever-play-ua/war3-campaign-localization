    call QueueUnitAnimationBJ(GetEnumUnit(), "stand")
endfunction

function Trig_RetakeN_WaterElementals_TakeItem_Func016A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_RetakeN_WaterElementals_TakeItem_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_RetakeN_WaterElementalDies01)
    call EnableTrigger(gg_trg_RetakeN_WaterElementalDies02)
    call EnableTrigger(gg_trg_RetakeN_WaterElementalDies03)
    call EnableTrigger(gg_trg_RetakeN_WaterElementalDies04)
    call EnableTrigger(gg_trg_RetakeN_WaterElementalDies05)
    call EnableTrigger(gg_trg_RetakeN_WaterElementalDies06)
    call EnableTrigger(gg_trg_RetakeN_WaterElementalDies07)
    call EnableTrigger(gg_trg_RetakeN_WaterElementalDies08)
    call EnumDestructablesInRectAll(gg_rct_WaterElementals, function Trig_RetakeN_WaterElementals_TakeItem_Func011A)
    call PolledWait(1.00)
    call SetUnitPositionLoc(gg_unit_hwt3_0137, GetRectCenter(gg_rct_CratorMain))
    call ForGroupBJ(udg_Group_WaterElementals, function Trig_RetakeN_WaterElementals_TakeItem_Func014A)
    call PolledWait(1.07)
    call ForGroupBJ(udg_Group_WaterElementals, function Trig_RetakeN_WaterElementals_TakeItem_Func016A)
    call PolledWait(1.00)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_CratorMain), 270.00, 1, 0)
    call EnableTrigger(gg_trg_RetakeN_WaterElementals_ManaWell)
endfunction

