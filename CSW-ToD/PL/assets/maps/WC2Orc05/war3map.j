    return ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual )
endfunction

function Trig_RetakeN_PitTrap01_Func010001002002 takes nothing returns boolean
    return ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true )
endfunction

function Trig_RetakeN_PitTrap01_Func010001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual), (IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true)) // INLINED!!
endfunction

