//===========================================================================
// Trigger: RetakeN HealGrunt01
//===========================================================================
function Trig_RetakeN_HealGrunt01_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00R' ) ) then
        return false
    endif
    if ( not ( GetSpellTargetUnit() == gg_unit_o60G_0040 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeN_HealGrunt01_Func010C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_RetakeN_HealGrunt02) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeN_HealGrunt01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(0.50)
    call ResetUnitAnimation(gg_unit_o60G_0040)
    call RescueUnitBJ(gg_unit_o60G_0040, Player(0), false)
    call SetUnitBlendTimeBJ(gg_unit_o60G_0040, 0.15)
    call SetUnitInvulnerable(gg_unit_o60G_0040, false)
    if ( Trig_RetakeN_HealGrunt01_Func010C() ) then
        call TriggerExecute(gg_trg_RetakeN_HealGrunt02)
    else
    endif
endfunction

//===========================================================================
function InitTrig_RetakeN_HealGrunt01 takes nothing returns nothing
    set gg_trg_RetakeN_HealGrunt01=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_RetakeN_HealGrunt01, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_RetakeN_HealGrunt01, Condition(function Trig_RetakeN_HealGrunt01_Conditions))
    call TriggerAddAction(gg_trg_RetakeN_HealGrunt01, function Trig_RetakeN_HealGrunt01_Actions)
endfunction

