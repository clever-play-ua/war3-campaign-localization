function Trig_North_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinNorthOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_North_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinNorthSkipped=true
    call ConditionalTriggerExecute(gg_trg_North_Cinematic_Cleanup)
endfunction

