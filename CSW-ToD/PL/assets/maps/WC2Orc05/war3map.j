function Trig_Intro_Cinematic_ScopeUtok_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_FakeUtok, 199.68, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.50)
    call SetUnitAnimation(udg_FakeUtok, "cinematic scope one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic scope one")
endfunction

