    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Goblin_Cinematic_Setup_Func008001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Goblin_Cinematic_Setup_Func008002 takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_MoveTroopsHere))
endfunction

function Trig_Goblin_Cinematic_Setup_Func011002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Goblin_Cinematic_Setup_Func014001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

