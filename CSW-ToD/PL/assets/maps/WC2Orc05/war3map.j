        call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_Actual, udg_Player_BTGCinematic, 'o60G', GetCameraTargetPositionLoc(), gg_snd_WC2Orc05GruntRescue1, bj_TIMETYPE_ADD, 0, true)
