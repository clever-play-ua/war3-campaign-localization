    if ( not ( udg_Zuluhed_Chance == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuluhed_I_Call_of_the_Elements_Func009C takes nothing returns boolean
    if ( not ( udg_Zuluhed_Chance == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuluhed_I_Call_of_the_Elements_Actions takes nothing returns nothing
    set udg_Zuluhed_Chance=GetRandomInt(1, 4)
    set udg_Zuluhed_TempPoint_R=GetSpellTargetLoc()
    //  
    // Dummy (Spells)
    call CreateNUnitsAtLoc(1, 'u003', GetTriggerPlayer(), udg_Zuluhed_TempPoint_R, bj_UNIT_FACING)
    set udg_Zuluhed_Dummy_R=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_Zuluhed_Dummy_R)
    //  
    if ( Trig_Zuluhed_I_Call_of_the_Elements_Func009C() ) then
        // Ability: Summon Fire Elemental (Zuluhed)
        call UnitAddAbilityBJ('XZA4', udg_Zuluhed_Dummy_R)
    else
        if ( Trig_Zuluhed_I_Call_of_the_Elements_Func009Func002C() ) then
            // Ability: Summon Water Elemental (Zuluhed)
            call UnitAddAbilityBJ('XZA1', udg_Zuluhed_Dummy_R)
        else
            if ( Trig_Zuluhed_I_Call_of_the_Elements_Func009Func002Func002C() ) then
                // Ability: Summon Earth Elemental (Zuluhed)
                call UnitAddAbilityBJ('XZA3', udg_Zuluhed_Dummy_R)
            else
                if ( Trig_Zuluhed_I_Call_of_the_Elements_Func009Func002Func002Func002C() ) then
                    // Ability: Summon Air Elemental (Zuluhed)
                    call UnitAddAbilityBJ('XZA2', udg_Zuluhed_Dummy_R)
                else
                endif
            endif
        endif
    endif
    call IssuePointOrderLocBJ(udg_Zuluhed_Dummy_R, "ward", udg_Zuluhed_TempPoint_R)
    //  
    call RemoveLocation(udg_Zuluhed_TempPoint_R)
endfunction

