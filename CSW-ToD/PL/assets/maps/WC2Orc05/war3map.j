function Trig_RetakeN_WindElementals_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call AddWeatherEffectSaveLast(gg_rct_WindElementals, 'WOlw')
    set udg_Weather_Wind=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_Wind, true)
    // //
    call QueuedTriggerAddBJ(gg_trg_RetakeN_WindElementals_Q, true)
    // //
    call ShowUnitShow(gg_unit_n02Q_0147)
    call SetUnitAnimation(gg_unit_n02Q_0147, "birth")
    call QueueUnitAnimationBJ(gg_unit_n02Q_0147, "stand")
    // //
    call ShowUnitShow(gg_unit_n02Q_0148)
    call SetUnitAnimation(gg_unit_n02Q_0148, "birth")
    call QueueUnitAnimationBJ(gg_unit_n02Q_0148, "stand")
    // //
    call ShowUnitShow(gg_unit_n02Q_0149)
    call SetUnitAnimation(gg_unit_n02Q_0149, "birth")
    call QueueUnitAnimationBJ(gg_unit_n02Q_0149, "stand")
    // //
    call PolledWait(1.07)
    // //
    call PauseUnitBJ(false, gg_unit_n02Q_0147)
    call PauseUnitBJ(false, gg_unit_n02Q_0148)
    call PauseUnitBJ(false, gg_unit_n02Q_0149)
endfunction

