function Trig_Final_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // ///
    call ClearSelectionForPlayer(udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, GetPlayersAll())
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_TolBarad, udg_Player_StromgardeGA), function Trig_Final_Cinematic_Q_Func014002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_TolBarad, udg_Player_StromgardeDef), function Trig_Final_Cinematic_Q_Func016002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_TolBarad, udg_Player_Actual), function Trig_Final_Cinematic_Q_Func019002)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Final_Cinematic_Q_Func021002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Final_Cinematic_Q_Func022002)
    // //
    call SetDayNightModels("", "")
    call SetTimeOfDay(0.00)
    call UseTimeOfDayBJ(false)
    call SetSkyModel("CSW\\Environment\\Sky\\SpaceSky\\ArathiSkyboxNight.mdx")
    call SetTerrainFogExBJ(0, 0.00, 1500.00, 5.00, 0.00, 0.00, 0.00)
    call AddWeatherEffectSaveLast(gg_rct_FinalCinematicFog, 'FDwl')
    call EnableWeatherEffect(GetLastCreatedWeatherEffect(), true)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final01, udg_Player_Actual, 0)
    // //
    call SetDoodadAnimationRectBJ("stand", 'D6CS', GetPlayableMapRect())
    // //
    call SetDoodadAnimationRectBJ("stand", 'D020', gg_rct_FinalCinHeroes)
    call SetDoodadAnimationRectBJ("stand", 'D020', gg_rct_TorchLight)
    // ///
    call ShowUnitShow(gg_unit_u004_0497)
    call ForGroupBJ(udg_Group_HangedTeam, function Trig_Final_Cinematic_Q_Func040002)
    call ForGroupBJ(udg_Group_HangedTeam, function Trig_Final_Cinematic_Q_Func041002)
    // ///
    call CreateNUnitsAtLoc(1, 'OZaC', udg_Player_DragonmawCinematic, GetRectCenter(gg_rct_FinalZuluhed01), 73.54)
    set udg_FakeZuluhed=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // ///
    call CreateNUnitsAtLoc(1, 'o605', udg_Player_BlackRockCinematic, GetRectCenter(gg_rct_FinalUtok01), 124.95)
    set udg_FakeUtok=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // ///
    call CreateNUnitsAtLoc(1, 'N002', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FinalMaim01), 147.31)
    set udg_FakeMaim=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMaim)
    call SetUnitMoveSpeed(udg_FakeMaim, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // ///
    call CreateNUnitsAtLoc(1, 'o006', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FinalGrun01), 117.31)
    set udg_Unit_OutroCinGrunt=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_Unit_OutroCinGrunt, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_OutroCinGrunt)
    call SetUnitMoveSpeed(udg_Unit_OutroCinGrunt, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_OutroCinGrunt, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_Unit_OutroCinGrunt, "cinematic listening one")
    // ///
    call IssuePointOrderLocBJ(udg_Unit_OutroCinGrunt, "move", GetRectCenter(gg_rct_FinalGrun02))
    // ///
    call PlaySoundBJ(gg_snd_Orc2)
    // ///
    call DisplayTimedTextToForce(udg_PlayerGroup_Actual, 3.00, "TRIGSTR_3939")
    call TriggerSleepAction(6.00)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    // Lit the Fire
    // ///
    set udg_Bool_CinOutroOn=true
    call CameraSetupApplyForPlayer(true, gg_cam_Final02, udg_Player_Actual, 8.00)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_Unit_OutroCinGrunt, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_Unit_OutroCinGrunt, "cinematic listening one")
    // ///
    call SetDoodadAnimationRectBJ("stand", 'YOfs', gg_rct_FinalCinFires)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetDoodadAnimationRectBJ("stand", 'YOf3', gg_rct_FinalCinFires)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetDoodadAnimationRectBJ("stand", 'D020', gg_rct_FinalCinFires)
    call SetDoodadAnimationRectBJ("stand", 'YOtf', gg_rct_FinalCinFires)
    // ///
    call SetUnitAnimation(udg_FakeMaim, "cinematic drink one")
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeMaim, 0.50)
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeZuluhed, 0, 0, 90)
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeZuluhed, 0, gg_snd_WC2Orc05Zuluhed4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeMaim, udg_FakeZuluhed, 0.50)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final03, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc05Maim7))
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic headnod")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_FinalUtok02))
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_FinalUtok02, udg_FakeUtok) == true), (udg_Bool_CinOutroSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeUtok, 0, 0, 90)
    call SetUnitFacingToFaceUnitTimed(udg_FakeMaim, udg_FakeUtok, 1.00)
    call SetUnitLookAt(udg_FakeZuluhed, "bone_head", udg_FakeUtok, 0, 0, 90)
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeUtok, 1.00)
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeUtok, 0, gg_snd_WC2Orc05Utok4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeZuluhed, 0, gg_snd_WC2Orc05Zuluhed5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeMaim, 0.50)
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic idea one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim8, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic salute one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeUtok, 0, gg_snd_WC2Orc05Utok5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ResetUnitLookAt(udg_FakeMaim)
    call ResetUnitLookAt(udg_FakeZuluhed)
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_FinalUtok01))
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call StopSoundBJ(gg_snd_Orc2, true)
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_FinalMaim02))
    call PlaySoundBJ(gg_snd_CS_H01a_Uther_walks_003_LR_v3)
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_FinalUtok01))
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_Cleanup)
endfunction

