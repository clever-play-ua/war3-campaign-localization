function InitTrig_OilSpentForResearchZB takes nothing returns nothing
    set gg_trg_OilSpentForResearchZB=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilSpentForResearchZB, Player(0), EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerAddCondition(gg_trg_OilSpentForResearchZB, Condition(function Trig_OilSpentForResearchZB_Conditions))
