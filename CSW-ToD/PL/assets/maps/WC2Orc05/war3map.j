function InitTrig_HeroDies_Defeat takes nothing returns nothing
    set gg_trg_HeroDies_Defeat=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_HeroDies_Defeat, Player(0), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_HeroDies_Defeat, Condition(function Trig_HeroDies_Defeat_Conditions))
    call TriggerAddAction(gg_trg_HeroDies_Defeat, function Trig_HeroDies_Defeat_Actions)
endfunction

