    endif
    // //
    call SetUnitOwner(udg_Fake_Duke, udg_Player_StromgardeDef, true)
    call SetUnitPositionLoc(udg_Fake_Duke, GetRectCenter(gg_rct_DukeSpawn))
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Duke)
    call SetUnitBlendTimeBJ(udg_Fake_Duke, 0.25)
    call SetUnitMoveSpeed(udg_Fake_Duke, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Duke, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call IssuePointOrderLocBJ(udg_Fake_Duke, "move", GetRectCenter(gg_rct_DukeArrves))
    // //
endfunction

