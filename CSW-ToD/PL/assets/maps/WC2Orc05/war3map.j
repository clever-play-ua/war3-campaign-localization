//===========================================================================
// Trigger: AI P17 Oil
//
// If the enemy player doesnt have oil rigs and its oil reserves less than 700, no sense in continue attacking.
// P 17 Ship construction will be restricted by amount of oil to  prevent difficulty snowballing on later phase of the game
//===========================================================================
function Trig_AI_P17_Oil_Func007A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P17OilRigs)
endfunction

function Trig_AI_P17_Oil_Func015C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P17_Oil_Actions takes nothing returns nothing
    local integer p17OilRigs
    // //
    call GroupClear(udg_Group_P17OilRigs)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_StromgardeNavy, 'u600'), function Trig_AI_P17_Oil_Func007A)
    // //
    set p17OilRigs=CountUnitsInGroup(udg_Group_P17OilRigs)
    // //
    if (OilHarvest___playerOil[GetPlayerId((Player(16)))]) < 700 and p17OilRigs == 0 then // INLINED!!
    call PauseTimerBJ(true, udg_Timer_P17OilChecker)
    call ConditionalTriggerExecute(gg_trg_AI_P17_Stop_Attack_Command)
    call DisableTrigger(gg_trg_OilSpentForHumanDestroyer)
    if ( Trig_AI_P17_Oil_Func015C() ) then
        call DisplayTextToForce(udg_PlayerGroup_Actual, "TRIGSTR_4344")
    else
    endif
    endif
    // //
    call GroupClear(udg_Group_P17OilRigs)
endfunction

//===========================================================================
function InitTrig_AI_P17_Oil takes nothing returns nothing
    set gg_trg_AI_P17_Oil=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_AI_P17_Oil, udg_Timer_P17OilChecker)
    call TriggerAddAction(gg_trg_AI_P17_Oil, function Trig_AI_P17_Oil_Actions)
endfunction

