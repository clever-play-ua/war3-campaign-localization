    set gg_trg_RetakeN_ExplodeBridge01=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_RetakeN_ExplodeBridge01, gg_rct_BridgeExplode01Tripwire)
    call TriggerAddCondition(gg_trg_RetakeN_ExplodeBridge01, Condition(function Trig_RetakeN_ExplodeBridge01_Conditions))
