endfunction

function Trig_Intro_Cinematic_Cleanup_Func092002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), true)
endfunction

function Trig_Intro_Cinematic_Cleanup_Func098002 takes nothing returns nothing
