//===========================================================================
// Trigger: Partisans Completed
//===========================================================================
function Trig_Partisans_Completed_Conditions takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_OQPartisans) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Partisans_Completed_Func004Func001001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Dwarves )
endfunction

function Trig_Partisans_Completed_Func004Func001001001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_Partisans_Completed_Func004Func001001001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Partisans_Completed_Func004Func001001001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Partisans_Completed_Func004Func001001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Dwarves), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_Partisans_Completed_Func004C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_DwarvenCamp, Condition(function Trig_Partisans_Completed_Func004Func001001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Partisans_Completed_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Partisans_Completed_Func004C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QueuedTriggerAddBJ(gg_trg_Partisans_Completed_Q, true)
        call QueuedTriggerAddBJ(gg_trg_UtokLevelUp, true)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Partisans_Completed takes nothing returns nothing
    set gg_trg_Partisans_Completed=CreateTrigger()
    call DisableTrigger(gg_trg_Partisans_Completed)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Partisans_Completed, 2)
    call TriggerAddCondition(gg_trg_Partisans_Completed, Condition(function Trig_Partisans_Completed_Conditions))
    call TriggerAddAction(gg_trg_Partisans_Completed, function Trig_Partisans_Completed_Actions)
endfunction

