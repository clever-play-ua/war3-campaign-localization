//===========================================================================
// Trigger: Init 01 Players
//===========================================================================
function Trig_Init_01_Players_Actions takes nothing returns nothing
    // //
    set udg_PlayerGroup_Actual=bj_FORCE_PLAYER[0]
    // //
    set udg_Player_Actual=Player(0)
    set udg_Player_BlackRockCinematic=Player(4)
    set udg_Player_Dwarves=Player(5)
    set udg_Player_Tavern=Player(8)
    set udg_Player_Elementals=Player(11)
    // //
    set udg_Player_StromgardeGA=Player(12)
    call SetPlayerName(udg_Player_StromgardeGA, "TRIGSTR_4340")
    // //
    set udg_Player_StromgardeDef=Player(17)
    call SetPlayerName(udg_Player_StromgardeDef, "TRIGSTR_4338")
    // //
    set udg_Player_StromgardeNavy=Player(16)
    call SetPlayerName(udg_Player_StromgardeNavy, "TRIGSTR_4339")
    // //
    set udg_Player_BTGCinematic=Player(20)
    set udg_Player_DragonmawCinematic=Player(21)
    // //
    // //
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_3984")
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 2000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 2000)
    call playerAddOil(Player(0) , 2000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_FOOD_CAP, 30)
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Player_Actual)
    // //
    call SetPlayerAbilityAvailableBJ(true, 'XGC1', udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(true, 'A02F', udg_Player_Actual)
    // //
    // Player Colors
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_COAL, true)
    call SetPlayerColorBJ(udg_Player_Elementals, ConvertPlayerColor(24), true)
    call SetPlayerColorBJ(udg_Player_BlackRockCinematic, PLAYER_COLOR_RED, true)
    call SetPlayerColorBJ(udg_Player_StromgardeDef, PLAYER_COLOR_MAROON, true)
    call SetPlayerColorBJ(udg_Player_StromgardeNavy, PLAYER_COLOR_MAROON, true)
    // Alliances
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BlackRockCinematic, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_BlackRockCinematic, udg_Player_Actual, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Tavern, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Tavern, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Elementals, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Elementals, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeGA, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_StromgardeGA, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeGA, udg_Player_StromgardeDef, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDef, udg_Player_StromgardeGA, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StromgardeDef, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDef, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerStateBJ(udg_Player_BlackRockCinematic, PLAYER_STATE_RESOURCE_GOLD, 2000)
    call SetPlayerStateBJ(udg_Player_BlackRockCinematic, PLAYER_STATE_RESOURCE_LUMBER, 2000)
    // //
    call SetPlayerStateBJ(udg_Player_StromgardeGA, PLAYER_STATE_RESOURCE_GOLD, 2000)
    call SetPlayerStateBJ(udg_Player_StromgardeGA, PLAYER_STATE_RESOURCE_LUMBER, 2000)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_06a_Hard)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Normal)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Easy)
    // //
    // //
endfunction

