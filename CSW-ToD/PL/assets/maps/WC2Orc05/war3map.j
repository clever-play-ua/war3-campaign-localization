    call ShowUnitShow(gg_unit_hfSt_0469)
    call IssuePointOrderLocBJ(gg_unit_hfSt_0469, "move", GetRectCenter(gg_rct_DukeArrves))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
