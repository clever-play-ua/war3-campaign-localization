    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == false), (GetUnitTypeId(GetFilterUnit()) != 'u002')) // INLINED!!
endfunction

function Trig_Goblin_Cinematic_Setup_Func014001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == false), (GetUnitTypeId(GetFilterUnit()) != 'u002')))) // INLINED!!
endfunction

function Trig_Goblin_Cinematic_Setup_Func014002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Goblin_Cinematic_Setup_Func016C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Maim) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_Cinematic_Setup_Func017C takes nothing returns boolean
