function InitTrig_Neutral_Smart_Attack takes nothing returns nothing
    set gg_trg_Neutral_Smart_Attack=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Neutral_Smart_Attack, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddCondition(gg_trg_Neutral_Smart_Attack, Condition(function Trig_Neutral_Smart_Attack_Conditions))
    call TriggerAddAction(gg_trg_Neutral_Smart_Attack, function Trig_Neutral_Smart_Attack_Actions)
endfunction

//===========================================================================
// Trigger: NextLevelPrep
//===========================================================================
function Trig_NextLevelPrep_Func006C takes nothing returns boolean
    if ( not ( udg_Bool_3DragonItemsFound == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_NextLevelPrep_Func010C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_NextLevelPrep_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // SaveHeroues
    // cache
    call TriggerSleepAction(0.10)
    // //
    if ( Trig_NextLevelPrep_Func006C() ) then
        call StoreBooleanBJ(true, "ItemDragonAquired", "WC2Orc05", udg_Cache)
    else
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I6DX'))
        // //
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60Q'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60P'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60N'))
        // //
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Maim, 'I60N'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Maim, 'I60P'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Maim, 'I60Q'))
        // //
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60Q'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60P'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60N'))
        // //
        call StoreBooleanBJ(false, "ItemDragonPartsAquired", "WC2Orc05", udg_Cache)
    endif
    // //
    call StoreUnitBJ(udg_Hero_Zuluhed, "Zuluhed", "WC2Orc05", udg_Cache)
    // //
    if ( Trig_NextLevelPrep_Func010C() ) then
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc05", udg_Cache)
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_WindElementals), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call SetUnitColor(udg_SemiHero_Utok, PLAYER_COLOR_RED)
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc05", udg_Cache)
    endif
    // //
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', Player(0)), "UtokLevel", "WC2Orc05", udg_Cache)
    // //
    call StoreUnitBJ(udg_Hero_Maim, "Maim", "WC2Orc05", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc05", udg_Cache)
    call TriggerSleepAction(0.10)
    call SaveGameCacheBJ(udg_Cache)
    // NextLevel
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ShowCustomCampaignButton(true, 8)
    call SetNextLevelBJ("WC2Orc06.w3x")
    call CustomVictoryBJ(udg_Player_Actual, true, true)
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_NextLevelPrep takes nothing returns nothing
    set gg_trg_NextLevelPrep=CreateTrigger()
    call TriggerAddAction(gg_trg_NextLevelPrep, function Trig_NextLevelPrep_Actions)
endfunction

//===========================================================================
// Trigger: Setup Cinematic Frame
//
// Note: this must be called in each cinematic because it gets reset back when loading from a save
//===========================================================================
function Trig_Setup_Cinematic_Frame_Actions takes nothing returns nothing
    // Hide portrait during cinematic
    call BlzFrameSetVisible(BlzGetFrameByName("HDCinematicPortraitCover", 0), false)
    // Remove the background by moving it (hiding does not work)
    call BlzFrameClearAllPoints(BlzGetFrameByName("HDCinematicBackground", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.0)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_TOPRIGHT, 0.0, 0.0)
    // Set the cinematic dialogue text rectangle to the bottom center portion of the screen
    call BlzFrameClearAllPoints(BlzGetFrameByName("CinematicDialogueText", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.035)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.075)
    // Set the cinematic speaker text rectangle to the bottom center portion of the screen (above dialogue text)
    call BlzFrameClearAllPoints(BlzGetFrameByName("CinematicSpeakerText", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.085)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.95)
    // Set both cinematic speaker and cinematic dialogue text alignment to center
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicDialogueText", 0), TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicSpeakerText", 0), TEXT_JUSTIFY_BOTTOM, TEXT_JUSTIFY_CENTER)
endfunction

//===========================================================================
function InitTrig_Setup_Cinematic_Frame takes nothing returns nothing
    set gg_trg_Setup_Cinematic_Frame=CreateTrigger()
    call TriggerAddAction(gg_trg_Setup_Cinematic_Frame, function Trig_Setup_Cinematic_Frame_Actions)
endfunction

