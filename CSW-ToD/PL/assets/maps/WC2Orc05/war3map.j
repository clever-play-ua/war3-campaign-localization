function Trig_Intro_Cinematic_Ship02Unload_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(gg_unit_o60Q_0032, 35.96, 0.50)
    call PlaySoundAtPointBJ(gg_snd_Dock, 80.00, GetRectCenter(gg_rct_IntroTransportUnload02), 0)
