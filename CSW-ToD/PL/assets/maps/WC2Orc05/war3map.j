    if ( not GetBooleanOr((GetEnteringUnit() == udg_Hero_Zuluhed), (GetEnteringUnit() == udg_Hero_Maim)) ) then // INLINED!!
        return false
    endif
    return true
endfunction

function Trig_RetakeN_PitTrap01_Func044Func002C takes nothing returns boolean
    if ( not ( udg_Int_PitTrapCountNorth == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeN_PitTrap01_Func044C takes nothing returns boolean
    if ( not ( udg_Int_PitTrapCountNorth == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeN_PitTrap01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TerrainDeformationCraterBJ(1.00, true, GetRectCenter(gg_rct_Trap01Crator), 330.00, 64.00)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_Trap01Crator), 0.50)
    call PolledWait(0.50)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_ItsATrap01, Condition(function Trig_RetakeN_PitTrap01_Func010001002)), function Trig_RetakeN_PitTrap01_Func010A)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Trap01Crator), "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl")
    set udg_SE_DustArr[1]=GetLastCreatedEffectBJ()
    // //
    call PlaySoundAtPointBJ(gg_snd_BlueFireBurst, 100.00, GetRectCenter(gg_rct_Trap01Crator), 0.00)
    // //
    call PolledWait(0.80)
    call PlaySoundOnUnitBJ(gg_snd_MetalHeavySliceFlesh1, 100, GetEnteringUnit())
    // //
    // Damage to Units
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(200.00, GetRectCenter(gg_rct_ItsATrap01), Condition(function Trig_RetakeN_PitTrap01_Func022001003)), function Trig_RetakeN_PitTrap01_Func022A)
    // //
    // Damage to Hero
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_ItsATrap01, Condition(function Trig_RetakeN_PitTrap01_Func027001002)), function Trig_RetakeN_PitTrap01_Func027A)
    // //
    // Unpause
    // //
    call ForGroupBJ(udg_Group_PausedInSpikeTrap, function Trig_RetakeN_PitTrap01_Func031A)
    // //
    call GroupClear(udg_Group_PausedInSpikeTrap)
    // //
    call PolledWait(1.00)
    // //
    call EnumDestructablesInRectAll(gg_rct_ItsATrap01, function Trig_RetakeN_PitTrap01_Func037A)
    call DestroyEffectBJ(udg_SE_DustArr[1])
    // //
    if ( Trig_RetakeN_PitTrap01_Func040C() ) then
        call IssuePointOrderLocBJ(GetEnteringUnit(), "move", GetRandomLocInRect(gg_rct_EscapeTrap01))
    else
    endif
    // ****
    set udg_Int_PitTrapCountNorth=( udg_Int_PitTrapCountNorth + 1 )
    // ****
    if ( Trig_RetakeN_PitTrap01_Func044C() ) then
        call QueuedTriggerAddBJ(gg_trg_RetakeN_PitTrap_Q1, true)
    else
        if ( Trig_RetakeN_PitTrap01_Func044Func002C() ) then
            call QueuedTriggerAddBJ(gg_trg_RetakeN_PitTrap_Q2, true)
        else
            call DoNothing()
        endif
    endif
endfunction

//===========================================================================
