function InitTrig_Barad_GoblinLab takes nothing returns nothing
    set gg_trg_Barad_GoblinLab=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Barad_GoblinLab, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
    call TriggerAddCondition(gg_trg_Barad_GoblinLab, Condition(function Trig_Barad_GoblinLab_Conditions))
