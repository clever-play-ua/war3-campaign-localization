    call TriggerAddCondition(gg_trg_South_Cinematic_Skipped, Condition(function Trig_South_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_South_Cinematic_Skipped, function Trig_South_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: South Cinematic Cleanup
//===========================================================================
function Trig_South_Cinematic_Cleanup_Func004C takes nothing returns boolean
    if ( not ( udg_Bool_CinSouthSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_South_Cinematic_Cleanup_Func009002 takes nothing returns nothing
    call SetItemPositionLoc(GetEnumItem(), GetRandomLocInRect(gg_rct_MoveTroopsHere))
endfunction

function Trig_South_Cinematic_Cleanup_Func011C takes nothing returns boolean
    if ( not ( udg_Bool_CinSouthSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_South_Cinematic_Cleanup_Func021002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_South_Cinematic_Cleanup_Func025002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_South_Cinematic_Cleanup_Func034002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_South_Cinematic_Cleanup_Func035002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_South_Cinematic_Cleanup_Func038A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_South_Cinematic_Cleanup_Func039A takes nothing returns nothing
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_South_Cinematic_Cleanup_Func041A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_South_Cinematic_Cleanup_Func079C takes nothing returns boolean
    if ( not ( udg_Bool_CinSouthSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_South_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinSouthOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_South_Cinematic_Cleanup_Func004C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    // ///
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call RemoveUnit(udg_Unit_CinGrunt)
    call EnumItemsInRectBJ(gg_rct_QMDunModrIcon02, function Trig_South_Cinematic_Cleanup_Func009002)
    // ///
    if ( Trig_South_Cinematic_Cleanup_Func011C() ) then
        call StopSoundBJ(gg_snd_CS_TFT_Orc_01_Intro_MX, false)
        call StopSoundBJ(gg_snd_WC2Orc05Zuluhed_DunModr1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Utok_WarnTheIsland, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim_LetThemCome1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Grunt1, false)
    else
    endif
    // ///
    // ResetBTGStartingCamp
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_FOOD_CAP, 0)
    call BlzSetUnitName(gg_unit_o61Y_0068, BlzGetItemTooltip(gg_item_IQL2_0216))
    call ResetUnitAnimation(gg_unit_oC51_0041)
    call ResetUnitAnimation(gg_unit_o60X_0006)
    call ResetUnitAnimation(gg_unit_o60X_0005)
    call ResetUnitAnimation(gg_unit_o60X_0042)
    call ResetUnitAnimation(gg_unit_o60V_0029)
    call ForGroupBJ(udg_Group_BTGInvulnerableActors, function Trig_South_Cinematic_Cleanup_Func021002)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61Y_0067, GetRectCenter(gg_rct_PeonMove03), GetRectCenter(gg_rct_PeonMoveOrder03))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61Y_0066, GetRectCenter(gg_rct_PeonMove01), GetRectCenter(gg_rct_PeonMoveOrder01))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61Y_0068, GetRectCenter(gg_rct_PeonMove02), GetRectCenter(gg_rct_PeonMoveOrder02))
    call ForGroupBJ(udg_Group_BTGInitialTroops, function Trig_South_Cinematic_Cleanup_Func025002)
    call DestroyGroup(udg_Group_BTGInitialTroops)
    call IssuePointOrderLocBJ(gg_unit_o61Y_0068, "move", GetRectCenter(gg_rct_PeonMoveOrder02))
    call IssuePointOrderLocBJ(gg_unit_o61Y_0067, "move", GetRectCenter(gg_rct_PeonMoveOrder03))
    call IssuePointOrderLocBJ(gg_unit_o61Y_0066, "move", GetRectCenter(gg_rct_PeonMoveOrder01))
    // Deactivate Mercenary Camp
    call UnitRemoveAbilityBJ('Ane2', gg_unit_nmr0_0055)
    // Unhide Dwarves and give access to them
    call SetDestructableInvulnerableBJ(gg_dest_B014_2601, false)
    call ForGroupBJ(udg_Group_HiddenDwarves, function Trig_South_Cinematic_Cleanup_Func034002)
    call ForGroupBJ(udg_Group_HiddenDwarves, function Trig_South_Cinematic_Cleanup_Func035002)
    call DestroyGroup(udg_Group_HiddenDwarves)
    // Unhide and Unpause P1 units
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_South_Cinematic_Cleanup_Func038A)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_South_Cinematic_Cleanup_Func039A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_South_Cinematic_Cleanup_Func041A)
    // //
    call SetUnitPositionLoc(udg_SemiHero_Utok, GetRectCenter(gg_rct_MoveUtokHere))
    call ResetUnitLookAt(udg_SemiHero_Utok)
    call UnitRemoveAbilityBJ('Andt', udg_SemiHero_Utok)
    call UnitRemoveAbilityBJ('A01I', udg_SemiHero_Utok)
    call UnitAddAbilityBJ('A642', udg_SemiHero_Utok)
    call UnitAddAbilityBJ('A641', udg_SemiHero_Utok)
    call UnitAddAbilityBJ('Asal', udg_SemiHero_Utok)
    call SetUnitBlendTimeBJ(udg_SemiHero_Utok, 0.15)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_SemiHero_Utok)
    call SetUnitMoveSpeed(udg_SemiHero_Utok, 270.00)
    call BlzSetUnitRealFieldBJ(udg_SemiHero_Utok, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call IssuePointOrderLocBJ(udg_SemiHero_Utok, "move", GetRectCenter(gg_rct_MoveTroopsHere))
    // Give player access to North Camp
    call SetUnitOwner(gg_unit_o60X_0042, udg_Player_Actual, false)
    call SetUnitOwner(gg_unit_o60X_0005, udg_Player_Actual, false)
    call SetUnitOwner(gg_unit_o60X_0006, udg_Player_Actual, false)
    call SetUnitOwner(gg_unit_o603_0045, udg_Player_Actual, false)
    call SetUnitOwner(gg_unit_o603_0046, udg_Player_Actual, false)
    call SetUnitOwner(gg_unit_o603_0048, udg_Player_Actual, false)
    call SetUnitOwner(gg_unit_o603_0049, udg_Player_Actual, false)
    // //
    call RemoveDestructable(gg_dest_YT51_0991)
    call ShowDestructableBJ(true, gg_dest_RW07_1276)
    call DestructableRestoreLife(gg_dest_RW07_1276, GetDestructableMaxLife(gg_dest_RW07_1276), false)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ResetGameCameraDunModr, udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_PeonMoveOrder02), 0.00)
    // ///
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupClear(udg_Group_SelectedUnits)
    // ///
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_South_Cinematic_Cleanup_Func079C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_South_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call ConditionalTriggerExecute(gg_trg_Fortify_Discover)
endfunction

