function Trig_South_Cinematic_Q_Func099001 takes nothing returns boolean
    return ( udg_Bool_CinSouthSkipped == true )
endfunction

function Trig_South_Cinematic_Q_Actions takes nothing returns nothing
    // //
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_South_Cinematic_Q_Func008002)
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_South_Cinematic_Setup)
    call TriggerSleepAction(0.50)
    // //
    call IssuePointOrderLocBJ(udg_Unit_CinGrunt, "move", GetRectCenter(gg_rct_Mid2CinGrunt02))
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr08, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr09, udg_Player_Actual, ( ( DistanceBetweenPoints(GetUnitLoc(udg_Unit_CinGrunt), GetRectCenter(gg_rct_Mid2CinGrunt02)) / GetUnitMoveSpeed(udg_Unit_CinGrunt) ) + GetSoundDurationBJ(gg_snd_WC2Orc05Grunt1) ))
    // ///
    call PlaySoundBJ(gg_snd_CS_TFT_Orc_01_Intro_MX)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    set udg_Bool_CinSouthOn=true
    // ///
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_Mid2CinGrunt02, udg_Unit_CinGrunt) == true), (udg_Bool_CinSouthSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingToFaceUnitTimed(udg_FakeMaim, udg_Unit_CinGrunt, 0.50)
    call SetUnitFacingToFaceUnitTimed(udg_Unit_CinGrunt, udg_FakeMaim, 0.50)
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_Unit_CinGrunt, 0.50)
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_Unit_CinGrunt, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_CinGrunt, "cinematic salute one")
    call QueueUnitAnimationBJ(udg_Unit_CinGrunt, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_Unit_CinGrunt, 0, gg_snd_WC2Orc05Grunt1, bj_TIMETYPE_ADD, 0, true)
    call SetUnitAnimation(udg_Unit_CinGrunt, "cinematic listening one")
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr07, udg_Player_Actual, 0)
    // //
    call IssuePointOrderLocBJ(udg_Unit_CinGrunt, "move", GetRectCenter(gg_rct_Mid2CinGrunt03))
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeMaim, udg_FakeUtok, 0.50)
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeUtok, 0.50)
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeMaim, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeUtok, 0, gg_snd_WC2Orc05Utok_WarnTheIsland, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr09, udg_Player_Actual, 0)
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeMaim, 0.50)
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeMaim, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr10, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc05Maim_LetThemCome1))
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim_LetThemCome1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    // //
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeZuluhed, 0, 0, 90)
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_FakeZuluhed, 0, 0, 90)
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeMaim, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeZuluhed, 0, gg_snd_WC2Orc05Zuluhed_DunModr1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr06, udg_Player_Actual, 0)
    call RemoveUnit(udg_Unit_CinGrunt)
    call ResetUnitLookAt(udg_FakeUtok)
    call ResetUnitLookAt(udg_FakeMaim)
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_MoveTroopsHere))
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_MoveTroopsHere))
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_MoveTroopsHere))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinSouthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_South_Cinematic_Cleanup)
endfunction

