    call ShowUnitShow(gg_unit_hfSt_0470)
    call IssuePointOrderLocBJ(gg_unit_hfSt_0470, "move", GetRectCenter(gg_rct_DukeArrves))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPositionLoc(gg_unit_hfSt_0473, GetRectCenter(gg_rct_DukeSpawn))
    call ShowUnitShow(gg_unit_hfSt_0473)
    call IssuePointOrderLocBJ(gg_unit_hfSt_0473, "move", GetRectCenter(gg_rct_DukeArrves))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPositionLoc(gg_unit_hfSt_0474, GetRectCenter(gg_rct_DukeSpawn))
    call ShowUnitShow(gg_unit_hfSt_0474)
    call IssuePointOrderLocBJ(gg_unit_hfSt_0474, "move", GetRectCenter(gg_rct_DukeArrves))
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDukeSkipped == true) ) then // INLINED!!
