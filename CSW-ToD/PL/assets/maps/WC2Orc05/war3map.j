    set gg_trg_RetakeS_CatapultsAcquired=CreateTrigger()
    call DisableTrigger(gg_trg_RetakeS_CatapultsAcquired)
    call TriggerRegisterTimerEventPeriodic(gg_trg_RetakeS_CatapultsAcquired, 2)
    call TriggerAddCondition(gg_trg_RetakeS_CatapultsAcquired, Condition(function Trig_RetakeS_CatapultsAcquired_Conditions))
