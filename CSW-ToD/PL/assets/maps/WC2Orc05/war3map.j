//===========================================================================
// Trigger: RetakeN ExplodeBridge01
//===========================================================================
function Trig_RetakeN_ExplodeBridge01_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeN_ExplodeBridge01_Func012A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_RetakeN_ExplodeBridge01_Func015A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_RetakeN_ExplodeBridge01_Func030Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeN_ExplodeBridge01_Func030A takes nothing returns nothing
    if ( Trig_RetakeN_ExplodeBridge01_Func030Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_RetakeN_ExplodeBridge01_Func035001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_EEExplode, gg_unit_n60B_0024) == true )
endfunction

function Trig_RetakeN_ExplodeBridge01_Func053Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeN_ExplodeBridge01_Func053A takes nothing returns nothing
    if ( Trig_RetakeN_ExplodeBridge01_Func053Func001C() ) then
        call DestructableRestoreLife(GetEnumDestructable(), 9999.00, false)
    else
    endif
endfunction

function Trig_RetakeN_ExplodeBridge01_Func057A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_RetakeN_ExplodeBridge01_Func060A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_RetakeN_ExplodeBridge01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Set Visibility Modifier
    call UnitShareVisionBJ(true, gg_unit_n60B_0024, Player(0))
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_RevealBridge01), 1024.00)
    set udg_VisMod_Bridge01=GetLastCreatedFogModifier()
    // Pause Units
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_RetakeN_ExplodeBridge01_Func012A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_RetakeN_ExplodeBridge01_Func015A)
    // //
    // UnlockRiverVisibility
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_RiverVisibilityUnlock01)
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_RiverVisibilityUnlock02)
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_RiverVisibilityUnlock03)
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_RiverVisibilityUnlock04)
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_RiverVisibilityUnlock05)
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_RiverVisibilityUnlock06)
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_RiverVisibilityUnlock07)
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_RiverVisibilityUnlock08)
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_RiverVisibilityUnlock09)
    // Pan Camera
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_EEExplode), 1.00)
    call TriggerSleepAction(1.00)
    call EnumDestructablesInRectAll(gg_rct_PBControl, function Trig_RetakeN_ExplodeBridge01_Func030A)
    call PolledWait(0.25)
    // For Khaz Modan!
    call ConditionalTriggerExecute(gg_trg_RetakeN_ExplodeBridge01_Q1)
    call IssuePointOrderLocBJ(gg_unit_n60B_0024, "move", GetRectCenter(gg_rct_EEExplode))
    loop
        exitwhen ( (RectContainsUnit(gg_rct_EEExplode, gg_unit_n60B_0024) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    call SetUnitFacingTimed(gg_unit_n60B_0024, 315.00, 0.25)
    call TriggerSleepAction(0.25)
    call SetUnitAnimation(gg_unit_n60B_0024, "Death Spell")
    call TriggerSleepAction(0.25)
    call KillDestructable(gg_dest_LTex_5112)
    call TriggerSleepAction(0.25)
    call KillDestructable(gg_dest_LTex_5113)
    call TriggerSleepAction(0.25)
    call KillDestructable(gg_dest_LTex_5114)
    call TriggerSleepAction(0.25)
    call KillDestructable(gg_dest_LTex_1315)
    call TriggerSleepAction(0.25)
    call KillDestructable(gg_dest_LTex_1316)
    call TriggerSleepAction(0.25)
    call KillDestructable(gg_dest_YT51_0991)
    call TriggerSleepAction(0.50)
    call RemoveUnit(gg_unit_n60B_0024)
    call EnumDestructablesInRectAll(gg_rct_PBControl, function Trig_RetakeN_ExplodeBridge01_Func053A)
    // Unpause Units
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_RetakeN_ExplodeBridge01_Func057A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_RetakeN_ExplodeBridge01_Func060A)
    // //
    call DestroyFogModifier(udg_VisMod_Bridge01)
    call PolledWait(2.00)
    // //
    call AddSpecialEffectTargetUnitBJ("overhead", udg_SemiHero_Utok, "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl")
    set udg_SE_ExclamationMark=GetLastCreatedEffectBJ()
    // //
    call QueuedTriggerAddBJ(gg_trg_RetakeN_ExplodeBridge01_Q2, true)
endfunction

