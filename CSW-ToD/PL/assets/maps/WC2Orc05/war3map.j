//===========================================================================
// Trigger: AI P13 Defeated
//===========================================================================
function Trig_AI_P13_Defeated_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_StromgardeGA ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P13_Defeated_Func009001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h616' )
endfunction

function Trig_AI_P13_Defeated_Func009001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P13_Defeated_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h616'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P13_Defeated_Func009002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P13DefeatCondition)
endfunction

function Trig_AI_P13_Defeated_Func012001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_AI_P13_Defeated_Func012001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P13_Defeated_Func012001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P13_Defeated_Func012002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P13DefeatCondition)
endfunction

function Trig_AI_P13_Defeated_Func015C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'h60X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P13_Defeated_Func017Func003C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'h616' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'h60X' ) ) then
        return true
    endif
    return false
endfunction

function Trig_AI_P13_Defeated_Func017Func004C takes nothing returns boolean
    if ( ( CountLivingPlayerUnitsOfTypeId('h60X', udg_Player_StromgardeGA) == 0 ) ) then
        return true
    endif
    if ( ( CountLivingPlayerUnitsOfTypeId('h616', udg_Player_StromgardeGA) == 0 ) ) then
        return true
    endif
    return false
endfunction

function Trig_AI_P13_Defeated_Func017C takes nothing returns boolean
    if ( not Trig_AI_P13_Defeated_Func017Func003C() ) then
        return false
    endif
    if ( not Trig_AI_P13_Defeated_Func017Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P13_Defeated_Func020C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P13DefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P13_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_P13DefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_StromgardeGA, Condition(function Trig_AI_P13_Defeated_Func009001002)), function Trig_AI_P13_Defeated_Func009002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_StromgardeGA, Condition(function Trig_AI_P13_Defeated_Func012001002)), function Trig_AI_P13_Defeated_Func012002)
    // //
    // This done to avoid crashes
    if ( Trig_AI_P13_Defeated_Func015C() ) then
        call UnitAddTypeBJ(UNIT_TYPE_TOWNHALL, gg_unit_nnfm_0297)
    else
    endif
    // //
    if ( Trig_AI_P13_Defeated_Func017C() ) then
        call ConditionalTriggerExecute(gg_trg_AI_P13_Stop_Attack_Command)
        call ConditionalTriggerExecute(gg_trg_AI_P13_Defeat_Command)
    else
    endif
    // //
    // //
    if ( Trig_AI_P13_Defeated_Func020C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_AI_P13_Gold)
        call DisableTrigger(gg_trg_AI_P13_Lumber)
        call DisableTrigger(gg_trg_AI_P13_Transports_Availiable_Checker)
    else
    endif
    // //
    call GroupClear(udg_Group_P13DefeatCondition)
    // //
endfunction

