    if (OilHarvest___playerOil[GetPlayerId((Player(16)))]) < 700 then // INLINED!!
    // // UI Warning
    // No need for it for computer driven player
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(16) , - 700)
    else
    // need to decrease the oil if there was enough of it and ship started to build
    call playerAddOil(Player(16) , - 700)
    endif
    if ( Trig_OilSpentForHumanDestroyer_Func017C() ) then
        call DisplayTextToForce(udg_PlayerGroup_Actual, ( "Marynarka Stromgardu ma obecnie: " + I2S((OilHarvest___playerOil[GetPlayerId((Player(16)))])) + " jednostek ropy" )) // INLINED!!
    else
    endif
    // //
endfunction

//===========================================================================
function InitTrig_OilSpentForHumanDestroyer takes nothing returns nothing
    set gg_trg_OilSpentForHumanDestroyer=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OilSpentForHumanDestroyer, EVENT_PLAYER_UNIT_TRAIN_START)
    call TriggerAddCondition(gg_trg_OilSpentForHumanDestroyer, Condition(function Trig_OilSpentForHumanDestroyer_Conditions))
