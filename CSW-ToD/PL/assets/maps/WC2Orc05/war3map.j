    return ( udg_Bool_CinCatapultSkipped == true )
endfunction

function Trig_Catapult_Cinematic_Q_Actions takes nothing returns nothing
    call DestroyEffectBJ(udg_SE_ExclamationMark)
    // //
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(Player(0)), function Trig_Catapult_Cinematic_Q_Func010002)
    call ClearSelectionForPlayer(Player(0))
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_Actual)
    // ///
    // SetEnv and Actors
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call ConditionalTriggerExecute(gg_trg_Catapult_Cinematic_Setup)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_CatapultCin01, udg_Player_Actual, 0)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_CatapultCin02, udg_Player_Actual, 5.00)
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_CatapultCinMaim02))
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_CatapultCinZuluhed02))
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_CatapultCinUtok01))
    call SetUnitPathing(udg_Unit_CatapultsArr[1], false)
    call IssuePointOrderLocBJ(udg_Unit_CatapultsArr[1], "move", GetRectCenter(gg_rct_Catapult01))
    call IssuePointOrderLocBJ(gg_unit_o61Y_0066, "move", GetRectCenter(gg_rct_CatapultCinPeon01))
    call PlaySoundOnUnitBJ(gg_snd_CatapultLoop, 75.00, udg_Unit_CatapultsArr[1])
    // ///
    call PlaySoundBJ(gg_snd_DarkAgents)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    // Cinematic Started and can be skipped now
    set udg_Bool_CinCatapultOn=true
    // ///
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_CatapultCinUtok01, udg_FakeUtok) == true), (udg_Bool_CinCatapultSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_Unit_CatapultsArr[2], "move", GetRectCenter(gg_rct_Catapult02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(gg_unit_o61Y_0067, "move", GetRectCenter(gg_rct_CatapultCinPeon02))
    // ///
    call SetUnitFacingToFaceLocTimed(udg_FakeUtok, GetRectCenter(gg_rct_CatapultCinMaim02), 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeUtok, 0, gg_snd_WC2Orc05Utok_Catapult1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_CatapultCin03, udg_Player_Actual, 0.00)
    // ///
    call SetUnitFacingToFaceLocTimed(udg_FakeUtok, GetRectCenter(gg_rct_CatapultCinPeon02), 1.50)
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic point three")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    call TriggerSleepAction(1.90)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // Attack Trees
    // ///
    call SetUnitAnimation(gg_unit_o61Y_0066, "attack")
    call QueueUnitAnimationBJ(gg_unit_o61Y_0066, "stand")
    call PlaySoundOnUnitBJ(gg_snd_AxeMediumChopWood1, 100, gg_unit_o61Y_0067)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CatapultsArr[1], "attackground", GetRectCenter(gg_rct_CatapultTarget01))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(gg_unit_o61Y_0067, "attack")
    call QueueUnitAnimationBJ(gg_unit_o61Y_0067, "stand")
    call PlaySoundOnUnitBJ(gg_snd_AxeMediumChopWood2, 100, gg_unit_o61Y_0066)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssueImmediateOrderBJ(udg_Unit_CatapultsArr[1], "stop")
    call IssuePointOrderLocBJ(udg_Unit_CatapultsArr[2], "attackground", GetRectCenter(gg_rct_CatapultTarget02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssueImmediateOrderBJ(udg_Unit_CatapultsArr[2], "stop")
    // ///
    call EnumDestructablesInRectAll(gg_rct_TreesCut, function Trig_Catapult_Cinematic_Q_Func089A)
    // ///
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_CatapultsArr[2], "death")
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_CatapultCin04, udg_Player_Actual, 0.00)
    // ///
    call SetUnitAnimation(udg_FakeUtok, "cinematic frustrated one")
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.85)
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic writing one")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeUtok, 0, gg_snd_WC2Orc05Utok_Catapult2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call StopSoundBJ(gg_snd_DarkAgents, true)
    // ///
    call SetUnitAnimation(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim_Catapult1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCatapultSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // ///
    call ConditionalTriggerExecute(gg_trg_Catapult_Cinematic_Cleanup)
endfunction

