// Trigger: Fortify Update Q
//===========================================================================
function Trig_Fortify_Update_Q_Func004C takes nothing returns boolean
    if ( not ( udg_Bool_StrongholdUpgraded == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fortify_Update_Q_Func005C takes nothing returns boolean
    if ( not ( udg_Bool_ShipyardBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fortify_Update_Q_Func006C takes nothing returns boolean
    if ( not ( udg_Bool_FoundryBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fortify_Update_Q_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_RefineryBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fortify_Update_Q_Actions takes nothing returns nothing
    set udg_newLine="\n"
    set udg_String_CompletedQuests=( GetItemName(gg_item_IQL0_0222) + ( udg_newLine + BlzGetItemDescription(gg_item_IQL0_0222) ) )
    if ( Trig_Fortify_Update_Q_Func004C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FortifyUpgradeStronghold, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL0_0222) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL0_0222) ) )
    endif
    if ( Trig_Fortify_Update_Q_Func005C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FortifyBuildShipyard, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL1_0221) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL1_0221) ) )
    endif
    if ( Trig_Fortify_Update_Q_Func006C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FortifyBuildFoundry, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL1_0221) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL1_0221) ) )
    endif
    if ( Trig_Fortify_Update_Q_Func007C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FortifyBuildRefinery, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL2_0216) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL2_0216) ) )
    endif
    call QuestMessageBJ(udg_PlayerGroup_Actual, bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

