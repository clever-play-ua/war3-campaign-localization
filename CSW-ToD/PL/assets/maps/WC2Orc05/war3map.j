//===========================================================================
// Trigger: RetakeS DragonItemCombine
//===========================================================================
function Trig_RetakeS_DragonItemCombine_Func011C takes nothing returns boolean
    if ( not ( udg_Int_DragonItemCounter <= 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RetakeS_DragonItemCombine_Actions takes nothing returns nothing
    call RemoveItem(GetManipulatedItem())
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60P'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60Q'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60N'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Maim, 'I60P'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Maim, 'I60Q'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Maim, 'I60N'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60P'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60Q'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60N'))
    if ( Trig_RetakeS_DragonItemCombine_Func011C() ) then
        call CreateItemLoc('I6DX', GetUnitLoc(udg_Unit_DragonFigurineHolder))
        set udg_Item_UnassembledDragonTotem=GetLastCreatedItem()
        call UnitAddItemSwapped(udg_Item_UnassembledDragonTotem, udg_Hero_Zuluhed)
    else
    endif
    set udg_Unit_DragonFigurineHolder=null
endfunction

