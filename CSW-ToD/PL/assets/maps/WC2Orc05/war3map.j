    // //
    call SetUnitColor(udg_FakeUtok, PLAYER_COLOR_RED)
    call SetUnitOwner(udg_FakeUtok, udg_Player_Actual, false)
    call SetUnitPositionLocFacingLocBJ(udg_FakeUtok, GetRectCenter(gg_rct_UnloadTransport02), GetRectCenter(gg_rct_LoadUtok))
