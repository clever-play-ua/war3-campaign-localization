endfunction

function Trig_North_Cinematic_Q_Func043001 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_Q_Func053001 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_Q_Func056001 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_Q_Func074001 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_Q_Func078001 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_Q_Func081001 takes nothing returns boolean
    return ( udg_Bool_CinNorthSkipped == true )
endfunction

function Trig_North_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    set udg_Var_CurrentCamera=GetCurrentCameraSetup()
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_North_Cinematic_Q_Func007002)
    call ClearSelectionForPlayer(udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_Actual)
    // ///
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call ConditionalTriggerExecute(gg_trg_North_Cinematic_Setup)
    call CameraSetupApplyForPlayer(true, gg_cam_MidCinDunModr01, udg_Player_Actual, 0)
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_MidCinRend02))
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_MidCinUtok02))
    // ///
    call PlaySoundBJ(gg_snd_Orc1)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    // Cinematic Started and can be skipped now
    set udg_Bool_CinNorthOn=true
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_EnterObervationPoint, udg_Player_Actual, 10.00)
    // ///
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_MidCinRend02, udg_FakeMaim) == true), (udg_Bool_CinNorthSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitFacingToFaceLocTimed(udg_FakeMaim, GetRectCenter(gg_rct_EnterObserationPost), 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeMaim, "cinematic point one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeMaim, 0, gg_snd_WC2Orc05Maim_ObservationPost1, bj_TIMETYPE_ADD, 0, false)
    // ///
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_ObservationPost01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_ObservationPost02, udg_Player_Actual, 5.00)
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_DunModr05, udg_Player_Actual, 0)
    // ///
    // TelescopeEffect
    // ///
    set udg_Real_FocalDistance=400.00
    set udg_Real_DepthOfField=200.00
    call SetCameraFieldForPlayer(udg_Player_Actual, CAMERA_FIELD_FIELD_OF_VIEW, 50.00, 4.00)
    call CameraSetSourceNoiseForPlayer(udg_Player_Actual, 20.00, 0.20)
    call EnableTrigger(gg_trg_Cinematic_FadeCameraFocus)
    call ConditionalTriggerExecute(gg_trg_Cinematic_FadeCameraFocus)
    // ///
    call CinematicFilterGenericBJ(1.00, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\Scope_Mask.blp", 100, 100, 100, 0.00, 100.00, 100.00, 100.00, 0.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_FakeUtok, 0, gg_snd_WC2Orc05Utok_Telescope1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc05Utok_Telescope1, 0)
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call StopSoundBJ(gg_snd_Orc1, true)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinNorthSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // ///
    call ConditionalTriggerExecute(gg_trg_North_Cinematic_Cleanup)
endfunction

