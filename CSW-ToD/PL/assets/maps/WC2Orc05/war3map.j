//===========================================================================
// Trigger: Barad Shipyard Hint Q
//===========================================================================
function Trig_Barad_Shipyard_Hint_Q_Func004002 takes nothing returns nothing
    call RescueUnitBJ(GetEnumUnit(), udg_Player_Actual, false)
endfunction

function Trig_Barad_Shipyard_Hint_Q_Actions takes nothing returns nothing
    local location p
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_DragonmawCinematic), function Trig_Barad_Shipyard_Hint_Q_Func004002)
    // //
    call ReplaceUnitBJ(gg_unit_o60V_0029, 'o60V', bj_UNIT_STATE_METHOD_RELATIVE)
    call RescueUnitBJ(GetLastReplacedUnitBJ(), udg_Player_Actual, false)
    // //
    set p=GetUnitLoc(GetLastReplacedUnitBJ())
    // //
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, p)
    call PingMinimapLocForForceEx(udg_PlayerGroup_Actual, p, 4.00, bj_MINIMAPPINGSTYLE_SIMPLE, 0.00, 100, 0.00)
    // //
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UNITACQUIRED, "TRIGSTR_4067")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    // //
    call RemoveLocation(p)
    set p=null
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

