//===========================================================================
// Trigger: HeroDies Defeat
//===========================================================================
function Trig_HeroDies_Defeat_Func002C takes nothing returns boolean
    if ( ( GetDyingUnit() == udg_Hero_Maim ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_Hero_Zuluhed ) ) then
        return true
    endif
    return false
endfunction

function Trig_HeroDies_Defeat_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQRetakeDunModr) == false ) ) then
        return false
    endif
    if ( not Trig_HeroDies_Defeat_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_HeroDies_Defeat_Func007C takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Hero_Maim ) ) then
        return false
    endif
    return true
endfunction

function Trig_HeroDies_Defeat_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetFailedBJ(udg_MQRetakeDunModr, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    if ( Trig_HeroDies_Defeat_Func007C() ) then
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_MISSIONFAILED, "TRIGSTR_3448")
    else
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_MISSIONFAILED, "TRIGSTR_3447")
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
    call TriggerSleepAction(1.00)
    call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_4007")
endfunction

