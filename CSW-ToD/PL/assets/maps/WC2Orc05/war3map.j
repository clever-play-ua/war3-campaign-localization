function Trig_Visibility_Zone01_Hide_Func006001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Visibility_Zone01_Hide_Func006001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Visibility_Zone01_Hide_Func006001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Visibility_Zone01_Hide_Func006A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_RevealArea01)
endfunction

function Trig_Visibility_Zone01_Hide_Func008C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_RevealArea01) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Visibility_Zone01_Hide_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call GroupClear(udg_Group_RevealArea01)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_RevealArea01, Condition(function Trig_Visibility_Zone01_Hide_Func006001002)), function Trig_Visibility_Zone01_Hide_Func006A)
    // //
    if ( Trig_Visibility_Zone01_Hide_Func008C() ) then
        set udg_Bool_VisModZone01On=false
        call DestroyFogModifier(udg_VisMod_Zone01)
    else
    endif
    // //
    call GroupClear(udg_Group_RevealArea01)
endfunction

//===========================================================================
function InitTrig_Visibility_Zone01_Hide takes nothing returns nothing
    set gg_trg_Visibility_Zone01_Hide=CreateTrigger()
    call DisableTrigger(gg_trg_Visibility_Zone01_Hide)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Visibility_Zone01_Hide, 2)
    call TriggerAddCondition(gg_trg_Visibility_Zone01_Hide, Condition(function Trig_Visibility_Zone01_Hide_Conditions))
    call TriggerAddAction(gg_trg_Visibility_Zone01_Hide, function Trig_Visibility_Zone01_Hide_Actions)
endfunction

//===========================================================================
// Trigger: Visibility Zone02 Reveal
//===========================================================================
function Trig_Visibility_Zone02_Reveal_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_VisModZone02On == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Visibility_Zone02_Reveal_Actions takes nothing returns nothing
    set udg_Bool_VisModZone02On=true
    call FogModifierStart(udg_VisMod_Zone02)
    call EnableTrigger(gg_trg_Visibility_Zone02_Hide)
endfunction

//===========================================================================
function InitTrig_Visibility_Zone02_Reveal takes nothing returns nothing
    set gg_trg_Visibility_Zone02_Reveal=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Visibility_Zone02_Reveal, gg_rct_Mine)
    call TriggerAddCondition(gg_trg_Visibility_Zone02_Reveal, Condition(function Trig_Visibility_Zone02_Reveal_Conditions))
