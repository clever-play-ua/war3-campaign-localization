function InitTrig_South_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_South_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_South_Cinematic_Cleanup, function Trig_South_Cinematic_Cleanup_Actions)
endfunction

