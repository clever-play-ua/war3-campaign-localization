endfunction

function Trig_Intro_Cinematic_Cleanup_Func101C takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinIntroOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call SetDoodadAnimationRectBJ("death", 'NOfp', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'YSll', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'NOfg', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'LOlp', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'D61B', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death alternate", 'LObr', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death alternate", 'LObz', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death alternate", 'D6CS', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death alternate", 'AObr', GetPlayableMapRect())
    // ///
    call UseTimeOfDayBJ(true)
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, 50.00, 50.00, 68.00)
    call SetTimeOfDay(6.00)
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_GameStarts, udg_Player_Actual, 0)
    call TriggerSleepAction(0.50)
    // ///
    // ///
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // ///
    // Default Units Positioning
    // ///
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Intro_Cinematic_Cleanup_Func028A)
    // ///
    call SetUnitPositionLocFacingBJ(gg_unit_o60R_0034, GetRectCenter(gg_rct_IntroDestroyer01), 225.00)
    call SetUnitScalePercent(gg_unit_o60R_0034, 160.00, 160.00, 160.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60R_0035, GetRectCenter(gg_rct_IntroDestroyer02), 225.00)
    call SetUnitScalePercent(gg_unit_o60R_0035, 160.00, 160.00, 160.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60R_0036, GetRectCenter(gg_rct_IntroDestroyer03), 225.00)
    call SetUnitScalePercent(gg_unit_o60R_0036, 160.00, 160.00, 160.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60R_0037, GetRectCenter(gg_rct_IntroDestroyer04), 225.00)
    call SetUnitScalePercent(gg_unit_o60R_0037, 160.00, 160.00, 160.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0032, GetRectCenter(gg_rct_IntroTransportUnload02), 35.96)
    call SetUnitScalePercent(gg_unit_o60Q_0032, 120.00, 120.00, 120.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0031, GetRectCenter(gg_rct_IntroTransportUnload01), 46.39)
    call SetUnitScalePercent(gg_unit_o60Q_0031, 120.00, 120.00, 120.00)
    // ///
    call SetUnitPositionLocFacingBJ(gg_unit_o61V_0064, GetRectCenter(gg_rct_IntroGrunt01), 63.50)
    call SetUnitPositionLocFacingBJ(gg_unit_o61V_0063, GetRectCenter(gg_rct_IntroGrunt02), 64.68)
    call SetUnitPositionLocFacingBJ(gg_unit_o61V_0060, GetRectCenter(gg_rct_IntroGrunt03), 257.43)
    call SetUnitPositionLocFacingBJ(gg_unit_o61V_0062, GetRectCenter(gg_rct_IntroGrunt04), 272.38)
    // ///
    call SetUnitPositionLocFacingBJ(gg_unit_oWyh_0085, GetRectCenter(gg_rct_IntroHunter03), 281.72)
    call SetUnitPositionLocFacingBJ(gg_unit_oWyh_0086, GetRectCenter(gg_rct_IntroHunter04), 299.48)
    call SetUnitPositionLocFacingBJ(gg_unit_oWyh_0083, GetRectCenter(gg_rct_IntroHunter01), 99.38)
    call SetUnitPositionLocFacingBJ(gg_unit_oWyh_0084, GetRectCenter(gg_rct_IntroHunter02), 89.09)
    // ///
    // Unhide gameplay heroes
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Maim, GetRectCenter(gg_rct_LoadMaim), GetRectCenter(gg_rct_LoadZuluhed))
    call ShowUnitShow(udg_Hero_Maim)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_LoadZuluhed), GetRectCenter(gg_rct_LoadMaim))
    call ShowUnitShow(udg_Hero_Zuluhed)
    call ShowUnitShow(udg_SemiHero_Utok)
    call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_UtokScribesHere), bj_UNIT_FACING)
    call SetUnitAnimation(udg_SemiHero_Utok, "cinematic writing one")
    // ///
    call SetUnitBlendTimeBJ(udg_Hero_Maim, 0.15)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Hero_Maim)
    call SetUnitMoveSpeed(udg_Hero_Maim, 270.00)
    call BlzSetUnitRealFieldBJ(udg_Hero_Maim, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    // ///
    call SetUnitBlendTimeBJ(udg_Hero_Zuluhed, 0.15)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Hero_Zuluhed)
    call SetUnitMoveSpeed(udg_Hero_Zuluhed, 270.00)
    call BlzSetUnitRealFieldBJ(udg_Hero_Zuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    // ///
    if ( Trig_Intro_Cinematic_Cleanup_Func072C() ) then
        call StopSoundBJ(gg_snd_OrcX1, false)
        call StopSoundBJ(gg_snd_WC3OrcDefeat, false)
        call StopSoundBJ(gg_snd_Orc3, false)
        call StopSoundBJ(gg_snd_WC2Orc05Zuluhed1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Zuluhed2, false)
        call StopSoundBJ(gg_snd_WC2Orc05Zuluhed3, false)
        call StopSoundBJ(gg_snd_WC2Orc05Utok1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Utok2, false)
        call StopSoundBJ(gg_snd_WC2Orc05Utok3, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim1, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim2, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim3, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim4, false)
        call StopSoundBJ(gg_snd_WC2Orc05Maim5, false)
        call CameraClearNoiseForPlayer(udg_Player_Actual)
        call CameraSetFocalDistance(0.00)
        call CameraSetDepthOfFieldScale(0.00)
    else
    endif
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'o61V'), function Trig_Intro_Cinematic_Cleanup_Func075A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'oWyh'), function Trig_Intro_Cinematic_Cleanup_Func078A)
    // ///
    // ///
    call SetItemVisibleBJ(true, gg_item_I603_0319)
    call SetItemVisibleBJ(true, gg_item_I603_0324)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_BlackToothGrinCamp, udg_Player_BTGCinematic), function Trig_Intro_Cinematic_Cleanup_Func085A)
    call ForGroupBJ(udg_Group_BTGInitialTroops, function Trig_Intro_Cinematic_Cleanup_Func086002)
    call ShowUnitShow(gg_unit_n61O_0133)
    call ConditionalTriggerExecute(gg_trg_RetakeN_BusyPeon_Patrol)
    // ///
    // We need to save the ships for future
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_DragonmawCinematic), function Trig_Intro_Cinematic_Cleanup_Func092002)
    // ///
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Intro_Cinematic_Cleanup_Func098002)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func101C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Retake_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

