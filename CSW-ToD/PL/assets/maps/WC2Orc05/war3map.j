//===========================================================================
// Trigger: Init 04 Environment
//===========================================================================
function Trig_Init_04_Environment_Func039Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B017' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_04_Environment_Func039A takes nothing returns nothing
    if ( Trig_Init_04_Environment_Func039Func001C() ) then
        call SetDestructableAnimationBJ(GetEnumDestructable(), "death")
    else
    endif
endfunction

function Trig_Init_04_Environment_Func040Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B017' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_04_Environment_Func040A takes nothing returns nothing
    if ( Trig_Init_04_Environment_Func040Func001C() ) then
        call SetDestructableAnimationBJ(GetEnumDestructable(), "death")
    else
    endif
endfunction

function Trig_Init_04_Environment_Actions takes nothing returns nothing
    // Initial Time Of Day
    call SetTimeOfDay(12.00)
    // sky
    call SetSkyModel("Environment\\Sky\\LordaeronFallSky\\LordaeronFallSky.mdl")
    // Fog
    set udg_Real_FogMin=3000.00
    set udg_Real_FogMax=12500.00
    // Bridges, Gates, etc.
    call SetDestructableInvulnerableBJ(gg_dest_B014_2601, true)
    call SetDestructableInvulnerableBJ(gg_dest_B62R_8305, true)
    call SetDestructableInvulnerableBJ(gg_dest_LTg3_3924, true)
    call SetDestructableInvulnerableBJ(gg_dest_LTrc_3380, true)
    call SetDestructableInvulnerableBJ(gg_dest_LTrc_0030, true)
    // //
    call KillDestructable(gg_dest_RW07_1276)
    call ShowDestructableBJ(false, gg_dest_RW07_1276)
    // //
    set udg_Point_FakeDukeSpawn=GetRectCenter(gg_rct_FakeActorDukeSpawn)
    set udg_Point_FakeMaimSpawn=GetRectCenter(gg_rct_FakeActorMaimSpawn)
    set udg_Point_FakeUtokSpawn=GetRectCenter(gg_rct_FakeActorUtokSpawn)
    set udg_Point_FakeZuluhedSpawn=GetRectCenter(gg_rct_FakeActorZuluhedSpawn)
    // //
    call WaygateActivateBJ(false, gg_unit_nC1M_0369)
    call WaygateActivateBJ(false, gg_unit_nC2M_0370)
    // //
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_WallpaperDoodad)
    // //
    call SetDoodadAnimationRectBJ("death", 'NOfg', gg_rct_CampfireHPRegen01)
    call SetDoodadAnimationRectBJ("death", 'NOfg', gg_rct_CampfireHPRegen02)
    // //
    call SetDoodadAnimationRectBJ("death", 'LOtz', gg_rct_TorchesControl)
    // //
    call SetDestructableAnimationBJ(gg_dest_B00U_0590, "death")
    call SetDestructableAnimationBJ(gg_dest_B01M_9359, "death")
    call SetDestructableAnimationBJ(gg_dest_B01M_9361, "death")
    // //
    call KillDestructable(gg_dest_B00T_7845)
    // //
    call EnumDestructablesInRectAll(gg_rct_Crators, function Trig_Init_04_Environment_Func039A)
    call EnumDestructablesInRectAll(gg_rct_WaterElementals, function Trig_Init_04_Environment_Func040A)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_DestroyTrunkForFun)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_FinalCinFires)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_FinalCinFires)
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_FinalCinFires)
    call SetDoodadAnimationRectBJ("death", 'D020', gg_rct_FinalCinFires)
    call SetDoodadAnimationRectBJ("death", 'D020', gg_rct_FinalCinHeroes)
    call SetDoodadAnimationRectBJ("death", 'D020', gg_rct_TorchLight)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_TolBaradFire)
    call SetDoodadAnimationRectBJ("death", 'D001', GetPlayableMapRect())
    // ///
    call SetDoodadAnimationRectBJ("death", 'NOfp', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'YSll', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'NOfg', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'LOlp', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'D61B', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death alternate", 'LObr', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death alternate", 'LObz', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death alternate", 'D6CS', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death alternate", 'AObr', GetPlayableMapRect())
    // //
    // Partisans
    // //
    // LowerTunnelExit
    // hide animation? seems like it doesnt work
    call SetDoodadAnimationRectBJ("hide", 'D021', gg_rct_WaterWaves07)
    set udg_Point_PartisansTunnelExit=GetRectCenter(gg_rct_UndergroundStairsSpawn)
    // //
    // Visibility
    // //
    set udg_Point_VisibilityZone[1]=GetRectCenter(gg_rct_RevealArea01)
    call CreateFogModifierRadiusLocBJ(false, udg_Player_Actual, FOG_OF_WAR_VISIBLE, udg_Point_VisibilityZone[1], 448.00)
    set udg_VisMod_Zone01=GetLastCreatedFogModifier()
    // //
    set udg_Point_VisibilityZone[2]=GetRectCenter(gg_rct_Mine)
    call CreateFogModifierRadiusLocBJ(false, udg_Player_Actual, FOG_OF_WAR_VISIBLE, udg_Point_VisibilityZone[2], 1024.00)
    set udg_VisMod_Zone02=GetLastCreatedFogModifier()
    // //
    // Cave Pathing
    // //
    set udg_Point_CavePathingTarget[1]=GetRectCenter(gg_rct_Cave_AirUnit_Tripline1_Target)
    set udg_Point_CavePathingTarget[2]=GetRectCenter(gg_rct_Cave_AirUnit_Tripline1_Target)
    // ///
    // Hiding the Localized text items
    // ///
    call SetItemVisibleBJ(false, gg_item_IQL0_0222)
    call SetItemVisibleBJ(false, gg_item_IQL1_0221)
    call SetItemVisibleBJ(false, gg_item_IQL2_0216)
    call SetItemVisibleBJ(false, gg_item_IQL3_0120)
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
    // ///
endfunction

