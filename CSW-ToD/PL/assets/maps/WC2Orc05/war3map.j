    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_Hero_Maim, 'N60K', gg_snd_WC2Orc05Maim_BlastedDwares3, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_Actual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc05Zuluhed_LastDwarves1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestSetDiscoveredBJ(udg_OQPartisans, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_4040")
