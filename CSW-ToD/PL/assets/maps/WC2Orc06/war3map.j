//===========================================================================
// Trigger: Humans MasGhost Meet
//
// Badly triggered Boss fight for mah, basically making her scream then spawn some wisp types to attack you a few times. just to spice the battle up. Up to you to make the fight more interresting if you want. but it's just a ''cool'' strong mod, not a real boss battle.
//===========================================================================
function Trig_Humans_MasGhost_Meet_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n003' ) ) then
        return false
    endif
    if ( not ( udg_Bool_LeftRoadSelected == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Humans_MasGhost_Meet_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ShowUnitShow(gg_unit_n00Y_0285)
    call IssueTargetOrderBJ(gg_unit_n00Y_0285, "attack", GetTriggerUnit())
    call PlaySoundOnUnitBJ(gg_snd_BansheeDeath, 100, gg_unit_n00Y_0285)
    call PolledWait(3.00)
    call PlaySoundOnUnitBJ(gg_snd_BansheePissed5, 100, gg_unit_n00Y_0285)
    call PolledWait(2.00)
    call StopSoundBJ(gg_snd_BansheePissed5, true)
    call PolledWait(4.00)
    call CreateNUnitsAtLocFacingLocBJ(3, 'e002', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(gg_rct_Ma_trigger), GetUnitLoc(GetEnteringUnit()))
    call PolledWait(4.00)
    call CreateNUnitsAtLocFacingLocBJ(3, 'e002', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(gg_rct_Ma_trigger), GetUnitLoc(GetEnteringUnit()))
endfunction

//===========================================================================
function InitTrig_Humans_MasGhost_Meet takes nothing returns nothing
    set gg_trg_Humans_MasGhost_Meet=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Humans_MasGhost_Meet, gg_rct_Ma_trigger)
    call TriggerAddCondition(gg_trg_Humans_MasGhost_Meet, Condition(function Trig_Humans_MasGhost_Meet_Conditions))
    call TriggerAddAction(gg_trg_Humans_MasGhost_Meet, function Trig_Humans_MasGhost_Meet_Actions)
endfunction

