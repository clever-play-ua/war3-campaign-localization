//===========================================================================
function RunInitializationTriggers takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Unit_Event_Config)
    call ConditionalTriggerExecute(gg_trg_Initialization)
    call ConditionalTriggerExecute(gg_trg_Load_Heroes)
endfunction

//***************************************************************************
//*
//*  Upgrades
//*
//***************************************************************************

function InitUpgrades_Player0 takes nothing returns nothing
    call SetPlayerTechResearched(Player(0), 'Rovs', 1)
    call SetPlayerTechResearched(Player(0), 'R003', 2)
    call SetPlayerTechResearched(Player(0), 'R011', 1)
    call SetPlayerTechResearched(Player(0), 'R010', 1)
    call SetPlayerTechMaxAllowed(Player(0), 'R00Z', 0)
endfunction

function InitUpgrades_Player20 takes nothing returns nothing
    call SetPlayerTechResearched(Player(20), 'R003', 2)
    call SetPlayerTechResearched(Player(20), 'R011', 1)
    call SetPlayerTechResearched(Player(20), 'R010', 1)
endfunction

function InitUpgrades_Player21 takes nothing returns nothing
    call SetPlayerTechResearched(Player(21), 'R003', 2)
endfunction

function InitUpgrades_Player22 takes nothing returns nothing
    call SetPlayerTechResearched(Player(22), 'RBBH', 1)
endfunction

function InitUpgrades takes nothing returns nothing
    call InitUpgrades_Player0()
    call InitUpgrades_Player20()
    call SetPlayerTechResearched(Player(21), 'R003', 2) // INLINED!!
    call SetPlayerTechResearched(Player(22), 'RBBH', 1) // INLINED!!
endfunction

//***************************************************************************
//*
//*  TechTree
//*
//***************************************************************************

function InitTechTree_Player0 takes nothing returns nothing
    call SetPlayerAbilityAvailable(Player(0), 'A61J', false)
    call SetPlayerAbilityAvailable(Player(0), 'A022', false)
    call SetPlayerTechMaxAllowed(Player(0), 'A01H', 0)
    call SetPlayerTechMaxAllowed(Player(0), 'A01V', 0)
endfunction

function InitTechTree_Player20 takes nothing returns nothing
    call SetPlayerAbilityAvailable(Player(20), 'A022', false)
    call SetPlayerAbilityAvailable(Player(20), 'A020', false)
    call SetPlayerAbilityAvailable(Player(20), 'A023', false)
    call SetPlayerTechMaxAllowed(Player(20), 'A01H', 0)
    call SetPlayerTechMaxAllowed(Player(20), 'A01V', 0)
endfunction

function InitTechTree takes nothing returns nothing
    call InitTechTree_Player0()
    call InitTechTree_Player20()
endfunction

