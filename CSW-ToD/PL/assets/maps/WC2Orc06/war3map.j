        set udg_Bool_VisModHumanCampOn=false
    else
    endif
endfunction

//===========================================================================
function InitTrig_HideHumanCamp takes nothing returns nothing
    set gg_trg_HideHumanCamp=CreateTrigger()
    call DisableTrigger(gg_trg_HideHumanCamp)
    call TriggerRegisterTimerEventPeriodic(gg_trg_HideHumanCamp, 2)
    call TriggerAddCondition(gg_trg_HideHumanCamp, Condition(function Trig_HideHumanCamp_Conditions))
    call TriggerAddAction(gg_trg_HideHumanCamp, function Trig_HideHumanCamp_Actions)
endfunction

