    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeKilrogg, 1.00)
    call SetUnitFacingToFaceLocTimed(udg_FakeKilrogg, GetRectCenter(gg_rct_ChogallAwayCin), 2.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
