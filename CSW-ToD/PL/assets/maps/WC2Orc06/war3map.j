//===========================================================================
// Trigger: Dwarves Ambush1
//
// When you walk inside a region, you trigger an ambush. Basically, inside the bushes, some Human archer spawns... all they need is potentially the '' ! '' fx floathing on top of their heads, to make them more clear to the players. Do that for every ambush. Since they are inside bushes, they are hard to spot.
//===========================================================================
function Trig_Dwarves_Ambush1_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n003' ) ) then
        return false
    endif
    if ( not ( udg_Bool_LeftRoadSelected == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarves_Ambush1_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_Stromgarde, GetRectCenter(gg_rct_ambush_5_bush_1), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_Stromgarde, GetRectCenter(gg_rct_ambush_5_bush_2), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_Stromgarde, GetRectCenter(gg_rct_ambush_5_bush_3), bj_UNIT_FACING)
endfunction

