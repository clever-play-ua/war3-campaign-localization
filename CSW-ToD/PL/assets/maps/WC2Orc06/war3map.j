// Trigger: Init 04 Environment
//===========================================================================
function Trig_Init_04_Environment_Actions takes nothing returns nothing
    call SetTimeOfDay(18.00)
    call UseTimeOfDayBJ(false)
    call SetSkyModel("CSW\\Environment\\Sky\\SpaceSky\\WetlandsSkyboxNight.mdx")
    call SetTerrainFogExBJ(0, 0.00, 6000.00, 0.05, 0.00, 20.00, 10.00)
    call ShowDestructableBJ(false, gg_dest_B00U_2545)
    call KillDestructable(gg_dest_B010_10384)
    call SetDestructableAnimationBJ(gg_dest_B00S_0061, "stand alternate")
    // Locations
    // //
    set udg_Bool_BeforeFork=true
    // //
    set udg_Point_SpawnFakeChogall=GetRectCenter(gg_rct_CreateFakeChogall)
    set udg_Point_SpawnFakeKilrogg=GetRectCenter(gg_rct_CreateFakeKilrogg)
    set udg_Point_SpawnFakeUtok=GetRectCenter(gg_rct_CreateFakeUtok)
    set udg_Point_SpawnFakeZuluhed=GetRectCenter(gg_rct_CreateFakeZuluhed)
    set udg_Point_ChogallBridgeTeleport=GetRectCenter(gg_rct_ChogallBridgeTeleport)
    // //
    // Cho'gall
    set udg_Point_MinimapChogall=GetRectCenter(gg_rct_ReachTheCamp)
    // //
    call PolledWait(2)
    // //
    // Dead HORDE UNITS ------------------------------------------------------------------
    // //
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o001', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody2), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o001', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody3), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o001', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody4), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n00T', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody5), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o001', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody11), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n00T', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody13), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o001', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody18), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n00T', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody25), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o001', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody26), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n00T', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody27), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o001', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody28), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n00T', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody29), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o001', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody30), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n00T', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody31), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60P', udg_Player_BleedingHollow, GetRectCenter(gg_rct_TheBeast_deadbody16), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60P', udg_Player_BleedingHollow, GetRectCenter(gg_rct_deadcatapult), GetRandomDirectionDeg())
