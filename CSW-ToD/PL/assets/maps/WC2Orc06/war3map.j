    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[20]
    set udg_Player_Actual=Player(20)
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 50.00)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_2913")
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 575)
    call SetPlayerAbilityAvailableBJ(false, 'A61J', udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R00Q', 1, udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(true, 'ABhC', udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(true, 'XGC1', udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(true, 'A02F', udg_Player_Actual)
    // //
    call EnableCreepSleepBJ(false)
    call SetPlayerFlagBJ(PLAYER_STATE_GIVES_BOUNTY, false, Player(PLAYER_NEUTRAL_AGGRESSIVE))
    // //
    set udg_Player_CinematicDummy=Player(18)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicDummy)
    // //
    set udg_Player_BTG=Player(8)
    call SetPlayerColorBJ(udg_Player_BTG, PLAYER_COLOR_COAL, true)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_BTG)
    call SetPlayerAbilityAvailableBJ(true, 'XGC1', udg_Player_BTG)
    call SetPlayerAbilityAvailableBJ(true, 'A02F', udg_Player_BTG)
    // //
    set udg_Player_Ironforge=Player(23)
    set udg_Player_Stromgarde=Player(12)
    set udg_Player_BlackRock=Player(0)
    set udg_Player_TwilightHammer=Player(3)
    set udg_Player_BurningBlade=Player(5)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_BurningBlade)
    set udg_Player_DragonmawCinematic=Player(21)
    // //
    set udg_Player_BleedingHollow=Player(22)
    call SetPlayerColorBJ(udg_Player_BleedingHollow, PLAYER_COLOR_AQUA, true)
    call SetPlayerAbilityAvailableBJ(false, 'AHiO', udg_Player_BleedingHollow)
    call SetPlayerAbilityAvailableBJ(true, 'ABhC', udg_Player_BleedingHollow)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_BleedingHollow), function Trig_Init_01_Players_Func039A)
    // //
    set udg_Player_GhostWildhammer=Player(10)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_GhostWildhammer)
    set udg_Player_GhostDarkIron=Player(11)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_GhostDarkIron)
    // //
    // Alliances Horde
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BTG, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BleedingHollow, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BleedingHollow, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BurningBlade, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BurningBlade, bj_ALLIANCE_NEUTRAL)
    // //
    // Alliances Alliance
    // //
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Ironforge, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Ironforge, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Stromgarde, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Stromgarde, bj_ALLIANCE_NEUTRAL)
    // //
    // Hostiles neutral agains cinematics
    // //
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_DragonmawCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_BlackRock, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_TwilightHammer, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BlackRock, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_DragonmawCinematic, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammer, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    // //
    // Ghosts
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_GhostWildhammer, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_GhostDarkIron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_GhostWildhammer, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_GhostDarkIron, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_GhostWildhammer, udg_Player_GhostDarkIron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_GhostDarkIron, udg_Player_GhostWildhammer, bj_ALLIANCE_NEUTRAL)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_06a_Hard)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Normal)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Easy)
    // //
    // //
    // //
    // //
endfunction

