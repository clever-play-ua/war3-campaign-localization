endfunction

//===========================================================================
// Trigger: Chogall Discover Q
//===========================================================================
function Trig_Chogall_Discover_Q_Actions takes nothing returns nothing
    call CreateLeaderboardBJ(udg_PlayerGroup_PlayerActual, "TRIGSTR_3538")
    set udg_Leaderboard_QuestObjectives=GetLastCreatedLeaderboard()
    call LeaderboardAddItemBJ(Player(0), udg_Leaderboard_QuestObjectives, "TRIGSTR_3539", R2I(GetTimeOfDay()))
    call LeaderboardSetPlayerItemLabelBJ(Player(0), udg_Leaderboard_QuestObjectives, "TRIGSTR_3540")
    call LeaderboardSetPlayerItemValueColorBJ(Player(0), udg_Leaderboard_QuestObjectives, 20.00, 100.00, 20, 0)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(0), udg_Leaderboard_QuestObjectives, 20.00, 100.00, 20, 0)
    call LeaderboardSetPlayerItemStyleBJ(Player(0), udg_Leaderboard_QuestObjectives, true, true, false)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3541")
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // ///
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, udg_Point_MinimapChogall, 450.00)
    set udg_VisMod_KilroggCamp=GetLastCreatedFogModifier()
    call CampaignMinimapIconLocBJ(udg_Point_MinimapChogall, bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_QChogall=GetLastCreatedMinimapIcon()
    // ///
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, udg_Point_MinimapChogall, 5.00)
    call EnableTrigger(gg_trg_Chogall_Ping)
    call EnableTrigger(gg_trg_Chogall_Time_Refresh)
    call EnableTrigger(gg_trg_Chogall_Time_Yellow_Warning)
    call EnableTrigger(gg_trg_Chogall_Time_Red_400_Warning)
endfunction

