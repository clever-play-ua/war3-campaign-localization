function Trig_Init_02_Units_Actions takes nothing returns nothing
    set udg_Hero_KilroggDeadeye=gg_unit_O616_0051
    set udg_Unit_TheBeast=gg_unit_n00V_0101
    // //
    // Bogs
    // //
    call SetUnitColor(gg_unit_o60P_0008, PLAYER_COLOR_EMERALD)
    call SetUnitColor(gg_unit_hBaL_0217, PLAYER_COLOR_MAROON)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_HumanCampReveal, udg_Player_Stromgarde), function Trig_Init_02_Units_Func010A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_DwarvenCampReveal, udg_Player_Ironforge), function Trig_Init_02_Units_Func013A)
    // //
    call EnumDestructablesInRectAll(gg_rct_Bogbeastspawn_1, function Trig_Init_02_Units_Func015A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Bogbeastspawn_1, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Init_02_Units_Func018A)
    call ForGroupBJ(udg_Group_BogMonsters01, function Trig_Init_02_Units_Func019A)
    // //
    call SetDestAnimationSpeedPercent(gg_dest_B003_9993, 0.00)
    call PauseUnitBJ(true, gg_unit_njgb_0400)
    call ShowUnitHide(gg_unit_njgb_0400)
    call SetDestAnimationSpeedPercent(gg_dest_B003_9992, 0.00)
    call PauseUnitBJ(true, gg_unit_njgb_0399)
    call ShowUnitHide(gg_unit_njgb_0399)
    // //
    call SetDestAnimationSpeedPercent(gg_dest_B003_10092, 0.00)
    call PauseUnitBJ(true, gg_unit_njgb_0420)
    call ShowUnitHide(gg_unit_njgb_0420)
    // //
    call SetDestAnimationSpeedPercent(gg_dest_B003_10093, 0.00)
    call PauseUnitBJ(true, gg_unit_njgb_0421)
    call ShowUnitHide(gg_unit_njgb_0421)
    // //
    call EnumDestructablesInRectAll(gg_rct_Bogbeastspawn_2, function Trig_Init_02_Units_Func036A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Bogbeastspawn_2, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Init_02_Units_Func039A)
    call ForGroupBJ(udg_Group_BogMonsters02, function Trig_Init_02_Units_Func040A)
    // //
    // //
    call EnumDestructablesInRectAll(gg_rct_Bogbeastspawn_3, function Trig_Init_02_Units_Func043A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Bogbeastspawn_3, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Init_02_Units_Func046A)
    call ForGroupBJ(udg_Group_BogMonsters03, function Trig_Init_02_Units_Func047A)
    // //
    // Trapped Orcs
    // //
    call SetUnitAnimation(gg_unit_o60G_0010, "cinematic injured one")
    call SetUnitAnimation(gg_unit_o60G_0018, "cinematic injured two")
    call SetUnitAnimation(gg_unit_oBhS_0011, "stand ready")
    call SetUnitAnimation(gg_unit_n02F_0019, "stand ready")
    // //
    // Fire Elemental
    // //
    call ShowUnitHide(gg_unit_Nfir_0012)
    call PauseUnitBJ(true, gg_unit_Nfir_0012)
    // //
    // Angwe
    call SetUnitColor(gg_unit_n00W_0203, PLAYER_COLOR_ORANGE)
    call SetUnitInvulnerable(gg_unit_n00W_0203, true)
    // //
    // BleedingHollowGrunts
    // //
    call SetUnitAnimation(gg_unit_oGSb_0128, "cinematic standard one")
    call SetUnitAnimation(gg_unit_oGSb_0201, "cinematic standard two")
    // //
    // ScaredGrunt
    // //
    call AddSpecialEffectTargetUnitBJ("overhead", gg_unit_oGSb_0094, "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl")
    set udg_SE_ExclamationMarkBeast=GetLastCreatedEffectBJ()
    call SetUnitAnimation(gg_unit_oGSb_0094, "cinematic injured one")
    // //
    // CatapultGuard
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CatapultGuard, udg_Player_Stromgarde), function Trig_Init_02_Units_Func079A)
    // //
    // Ghost
    call ShowUnitHide(gg_unit_n00Y_0285)
    // //
    // Ghosts
    // //
    call ShowUnitHide(gg_unit_ngh1_0073)
    call ShowUnitHide(gg_unit_ngh1_0084)
    call ShowUnitHide(gg_unit_ngh1_0413)
    call ShowUnitHide(gg_unit_ngh1_0412)
    call ShowUnitHide(gg_unit_ngh1_0394)
    call ShowUnitHide(gg_unit_ngh1_0451)
    call ShowUnitHide(gg_unit_ngh1_0453)
    call ShowUnitHide(gg_unit_ngh1_0452)
    // //
    // This murlock Jumps out of the water
    call ShowUnitHide(gg_unit_nmrl_0027)
    // //
    // Recolor mountaineers
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfTypeIdAll('h61W'), function Trig_Init_02_Units_Func100A)
    // //
    // WoundedBHGrunts
    // //
    call SetUnitAnimation(gg_unit_oGSb_0205, "cinematic injured one")
    call SetUnitAnimation(gg_unit_oGSb_0206, "cinematic injured two")
    // //
    call SetUnitVertexColorBJ(gg_unit_h61U_0104, 100, 100, 100, 35.00)
    // //
    // Intro Catapults Color
    set udg_Unit_CatapultIntro[1]=gg_unit_o60P_0043
    call SetUnitColor(udg_Unit_CatapultIntro[1], PLAYER_COLOR_PURPLE)
    set udg_Unit_CatapultIntro[2]=gg_unit_o60P_0044
    call SetUnitColor(udg_Unit_CatapultIntro[2], PLAYER_COLOR_PURPLE)
    // //
    call SetUnitInvulnerable(gg_unit_n60C_0202, true)
    // //
    // Campfire Healers
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(PLAYER_NEUTRAL_PASSIVE), 'u004'), function Trig_Init_02_Units_Func120A)
    // //
    // //
    // //
    // RemoveCinematicDummies
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_CinematicDummy), function Trig_Init_02_Units_Func126002)
    // //
    // //
endfunction

