//===========================================================================
function Trig_Any_BurnTheScroll_Func001C takes nothing returns boolean
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'ICL9' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'ICL2' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'ICL1' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'ICL3' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'ICL4' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'ICL5' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'ICL6' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'ICL7' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'ICL8' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Any_BurnTheScroll_Conditions takes nothing returns boolean
    if ( not Trig_Any_BurnTheScroll_Func001C() ) then
        return false
    endif
    return true
endfunction

