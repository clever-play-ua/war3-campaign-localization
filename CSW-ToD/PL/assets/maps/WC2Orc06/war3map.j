    call DisableTrigger(GetTriggeringTrigger())
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_Stromgarde, GetRectCenter(gg_rct_ambush_2_bush1), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_Stromgarde, GetRectCenter(gg_rct_ambush_2_bush2), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_Stromgarde, GetRectCenter(gg_rct_ambush_2_bush3), bj_UNIT_FACING)
