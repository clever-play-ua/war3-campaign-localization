//===========================================================================
// Trigger: Humans Kobolds Spawn
//
// In the mine on the top right of the map. Just up north of Killrog's village. I'm making a few kobold spawn. when you get close to the cavern.
//===========================================================================
function Trig_Humans_Kobolds_Spawn_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    return true
endfunction

function Trig_Humans_Kobolds_Spawn_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Kobolt_spawn), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    set udg_SE_Dust=GetLastCreatedEffectBJ()
    call PolledWait(1.00)
    // //
    call DestroyEffectBJ(udg_SE_Dust)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Kobolt_spawn), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    set udg_SE_Dust=GetLastCreatedEffectBJ()
    call CreateNUnitsAtLoc(1, 'nkob', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(gg_rct_Kobolt_spawn), bj_UNIT_FACING)
    call PolledWait(1.00)
    // //
    call DestroyEffectBJ(udg_SE_Dust)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Kobolt_spawn), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    set udg_SE_Dust=GetLastCreatedEffectBJ()
    call CreateNUnitsAtLoc(1, 'nkob', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(gg_rct_Kobolt_spawn), bj_UNIT_FACING)
    call PolledWait(1.00)
    // //
    call DestroyEffectBJ(udg_SE_Dust)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Kobolt_spawn), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    set udg_SE_Dust=GetLastCreatedEffectBJ()
    call CreateNUnitsAtLoc(1, 'nkob', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(gg_rct_Kobolt_spawn), bj_UNIT_FACING)
    call PolledWait(1.00)
    // //
    call DestroyEffectBJ(udg_SE_Dust)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Kobolt_spawn), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    set udg_SE_Dust=GetLastCreatedEffectBJ()
    call CreateNUnitsAtLoc(1, 'nkot', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(gg_rct_Kobolt_spawn), bj_UNIT_FACING)
    set udg_Unit_KobolDropsPick=GetLastCreatedUnit()
endfunction

