//===========================================================================
// Trigger: Prisoners Cage Q
//===========================================================================
function Trig_Prisoners_Cage_Q_Func002Func003C takes nothing returns boolean
    if ( not ( udg_Int_Prisoners_Random == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Prisoners_Cage_Q_Func002C takes nothing returns boolean
    if ( not ( udg_Int_Prisoners_Random == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Prisoners_Cage_Q_Actions takes nothing returns nothing
    set udg_Int_Prisoners_Random=GetRandomInt(1, 3)
    if ( Trig_Prisoners_Cage_Q_Func002C() ) then
        call SetSpeechVolumeGroupsBJ()
        call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_BleedingHollow, 'oGSb', GetCameraTargetPositionLoc(), gg_snd_WC2Orc06BHollowGrunt_Free1, bj_TIMETYPE_ADD, 0, true)
        call VolumeGroupResetBJ()
    else
        if ( Trig_Prisoners_Cage_Q_Func002Func003C() ) then
            call SetSpeechVolumeGroupsBJ()
            call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_BleedingHollow, 'oGSb', GetCameraTargetPositionLoc(), gg_snd_WC2Orc06BHollowGrunt_Free2, bj_TIMETYPE_ADD, 0, true)
            call VolumeGroupResetBJ()
        else
            call DoNothing()
        endif
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

