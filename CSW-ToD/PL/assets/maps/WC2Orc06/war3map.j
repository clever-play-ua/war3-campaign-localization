    return ( udg_Bool_CinForlornSpiritSkipped == true )
endfunction

function Trig_Forlorn_Cinematic_Q_Func053001 takes nothing returns boolean
    return ( udg_Bool_CinForlornSpiritSkipped == true )
endfunction

function Trig_Forlorn_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_Forlorn_Cinematic_Q_Func006A)
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, GetPlayersAll())
    // //
    call UseTimeOfDayBJ(false)
    // //
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call ConditionalTriggerExecute(gg_trg_Cinematic_HideCritters)
    // //
    call SetUnitAnimationWithRarity(gg_unit_ncpn_0152, "stand", RARITY_FREQUENT)
    // //
    call ShowUnitHide(udg_Hero_Zuluhed)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // Zuluhed
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_ZuluhedSpiritCin01), 132.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Spirit02, udg_Player_Actual, 0)
    // //
    call PlaySoundBJ(gg_snd_WC3OrcDefeat)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinForlornSpiritOn=true
    set udg_Bool_CinSkipped=false
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Spirit01, udg_Player_Actual, 20.00)
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed_ForlornSpirit1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinForlornSpiritSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call SetUnitFacingToFaceUnitTimed(gg_unit_ncpn_0152, udg_FakeZuluhed, 1.00)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_ncpn_0152, 0, gg_snd_WC2Orc06ForlornSpirit1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinForlornSpiritSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed_ForlornSpirit2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinForlornSpiritSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_WC3OrcDefeat, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_ncpn_0152, 0, gg_snd_WC2Orc06ForlornSpirit2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinForlornSpiritSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Forlorn_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Forlorn_Cinematic_Q takes nothing returns nothing
    set gg_trg_Forlorn_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Forlorn_Cinematic_Q, function Trig_Forlorn_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Forlorn Cinematic Skipped
//===========================================================================
function Trig_Forlorn_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinForlornSpiritOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Forlorn_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinForlornSpiritSkipped=true
    set udg_Bool_CinSkipped=true
    call ConditionalTriggerExecute(gg_trg_Forlorn_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Forlorn_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Forlorn_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Forlorn_Cinematic_Skipped, Player(20))
    call TriggerAddCondition(gg_trg_Forlorn_Cinematic_Skipped, Condition(function Trig_Forlorn_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Forlorn_Cinematic_Skipped, function Trig_Forlorn_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Forlorn Cinematic Cleanup
//===========================================================================
function Trig_Forlorn_Cinematic_Cleanup_Func004C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Forlorn_Cinematic_Cleanup_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_CinForlornSpiritSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Forlorn_Cinematic_Cleanup_Func025C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Forlorn_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinForlornSpiritOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Forlorn_Cinematic_Cleanup_Func004C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call SetDoodadAnimationRectBJ("death", 'NOfp', GetPlayableMapRect())
    if ( Trig_Forlorn_Cinematic_Cleanup_Func007C() ) then
        call StopSoundBJ(gg_snd_WC3OrcDefeat, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed_ForlornSpirit1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed_ForlornSpirit2, false)
        call StopSoundBJ(gg_snd_WC2Orc06ForlornSpirit1, false)
        call StopSoundBJ(gg_snd_WC2Orc06ForlornSpirit2, false)
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Cinematic_ShowCritters)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call RemoveUnit(gg_unit_ncpn_0152)
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    call UseTimeOfDayBJ(true)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_SpiritDefaultCamera), 0)
    call TriggerSleepAction(0.25)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupRemoveGroup(udg_Group_SelectedUnits, udg_Group_SelectedUnits)
    call KillDestructable(gg_dest_B00U_0050)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Forlorn_Cinematic_Cleanup_Func025C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Forlorn_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_deadForlornspirit), "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    set udg_SE_CreateItem=GetLastCreatedEffectBJ()
    call CreateItemLoc('shcw', GetRectCenter(gg_rct_deadForlornspirit))
    call TriggerSleepAction(3.70)
    call DestroyEffectBJ(udg_SE_CreateItem)
endfunction

//===========================================================================
function InitTrig_Forlorn_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Forlorn_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Forlorn_Cinematic_Cleanup, function Trig_Forlorn_Cinematic_Cleanup_Actions)
endfunction

