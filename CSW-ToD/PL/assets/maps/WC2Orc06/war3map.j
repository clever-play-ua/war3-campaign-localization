    call SetSoundDuration(gg_snd_BansheePissed5, 4652)
    call SetSoundChannel(gg_snd_BansheePissed5, 0)
    call SetSoundVolume(gg_snd_BansheePissed5, 127)
    call SetSoundDistances(gg_snd_BansheePissed5, 600.0, 3500.0)
    call SetSoundDistanceCutoff(gg_snd_BansheePissed5, 3000.0)
    set gg_snd_SwampAmbience=CreateSound("Sound/Ambient/SwampAmbience.mp3", true, true, true, 1, 1, "DoodadsEAX")
