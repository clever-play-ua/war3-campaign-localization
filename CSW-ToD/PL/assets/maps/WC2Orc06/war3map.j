//***************************************************************************
//*  SetAutoFacialAnimationsOgreTwoHeaded
function SetAutoFacialAnimationsOgreTwoHeaded takes sound soundHandle,string speakerName returns nothing
    local real soundDuration= GetSoundDurationBJ(soundHandle)
    call SetDialogueSpeakerNameKey(soundHandle, speakerName)

    if ( soundDuration >= 3.808 ) then
       call SetSoundFacialAnimationLabel(soundHandle, "OgrePissed1")
       call SetSoundFacialAnimationGroupLabel(soundHandle, "BaseSD")
       call SetSoundFacialAnimationSetFilepath(soundHandle, "units/creeps/ogre/ogre_portrait.sd.animset_ingame")
