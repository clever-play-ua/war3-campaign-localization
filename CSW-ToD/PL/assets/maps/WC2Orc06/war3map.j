    call RescueUnitBJ(gg_unit_oGSb_0205, udg_Player_Actual, false)
    call SetUnitBlendTimeBJ(gg_unit_oGSb_0205, 0.15)
    // //
    call SetUnitInvulnerable(gg_unit_oGSb_0207, false)
    call RescueUnitBJ(gg_unit_oGSb_0207, udg_Player_Actual, false)
    call SetUnitBlendTimeBJ(gg_unit_oGSb_0207, 0.15)
    // //
    call SetUnitInvulnerable(gg_unit_oGSb_0206, false)
    call RescueUnitBJ(gg_unit_oGSb_0206, udg_Player_Actual, false)
    call SetUnitBlendTimeBJ(gg_unit_oGSb_0206, 0.15)
endfunction

