function Trig_Grim_KilroggRoute_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Hero_KilroggDeadeye)
    call SetUnitMoveSpeed(udg_Hero_KilroggDeadeye, 150.00)
    call BlzSetUnitRealFieldBJ(udg_Hero_KilroggDeadeye, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call PolledWait(2)
    if ( (udg_Bool_CinOutroOn == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Hero_KilroggDeadeye, "move", GetRectCenter(gg_rct_KilroggRoute00))
    set udg_Point_TempKilroggWalk=GetUnitLoc(udg_Hero_KilroggDeadeye)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_TempKilroggWalk, GetRectCenter(gg_rct_KilroggRoute00)) / GetUnitMoveSpeed(udg_Hero_KilroggDeadeye) ))
