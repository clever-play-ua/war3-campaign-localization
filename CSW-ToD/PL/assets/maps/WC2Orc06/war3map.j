function Trig_ChooseWay_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // Create Fake actors
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    // Chogall
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_CWCinChogall01), 32.86)
    call SetUnitAnimation(udg_FakeChogall, "cinematic listening one")
    // Zuluhed
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_CWCinZuluhed01), 56.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // Utok
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_CWCinUtok01), 7.00)
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call ConditionalTriggerExecute(gg_trg_Cinematic_HideCritters)
    // //
    call SetTerrainFogExBJ(0, 0.00, 6000.00, 0.05, 0.00, 20.00, 10.00)
    // //
endfunction

