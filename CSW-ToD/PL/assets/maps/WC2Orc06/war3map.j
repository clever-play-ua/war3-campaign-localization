    return ( udg_Bool_CinScaredGruntSkipped == true )
endfunction

function Trig_TheBeast_Cinematic_Q_Func050001 takes nothing returns boolean
    return ( udg_Bool_CinScaredGruntSkipped == true )
endfunction

function Trig_TheBeast_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_TheBeast_Cinematic_Q_Func006A)
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, GetPlayersAll())
    // //
    call UseTimeOfDayBJ(false)
    call ConditionalTriggerExecute(gg_trg_TheBeast_Cinematic_Setup)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ScaredGrunt01, udg_Player_Actual, 0)
    // //
    call PlaySoundBJ(gg_snd_Orc3)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinScaredGruntOn=true
    set udg_Bool_CinSkipped=false
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ScaredGrunt02, udg_Player_Actual, 30.00)
    // //
    call ConditionalTriggerExecute(gg_trg_TheBeast_Cinematic_RaiseHead)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oGSb_0094, 0, gg_snd_WC2Orc06BHollowGrunt_CrocoliskQuest1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinScaredGruntSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed_CrocoliskQuest1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinScaredGruntSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oGSb_0094, 0, gg_snd_WC2Orc06BHollowGrunt_CrocoliskQuest2a, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinScaredGruntSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oGSb_0094, 0, gg_snd_WC2Orc06BHollowGrunt_CrocoliskQuest2b, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinScaredGruntSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oGSb_0094, 0, gg_snd_WC2Orc06BHollowGrunt_CrocoliskQuest2c, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinScaredGruntSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_Orc3, true)
    call IssueTargetOrderBJ(udg_FakeZuluhed, "healingwave", gg_unit_oGSb_0094)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinScaredGruntSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ResetUnitLookAt(gg_unit_oGSb_0094)
    call SetUnitAnimation(gg_unit_oGSb_0094, "cinematic listening one")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinScaredGruntSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_TheBeast_Cinematic_Cleanup)
endfunction

