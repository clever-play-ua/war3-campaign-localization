    set gg_trg_Chogall_Discover_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Chogall_Discover_Q, function Trig_Chogall_Discover_Q_Actions)
endfunction

//===========================================================================
// Trigger: Chogall Completed
//===========================================================================
function Trig_Chogall_Completed_Conditions takes nothing returns boolean
    if ( not ( udg_Hero_Chogall == GetEnteringUnit() ) ) then
        return false
    endif
    if ( not ( IsQuestFailed(udg_MQ_Chogal) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chogall_Completed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_ChogallInCamp=true
    call PlaySoundAtPointBJ(gg_snd_Orescue, 50.00, GetRectCenter(gg_rct_GrimBatol), 0)
    call DisableTrigger(gg_trg_Chogall_Ping)
    call DestroyFogModifier(udg_VisMod_KilroggCamp)
    call DestroyMinimapIcon(udg_MinimapIcon_QChogall)
    call PolledWait(0.75)
    call PauseUnitBJ(true, udg_Hero_Chogall)
    call QueuedTriggerAddBJ(gg_trg_Chogall_Completed_Q, true)
    call QueuedTriggerAddBJ(gg_trg_Kilrogg_Cinematic_Q, true)
endfunction

//===========================================================================
function InitTrig_Chogall_Completed takes nothing returns nothing
    set gg_trg_Chogall_Completed=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Chogall_Completed, gg_rct_ReachTheCamp)
    call TriggerAddCondition(gg_trg_Chogall_Completed, Condition(function Trig_Chogall_Completed_Conditions))
    call TriggerAddAction(gg_trg_Chogall_Completed, function Trig_Chogall_Completed_Actions)
endfunction

//===========================================================================
// Trigger: Chogall Completed Q
//===========================================================================
function Trig_Chogall_Completed_Q_Actions takes nothing returns nothing
    call DestroyMinimapIcon(udg_MinimapIcon_QChogall)
    call QuestItemSetCompletedBJ(udg_QReq_ChogallEscort, true)
    call QuestItemSetCompletedBJ(udg_QReq_ChogallChogallSurvive, true)
    call QuestItemSetCompletedBJ(udg_QReq_ChogallZuluhedSurvive, true)
    call QuestSetCompletedBJ(udg_MQ_Chogal, true)
    call DestroyLeaderboardBJ(udg_Leaderboard_QuestObjectives)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3551")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

