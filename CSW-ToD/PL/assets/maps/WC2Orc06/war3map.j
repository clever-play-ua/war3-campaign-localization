//===========================================================================
// Trigger: Beast Attacked
//===========================================================================
function Trig_Beast_Attacked_Conditions takes nothing returns boolean
    if ( not ( GetAttackedUnitBJ() == udg_Unit_TheBeast ) ) then
        return false
    endif
    return true
endfunction

function Trig_Beast_Attacked_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Beast_Update_Healed)
    call SetUnitOwner(udg_Unit_TheBeast, Player(PLAYER_NEUTRAL_AGGRESSIVE), false)
endfunction

//===========================================================================
function InitTrig_Beast_Attacked takes nothing returns nothing
    set gg_trg_Beast_Attacked=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Beast_Attacked, Player(PLAYER_NEUTRAL_AGGRESSIVE), EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Beast_Attacked, Player(PLAYER_NEUTRAL_PASSIVE), EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_Beast_Attacked, Condition(function Trig_Beast_Attacked_Conditions))
    call TriggerAddAction(gg_trg_Beast_Attacked, function Trig_Beast_Attacked_Actions)
endfunction

//===========================================================================
// Trigger: Beast AttackedBySpell
//===========================================================================
function Trig_Beast_AttackedBySpell_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Beast_AttackedBySpell_Func005C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Point_Beast, udg_Point_BeastSpell) <= 128.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Beast_AttackedBySpell_Actions takes nothing returns nothing
    set udg_Point_BeastSpell=GetSpellTargetLoc()
    set udg_Point_Beast=GetUnitLoc(udg_Unit_TheBeast)
    if ( Trig_Beast_AttackedBySpell_Func005C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_Beast_Update_Healed)
        call SetUnitOwner(udg_Unit_TheBeast, Player(PLAYER_NEUTRAL_AGGRESSIVE), false)
    else
    endif
    call RemoveLocation(udg_Point_BeastSpell)
    call RemoveLocation(udg_Point_Beast)
endfunction

//===========================================================================
function InitTrig_Beast_AttackedBySpell takes nothing returns nothing
    set gg_trg_Beast_AttackedBySpell=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Beast_AttackedBySpell, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Beast_AttackedBySpell, Condition(function Trig_Beast_AttackedBySpell_Conditions))
    call TriggerAddAction(gg_trg_Beast_AttackedBySpell, function Trig_Beast_AttackedBySpell_Actions)
endfunction

