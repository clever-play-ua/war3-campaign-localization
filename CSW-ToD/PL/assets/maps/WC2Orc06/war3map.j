//===========================================================================
// Trigger: Bridge Cinematic Q
//===========================================================================
function Trig_Bridge_Cinematic_Q_Func007A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_SelectedUnits)
endfunction

function Trig_Bridge_Cinematic_Q_Func034001 takes nothing returns boolean
    return ( udg_Bool_CinBridgeCollapsedSkipped == true )
endfunction

function Trig_Bridge_Cinematic_Q_Func040001 takes nothing returns boolean
    return ( udg_Bool_CinBridgeCollapsedSkipped == true )
endfunction

function Trig_Bridge_Cinematic_Q_Func045001 takes nothing returns boolean
    return ( udg_Bool_CinBridgeCollapsedSkipped == true )
endfunction

function Trig_Bridge_Cinematic_Q_Func050001 takes nothing returns boolean
    return ( udg_Bool_CinBridgeCollapsedSkipped == true )
endfunction

function Trig_Bridge_Cinematic_Q_Func053001 takes nothing returns boolean
    return ( udg_Bool_CinBridgeCollapsedSkipped == true )
endfunction

function Trig_Bridge_Cinematic_Q_Func061001 takes nothing returns boolean
    return ( udg_Bool_CinBridgeCollapsedSkipped == true )
endfunction

function Trig_Bridge_Cinematic_Q_Func069001 takes nothing returns boolean
    return ( udg_Bool_CinBridgeCollapsedSkipped == true )
endfunction

function Trig_Bridge_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_Bridge_Cinematic_Q_Func007A)
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call ConditionalTriggerExecute(gg_trg_Bridge_Cinematic_Setup)
    call CameraSetupApplyForPlayer(true, gg_cam_Bridge01, udg_Player_Actual, 0)
    call TriggerSleepAction(0.50)
    // //
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_PostBridgeZuluhed))
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_PostBridgeUtok))
    // //
    call PlaySoundBJ(gg_snd_Tension)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinBridgeCollapseOn=true
    set udg_Bool_CinSkipped=false
    // //
    call IssuePointOrderLocBJ(udg_FakeChogall, "move", GetRectCenter(gg_rct_ChogallBridge02))
    call PauseUnitBJ(false, udg_Unit_CatapultIntro[1])
    call IssuePointOrderLocBJ(udg_Unit_CatapultIntro[1], "move", GetRectCenter(gg_rct_CatapultBridge01Dies))
    call PauseUnitBJ(false, udg_Unit_CatapultIntro[2])
    call IssuePointOrderLocBJ(udg_Unit_CatapultIntro[2], "move", GetRectCenter(gg_rct_CatapultBridge02Dies))
    // Bridge should crack here
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinBridgeCollapsedSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Bridge02, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Bridge03, udg_Player_Actual, 6.00)
    // //
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeChogall), GetRectCenter(gg_rct_ChogallBridge02)) / GetUnitMoveSpeed(udg_FakeChogall) ))
    if ( (udg_Bool_CinBridgeCollapsedSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // DestroyBridge
    call KillDestructable(gg_dest_B00T_6542)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinBridgeCollapsedSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call KillUnit(udg_Unit_CatapultIntro[1])
    call KillUnit(udg_Unit_CatapultIntro[2])
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinBridgeCollapsedSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeChogall, "cinematic angry one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc06Chogall_BrokenBridge1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinBridgeCollapsedSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_ChogallBridge02), "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidTeleportTarget.mdx")
    set udg_SE_ChogalTeleportTargetArr[1]=GetLastCreatedEffectBJ()
    call AddSpecialEffectLocBJ(udg_Point_ChogallBridgeTeleport, "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidTeleportTo.mdx")
    set udg_SE_ChogalTeleportTargetArr[2]=GetLastCreatedEffectBJ()
    call SetUnitAnimation(udg_FakeChogall, "spell")
    call TriggerSleepAction(1.20)
    if ( (udg_Bool_CinBridgeCollapsedSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPositionLoc(udg_FakeChogall, udg_Point_ChogallBridgeTeleport)
    call DestroyEffectBJ(udg_SE_ChogalTeleportTargetArr[1])
    call DestroyEffectBJ(udg_SE_ChogalTeleportTargetArr[2])
    call SetUnitAnimation(udg_FakeChogall, "cinematic proud one")
    call QueueUnitAnimationBJ(udg_FakeChogall, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc06Chogall_BrokenBridge2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinBridgeCollapsedSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Clean Up
    call ConditionalTriggerExecute(gg_trg_Bridge_Cinematic_Cleanup)
endfunction

