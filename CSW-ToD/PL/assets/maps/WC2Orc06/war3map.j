endfunction

function Trig_Final_Cinematic_Music_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundBJ(gg_snd_MUS_Marsh_UU03)
    call WaitForSoundBJ(gg_snd_MUS_Marsh_UU03, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    if ( (udg_Bool_CinOutroOn == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_MUS_Marsh_UU02)
    call WaitForSoundBJ(gg_snd_MUS_Marsh_UU02, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    if ( (udg_Bool_CinOutroOn == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_MUS_Marsh_UU01)
    call WaitForSoundBJ(gg_snd_MUS_Marsh_UU01, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    if ( (udg_Bool_CinOutroOn == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_MUS_Marsh_UU06)
    call WaitForSoundBJ(gg_snd_MUS_Marsh_UU06, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    if ( (udg_Bool_CinOutroOn == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
endfunction

