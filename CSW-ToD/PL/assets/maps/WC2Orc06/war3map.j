function Trig_TheBeast_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinScaredGruntOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_TheBeast_Cinematic_Cleanup_Func004C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call SetDoodadAnimationRectBJ("death", 'NOfp', GetPlayableMapRect())
    if ( Trig_TheBeast_Cinematic_Cleanup_Func007C() ) then
        call StopSoundBJ(gg_snd_Orc3, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed_CrocoliskQuest1, false)
        call StopSoundBJ(gg_snd_WC2Orc06BHollowGrunt_CrocoliskQuest1, false)
        call StopSoundBJ(gg_snd_WC2Orc06BHollowGrunt_CrocoliskQuest2a, false)
        call StopSoundBJ(gg_snd_WC2Orc06BHollowGrunt_CrocoliskQuest2b, false)
        call StopSoundBJ(gg_snd_WC2Orc06BHollowGrunt_CrocoliskQuest2c, false)
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Cinematic_ShowCritters)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_TheBeast_Cinematic_Cleanup_Func010A)
    call GroupRemoveGroup(udg_Group_HiddenTroops, udg_Group_HiddenTroops)
    call UseTimeOfDayBJ(true)
    call SetUnitAnimation(gg_unit_oGSb_0094, "cinematic listening one")
    call ResetUnitLookAt(gg_unit_oGSb_0094)
    call UnitShareVisionBJ(true, gg_unit_oGSb_0094, udg_Player_Actual)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_ScaredGruntDefault), 0)
    call TriggerSleepAction(0.25)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupRemoveGroup(udg_Group_SelectedUnits, udg_Group_SelectedUnits)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_TheBeast_Cinematic_Cleanup_Func025C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_TheBeast_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Beast_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

