//===========================================================================
function Trig_ChooseWay_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinChooseWayOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ChooseWay_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinChooseWaySkipped=true
    set udg_Bool_CinSkipped=true
    call ConditionalTriggerExecute(gg_trg_ChooseWay_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_ChooseWay_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_ChooseWay_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_ChooseWay_Cinematic_Skipped, Player(20))
    call TriggerAddCondition(gg_trg_ChooseWay_Cinematic_Skipped, Condition(function Trig_ChooseWay_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_ChooseWay_Cinematic_Skipped, function Trig_ChooseWay_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: ChooseWay Cinematic Cleanup
//===========================================================================
function Trig_ChooseWay_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ChooseWay_Cinematic_Cleanup_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_CinChooseWaySkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ChooseWay_Cinematic_Cleanup_Func016A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_ChooseWay_Cinematic_Cleanup_Func028C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ChooseWay_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinChooseWayOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_ChooseWay_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call SetDoodadAnimationRectBJ("death", 'NOfp', GetPlayableMapRect())
    // //
    if ( Trig_ChooseWay_Cinematic_Cleanup_Func007C() ) then
        call RemoveUnit(udg_Unit_Eye01)
        call RemoveUnit(udg_Unit_Eye02)
        call StopSoundBJ(gg_snd_MUS_Marsh_UU07, false)
        call StopSoundBJ(gg_snd_MUS_Marsh_UU08, false)
        call StopSoundBJ(gg_snd_MUS_Marsh_UU05, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall_Crosspath1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall_Crosspath2, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall_Crosspath3, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok_ChooseWay1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok_ChooseWay2, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed_ChooseWay1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed_ChooseWay2, false)
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call RemoveLocation(udg_Point_TempEye01Cinematic)
    call RemoveLocation(udg_Point_TempEye02Cinematic)
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_ChooseWayDefaultCamera), 0)
    call TriggerSleepAction(0.25)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_ChooseWay_Cinematic_Cleanup_Func016A)
    call GroupRemoveGroup(udg_Group_HiddenTroops, udg_Group_HiddenTroops)
    call ConditionalTriggerExecute(gg_trg_Cinematic_ShowCritters)
    call SetTerrainFogExBJ(0, 1000.00, 4000.00, 0.05, 68.00, 43.00, 49.00)
    call UseTimeOfDayBJ(true)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupRemoveGroup(udg_Group_SelectedUnits, udg_Group_SelectedUnits)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_ChooseWay_Cinematic_Cleanup_Func028C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_ChooseWay_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Decision_Dialog_Show)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

//===========================================================================
function InitTrig_ChooseWay_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_ChooseWay_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_ChooseWay_Cinematic_Cleanup, function Trig_ChooseWay_Cinematic_Cleanup_Actions)
endfunction

