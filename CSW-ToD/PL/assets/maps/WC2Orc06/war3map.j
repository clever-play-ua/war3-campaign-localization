function InitSounds takes nothing returns nothing
    set gg_snd_BansheeDeath=CreateSound("Units/Undead/Banshee/BansheeDeath.flac", false, true, true, 1, 1, "DefaultEAXON")
    call SetSoundParamsFromLabel(gg_snd_BansheeDeath, "BansheeDeath")
    call SetSoundDuration(gg_snd_BansheeDeath, 2379)
    call SetSoundChannel(gg_snd_BansheeDeath, 0)
    call SetSoundVolume(gg_snd_BansheeDeath, 127)
    set gg_snd_BansheePissed5=CreateSound("Units/Undead/Banshee/BansheePissed5.flac", false, true, true, 1, 9, "DefaultEAXON")
