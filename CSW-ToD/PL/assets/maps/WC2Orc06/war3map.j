//===========================================================================
// Trigger: Dwarves Ambush2
//
// When you walk inside a region, you trigger an ambush. Basically, inside the bushes, some Human archer spawns... all they need is potentially the '' ! '' fx floathing on top of their heads, to make them more clear to the players. Do that for every ambush. Since they are inside bushes, they are hard to spot.
//===========================================================================
function Trig_Dwarves_Ambush2_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(20) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n003' ) ) then
        return false
    endif
    if ( not ( udg_Bool_LeftRoadSelected == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarves_Ambush2_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_Stromgarde, GetRectCenter(gg_rct_ambush_6_bush_1), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_Stromgarde, GetRectCenter(gg_rct_ambush_6_bush_2), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_Stromgarde, GetRectCenter(gg_rct_ambush_6_bush_3), bj_UNIT_FACING)
endfunction

//===========================================================================
function InitTrig_Dwarves_Ambush2 takes nothing returns nothing
    set gg_trg_Dwarves_Ambush2=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Dwarves_Ambush2, gg_rct_Ambush_6)
    call TriggerAddCondition(gg_trg_Dwarves_Ambush2, Condition(function Trig_Dwarves_Ambush2_Conditions))
    call TriggerAddAction(gg_trg_Dwarves_Ambush2, function Trig_Dwarves_Ambush2_Actions)
endfunction

