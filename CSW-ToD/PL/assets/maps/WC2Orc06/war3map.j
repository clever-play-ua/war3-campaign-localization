    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_SlimeAnimationLoop_Actions takes nothing returns nothing
    call QueueUnitAnimationBJ(gg_unit_ndrj_0506, "attack")
    call TriggerSleepAction(1.00)
    if ( Trig_Intro_Cinematic_SlimeAnimationLoop_Func003C() ) then
        call ConditionalTriggerExecute(GetTriggeringTrigger())
    else
        call ResetUnitAnimation(gg_unit_ndrj_0506)
        call SetUnitTimeScalePercent(gg_unit_ndrj_0506, 100)
        call SetUnitOwner(gg_unit_ndrj_0506, Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    endif
endfunction

