    set gg_trg_Zuluhed_I_Earth_Shield=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Zuluhed_I_Earth_Shield, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Zuluhed_I_Earth_Shield, Condition(function Trig_Zuluhed_I_Earth_Shield_Conditions))
