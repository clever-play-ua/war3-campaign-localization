function Trig_MurlockSpawnFromHut_Func003C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nmh0' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nmh1' ) ) then
        return true
    endif
    return false
endfunction

function Trig_MurlockSpawnFromHut_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    if ( not Trig_MurlockSpawnFromHut_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_MurlockSpawnFromHut_Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_MurlockSpawnFromHut_Actions takes nothing returns nothing
    if ( Trig_MurlockSpawnFromHut_Func001C() ) then
        set udg_Point_SpawnMurlock=GetUnitLoc(GetDyingUnit())
        call CreateNUnitsAtLoc(1, 'nmrl', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Point_SpawnMurlock, GetRandomDirectionDeg())
        call RemoveLocation(udg_Point_SpawnMurlock)
    else
    endif
endfunction

