//===========================================================================
function Trig_Beast_Update_Healed_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00R' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    if ( not ( GetSpellTargetUnit() == udg_Unit_TheBeast ) ) then
        return false
    endif
    if ( not ( udg_Bool_LeftRoadSelected == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Beast_Update_Healed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Beast_Attacked)
    call CreateItemLoc('IWCE', GetRectCenter(gg_rct_EggLeft))
    call SmartCameraPanBJ(udg_Player_Actual, GetRectCenter(gg_rct_TheBeastMarker), 1.00)
    call PolledWait(1.00)
    call QueuedTriggerAddBJ(gg_trg_Beast_Update_Q, true)
    call SetUnitPathing(gg_unit_n00V_0101, false)
    call IssuePointOrderLocBJ(udg_Unit_TheBeast, "move", GetRectCenter(gg_rct_WalkAway))
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_Unit_TheBeast), GetRectCenter(gg_rct_WalkAway)) / GetUnitMoveSpeed(gg_unit_n00V_0101) ))
    call ShowUnitHide(udg_Unit_TheBeast)
    call DestroyFogModifier(udg_VisMod_Beast)
endfunction

