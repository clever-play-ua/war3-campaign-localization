function InitTrig_Prisoners_Cage_Q takes nothing returns nothing
    set gg_trg_Prisoners_Cage_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Prisoners_Cage_Q, function Trig_Prisoners_Cage_Q_Actions)
endfunction

