    set gg_trg_Prisoners_Completed_Q=CreateTrigger()
    call TriggerAddCondition(gg_trg_Prisoners_Completed_Q, Condition(function Trig_Prisoners_Completed_Q_Conditions))
    call TriggerAddAction(gg_trg_Prisoners_Completed_Q, function Trig_Prisoners_Completed_Q_Actions)
