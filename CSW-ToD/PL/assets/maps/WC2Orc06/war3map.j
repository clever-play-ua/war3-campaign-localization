//===========================================================================
// Trigger: Grim Discover Q
//===========================================================================
function Trig_Grim_Discover_Q_Actions takes nothing returns nothing
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_GBCircleOfPower), 450.00)
    set udg_VisMod_GrimBatol=GetLastCreatedFogModifier()
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_GBCircleOfPower), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_QGrimBatol=GetLastCreatedMinimapIcon()
    call QuestSetDiscoveredBJ(udg_MQGrimBatol, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3564")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

