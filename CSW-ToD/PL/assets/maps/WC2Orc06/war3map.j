//===========================================================================
function Trig_Chogal_HeroDies_Defeat_Func001C takes nothing returns boolean
    if ( ( GetDyingUnit() == udg_Hero_Zuluhed ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_Hero_Chogall ) ) then
        return true
    endif
    return false
endfunction

function Trig_Chogal_HeroDies_Defeat_Conditions takes nothing returns boolean
    if ( not Trig_Chogal_HeroDies_Defeat_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Chogal_HeroDies_Defeat_Actions takes nothing returns nothing
