//===========================================================================
function InitTrig_FaceAminationLoader takes nothing returns nothing
    set gg_trg_FaceAminationLoader=CreateTrigger()
    call TriggerAddAction(gg_trg_FaceAminationLoader, function Trig_FaceAminationLoader_Actions)
endfunction

//===========================================================================
// Trigger: Load Heroes
//===========================================================================
function Trig_Load_Heroes_Func009C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("ItemDragonAquired", "WC2Orc05", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Heroes_Actions takes nothing returns nothing
    // Cache
    call InitGameCacheBJ("WC2Horde.w3v")
    set udg_Cache=GetLastCreatedGameCacheBJ()
    // LoadHero
    call ConditionalTriggerExecute(gg_trg_Load_Zuluhed)
    call ConditionalTriggerExecute(gg_trg_Load_Utok)
    call ConditionalTriggerExecute(gg_trg_Load_Chogall)
    if ( Trig_Load_Heroes_Func009C() ) then
        set udg_Bool_ItemDragonSpawn=true
    else
    endif
endfunction

//===========================================================================
function InitTrig_Load_Heroes takes nothing returns nothing
    set gg_trg_Load_Heroes=CreateTrigger()
    call TriggerAddAction(gg_trg_Load_Heroes, function Trig_Load_Heroes_Actions)
endfunction

//===========================================================================
// Trigger: Load Zuluhed
//===========================================================================
function Trig_Load_Zuluhed_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc05", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Zuluhed_Actions takes nothing returns nothing
    // LoadHero
    if ( Trig_Load_Zuluhed_Func002C() ) then
        call RestoreUnitLocFacingAngleBJ("Zuluhed", "WC2Orc05", udg_Cache, udg_Player_DragonmawCinematic, GetRectCenter(gg_rct_LoadZuluhed), 270.00)
        set udg_Hero_Zuluhed=GetLastRestoredUnitBJ()
        call SetUnitColor(udg_Hero_Zuluhed, PLAYER_COLOR_SNOW)
    else
        call CreateNUnitsAtLoc(1, 'O61F', udg_Player_DragonmawCinematic, GetRectCenter(gg_rct_LoadZuluhed), bj_UNIT_FACING)
        set udg_Hero_Zuluhed=GetLastCreatedUnit()
        call SetUnitColor(udg_Hero_Zuluhed, PLAYER_COLOR_SNOW)
        call SetHeroLevelBJ(udg_Hero_Zuluhed, 5, false)
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00R')
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00S')
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00S')
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00U')
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00U')
        call UnitAddItemByIdSwapped('Z007', udg_Hero_Zuluhed)
    endif
    call SuspendHeroXPBJ(true, udg_Hero_Zuluhed)
endfunction

//===========================================================================
function InitTrig_Load_Zuluhed takes nothing returns nothing
    set gg_trg_Load_Zuluhed=CreateTrigger()
