    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_MarchingTroops_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_LoadZuluhedWalk01))
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_LoadUtokWalk01))
    // //
    set udg_Point_TempZuluhedCinematic=GetUnitLoc(udg_FakeZuluhed)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_IntroLock02, udg_Player_Actual, ( ( DistanceBetweenPoints(udg_Point_TempZuluhedCinematic, GetRectCenter(gg_rct_LoadZuluhedWalk01)) / GetUnitMoveSpeed(udg_FakeZuluhed) ) + 2.00 ), 0.50, 2.00, 2.00)
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_o619_0035, "move", GetRectCenter(gg_rct_IntroGruntWalk01))
    call IssuePointOrderLocBJ(gg_unit_o60G_0047, "move", GetRectCenter(gg_rct_IntroGruntWalk02))
    call IssuePointOrderLocBJ(gg_unit_o60G_0046, "move", GetRectCenter(gg_rct_IntroGruntWalk03))
    call IssuePointOrderLocBJ(gg_unit_o60G_0048, "move", GetRectCenter(gg_rct_IntroGruntWalk04))
