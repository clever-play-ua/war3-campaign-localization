//===========================================================================
// Trigger: Load Utok
//===========================================================================
function Trig_Load_Utok_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc05", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Utok_Actions takes nothing returns nothing
    // LoadHero
    if ( Trig_Load_Utok_Func002C() ) then
        call RestoreUnitLocFacingAngleBJ("Utok", "WC2Orc05", udg_Cache, udg_Player_BlackRock, GetRectCenter(gg_rct_LoadUtok), 270.00)
        set udg_SemiHero_Utok=GetLastRestoredUnitBJ()
        call SetPlayerTechResearchedSwap('RUX2', GetStoredIntegerBJ("UtokLevel", "WC2Orc05", udg_Cache), udg_Player_Actual)
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_BlackRock, GetRectCenter(gg_rct_LoadUtok), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call SetPlayerTechResearchedSwap('RUX2', 5, udg_Player_Actual)
    endif
    call ConditionalTriggerExecute(gg_trg_UtokLevelChecker)
endfunction

