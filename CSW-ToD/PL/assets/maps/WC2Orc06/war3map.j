//===========================================================================
// Trigger: Bridge Cinematic Cleanup
//===========================================================================
function Trig_Bridge_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bridge_Cinematic_Cleanup_Func009A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Bridge_Cinematic_Cleanup_Func021C takes nothing returns boolean
    if ( not ( udg_Bool_CinBridgeCollapsedSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bridge_Cinematic_Cleanup_Func029A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Bridge_Cinematic_Cleanup_Func032C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bridge_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinBridgeCollapseOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Bridge_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call SetDoodadAnimationRectBJ("death", 'NOfp', GetPlayableMapRect())
    call SetPlayerAllianceStateBJ(udg_Player_Actual, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Bridge_Cinematic_Cleanup_Func009A)
    call GroupRemoveGroup(udg_Group_HiddenTroops, udg_Group_HiddenTroops)
    call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_PostBridgeUtok), GetRectCenter(gg_rct_ChogallBridgeTeleport))
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Chogall, udg_Point_ChogallBridgeTeleport, GetRectCenter(gg_rct_PostBridgeUtok))
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_PostBridgeZuluhed), GetRectCenter(gg_rct_ChogallBridgeTeleport))
    call ConditionalTriggerExecute(gg_trg_Cinematic_ShowCritters)
    call SetTerrainFogExBJ(0, 1000.00, 4000.00, 0.05, 68.00, 43.00, 49.00)
    call UseTimeOfDayBJ(true)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_BridgeCleanUp), 0)
    call TriggerSleepAction(0.25)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    if ( Trig_Bridge_Cinematic_Cleanup_Func021C() ) then
        call StopSoundBJ(gg_snd_Tension, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall_BrokenBridge1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall_BrokenBridge2, false)
        call KillDestructable(gg_dest_B00T_6542)
        call RemoveUnit(udg_Unit_CatapultIntro[1])
        call RemoveUnit(udg_Unit_CatapultIntro[2])
        call DestroyEffectBJ(udg_SE_ChogalTeleportTargetArr[1])
        call DestroyEffectBJ(udg_SE_ChogalTeleportTargetArr[2])
    else
    endif
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    // //
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupRemoveGroup(udg_Group_SelectedUnits, udg_Group_SelectedUnits)
    // //
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Bridge_Cinematic_Cleanup_Func029A)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Bridge_Cinematic_Cleanup_Func032C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Bridge_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call EnableTrigger(gg_trg_Humans_RescueCatapult)
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_DragonmawCinematic, 'O61F', GetCameraTargetPositionLoc(), gg_snd_WC2Orc06Zuluhed_BrokenBridge1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_BlackRock, 'o605', GetCameraTargetPositionLoc(), gg_snd_WC2Orc06Utok_BrokenBridge1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
endfunction

