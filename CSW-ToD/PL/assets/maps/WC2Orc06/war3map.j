//===========================================================================
// Trigger: Humans Murlocs Spawn
//
// In the top middle puzzle, there's a village of murlocs. I tried to make it work that when you attack the murlocs, a new wave of unexpected Murlocs swims to you. To simulate the constant aggro of murlocs when you're attacking 
//===========================================================================
function Trig_Humans_Murlocs_Spawn_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n003' ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_LeftRoadSelected == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Humans_Murlocs_Spawn_Func009A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_MurlocsAttack)
endfunction

function Trig_Humans_Murlocs_Spawn_Func010A takes nothing returns nothing
    call IssuePointOrderLocBJ(GetEnumUnit(), "attack", GetUnitLoc(GetEnteringUnit()))
endfunction

function Trig_Humans_Murlocs_Spawn_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CreateNUnitsAtLoc(3, 'nmrl', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(gg_rct_spawn_murloc), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'nmrr', Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRandomLocInRect(gg_rct_spawn_murloc), bj_UNIT_FACING)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_spawn_murloc, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Humans_Murlocs_Spawn_Func009A)
    call ForGroupBJ(udg_Group_MurlocsAttack, function Trig_Humans_Murlocs_Spawn_Func010A)
endfunction

