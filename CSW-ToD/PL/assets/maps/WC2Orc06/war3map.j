// Trigger: Prisoners Completed
//===========================================================================
function Trig_Prisoners_Completed_Conditions takes nothing returns boolean
    if ( not ( udg_Int_PrisonersRemaining == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Prisoners_Completed_Func008Func002C takes nothing returns boolean
    if ( ( udg_Bool_LeftRoadSelected == true ) ) then
        return true
    endif
    if ( ( IsQuestCompleted(udg_OQ_Beast) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Prisoners_Completed_Func008C takes nothing returns boolean
    if ( not Trig_Prisoners_Completed_Func008Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Prisoners_Completed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ShowUnitHide(gg_unit_ncpn_0152)
    call ShowDestructableBJ(false, gg_dest_B00U_0050)
    call QueuedTriggerAddBJ(gg_trg_Prisoners_Completed_Q, true)
    // //
    if ( Trig_Prisoners_Completed_Func008C() ) then
        call QueuedTriggerAddBJ(gg_trg_UtokLevelUp, true)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Prisoners_Completed takes nothing returns nothing
    set gg_trg_Prisoners_Completed=CreateTrigger()
    call DisableTrigger(gg_trg_Prisoners_Completed)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Prisoners_Completed, 2.00)
    call TriggerAddCondition(gg_trg_Prisoners_Completed, Condition(function Trig_Prisoners_Completed_Conditions))
    call TriggerAddAction(gg_trg_Prisoners_Completed, function Trig_Prisoners_Completed_Actions)
endfunction

//===========================================================================
// Trigger: Prisoners Completed Q
//===========================================================================
function Trig_Prisoners_Completed_Q_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Prisoners_Completed_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_BleedingHollow, 'oGSb', GetCameraTargetPositionLoc(), gg_snd_WC2Orc06BHollowGrunt_Outnumbered1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc06Zuluhed_CrocoliskQuest5, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestItemSetCompletedBJ(udg_QReq_FreePrisoners, true)
    call QuestSetCompletedBJ(udg_OQ_Prisoners, true)
    call LeaderboardRemovePlayerItemBJ(Player(22), udg_Leaderboard_QuestObjectives)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3582")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

