//===========================================================================
// Trigger: Prisoners Discover
//===========================================================================
function Trig_Prisoners_Discover_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_LeftRoadSelected == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Prisoners_Discover_Func005C takes nothing returns boolean
    if ( not ( udg_Bool_LeftRoadSelected == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Prisoners_Discover_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_Prisoners_Completed)
    call QueuedTriggerAddBJ(gg_trg_Prisoners_Discover_Q, true)
    if ( Trig_Prisoners_Discover_Func005C() ) then
        call QueuedTriggerAddBJ(gg_trg_Prisoners_Right_Stalker_Hint_Q, true)
    else
        call QueuedTriggerAddBJ(gg_trg_Prisoners_Left_Savage_Hint_Q, true)
    endif
    call QueuedTriggerAddBJ(gg_trg_Prisoners_Lore_Hint_Q, true)
endfunction

//===========================================================================
function InitTrig_Prisoners_Discover takes nothing returns nothing
    set gg_trg_Prisoners_Discover=CreateTrigger()
    call TriggerRegisterDeathEvent(gg_trg_Prisoners_Discover, gg_dest_B00A_9911)
    call TriggerAddCondition(gg_trg_Prisoners_Discover, Condition(function Trig_Prisoners_Discover_Conditions))
    call TriggerAddAction(gg_trg_Prisoners_Discover, function Trig_Prisoners_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Prisoners Discover Q
//===========================================================================
function Trig_Prisoners_Discover_Q_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_LeftRoadSelected == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Prisoners_Discover_Q_Actions takes nothing returns nothing
    call QuestSetDiscoveredBJ(udg_OQ_Prisoners, true)
    if ( Trig_Prisoners_Discover_Q_Func002C() ) then
        call SetSpeechVolumeGroupsBJ()
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oBhS_0011, 'oBhS', gg_snd_WC2Orc06BHollowGrunt_FirstQuest2, bj_TIMETYPE_ADD, 0, true)
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc06Zuluhed_BHollowMinicamp2, bj_TIMETYPE_ADD, 0, true)
        call VolumeGroupResetBJ()
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3579")
        set udg_Int_PrisonersRemaining=6
        call CreateQuestItemBJ(udg_OQ_Prisoners, "TRIGSTR_3578")
    else
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3583")
        set udg_Int_PrisonersRemaining=4
        call CreateQuestItemBJ(udg_OQ_Prisoners, "TRIGSTR_3577")
    endif
    call LeaderboardAddItemBJ(Player(22), udg_Leaderboard_QuestObjectives, "TRIGSTR_3606", udg_Int_PrisonersRemaining)
    call LeaderboardSetPlayerItemValueColorBJ(Player(22), udg_Leaderboard_QuestObjectives, 0.00, 50.00, 0.00, 0)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(22), udg_Leaderboard_QuestObjectives, 0.00, 50.00, 0.00, 0)
    call LeaderboardSetPlayerItemStyleBJ(Player(22), udg_Leaderboard_QuestObjectives, true, true, false)
    set udg_QReq_FreePrisoners=GetLastCreatedQuestItemBJ()
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Prisoners_Discover_Q takes nothing returns nothing
    set gg_trg_Prisoners_Discover_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Prisoners_Discover_Q, function Trig_Prisoners_Discover_Q_Actions)
endfunction

