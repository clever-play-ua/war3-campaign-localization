//===========================================================================
// Trigger: Init 05 Quests
//===========================================================================
function Trig_Init_05_Quests_Actions takes nothing returns nothing
    // //
    // MAIN QUEST: CHO'GALL
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_3531", "TRIGSTR_3532", "ReplaceableTextures\\CommandButtons\\BTNChogall.BLP")
    set udg_MQ_Chogal=GetLastCreatedQuestBJ()
    // //
    call CreateQuestItemBJ(udg_MQ_Chogal, "TRIGSTR_3533")
    set udg_QReq_ChogallEscort=GetLastCreatedQuestItemBJ()
    // //
    call CreateQuestItemBJ(udg_MQ_Chogal, "TRIGSTR_3534")
    set udg_QReq_ChogallChogallSurvive=GetLastCreatedQuestItemBJ()
    // //
    call CreateQuestItemBJ(udg_MQ_Chogal, "TRIGSTR_3535")
    set udg_QReq_ChogallZuluhedSurvive=GetLastCreatedQuestItemBJ()
    // //
    // MAIN QUEST: GRIM BATOL
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3565", "TRIGSTR_3566", "ReplaceableTextures\\CommandButtons\\BTNOrcCaptureFlag.blp")
    set udg_MQGrimBatol=GetLastCreatedQuestBJ()
    // //
    call CreateQuestItemBJ(udg_MQGrimBatol, "TRIGSTR_3567")
    set udg_QReq_GrimBatolReach=GetLastCreatedQuestItemBJ()
    // //
    // OPTIONAL QUEST: PRISONERS
    // //
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_3575", "TRIGSTR_3576", "ReplaceableTextures\\CommandButtons\\BTNBleedingHollow_Grunt.dds")
    set udg_OQ_Prisoners=GetLastCreatedQuestBJ()
    // //
    // OPTIONAL QUEST: THE BEAST
    // //
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_3601", "TRIGSTR_3602", "ReplaceableTextures\\CommandButtons\\BTNSnapDragon.blp")
    set udg_OQ_Beast=GetLastCreatedQuestBJ()
    // //
    call CreateQuestItemBJ(udg_OQ_Beast, "TRIGSTR_3603")
    set udg_QReq_BeastGetRid=GetLastCreatedQuestItemBJ()
    // //
    // //
endfunction

