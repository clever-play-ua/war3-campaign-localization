    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed10, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc06Utok9, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call SetUnitFacingTimed(udg_FakeZuluhed, 110.17, 1.00)
    // //
    call SetUnitAnimation(udg_FakeKilrogg, "cinematic headnod one")
    call QueueUnitAnimationBJ(udg_FakeKilrogg, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeKilrogg, 0, gg_snd_WC2Orc06Kilrogg3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeKilrogg, "cinematic listening one")
    // //
    // Utok Walks Away
    call SetUnitAnimation(udg_FakeUtok, "cinematic salute one")
    call PlaySoundBJ(gg_snd_CS_H01b_Orc_gesture_v2)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_KilroggRoute11))
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final06, Player(20), 0.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed11, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final07, udg_Player_Actual, 10.00)
    // //
    if ( Trig_Final_Cinematic_Q_Func107C() ) then
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed12, bj_TIMETYPE_ADD, 0, true)
        if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
    else
    endif
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_Cleanup)
endfunction

