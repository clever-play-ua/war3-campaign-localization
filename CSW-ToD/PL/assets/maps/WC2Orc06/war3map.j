    if ( not ( udg_Bool_LeftRoadSelected == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kilrogg_Cinematic_Walk_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call IssuePointOrderLocBJ(udg_FakeKilrogg, "move", GetRectCenter(gg_rct_KilroggRoute01))
    set udg_Point_TempKilroggCinematic=GetUnitLoc(udg_FakeKilrogg)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_TempKilroggCinematic, GetRectCenter(gg_rct_KilroggRoute01)) / GetUnitMoveSpeed(udg_FakeKilrogg) ))
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeKilrogg, "move", GetRectCenter(gg_rct_KilroggRoute00))
    set udg_Point_TempKilroggCinematic=GetUnitLoc(udg_FakeKilrogg)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_TempKilroggCinematic, GetRectCenter(gg_rct_KilroggRoute00)) / GetUnitMoveSpeed(udg_FakeKilrogg) ))
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    if ( Trig_Kilrogg_Cinematic_Walk_Func012C() ) then
        call IssuePointOrderLocBJ(udg_FakeKilrogg, "move", GetRectCenter(gg_rct_KilroggCin01))
        set udg_Point_TempKilroggCinematic=GetUnitLoc(udg_FakeKilrogg)
        call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_TempKilroggCinematic, GetRectCenter(gg_rct_KilroggCin01)) / GetUnitMoveSpeed(udg_FakeKilrogg) ))
        if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
    else
        call IssuePointOrderLocBJ(udg_FakeKilrogg, "move", GetRectCenter(gg_rct_KilroggRoute01ALT))
        set udg_Point_TempKilroggCinematic=GetUnitLoc(udg_FakeKilrogg)
        call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_TempKilroggCinematic, GetRectCenter(gg_rct_KilroggRoute01ALT)) / GetUnitMoveSpeed(udg_FakeKilrogg) ))
        if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
    endif
endfunction

