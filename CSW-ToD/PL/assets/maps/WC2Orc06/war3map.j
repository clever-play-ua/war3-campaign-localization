    set gg_trg_Bridge_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Bridge_Cinematic_Q, function Trig_Bridge_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Bridge Cinematic Setup
//===========================================================================
function Trig_Bridge_Cinematic_Setup_Func007A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Bridge_Cinematic_Setup_Func010001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Bridge_Cinematic_Setup_Func010A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenTroops)
endfunction

function Trig_Bridge_Cinematic_Setup_Func012A takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_PostBridgeMoveTroopsHere))
endfunction

function Trig_Bridge_Cinematic_Setup_Func014A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Bridge_Cinematic_Setup_Func036C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_CatapultIntro[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bridge_Cinematic_Setup_Func039C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_CatapultIntro[2]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bridge_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call ConditionalTriggerExecute(gg_trg_Cinematic_HideCritters)
    call UseTimeOfDayBJ(false)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Bridge_Cinematic_Setup_Func007A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Bridge_Cinematic_Setup_Func010001002)), function Trig_Bridge_Cinematic_Setup_Func010A)
    // //
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Bridge_Cinematic_Setup_Func012A)
    // //
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Bridge_Cinematic_Setup_Func014A)
    // //
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    // Chogall
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_ChogallBridge01), 90.00)
    call SetUnitMoveSpeed(udg_FakeChogall, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeChogall, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    // Zuluhed
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_BidgeZuluhed), 90.00)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    // Utok
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_BridgeUtok), 90.00)
    call SetUnitMoveSpeed(udg_FakeUtok, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    // //
    if ( Trig_Bridge_Cinematic_Setup_Func036C() ) then
        call ShowUnitShow(udg_Unit_CatapultIntro[1])
        call SetUnitPositionLocFacingBJ(udg_Unit_CatapultIntro[1], GetRectCenter(gg_rct_CatapultBridge01), 90.00)
    else
        call CreateNUnitsAtLoc(1, 'o60P', Player(3), GetRectCenter(gg_rct_CatapultBridge01), 90.00)
        set udg_Unit_CatapultIntro[1]=GetLastCreatedUnit()
    endif
    call SetUnitMoveSpeed(udg_Unit_CatapultIntro[1], 150.00)
    // //
    if ( Trig_Bridge_Cinematic_Setup_Func039C() ) then
        call ShowUnitShow(udg_Unit_CatapultIntro[2])
        call SetUnitPositionLocFacingBJ(udg_Unit_CatapultIntro[2], GetRectCenter(gg_rct_CatapultBridge02), 90.00)
    else
        call CreateNUnitsAtLoc(1, 'o60P', Player(3), GetRectCenter(gg_rct_CatapultBridge02), 90.00)
        set udg_Unit_CatapultIntro[2]=GetLastCreatedUnit()
    endif
    call SetUnitMoveSpeed(udg_Unit_CatapultIntro[2], 150.00)
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Bridge_Cinematic_Setup takes nothing returns nothing
    set gg_trg_Bridge_Cinematic_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Bridge_Cinematic_Setup, function Trig_Bridge_Cinematic_Setup_Actions)
endfunction

