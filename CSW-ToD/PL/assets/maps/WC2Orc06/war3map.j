function Trig_Kilrogg_Cinematic_Cleanup_Func038C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kilrogg_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinKilroggOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Kilrogg_Cinematic_Cleanup_Func004C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call SetDoodadAnimationRectBJ("death", 'NOfp', GetPlayableMapRect())
    if ( Trig_Kilrogg_Cinematic_Cleanup_Func007C() ) then
        call StopSoundBJ(gg_snd_OrcX1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed_BHollowLastCamp1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed_BHollowLastCamp2, false)
        call StopSoundBJ(gg_snd_WC2Orc06BHollowGrunt_FinalCamp1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall_BHollowCamp1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall_BHollowCamp2, false)
        call StopSoundBJ(gg_snd_WC2Orc06Kilrogg_EnterCamp1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Kilrogg_EnterCamp2, false)
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Cinematic_ShowCritters)
    // //
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Kilrogg_Cinematic_Cleanup_Func010A)
    call GroupRemoveGroup(udg_Group_HiddenTroops, udg_Group_HiddenCritters)
    // //
    call ShowUnitShow(udg_Hero_KilroggDeadeye)
    call PauseUnitBJ(false, udg_Hero_KilroggDeadeye)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call RemoveLocation(udg_Point_TempKilroggCinematic)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Kilrogg_Cinematic_Cleanup_Func020001002)), function Trig_Kilrogg_Cinematic_Cleanup_Func020A)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BTG, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player_Actual, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_BleedingHollow, udg_Player_Actual, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BleedingHollow, bj_ALLIANCE_ALLIED_VISION)
    // //
    // //
    if ( Trig_Kilrogg_Cinematic_Cleanup_Func028C() ) then
        call KillDestructable(gg_dest_RW05_2221)
        call SetUnitPositionLocFacingLocBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_KilroggCinZuluhed02), GetRectCenter(gg_rct_KilroggCin01))
        call SetUnitPositionLocFacingLocBJ(udg_Hero_Chogall, GetRectCenter(gg_rct_KilroggCinChogall01), GetRectCenter(gg_rct_KilroggCin01))
        call SetUnitPositionLocFacingLocBJ(udg_Hero_KilroggDeadeye, GetRectCenter(gg_rct_KilroggCin01), GetRectCenter(gg_rct_KilroggCinZuluhed02))
        if ( Trig_Kilrogg_Cinematic_Cleanup_Func028Func011C() ) then
            call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_KilroggCinUtok02), GetRectCenter(gg_rct_KilroggCin01))
        else
        endif
        call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_KilroggCinDefault), 0)
    else
        call KillDestructable(gg_dest_RW04_2220)
        call SetUnitPositionLocFacingLocBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_KilroggCinZuluhed02ALT), GetRectCenter(gg_rct_KilroggRoute01ALT))
        call SetUnitPositionLocFacingLocBJ(udg_Hero_Chogall, GetRectCenter(gg_rct_ReachTheCamp), GetRectCenter(gg_rct_KilroggRoute01ALT))
        call SetUnitPositionLocFacingLocBJ(udg_Hero_KilroggDeadeye, GetRectCenter(gg_rct_KilroggRoute01ALT), GetRectCenter(gg_rct_KilroggCinZuluhed02ALT))
        if ( Trig_Kilrogg_Cinematic_Cleanup_Func028Func005C() ) then
            call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_KilroggCinUtok02ALT), GetRectCenter(gg_rct_KilroggRoute01ALT))
        else
        endif
        call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_KilroggCinDefaultAlt), 0)
    endif
    call TriggerSleepAction(0.25)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, Player(20))
    call GroupRemoveGroup(udg_Group_SelectedUnits, udg_Group_SelectedUnits)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Kilrogg_Cinematic_Cleanup_Func038C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Kilrogg_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Grim_Discover)
    call ConditionalTriggerExecute(gg_trg_Grim_KilroggRoute)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

