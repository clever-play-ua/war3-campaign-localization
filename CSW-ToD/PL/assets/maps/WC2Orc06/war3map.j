//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func030C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func038C takes nothing returns boolean
    if ( not ( udg_Bool_ItemDragonAquired == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    call ShowUnitShow(udg_Hero_Chogall)
    call ShowUnitShow(udg_SemiHero_Utok)
    call ShowUnitShow(udg_Hero_Zuluhed)
    // cache
    call TriggerSleepAction(0.10)
    // //
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Chogall, 'ICL1'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Chogall, 'ICL2'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Chogall, 'ICL3'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Chogall, 'ICL4'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Chogall, 'ICL5'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Chogall, 'ICL6'))
    // //
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'ICL1'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'ICL2'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'ICL3'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'ICL4'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'ICL5'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'ICL6'))
    // //
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'ICL1'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'ICL2'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'ICL3'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'ICL4'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'ICL5'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'ICL6'))
    // //
    call StoreUnitBJ(udg_Hero_Zuluhed, "Zuluhed", "WC2Orc06", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func030C() ) then
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc06", udg_Cache)
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_LoadUtok), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc06", udg_Cache)
    endif
    // //
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', udg_Player_Actual), "UtokLevel", "WC2Orc06", udg_Cache)
    // //
    call StoreUnitBJ(udg_Hero_Chogall, "Chogall", "WC2Orc06", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc06", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func038C() ) then
        call StoreBooleanBJ(true, "ItemDragonAquired", "WC2Orc06", udg_Cache)
        call ShowCustomCampaignButton(true, 9)
        call ShowCustomCampaignButton(true, 10)
        call SetNextLevelBJ("WC2Orc06s.w3x")
    else
        call StoreBooleanBJ(false, "ItemDragonPartsAquired", "WC2Orc06", udg_Cache)
        call ShowCustomCampaignButton(true, 10)
        call SetNextLevelBJ("WC2Orc07.w3x")
    endif
    call TriggerSleepAction(0.10)
    call SaveGameCacheBJ(udg_Cache)
    // //
    call ConditionalTriggerExecute(gg_trg_Victory)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

//===========================================================================
// Trigger: Zuluhed I Earth Shield
//===========================================================================
function Trig_Zuluhed_I_Earth_Shield_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A015' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuluhed_I_Earth_Shield_Actions takes nothing returns nothing
    // Sound: Ability_EarthShield
    call PlaySoundOnUnitBJ(gg_snd_Ability_EarthShield, 75.00, GetSpellTargetUnit())
    set udg_Zuluhed_TempPoint_item=GetUnitLoc(GetSpellTargetUnit())
    //  
    // Dummy (Spells)
    call CreateNUnitsAtLoc(1, 'u003', GetOwningPlayer(GetTriggerUnit()), udg_Zuluhed_TempPoint_item, bj_UNIT_FACING)
    set udg_Zuluhed_Dummy_item=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_Zuluhed_Dummy_item)
    // Ability: Earth Shield (Zuluhed - Effect)
    call UnitAddAbilityBJ('A016', udg_Zuluhed_Dummy_item)
    call IssueTargetOrderBJ(udg_Zuluhed_Dummy_item, "innerfire", GetSpellTargetUnit())
    //  
    call RemoveLocation(udg_Zuluhed_TempPoint_item)
endfunction

