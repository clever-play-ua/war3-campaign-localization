//===========================================================================
// Trigger: Final Cinematic Setup
//===========================================================================
function Trig_Final_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // Hide playables
    call ConditionalTriggerExecute(gg_trg_Cinematic_HideCritters)
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call ShowUnitHide(udg_Hero_Chogall)
    call ShowUnitHide(udg_SemiHero_Utok)
    call ShowUnitHide(udg_Hero_Zuluhed)
    call ShowUnitHide(udg_Hero_KilroggDeadeye)
    // Env
    call SetTerrainFogExBJ(0, 2000.00, 12500.00, 0.05, 78.00, 82.00, 92.15)
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    // Chogall
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_GBCircleOfPower), 273.55)
    call SetUnitMoveSpeed(udg_FakeChogall, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeChogall, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    // Zuluhed
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_FinalCinZuluhed), 73.50)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    // Utok
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_FinalCinUtok), 22.97)
    call SetUnitMoveSpeed(udg_FakeUtok, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeKilrogg, GetRectCenter(gg_rct_KilroggRoute13), GetRectCenter(gg_rct_GBCircleOfPower))
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_Setup takes nothing returns nothing
    set gg_trg_Final_Cinematic_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Final_Cinematic_Setup, function Trig_Final_Cinematic_Setup_Actions)
endfunction

