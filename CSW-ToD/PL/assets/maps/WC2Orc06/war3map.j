function Trig_Kilrogg_Cinematic_Walk_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinKilroggOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kilrogg_Cinematic_Walk_Func006001 takes nothing returns boolean
    return ( udg_Bool_CinKilroggSkipped == true )
endfunction

function Trig_Kilrogg_Cinematic_Walk_Func010001 takes nothing returns boolean
    return ( udg_Bool_CinKilroggSkipped == true )
endfunction

function Trig_Kilrogg_Cinematic_Walk_Func012Func004001 takes nothing returns boolean
    return ( udg_Bool_CinKilroggSkipped == true )
endfunction

