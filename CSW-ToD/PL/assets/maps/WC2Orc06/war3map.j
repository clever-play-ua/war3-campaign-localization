//===========================================================================
// Trigger: Final Cinematic Cleanup
//===========================================================================
function Trig_Final_Cinematic_Cleanup_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinOutroOn=false
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    if ( Trig_Final_Cinematic_Cleanup_Func007C() ) then
        call StopSoundBJ(gg_snd_MUS_Marsh_UU03, false)
        call StopSoundBJ(gg_snd_MUS_Marsh_UU02, false)
        call StopSoundBJ(gg_snd_MUS_Marsh_UU01, false)
        call StopSoundBJ(gg_snd_MUS_Marsh_UU06, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok8, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok9, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed9, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed10, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed11, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed12, false)
        call StopSoundBJ(gg_snd_WC2Orc06Kilrogg1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Kilrogg2, false)
        call StopSoundBJ(gg_snd_WC2Orc06Kilrogg3, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall6, false)
    else
        call DoNothing()
    endif
    // //
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Final_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Final_Cinematic_Cleanup, function Trig_Final_Cinematic_Cleanup_Actions)
endfunction

