    set gg_trg_BleedingHollow_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_BleedingHollow_Cinematic_Cleanup, function Trig_BleedingHollow_Cinematic_Cleanup_Actions)
endfunction

