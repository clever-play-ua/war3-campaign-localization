endfunction

function Trig_ChooseWay_Cinematic_Q_Func130001 takes nothing returns boolean
    return ( udg_Bool_CinChooseWaySkipped == true )
endfunction

function Trig_ChooseWay_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_ChooseWay_Cinematic_Q_Func007A)
    // //
    call ClearSelectionForPlayer(udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call ConditionalTriggerExecute(gg_trg_ChooseWay_Cinematic_Setup)
    call UseTimeOfDayBJ(false)
    call RemoveDestructable(gg_dest_B00U_5655)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_ChooseWay_Cinematic_Q_Func017001002)), function Trig_ChooseWay_Cinematic_Q_Func017A)
    // //
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_ChooseWay_Cinematic_Q_Func019A)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ChooseWay01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_ChooseWay02, udg_Player_Actual, 10.00)
    call ConditionalTriggerExecute(gg_trg_ChooseWay_Cinematic_Music)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // Cinematic Has Started
    set udg_Bool_CinChooseWayOn=true
    set udg_Bool_CinSkipped=false
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed_ChooseWay1, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(GetSoundDurationBJ(gg_snd_WC2Orc06Zuluhed_ChooseWay1))
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ChooseWay03, udg_Player_Actual, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeZuluhed, 1.00)
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeUtok, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc06Utok_ChooseWay1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeChogall, "spell")
    call QueueUnitAnimationBJ(udg_FakeChogall, "cinematic listening one")
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeChogall, 1.00)
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeChogall, 1.00)
    call TriggerSleepAction(1.00)
    call PlaySoundAtPointBJ(gg_snd_DarkSummoningLaunch1, 100, GetRectCenter(gg_rct_CWCinChogall01), 0)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CreateNUnitsAtLoc(1, 'n003', udg_Player_TwilightHammer, GetRectCenter(gg_rct_SpawnEye01), 61.00)
    set udg_Unit_Eye01=GetLastCreatedUnit()
    call SetUnitInvulnerable(udg_Unit_Eye01, true)
    call CreateNUnitsAtLoc(1, 'n003', udg_Player_TwilightHammer, GetRectCenter(gg_rct_SpawnEye02), 36.00)
    set udg_Unit_Eye02=GetLastCreatedUnit()
    call SetUnitInvulnerable(udg_Unit_Eye02, true)
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic point one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc06Utok_ChooseWay2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_Unit_Eye01, "move", GetRectCenter(gg_rct_SpawnEye01Direction))
    call IssuePointOrderLocBJ(udg_Unit_Eye02, "move", GetRectCenter(gg_rct_SpawnEyeDirection02))
    // //
    call SetUnitAnimation(udg_FakeChogall, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc06Chogall_Crosspath1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeChogall, "cineamtic listening one")
    // //
    // Dwrven Camp
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_ChooseWay_Cinematic_EyeMoveDwarves)
    call CameraSetupApplyForPlayer(true, gg_cam_DwarvenCamp, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc06Chogall_Crosspath2, bj_TIMETYPE_ADD, 0, false)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc06Chogall_Crosspath2) - 1 ))
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Human Camp
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_ChooseWay_Cinematic_EyeMoveHumans)
    call CameraSetupApplyForPlayer(true, gg_cam_StromGardeCamp, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc06Chogall_Crosspath3, bj_TIMETYPE_ADD, 0, false)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc06Chogall_Crosspath3) - 1 ))
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Crossroads
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ChooseWay03, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_ChooseWay04, udg_Player_Actual, 10.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed_ChooseWay2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_MUS_Marsh_UU05, true)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinChooseWaySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Clean up
    call ConditionalTriggerExecute(gg_trg_ChooseWay_Cinematic_Cleanup)
endfunction

