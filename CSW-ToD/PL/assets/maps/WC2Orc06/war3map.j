    if ( not ( udg_Bool_ItemDragonSpawn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonItem_WingCreate_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CreateItemLoc('I60R', GetRectCenter(gg_rct_FireElementalSpawn))
    set udg_Item_ItemDragonWings=GetLastCreatedItem()
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_FireElementalSpawn), "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    set udg_SE_CreateItem=GetLastCreatedEffectBJ()
    call TriggerSleepAction(3.70)
    call DestroyEffectBJ(udg_SE_CreateItem)
endfunction

