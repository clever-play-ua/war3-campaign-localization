    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'dIKn', udg_Player_Ironforge, GetRectCenter(gg_rct_TheBeast_deadbody12), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'dIMn', udg_Player_GhostWildhammer, GetRectCenter(gg_rct_TheBeast_deadbody14), GetRandomDirectionDeg())
