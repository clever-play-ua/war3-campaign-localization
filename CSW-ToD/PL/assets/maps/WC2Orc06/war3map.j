//===========================================================================
// Trigger: Humans Ambush1
//
// When you walk inside a region, you trigger an ambush. Basically, inside the bushes, some Human archer spawns... all they need is potentially the '' ! '' fx floathing on top of their heads, to make them more clear to the players. Do that for every ambush. Since they are inside bushes, they are hard to spot.
//===========================================================================
function Trig_Humans_Ambush1_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n003' ) ) then
        return false
    endif
    if ( not ( udg_Bool_LeftRoadSelected == true ) ) then
        return false
    endif
    return true
endfunction

