    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final04, udg_Player_Actual, 0.00)
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Final05, udg_Player_Actual, 20.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeKilrogg, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeKilrogg, 0, gg_snd_WC2Orc06Kilrogg2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
