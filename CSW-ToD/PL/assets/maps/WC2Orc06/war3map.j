    call ShowUnitShow(GetEnumUnit())
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_BleedingHollow_Cinematic_Cleanup_Func028C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_BleedingHollow_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinBleedingHollowOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_BleedingHollow_Cinematic_Cleanup_Func004C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call SetDoodadAnimationRectBJ("death", 'NOfp', GetPlayableMapRect())
    if ( Trig_BleedingHollow_Cinematic_Cleanup_Func007C() ) then
        call StopSoundBJ(gg_snd_Orc2, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed_BHollowMinicamp1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed_BHollowMinicamp2, false)
        call StopSoundBJ(gg_snd_WC2Orc06BHollowGrunt_YoursToCommand1, false)
        call StopSoundBJ(gg_snd_WC2Orc06BHollowGrunt_FirstQuest1, false)
        call StopSoundBJ(gg_snd_WC2Orc06BHollowGrunt_FirstQuest2, false)
        call StopSoundBJ(gg_snd_WC2Orc06BHollowGrunt_FirstQuest3, false)
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call ConditionalTriggerExecute(gg_trg_Cinematic_ShowCritters)
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_BleedingHollow_Cinematic_Cleanup_Func011A)
    call GroupRemoveGroup(udg_Group_HiddenTroops, udg_Group_HiddenTroops)
    call UseTimeOfDayBJ(true)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_ZuluhedBHCin), GetUnitLoc(gg_unit_oGSb_0207))
    call SetUnitAnimation(gg_unit_oGSb_0207, "cinematic listening one")
    call SetUnitAnimation(gg_unit_oGSb_0206, "cinematic listening one")
    call SetUnitAnimation(gg_unit_oGSb_0205, "cinematic listening one")
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_BleedingHollowDefault), 0)
    call TriggerSleepAction(0.25)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupRemoveGroup(udg_Group_SelectedUnits, udg_Group_SelectedUnits)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_BleedingHollow_Cinematic_Cleanup_Func028C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_BleedingHollow_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_BleedingHollow_Cinematic_Reinforcements)
    call QueuedTriggerAddBJ(gg_trg_Prisoners_Lore_Hint_Q, true)
    call EnableTrigger(gg_trg_Prisoners_Completed)
    call QueuedTriggerAddBJ(gg_trg_Prisoners_Discover_Q, true)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

