function InitTrig_Cinematic_ShowCritters takes nothing returns nothing
    set gg_trg_Cinematic_ShowCritters=CreateTrigger()
    call TriggerAddAction(gg_trg_Cinematic_ShowCritters, function Trig_Cinematic_ShowCritters_Actions)
endfunction

//===========================================================================
// Trigger: LaunchInGameMusic
//===========================================================================
function Trig_LaunchInGameMusic_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Music_CurrentVolume < 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LaunchInGameMusic_Actions takes nothing returns nothing
    call PlayMusicBJ(udg_Music_CurrentName)
    set udg_Int_C=1
    loop
        exitwhen udg_Int_C > 100
        if ( Trig_LaunchInGameMusic_Func002Func001C() ) then
            set udg_Music_CurrentVolume=( udg_Music_CurrentVolume + 1 )
            call SetMusicVolumeBJ(udg_Music_CurrentVolume)
            call TriggerSleepAction(0.02)
        else
        endif
        set udg_Int_C=udg_Int_C + 1
    endloop
endfunction

//===========================================================================
function InitTrig_LaunchInGameMusic takes nothing returns nothing
    set gg_trg_LaunchInGameMusic=CreateTrigger()
    call TriggerAddAction(gg_trg_LaunchInGameMusic, function Trig_LaunchInGameMusic_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Q
//===========================================================================
function Trig_Intro_Cinematic_Q_Func029001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // /////
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call EnableOcclusionBJ(false, udg_PlayerGroup_PlayerActual)
    // /////
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Setup)
    call TriggerSleepAction(0.50)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n001', udg_Player_TwilightHammer, GetRectCenter(gg_rct_DeadOgre), 60.00)
    call ShowUnitShow(gg_unit_ndrj_0506)
    call SetUnitTimeScalePercent(gg_unit_ndrj_0506, 50.00)
    call SetUnitAnimation(gg_unit_ndrj_0506, "attack")
    call CameraSetupApplyForPlayer(true, gg_cam_IntroLock01, udg_Player_Actual, 0)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_MarchingTroops)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Dialogue)
    // /////
    set udg_Bool_CinIntroOn=true
    set udg_Bool_CinSkipped=false
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_SlimeAnimationLoop)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DeadOgre), "Abilities\\Spells\\Orc\\Rend\\BloodBreathDamage.mdx")
    set udg_SE_Bloodsplats=GetLastCreatedEffectBJ()
    // /////
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Music)
    call PlaySoundBJ(gg_snd_WalkSwampLoop)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 4.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Cinematic Started
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Q takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Q, function Trig_Intro_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Setup
//===========================================================================
function Trig_Intro_Cinematic_Setup_Func008001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Intro_Cinematic_Setup_Func008001002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false )
endfunction

function Trig_Intro_Cinematic_Setup_Func008001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false)) // INLINED!!
endfunction

function Trig_Intro_Cinematic_Setup_Func008002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_IntroBTGForces)
endfunction

function Trig_Intro_Cinematic_Setup_Func010A takes nothing returns nothing
    call AddUnitAnimationPropertiesBJ(true, "cinematic", GetEnumUnit())
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.25)
    call SetUnitMoveSpeed(GetEnumUnit(), 100.00)
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
endfunction

function Trig_Intro_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_IntroCinematicUnitsBTG, Condition(function Trig_Intro_Cinematic_Setup_Func008001002)), function Trig_Intro_Cinematic_Setup_Func008002)
    // //
    call ForGroupBJ(udg_Group_IntroBTGForces, function Trig_Intro_Cinematic_Setup_Func010A)
    // //
    call ConditionalTriggerExecute(gg_trg_Cinematic_HideCritters)
    // //
    call TriggerSleepAction(0.01)
    call PauseUnitBJ(true, udg_Hero_Chogall)
    call ShowUnitHide(udg_Hero_Chogall)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    call ShowUnitHide(udg_Hero_Zuluhed)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    call ShowUnitHide(udg_SemiHero_Utok)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_ChogallStartGame), 48.39)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_LoadZuluhed), 270.00)
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_LoadUtok), 270.00)
    // //
    call PauseUnitBJ(true, udg_FakeKilrogg)
    call ShowUnitHide(udg_FakeKilrogg)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Setup takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Setup, function Trig_Intro_Cinematic_Setup_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Skipped
//===========================================================================
function Trig_Intro_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    set udg_Bool_CinSkipped=true
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Cinematic_Skipped, Player(20))
    call TriggerAddCondition(gg_trg_Intro_Cinematic_Skipped, Condition(function Trig_Intro_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_Skipped, function Trig_Intro_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Cleanup
//===========================================================================
function Trig_Intro_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func010C takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func036A takes nothing returns nothing
    call AddUnitAnimationPropertiesBJ(false, "cinematic", GetEnumUnit())
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.15)
    call SetUnitMoveSpeed(GetEnumUnit(), 270.00)
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
endfunction

function Trig_Intro_Cinematic_Cleanup_Func062A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_SelectedUnits)
endfunction

function Trig_Intro_Cinematic_Cleanup_Func068C takes nothing returns boolean
    if ( not ( udg_Bool_CinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinIntroOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call SetDoodadAnimationRectBJ("death", 'NOfp', GetPlayableMapRect())
    call UseTimeOfDayBJ(true)
    // MoveStarting Units
    call ConditionalTriggerExecute(gg_trg_Cinematic_ShowCritters)
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func010C() ) then
        call StopSoundBJ(gg_snd_MUS_Marsh_UU03, false)
        call StopSoundBJ(gg_snd_MUS_Marsh_UU02, false)
        call StopSoundBJ(gg_snd_MUS_Marsh_UU01, false)
        call StopSoundBJ(gg_snd_MUS_Marsh_UU06, false)
        call StopSoundBJ(gg_snd_WalkSwampLoop, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok2, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok3, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok4, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok5, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok6, false)
        call StopSoundBJ(gg_snd_WC2Orc06Utok7, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed2, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed3, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed4, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed5, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed6, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed7, false)
        call StopSoundBJ(gg_snd_WC2Orc06Zuluhed8, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall1, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall2, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall3, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall4, false)
        call StopSoundBJ(gg_snd_WC2Orc06Chogall5, false)
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call RemoveLocation(udg_Point_TempZuluhedCinematic)
    // //
    call PauseUnitBJ(false, udg_Hero_Chogall)
    call ShowUnitShow(udg_Hero_Chogall)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    call ShowUnitShow(udg_SemiHero_Utok)
    // //
    // BTG
    call SetUnitPositionLocFacingBJ(gg_unit_o619_0035, GetRectCenter(gg_rct_IntroGruntStart01), 315.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60G_0047, GetRectCenter(gg_rct_IntroGruntStart02), 315.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60G_0046, GetRectCenter(gg_rct_IntroGruntStart03), 315.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o60G_0048, GetRectCenter(gg_rct_IntroGruntStart04), 315.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o619_0036, GetRectCenter(gg_rct_IntroGruntStart05), 315.00)
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_ZuluhedStartGame), 315.00)
    call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_UtokStartGame), 315.00)
    // TwilightHammer
    call SetUnitPositionLocFacingBJ(udg_Hero_Chogall, GetRectCenter(gg_rct_ChogallStartGame), 45.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o621_0041, GetRectCenter(gg_rct_THGruntStart01), 45.00)
    call SetUnitPositionLocFacingBJ(gg_unit_o621_0039, GetRectCenter(gg_rct_THGruntStart02), 45.00)
    call ResetUnitLookAt(gg_unit_o621_0041)
    // SetTheirSpeed
    call ForGroupBJ(udg_Group_IntroBTGForces, function Trig_Intro_Cinematic_Cleanup_Func036A)
    call GroupClear(udg_Group_IntroBTGForces)
    call DestroyGroup(udg_Group_IntroBTGForces)
    // //
    // Change Hero Owners for appropriate colors in cinematic portraits 
    call SetUnitOwner(udg_SemiHero_Utok, udg_Player_Actual, false)
    call SetUnitOwner(udg_Hero_Zuluhed, udg_Player_Actual, false)
    call SetUnitOwner(udg_Hero_Chogall, udg_Player_Actual, false)
    call SetUnitColor(udg_Hero_Chogall, PLAYER_COLOR_PURPLE)
    call SelectUnitForPlayerSingle(udg_Hero_Zuluhed, udg_Player_Actual)
    // +++++++++++++++++++++++
    call ResetUnitAnimation(gg_unit_ndrj_0506)
    call SetUnitTimeScalePercent(gg_unit_ndrj_0506, 100)
    call SetUnitOwner(gg_unit_ndrj_0506, Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    call DestroyEffectBJ(udg_SE_Bloodsplats)
    // +++++++++++++++++++++++
    call SetTerrainFogExBJ(0, 1000.00, 4000.00, 0.05, 68.00, 43.00, 49.00)
    call CameraSetupApplyForPlayer(true, gg_cam_GameStart, udg_Player_Actual, 0)
    call TriggerSleepAction(0.25)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call CinematicModeBJ(false, GetPlayersAll())
    call EnableOcclusionBJ(true, udg_PlayerGroup_PlayerActual)
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call ConditionalTriggerExecute(gg_trg_Init_03_Audio)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Intro_Cinematic_Cleanup_Func062A)
    // //
    call SelectGroupBJ(udg_Group_SelectedUnits)
    call GroupRemoveGroup(udg_Group_SelectedUnits, udg_Group_SelectedUnits)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func068C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Chogall_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call ConditionalTriggerExecute(gg_trg_Creating_and_Setting_Weather)
endfunction

