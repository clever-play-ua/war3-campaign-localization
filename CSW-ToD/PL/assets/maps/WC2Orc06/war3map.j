    set gg_trg_Bridge_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Bridge_Cinematic_Cleanup, function Trig_Bridge_Cinematic_Cleanup_Actions)
endfunction

