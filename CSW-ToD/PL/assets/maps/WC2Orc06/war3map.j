function Trig_BleedingHollow_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_BleedingHollow_Cinematic_Q_Func007A)
    call ClearSelectionForPlayer(udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call UseTimeOfDayBJ(false)
    call ConditionalTriggerExecute(gg_trg_BleedingHollow_Cinematic_Setup)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_BleedingHollow01, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call PlaySoundBJ(gg_snd_Orc2)
    // //
    set udg_Bool_CinBleedingHollowOn=true
    set udg_Bool_CinSkipped=false
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_BleedingHollow02, udg_Player_Actual, 5.00)
    call SetUnitAnimation(gg_unit_oGSb_0207, "cinematic salute one")
    call QueueUnitAnimationBJ(gg_unit_oGSb_0207, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oGSb_0207, 0, gg_snd_WC2Orc06BHollowGrunt_FirstQuest1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinBleedingHollowSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_oGSb_0207, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed_BHollowMinicamp1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinBleedingHollowSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Battlefield01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Battlefield02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc06BHollowGrunt_FirstQuest2) + 2.00 ))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oGSb_0205, 0, gg_snd_WC2Orc06BHollowGrunt_FirstQuest2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinBleedingHollowSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_BleedingHollow03, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed_BHollowMinicamp2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinBleedingHollowSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call SetUnitLifePercentBJ(gg_unit_oGSb_0205, 90.00)
    call SetUnitLifePercentBJ(gg_unit_oGSb_0206, 90.00)
    call IssueTargetOrderBJ(udg_FakeZuluhed, "healingwave", gg_unit_oGSb_0205)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinBleedingHollowSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_oGSb_0205, "cinematic listening one")
    call SetUnitAnimation(gg_unit_oGSb_0206, "cinematic listening one")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinBleedingHollowSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_BleedingHollow02, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(gg_unit_oGSb_0207, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oGSb_0207, 0, gg_snd_WC2Orc06BHollowGrunt_FirstQuest3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinBleedingHollowSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_oGSb_0207, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_Orc2, true)
    // //
    call SetUnitAnimation(gg_unit_oGSb_0205, "cinematic salute one")
    call QueueUnitAnimationBJ(gg_unit_oGSb_0205, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oGSb_0205, 0, gg_snd_WC2Orc06BHollowGrunt_YoursToCommand1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinBleedingHollowSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_oGSb_0205, "cinematic listening one")
    // //
    call ConditionalTriggerExecute(gg_trg_BleedingHollow_Cinematic_Cleanup)
endfunction

