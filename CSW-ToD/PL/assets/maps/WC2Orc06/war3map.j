        local integer this= s__DelayedOrder__allocate()
        set s__DelayedOrder_u[this]=u
        set s__DelayedOrder_o[this]=ordr
        call TimerStart(NewTimerEx(this), time, false, function s__DelayedOrder_clock)
    endfunction




    
