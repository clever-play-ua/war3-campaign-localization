    call RemoveDestructable(gg_dest_B013_10352)
    call RemoveDestructable(gg_dest_B013_10351)
    call RemoveDestructable(gg_dest_YTpb_10353)
    call RemoveDestructable(gg_dest_YTpb_10354)
    call RemoveDestructable(gg_dest_YTpb_10355)
    call RemoveDestructable(gg_dest_YTpb_10356)
    call SetUnitLifePercentBJ(gg_unit_n00V_0101, 75.00)
    call QueuedTriggerAddBJ(gg_trg_Beast_Discover_Q, true)
