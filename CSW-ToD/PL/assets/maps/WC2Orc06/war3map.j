function Trig_Kilrogg_Cinematic_Cleanup_Func010A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Kilrogg_Cinematic_Cleanup_Func020001002001 takes nothing returns boolean
    return ( GetFilterUnit() != udg_SemiHero_Utok )
endfunction

function Trig_Kilrogg_Cinematic_Cleanup_Func020001002002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Kilrogg_Cinematic_Cleanup_Func020001002002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false )
endfunction

function Trig_Kilrogg_Cinematic_Cleanup_Func020001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false)) // INLINED!!
endfunction

function Trig_Kilrogg_Cinematic_Cleanup_Func020001002 takes nothing returns boolean
    return GetBooleanAnd((GetFilterUnit() != udg_SemiHero_Utok), (GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false)))) // INLINED!!
endfunction

function Trig_Kilrogg_Cinematic_Cleanup_Func020A takes nothing returns nothing
    call SetUnitOwner(GetEnumUnit(), udg_Player_BTG, false)
endfunction

