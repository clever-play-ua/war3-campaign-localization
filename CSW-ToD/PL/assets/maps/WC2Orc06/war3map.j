    set gg_trg_Beast_Completed=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Beast_Completed, gg_rct_ScaredGrunt)
    call TriggerAddCondition(gg_trg_Beast_Completed, Condition(function Trig_Beast_Completed_Conditions))
    call TriggerAddAction(gg_trg_Beast_Completed, function Trig_Beast_Completed_Actions)
endfunction

//===========================================================================
// Trigger: Beast Completed Q
//===========================================================================
function Trig_Beast_Completed_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc06Zuluhed_CrocoliskQuest4, bj_TIMETYPE_ADD, 0, true)
    call SetUnitAnimation(gg_unit_oGSb_0094, "cinematic salute one")
    call QueueUnitAnimationBJ(gg_unit_oGSb_0094, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_oGSb_0094, 'oGSb', gg_snd_WC2Orc06BHollowGrunt_CrocoliskQuest3, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call SetUnitAnimation(gg_unit_oGSb_0094, "cinematic listening one")
    call UnitShareVisionBJ(false, gg_unit_oGSb_0094, udg_Player_Actual)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Reward), "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    set udg_SE_CreateItem=GetLastCreatedEffectBJ()
    call CreateItemLoc('shtm', GetRectCenter(gg_rct_Reward))
    // //
    call QuestItemSetCompletedBJ(udg_QReq_BeastReturn, true)
    call QuestSetCompletedBJ(udg_OQ_Beast, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3593")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call DestroyEffectBJ(udg_SE_CreateItem)
    call ConditionalTriggerExecute(gg_trg_HideTheScaredGrunt)
endfunction

//===========================================================================
function InitTrig_Beast_Completed_Q takes nothing returns nothing
    set gg_trg_Beast_Completed_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Beast_Completed_Q, function Trig_Beast_Completed_Q_Actions)
endfunction

//===========================================================================
// Trigger: Beast GruntReveal
//===========================================================================
function Trig_Beast_GruntReveal_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_VisModCliffOn[13] == false ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    if ( not ( udg_Bool_LeftRoadSelected == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Beast_GruntReveal_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_VisModCliffOn[13]=true
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, gg_rct_RevealTheGrunt)
    set udg_VisMod_ScaredGrunt=GetLastCreatedFogModifier()
endfunction

//===========================================================================
