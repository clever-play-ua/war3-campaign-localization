    if ( not ( GetManipulatedItem() == udg_Item_ItemDragonWings ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonItem_WingAcquire_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call RemoveItem(udg_Item_ItemDragonWings)
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I6DX'))
    call UnitAddItemByIdSwapped('I60O', udg_Hero_Zuluhed)
    set udg_Item_DragonTotemComplete=GetLastCreatedItem()
    set udg_Bool_ItemDragonAquired=true
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc06Zuluhed_Figurine1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call TriggerSleepAction(1.00)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_SECRET, "TRIGSTR_3514")
endfunction

