function Trig_Kilrogg_Cinematic_Q_Func129001 takes nothing returns boolean
    return ( udg_Bool_CinKilroggSkipped == true )
endfunction

function Trig_Kilrogg_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_Kilrogg_Cinematic_Q_Func007A)
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call ConditionalTriggerExecute(gg_trg_Cinematic_HideCritters)
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    if ( Trig_Kilrogg_Cinematic_Q_Func014C() ) then
        call CameraSetupApplyForPlayer(true, gg_cam_KilroggCin01, udg_Player_Actual, 0)
    else
        call CameraSetupApplyForPlayer(true, gg_cam_KilroggCin01ALT, udg_Player_Actual, 0)
    endif
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Kilrogg_Cinematic_Q_Func017001002)), function Trig_Kilrogg_Cinematic_Q_Func017A)
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Kilrogg_Cinematic_Q_Func018A)
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Kilrogg_Cinematic_Q_Func019A)
    // //
    if ( Trig_Kilrogg_Cinematic_Q_Func021C() ) then
        set udg_Unit_CinSavage=gg_unit_oGSb_0317
    else
        set udg_Unit_CinSavage=gg_unit_oGSb_0182
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call PauseUnitBJ(true, udg_Hero_KilroggDeadeye)
    call ShowUnitHide(udg_Hero_KilroggDeadeye)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeKilrogg, GetRectCenter(gg_rct_KilroggRoute02), 259.09)
    call SetUnitMoveSpeed(udg_FakeKilrogg, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeKilrogg, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    // Chogall
    if ( Trig_Kilrogg_Cinematic_Q_Func033C() ) then
        call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_KilroggCinChogall01), 144.45)
    else
        call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_ReachTheCamp), 341.00)
    endif
    call SetUnitMoveSpeed(udg_FakeChogall, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeChogall, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    // Zuluhed
    if ( Trig_Kilrogg_Cinematic_Q_Func037C() ) then
        call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_KilroggCinZuluhed01), 0.00)
    else
        call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_KilroggCinZuluhed01ALT), 125.36)
    endif
    call SetUnitMoveSpeed(udg_FakeZuluhed, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    // Utok
    if ( Trig_Kilrogg_Cinematic_Q_Func041C() ) then
        call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_KilroggCinUtok01), 0.00)
    else
        call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_KilroggCinUtok01ALT), 107.17)
    endif
    call SetUnitMoveSpeed(udg_FakeUtok, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    // //
    if ( Trig_Kilrogg_Cinematic_Q_Func045C() ) then
        call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_KilroggCinUtok02))
        call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_KilroggCinZuluhed02))
    else
        call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_KilroggCinUtok02ALT))
        call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_KilroggCinZuluhed02ALT))
    endif
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    // //
    call PlaySoundBJ(gg_snd_OrcX1)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinKilroggOn=true
    set udg_Bool_CinSkipped=false
    if ( Trig_Kilrogg_Cinematic_Q_Func054C() ) then
        call CameraSetupApplyForPlayer(true, gg_cam_KilroggCin02, udg_Player_Actual, 7.00)
    else
        call CameraSetupApplyForPlayer(true, gg_cam_KilroggCin02ALT, udg_Player_Actual, 7.00)
    endif
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    if ( Trig_Kilrogg_Cinematic_Q_Func058C() ) then
        call SetUnitAnimation(gg_unit_oGSb_0314, "cinematic salute one")
        call QueueUnitAnimationBJ(gg_unit_oGSb_0314, "cinematic listening one")
    else
        call SetUnitAnimation(gg_unit_oGSb_0312, "cinematic salute one")
        call QueueUnitAnimationBJ(gg_unit_oGSb_0312, "cinematic listening one")
        // //
        call SetUnitAnimation(gg_unit_oGSb_0313, "cinematic salute one")
        call QueueUnitAnimationBJ(gg_unit_oGSb_0313, "cinematic listening one")
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed_BHollowLastCamp1, bj_TIMETYPE_ADD, 0, false)
    if ( Trig_Kilrogg_Cinematic_Q_Func061C() ) then
        call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeUtok), GetRectCenter(gg_rct_KilroggCinUtok02)) / GetUnitMoveSpeed(udg_FakeUtok) ))
    else
        call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeZuluhed), GetRectCenter(gg_rct_KilroggCinZuluhed02ALT)) / GetUnitMoveSpeed(udg_FakeZuluhed) ))
    endif
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.40)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_Unit_CinSavage, 0.60)
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_Unit_CinSavage, 0.60)
    call SetUnitFacingToFaceUnitTimed(udg_Unit_CinSavage, udg_FakeZuluhed, 0.60)
    call TriggerSleepAction(0.60)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_CinSavage, "cinematic salute one")
    if ( Trig_Kilrogg_Cinematic_Q_Func073C() ) then
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_CinSavage, 0, gg_snd_WC2Orc06BHollowGrunt_FinalCamp1a, bj_TIMETYPE_ADD, 0, false)
    else
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_CinSavage, 0, gg_snd_WC2Orc06BHollowGrunt_FinalCamp1, bj_TIMETYPE_ADD, 0, false)
    endif
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_CinSavage, "cinematic standard three")
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc06BHollowGrunt_FinalCamp1) - 2.00 ))
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_CinSavage, "cinematic listening one")
    // //
    if ( Trig_Kilrogg_Cinematic_Q_Func081C() ) then
        call CameraSetupApplyForPlayer(true, gg_cam_KilroggCin03, udg_Player_Actual, 15.00)
    else
        call CameraSetupApplyForPlayer(true, gg_cam_KilroggCin03ALT, udg_Player_Actual, 0.00)
    endif
    call ConditionalTriggerExecute(gg_trg_Kilrogg_Cinematic_Walk)
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeChogall, 0.60)
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeChogall, 0.60)
    call SetUnitFacingToFaceUnitTimed(udg_FakeChogall, udg_FakeZuluhed, 0.60)
    call SetUnitFacingToFaceUnitTimed(udg_Unit_CinSavage, udg_FakeChogall, 0.60)
    call TriggerSleepAction(0.60)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeChogall, "cinematic angry one")
    call QueueUnitAnimationBJ(udg_FakeChogall, "cinematic standard two")
    if ( Trig_Kilrogg_Cinematic_Q_Func093C() ) then
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc06Chogall_BHollowCamp1a, bj_TIMETYPE_ADD, 0, true)
    else
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc06Chogall_BHollowCamp1, bj_TIMETYPE_ADD, 0, true)
    endif
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeChogall, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06Zuluhed_BHollowLastCamp2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    if ( Trig_Kilrogg_Cinematic_Q_Func102C() ) then
        call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeKilrogg), GetRectCenter(gg_rct_KilroggCin01)) / GetUnitMoveSpeed(udg_FakeKilrogg) ))
    else
        call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeKilrogg), GetRectCenter(gg_rct_KilroggRoute01ALT)) / GetUnitMoveSpeed(udg_FakeKilrogg) ))
    endif
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(0.60)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingToFaceUnitTimed(udg_FakeKilrogg, udg_FakeZuluhed, 0.60)
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeKilrogg, 0.60)
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeKilrogg, 0.60)
    call SetUnitFacingToFaceUnitTimed(udg_FakeChogall, udg_FakeKilrogg, 0.60)
    call SetUnitFacingToFaceUnitTimed(udg_Unit_CinSavage, udg_FakeKilrogg, 0.60)
    call TriggerSleepAction(0.60)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeKilrogg, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeKilrogg, 0, gg_snd_WC2Orc06Kilrogg_EnterCamp1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeKilrogg, "cinematic listening one")
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeKilrogg, udg_FakeChogall, 1.00)
    // //
    call SetUnitAnimation(udg_FakeChogall, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc06Chogall_BHollowCamp2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeChogall, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_OrcX1, true)
    call SetUnitAnimation(udg_FakeKilrogg, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeKilrogg, 0, gg_snd_WC2Orc06Kilrogg_EnterCamp2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKilroggSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeKilrogg, "cinematic listening one")
    // //
    call ConditionalTriggerExecute(gg_trg_Kilrogg_Cinematic_Cleanup)
endfunction

