//===========================================================================
// Trigger: Init 06a Hard
//===========================================================================
function Trig_Init_06a_Hard_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_06a_Hard_Actions takes nothing returns nothing
    // Humans
    call SetPlayerTechResearchedSwap('R013', 2, udg_Player_Stromgarde)
    call SetPlayerTechResearchedSwap('R014', 2, udg_Player_Stromgarde)
    call SetPlayerTechResearchedSwap('R01A', 2, udg_Player_Stromgarde)
    call SetPlayerTechResearchedSwap('R00J', 2, udg_Player_Stromgarde)
    // Dwarves
    call SetPlayerTechResearchedSwap('RUMI', 2, udg_Player_Ironforge)
    call SetPlayerTechResearchedSwap('RArI', 2, udg_Player_Ironforge)
    call SetPlayerTechResearchedSwap('RDIF', 1, udg_Player_Ironforge)
    call SetPlayerTechResearchedSwap('RDRA', 2, udg_Player_Ironforge)
    call SetPlayerTechResearchedSwap('RBgI', 2, udg_Player_Ironforge)
endfunction

//===========================================================================
function InitTrig_Init_06a_Hard takes nothing returns nothing
    set gg_trg_Init_06a_Hard=CreateTrigger()
    call TriggerAddCondition(gg_trg_Init_06a_Hard, Condition(function Trig_Init_06a_Hard_Conditions))
    call TriggerAddAction(gg_trg_Init_06a_Hard, function Trig_Init_06a_Hard_Actions)
endfunction

