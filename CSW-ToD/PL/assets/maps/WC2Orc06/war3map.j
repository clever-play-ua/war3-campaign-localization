endfunction

function RegisterNativeEventTrigger takes integer whichIndex,integer whichEvent returns boolean
    if not IsNativeEventRegistered(whichIndex , whichEvent) then

        call SaveTriggerHandle(Table___ht, (((((s__RegisterNativeEvent__NativeEvent_table) + (whichEvent))))), (whichIndex), ( CreateTrigger())) // INLINED!!



        return true
    endif
    return false
endfunction

