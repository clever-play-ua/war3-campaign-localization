    call UnitAddItemByIdSwapped('rst1', udg_Hero_Chogall)
    call UnitAddItemByIdSwapped('brac', udg_Hero_Chogall)
    call SetUnitColor(udg_Hero_Chogall, PLAYER_COLOR_PURPLE)
