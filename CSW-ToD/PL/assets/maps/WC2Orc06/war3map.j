//===========================================================================
// Trigger: Grim DwavenGhostsFight
//===========================================================================
function Trig_Grim_DwavenGhostsFight_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    return true
endfunction

function Trig_Grim_DwavenGhostsFight_Func013A takes nothing returns nothing
    call UnitAddAbility(GetEnumUnit(), 'Aloc')
endfunction

function Trig_Grim_DwavenGhostsFight_Func016A takes nothing returns nothing
    call UnitAddAbility(GetEnumUnit(), 'Aloc')
endfunction

function Trig_Grim_DwavenGhostsFight_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerAllianceStateBJ(udg_Player_GhostDarkIron, udg_Player_Actual, bj_ALLIANCE_NEUTRAL_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_GhostWildhammer, udg_Player_Actual, bj_ALLIANCE_NEUTRAL_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_GhostWildhammer, bj_ALLIANCE_NEUTRAL_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_GhostDarkIron, bj_ALLIANCE_NEUTRAL_VISION)
    // //
    call ConditionalTriggerExecute(gg_trg_Grim_DwavenGhostsFight_Loop1)
    call ConditionalTriggerExecute(gg_trg_Grim_DwavenGhostsFight_Loop2)
    call PolledWait(0.25)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_GhostWildhammer), function Trig_Grim_DwavenGhostsFight_Func013A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_GhostDarkIron), function Trig_Grim_DwavenGhostsFight_Func016A)
endfunction

//===========================================================================
function InitTrig_Grim_DwavenGhostsFight takes nothing returns nothing
    set gg_trg_Grim_DwavenGhostsFight=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Grim_DwavenGhostsFight, gg_rct_Blink11)
    call TriggerAddCondition(gg_trg_Grim_DwavenGhostsFight, Condition(function Trig_Grim_DwavenGhostsFight_Conditions))
    call TriggerAddAction(gg_trg_Grim_DwavenGhostsFight, function Trig_Grim_DwavenGhostsFight_Actions)
endfunction

