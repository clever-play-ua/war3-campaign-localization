//===========================================================================
// Trigger: DragonItem ElementalSpawn
//===========================================================================
function Trig_DragonItem_ElementalSpawn_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonItem_ElementalSpawn_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ShowUnitShow(gg_unit_Nfir_0012)
    call SetUnitAnimation(gg_unit_Nfir_0012, "birth")
    call QueueUnitAnimationBJ(gg_unit_Nfir_0012, "stand")
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_FireElementalSpawn), "Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl")
    set udg_SE_FireElementalSpawn=GetLastCreatedEffectBJ()
    call TriggerSleepAction(1.00)
    call DestroyEffectBJ(udg_SE_FireElementalSpawn)
    call PauseUnitBJ(false, gg_unit_Nfir_0012)
endfunction

//===========================================================================
function InitTrig_DragonItem_ElementalSpawn takes nothing returns nothing
    set gg_trg_DragonItem_ElementalSpawn=CreateTrigger()
