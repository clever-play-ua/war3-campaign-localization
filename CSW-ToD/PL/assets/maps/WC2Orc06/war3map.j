    set gg_trg_Kilrogg_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Kilrogg_Cinematic_Cleanup, function Trig_Kilrogg_Cinematic_Cleanup_Actions)
endfunction

