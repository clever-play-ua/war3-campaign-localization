//===========================================================================
// Trigger: Init 05 Quests
//===========================================================================
function Trig_Init_05_Quests_Actions takes nothing returns nothing
    // MAIN QUEST: STRENGTH IN NUMBERS
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_2581", "TRIGSTR_2582", "ReplaceableTextures\\CommandButtons\\BTNOrcBattleStandard.blp")
    set udg_MQ_Strength=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQ_Strength, "TRIGSTR_2583")
    set udg_QReq_StengthBuildBarracks=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQ_Strength, "TRIGSTR_2584")
    set udg_QReq_StengthTrainGrunts=GetLastCreatedQuestItemBJ()
    // MAIN QUEST: ZUL'JIN
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_2595", "TRIGSTR_2596", "ReplaceableTextures\\CommandButtons\\BTNZuljin.dds")
    set udg_MQ_Zuljin=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQ_Zuljin, "TRIGSTR_2597")
    set udg_QReq_ZuljinRescue=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQ_Zuljin, "TRIGSTR_2598")
    set udg_QReq_ZuljinEscort=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQ_Zuljin, "TRIGSTR_2599")
    set udg_QReq_ZuljinSurvive=GetLastCreatedQuestItemBJ()
    // OPTIONAL QUEST: CRIPPLING DURNHOLDE
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2585", "TRIGSTR_2586", "ReplaceableTextures\\CommandButtons\\BTNKeep.blp")
    set udg_OQ_Durnholde=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQ_Durnholde, "TRIGSTR_2587")
    set udg_QReq_DurnholeDestroyBarracks=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_OQ_Durnholde, "TRIGSTR_2588")
    set udg_QReq_DurnholdeDestroyTownHall=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_OQ_Durnholde, "TRIGSTR_2589")
    set udg_QReq_DurnholdeDestroyFarms=GetLastCreatedQuestItemBJ()
endfunction

