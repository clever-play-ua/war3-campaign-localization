//===========================================================================
// Trigger: WaterFallBigOn
//===========================================================================
function Trig_WaterFallBigOn_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_VisWaterFallBigOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_WaterFallBigOn_Func002Func006001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == Player(0) )
endfunction

function Trig_WaterFallBigOn_Func002Func006001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_WaterFallBigOn_Func002Func006001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == Player(0)), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_WaterFallBigOn_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_WaterLakeLoop01, Condition(function Trig_WaterFallBigOn_Func002Func006001001002))) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_WaterFallBigOn_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_WaterFallBigOn_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Bool_VisWaterFallBigOn=true
        call CreateFogModifierRadiusLocBJ(true, Player(0), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_WaterLakeLoop01), 1024.00)
        set udg_VisMod_WaterFallBig=GetLastCreatedFogModifier()
        call EnableTrigger(gg_trg_WaterFallBigOff)
    else
    endif
endfunction

//===========================================================================
function InitTrig_WaterFallBigOn takes nothing returns nothing
    set gg_trg_WaterFallBigOn=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_WaterFallBigOn, 1.00)
    call TriggerAddCondition(gg_trg_WaterFallBigOn, Condition(function Trig_WaterFallBigOn_Conditions))
    call TriggerAddAction(gg_trg_WaterFallBigOn, function Trig_WaterFallBigOn_Actions)
endfunction

