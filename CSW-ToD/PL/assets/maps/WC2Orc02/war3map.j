//===========================================================================
// Trigger: Init 06a Hard
//===========================================================================
function Trig_Init_06a_Hard_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_06a_Hard_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 15000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 15000)
endfunction

//===========================================================================
function InitTrig_Init_06a_Hard takes nothing returns nothing
    set gg_trg_Init_06a_Hard=CreateTrigger()
    call TriggerAddCondition(gg_trg_Init_06a_Hard, Condition(function Trig_Init_06a_Hard_Conditions))
    call TriggerAddAction(gg_trg_Init_06a_Hard, function Trig_Init_06a_Hard_Actions)
endfunction

//===========================================================================
// Trigger: Init 06b Medium
//===========================================================================
function Trig_Init_06b_Medium_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_06b_Medium_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerHandicapXPBJ(udg_Player_Alliance, 50.00)
    call ConditionalTriggerExecute(gg_trg_Remove_Hard_Units)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 12000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 12000)
endfunction

//===========================================================================
function InitTrig_Init_06b_Medium takes nothing returns nothing
    set gg_trg_Init_06b_Medium=CreateTrigger()
    call TriggerAddCondition(gg_trg_Init_06b_Medium, Condition(function Trig_Init_06b_Medium_Conditions))
    call TriggerAddAction(gg_trg_Init_06b_Medium, function Trig_Init_06b_Medium_Actions)
endfunction

//===========================================================================
