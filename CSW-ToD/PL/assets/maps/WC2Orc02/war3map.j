    call QuestSetCompletedBJ(udg_MQ_Zuljin, true)
    call QuestMessageBJ(udg_PlayerGroup_User, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2613")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

