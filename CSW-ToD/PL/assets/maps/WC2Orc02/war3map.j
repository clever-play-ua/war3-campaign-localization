    call SetUnitOwner(gg_unit_o60O_0003, Player(PLAYER_NEUTRAL_PASSIVE), false)
    call SetUnitOwner(gg_unit_o60O_0005, Player(PLAYER_NEUTRAL_PASSIVE), false)
    call SetUnitOwner(gg_unit_o60O_0006, Player(PLAYER_NEUTRAL_PASSIVE), false)
    call SetUnitOwner(gg_unit_o60O_0007, Player(PLAYER_NEUTRAL_PASSIVE), false)
    // //
