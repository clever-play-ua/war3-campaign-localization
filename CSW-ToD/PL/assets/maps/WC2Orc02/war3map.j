    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_BridgeKillsUnits, Condition(function Trig_Durnholde_BridgeDeath_Func006001002)), function Trig_Durnholde_BridgeDeath_Func006A)
endfunction

