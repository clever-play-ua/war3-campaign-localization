//===========================================================================
// Trigger: PrepareActors
//===========================================================================
function Trig_PrepareActors_Func005001002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) )
endfunction

function Trig_PrepareActors_Func005A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PausedUnits)
endfunction

function Trig_PrepareActors_Func007002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_PrepareActors_Func012001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_PrepareActors_Func012001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false )
endfunction

function Trig_PrepareActors_Func012001002002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) != 'o60D' )
endfunction

function Trig_PrepareActors_Func012001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false), (GetUnitTypeId(GetFilterUnit()) != 'o60D')) // INLINED!!
endfunction

function Trig_PrepareActors_Func012001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false), (GetUnitTypeId(GetFilterUnit()) != 'o60D')))) // INLINED!!
endfunction

function Trig_PrepareActors_Func012A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_PrepareActors_Func014002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_PrepareActors_Actions takes nothing returns nothing
    // //
    // Pause all except Critters
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_PrepareActors_Func005001002)), function Trig_PrepareActors_Func005A)
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_PrepareActors_Func007002)
    // //
    // Hide Player Units
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_PrepareActors_Func012001002)), function Trig_PrepareActors_Func012A)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_PrepareActors_Func014002)
    // //
    call ShowUnitHide(udg_Unit_Thrall)
    // //
    // Create Fake Actors
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, true)
    // //
    call CreateNUnitsAtLoc(1, 'ORbC', Player(20), GetRectCenter(gg_rct_FakeRendInit), bj_UNIT_FACING)
    set udg_FakeRend=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'o605', Player(20), GetRectCenter(gg_rct_FakeUtokInit), bj_UNIT_FACING)
    set udg_FakeUtok=GetLastCreatedUnit()
    call SetUnitColor(udg_FakeUtok, PLAYER_COLOR_RED)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    // //
endfunction

//===========================================================================
function InitTrig_PrepareActors takes nothing returns nothing
    set gg_trg_PrepareActors=CreateTrigger()
    call TriggerAddAction(gg_trg_PrepareActors, function Trig_PrepareActors_Actions)
endfunction

