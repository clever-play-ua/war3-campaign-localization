//===========================================================================
function Trig_Load_Rend_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc01", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Rend_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Load_Rend_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Rend", "WC2Orc01", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_UrukDefault), GetRectCenter(gg_rct_Uruk03))
        set udg_Hero_Rend=GetLastRestoredUnitBJ()
        call SetUnitColor(udg_Hero_Rend, PLAYER_COLOR_COAL)
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'O617', udg_Player_Actual, GetRectCenter(gg_rct_UrukDefault), GetRectCenter(gg_rct_Uruk03))
        set udg_Hero_Rend=GetLastCreatedUnit()
        call SetHeroLevelBJ(udg_Hero_Rend, 2, false)
        call SelectHeroSkill(udg_Hero_Rend, 'A00N')
        call SelectHeroSkill(udg_Hero_Rend, 'A00O')
        call UnitAddItemByIdSwapped('I60B', udg_Hero_Rend)
        call SetUnitColor(udg_Hero_Rend, PLAYER_COLOR_COAL)
    endif
endfunction

