    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_h60B_0237, "move", GetRandomLocInRect(gg_rct_DurnholdeAttackCin))
    call PlaySoundAtPointBJ(gg_snd_CS_H01a_soldiers_walk_RtoL_a, 70.00, GetRectCenter(gg_rct_Prisoners), 50.00)
    // //
    call IssuePointOrderLocBJ(gg_unit_h60K_0210, "move", GetRandomLocInRect(gg_rct_DurnholdeAttackCin))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_h60K_0203, "move", GetRandomLocInRect(gg_rct_DurnholdeAttackCin))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_h60B_0209, "move", GetRandomLocInRect(gg_rct_DurnholdeAttackCin))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_h60K_0204, "move", GetRandomLocInRect(gg_rct_DurnholdeAttackCin))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_h60B_0207, "move", GetRandomLocInRect(gg_rct_DurnholdeAttackCin))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_h60K_0205, "move", GetRandomLocInRect(gg_rct_DurnholdeAttackCin))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_h60K_0212, "move", GetRandomLocInRect(gg_rct_DurnholdeAttackCin))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_DurnholdeCinematicCleanup)
    // //
    // //
    // //
    // //
endfunction

