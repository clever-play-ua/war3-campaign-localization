//===========================================================================
// Trigger: BarrelExplode
//===========================================================================
function Trig_BarrelExplode_Func002A takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_BarrelExplode_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnumDestructablesInCircleBJ(256.00, GetDestructableLoc(gg_dest_LTex_3613), function Trig_BarrelExplode_Func002A)
endfunction

//===========================================================================
function InitTrig_BarrelExplode takes nothing returns nothing
    set gg_trg_BarrelExplode=CreateTrigger()
    call TriggerRegisterDeathEvent(gg_trg_BarrelExplode, gg_dest_LTex_3613)
    call TriggerAddAction(gg_trg_BarrelExplode, function Trig_BarrelExplode_Actions)
endfunction

//===========================================================================
// Trigger: GolemsArise
//===========================================================================
function Trig_GolemsArise_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(0) ) ) then
        return false
    endif
    return true
endfunction

function Trig_GolemsArise_Func002A takes nothing returns nothing
    call SetUnitAnimation(GetEnumUnit(), "birth")
    call QueueUnitAnimationBJ(GetEnumUnit(), "stand")
endfunction

function Trig_GolemsArise_Func005A takes nothing returns nothing
    call ReplaceUnitBJ(GetEnumUnit(), 'ngrk', bj_UNIT_STATE_METHOD_RELATIVE)
endfunction

function Trig_GolemsArise_Func008001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'ngrk' )
endfunction

function Trig_GolemsArise_Func008A takes nothing returns nothing
    call SetUnitOwner(GetEnumUnit(), Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
endfunction

function Trig_GolemsArise_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ForGroupBJ(udg_Group_Golems, function Trig_GolemsArise_Func002A)
    call PlaySoundAtPointBJ(gg_snd_RockGolemDeath1, 100, GetRectCenter(gg_rct_RockGolems), 0)
    call PolledWait(2.30)
    call ForGroupBJ(udg_Group_Golems, function Trig_GolemsArise_Func005A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_RockGolems, Condition(function Trig_GolemsArise_Func008001002)), function Trig_GolemsArise_Func008A)
    // //
endfunction

//===========================================================================
function InitTrig_GolemsArise takes nothing returns nothing
    set gg_trg_GolemsArise=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_GolemsArise, gg_rct_RockGolems)
    call TriggerAddCondition(gg_trg_GolemsArise, Condition(function Trig_GolemsArise_Conditions))
    call TriggerAddAction(gg_trg_GolemsArise, function Trig_GolemsArise_Actions)
endfunction

//===========================================================================
// Trigger: EggSack
//===========================================================================
function Trig_EggSack_Conditions takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'DTes' ) ) then
        return false
    endif
    return true
endfunction

function Trig_EggSack_Actions takes nothing returns nothing
    set udg_Point_SpiderSpawnTemp=GetDestructableLoc(GetDyingDestructable())
    call CreateNUnitsAtLoc(1, 'nspg', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Point_SpiderSpawnTemp, GetRandomDirectionDeg())
    call RemoveLocation(udg_Point_SpiderSpawnTemp)
endfunction

//===========================================================================
function InitTrig_EggSack takes nothing returns nothing
    set gg_trg_EggSack=CreateTrigger()
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_EggSack, gg_rct_Swamp)
    call TriggerAddCondition(gg_trg_EggSack, Condition(function Trig_EggSack_Conditions))
    call TriggerAddAction(gg_trg_EggSack, function Trig_EggSack_Actions)
endfunction

