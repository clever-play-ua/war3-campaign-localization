function Trig_Init_01_Players_Actions takes nothing returns nothing
    call MeleeStartingResources()
    call EnableCreepSleepBJ(false)
    // //
    set udg_PlayerGroup_User=bj_FORCE_PLAYER[0]
    set udg_Player_Actual=Player(0)
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 50.00)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_2580")
    call SetPlayerAbilityAvailableBJ(false, 'A610', udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60O', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o613', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60Z', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60W', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60W', false, udg_Player_Actual)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_FOOD_CAP_CEILING, 75)
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Player_Actual)
    // //
    set udg_Player_Alliance=Player(1)
    call SetPlayerColorBJ(udg_Player_Alliance, PLAYER_COLOR_SNOW, true)
    call SetPlayerTechResearchedSwap('R00A', 1, udg_Player_Alliance)
    // //
    set udg_Player_DurnholdePrisoners=Player(8)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_DurnholdePrisoners)
    // //
    set udg_Player_Trolls=Player(20)
    call SetPlayerAbilityAvailableBJ(false, 'A60C', udg_Player_Trolls)
    // //
    set udg_Player_TrollVillage=Player(6)
    // //
    set udg_Player_TrollPrisoners=Player(2)
    call SetPlayerAbilityAvailableBJ(false, 'A60C', udg_Player_TrollPrisoners)
    // //
    set udg_Player_CinematicLordaeron=Player(9)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicLordaeron)
    // //
    // Alliances
    call SetPlayerAllianceStateBJ(udg_Player_Alliance, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Alliance, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TrollPrisoners, udg_Player_Trolls, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_TrollPrisoners, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TrollPrisoners, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_TrollPrisoners, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceBJ(udg_Player_Actual, ALLIANCE_PASSIVE, true, udg_Player_Trolls)
    call SetPlayerAllianceBJ(udg_Player_Trolls, ALLIANCE_PASSIVE, true, udg_Player_Actual)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Trolls, bj_ALLIANCE_NEUTRAL)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_06a_Hard)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Medium)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Easy)
    // //
    // //
    // //
endfunction

