    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuljin_EnterVillage_Func005A takes nothing returns nothing
    if ( Trig_Zuljin_EnterVillage_Func005Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Zuljin_EnterVillage_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Zuljin_EnterVillage_NotZuljin)
    call QueuedTriggerAddBJ(gg_trg_Zuljin_EnterVillage_Q, true)
    set udg_Bool_ZuljinInTheVillage=true
    call EnumDestructablesInRectAll(gg_rct_PathingBlockersTV, function Trig_Zuljin_EnterVillage_Func005A)
    call IssuePointOrderLocBJ(gg_unit_o60O_0036, "move", GetRectCenter(gg_rct_TrollThrower02))
    call TriggerSleepAction(0.30)
    call SetUnitFacingToFaceUnitTimed(gg_unit_o60O_0036, udg_Hero_Zuljin, 0.20)
    call IssuePointOrderLocBJ(gg_unit_o60O_0035, "move", GetRectCenter(gg_rct_TrollThrower01))
    call TriggerSleepAction(0.30)
    call SetUnitFacingToFaceUnitTimed(gg_unit_o60O_0035, udg_Hero_Zuljin, 0.20)
    call IssuePointOrderLocBJ(gg_unit_nftt_0114, "move", GetRectCenter(gg_rct_Woljeen))
    call TriggerSleepAction(1.20)
    call SetUnitFacingToFaceUnitTimed(gg_unit_nftt_0114, udg_Hero_Zuljin, 0.20)
    call SetUnitFacingToFaceUnitTimed(gg_unit_o60O_0034, udg_Hero_Zuljin, 0.20)
    call SetUnitFacingToFaceUnitTimed(gg_unit_o60O_0037, udg_Hero_Zuljin, 0.20)
endfunction

