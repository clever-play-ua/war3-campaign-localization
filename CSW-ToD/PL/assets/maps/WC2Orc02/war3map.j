    call StopSoundBJ(gg_snd_Comradeship, false)
    call StopSoundBJ(gg_snd_WC2Orc02ZulJin4, false)
    call StopSoundBJ(gg_snd_WC2Orc02ZulJin5, false)
    call StopSoundBJ(gg_snd_WC2Orc02Rend14, false)
    call StopSoundBJ(gg_snd_WC2Orc02Rend15, false)
    call TriggerSleepAction(0.10)
    call TriggerExecute(gg_trg_Next_Level_Prep)
endfunction

