// Trigger: RemoveActors
//===========================================================================
function Trig_RemoveActors_Func001002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_RemoveActors_Func002002 takes nothing returns nothing
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_PausedUnits)
endfunction

function Trig_RemoveActors_Func003002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_RemoveActors_Func004002 takes nothing returns nothing
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_RemoveActors_Actions takes nothing returns nothing
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_RemoveActors_Func001002)
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_RemoveActors_Func002002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_RemoveActors_Func003002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_RemoveActors_Func004002)
    call ShowUnitShow(udg_Unit_Thrall)
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', false, false)
    call RemoveUnit(udg_FakeRend)
    call RemoveUnit(udg_FakeUtok)
endfunction

