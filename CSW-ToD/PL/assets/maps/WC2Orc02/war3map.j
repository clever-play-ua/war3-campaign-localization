//===========================================================================
// Trigger: Trolls Rescue Q
//===========================================================================
function Trig_Trolls_Rescue_Q_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Trolls_Rescue_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SmartCameraPanBJ(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_Game_Camera), 1.00)
    call TriggerSleepAction(1.00)
    call RescueUnitBJ(gg_unit_o60O_0015, udg_Player_Actual, false)
    call RescueUnitBJ(gg_unit_o60O_0016, udg_Player_Actual, false)
    call SelectUnitAddForPlayer(gg_unit_o60O_0015, udg_Player_Actual)
    call SelectUnitAddForPlayer(gg_unit_o60O_0016, udg_Player_Actual)
    call IssuePointOrderLocBJ(gg_unit_o60O_0015, "move", GetRectCenter(gg_rct_Troll01))
    call IssuePointOrderLocBJ(gg_unit_o60O_0016, "move", GetRectCenter(gg_rct_Troll02))
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_User, udg_Player_Trolls, 'o60O', GetCameraTargetPositionLoc(), gg_snd_WC2Orc02Troll7, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Trolls_Rescue_Q takes nothing returns nothing
    set gg_trg_Trolls_Rescue_Q=CreateTrigger()
    call TriggerAddCondition(gg_trg_Trolls_Rescue_Q, Condition(function Trig_Trolls_Rescue_Q_Conditions))
    call TriggerAddAction(gg_trg_Trolls_Rescue_Q, function Trig_Trolls_Rescue_Q_Actions)
endfunction

