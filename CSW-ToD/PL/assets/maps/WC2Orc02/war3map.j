function config takes nothing returns nothing
    call SetMapName("TRIGSTR_001")
    call SetMapDescription("TRIGSTR_430")
    call SetPlayers(5)
    call SetTeams(5)
    call SetGamePlacement(MAP_PLACEMENT_USE_MAP_SETTINGS)

    call DefineStartLocation(0, 6336.0, - 4480.0)
    call DefineStartLocation(1, - 320.0, 1664.0)
    call DefineStartLocation(2, 320.0, 5760.0)
    call DefineStartLocation(3, 832.0, 5888.0)
    call DefineStartLocation(4, - 2816.0, - 4480.0)

    // Player setup
    call InitCustomPlayerSlots()
    call InitCustomTeams()
    call InitAllyPriorities()
endfunction




