//===========================================================================
// Trigger: Zuljin Completed
//===========================================================================
function Trig_Zuljin_Completed_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == gg_unit_O60B_0004 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuljin_Completed_Func017001 takes nothing returns boolean
    return ( IsQuestCompleted(udg_MQ_Strength) == true )
endfunction

function Trig_Zuljin_Completed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_AllUnitsDead_Defeat)
    call SetUnitInvulnerable(udg_Hero_Zuljin, true)
    call DisableTrigger(gg_trg_Zuljin_Ping)
    call DestroyMinimapIcon(udg_MinimapIcon_Zuljin[2])
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_TrollVillage, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_TrollVillage, udg_Player_Actual, bj_ALLIANCE_ALLIED_VISION)
    call PolledWait(1.00)
    call SetUnitOwner(udg_Hero_Zuljin, udg_Player_Trolls, false)
    call UnitRemoveAbilityBJ('A60C', udg_Hero_Zuljin)
    call PlaySoundOnUnitBJ(gg_snd_Orescue, 100, gg_unit_n60A_0030)
    call SetUnitAnimation(gg_unit_nfsh_0031, "spell")
    call TriggerSleepAction(1.50)
    call ResetUnitAnimation(gg_unit_nfsh_0031)
    call PolledWait(2)
    call QueuedTriggerAddBJ(gg_trg_Zuljin_Completed_Q, true)
    loop
        exitwhen ( (IsQuestCompleted(udg_MQ_Strength) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    call QueuedTriggerAddBJ(gg_trg_FinalCinematicQ, true)
endfunction

