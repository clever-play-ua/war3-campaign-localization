//===========================================================================
// Trigger: Zuljin Discover Q
//===========================================================================
function Trig_Zuljin_Discover_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitOwner(gg_unit_n60A_0030, udg_Player_Actual, true)
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Trolls), 400.00)
    set udg_VisMod_Zuljin=GetLastCreatedFogModifier()
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Troll_Village), 400.00)
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_Trolls), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Zuljin[1]=GetLastCreatedMinimapIcon()
    // //
    call PingMinimapLocForForce(bj_FORCE_PLAYER[0], GetRectCenter(gg_rct_Trolls), 7.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_Trolls))
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_ZulJeen), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Zuljin[2]=GetLastCreatedMinimapIcon()
    call PingMinimapLocForForce(bj_FORCE_PLAYER[0], GetRectCenter(gg_rct_Troll_Village), 7.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_Troll_Village))
    // //
    call QuestSetDiscoveredBJ(udg_MQ_Zuljin, true)
    call QuestMessageBJ(udg_PlayerGroup_User, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2611")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

