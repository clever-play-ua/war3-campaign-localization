//===========================================================================
// Trigger: FinalCinematicCleanUp
//===========================================================================
function Trig_FinalCinematicCleanUp_Func009002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_FinalCinematicCleanUp_Func012001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_FinalCinematicCleanUp_Func012002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_FinalCinematicCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CinematicFilterGenericBJ(2, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100, 100, 100, 100, 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(3.00)
    // //
    call SetUnitOwner(udg_Hero_Zuljin, udg_Player_TrollVillage, false)
    call SetUnitOwner(udg_Hero_Rend, udg_Player_Actual, false)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'opeo'), function Trig_FinalCinematicCleanUp_Func009002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_FinalCinematicCleanUp_Func012001002)), function Trig_FinalCinematicCleanUp_Func012002)
    // //
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', false, false)
    call TriggerSleepAction(0.10)
    call TriggerExecute(gg_trg_Next_Level_Prep)
endfunction

//===========================================================================
