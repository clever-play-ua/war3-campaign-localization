//===========================================================================
function Trig_BlowContainer_Conditions takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'LTex' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlowContainer_Func002A takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_BlowContainer_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnumDestructablesInCircleBJ(128.00, GetDestructableLoc(GetDyingDestructable()), function Trig_BlowContainer_Func002A)
endfunction

//===========================================================================
function InitTrig_BlowContainer takes nothing returns nothing
    set gg_trg_BlowContainer=CreateTrigger()
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_BlowContainer, gg_rct_Blow)
    call TriggerAddCondition(gg_trg_BlowContainer, Condition(function Trig_BlowContainer_Conditions))
    call TriggerAddAction(gg_trg_BlowContainer, function Trig_BlowContainer_Actions)
endfunction

//===========================================================================
// Trigger: SnowcapsOn
//===========================================================================
function Trig_SnowcapsOn_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'o614' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SnowcapsOn_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'o610' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SnowcapsOn_Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'o60X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SnowcapsOn_Func004C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'o60Z' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SnowcapsOn_Actions takes nothing returns nothing
    if ( Trig_SnowcapsOn_Func001C() ) then
        call UnitAddAbilityBJ('A61M', GetConstructedStructure())
    else
    endif
    if ( Trig_SnowcapsOn_Func002C() ) then
        call UnitAddAbilityBJ('A630', GetConstructedStructure())
    else
    endif
    if ( Trig_SnowcapsOn_Func003C() ) then
        call UnitAddAbilityBJ('A62Z', GetConstructedStructure())
    else
    endif
    if ( Trig_SnowcapsOn_Func004C() ) then
        call UnitAddAbilityBJ('A631', GetConstructedStructure())
    else
    endif
endfunction

