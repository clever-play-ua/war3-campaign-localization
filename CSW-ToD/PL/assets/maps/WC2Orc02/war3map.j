endfunction

//===========================================================================
// Trigger: Zuljin Update
//===========================================================================
function Trig_Zuljin_Update_Conditions takes nothing returns boolean
    if ( not ( IsQuestItemCompleted(udg_QReq_ZuljinRescue) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuljin_Update_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_ZuljinFreed=true
    call SetDestructableInvulnerableBJ(gg_dest_B61O_4408, false)
    call SetDestructableInvulnerableBJ(gg_dest_B61N_4406, false)
    call SetDestructableInvulnerableBJ(gg_dest_B61O_4435, false)
    call SetDestructableInvulnerableBJ(gg_dest_B61N_4437, false)
    call TriggerSleepAction(0.50)
    call KillDestructable(gg_dest_B61N_4437)
    call KillDestructable(gg_dest_B61N_4406)
    call KillDestructable(gg_dest_B61O_4435)
    call KillDestructable(gg_dest_B61O_4408)
    call SmartCameraPanBJ(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_Saving_ZulJeen), 1.00)
    call TriggerSleepAction(1.00)
    call ResetUnitAnimation(gg_unit_O60B_0004)
    call ResetUnitAnimation(gg_unit_o60O_0003)
    call ResetUnitAnimation(gg_unit_o60O_0007)
    call ResetUnitAnimation(gg_unit_o60O_0006)
    call ResetUnitAnimation(gg_unit_o60O_0005)
    call RescueUnitBJ(gg_unit_o60O_0005, udg_Player_Actual, false)
    call RescueUnitBJ(gg_unit_o60O_0006, udg_Player_Actual, false)
    call RescueUnitBJ(gg_unit_o60O_0007, udg_Player_Actual, false)
    call RescueUnitBJ(gg_unit_o60O_0003, udg_Player_Actual, false)
    call RescueUnitBJ(udg_Hero_Zuljin, udg_Player_Actual, false)
    call UnitAddAbilityBJ('A60C', udg_Hero_Zuljin)
    call DestroyFogModifier(udg_VisMod_Zuljin)
    call QueuedTriggerAddBJ(gg_trg_Zuljin_Update_Q, true)
endfunction

//===========================================================================
