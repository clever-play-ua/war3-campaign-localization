    set gg_trg_IntroCinematicCleanup=CreateTrigger()
    call TriggerAddCondition(gg_trg_IntroCinematicCleanup, Condition(function Trig_IntroCinematicCleanup_Conditions))
    call TriggerAddAction(gg_trg_IntroCinematicCleanup, function Trig_IntroCinematicCleanup_Actions)
endfunction

//===========================================================================
// Trigger: TrollsCinematicQ
//===========================================================================
function Trig_TrollsCinematicQ_Func027001 takes nothing returns boolean
    return ( udg_Bool_CinematicTrollSkipped == true )
endfunction

function Trig_TrollsCinematicQ_Func031001 takes nothing returns boolean
