endfunction

function Trig_WaterFallBigOff_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_WaterLakeLoop01, Condition(function Trig_WaterFallBigOff_Func002Func005001001002))) <= 0 ) ) then
        return false
    endif
    return true
