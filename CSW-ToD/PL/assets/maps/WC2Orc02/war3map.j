function Trig_DurnholdeCinematicQ_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, bj_FORCE_PLAYER[0])
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinematicSkipped=false
    // //
    call ConditionalTriggerExecute(gg_trg_PrepareActors)
    // //
    call ConditionalTriggerExecute(gg_trg_DurnholdeCinematicSetup)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Durnholde03, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    // Cinematic Started
    // //
    set udg_Bool_CinematicDurnholde=true
    // //
    call PlaySoundBJ(gg_snd_Tension)
    // //
    call SetUnitFacingTimed(udg_Unit_DurnholdeFootman, 225.00, 10.00)
    // //
    call SetCameraFieldForPlayer(udg_Player_Actual, CAMERA_FIELD_FIELD_OF_VIEW, 60.00, 10.00)
    // //
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_Unit_DurnholdeFootman, gg_unit_h616_0197, 0)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Durnholde01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Durnholde02, udg_Player_Actual, 10.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_DurnholdeFootman, "stand Victory")
    call QueueUnitAnimationBJ(udg_Unit_DurnholdeFootman, "stand")
    call TriggerSleepAction(0.30)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundOnUnitBJ(gg_snd_MetalMediumBashMetal2, 100, udg_Unit_DurnholdeFootman)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundOnUnitBJ(gg_snd_FootmanYesAttack3, 100, udg_Unit_DurnholdeFootman)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ForGroupBJ(udg_Group_DurnholdeGarrison, function Trig_DurnholdeCinematicQ_Func057A)
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_H01a_soldiers_cheer_006_LR_v3, 100.00, gg_unit_h616_0197)
    call TriggerSleepAction(2.33)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueTargetDestructableOrder(gg_unit_h60K_0210, "attack", gg_dest_DTlv_1259)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillDestructable(gg_dest_DTlv_1259)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicDurnholdeSkipped == true) ) then // INLINED!!
        return
    else
