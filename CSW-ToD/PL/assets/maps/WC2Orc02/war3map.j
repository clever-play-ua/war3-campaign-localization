    set gg_trg_Durnholde_UpdateCompleted_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Durnholde_UpdateCompleted_Q, function Trig_Durnholde_UpdateCompleted_Q_Actions)
endfunction

