    if RegisterNativeEventTrigger(bj_MAX_PLAYER_SLOTS , eventId) then
        set t=(GetIndexNativeEventTrigger(bj_MAX_PLAYER_SLOTS , (eventId))) // INLINED!!
        loop
            call TriggerRegisterPlayerUnitEvent(t, Player(index), whichEvent, null)
            set index=index + 1
