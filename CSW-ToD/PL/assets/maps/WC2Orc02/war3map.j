    endif
    // //
    call SetUnitAnimation(gg_unit_h60K_0210, "Cinematic Point One")
    call QueueUnitAnimationBJ(gg_unit_h60K_0210, "stand")
    call PlaySoundOnUnitBJ(gg_snd_FootmanWarcry1, 70.00, gg_unit_h60K_0210)
    // //
