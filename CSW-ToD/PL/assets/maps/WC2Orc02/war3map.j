    if ( not ( GetRandomInt(1, 3) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Durnholde_BarracksTrain_Func002C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Durnholde_BarracksTrain_Actions takes nothing returns nothing
    if ( Trig_Durnholde_BarracksTrain_Func002C() ) then
        if ( Trig_Durnholde_BarracksTrain_Func002Func003C() ) then
            call IssueTrainOrderByIdBJ(udg_Unit_DurnholdeBarracks, 'h60K')
        else
        endif
    else
        if ( Trig_Durnholde_BarracksTrain_Func002Func001C() ) then
            call IssueTrainOrderByIdBJ(udg_Unit_DurnholdeBarracks, 'h60K')
        else
            call DoNothing()
        endif
    endif
endfunction

