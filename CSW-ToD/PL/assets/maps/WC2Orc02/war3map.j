function CreateCameras takes nothing returns nothing

    set gg_cam_Build01=CreateCameraSetup()
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_ZOFFSET, 200.0, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_ROTATION, 38.9, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_ANGLE_OF_ATTACK, 320.7, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_TARGET_DISTANCE, 1000.0, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_ROLL, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_FIELD_OF_VIEW, 70.0, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_FARZ, 10000.0, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_NEARZ, 100.0, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_LOCAL_PITCH, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_LOCAL_YAW, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Build01, CAMERA_FIELD_LOCAL_ROLL, 0.0, 0.0)
    call CameraSetupSetDestPosition(gg_cam_Build01, 6318.5, - 4942.3, 0.0)

    set gg_cam_Build02=CreateCameraSetup()
    call CameraSetupSetField(gg_cam_Build02, CAMERA_FIELD_ZOFFSET, 0.0, 0.0)
