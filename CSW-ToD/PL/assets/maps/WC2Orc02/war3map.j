    if ( not ( udg_Bool_CinematicOutroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FinalCinematicSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
