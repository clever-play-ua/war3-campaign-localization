function InitSounds takes nothing returns nothing
    set gg_snd_GoodJob=CreateSound("Sound\\Interface\\GoodJob.wav", false, false, false, 10, 10, "DefaultEAXON")
    call SetSoundDuration(gg_snd_GoodJob, 2954)
    call SetSoundChannel(gg_snd_GoodJob, 0)
    call SetSoundVolume(gg_snd_GoodJob, 127)
    call SetSoundPitch(gg_snd_GoodJob, 1.0)
    set gg_snd_DoorSlam1=CreateSound("Sound\\Ambient\\DoodadEffects\\DoorSlam1.wav", false, false, false, 10, 10, "DefaultEAXON")
    call SetSoundDuration(gg_snd_DoorSlam1, 485)
    call SetSoundChannel(gg_snd_DoorSlam1, 0)
    call SetSoundVolume(gg_snd_DoorSlam1, 127)
    call SetSoundPitch(gg_snd_DoorSlam1, 1.0)
    set gg_snd_WaterStreamLoop1=CreateSound("Sound\\Ambient\\DoodadEffects\\WaterStreamLoop1.wav", true, true, true, 10, 10, "DoodadsEAX")
    call SetSoundDuration(gg_snd_WaterStreamLoop1, 2008)
    call SetSoundChannel(gg_snd_WaterStreamLoop1, 0)
    call SetSoundVolume(gg_snd_WaterStreamLoop1, 127)
    call SetSoundPitch(gg_snd_WaterStreamLoop1, 1.0)
    call SetSoundDistances(gg_snd_WaterStreamLoop1, 600.0, 2600.0)
    call SetSoundDistanceCutoff(gg_snd_WaterStreamLoop1, 2100.0)
    call SetSoundConeAngles(gg_snd_WaterStreamLoop1, 0.0, 0.0, 127)
    call SetSoundConeOrientation(gg_snd_WaterStreamLoop1, 0.0, 0.0, 0.0)
    set gg_snd_WaterLakeLoop1=CreateSound("Sound\\Ambient\\DoodadEffects\\WaterLakeLoop1.wav", true, true, true, 10, 10, "DoodadsEAX")
    call SetSoundDuration(gg_snd_WaterLakeLoop1, 3297)
    call SetSoundChannel(gg_snd_WaterLakeLoop1, 0)
    call SetSoundVolume(gg_snd_WaterLakeLoop1, 0)
    call SetSoundPitch(gg_snd_WaterLakeLoop1, 1.0)
    call SetSoundDistances(gg_snd_WaterLakeLoop1, 600.0, 2600.0)
    call SetSoundDistanceCutoff(gg_snd_WaterLakeLoop1, 2100.0)
    call SetSoundConeAngles(gg_snd_WaterLakeLoop1, 0.0, 0.0, 127)
    call SetSoundConeOrientation(gg_snd_WaterLakeLoop1, 0.0, 0.0, 0.0)
    set gg_snd_GateOpen=CreateSound("Sound\\Ambient\\DoodadEffects\\GateOpen.wav", false, false, true, 10, 10, "DefaultEAXON")
    call SetSoundDuration(gg_snd_GateOpen, 4852)
    call SetSoundChannel(gg_snd_GateOpen, 0)
    call SetSoundVolume(gg_snd_GateOpen, 127)
    call SetSoundPitch(gg_snd_GateOpen, 1.0)
    set gg_snd_H06VillagerF5701=CreateSound("Sound/Dialogue/HumanCampaign/Human06/H06VillagerF57.flac", false, false, false, 1, 1, "DefaultEAXON")
    call SetSoundParamsFromLabel(gg_snd_H06VillagerF5701, "H06VillagerF57")
    call SetSoundDuration(gg_snd_H06VillagerF5701, 2144)
    call SetSoundChannel(gg_snd_H06VillagerF5701, 19)
    call SetSoundVolume(gg_snd_H06VillagerF5701, 120)
    set gg_snd_WC2Orc02ElfArcher1=CreateSound("_HD.w3mod/Sound/Dialogue/WC2Orc02/WC2Orc02ElfArcher1.flac", false, false, false, 1, 1, "DoodadsEAX")
    call SetSoundDuration(gg_snd_WC2Orc02ElfArcher1, 10866)
