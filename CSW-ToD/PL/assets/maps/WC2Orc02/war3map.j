    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "TRIGSTR_2467")
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_LoreDurnholde takes nothing returns nothing
    set gg_trg_LoreDurnholde=CreateTrigger()
    call TriggerAddAction(gg_trg_LoreDurnholde, function Trig_LoreDurnholde_Actions)
endfunction

