//===========================================================================
// Trigger: LaunchInGameMusic
//===========================================================================
function Trig_LaunchInGameMusic_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Music_CurrentVolume < 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LaunchInGameMusic_Actions takes nothing returns nothing
    call PlayMusicBJ(udg_Music_CurrentName)
    set udg_Int_C=1
    loop
        exitwhen udg_Int_C > 100
        if ( Trig_LaunchInGameMusic_Func002Func001C() ) then
            set udg_Music_CurrentVolume=( udg_Music_CurrentVolume + 1 )
            call SetMusicVolumeBJ(udg_Music_CurrentVolume)
            call TriggerSleepAction(0.02)
        else
        endif
        set udg_Int_C=udg_Int_C + 1
    endloop
endfunction

//===========================================================================
function InitTrig_LaunchInGameMusic takes nothing returns nothing
    set gg_trg_LaunchInGameMusic=CreateTrigger()
    call TriggerAddAction(gg_trg_LaunchInGameMusic, function Trig_LaunchInGameMusic_Actions)
endfunction

