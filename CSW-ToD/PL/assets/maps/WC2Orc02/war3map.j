    set gg_trg_SnowcapsOn=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SnowcapsOn, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
    call TriggerAddAction(gg_trg_SnowcapsOn, function Trig_SnowcapsOn_Actions)
endfunction

