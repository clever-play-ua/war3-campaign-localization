endfunction

function Trig_TrollsCinematicQ_Func112001 takes nothing returns boolean
    return ( udg_Bool_CinematicTrollSkipped == true )
endfunction

function Trig_TrollsCinematicQ_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, bj_FORCE_PLAYER[0])
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinematicSkipped=false
    // //
    call ConditionalTriggerExecute(gg_trg_PrepareActors)
    call ConditionalTriggerExecute(gg_trg_TrollsCinematicSetup)
    call PlaySoundBJ(gg_snd_OrcTheme)
    call SetSoundVolumeBJ(gg_snd_OrcTheme, 65.00)
    // //
    // CinematicStarted
    // //
    set udg_Bool_CinematicTrollOn=true
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Uruk_See_Trolls01, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Uruk_See_Trolls02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc02Rend3) + 3.00 ))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    // Hmm...Forest Trolls, how convenient. Let us approach with caution.
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_Trolls, 0, GetCameraTargetPositionLoc(), gg_snd_WC2Orc02Rend3, bj_TIMETYPE_ADD, 0, true)
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Troll, udg_Player_Actual, 0)
    // //
    call SetUnitPositionLoc(udg_FakeRend, GetRectCenter(gg_rct_FTCRendWalk))
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_RendSpeakWithTrolls))
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_FTCUtokWalk))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, udg_FakeRend)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Greetings, Amani, we have been dispatched by our Warchief to rescue your legendary leader. Were you part of Zul'jin's war-party?
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc02Rend4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Troll_Speaking02, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeRend, "Cinematic Listening One")
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    call SetUnitLookAt(udg_FakeRend, "bone_head", gg_unit_o60O_0015, 0, 0, 90)
    // //
    call SetUnitAnimation(gg_unit_o60O_0015, "cinematic point one")
    call QueueUnitAnimationBJ(gg_unit_o60O_0015, "cinematic standard one")
    // Amani... we've not been called by dat name for generations, not since the days of our great empire of old. You be well versed in our history, stranger.
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], gg_unit_o60O_0015, 0, gg_snd_WC2Orc02Troll1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_o60O_0015, "Cinematic Listening One")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Troll_Speaking01, udg_Player_Actual, 0.00)
    // //
    call SetUnitFacingToFaceUnitTimed(gg_unit_o60O_0016, udg_FakeRend, 0.50)
    call SetUnitFacingToFaceUnitTimed(udg_FakeRend, gg_unit_o60O_0016, 0.50)
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitLookAt(udg_FakeRend, "bone_head", gg_unit_o60O_0016, 0, 0, 90)
    // //
    call SetUnitAnimation(gg_unit_o60O_0016, "cinematic standard one")
    // We were indeed led by the great Zul'jin, until we be ambushed by da Humans. Three of us were killed, and da rest were captured. I managed to evade capture so I could warn my brethren of Zul'jin's abduction.
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], gg_unit_o60O_0016, 0, gg_snd_WC2Orc02Troll2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_o60O_0016, "Cinematic Listening One")
    // //
    call SetUnitFacingToFaceUnitTimed(gg_unit_o60O_0015, udg_FakeRend, 0.50)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Troll_Speaking02, udg_Player_Actual, 0.00)
    // //
    call SetUnitLookAt(udg_FakeRend, "bone_head", gg_unit_o60O_0015, 0, 0, 90)
    call SetUnitFacingToFaceUnitTimed(udg_FakeRend, gg_unit_o60O_0015, 0.50)
    // //
    // Their camp be on da other side of da forest, but da path be blocked by dat accursed human settlement.
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], gg_unit_o60O_0015, 0, gg_snd_WC2Orc02Troll2a, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_o60O_0015, "Cinematic Listening One")
    // //
    call SetUnitAnimation(gg_unit_o60O_0015, "cinematic standard one")
    // We cannot make it there on our own, but if ya truly be here to help us, den we will show you how to build a proper Troll Lumber Mill and grant you the use of our tools and weapons!
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], gg_unit_o60O_0015, 0, gg_snd_WC2Orc02Troll3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_o60O_0015, "Cinematic Listening One")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Troll, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_FakeRend, "Cinematic Standard One")
    // Zul'jin is of great interest to our Warchief. That is why we are here to slaughter his captors and deliver him to safety. We will aid you in your plight, Amani.
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc02Rend5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Uruk_See_Trolls02, udg_Player_Actual, 0)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Game_Camera, udg_Player_Actual, 6.00)
    // //
    call SetUnitAnimation(gg_unit_o60O_0015, "cinematic point one")
    call QueueUnitAnimationBJ(gg_unit_o60O_0015, "cinematic standard one")
    // Our axes are yours to command, Orc Master.
    call SetUnitAnimation(udg_FakeRend, "Cinematic Listening One")
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], gg_unit_o60O_0015, 0, gg_snd_WC2Orc02Troll4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicTrollSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_o60O_0015, "Cinematic Listening One")
    // //
    // CinematicFinished
    // //
    call StopSoundBJ(gg_snd_OrcTheme, true)
    call TriggerExecute(gg_trg_TrollsCinematicCleanup)
endfunction

//===========================================================================
function InitTrig_TrollsCinematicQ takes nothing returns nothing
    set gg_trg_TrollsCinematicQ=CreateTrigger()
    call TriggerAddAction(gg_trg_TrollsCinematicQ, function Trig_TrollsCinematicQ_Actions)
endfunction

//===========================================================================
// Trigger: TrollsCinematicSetup
//===========================================================================
function Trig_TrollsCinematicSetup_Func004C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Rend) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollsCinematicSetup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    if ( Trig_TrollsCinematicSetup_Func004C() ) then
        call ShowUnitHide(udg_Hero_Rend)
    else
    endif
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, true)
    // //
    call TriggerSleepAction(0.10)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_FTCRendStart), 180.00)
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeRend)
    call SetUnitMoveSpeed(udg_FakeRend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_FTCUtokStart), 180.00)
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call SetSkyModel("Environment\\Sky\\Sky\\SkyLight.mdl")
endfunction

//===========================================================================
function InitTrig_TrollsCinematicSetup takes nothing returns nothing
    set gg_trg_TrollsCinematicSetup=CreateTrigger()
    call TriggerAddAction(gg_trg_TrollsCinematicSetup, function Trig_TrollsCinematicSetup_Actions)
endfunction

//===========================================================================
// Trigger: TrollsCinematicSkipped
//===========================================================================
function Trig_TrollsCinematicSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinematicTrollOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollsCinematicSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinematicSkipped=true
    set udg_Bool_CinematicTrollSkipped=true
    call TriggerExecute(gg_trg_TrollsCinematicCleanup)
endfunction

//===========================================================================
function InitTrig_TrollsCinematicSkipped takes nothing returns nothing
    set gg_trg_TrollsCinematicSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_TrollsCinematicSkipped, Player(0))
    call TriggerAddCondition(gg_trg_TrollsCinematicSkipped, Condition(function Trig_TrollsCinematicSkipped_Conditions))
    call TriggerAddAction(gg_trg_TrollsCinematicSkipped, function Trig_TrollsCinematicSkipped_Actions)
endfunction

//===========================================================================
// Trigger: TrollsCinematicCleanup
//===========================================================================
function Trig_TrollsCinematicCleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollsCinematicCleanup_Func010C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicTrollSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollsCinematicCleanup_Func011C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Rend) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollsCinematicCleanup_Func013C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollsCinematicCleanup_Func018C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollsCinematicCleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Fade Faster If Cinematic Skipped
    if ( Trig_TrollsCinematicCleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set udg_Bool_CinematicTrollOn=false
    call SetSkyModel(null)
    call ConditionalTriggerExecute(gg_trg_RemoveActors)
    call ResetUnitLookAt(gg_unit_o60O_0016)
    call ResetUnitLookAt(gg_unit_o60O_0015)
    if ( Trig_TrollsCinematicCleanup_Func010C() ) then
        call StopSoundBJ(gg_snd_OrcTheme, false)
        call StopSoundBJ(gg_snd_WC2Orc02Troll1, false)
        call StopSoundBJ(gg_snd_WC2Orc02Troll2, false)
        call StopSoundBJ(gg_snd_WC2Orc02Troll2a, false)
        call StopSoundBJ(gg_snd_WC2Orc02Troll3, false)
        call StopSoundBJ(gg_snd_WC2Orc02Troll4, false)
        call StopSoundBJ(gg_snd_WC2Orc02Rend3, false)
        call StopSoundBJ(gg_snd_WC2Orc02Rend4, false)
        call StopSoundBJ(gg_snd_WC2Orc02Rend5, false)
    else
    endif
    if ( Trig_TrollsCinematicCleanup_Func011C() ) then
        call ShowUnitShow(udg_Hero_Rend)
        call SetUnitPositionLocFacingBJ(udg_Hero_Rend, GetRectCenter(gg_rct_DefaultRendFT), 180.00)
    else
    endif
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', false, false)
    if ( Trig_TrollsCinematicCleanup_Func013C() ) then
        call ShowUnitShow(udg_SemiHero_Utok)
        call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_FTCUtokDefault), 180.00)
    else
    endif
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    call CinematicModeBJ(false, bj_FORCE_PLAYER[0])
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_TrollsCinematicCleanup_Func018C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_TrollsCinematicQ)
    call TriggerExecute(gg_trg_LaunchInGameMusic)
    call TriggerExecute(gg_trg_Trolls_Rescue)
endfunction

//===========================================================================
function InitTrig_TrollsCinematicCleanup takes nothing returns nothing
    set gg_trg_TrollsCinematicCleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_TrollsCinematicCleanup, function Trig_TrollsCinematicCleanup_Actions)
endfunction

