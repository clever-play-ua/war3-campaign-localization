//===========================================================================
// Trigger: AllUnitsDead Defeat
//===========================================================================
function Trig_AllUnitsDead_Defeat_Func002Func003C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQ_Zuljin) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllUnitsDead_Defeat_Func002Func004C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQ_Strength) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllUnitsDead_Defeat_Func002Func009001001002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AllUnitsDead_Defeat_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_AllUnitsDead_Defeat_Func002Func009001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllUnitsDead_Defeat_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_AllUnitsDead_Defeat_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Bool_GameOver=true
        if ( Trig_AllUnitsDead_Defeat_Func002Func003C() ) then
            call QuestSetFailedBJ(udg_MQ_Zuljin, true)
        else
        endif
        if ( Trig_AllUnitsDead_Defeat_Func002Func004C() ) then
            call QuestSetFailedBJ(udg_MQ_Strength, true)
        else
        endif
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_FAILED, "TRIGSTR_2769")
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
        call TriggerSleepAction(2.00)
        call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_2770")
    else
    endif
endfunction

//===========================================================================
function InitTrig_AllUnitsDead_Defeat takes nothing returns nothing
    set gg_trg_AllUnitsDead_Defeat=CreateTrigger()
    call DisableTrigger(gg_trg_AllUnitsDead_Defeat)
    call TriggerRegisterTimerEventPeriodic(gg_trg_AllUnitsDead_Defeat, 2)
    call TriggerAddAction(gg_trg_AllUnitsDead_Defeat, function Trig_AllUnitsDead_Defeat_Actions)
endfunction

//===========================================================================
// Trigger: SetUpCinematicFrame
//
// By Insane Monster
// Need to be launched in every cinematic
//===========================================================================
function Trig_SetUpCinematicFrame_Actions takes nothing returns nothing
    // //
    // // Hide portrait during cinematic
    call BlzFrameSetVisible(BlzGetFrameByName("HDCinematicPortraitCover", 0), false)
    // // Remove the background by moving it (hiding does not work)
    call BlzFrameClearAllPoints(BlzGetFrameByName("HDCinematicBackground", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.0)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_TOPRIGHT, 0.0, 0.0)
    // // Set the cinematic dialogue text rectangle to the bottom center portion of the screen
    call BlzFrameClearAllPoints(BlzGetFrameByName("CinematicDialogueText", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.035)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.075)
    // // Set the cinematic speaker text rectangle to the bottom center portion of the screen (above dialogue text)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.085)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.95)
    // // Set both cinematic speaker and cinematic dialogue text alignment to center
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicDialogueText", 0), TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicSpeakerText", 0), TEXT_JUSTIFY_BOTTOM, TEXT_JUSTIFY_CENTER)
    // //
    // //
endfunction

//===========================================================================
function InitTrig_SetUpCinematicFrame takes nothing returns nothing
    set gg_trg_SetUpCinematicFrame=CreateTrigger()
    call TriggerAddAction(gg_trg_SetUpCinematicFrame, function Trig_SetUpCinematicFrame_Actions)
endfunction

