function Trig_FinalCinematicQ_Func076001 takes nothing returns boolean
    return ( udg_Bool_CinematicOutroSkipped == true )
endfunction

function Trig_FinalCinematicQ_Func080001 takes nothing returns boolean
    return ( udg_Bool_CinematicOutroSkipped == true )
endfunction

function Trig_FinalCinematicQ_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, bj_FORCE_PLAYER[0])
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinematicOutroOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call ConditionalTriggerExecute(gg_trg_FinalCinematicSetup)
    call PlaySoundBJ(gg_snd_Comradeship)
    call CameraSetupApplyForPlayer(true, gg_cam_ZulJeen01, udg_Player_Actual, 0)
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ZulJeen02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc02ZulJin4) + 1.00 ))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    // cinematic started
    // //
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic standard one")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeZuljin, 0, gg_snd_WC2Orc02ZulJin4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ZulJeen03, udg_Player_Actual, 5.00)
    // //
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeZuljin)
    call SetUnitMoveSpeed(udg_FakeZuljin, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuljin, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call ResetUnitLookAt(udg_FakeZuljin)
    call IssuePointOrderLocBJ(udg_FakeZuljin, "move", GetRectCenter(gg_rct_ZulJeenFinal02))
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    // //
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingTimed(udg_FakeRend, 209.87, 1.50)
    call SetUnitFacingTimed(udg_FakeUtok, 280.54, 1.50)
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_ZulJeenFinal02, udg_FakeZuljin) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuljin, udg_FakeRend, 1.00)
    call SetUnitLookAt(udg_FakeZuljin, "bone_head", udg_FakeRend, 0, 0, 90)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ZulJeen04, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc02ZulJin5) + GetSoundDurationBJ(gg_snd_WC2Orc02Rend14) ))
    // //
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic standard two")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeZuljin, 0, gg_snd_WC2Orc02ZulJin5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeRend, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc02Rend14, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Zuljin06, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc02Rend15) + GetSoundDurationBJ(gg_snd_WC2Orc02ZulJin6) ))
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc02Rend15, bj_TIMETYPE_ADD, 0, true)
    call SetUnitAnimation(udg_FakeRend, "Cinematic Listening One")
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeZuljin, 0, gg_snd_WC2Orc02ZulJin6, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic agree one")
    // //
    call TriggerSleepAction(1.90)
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic listening one")
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc02ZulJin6) - 1.90 ))
    if ( (udg_Bool_CinematicOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Cinematic Ended
    // //
    call StopSoundBJ(gg_snd_Comradeship, true)
    call TriggerExecute(gg_trg_FinalCinematicCleanUp)
    // //
endfunction

//===========================================================================
function InitTrig_FinalCinematicQ takes nothing returns nothing
    set gg_trg_FinalCinematicQ=CreateTrigger()
    call DisableTrigger(gg_trg_FinalCinematicQ)
    call TriggerAddAction(gg_trg_FinalCinematicQ, function Trig_FinalCinematicQ_Actions)
endfunction

//===========================================================================
// Trigger: FinalCinematicSetup
//===========================================================================
function Trig_FinalCinematicSetup_Func031001 takes nothing returns boolean
    return ( IsUnitDeadBJ(udg_Hero_Rend) == true )
endfunction

function Trig_FinalCinematicSetup_Func039A takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_Default_Troops_Final))
endfunction

function Trig_FinalCinematicSetup_Func041C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FinalCinematicSetup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call SetSkyModel("Environment\\Sky\\Sky\\SkyLight.mdl")
    call SetTimeOfDay(17.00)
    // //
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, true)
    // //
    call ShowUnitHide(udg_Hero_Zuljin)
    call ShowUnitHide(udg_Hero_Rend)
    // //
    call SetUnitOwner(gg_unit_n60A_0030, Player(6), false)
    // //
    call CreateNUnitsAtLoc(1, 'OZcN', udg_Player_TrollPrisoners, GetRectCenter(gg_rct_ZulJeen), 295.32)
    set udg_FakeZuljin=GetLastCreatedUnit()
    // //
    // Theese priests interfier in cinematics with their healing services
    // //
    call ShowUnitHide(gg_unit_nfsh_0152)
    call ShowUnitHide(gg_unit_nfsh_0031)
    // //
    // Create Fake Rend
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'ORFc', Player(20), GetRectCenter(gg_rct_Rend_Final), GetRectCenter(gg_rct_ZulJeen))
    set udg_FakeRend=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeRend)
    call SetUnitAnimation(udg_FakeRend, "Cinematic Listening One")
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.25)
    call SetUnitLookAt(udg_FakeRend, "bone_head", udg_FakeZuljin, 0, 0, 90)
    // //
    // Move Real Rend Out
    if ( (IsUnitDeadBJ(udg_Hero_Rend) == true) ) then // INLINED!!
        call ReviveHeroLoc(udg_Hero_Rend, GetRectCenter(gg_rct_Uruk03), false)
    else
        call DoNothing()
    endif
    call SetUnitPositionLoc(udg_Hero_Rend, GetRectCenter(gg_rct_Uruk03))
    // //
    // Create wolf
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n009', Player(20), GetRectCenter(gg_rct_WolfFinal), GetRectCenter(gg_rct_UtokFInal))
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Troll_Village_Q, Player(0)), function Trig_FinalCinematicSetup_Func039A)
    // //
    if ( Trig_FinalCinematicSetup_Func041C() ) then
        call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_Uruk03), GetRectCenter(gg_rct_ZulJeen))
    else
    endif
    // //
    call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_UtokFInal), 38.11)
    set udg_FakeUtok=GetLastCreatedUnit()
    // //
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeUtok)
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Writing One")
    // //
    call SetUnitBlendTimeBJ(udg_FakeZuljin, 1.00)
    call SetUnitLookAt(udg_FakeZuljin, "bone_head", udg_FakeRend, 0, 0, 90)
    // //
endfunction

//===========================================================================
function InitTrig_FinalCinematicSetup takes nothing returns nothing
    set gg_trg_FinalCinematicSetup=CreateTrigger()
    call TriggerAddAction(gg_trg_FinalCinematicSetup, function Trig_FinalCinematicSetup_Actions)
endfunction

