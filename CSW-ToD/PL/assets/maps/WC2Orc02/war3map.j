    set gg_trg_Zuljin_EnterVillage_NotZuljin=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Zuljin_EnterVillage_NotZuljin, gg_rct_Enter_tothe_Troll_village)
    call TriggerAddCondition(gg_trg_Zuljin_EnterVillage_NotZuljin, Condition(function Trig_Zuljin_EnterVillage_NotZuljin_Conditions))
    call TriggerAddAction(gg_trg_Zuljin_EnterVillage_NotZuljin, function Trig_Zuljin_EnterVillage_NotZuljin_Actions)
