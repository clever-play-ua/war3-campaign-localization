    call TriggerAddCondition(gg_trg_Zuljin_Completed, Condition(function Trig_Zuljin_Completed_Conditions))
    call TriggerAddAction(gg_trg_Zuljin_Completed, function Trig_Zuljin_Completed_Actions)
endfunction

