    set gg_trg_Zuljin_Update=CreateTrigger()
    call TriggerRegisterUnitEvent(gg_trg_Zuljin_Update, gg_unit_h60Z_0103, EVENT_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Zuljin_Update, Condition(function Trig_Zuljin_Update_Conditions))
    call TriggerAddAction(gg_trg_Zuljin_Update, function Trig_Zuljin_Update_Actions)
endfunction

//===========================================================================
// Trigger: Zuljin Update Q
//===========================================================================
function Trig_Zuljin_Update_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_TrollPrisoners, 'O60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc02ZulJin1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_Trolls, 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc02Rend10, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_TrollPrisoners, 'O60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc02ZulJin2, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_Trolls, 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc02Rend11, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestItemSetCompletedBJ(udg_QReq_ZuljinRescue, true)
    call DestroyMinimapIcon(udg_MinimapIcon_Zuljin[1])
    call QuestMessageBJ(udg_PlayerGroup_User, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_2612")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call PingMinimapLocForForceEx(bj_FORCE_PLAYER[0], GetRectCenter(gg_rct_Ping), 10.00, bj_MINIMAPPINGSTYLE_FLASHY, 0.00, 100, 0.00)
endfunction

