//===========================================================================
// Trigger: Zuljin Ping
//===========================================================================
function Trig_Zuljin_Ping_Func004001 takes nothing returns boolean
    return ( udg_Bool_ZuljinFreed == false )
endfunction

function Trig_Zuljin_Ping_Actions takes nothing returns nothing
    call TriggerSleepAction(60.00)
    set udg_Point_MinimapPingZuljin[1]=GetRectCenter(gg_rct_Trolls)
    set udg_Point_MinimapPingZuljin[2]=GetRectCenter(gg_rct_Troll_Village)
    if ( (udg_Bool_ZuljinFreed == false) ) then // INLINED!!
        call PingMinimapLocForForceEx(udg_PlayerGroup_User, udg_Point_MinimapPingZuljin[1], 7.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    else
        call DoNothing()
    endif
    call PingMinimapLocForForceEx(udg_PlayerGroup_User, udg_Point_MinimapPingZuljin[2], 7.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call RemoveLocation(udg_Point_MinimapPingZuljin[1])
    call RemoveLocation(udg_Point_MinimapPingZuljin[2])
    call TriggerSleepAction(60.00)
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

