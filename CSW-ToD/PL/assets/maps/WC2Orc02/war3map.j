//***************************************************************************
//*  SetAutoFacialAnimationsHuman
// By OutsiderXE

function SetAutoFacialAnimationsHuman takes sound soundHandle,string speakerName returns nothing
 local real soundDuration= GetSoundDurationBJ(soundHandle)
    call SetDialogueSpeakerNameKey(soundHandle, speakerName)

	if ( soundDuration >= 21.056 ) then
	call SetSoundFacialAnimationLabel(soundHandle, "H06Medivh56")
	call SetSoundFacialAnimationGroupLabel(soundHandle, "Map-Medivh")
	call SetSoundFacialAnimationSetFilepath(soundHandle, "sound/dialogue/faceanimation/human06interlude/facialanimation/medivh.animset_ingame")
	
