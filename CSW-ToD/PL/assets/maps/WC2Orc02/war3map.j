function Trig_Durnholde_BarracksTrain_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Alliance ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeBarracks) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Durnholde_BarracksTrain_Func002Func001C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

