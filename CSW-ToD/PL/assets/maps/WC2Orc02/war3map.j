//===========================================================================
// Trigger: Zuljin EnterVillage NotZuljin
//===========================================================================
function Trig_Zuljin_EnterVillage_NotZuljin_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() != udg_Hero_Zuljin ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuljin_EnterVillage_NotZuljin_Func003Func001001 takes nothing returns boolean
    return ( udg_Bool_ZuljinInTheVillage == false )
endfunction

function Trig_Zuljin_EnterVillage_NotZuljin_Func003Func004Func001001 takes nothing returns boolean
    return ( udg_Bool_ZuljinInTheVillage == false )
endfunction

function Trig_Zuljin_EnterVillage_NotZuljin_Func003Func004Func002001 takes nothing returns boolean
    return ( udg_Bool_ZuljinInTheVillage == false )
endfunction

function Trig_Zuljin_EnterVillage_NotZuljin_Func003Func004C takes nothing returns boolean
    if ( not ( udg_Real_Chance >= 70.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuljin_EnterVillage_NotZuljin_Func003C takes nothing returns boolean
    if ( not ( udg_Real_Chance <= 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuljin_EnterVillage_NotZuljin_Actions takes nothing returns nothing
    set udg_Real_Chance=GetRandomPercentageBJ()
    call SetSpeechVolumeGroupsBJ()
    if ( Trig_Zuljin_EnterVillage_NotZuljin_Func003C() ) then
        if ( (udg_Bool_ZuljinInTheVillage == false) ) then // INLINED!!
            call DoNothing()
        else
            return
        endif
        call PlaySoundAtPointBJ(gg_snd_ForestTrollWhat3, 100, GetRectCenter(gg_rct_Enter_tothe_Troll_village), 50.00)
    else
        if ( Trig_Zuljin_EnterVillage_NotZuljin_Func003Func004C() ) then
            if ( (udg_Bool_ZuljinInTheVillage == false) ) then // INLINED!!
                call DoNothing()
            else
                return
            endif
            call PlaySoundAtPointBJ(gg_snd_ForestTrollWhat4, 100, GetRectCenter(gg_rct_Enter_tothe_Troll_village), 50.00)
        else
            if ( (udg_Bool_ZuljinInTheVillage == false) ) then // INLINED!!
                call DoNothing()
            else
                return
            endif
            call PlaySoundAtPointBJ(gg_snd_ForestTrollPissed3, 100, GetRectCenter(gg_rct_Enter_tothe_Troll_village), 50.00)
        endif
    endif
    call VolumeGroupResetBJ()
endfunction

