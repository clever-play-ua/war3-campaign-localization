    call AddUnitAnimationPropertiesBJ(true, "Cinematic", gg_unit_h60K_0094)
    call SetUnitAnimation(gg_unit_h60K_0094, "Cinematic Kneeling One")
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", gg_unit_h60K_0095)
    call SetUnitAnimation(gg_unit_h60K_0203, "Cinematic Kneeling One")
    call SetUnitAnimation(gg_unit_h60K_0141, "Cinematic Kneeling One")
    // //
    call SetUnitAnimation(gg_unit_o60O_0003, "cinematic trapped")
    call SetUnitAnimation(gg_unit_o60O_0007, "cinematic trapped")
    call SetUnitAnimation(gg_unit_o60O_0006, "cinematic trapped")
    call SetUnitAnimation(gg_unit_o60O_0005, "cinematic trapped")
    // //
    call BlzSetUnitName(gg_unit_hpea_0194, GetItemName(gg_item_IQL2_0249))
    call BlzSetUnitName(gg_unit_nvil_0196, GetItemName(gg_item_IQL2_0249))
    call BlzSetUnitName(gg_unit_nvl2_0195, GetItemName(gg_item_IQL2_0249))
    // //
    call SetUnitMoveSpeed(gg_unit_h60K_0095, 100.00)
    call BlzSetUnitRealFieldBJ(gg_unit_h60K_0095, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call IssuePointOrderLocBJ(gg_unit_h60K_0095, "patrol", GetRectCenter(gg_rct_Patrol01))
    // //
    call UnitAddAbilityBJ('A631', gg_unit_o60Z_0014)
    // //
    set udg_Unit_DurnholdeBarracks=gg_unit_h616_0111
    set udg_Unit_DurnholdeFarmArray[1]=gg_unit_h619_0029
    set udg_Unit_DurnholdeFarmArray[2]=gg_unit_h619_0116
    set udg_Unit_DurnholdeFarmArray[3]=gg_unit_h619_0113
    set udg_Unit_DurnholdeTownHall=gg_unit_h61C_0110
    call UnitAddAbilityBJ('A63D', udg_Unit_DurnholdeTownHall)
    call UnitAddAbilityBJ('A63E', gg_unit_h616_0111)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Alliance, 'h619'), function Trig_Init_02_Units_Func072A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Alliance, 'h610'), function Trig_Init_02_Units_Func075A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Alliance, 'h60Z'), function Trig_Init_02_Units_Func078A)
    // //
    call TriggerExecute(gg_trg_Load_Heroes)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Troll_Village_Q, udg_Player_Trolls), function Trig_Init_02_Units_Func083A)
