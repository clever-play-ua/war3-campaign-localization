//===========================================================================
function Trig_Strength_Completed_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTrainedUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTrainedUnit()) == 'o61W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Strength_Completed_Func005C takes nothing returns boolean
    if ( not ( udg_Int_QStrength_GruntsTrained < 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Strength_Completed_Actions takes nothing returns nothing
    set udg_Int_QStrength_GruntsTrained=( udg_Int_QStrength_GruntsTrained + 1 )
    if ( Trig_Strength_Completed_Func005C() ) then
        call PlaySoundBJ(gg_snd_GoodJob)
        call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_QuestObjectives, udg_Int_QStrength_GruntsTrained)
    else
        call DisableTrigger(GetTriggeringTrigger())
        call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_QuestObjectives, 10)
        call QueuedTriggerAddBJ(gg_trg_Strength_Completed_Q, true)
    endif
endfunction

