//===========================================================================
function Trig_Strength_Discover_Q_Actions takes nothing returns nothing
    // //
    call CreateLeaderboardBJ(bj_FORCE_PLAYER[0], "TRIGSTR_2601")
    set udg_Leaderboard_QuestObjectives=GetLastCreatedLeaderboard()
    // //
    call LeaderboardAddItemBJ(Player(1), udg_Leaderboard_QuestObjectives, "TRIGSTR_2602", 0)
    call LeaderboardAddItemBJ(Player(0), udg_Leaderboard_QuestObjectives, "TRIGSTR_2603", udg_Int_QStrength_GruntsTrained)
    // //
    call LeaderboardSetPlayerItemLabelColorBJ(Player(1), udg_Leaderboard_QuestObjectives, 100.00, 80.00, 0.00, 0)
    call LeaderboardSetPlayerItemValueColorBJ(Player(1), udg_Leaderboard_QuestObjectives, 100.00, 100.00, 100.00, 0)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(0), udg_Leaderboard_QuestObjectives, 100.00, 80.00, 0.00, 0)
    call LeaderboardSetPlayerItemValueColorBJ(Player(0), udg_Leaderboard_QuestObjectives, 100.00, 100.00, 100.00, 0)
    // //
    call QuestMessageBJ(udg_PlayerGroup_User, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2600")
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

