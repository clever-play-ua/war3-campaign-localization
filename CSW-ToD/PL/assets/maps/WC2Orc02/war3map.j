endfunction

function Trig_Zuljin_Villager01_Taunt_Func010001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_Step02VF, gg_unit_nvlw_0137) == true )
endfunction

function Trig_Zuljin_Villager01_Taunt_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundOnUnitBJ(gg_snd_H06VillagerF5701, 100, gg_unit_nvlw_0137)
    call IssuePointOrderLocBJ(gg_unit_nvlw_0137, "move", GetRectCenter(gg_rct_Step01VF))
    call TriggerSleepAction(0.50)
    call IssuePointOrderLocBJ(gg_unit_nvlk_0138, "move", GetRectCenter(gg_rct_Step01VF))
    loop
        exitwhen ( (RectContainsUnit(gg_rct_Step01VF, gg_unit_nvlw_0137) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    call IssuePointOrderLocBJ(gg_unit_nvlw_0137, "move", GetRectCenter(gg_rct_Step02VF))
    call TriggerSleepAction(0.50)
    call IssuePointOrderLocBJ(gg_unit_nvlk_0138, "move", GetRectCenter(gg_rct_Step02VF))
    loop
        exitwhen ( (RectContainsUnit(gg_rct_Step02VF, gg_unit_nvlw_0137) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.10))
    endloop
    call TriggerSleepAction(0.50)
    call IssuePointOrderLocBJ(gg_unit_nvlw_0137, "move", GetRectCenter(gg_rct_Step03VF))
    call TriggerSleepAction(0.50)
    call IssuePointOrderLocBJ(gg_unit_nvlk_0138, "move", GetRectCenter(gg_rct_Step03VF))
endfunction

