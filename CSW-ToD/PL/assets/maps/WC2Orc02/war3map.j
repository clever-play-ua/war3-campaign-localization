//===========================================================================
// Trigger: DurnholdeCinematicSetup
//===========================================================================
function Trig_DurnholdeCinematicSetup_Func004002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_DurnholdeCinematicSetup_Func009001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == Player(9) )
endfunction

function Trig_DurnholdeCinematicSetup_Func009001002002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60K' )
endfunction

function Trig_DurnholdeCinematicSetup_Func009001002002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60B' )
endfunction

function Trig_DurnholdeCinematicSetup_Func009001002002 takes nothing returns boolean
    return GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'h60K'), (GetUnitTypeId(GetFilterUnit()) == 'h60B')) // INLINED!!
endfunction

function Trig_DurnholdeCinematicSetup_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == Player(9)), (GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'h60K'), (GetUnitTypeId(GetFilterUnit()) == 'h60B')))) // INLINED!!
endfunction

function Trig_DurnholdeCinematicSetup_Func009002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DurnholdeGarrison)
endfunction

function Trig_DurnholdeCinematicSetup_Func011002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_DurnholdeCinematicSetup_Func021C takes nothing returns boolean
    if ( not ( IsDestructableDeadBJ(gg_dest_YT18_6851) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DurnholdeCinematicSetup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_DurnholdeCinematicSetup_Func004002)
    // //
    call SetSkyModel("Environment\\Sky\\Sky\\SkyLight.mdl")
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_DurnholdeCinematicSetup_Func009001002)), function Trig_DurnholdeCinematicSetup_Func009002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(9)), function Trig_DurnholdeCinematicSetup_Func011002)
    // //
    call IssueImmediateOrderBJ(gg_unit_h60K_0210, "stop")
    call SetUnitPositionLocFacingBJ(gg_unit_h60K_0210, GetRectCenter(gg_rct_OpenTheGate), bj_UNIT_FACING)
    call SetUnitMoveSpeed(gg_unit_h60K_0210, GetUnitDefaultMoveSpeed(gg_unit_h60K_0210))
    call BlzSetUnitRealFieldBJ(gg_unit_h60K_0210, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    // //
    call CreateNUnitsAtLoc(1, 'h60K', Player(9), GetRectCenter(gg_rct_DurnholdeFootmanCinematic), 315.00)
    set udg_Unit_DurnholdeFootman=GetLastCreatedUnit()
    // //
    if ( Trig_DurnholdeCinematicSetup_Func021C() ) then
        call DestructableRestoreLife(gg_dest_YT18_6851, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
        call EnableTrigger(gg_trg_Durnholde_BridgeDeath)
    else
    endif
    // //
endfunction

//===========================================================================
function InitTrig_DurnholdeCinematicSetup takes nothing returns nothing
    set gg_trg_DurnholdeCinematicSetup=CreateTrigger()
    call TriggerAddAction(gg_trg_DurnholdeCinematicSetup, function Trig_DurnholdeCinematicSetup_Actions)
endfunction

//===========================================================================
// Trigger: DurnholdeCinematicSkipped
//===========================================================================
function Trig_DurnholdeCinematicSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinematicDurnholde == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DurnholdeCinematicSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call StopSoundBJ(gg_snd_Tension, false)
    set udg_Bool_CinematicSkipped=true
    set udg_Bool_CinematicDurnholdeSkipped=true
    call ConditionalTriggerExecute(gg_trg_DurnholdeCinematicCleanup)
endfunction

//===========================================================================
function InitTrig_DurnholdeCinematicSkipped takes nothing returns nothing
    set gg_trg_DurnholdeCinematicSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_DurnholdeCinematicSkipped, Player(0))
    call TriggerAddCondition(gg_trg_DurnholdeCinematicSkipped, Condition(function Trig_DurnholdeCinematicSkipped_Conditions))
    call TriggerAddAction(gg_trg_DurnholdeCinematicSkipped, function Trig_DurnholdeCinematicSkipped_Actions)
endfunction

//===========================================================================
// Trigger: DurnholdeCinematicCleanup
//===========================================================================
function Trig_DurnholdeCinematicCleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DurnholdeCinematicCleanup_Func009C takes nothing returns boolean
    if ( not ( IsDestructableDeadBJ(gg_dest_LTg3_4040) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DurnholdeCinematicCleanup_Func011A takes nothing returns nothing
    call SetUnitPositionLocFacingBJ(GetEnumUnit(), GetRandomLocInRect(gg_rct_DurnholdeStartedAttack), 225.00)
    call RemoveGuardPosition(GetEnumUnit())
    call IssuePointOrderLocBJ(GetEnumUnit(), "attack", GetUnitLoc(udg_Hero_Zuljin))
endfunction

function Trig_DurnholdeCinematicCleanup_Func018C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DurnholdeCinematicCleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Fade Faster If Cinematic Skipped
    if ( Trig_DurnholdeCinematicCleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set udg_Bool_CinematicDurnholde=false
    // //
    call SetSkyModel(null)
    // //
    if ( Trig_DurnholdeCinematicCleanup_Func009C() ) then
        call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_LTg3_4040)
    else
    endif
    // //
    call ForGroupBJ(udg_Group_DurnholdeGarrison, function Trig_DurnholdeCinematicCleanup_Func011A)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveActors)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    call CinematicModeBJ(false, bj_FORCE_PLAYER[0])
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_DurnholdeCinematicCleanup_Func018C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_DurnholdeCinematicQ)
    call TriggerExecute(gg_trg_LaunchInGameMusic)
    call ConditionalTriggerExecute(gg_trg_UtokLevelUp)
    // //
    // //
endfunction

//===========================================================================
function InitTrig_DurnholdeCinematicCleanup takes nothing returns nothing
    set gg_trg_DurnholdeCinematicCleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_DurnholdeCinematicCleanup, function Trig_DurnholdeCinematicCleanup_Actions)
endfunction

