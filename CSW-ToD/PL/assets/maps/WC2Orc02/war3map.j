//===========================================================================
function Trig_Init_04_Environment_Actions takes nothing returns nothing
    // //
    call SetSkyModel("Environment\\Sky\\Sky\\SkyLight.mdl")
    call SetTimeOfDay(14.00)
    call SetDayNightModels("csw\\environment\\dnc\\LordaeronWinter\\dnclordaeronwinterterrain.mdx", "csw\\environment\\dnc\\LordaeronWinter\\dnclordaeronwinterunit.mdx")
    // //
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_LTg2_3595)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_B61O_4408, true)
    call SetDestructableInvulnerableBJ(gg_dest_B61N_4406, true)
    call SetDestructableInvulnerableBJ(gg_dest_B61O_4435, true)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_B61N_4437, true)
    call SetDestructableOccluderHeight(gg_dest_B60L_7795, 300.00)
    call SetDestructableOccluderHeight(gg_dest_B60L_7794, 300.00)
    call SetDestructableOccluderHeight(gg_dest_B60L_1026, 300.00)
    call SetDestructableOccluderHeight(gg_dest_B60L_3648, 300.00)
    call SetDestructableOccluderHeight(gg_dest_B60L_3648, 300.00)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOtf', GetPlayableMapRect())
    // //
    // Localization Items
    // //
    call SetItemVisibleBJ(false, gg_item_IQL0_0247)
    call SetItemVisibleBJ(false, gg_item_IQL1_0248)
    call SetItemVisibleBJ(false, gg_item_IQL2_0249)
endfunction

