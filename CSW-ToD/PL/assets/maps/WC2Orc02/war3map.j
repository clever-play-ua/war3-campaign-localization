    // //
    call RemoveUnit(gg_unit_nmmu_0175)
    call RemoveUnit(gg_unit_nmfs_0176)
    call RemoveUnit(gg_unit_nmrm_0177)
    call RemoveUnit(gg_unit_h60K_0174)
