    // //
    // Durnholde
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Prisoners, udg_Player_DurnholdePrisoners), function Trig_Init_02_Units_Func091002)
