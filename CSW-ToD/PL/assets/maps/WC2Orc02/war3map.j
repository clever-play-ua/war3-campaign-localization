function Trig_IntroCinematicQ_Func201001 takes nothing returns boolean
    return ( udg_Bool_CinematicIntroSkipped == true )
endfunction

function Trig_IntroCinematicQ_Actions takes nothing returns nothing
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, bj_FORCE_PLAYER[0])
    call CameraSetupApplyForPlayer(true, gg_cam_Cage01, udg_Player_Actual, 0)
    call SetStackedSoundBJ(true, gg_snd_CS_H01a_village_004_LR_v3, gg_rct_Guard)
    call TriggerSleepAction(0.50)
    // //
    call ConditionalTriggerExecute(gg_trg_IntroCinematicSetup)
    // //
    call TriggerSleepAction(0.50)
    // //
    call PlaySoundBJ(gg_snd_Comradeship)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // CinematicStarted
    // //
    set udg_Bool_CinematicSkipped=false
    set udg_Bool_IntroCinematicOn=true
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Cage02, udg_Player_Actual, 7.00)
    // //
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroElfTalking02, udg_Player_Actual, 0.00)
    // //
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroRunner, GetRectCenter(gg_rct_Cinematic_Ranger00), 251.39)
    call SetUnitPositionLocFacingLocBJ(udg_Unit_IntroLuric, GetRectCenter(gg_rct_Cinematic_Paladin), GetRectCenter(gg_rct_Cinematic_Ranger00))
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Milan And Luric
    // //
    // I will inform our superiors about the capture of the Troll leader. Keep a close watch on the prisoners, commander, as there is no telling what vile schemes they are already hatching.
    call SetUnitAnimation(udg_Unit_IntroRunner, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_IntroRunner, 0, gg_snd_WC2Orc02ElfArcher1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_IntroRunner, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroLuricTalking, udg_Player_Actual, 0.00)
    // //
    // Don’t worry, my men know a thing or two about handling outlaws.
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_IntroLuric, 0, gg_snd_WC2Orc02Luric1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroElfTalking02, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_Unit_IntroRunner, "cinematic point one")
    call QueueUnitAnimationBJ(udg_Unit_IntroRunner, "cinematic standard one")
    // Do not underestimate the Forest Trolls, for they are unlike anything your men have ever faced. I will leave you a dozen of my archers.
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Unit_IntroRunner, 0, gg_snd_WC2Orc02ElfArcher2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_IntroRunner, "cinematic listening one")
    call SetUnitAnimation(udg_Unit_IntroRunner, "cinematic bow one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Run01A, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_Unit_IntroLuric, "Cinematic Salute One")
    call PlaySoundOnUnitBJ(gg_snd_CS_H01a_soldiers_turn_a, 100, udg_Unit_Captain)
    call TriggerSleepAction(0.80)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_IntroLuric, "Cinematic Salute Exit One")
    call QueueUnitAnimationBJ(udg_Unit_IntroLuric, "Cinematic Stand")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitMoveSpeed(udg_Unit_IntroLuric, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroLuric, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Unit_IntroRunner)
    call IssuePointOrderLocBJ(udg_Unit_IntroRunner, "move", GetRectCenter(gg_rct_Cinematic_Ranger))
    call PlaySoundBJ(gg_snd_CS_BG_Camp)
    call IssuePointOrderLocBJ(udg_Unit_IntroLuric, "move", GetRectCenter(gg_rct_CityBattle01))
    call SetUnitLookAt(gg_unit_n602_0156, "bone_head", udg_Unit_IntroRunner, 0, 0, 0.00)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Run02, udg_Player_Actual, 6.00, 2.00, 2.00, 100.00)
    // //
    call StopSoundBJ(gg_snd_Comradeship, true)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundBJ(gg_snd_WC3OrcVictory)
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Forest03, udg_Player_Actual, 0.00)
    // //
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Uruk02))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    // Orcs
    // //
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley101)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Forest04, udg_Player_Actual, 12.00)
    // //
    call TriggerSleepAction(8.50)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeRend, "stand victory")
    call QueueUnitAnimationBJ(udg_FakeRend, "stand")
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Build Camp
    // //
    call ShowUnitHide(udg_FakeRend)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Build01, udg_Player_Actual, 0.00)
    // //
    call SetUnitPositionLoc(gg_unit_o61X_0048, GetRectCenter(gg_rct_ChieftansHall))
    call IssueBuildOrderByIdLocBJ(gg_unit_o61X_0048, 'o614', GetRectCenter(gg_rct_ChieftansHall))
    call SetUnitPositionLoc(gg_unit_o61X_0047, GetRectCenter(gg_rct_BlackSmith))
    call IssueBuildOrderByIdLocBJ(gg_unit_o61X_0047, 'o60X', GetRectCenter(gg_rct_BlackSmith))
    call SetUnitPositionLoc(gg_unit_o61X_0050, GetRectCenter(gg_rct_Farm01))
    call IssueBuildOrderByIdLocBJ(gg_unit_o61X_0050, 'o60X', GetRectCenter(gg_rct_Farm01))
    // //
    call TriggerSleepAction(1.45)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundBJ(gg_snd_OrcBuildingLoop)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Build02, udg_Player_Actual, 7.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(1.45)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(3.40)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_OrcBuildingLoop, false)
    // //
    // WaterFallScene
    // //
    call StopSoundBJ(gg_snd_WC3OrcVictory, true)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_UrukDefault), GetRectCenter(gg_rct_Uruk03))
    call ShowUnitShow(udg_FakeRend)
    call ShowUnitShow(udg_SemiHero_Utok)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_WaterFall01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_WaterFall02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc02Rend1) + 2.50 ), 2.00, 4.00, 100.00)
    // //
    call PlaySoundBJ(gg_snd_Warcraft_II_Menu_Theme)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_Uruk07), GetRectCenter(gg_rct_Uruk03))
    call TriggerSleepAction(2.50)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeRend)
    call SetUnitAnimation(udg_FakeRend, "Cinematic Standard One")
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_SemiHero_Utok)
    call SetUnitAnimation(udg_SemiHero_Utok, "Cinematic Listening One")
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc02Rend1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_WaterFall03, udg_Player_Actual, 47.00)
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc02Rend2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_SemiHero_Utok, "Cinematic Proud One")
    call SetUnitAnimation(udg_Hero_Rend, "Cinematic Listening One")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_SemiHero_Utok, 0, gg_snd_WC2Orc02Utok1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_SemiHero_Utok, "Cinematic Listening One")
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinematicIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call StopSoundBJ(gg_snd_Warcraft_II_Menu_Theme, true)
    // //
    // CinematicEnded
    // //
    call TriggerExecute(gg_trg_IntroCinematicCleanup)
    // //
endfunction

//===========================================================================
function InitTrig_IntroCinematicQ takes nothing returns nothing
    set gg_trg_IntroCinematicQ=CreateTrigger()
    call DisableTrigger(gg_trg_IntroCinematicQ)
    call TriggerAddAction(gg_trg_IntroCinematicQ, function Trig_IntroCinematicQ_Actions)
endfunction

//===========================================================================
// Trigger: IntroCinematicSetup
//===========================================================================
function Trig_IntroCinematicSetup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // SettingActors
    // //
    call ShowUnitHide(udg_Hero_Rend)
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, true)
    // //
    call SetUnitBlendTimeBJ(udg_Unit_IntroRunner, 0.25)
    call SetUnitBlendTimeBJ(udg_Unit_Captain, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'ORbC', udg_Player_Trolls, GetRectCenter(gg_rct_Uruk01), 90.00)
    set udg_FakeRend=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.25)
    // //
    call SetUnitBlendTimeBJ(udg_SemiHero_Utok, 0.25)
    call SetUnitAnimation(gg_unit_h60K_0127, "Cinematic SaluteIdle One")
    call SetUnitAnimation(gg_unit_h60K_0128, "Cinematic SaluteIdle One")
    // //
    call ShowUnitHide(udg_Hero_Zuljin)
    // //
    call CreateNUnitsAtLoc(1, 'OZcN', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_IntroZuljin), 327.91)
    set udg_FakeZuljin=GetLastCreatedUnit()
    call SetUnitScalePercent(udg_FakeZuljin, 90.00, 90.00, 90.00)
    call SetUnitBlendTimeBJ(udg_FakeZuljin, 0.50)
    call SetUnitAnimation(udg_FakeZuljin, "cinematic trapped")
    call BlzUnitDisableAbility(udg_FakeZuljin, 'A60C', true, true)
    call SetUnitColor(udg_FakeZuljin, PLAYER_COLOR_CYAN)
    // //
    // //
    call CreateNUnitsAtLoc(1, 'hcth', udg_Player_Alliance, GetRectCenter(gg_rct_Cinematic_Paladin), 45.00)
    set udg_Unit_IntroLuric=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_Unit_IntroLuric, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_IntroLuric)
    // //
    call ShowUnitHide(udg_Unit_Captain)
    // //
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroRunner, GetRectCenter(gg_rct_Runner), 211.39)
    call SetUnitBlendTimeBJ(udg_Unit_IntroRunner, 0.50)
    call SetUnitAnimation(udg_Unit_IntroRunner, "cinematic writing one")
endfunction

//===========================================================================
function InitTrig_IntroCinematicSetup takes nothing returns nothing
    set gg_trg_IntroCinematicSetup=CreateTrigger()
    call TriggerAddAction(gg_trg_IntroCinematicSetup, function Trig_IntroCinematicSetup_Actions)
endfunction

//===========================================================================
// Trigger: IntroCinematicSkipped
//===========================================================================
function Trig_IntroCinematicSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_IntroCinematicOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCinematicSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinematicIntroSkipped=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_IntroCinematicCleanup)
endfunction

//===========================================================================
function InitTrig_IntroCinematicSkipped takes nothing returns nothing
    set gg_trg_IntroCinematicSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_IntroCinematicSkipped, Player(0))
    call TriggerAddCondition(gg_trg_IntroCinematicSkipped, Condition(function Trig_IntroCinematicSkipped_Conditions))
    call TriggerAddAction(gg_trg_IntroCinematicSkipped, function Trig_IntroCinematicSkipped_Actions)
endfunction

//===========================================================================
// Trigger: IntroCinematicCleanup
//===========================================================================
function Trig_IntroCinematicCleanup_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_IntroCinematicOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCinematicCleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCinematicCleanup_Func010C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicIntroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCinematicCleanup_Func024001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_IntroCinematicCleanup_Func024001002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_IntroCinematicCleanup_Func024001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual)) // INLINED!!
endfunction

function Trig_IntroCinematicCleanup_Func024002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_IntroCinematicCleanup_Func026001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_IntroCinematicCleanup_Func026001002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_IntroCinematicCleanup_Func026001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual)) // INLINED!!
endfunction

function Trig_IntroCinematicCleanup_Func026002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_IntroCinematicCleanup_Func028001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_IntroCinematicCleanup_Func028001002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_IntroCinematicCleanup_Func028001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual)) // INLINED!!
endfunction

function Trig_IntroCinematicCleanup_Func028002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_IntroCinematicCleanup_Func081C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCinematicCleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_IntroCinematicCleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    // //
    set udg_Bool_IntroCinematicOn=false
    // //
    call DisableTrigger(gg_trg_IntroCinematicQ)
    // //
    if ( Trig_IntroCinematicCleanup_Func010C() ) then
        call StopSoundBJ(gg_snd_Comradeship, false)
        call StopSoundBJ(gg_snd_Warcraft_II_Menu_Theme, false)
        call StopSoundBJ(gg_snd_WC3OrcVictory, false)
        call StopSoundBJ(gg_snd_OrcBuildingLoop, false)
        call StopSoundBJ(gg_snd_WC2Orc02ElfArcher1, false)
        call StopSoundBJ(gg_snd_WC2Orc02ElfArcher2, false)
        call StopSoundBJ(gg_snd_WC2Orc02Luric1, false)
        call StopSoundBJ(gg_snd_WC2Orc02Rend1, false)
        call StopSoundBJ(gg_snd_WC2Orc02Rend2, false)
        call StopSoundBJ(gg_snd_WC2Orc02Utok1, false)
    else
    endif
    // //
    // Remove Intro Actors
    // //
    call ShowUnitHide(udg_FakeZuljin)
    call RemoveUnit(udg_FakeRend)
    call RemoveUnit(gg_unit_n602_0156)
    call RemoveUnit(udg_Unit_IntroLuric)
    // //
    call RemoveUnit(gg_unit_o61X_0047)
    call RemoveUnit(gg_unit_o61X_0048)
    call RemoveUnit(gg_unit_o61X_0050)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_ChieftansHall, Condition(function Trig_IntroCinematicCleanup_Func024001002)), function Trig_IntroCinematicCleanup_Func024002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_BlackSmith, Condition(function Trig_IntroCinematicCleanup_Func026001002)), function Trig_IntroCinematicCleanup_Func026002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Farm01, Condition(function Trig_IntroCinematicCleanup_Func028001002)), function Trig_IntroCinematicCleanup_Func028002)
    // //
    call SetSkyModel(null)
    // //
    // Restore Gameplay Units
    // //
    call ShowUnitShow(udg_Hero_Zuljin)
    // //
    call ShowUnitShow(udg_Unit_Captain)
    call SetUnitPositionLocFacingLocBJ(udg_Unit_Captain, GetRectCenter(gg_rct_CityBattle01), GetRectCenter(gg_rct_Step03VF))
    call SetUnitMoveSpeed(udg_Unit_Captain, GetUnitDefaultMoveSpeed(udg_Unit_Captain))
    call BlzSetUnitRealFieldBJ(udg_Unit_Captain, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", udg_Unit_Captain)
    call SetUnitBlendTimeBJ(udg_Unit_Captain, 0.15)
    // //
    call ShowUnitShow(udg_Hero_Rend)
    call SetUnitBlendTimeBJ(udg_Hero_Rend, 0.15)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_UrukDefault), GetRectCenter(gg_rct_Uruk03))
    call SetUnitOwner(udg_Hero_Rend, udg_Player_Actual, false)
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', false, false)
    // //
    call CreateNUnitsAtLoc(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_PeonDefault01), 225.00)
    call CreateNUnitsAtLoc(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_PeonDefault02), 235.00)
    call CreateNUnitsAtLoc(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_PeonDefault03), 215.00)
    // //
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", udg_SemiHero_Utok)
    // //
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroRunner, GetRectCenter(gg_rct_MilanAtDurnhole), 315.00)
    // //
    call TriggerSleepAction(0.25)
    // //
    call CreateNUnitsAtLoc(1, 'o614', udg_Player_Actual, GetRectCenter(gg_rct_ChieftansHall), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A61M', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BlackSmith), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A62Z', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_Farm01), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A62Z', GetLastCreatedUnit())
    // //
    call ResetUnitAnimation(gg_unit_h60K_0127)
    call ResetUnitAnimation(gg_unit_h60K_0128)
    call SetUnitBlendTimeBJ(udg_Unit_IntroRunner, 0.15)
    call SetUnitBlendTimeBJ(udg_SemiHero_Utok, 0.15)
    call SetUnitScalePercent(udg_Hero_Zuljin, 100.00, 100.00, 100.00)
    call ShowUnitShow(udg_SemiHero_Utok)
    // //
    // //
    call DisableTrigger(gg_trg_IntroCinematicSkipped)
    call CameraSetupApplyForPlayer(true, gg_cam_Standart, Player(0), 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    call CinematicModeBJ(false, bj_FORCE_PLAYER[0])
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_IntroCinematicCleanup_Func081C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    call QueuedTriggerRemoveBJ(gg_trg_IntroCinematicQ)
    // //
    call SelectUnitSingle(udg_Hero_Rend)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 1.00)
    call TriggerSleepAction(1.00)
    call TriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    call TriggerExecute(gg_trg_Strength_Discover)
    call TriggerSleepAction(15.00)
    call TriggerExecute(gg_trg_Zuljin_Discover)
    // //
    // //
    // //
    // //
endfunction

