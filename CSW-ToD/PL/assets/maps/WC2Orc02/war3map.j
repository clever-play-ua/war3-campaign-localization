//===========================================================================
// Trigger: Durnholde UpdateCompleted Q
//===========================================================================
function Trig_Durnholde_UpdateCompleted_Q_Func001Func011C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeBarracks) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Durnholde_UpdateCompleted_Q_Func001Func012C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeTownHall) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Durnholde_UpdateCompleted_Q_Func001Func013C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeFarmArray[1]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeFarmArray[2]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeFarmArray[3]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Durnholde_UpdateCompleted_Q_Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeBarracks) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeTownHall) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeFarmArray[1]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeFarmArray[2]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_DurnholdeFarmArray[3]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Durnholde_UpdateCompleted_Q_Actions takes nothing returns nothing
    if ( Trig_Durnholde_UpdateCompleted_Q_Func001C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call SetStackedSoundBJ(false, gg_snd_CS_H01a_village_004_LR_v3, gg_rct_Guard)
        call QuestSetCompletedBJ(udg_OQ_Durnholde, true)
        call QuestItemSetCompletedBJ(udg_QReq_DurnholeDestroyBarracks, true)
        call QuestItemSetCompletedBJ(udg_QReq_DurnholdeDestroyTownHall, true)
        call QuestItemSetCompletedBJ(udg_QReq_DurnholdeDestroyFarms, true)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2616")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerAddBJ(gg_trg_DurnholdeCinematicQ, true)
    else
        set udg_newLine="\n"
        set udg_String_CompletedQuests=( BlzGetItemDescription(gg_item_IQL0_0247) + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL0_0247) ) )
        if ( Trig_Durnholde_UpdateCompleted_Q_Func001Func011C() ) then
            call QuestItemSetCompletedBJ(udg_QReq_DurnholeDestroyBarracks, true)
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL1_0248) ) )
        else
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + "  - Zniszcz koszary" ) )
        endif
        if ( Trig_Durnholde_UpdateCompleted_Q_Func001Func012C() ) then
            call QuestItemSetCompletedBJ(udg_QReq_DurnholdeDestroyTownHall, true)
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL1_0248) ) )
        else
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL1_0248) ) )
        endif
        if ( Trig_Durnholde_UpdateCompleted_Q_Func001Func013C() ) then
            call QuestItemSetCompletedBJ(udg_QReq_DurnholdeDestroyFarms, true)
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL0_0247) ) )
        else
            set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL0_0247) ) )
        endif
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    endif
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

