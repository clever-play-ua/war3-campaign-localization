function Trig_VOChogallBossfight02Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    set udg_Boss_Phase1_Chance_Orbs_D=GetRandomInt(1, 2)
    if ( Trig_VOChogallBossfight02Q_Func003C() ) then
        call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_TwilightHammer, 'O001', GetCameraTargetPositionLoc(), gg_snd_WC2Orc12ChoGall5, bj_TIMETYPE_ADD, 0, true)
    else
        call PlaySoundBJ(gg_snd_WC2Orc08ChoGall5)
        call SetSoundOffsetBJ(1.70, gg_snd_WC2Orc08ChoGall5)
        call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_TwilightHammer, 'O001', GetCameraTargetPositionLoc(), null, bj_TIMETYPE_SET, 2.60, false)
        call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3334")
        call WaitForSoundBJ(gg_snd_WC2Orc08ChoGall5, 0)
    endif
    call VolumeGroupResetBJ()
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

