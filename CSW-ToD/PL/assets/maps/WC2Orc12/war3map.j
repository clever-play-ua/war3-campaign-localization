// BNsi - Silenced
// BPac - Turalyon Crusader Strike
//===========================================================================
function Trig_WhirlwindCasterUnderSpellDamage_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == 'u000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_WhirlwindCasterUnderSpellDamage_Actions takes nothing returns nothing
    local unit w
    local unit dk
    // //
    set dk=GetSpellTargetUnit()
    // //
     if ( ( UnitHasBuffBJ(dk, 'BPSE') == true ) or ( UnitHasBuffBJ(dk, 'BNsi') == true ) or ( UnitHasBuffBJ(dk, 'BPac') == true ) ) then
    set w=LoadUnitHandle(udg_Hashtable_WhirlwindSpell, GetHandleId(dk), 0)
    if w != null then
    call KillUnit(w)
    endif
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, GetHandleId(dk))
    endif
    // //
endfunction

//===========================================================================
function InitTrig_WhirlwindCasterUnderSpellDamage takes nothing returns nothing
    set gg_trg_WhirlwindCasterUnderSpellDamage=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_WhirlwindCasterUnderSpellDamage, EVENT_PLAYER_UNIT_SPELL_EFFECT)
