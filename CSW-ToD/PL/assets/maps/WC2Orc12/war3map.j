    return true
endfunction

function Trig_P07PlayerMarineAttackOrderPoint_2_Actions takes nothing returns nothing
    local integer locOrderID= GetIssuedOrderId()
    local real locOrderX
    local real locOrderY
    local unit locOrderedUnit
    local boolean accurateSignalIsDetected= false
    // //
    local integer landingrolldiceMainOrc
    local integer landingrolldiceExpGoldmine
    local integer landingrolldiceCultistIsland
    local integer landingrolldiceStormReaverCamp
    local integer landingrolldiceTwilightCamp
    // //
    if locOrderID == 851988 or locOrderID == 851986 or locOrderID == 851983 then
    set locOrderedUnit=GetOrderedUnit()
    set locOrderX=GetOrderPointX()
    set locOrderY=GetOrderPointY()
    // //
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func019C() ) then
        set udg_MarineAttackPointIsSet[7]=true
        call MoveLocation(udg_MarineAttackPoint[7], locOrderX, locOrderY)
    else
    endif
    // //
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func021C() ) then
        call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, udg_MarineAttackPoint[7], 1, bj_MINIMAPPINGSTYLE_FLASHY, 0.00, 100.00, 0.00)
    else
    endif
    // //
    // //
    // We check of out Boarding Temp Point exists in the Particular Regions
    // And if the Unit is in the same region or it has to reach it first
    // //
    // First batch is for cases when our attackers are not yet in the area for landing
    // //
    // We start with the attacking player own base area
    // //
    // Storm Reaver Island
    // //
    if RectContainsUnit(gg_rct_StormReaverIsland, locOrderedUnit) then
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func034C() ) then
        set accurateSignalIsDetected=true
    else
    endif
    endif
    // //
    // Twilight Hammer Camp
    // //
    if RectContainsUnit(gg_rct_TwilightBase, locOrderedUnit) then
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func040C() ) then
        set accurateSignalIsDetected=true
    else
    endif
    endif
    // //
    // Goldmine Expansion
    // //
    if RectContainsUnit(gg_rct_ExpansionGoldmine, locOrderedUnit) then
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func046C() ) then
        set accurateSignalIsDetected=true
    else
    endif
    endif
    // //
    // Cultist Island
    // //
    if RectContainsUnit(gg_rct_CultistsIsland, locOrderedUnit) then
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func052C() ) then
        set accurateSignalIsDetected=true
    else
    endif
    endif
    // //
    // Orcs Main Base Area
    // //
    if RectContainsUnit(gg_rct_PlayerMainBase01, locOrderedUnit) or RectContainsUnit(gg_rct_PlayerMainBase02, locOrderedUnit) then
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func058C() ) then
        set accurateSignalIsDetected=true
    else
    endif
    endif
    // //
    // Second Batch of checks is for cases when they are in the landing areas
    // //
    if accurateSignalIsDetected then
    // //
    // Storm Reaver Camp
    // //
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func067C() ) then
        // //
        set landingrolldiceStormReaverCamp=GetRandomInt(1, 2)
        // //
        if landingrolldiceStormReaverCamp == 1 then
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingStormReaver01)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingStormReaver01)
        else
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingStormReaver02)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingStormReaver02)
        endif
        // //
    else
    endif
    // //
    // Twiligh Hammer Camp
    // //
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func071C() ) then
        // //
        set landingrolldiceTwilightCamp=GetRandomInt(1, 2)
        // //
        if landingrolldiceTwilightCamp == 1 then
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingTwilightHammer01)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingTwilightHammer01)
        else
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingTwilightHammer02)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingTwilightHammer02)
        endif
        // //
    else
    endif
    // //
    // Goldmine Expansion
    // //
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func075C() ) then
        // //
        set landingrolldiceExpGoldmine=GetRandomInt(1, 2)
        // //
        if landingrolldiceExpGoldmine == 1 then
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingExpansion01)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingExpansion01)
        elseif landingrolldiceExpGoldmine == 2 then
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingExpansion02)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingExpansion02)
        endif
        // //
    else
    endif
    // //
    // Cultist Island
    // //
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func079C() ) then
        // //
        set landingrolldiceCultistIsland=GetRandomInt(1, 2)
        // //
        if landingrolldiceCultistIsland == 1 then
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingCultistIsland01)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingCultistIsland01)
        elseif landingrolldiceCultistIsland == 2 then
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingCultistIsland02)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingCultistIsland02)
        endif
        // //
    else
    endif
    // //
    // Orc Base
    // //
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func083C() ) then
        // //
        set landingrolldiceMainOrc=GetRandomInt(1, 2)
        // //
        if landingrolldiceMainOrc == 1 then
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingMainOrcBase03)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingMainOrcBase03)
        elseif landingrolldiceMainOrc == 2 then
        set udg_AttackOrderPointerX[7]=GetLocationX(udg_Point_LandingMainOrcBase04)
        set udg_AttackOrderPointerY[7]=GetLocationY(udg_Point_LandingMainOrcBase04)
        endif
        // //
    else
    endif
    // //
    // //
    // closing accurate signal is detected check
    endif
    // Avoid Attacking Oil Rigs
    // //
    // //
    if accurateSignalIsDetected and s__ForceBoarding_struct[GetUnitUserData(locOrderedUnit)] == 0 and not IsUnitInGroup(locOrderedUnit, udg_UnitsInCargo) then
    call GroupAddUnit(udg_IdleMarines[7], locOrderedUnit)
    endif
    // //
    // closing if statement for attack order ID check
    endif
    // //
    set locOrderedUnit=null
    // //
    if ( Trig_P07PlayerMarineAttackOrderPoint_2_Func101C() ) then
        set udg_MarineAttackPointIsSet[7]=false
    else
    endif
    // //
    // //
    // //
endfunction

