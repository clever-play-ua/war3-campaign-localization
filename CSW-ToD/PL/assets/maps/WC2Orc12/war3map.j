function Trig_P04DeindexPassengers_Func011C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oFMa' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oGMa' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oCaM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oDkM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oOMa' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oOmM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'n000' ) ) then
        return true
    endif
    return false
endfunction

