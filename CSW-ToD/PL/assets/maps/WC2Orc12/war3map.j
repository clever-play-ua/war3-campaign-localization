    if ( not ( GetTriggerUnit() == udg_Unit_Drakthul ) ) then
        return false
    endif
    if ( not ( IsQuestDiscovered(udg_OQShadowCouncill) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_VODrakThulClickOn_Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VODrakThulClickOn_Func004Func001Func002C takes nothing returns boolean
    if ( not ( udg_Int_DrakthulRantChance == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VODrakThulClickOn_Func004Func001C takes nothing returns boolean
    if ( not ( udg_Int_DrakthulRantChance == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VODrakThulClickOn_Func004C takes nothing returns boolean
    if ( not ( udg_Int_DrakthulRantChance == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VODrakThulClickOn_Func006Func002Func002C takes nothing returns boolean
    if ( not ( udg_Int_DrakthulRantChance == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VODrakThulClickOn_Func006Func002C takes nothing returns boolean
    if ( not ( udg_Int_DrakthulRantChance == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VODrakThulClickOn_Func006C takes nothing returns boolean
    if ( not ( udg_Int_DrakthulRantChance == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VODrakThulClickOn_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetSpeechVolumeGroupsBJ()
    // //
    if ( Trig_VODrakThulClickOn_Func004C() ) then
        set udg_Int_DrakthulRantChance=GetRandomInt(2, 4)
    else
        if ( Trig_VODrakThulClickOn_Func004Func001C() ) then
            if ( Trig_VODrakThulClickOn_Func004Func001Func001C() ) then
                set udg_Int_DrakthulRantChance=GetRandomInt(3, 4)
            else
                set udg_Int_DrakthulRantChance=1
            endif
        else
            if ( Trig_VODrakThulClickOn_Func004Func001Func002C() ) then
                set udg_Int_DrakthulRantChance=GetRandomInt(1, 2)
            else
                set udg_Int_DrakthulRantChance=GetRandomInt(1, 4)
            endif
        endif
    endif
    // //
    if ( Trig_VODrakThulClickOn_Func006C() ) then
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_Drakthul, 'odkt', gg_snd_WC2Orc12Drakthul7, bj_TIMETYPE_ADD, 0, true)
    else
        if ( Trig_VODrakThulClickOn_Func006Func002C() ) then
            call SetSpeechVolumeGroupsBJ()
            call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_Drakthul, 'odkt', gg_snd_WC2Orc12Drakthul8, bj_TIMETYPE_ADD, 0, true)
        else
            if ( Trig_VODrakThulClickOn_Func006Func002Func002C() ) then
                call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_Drakthul, 'odkt', gg_snd_WC2Orc12Drakthul9, bj_TIMETYPE_ADD, 0, true)
            else
            endif
        endif
    endif
    // //
    call VolumeGroupResetBJ()
    call EnableTrigger(GetTriggeringTrigger())
endfunction

