    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_StormWeaver ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P7_Defeated_Func005001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_AI_P7_Defeated_Func005001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P7_Defeated_Func005001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P7_Defeated_Func005A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerSRDefeatCondition)
endfunction

