    return ( GetUnitTypeId(GetFilterUnit()) == 'o60V' )
endfunction

function Trig_AI_P5_Defeated_Func005001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P5_Defeated_Func005001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o60V'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

