function Trig_AI_P04_Attacker_Being_Attacked_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_AI_P04_Attacker_Being_Attacked_Func002C() ) then
        call ForGroupBJ(udg_G_P04_AttackerGround, function Trig_AI_P04_Attacker_Being_Attacked_Func002Func002A)
        call ForGroupBJ(udg_G_P04_AttackerDK, function Trig_AI_P04_Attacker_Being_Attacked_Func002Func003A)
        call PolledWait(6.00)
        call ForGroupBJ(udg_G_P04_AttackerGround, function Trig_AI_P04_Attacker_Being_Attacked_Func002Func005A)
        call ForGroupBJ(udg_G_P04_AttackerDK, function Trig_AI_P04_Attacker_Being_Attacked_Func002Func006A)
    else
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction

