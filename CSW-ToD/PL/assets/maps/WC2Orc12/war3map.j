function InitTrig_P07PlayerMarineAttackOrderPoint_2 takes nothing returns nothing
    set gg_trg_P07PlayerMarineAttackOrderPoint_2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_P07PlayerMarineAttackOrderPoint_2, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddCondition(gg_trg_P07PlayerMarineAttackOrderPoint_2, Condition(function Trig_P07PlayerMarineAttackOrderPoint_2_Conditions))
    call TriggerAddAction(gg_trg_P07PlayerMarineAttackOrderPoint_2, function Trig_P07PlayerMarineAttackOrderPoint_2_Actions)
endfunction

