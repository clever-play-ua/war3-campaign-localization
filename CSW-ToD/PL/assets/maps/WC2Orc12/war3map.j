        return false
    endif
    return true
endfunction

function Trig_Easy_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Upgrades
    // P4
    // P7
    // ShadowCouncilRemnants
    call SetPlayerTechResearchedSwap('R00T', 1, udg_Player_ShadowCouncil)
    call SetPlayerTechResearchedSwap('R00S', 1, udg_Player_ShadowCouncil)
    call SetPlayerTechResearchedSwap('R60K', 1, udg_Player_ShadowCouncil)
    call SetPlayerTechResearchedSwap('R003', 1, udg_Player_ShadowCouncil)
    call SetPlayerTechResearchedSwap('R001', 1, udg_Player_ShadowCouncil)
    // Creeps
    call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), 150.00)
    call SetPlayerHandicapDamageBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), 125.00)
endfunction

