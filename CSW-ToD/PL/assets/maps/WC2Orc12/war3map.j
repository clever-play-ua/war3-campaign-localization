//===========================================================================
// Trigger: AI P4 Start
//===========================================================================
function Trig_AI_P4_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call AdjustPlayerStateBJ(30000, udg_Player_TwilightHammer, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(30000, udg_Player_TwilightHammer, PLAYER_STATE_RESOURCE_LUMBER)
    call AdjustPlayerStateBJ(60, udg_Player_TwilightHammer, PLAYER_STATE_RESOURCE_FOOD_CAP)
    // //
    call EnableTrigger(gg_trg_AI_P4_Gold)
    call EnableTrigger(gg_trg_AI_P4_Lumber)
    // //
    call ConditionalTriggerExecute(gg_trg_P04TransportationConfig)
    // //
    call StartCampaignAI(udg_Player_TwilightHammer, "CSW\\Scripts\\ToDScripts\\WC2Orc12\\WC2Orc12P04GroundAI.ai")
    // //
    // //
endfunction

