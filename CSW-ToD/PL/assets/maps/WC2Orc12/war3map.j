//===========================================================================
// Trigger: InitEnvironment
//===========================================================================
function Trig_InitEnvironment_Func011Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B00B' ) ) then
        return false
    endif
    return true
endfunction

function Trig_InitEnvironment_Func011Func002C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B00C' ) ) then
        return false
    endif
    return true
endfunction

function Trig_InitEnvironment_Func011A takes nothing returns nothing
    if ( Trig_InitEnvironment_Func011Func001C() ) then
        call SetDestructableAnimationBJ(GetEnumDestructable(), "death one")
    else
    endif
    if ( Trig_InitEnvironment_Func011Func002C() ) then
        call ShowDestructableBJ(false, GetEnumDestructable())
    else
    endif
endfunction

function Trig_InitEnvironment_Actions takes nothing returns nothing
    // Initial Time Of Day
    call SetTimeOfDay(19.00)
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_COMBAT, 0.00)
    // Weather Effects
    // Fog
    // Initial Visibility
    // Lightning Bolts
    call SetDoodadAnimationRectBJ("death", 'YOlb', GetEntireMapRect())
    call SetDoodadAnimationRectBJ("death", 'D014', gg_rct_Guldan_Clans)
    // Old God Stuff
    call EnumDestructablesInRectAll(gg_rct_Boss_Battle_Area, function Trig_InitEnvironment_Func011A)
    // Treasure
    call SetDestructableAnimationBJ(gg_dest_B00E_8581, "stand alternate")
    // Localization items
    call SetItemVisibleBJ(false, gg_item_IQL0_0340)
endfunction

