    set gg_trg_Hermit_1_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Hermit_1_Setup, function Trig_Hermit_1_Setup_Actions)
endfunction

//===========================================================================
// Trigger: Hermit Cinematic 1 Q
//===========================================================================
function Trig_Hermit_Cinematic_1_Q_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hermit_Cinematic_1_Q_Func015001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func035001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func044001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func053001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

