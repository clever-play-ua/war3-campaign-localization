//===========================================================================
// Trigger: Boss Phase 3 Chogall Teleport
//===========================================================================
function Trig_Boss_Phase_3_Chogall_Teleport_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Boss_ChoGall), "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidTeleportTo.mdx")
    set udg_Boss_Effect_Teleport_Portal=GetLastCreatedEffectBJ()
    call DestroyEffectBJ(udg_Boss_Effect_Teleport_Portal)
    call PolledWait(2.00)
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Boss_ChoGall), "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidTeleportTarget.mdx")
    set udg_Boss_Effect_Teleport=GetLastCreatedEffectBJ()
    call DestroyEffectBJ(udg_Boss_Effect_Teleport)
    call SetUnitPositionLocFacingBJ(udg_Boss_ChoGall, GetRectCenter(gg_rct_Boss_Phase_3_Center), 225.00)
    call PauseUnitBJ(false, udg_Boss_ChoGall)
    call ReplaceUnitBJ(udg_Boss_ChoGall, 'O005', bj_UNIT_STATE_METHOD_ABSOLUTE)
    set udg_Boss_ChoGall=GetLastReplacedUnitBJ()
    call LockGuardPosition(udg_Boss_ChoGall)
    call DestroyMinimapIcon(udg_MinimapIcon_BossFightChogall)
    call CampaignMinimapIconUnitBJ(udg_Boss_ChoGall, bj_CAMPPINGSTYLE_BOSS)
    set udg_MinimapIcon_BossFightChogall=GetLastCreatedMinimapIcon()
    //  
    call ConditionalTriggerExecute(gg_trg_Boss_Phase_3)
endfunction

