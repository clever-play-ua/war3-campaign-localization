//===========================================================================
// Trigger: Boss Prep
//===========================================================================
function Trig_Boss_Prep_Func009Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetTriggerUnit(), udg_Player_TwilightHammer) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Prep_Func009A takes nothing returns nothing
    if ( Trig_Boss_Prep_Func009Func001C() ) then
        call ShowUnitHide(GetEnumUnit())
        call PauseUnitBJ(true, GetEnumUnit())
    else
    endif
endfunction

function Trig_Boss_Prep_Func014Func007Func007C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Prep_Func014Func007C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Prep_Func014C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Prep_Func034001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false )
endfunction

function Trig_Boss_Prep_Func034A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
    // Make Invoulnerable to Prevent Aggro
    call SetUnitInvulnerable(GetEnumUnit(), true)
endfunction

function Trig_Boss_Prep_Func036002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Boss_Prep_Func045C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Rend) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Prep_Func047C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Maim) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Prep_Actions takes nothing returns nothing
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, gg_rct_Boss_Battle_Area)
    call CreateFogModifierRectBJ(true, udg_Player_TwilightHammer, FOG_OF_WAR_VISIBLE, gg_rct_Boss_Battle_Area)
    call CreateFogModifierRectBJ(true, Player(PLAYER_NEUTRAL_PASSIVE), FOG_OF_WAR_VISIBLE, gg_rct_Boss_Battle_Area)
    //  
    // Hide Units
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Boss_Prep_Func009A)
    //  
    // Difficulty
    //  
    set udg_Boss_ChoGall=gg_unit_O001_0087
    if ( Trig_Boss_Prep_Func014C() ) then
        call BlzSetUnitMaxHP(udg_Boss_ChoGall, 10000)
        call BlzSetUnitArmor(udg_Boss_ChoGall, 5.00)
        set udg_Boss_Warstomp_Damage=1
        set udg_Boss_Orb_Damage=50
        set udg_Boss_Ogre_Damage=75.00
        set udg_Boss_Twilight_Damage=300.00
    else
        if ( Trig_Boss_Prep_Func014Func007C() ) then
            call BlzSetUnitMaxHP(udg_Boss_ChoGall, 10000)
            call BlzSetUnitArmor(udg_Boss_ChoGall, 10.00)
            set udg_Boss_Warstomp_Damage=2
            set udg_Boss_Orb_Damage=75
            set udg_Boss_Ogre_Damage=125.00
            set udg_Boss_Twilight_Damage=400.00
        else
            if ( Trig_Boss_Prep_Func014Func007Func007C() ) then
                call BlzSetUnitMaxHP(udg_Boss_ChoGall, 10000)
                call BlzSetUnitArmor(udg_Boss_ChoGall, 15.00)
                set udg_Boss_Warstomp_Damage=3
                set udg_Boss_Orb_Damage=100
                set udg_Boss_Ogre_Damage=200.00
                set udg_Boss_Twilight_Damage=500.00
            else
            endif
        endif
    endif
    //  
    call ShowUnitShow(udg_Boss_ChoGall)
    call PauseUnitBJ(false, udg_Boss_ChoGall)
    call SetUnitAnimation(udg_Boss_ChoGall, "stand ready")
    call SetUnitTimeScalePercent(udg_Boss_ChoGall, 75.00)
    //  
    call CampaignMinimapIconUnitBJ(udg_Boss_ChoGall, bj_CAMPPINGSTYLE_BOSS)
    set udg_MinimapIcon_BossFightChogall=GetLastCreatedMinimapIcon()
    //  
    call ModifyGateBJ(bj_GATEOPERATION_CLOSE, gg_dest_DIG2_1826)
    //  
    call SetUnitLifePercentBJ(udg_Boss_ChoGall, 100)
    call SetUnitManaPercentBJ(udg_Boss_ChoGall, 100)
    //  
    call ShowUnitHide(udg_Hero_Zuluhed)
    call SetUnitOwner(udg_Hero_Zuluhed, udg_Player_Zuluhed, false)
    call ShowUnitHide(udg_SemiHero_Utok)
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Boss_Prep_Func034001002)), function Trig_Boss_Prep_Func034A)
    //  
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Boss_Prep_Func036002)
    //  
    call PauseAllUnitsBJ(true)
    call PauseUnitBJ(false, udg_Boss_ChoGall)
    call PauseUnitBJ(false, udg_Hero_Rend)
    call PauseUnitBJ(false, udg_Hero_Maim)
    //  
    // Heroes
    //  
    if ( Trig_Boss_Prep_Func045C() ) then
        call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_Boss_Rend_Start), GetRectCenter(gg_rct_Boss_Phase_1_Center))
        call SetUnitLifePercentBJ(udg_Hero_Rend, 100)
        call SetUnitManaPercentBJ(udg_Hero_Rend, 100)
        call BlzEndUnitAbilityCooldown(udg_Hero_Rend, 'AR9Q')
        call BlzEndUnitAbilityCooldown(udg_Hero_Rend, 'A00O')
    else
        call ReviveHeroLoc(udg_Hero_Rend, GetRectCenter(gg_rct_Boss_Maim_Start), false)
        call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_Boss_Rend_Start), GetRectCenter(gg_rct_Boss_Phase_1_Center))
        call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_Boss_Rend_Start), GetRectCenter(gg_rct_Boss_Phase_1_Center))
        call SetUnitLifePercentBJ(udg_Hero_Rend, 100)
        call SetUnitManaPercentBJ(udg_Hero_Rend, 100)
        call BlzEndUnitAbilityCooldown(udg_Hero_Rend, 'AR9Q')
        call BlzEndUnitAbilityCooldown(udg_Hero_Rend, 'A00O')
    endif
    //  
    if ( Trig_Boss_Prep_Func047C() ) then
        call SetUnitPositionLocFacingLocBJ(udg_Hero_Maim, GetRectCenter(gg_rct_Boss_Maim_Start), GetRectCenter(gg_rct_Boss_Phase_1_Center))
        call SetUnitLifePercentBJ(udg_Hero_Maim, 100)
        call SetUnitManaPercentBJ(udg_Hero_Maim, 100)
        call BlzEndUnitAbilityCooldown(udg_Hero_Maim, 'A00J')
        call BlzEndUnitAbilityCooldown(udg_Hero_Maim, 'A00M')
        call BlzEndUnitAbilityCooldown(udg_Hero_Maim, 'A00L')
    else
        call ReviveHeroLoc(udg_Hero_Maim, GetRectCenter(gg_rct_Boss_Maim_Start), false)
        call SetUnitPositionLocFacingLocBJ(udg_Hero_Maim, GetRectCenter(gg_rct_Boss_Maim_Start), GetRectCenter(gg_rct_Boss_Phase_1_Center))
        call SetUnitLifePercentBJ(udg_Hero_Maim, 100)
        call SetUnitManaPercentBJ(udg_Hero_Maim, 100)
        call BlzEndUnitAbilityCooldown(udg_Hero_Maim, 'A00J')
        call BlzEndUnitAbilityCooldown(udg_Hero_Maim, 'A00M')
        call BlzEndUnitAbilityCooldown(udg_Hero_Maim, 'A00L')
    endif
    //  
    set udg_Boss_Heroes=GetUnitsInRangeOfLocAll(1.00, GetRectCenter(gg_rct_Boss_Battle_Area))
    call GroupClear(udg_Boss_Heroes)
    //  
    call GroupAddUnitSimple(udg_Hero_Rend, udg_Boss_Heroes)
    call GroupAddUnitSimple(udg_Hero_Maim, udg_Boss_Heroes)
    //  
    call SetUnitAnimation(udg_Hero_Rend, "stand ready")
    call SetUnitAnimation(udg_Hero_Maim, "stand ready")
    //  
    // Shamans
    //  
    call UnitAddAbilityBJ('Avul', udg_Boss_Zuluhed)
    call UnitAddAbilityBJ('Avul', udg_Boss_Utok)
    //  
    call ShowUnitShow(udg_Boss_Zuluhed)
    call PauseUnitBJ(false, udg_Boss_Zuluhed)
    call UnitAddAbilityBJ('ACB7', udg_Boss_Zuluhed)
    call SetUnitColor(udg_Boss_Zuluhed, PLAYER_COLOR_SNOW)
    call SetUnitAnimation(udg_Boss_Zuluhed, "stand ready")
    call RemoveGuardPosition(udg_Boss_Zuluhed)
    call UnitAddAbility(udg_Boss_Zuluhed, 'Aloc')
    //  
    call ShowUnitShow(udg_Boss_Utok)
    call PauseUnitBJ(false, udg_Boss_Utok)
    call SetUnitColor(udg_Boss_Utok, PLAYER_COLOR_RED)
    call SetUnitAnimation(udg_Boss_Utok, "stand ready")
    call RemoveGuardPosition(udg_Boss_Utok)
    call UnitAddAbility(udg_Boss_Utok, 'Aloc')
    //  
    //  
    // Sound
    //  
    call SetMusicVolumeBJ(0.00)
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_MUSIC, 0.00)
    // --------------------------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Boss_Phase_1)
    call QueuedTriggerAddBJ(gg_trg_VOZuluhedBossfightQ, true)
endfunction

