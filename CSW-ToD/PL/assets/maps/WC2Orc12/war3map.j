function Trig_OgreMagiTransformTH_Conditions takes nothing returns boolean
    if ( not ( GetResearched() == 'R00X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgreMagiTransformTH_Func007001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n001' )
endfunction

function Trig_OgreMagiTransformTH_Func007001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_OgreMagiTransformTH_Func007001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'n001'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_OgreMagiTransformTH_Func007A takes nothing returns nothing
    set udg_Point_OgreTransformTemp=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_Point_OgreTransformTemp, "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_OgreMagiTransform=GetLastCreatedEffectBJ()
    call ReplaceUnitBJ(GetEnumUnit(), 'n002', bj_UNIT_STATE_METHOD_DEFAULTS)
    call DestroyEffectBJ(udg_SE_OgreMagiTransform)
    call RemoveLocation(udg_Point_OgreTransformTemp)
endfunction

function Trig_OgreMagiTransformTH_Func010001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'oOMa' )
endfunction

function Trig_OgreMagiTransformTH_Func010001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_OgreMagiTransformTH_Func010001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'oOMa'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_OgreMagiTransformTH_Func010A takes nothing returns nothing
    set udg_Point_OgreTransformTemp=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_Point_OgreTransformTemp, "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_OgreMagiTransform=GetLastCreatedEffectBJ()
    call ReplaceUnitBJ(GetEnumUnit(), 'oOmM', bj_UNIT_STATE_METHOD_DEFAULTS)
    call DestroyEffectBJ(udg_SE_OgreMagiTransform)
    call RemoveLocation(udg_Point_OgreTransformTemp)
endfunction

function Trig_OgreMagiTransformTH_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerTechResearchedSwap('ROmM', 1, udg_Player_TwilightHammer)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_TwilightHammer, Condition(function Trig_OgreMagiTransformTH_Func007001002)), function Trig_OgreMagiTransformTH_Func007A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_TwilightHammer, Condition(function Trig_OgreMagiTransformTH_Func010001002)), function Trig_OgreMagiTransformTH_Func010A)
endfunction

