    call PlayThematicMusicBJ("Tension")
    //  
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.50)
    call SetUnitAnimation(udg_FakeMaim, "stand ready")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc12Maim3, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Maim3, 0)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Zuluhed 10 - Moved to separate Trigger
    //  
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC ENDS - Cinematic Can No Longer Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call DisableTrigger(gg_trg_Warlock_Skipped)
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // Cleanup
    call ConditionalTriggerExecute(gg_trg_Warlock_Cleanup)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call CinematicModeBJ(false, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // Quest update
    call ConditionalTriggerExecute(gg_trg_Quest_Kill_Chogall_Discover)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    set udg_Bool_InCinematic=false
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Warlock_Cinematic_Q takes nothing returns nothing
    set gg_trg_Warlock_Cinematic_Q=CreateTrigger()
    call DisableTrigger(gg_trg_Warlock_Cinematic_Q)
    call TriggerAddCondition(gg_trg_Warlock_Cinematic_Q, Condition(function Trig_Warlock_Cinematic_Q_Conditions))
    call TriggerAddAction(gg_trg_Warlock_Cinematic_Q, function Trig_Warlock_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Warlock Skipped
//===========================================================================
function Trig_Warlock_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinWarlockSkipped=true
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    // Cleanup
    call ConditionalTriggerExecute(gg_trg_Warlock_Cleanup)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // Quest Update
    call ConditionalTriggerExecute(gg_trg_Quest_Kill_Chogall_Discover)
    // To Do: Reveal naga check
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    set udg_Bool_InCinematic=false
    call QueuedTriggerRemoveBJ(gg_trg_Warlock_Cinematic_Q)
endfunction

//===========================================================================
function InitTrig_Warlock_Skipped takes nothing returns nothing
    set gg_trg_Warlock_Skipped=CreateTrigger()
    call DisableTrigger(gg_trg_Warlock_Skipped)
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Warlock_Skipped, Player(0))
    call TriggerAddAction(gg_trg_Warlock_Skipped, function Trig_Warlock_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Warlock Cleanup
//===========================================================================
function Trig_Warlock_Cleanup_Func007002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Warlock_Cleanup_Func008002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Warlock_Cleanup_Func011A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Warlock_Cleanup_Func033C takes nothing returns boolean
    if ( not ( udg_Bool_CinWarlockSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Warlock_Cleanup_Actions takes nothing returns nothing
    call CameraSetFocalDistance(0.00)
    call StopSoundBJ(gg_snd_Demonic_Theme_2, true)
    call StopSoundBJ(gg_snd_Demonic_Theme_201, true)
    // Restore Abilities
    call SetPlayerAbilityAvailableBJ(true, 'Ashm', udg_Player_Actual)
    // Unhide Units
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Warlock_Cleanup_Func007002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Warlock_Cleanup_Func008002)
    call GroupClear(udg_Group_HiddenUnits)
    // Remove Units
    call ForGroupBJ(udg_Group_GuldanClans, function Trig_Warlock_Cleanup_Func011A)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call RemoveUnit(gg_unit_O007_0000)
    call RemoveUnit(udg_Unit_CinematicDaemon)
    set udg_Hero_Chogall=gg_unit_O001_0087
    call SetItemVisibleBJ(false, gg_item_IQL0_0340)
    // Unpause Units
    call PauseAllUnitsBJ(false)
    // Reset Fog
    call ResetTerrainFogBJ()
    // Reset Camera
    call CameraResetSmoothingFactorBJ()
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_Boss_Phase_1_Center), 0)
    call TriggerSleepAction(0.01)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_Boss_Battle_Area)
    call BlzChangeMinimapTerrainTex("Mission12MapBoss.tga")
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call EnableTrigger(gg_trg_Victory_Cinematic_Q)
    call EnableDawnDusk(true)
    call ConditionalTriggerExecute(gg_trg_Boss_Prep)
    if ( Trig_Warlock_Cleanup_Func033C() ) then
        call CinematicModeBJ(false, GetPlayersAll())
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    else
    endif
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call SetDestructableAnimationBJ(gg_dest_DMAG_7423, "stand")
    call SetDestructableAnimationBJ(gg_dest_DMAG_7422, "stand")
    call SetDestructableAnimationBJ(gg_dest_DMAG_2172, "stand")
endfunction

//===========================================================================
function InitTrig_Warlock_Cleanup takes nothing returns nothing
    set gg_trg_Warlock_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Warlock_Cleanup, function Trig_Warlock_Cleanup_Actions)
endfunction

//===========================================================================
// Trigger: Victory Setup
//===========================================================================
function Trig_Victory_Setup_Func016002002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Victory_Setup_Func019001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Victory_Setup_Func022001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Victory_Setup_Func025001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Victory_Setup_Func031002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Victory_Setup_Func032002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Victory_Setup_Func036A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Victory_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    //  
    // Weather
    //  
    call SetSkyModel("Environment\\Sky\\AshenvaleSky\\AshenvaleSky.mdl")
    call SetTerrainFogExBJ(0, 200.00, 2000.00, 0.00, 5.00, 0.00, 35.00)
    call SetTimeOfDay(0.00)
    call UseTimeOfDayBJ(false)
    //  
    // General Unit Prep
    //  
    call PauseAllUnitsBJ(true)
    //  
    // Hide Units
    //  
    set udg_Group_HiddenUnits=GetUnitsOfPlayerMatching(Player(0), Condition(function Trig_Victory_Setup_Func016002002))
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_ShadowCouncil, Condition(function Trig_Victory_Setup_Func019001002)), udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_StormWeaver, Condition(function Trig_Victory_Setup_Func022001002)), udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_TwilightHammer, Condition(function Trig_Victory_Setup_Func025001002)), udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), udg_Group_HiddenUnits)
    //  
    //  
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Victory_Setup_Func031002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Victory_Setup_Func032002)
    //  
    call RemoveUnit(udg_Boss_ChoGall)
    //  
    call ForGroupBJ(udg_Boss_Phase2_U_Tentacles, function Trig_Victory_Setup_Func036A)
    //  
    call RemoveUnit(udg_Boss_Utok)
    call RemoveUnit(udg_Boss_Zuluhed)
    //  
    call ShowUnitHide(udg_Hero_Zuluhed)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    call ShowUnitHide(udg_Hero_Rend)
    call PauseUnitBJ(true, udg_Hero_Rend)
    call ShowUnitHide(udg_Hero_Maim)
    call PauseUnitBJ(true, udg_Hero_Maim)
    //  
    // Remove Buffs
    //  
    //  
    // Create Fake Hero
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_Victory_Ghogall_A), 230.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeChogall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeChogall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeChogall, true)
    call ReplaceUnitBJ(udg_FakeChogall, 'O005', bj_UNIT_STATE_METHOD_RELATIVE)
    set udg_FakeChogall=GetLastReplacedUnitBJ()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeChogall)
    call SetUnitBlendTimeBJ(udg_FakeChogall, 0.50)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Victory_Zuluhed_A), 60.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeZuluhed, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeZuluhed, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeZuluhed, true)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_Victory_Rend_A), 40.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeRend, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeRend, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeRend, true)
    call BlzSetUnitSkin(udg_FakeRend, 'ORFc')
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeRend)
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.50)
    //  
    call CreateNUnitsAtLoc(1, 'n00D', udg_Player_Actual, GetRectCenter(gg_rct_Victory_Rend_Wolf), 20.00)
    set udg_RendWolfCinematic=GetLastCreatedUnit()
    call BlzSetUnitWeaponBooleanFieldBJ(udg_RendWolfCinematic, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_RendWolfCinematic, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_RendWolfCinematic, true)
    call ShowUnitHide(udg_RendWolfCinematic)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_Victory_Maim_A), 50.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeMaim, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeMaim, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeMaim, true)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_Victory_Utok_A), 65.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeUtok, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeUtok, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeUtok, true)
    //  
    // Disable Abilities
    //  
    call SetPlayerAbilityAvailableBJ(false, 'Ashm', udg_Player_Actual)
    //  
endfunction

//===========================================================================
function InitTrig_Victory_Setup takes nothing returns nothing
    set gg_trg_Victory_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Victory_Setup, function Trig_Victory_Setup_Actions)
endfunction

