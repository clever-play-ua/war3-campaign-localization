//===========================================================================
// Trigger: Setup Cinematic Frame
//
// Note: this must be called in each cinematic because it gets reset back when loading from a save
//===========================================================================
function Trig_Setup_Cinematic_Frame_Actions takes nothing returns nothing
    // Hide portrait during cinematic
    call BlzFrameSetVisible(BlzGetFrameByName("HDCinematicPortraitCover", 0), false)
    // Remove the background by moving it (hiding does not work)
    call BlzFrameClearAllPoints(BlzGetFrameByName("HDCinematicBackground", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.0)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_TOPRIGHT, 0.0, 0.0)
    // Set the cinematic dialogue text rectangle to the bottom center portion of the screen
    call BlzFrameClearAllPoints(BlzGetFrameByName("CinematicDialogueText", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.035)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.075)
    // Set the cinematic speaker text rectangle to the bottom center portion of the screen (above dialogue text)
    call BlzFrameClearAllPoints(BlzGetFrameByName("CinematicSpeakerText", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.085)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.95)
    // Set both cinematic speaker and cinematic dialogue text alignment to center
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicDialogueText", 0), TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicSpeakerText", 0), TEXT_JUSTIFY_BOTTOM, TEXT_JUSTIFY_CENTER)
endfunction

//===========================================================================
function InitTrig_Setup_Cinematic_Frame takes nothing returns nothing
    set gg_trg_Setup_Cinematic_Frame=CreateTrigger()
    call TriggerAddAction(gg_trg_Setup_Cinematic_Frame, function Trig_Setup_Cinematic_Frame_Actions)
endfunction

//===========================================================================
// Trigger: Intro Setup
//===========================================================================
function Trig_Intro_Setup_Func027002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Intro_Setup_Func037002 takes nothing returns nothing
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Intro_Setup_Func042002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Intro_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    //  
    // Weather
    //  
    call SetSkyModel("Environment\\Sky\\VillageFallSky\\VillageFallSky.mdl")
    call SetTerrainFogExBJ(0, 4000.00, 5000.00, 0, 0.00, 50.00, 0.00)
    //  
    // General Unit Prep
    //  
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_Intro_Rend_Start), 310.00)
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_Intro_Utok_Start), 90.00)
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_Intro_Maim_Start), 300.00)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Intro_Zuluhed_Start), 260.00)
    //  
    //  
    // Pause Units
    //  
    call PauseAllUnitsBJ(true)
    call PauseUnitBJ(false, udg_FakeRend)
    call PauseUnitBJ(false, udg_FakeMaim)
    call PauseUnitBJ(false, udg_FakeUtok)
    call PauseUnitBJ(false, udg_FakeZuluhed)
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_PASSIVE)), function Trig_Intro_Setup_Func027002)
    //  
    // Hide Units
    //  
    set udg_Group_HiddenUnits=GetUnitsOfPlayerAll(udg_Player_Actual)
    call GroupRemoveUnitSimple(gg_unit_o60R_0086, udg_Group_HiddenUnits)
    call GroupRemoveUnitSimple(gg_unit_o60S_0144, udg_Group_HiddenUnits)
    call GroupRemoveUnitSimple(gg_unit_o60R_0085, udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_Starting_Units), function Trig_Intro_Setup_Func037002)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), udg_Group_HiddenUnits)
    //  
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Intro_Setup_Func042002)
    //  
    // Disable Abilities
    //  
    call SetPlayerAbilityAvailableBJ(false, 'Ashm', udg_Player_Actual)
endfunction

//===========================================================================
function InitTrig_Intro_Setup takes nothing returns nothing
    set gg_trg_Intro_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Setup, function Trig_Intro_Setup_Actions)
endfunction

