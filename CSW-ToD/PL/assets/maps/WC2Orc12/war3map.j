    return (GetUnitUserData((ConstructEvent__eventConstruct))) // INLINED!!
endfunction

function GetStructureBuilder takes unit whichUnit returns unit
    return ConstructEvent__builders[(GetUnitUserData((whichUnit)))] // INLINED!!
endfunction

