//===========================================================================
// Trigger: Boss Phase 1 Initiated
//===========================================================================
function Trig_Boss_Phase_1_Initiated_Conditions takes nothing returns boolean
    if ( not ( udg_Boss_Phase1 == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttacker()) == 'O001' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_1_Initiated_Actions takes nothing returns nothing
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Boss_Utok)
    call SetUnitAnimation(udg_Boss_Utok, "cinematic writing one")
    // --------------------------------------------------------------------------------------------------------------------
    call UnitShareVisionBJ(true, udg_Hero_Maim, udg_Player_TwilightHammer)
    call UnitShareVisionBJ(true, udg_Hero_Rend, udg_Player_TwilightHammer)
    // --------------------------------------------------------------------------------------------------------------------
    call IssuePointOrderLocBJ(gg_unit_n002_0233, "attack", GetRectCenter(gg_rct_Boss_Phase_1_Center))
    call IssuePointOrderLocBJ(gg_unit_h62K_0229, "attack", GetRectCenter(gg_rct_Boss_Phase_1_Center))
    call IssuePointOrderLocBJ(gg_unit_h62K_0231, "attack", GetRectCenter(gg_rct_Boss_Phase_1_Center))
    call EnableTrigger(gg_trg_Boss_Phase_1_Rune)
    call EnableTrigger(gg_trg_Boss_Phase_1_Warstomp)
    call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Monsoon)
endfunction

//===========================================================================
function InitTrig_Boss_Phase_1_Initiated takes nothing returns nothing
    set gg_trg_Boss_Phase_1_Initiated=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Boss_Phase_1_Initiated, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_Boss_Phase_1_Initiated, Condition(function Trig_Boss_Phase_1_Initiated_Conditions))
    call TriggerAddAction(gg_trg_Boss_Phase_1_Initiated, function Trig_Boss_Phase_1_Initiated_Actions)
endfunction

//===========================================================================
// Trigger: Boss Phase 1 Warstomp
//===========================================================================
function Trig_Boss_Phase_1_Warstomp_Conditions takes nothing returns boolean
    if ( not ( udg_Boss_Phase1 == true ) ) then
        return false
    endif
    if ( not ( GetAttacker() == udg_Boss_ChoGall ) ) then
        return false
    endif
    if ( not ( R2I(BlzGetUnitAbilityCooldownRemaining(udg_Boss_ChoGall, 'ACB1')) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_1_Warstomp_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_VOChogallBossfight01Q)
    //  
    call BlzStartUnitAbilityCooldown(udg_Boss_ChoGall, 'ACB1', 15.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_ChoGall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call IssueImmediateOrderBJ(udg_Boss_ChoGall, "stop")
    call BlzUnitInterruptAttack(udg_Boss_ChoGall)
    call SetUnitTimeScalePercent(udg_Boss_ChoGall, 15.00)
    call SetUnitAnimation(udg_Boss_ChoGall, "attack slam")
    //  
    set udg_Boss_Phase1_TP_Warstomp=GetUnitLoc(udg_Boss_ChoGall)
    call AddSpecialEffectLocBJ(udg_Boss_Phase1_TP_Warstomp, "CSW\\Doodads\\Cinematic\\ToS\\BossArea.mdx")
    set udg_Boss_Phase1_Effect_Warstomp=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale(udg_Boss_Phase1_Effect_Warstomp, 4.00)
    call BlzSetSpecialEffectColor(udg_Boss_Phase1_Effect_Warstomp, 255, 100, 0)
    call BlzSetSpecialEffectTimeScale(udg_Boss_Phase1_Effect_Warstomp, 0.50)
    call PolledWait(1.00)
    call CreateNUnitsAtLoc(1, 'u005', udg_Player_TwilightHammer, udg_Boss_Phase1_TP_Warstomp, bj_UNIT_FACING)
    set udg_Boss_Phase1_U_Warstomp=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_Boss_Phase1_U_Warstomp)
    call UnitAddAbilityBJ('ACB2', udg_Boss_Phase1_U_Warstomp)
    call SetUnitAbilityLevelSwapped('ACB2', GetTriggerUnit(), 1)
    call IssueImmediateOrderBJ(udg_Boss_Phase1_U_Warstomp, "stomp")
    //  
    call PolledWait(1.20)
    call SetUnitTimeScalePercent(udg_Boss_ChoGall, 75.00)
    call AddSpecialEffectLocBJ(udg_Boss_Phase1_TP_Warstomp, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
    set udg_Boss_Phase1_Effect_Warstomp2=GetLastCreatedEffectBJ()
    call DestroyEffectBJ(udg_Boss_Phase1_Effect_Warstomp2)
    //  
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_ChoGall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
    call DestroyEffectBJ(udg_Boss_Phase1_Effect_Warstomp)
    call RemoveLocation(udg_Boss_Phase1_TP_Warstomp)
endfunction

//===========================================================================
function InitTrig_Boss_Phase_1_Warstomp takes nothing returns nothing
    set gg_trg_Boss_Phase_1_Warstomp=CreateTrigger()
    call DisableTrigger(gg_trg_Boss_Phase_1_Warstomp)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Boss_Phase_1_Warstomp, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_Boss_Phase_1_Warstomp, Condition(function Trig_Boss_Phase_1_Warstomp_Conditions))
    call TriggerAddAction(gg_trg_Boss_Phase_1_Warstomp, function Trig_Boss_Phase_1_Warstomp_Actions)
endfunction

