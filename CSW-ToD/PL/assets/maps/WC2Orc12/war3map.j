    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func074001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func085001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

