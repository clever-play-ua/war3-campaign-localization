    call TriggerAddAction(gg_trg_Quest_Locate_Guldan_Create, function Trig_Quest_Locate_Guldan_Create_Actions)
endfunction

//===========================================================================
// Trigger: Quest Locate Guldan Discover
//===========================================================================
function Trig_Quest_Locate_Guldan_Discover_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Ensure that the quest exists
    call ConditionalTriggerExecute(gg_trg_Quest_Locate_Guldan_Create)
    // Update the quest
    call QuestSetDiscoveredBJ(udg_MQLocateGuldan, true)
    // Display a quest message.
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3564")
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P7_Start)
    call ConditionalTriggerExecute(gg_trg_AI_P8_Start)
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P5_Start)
endfunction

