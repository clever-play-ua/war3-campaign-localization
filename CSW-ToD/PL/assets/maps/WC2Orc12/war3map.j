    set gg_trg_Turtle_Boss_Summon=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Turtle_Boss_Summon, 1.00)
    call TriggerAddCondition(gg_trg_Turtle_Boss_Summon, Condition(function Trig_Turtle_Boss_Summon_Conditions))
    call TriggerAddAction(gg_trg_Turtle_Boss_Summon, function Trig_Turtle_Boss_Summon_Actions)
