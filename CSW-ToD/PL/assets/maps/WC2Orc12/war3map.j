function Trig_CreateFakeActors_Actions takes nothing returns nothing
    // //
    call CreateNUnitsAtLoc(1, 'OWGC', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeGuldan, bj_UNIT_FACING)
    set udg_FakeGuldan=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeGuldan)
    call SetUnitBlendTimeBJ(udg_FakeGuldan, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeGuldan)
    // //
    call CreateNUnitsAtLoc(1, 'OCHC', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeChogall, bj_UNIT_FACING)
    set udg_FakeChogall=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeChogall)
    call SetUnitBlendTimeBJ(udg_FakeChogall, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeChogall)
    // //
    call CreateNUnitsAtLoc(1, 'OZaC', udg_Player_Zuluhed, udg_Point_SpawnFakeZuluhed, bj_UNIT_FACING)
    set udg_FakeZuluhed=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeZuluhed)
    // //
    call CreateNUnitsAtLoc(1, 'OMBc', udg_Player_BTGCinematic, udg_Point_SpawnFakeMaim, bj_UNIT_FACING)
    set udg_FakeMaim=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMaim)
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeMaim)
    // //
    call CreateNUnitsAtLoc(1, 'ORbC', udg_Player_BTGCinematic, udg_Point_SpawnFakeRend, bj_UNIT_FACING)
    set udg_FakeRend=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeRend)
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeRend)
    // //
    call CreateNUnitsAtLoc(1, 'o605', udg_Player_Utok, udg_Point_SpawnFakeUtok, bj_UNIT_FACING)
    set udg_FakeUtok=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.50)
    // //
    // //
    // //
    // //
    // //
endfunction

