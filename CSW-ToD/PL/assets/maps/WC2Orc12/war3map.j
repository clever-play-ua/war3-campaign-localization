function Trig_Ritual_Setup_Actions takes nothing returns nothing
    set udg_RitualTempleCount=3
    set udg_RitualWarlocksCount=3
    //  
    call SetUnitInvulnerable(gg_unit_nsrh_0072, true)
    call SetUnitInvulnerable(gg_unit_nw2w_0318, true)
    call SetUnitInvulnerable(gg_unit_nsra_0091, true)
    //  
    call SetUnitAnimation(gg_unit_nsrh_0072, "stand channel")
    call SetUnitAnimation(gg_unit_nsra_0091, "stand channel")
    call SetUnitAnimation(gg_unit_nw2w_0318, "stand channel")
    //  
    call BlzSetUnitMaxHP(gg_unit_nsrh_0072, 1000)
    call BlzSetUnitMaxHP(gg_unit_nsra_0091, 1000)
    call BlzSetUnitMaxHP(gg_unit_nw2w_0318, 1000)
    //  
    call BlzSetUnitMaxMana(gg_unit_nsrh_0072, 0)
    call BlzSetUnitMaxMana(gg_unit_nsra_0091, 0)
    call BlzSetUnitMaxMana(gg_unit_nw2w_0318, 0)
    //  
    call SetUnitLifeBJ(gg_unit_nsrh_0072, 1000.00)
    call SetUnitLifeBJ(gg_unit_nsra_0091, 1000.00)
    call SetUnitLifeBJ(gg_unit_nw2w_0318, 1000.00)
    //  
    call BlzSetUnitWeaponBooleanFieldBJ(gg_unit_nsrh_0072, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(gg_unit_nsra_0091, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(gg_unit_nw2w_0318, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
endfunction

