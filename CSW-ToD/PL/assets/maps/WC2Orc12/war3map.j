    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_AI_P7_Defeated_Func008001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P7_Defeated_Func008001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P7_Defeated_Func008A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerSRDefeatCondition)
endfunction

function Trig_AI_P7_Defeated_Func011001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o610' )
endfunction

function Trig_AI_P7_Defeated_Func011001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P7_Defeated_Func011001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o610'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P7_Defeated_Func011A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerSRDefeatCondition)
endfunction

function Trig_AI_P7_Defeated_Func013C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_PlayerSRDefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P7_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_PlayerSRDefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_StormWeaver, Condition(function Trig_AI_P7_Defeated_Func005001002)), function Trig_AI_P7_Defeated_Func005A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_StormWeaver, Condition(function Trig_AI_P7_Defeated_Func008001002)), function Trig_AI_P7_Defeated_Func008A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_StormWeaver, Condition(function Trig_AI_P7_Defeated_Func011001002)), function Trig_AI_P7_Defeated_Func011A)
    // //
    if ( Trig_AI_P7_Defeated_Func013C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_RefillTheGoldmine)
        call DisableTrigger(gg_trg_AI_P7_Gold)
        call DisableTrigger(gg_trg_AI_P7_Lumber)
        call ConditionalTriggerExecute(gg_trg_AI_P7_Command_Stop_Attack_User)
        call ConditionalTriggerExecute(gg_trg_AI_P7_Command_Defeat)
    else
    endif
    // //
    call GroupClear(udg_Group_PlayerSRDefeatCondition)
    // //
endfunction

