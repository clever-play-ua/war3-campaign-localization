function Trig_Hermit_2_Cleanup_Func038C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQLocateGuldan) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hermit_2_Cleanup_Actions takes nothing returns nothing
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call StopSoundBJ(gg_snd_ACT_IV_CinematicTheme2, true)
    // Restore Abilities
    call SetPlayerAbilityAvailableBJ(true, 'Ashm', udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // Unhide Units
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Hermit_2_Cleanup_Func008002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Hermit_2_Cleanup_Func009002)
    call GroupClear(udg_Group_HiddenUnits)
    // Position Units
    call SetUnitPositionLocFacingBJ(udg_Unit_Drakthul, GetRectCenter(gg_rct_Hermit2_Drakthul01), bj_UNIT_FACING)
    // Unpause Units
    // Pause Time Of Day
    call UseTimeOfDayBJ(true)
    // Re-enable XP Gain
    // Return Heroes
    // Cleanup Items
    call RemoveItem(udg_Item_SkeletalArtifact)
    call UnitAddItemByIdSwapped('ciri', udg_Hero_Zuluhed)
    // Restore Selection
    // Reset Sky
    call SetSkyModel(null)
    // Reset Fog
    call ResetTerrainFogBJ()
    // Reset Camera
    call CameraResetSmoothingFactorBJ()
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, udg_Point_CameraReturn, 0)
    call SetItemVisibleBJ(false, gg_item_IQL0_0340)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // Run Drakthul Goes Home
    call TriggerSleepAction(3.00)
    call SetUnitPathing(udg_Unit_Drakthul, false)
    call IssuePointOrderLocBJ(udg_Unit_Drakthul, "move", GetRectCenter(gg_rct_Hermit2_Drakthul02))
    call QueuedTriggerRemoveBJ(gg_trg_Hermit_Cinematic_2_Q)
    if ( Trig_Hermit_2_Cleanup_Func038C() ) then
        call QueuedTriggerAddBJ(gg_trg_Quest_Locate_Guldan_CompletedQ, true)
    else
    endif
endfunction

