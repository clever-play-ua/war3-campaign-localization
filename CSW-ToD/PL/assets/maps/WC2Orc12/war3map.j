    if ( not ( udg_RitualChance == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ritual_Chance_Actions takes nothing returns nothing
    set udg_RitualChance=GetRandomInt(1, 3)
    if ( Trig_Ritual_Chance_Func004C() ) then
        set udg_Point_CagedGruntSpawnTemp=GetDestructableLoc(GetDyingDestructable())
        call CreateNUnitsAtLoc(1, 'o60G', udg_Player_Actual, udg_Point_CagedGruntSpawnTemp, bj_UNIT_FACING)
        call RemoveLocation(udg_Point_CagedGruntSpawnTemp)
    else
    endif
endfunction

