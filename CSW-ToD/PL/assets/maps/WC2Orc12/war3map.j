    endif
    //  
    call SetUnitFacingToFaceUnitTimed(udg_FakeRend, gg_unit_o9ZW_0002, 0.25)
    call PlaySoundAtPointBJ(gg_snd_Loading, 80.00, GetRectCenter(gg_rct_Intro_Peon_01A), 0)
    //  
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Intro_Peon_01A), bj_UNIT_FACING)
    set udg_Unit_IntroPeon02=GetLastCreatedUnit()
    call GroupAddUnitSimple(udg_Unit_IntroPeon02, udg_Group_IntroDummyUnits)
    call IssuePointOrderLocBJ(udg_Unit_IntroPeon02, "move", GetRectCenter(gg_rct_Intro_Peon_01B))
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
