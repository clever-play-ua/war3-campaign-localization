function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    //  
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, GetPlayersAll())
    //  
    call SetTerrainFogExBJ(0, 500.00, 3500.00, 0, 73.00, 37.00, 4.00)
    call SetTimeOfDay(12)
    call UseTimeOfDayBJ(false)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_1_a, udg_Player_Actual, 0)
    //  
    call ConditionalTriggerExecute(gg_trg_Intro_Setup)
    call TriggerSleepAction(0.50)
    //  
    // Sounds and Music
    //  
    call PlaySoundBJ(gg_snd_ACT_IV_IntroTheme)
    call PlaySoundBJ(gg_snd_ShipExteriorLoop)
    call SetSoundVolumeBJ(gg_snd_ShipExteriorLoop, 50.00)
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    set udg_Bool_CinIntroOn=true
    set udg_Bool_InCinematic=true
    call EnableTrigger(gg_trg_Intro_Skipped)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro_1_b, udg_Player_Actual, 18.00, 3.00, 3.00, 2.00)
    call TriggerSleepAction(14.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Islands
    //  
    call SetTerrainFogExBJ(0, 400.00, 2500.00, 0, 57.00, 55.00, 40.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_2_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_2_b, udg_Player_Actual, 12.00)
    call TriggerSleepAction(9.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PolledWait(1.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    //  
    // Ships Reveal
    //  
    call SetSoundVolumeBJ(gg_snd_ShipExteriorLoop, 75.00)
    call SetTerrainFogExBJ(0, 500.00, 6000.00, 0, 92.00, 45.00, 13.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_3_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_3_b, udg_Player_Actual, 9.00)
    //  
    call PauseUnitBJ(false, gg_unit_o60R_0227)
    call PauseUnitBJ(false, gg_unit_o9ZW_0218)
    call PauseUnitBJ(false, gg_unit_o60R_0226)
    call PauseUnitBJ(false, gg_unit_o9ZW_0219)
    call PauseUnitBJ(false, gg_unit_o60S_0143)
    //  
    call IssuePointOrderLocBJ(gg_unit_o60R_0227, "move", GetRectCenter(gg_rct_Intro_3_Ships_N))
    call IssuePointOrderLocBJ(gg_unit_o9ZW_0218, "move", GetRectCenter(gg_rct_Intro_3_Ships_N))
    call IssuePointOrderLocBJ(gg_unit_o60R_0226, "move", GetRectCenter(gg_rct_Intro_3_Ships_S))
    call IssuePointOrderLocBJ(gg_unit_o9ZW_0219, "move", GetRectCenter(gg_rct_Intro_3_Ships_S))
    call IssuePointOrderLocBJ(gg_unit_o60S_0143, "move", GetRectCenter(gg_rct_Intro_3_Ships_S))
    //  
    call SetUnitMoveSpeed(gg_unit_o60R_0227, 100.00)
    call SetUnitMoveSpeed(gg_unit_o9ZW_0218, 100.00)
    call SetUnitMoveSpeed(gg_unit_o60R_0226, 100.00)
    call SetUnitMoveSpeed(gg_unit_o9ZW_0219, 100.00)
    call SetUnitMoveSpeed(gg_unit_o60S_0143, 100.00)
    //  
    call SetUnitPathing(gg_unit_o60R_0227, false)
    call SetUnitPathing(gg_unit_o9ZW_0218, false)
    call SetUnitPathing(gg_unit_o60R_0226, false)
    call SetUnitPathing(gg_unit_o9ZW_0219, false)
    call SetUnitPathing(gg_unit_o60S_0143, false)
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Ships Statue
    //  
    call CameraSetFocalDistance(135.00)
    call SetTerrainFogExBJ(0, 800.00, 4000.00, 0, 74.00, 44.00, 18.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_4_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_4_b, udg_Player_Actual, 8.00)
    //  
    call PauseUnitBJ(false, gg_unit_o60S_0104)
    call PauseUnitBJ(false, gg_unit_o60R_0142)
    //  
    call SetUnitMoveSpeed(gg_unit_o60S_0104, 100.00)
    call SetUnitTurnSpeedBJ(gg_unit_o60S_0104, 0.05)
    call SetUnitMoveSpeed(gg_unit_o60R_0142, 100.00)
    //  
    call IssueTargetOrderBJ(gg_unit_o60S_0104, "move", gg_unit_nmg1_0039)
    call IssueTargetOrderBJ(gg_unit_o60R_0142, "move", gg_unit_nmg1_0039)
    //  
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Ships Shore
    //  
    call CameraSetFocalDistance(160.00)
    call ShowUnitHide(udg_FakeZuluhed)
    call ShowUnitHide(udg_FakeRend)
    call ShowUnitHide(udg_FakeMaim)
    call ShowUnitHide(udg_FakeUtok)
    call ShowUnitHide(gg_unit_u000_0177)
    call ShowUnitHide(gg_unit_o60G_0053)
    call ShowUnitHide(gg_unit_n001_0266)
    //  
    call SetTerrainFogExBJ(0, 1750.00, 4000.00, 0, 66.00, 50.00, 21.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_5_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_5_b, udg_Player_Actual, 8.00)
    call PauseUnitBJ(true, gg_unit_o9ZW_0001)
    call IssuePointOrderLocBJ(gg_unit_o9ZW_0001, "move", GetRectCenter(gg_rct_Intro_Boat_1))
    call SetUnitMoveSpeed(gg_unit_o9ZW_0001, 100.00)
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call PolledWait(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call RemoveUnit(gg_unit_o60R_0227)
    call RemoveUnit(gg_unit_o9ZW_0218)
    call RemoveUnit(gg_unit_o60R_0226)
    call RemoveUnit(gg_unit_o9ZW_0219)
    call RemoveUnit(gg_unit_o60S_0143)
    //  
    call RemoveUnit(gg_unit_o60S_0104)
    call RemoveUnit(gg_unit_o60R_0142)
    // ------------------------------------------------------------------------------------------------------------
    // Landing Scenes
    // ------------------------------------------------------------------------------------------------------------
    // Utok 1
    //  
    call PlaySoundBJ(gg_snd_WaterWavesLoop101)
    call StopSoundBJ(gg_snd_ShipExteriorLoop, true)
    call CameraSetFocalDistance(140.00)
    call ShowUnitShow(udg_FakeZuluhed)
    call ShowUnitShow(udg_FakeRend)
    call ShowUnitShow(udg_FakeMaim)
    call ShowUnitShow(udg_FakeUtok)
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call SetTerrainFogExBJ(0, 1000.00, 4500.00, 0, 92.00, 46.00, 21.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Utok_1_a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Utok_1_b, udg_Player_Actual, 15.00)
    //  
    call ShowUnitHide(gg_unit_o9ZW_0001)
    call ShowUnitHide(gg_unit_o60S_0144)
    //  
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.50)
    call SetUnitAnimation(udg_FakeUtok, "cinematic writing one")
    //  
    call SetUnitScalePercent(gg_unit_o9ZW_0002, 200.00, 200.00, 200.00)
    call SetUnitScalePercent(gg_unit_o60R_0086, 200.00, 200.00, 200.00)
    call SetUnitScalePercent(gg_unit_o60R_0085, 200.00, 200.00, 200.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetSoundVolumeBJ(gg_snd_ACT_IV_IntroTheme, 33.00)
    //  
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc12Utok1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Utok1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Maim 1
    //  
    call CameraSetFocalDistance(110.00)
    call SetTerrainFogExBJ(0, 1000.00, 2500.00, 0, 96.00, 74.00, 17.00)
    call ShowUnitHide(gg_unit_o60G_0053)
    call ShowUnitHide(gg_unit_n001_0266)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Maim_1_a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Maim_1_b, udg_Player_Actual, 20.00)
    //  
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeMaim, 0, gg_snd_WC2Orc12Maim1, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetUnitFacingTimed(udg_FakeMaim, 330.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc12Maim1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Rend 1
    //  
    call StopSoundBJ(gg_snd_WaterWavesLoop101, true)
    call CameraSetFocalDistance(140.00)
    call SetTerrainFogExBJ(0, 1000.00, 5000.00, 0, 68.00, 37.00, 21.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc12Rend1, bj_TIMETYPE_ADD, 0, false)
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Rend_2_a, udg_Player_Actual, 0.00)
    //  
    call SetUnitFacingTimed(udg_FakeRend, 0.00, 0)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetUnitFacingTimed(udg_FakeRend, 310.00, 1.00)
    call TriggerSleepAction(5.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetUnitLookAt(udg_FakeZuluhed, "bone_head", udg_FakeRend, - 45.00, 0, 90.00)
    call SetTerrainFogExBJ(0, 1000.00, 4500.00, 0, 96.00, 52.00, 17.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Rend_3_a, udg_Player_Actual, 0.00)
    //  
    call SetUnitFacingTimed(udg_FakeRend, 0.00, 0)
    call SetUnitLookAt(udg_FakeRend, "bone_head", udg_FakeZuluhed, - 90.00, 0, 45.00)
    call SetUnitFacingTimed(udg_FakeZuluhed, 220.00, 0.50)
    call TriggerSleepAction(2.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Zuluhed 1
    //  
    call SetTerrainFogExBJ(0, 1000.00, 4500.00, 0, 100.00, 69.00, 39.00)
    // They are very old no doubt, and seem to be marked by very powerful magic… Perhaps this was once the beating heart of elven civilization on this world, much like Goria was to the ogres back on Draenor. As for the foul taint in the air I sense... something an
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed1, bj_TIMETYPE_ADD, 0, false)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Zuluhed_1_a, udg_Player_Actual, 0.00)
    //  
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.50)
    call ResetUnitLookAt(udg_FakeZuluhed)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetUnitFacingTimed(udg_FakeZuluhed, 270.00, 1.00)
    call TriggerSleepAction(10.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CameraSetFocalDistance(120.00)
    call SetTerrainFogExBJ(0, 1000.00, 4000.00, 0, 100.00, 69.00, 39.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Zuluhed_2_a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Zuluhed_2_b, udg_Player_Actual, 12.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "stand channel")
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call AddSpecialEffectTargetUnitBJ("hand, right", udg_FakeZuluhed, "Abilities/Weapons/FarseerMissile/FarseerMissile.mdl")
    set udg_SE_ZuluhedCastIntro=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetSoundVolumeBJ(gg_snd_ManaFlareLoop, 30.00)
    call SetStackedSoundBJ(true, gg_snd_ManaFlareLoop, gg_rct_Intro_Zuluhed_Start)
    call PlaySoundAtPointBJ(gg_snd_PurgeTarget1, 30.00, GetRectCenter(gg_rct_Intro_Zuluhed_Start), 20.00)
    call WaitForSoundBJ(gg_snd_WC2Orc12Zuluhed1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call DestroyEffectBJ(udg_SE_ZuluhedCastIntro)
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call PlaySoundAtPointBJ(gg_snd_PurgeTarget1, 30.00, GetRectCenter(gg_rct_Intro_Zuluhed_Start), 20.00)
    call SetStackedSoundBJ(false, gg_snd_ManaFlareLoop, gg_rct_Intro_Zuluhed_Start)
    //  
    // Rend 2
    //  
    call CameraSetFocalDistance(135.00)
    call SetTerrainFogExBJ(0, 600.00, 3000.00, 0, 100.00, 69.00, 39.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Rend_4_a, udg_Player_Actual, 0.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc12Rend2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Rend2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Zuluhed 2
    //  
    call CameraSetFocalDistance(150.00)
    call SetTerrainFogExBJ(0, 1000.00, 4000.00, 0, 100.00, 69.00, 39.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Rend_5_a, udg_Player_Actual, 0.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    // My vision is clouded, just as these islands are shrouded in fog. But the stench of fel is unmistakable.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Zuluhed2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    //  
    // Rend 3
    //  
    call PlaySoundBJ(gg_snd_WaterWavesLoop101)
    call CameraSetFocalDistance(150.00)
    call SetTerrainFogExBJ(0, 750.00, 2500.00, 0, 84.00, 60.00, 26.00)
    call ResetUnitLookAt(udg_FakeRend)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Rend_1_a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Rend_1_b, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc12Utok2) + GetSoundDurationBJ(gg_snd_WC2Orc12Rend2) ))
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc12Rend3, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Rend3, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Utok 2
    //  
    call PlaySoundBJ(gg_snd_WalkArmorLoop)
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_Intro_Utok_A), 70.00)
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_Intro_Utok_B))
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc12Utok2, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call StopSoundBJ(gg_snd_WalkArmorLoop, true)
    //  
    call SetUnitFacingTimed(udg_FakeMaim, 15.00, 1.00)
    call SetUnitLookAt(udg_FakeRend, "bone_head", udg_FakeUtok, - 90.00, 0, 45.00)
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc12Utok2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    //  
    // Zuluhed 3
    //  
    call StopSoundBJ(gg_snd_WaterWavesLoop101, true)
    call CameraSetFocalDistance(150.00)
    call SetTerrainFogExBJ(0, 1000.00, 4000.00, 0, 100.00, 69.00, 39.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Zuluhed_2_a, udg_Player_Actual, 0.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    // We can count on such forces as well, Utok. Gul'dan has made many enemies, and he can't outrun them any longer.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed3, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Zuluhed3, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Rend 4
    //  
    call PlaySoundBJ(gg_snd_WaterWavesLoop101)
    call CameraSetFocalDistance(0.00)
    call SetTerrainFogExBJ(0, 1000.00, 3000.00, 0, 84.00, 60.00, 26.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc12Rend4, bj_TIMETYPE_ADD, 0, false)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Rend_Command_a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Rend_Command_b, udg_Player_Actual, 15.00)
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_Intro_Utok_C), 120.00)
    //  
