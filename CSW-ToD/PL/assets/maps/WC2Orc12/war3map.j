    //  
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Intro_Peon_01A), bj_UNIT_FACING)
    set udg_Unit_IntroPeon01=GetLastCreatedUnit()
    call GroupAddUnitSimple(udg_Unit_IntroPeon01, udg_Group_IntroDummyUnits)
    call IssuePointOrderLocBJ(udg_Unit_IntroPeon01, "move", GetRectCenter(gg_rct_Intro_Peon_01B))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
