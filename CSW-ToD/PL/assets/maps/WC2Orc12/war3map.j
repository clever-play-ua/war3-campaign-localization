    set gg_trg_MissionFailedBlackhandBratsKilled=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MissionFailedBlackhandBratsKilled, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_MissionFailedBlackhandBratsKilled, Condition(function Trig_MissionFailedBlackhandBratsKilled_Conditions))
