// Trigger: Boss Victory
//===========================================================================
function Trig_Boss_Victory_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Boss_ChoGall ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Victory_Func008C takes nothing returns boolean
    if ( not ( udg_Boss_Phase1 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Victory_Func009C takes nothing returns boolean
    if ( not ( udg_Boss_Phase2 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Victory_Func010C takes nothing returns boolean
    if ( not ( udg_Boss_Phase3 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Victory_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ReviveHeroLoc(udg_Boss_ChoGall, GetUnitLoc(udg_Boss_ChoGall), false)
    call SetUnitOwner(udg_Boss_ChoGall, Player(PLAYER_NEUTRAL_PASSIVE), false)
    call UnitAddAbilityBJ('Avul', udg_Boss_ChoGall)
    call UnitAddAbility(udg_Boss_ChoGall, 'Aloc')
    call SetUnitAnimation(udg_Boss_ChoGall, "death")
    call SetUnitTimeScalePercent(udg_Boss_ChoGall, 5.00)
    if ( Trig_Boss_Victory_Func008C() ) then
        call ReviveHeroLoc(udg_Boss_ChoGall, GetUnitLoc(udg_Boss_ChoGall), true)
    else
    endif
    if ( Trig_Boss_Victory_Func009C() ) then
        call ReviveHeroLoc(udg_Boss_ChoGall, GetUnitLoc(udg_Boss_ChoGall), true)
    else
    endif
    if ( Trig_Boss_Victory_Func010C() ) then
        set udg_Boss_Phase3=false
        // Quest update
        call QueuedTriggerAddBJ(gg_trg_Quest_Kill_Chogall_Completed, true)
        call DestroyEffectBJ(udg_Boss_Phase3_Effect_Twilight2)
        call DestroyEffectBJ(udg_Boss_Phase3_Effect_Twilight)
    else
    endif
endfunction

