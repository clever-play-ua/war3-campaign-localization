    if ( ( IsUnitType(GetAttacker(), UNIT_TYPE_FLYING) == true ) ) then
        return true
    endif
    if ( ( IsUnitType(GetAttacker(), UNIT_TYPE_ANCIENT) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_AI_P04_Attacker_Being_Attacked_Func002Func002A takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(GetEnumUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)
endfunction

function Trig_AI_P04_Attacker_Being_Attacked_Func002Func003A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, 410)
endfunction

function Trig_AI_P04_Attacker_Being_Attacked_Func002Func005A takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(GetEnumUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
endfunction

