//===========================================================================
// Trigger: Boss Phase 2 Chogall Teleport
//===========================================================================
function Trig_Boss_Phase_2_Chogall_Teleport_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Boss_ChoGall), "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidTeleportTo.mdx")
    set udg_Boss_Effect_Teleport_Portal=GetLastCreatedEffectBJ()
    call DestroyEffectBJ(udg_Boss_Effect_Teleport_Portal)
    call PolledWait(2.00)
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_Boss_ChoGall), "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidTeleportTarget.mdx")
    set udg_Boss_Effect_Teleport=GetLastCreatedEffectBJ()
    call DestroyEffectBJ(udg_Boss_Effect_Teleport)
    call SetUnitPositionLocFacingBJ(udg_Boss_ChoGall, GetRectCenter(gg_rct_Boss_Phase_2_Center), 165.00)
    call ReplaceUnitBJ(udg_Boss_ChoGall, 'O006', bj_UNIT_STATE_METHOD_ABSOLUTE)
    set udg_Boss_ChoGall=GetLastReplacedUnitBJ()
    call LockGuardPosition(udg_Boss_ChoGall)
    call DestroyMinimapIcon(udg_MinimapIcon_BossFightChogall)
    call CampaignMinimapIconUnitBJ(udg_Boss_ChoGall, bj_CAMPPINGSTYLE_BOSS)
    set udg_MinimapIcon_BossFightChogall=GetLastCreatedMinimapIcon()
    //  
    call ConditionalTriggerExecute(gg_trg_Boss_Phase_2)
endfunction

//===========================================================================
function InitTrig_Boss_Phase_2_Chogall_Teleport takes nothing returns nothing
    set gg_trg_Boss_Phase_2_Chogall_Teleport=CreateTrigger()
    call TriggerAddAction(gg_trg_Boss_Phase_2_Chogall_Teleport, function Trig_Boss_Phase_2_Chogall_Teleport_Actions)
endfunction

//===========================================================================
// Trigger: Boss Phase 2
//===========================================================================
function Trig_Boss_Phase_2_Func038Func002Func002C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_2_Func038Func002C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_2_Func038C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_2_Actions takes nothing returns nothing
    set udg_Boss_Phase2=true
    // --------------------------------------------------------------------------------------------------------------------
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_Boss_Phase_2_Center), 2.00)
    //  
    // First Gate
    //  
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_DIG2_1826)
    call KillDestructable(gg_dest_DMAG_7423)
    call PolledWait(1.00)
    //  
    // Move Shamans
    //  
    call UnitRemoveAbilityBJ('ACB4', udg_Boss_Utok)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Boss_Utok)
    call IssuePointOrderLocBJ(udg_Boss_Utok, "move", GetRectCenter(gg_rct_Boss_Utok_P2))
    call IssuePointOrderLocBJ(udg_Boss_Zuluhed, "move", GetRectCenter(gg_rct_Boss_Zuluhed_P2))
    //  
    // Teleport Heroes
    //  
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_Boss_Rend_Phase_2), GetRectCenter(gg_rct_Boss_Phase_2_Center))
    call AddSpecialEffectTargetUnitBJ("origin", udg_Hero_Rend, "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidTeleportTarget.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //  
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Maim, GetRectCenter(gg_rct_Boss_Maim_Phase_2), GetRectCenter(gg_rct_Boss_Phase_2_Center))
    call AddSpecialEffectTargetUnitBJ("origin", udg_Hero_Maim, "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidTeleportTarget.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call TriggerSleepAction(1.00)
    //  
    // Cho'gall Setup
    //  
    // Choigall should not move
    //  
    call PauseUnitBJ(false, udg_Boss_ChoGall)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_ChoGall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_ChoGall, UNIT_WEAPON_BF_ATTACK_SHOW_UI, 0, true)
    call SetUnitInvulnerable(udg_Boss_ChoGall, false)
    //  
    if ( Trig_Boss_Phase_2_Func038C() ) then
        call BlzSetUnitArmor(udg_Boss_ChoGall, 5.00)
    else
        if ( Trig_Boss_Phase_2_Func038Func002C() ) then
            call BlzSetUnitArmor(udg_Boss_ChoGall, 10.00)
        else
            if ( Trig_Boss_Phase_2_Func038Func002Func002C() ) then
                call BlzSetUnitArmor(udg_Boss_ChoGall, 15.00)
            else
            endif
        endif
    endif
    //  
    call BlzSetUnitMaxHP(udg_Boss_ChoGall, 10000)
    call SetUnitLifePercentBJ(udg_Boss_ChoGall, 65.00)
    //  
    call SetUnitTimeScalePercent(udg_Boss_ChoGall, 75.00)
    call IssueImmediateOrderBJ(udg_Boss_ChoGall, "holdposition")
    //  
    call UnitAddAbilityBJ('ACB9', udg_Boss_ChoGall)
    // --------------------------------------------------------------------------------------------------------------------
    call EnableTrigger(gg_trg_Boss_Phase_3_Check_HP)
    call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres)
    call SetSoundVolumeBJ(gg_snd_ACT_IV_BossThemePhase1, 35.00)
    call QueuedTriggerAddBJ(gg_trg_VOHerousBossfight01Q, true)
    call TriggerSleepAction(0.50)
    call PauseUnitBJ(false, udg_Boss_ChoGall)
endfunction

