//===========================================================================
// Trigger: Initialization
//===========================================================================
function Trig_Initialization_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Oil_String_Setup)
    call SetAllyColorFilterState(0)
    call EnableMinimapFilterButtons(false, false)
    call SetMaxCheckpointSaves(10)
    set udg_String_CheckpointChapter="WC2Orc12"
    //  
    set udg_Point_SpawnFakeChogall=GetRectCenter(gg_rct_SpawnFakeChogall)
    set udg_Point_SpawnFakeGuldan=GetRectCenter(gg_rct_SpawnFakeGuldan)
    set udg_Point_SpawnFakeMaim=GetRectCenter(gg_rct_SpawnFakeMaim)
    set udg_Point_SpawnFakeRend=GetRectCenter(gg_rct_SpawnFakeRend)
    set udg_Point_SpawnFakeUtok=GetRectCenter(gg_rct_SpawnFakeUtok)
    set udg_Point_SpawnFakeZuluhed=GetRectCenter(gg_rct_SpawnFakeZuluhed)
    //  
    call ConditionalTriggerExecute(gg_trg_InitPlayers)
    call ConditionalTriggerExecute(gg_trg_InitAudio)
    call ConditionalTriggerExecute(gg_trg_InitEnvironment)
    //  
    call ConditionalTriggerExecute(gg_trg_FacialAnimationLoad)
    call ConditionalTriggerExecute(gg_trg_Turtle_Setup)
    call ConditionalTriggerExecute(gg_trg_Ritual_Setup)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Q)
    //  
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
endfunction

//===========================================================================
function InitTrig_Initialization takes nothing returns nothing
    set gg_trg_Initialization=CreateTrigger()
    call TriggerAddAction(gg_trg_Initialization, function Trig_Initialization_Actions)
endfunction

//===========================================================================
// Trigger: InitPlayers
//===========================================================================
function Trig_InitPlayers_Actions takes nothing returns nothing
    call EnableCreepSleepBJ(false)
    // //
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_2848")
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 40.00)
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o9ZZ', 0, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o9ZZ', 0, udg_Player_StormReaverNaval)
    call SetPlayerTechMaxAllowedSwap('o9ZZ', 0, udg_Player_StormWeaver)
    call SetPlayerTechMaxAllowedSwap('o9ZZ', 0, udg_Player_TwilightHammer)
    call SetPlayerTechMaxAllowedSwap('o9ZZ', 0, udg_Player_TwilightHammerNaval)
    // //
    call SetPlayerUnitAvailableBJ('n601', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oFMa', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oEMa', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oGMa', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oBMa', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oCaM', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oDkM', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oOMa', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oOmM', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('n60L', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60T', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o620', false, udg_Player_Actual)
    // //
    call SetPlayerUnitAvailableBJ('o9Zz', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o9ZX', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o9ZY', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o9Zy', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o9Zx', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o9Zw', false, udg_Player_Actual)
    // //
    set udg_Player_TwilightHammerNaval=Player(4)
    call SetPlayerColorBJ(udg_Player_TwilightHammerNaval, PLAYER_COLOR_PURPLE, true)
    call SetPlayerTechResearchedSwap('R000', 1, udg_Player_TwilightHammerNaval)
    call SetPlayerAbilityAvailableBJ(false, 'A65C', udg_Player_TwilightHammerNaval)
    // //
    set udg_Player_StormReaverNaval=Player(7)
    call SetPlayerColorBJ(udg_Player_StormReaverNaval, PLAYER_COLOR_NAVY, true)
    call SetPlayerTechResearchedSwap('R000', 1, udg_Player_StormReaverNaval)
    call SetPlayerAbilityAvailableBJ(false, 'A65C', udg_Player_StormReaverNaval)
    // //
    set udg_Player_ShadowCouncil=Player(1)
    // //
    // Alliance Settings
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Drakthul, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, Player(PLAYER_NEUTRAL_PASSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Zuluhed, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BTGCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Zuluhed, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Zuluhed, udg_Player_Drakthul, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Utok, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Utok, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Utok, udg_Player_Drakthul, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Drakthul, udg_Player_Utok, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Drakthul, udg_Player_Zuluhed, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_ShadowCouncil, udg_Player_StormWeaver, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_ShadowCouncil, udg_Player_TwilightHammer, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_ShadowCouncil, udg_Player_Drakthul, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_ShadowCouncil, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StormWeaver, udg_Player_ShadowCouncil, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StormWeaver, udg_Player_TwilightHammer, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StormWeaver, udg_Player_Drakthul, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StormWeaver, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StormReaverNaval, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StormWeaver, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammer, udg_Player_ShadowCouncil, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammer, udg_Player_StormWeaver, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammer, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammerNaval, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammer, udg_Player_Drakthul, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammer, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Drakthul, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Drakthul, udg_Player_ShadowCouncil, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Drakthul, udg_Player_StormWeaver, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Drakthul, udg_Player_TwilightHammer, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Drakthul, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_ShadowCouncil, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_StormWeaver, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_StormReaverNaval, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_TwilightHammer, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_TwilightHammerNaval, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Drakthul, bj_ALLIANCE_NEUTRAL)
    call SetPlayerColorBJ(udg_Player_Drakthul, PLAYER_COLOR_NAVY, true)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_TwilightHammerDummy, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammerDummy, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    // Initial Resources
    // //
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 20000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 20000)
    call playerAddOil(Player(0) , 1000)
    // //
    call SetPlayerStateBJ(udg_Player_ShadowCouncil, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(udg_Player_ShadowCouncil, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call SetPlayerTechResearchedSwap('R001', 3, udg_Player_ShadowCouncil)
    call SetPlayerStateBJ(udg_Player_StormWeaver, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    // //
    // //
    // Player Colors
    // //
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_COAL, true)
    call SetPlayerColorBJ(udg_Player_StormWeaver, PLAYER_COLOR_NAVY, true)
    call SetPlayerColorBJ(udg_Player_ShadowCouncil, PLAYER_COLOR_NAVY, true)
    call SetPlayerColorBJ(udg_Player_TwilightHammerDummy, PLAYER_COLOR_PURPLE, true)
    // //
    // Hide Excess Players
    // //
    call SetPlayerOnScoreScreenBJ(false, udg_Player_Drakthul)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_TwilightHammerDummy)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_BTGCinematic)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_Zuluhed)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_Utok)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicDummy)
    // //
    // Set Default Upgrades
    // //
    // TwilightHammer
    // //
    // //
    // StormReavers
    // //
    call SetPlayerUnitAvailableBJ('n001', false, udg_Player_StormWeaver)
    // //
    call ConditionalTriggerExecute(gg_trg_LoadCache)
    // //
    call ConditionalTriggerExecute(gg_trg_InitUnits)
    // //
    call ConditionalTriggerExecute(gg_trg_Easy)
    call ConditionalTriggerExecute(gg_trg_Normal)
    call ConditionalTriggerExecute(gg_trg_Hard)
    // //
endfunction

//===========================================================================
