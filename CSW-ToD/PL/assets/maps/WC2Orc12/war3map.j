    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerTHDefeatCondition)
endfunction

function Trig_AI_P4_Defeated_Func016C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_PlayerTHDefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P4_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_PlayerTHDefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_TwilightHammer, Condition(function Trig_AI_P4_Defeated_Func008001002)), function Trig_AI_P4_Defeated_Func008A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_TwilightHammer, Condition(function Trig_AI_P4_Defeated_Func011001002)), function Trig_AI_P4_Defeated_Func011A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_TwilightHammer, Condition(function Trig_AI_P4_Defeated_Func014001002)), function Trig_AI_P4_Defeated_Func014A)
    // //
    if ( Trig_AI_P4_Defeated_Func016C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_AI_P4_Gold)
        call DisableTrigger(gg_trg_AI_P4_Lumber)
        call ConditionalTriggerExecute(gg_trg_AI_P4_Command_Stop_Attack_User)
        call ConditionalTriggerExecute(gg_trg_AI_P4_Command_Defeat)
    else
    endif
    // //
    call GroupClear(udg_Group_PlayerTHDefeatCondition)
    // //
endfunction

