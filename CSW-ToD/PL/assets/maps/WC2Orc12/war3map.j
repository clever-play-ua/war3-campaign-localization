    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func102001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func107001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func116001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func120001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Func123001 takes nothing returns boolean
    return ( udg_Bool_CinHermitSkipped == true )
endfunction

function Trig_Hermit_Cinematic_1_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_InCinematic=true
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call PlaySoundBJ(gg_snd_ACT_IV_CinematicTheme1)
    call SetSoundVolumeBJ(gg_snd_ACT_IV_CinematicTheme1, 50.00)
    // Remove Exclamation Point above Quest Giver
    call DestroyEffectBJ(udg_SE_ExclamationPoint)
    // Set Up Scene
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Hermit_1_Setup)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Zuluhed_1, udg_Player_Actual, 0)
    call SetTerrainFogExBJ(0, 1500.00, 6000.00, 0, 90.00, 60.00, 7.00)
    call CameraSetFocalDistance(150.00)
    call TriggerSleepAction(1.00)
    // Fade In
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call EnableTrigger(gg_trg_Hermit_1_Skipped)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    //  
    // Zuluhed 4
    //  
    call SetUnitLookAt(udg_FakeZuluhed, "bone_head", udg_Unit_Drakthul, - 45.00, 0, 70.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Drak'thul 1
    //  
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Drakthul_1, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_Drakthul, 0, gg_snd_WC2Orc12Drakthul1, bj_TIMETYPE_ADD, 0, false)
    call SetUnitFacingTimed(udg_Unit_Drakthul, 310.00, 0.50)
    call WaitForSoundBJ(gg_snd_WC2Orc12Drakthul1, 0)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Maim 2
    //  
    call CameraSetFocalDistance(175.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Rend_1, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeMaim, 0, gg_snd_WC2Orc12Maim2, bj_TIMETYPE_ADD, 0, false)
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "stand ready")
    call WaitForSoundBJ(gg_snd_WC2Orc12Maim2, 0)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Rend 5
    //  
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc12Rend5, bj_TIMETYPE_ADD, 0, false)
    call SetUnitFacingTimed(udg_FakeRend, 150.00, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeRend, 0.00, 0, 90.00)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitBlendTimeBJ(udg_FakeMaim, 1.00)
    call SetUnitAnimation(udg_FakeMaim, "stand")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_FakeRend, 120.00, 0.50)
    call ResetUnitLookAt(udg_FakeMaim)
    call WaitForSoundBJ(gg_snd_WC2Orc12Rend5, 0)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Zuluhed 5
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Zuluhed_2, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed5, bj_TIMETYPE_ADD, 0, false)
    //  
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic frustrated one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc12Zuluhed5, 0)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Drak'thul 2
    //  
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Drakthul_1, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_Drakthul, 0, gg_snd_WC2Orc12Drakthul2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Zuluhed 6
    //  
    call CameraSetFocalDistance(175.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Zuluhed_2, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed6, bj_TIMETYPE_ADD, 0, false)
    //  
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc12Zuluhed6, 0)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Drak'thul 3
    //  
    call SetTerrainFogExBJ(0, 300.00, 2500.00, 0, 71.00, 39.00, 17.00)
    call CameraSetFocalDistance(100.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Drakthul_1, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_Drakthul, 0, gg_snd_WC2Orc12Drakthul3, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(11.00)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Drakthul_2, udg_Player_Actual, 0)
    call SetUnitFacingTimed(udg_Unit_Drakthul, 0.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc12Drakthul3, 4.00)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_Unit_Drakthul, 265.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc12Drakthul3, 0.00)
    if ( (udg_Bool_CinHermitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC ENDS - Cinematic Can No Longer Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call DisableTrigger(gg_trg_Hermit_1_Skipped)
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // Cleanup
    call ConditionalTriggerExecute(gg_trg_Hermit_1_Cleanup)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // Fade In
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // Quest update
    call ConditionalTriggerExecute(gg_trg_Quest_Find_Artifact_Discover)
    set udg_Bool_SideQuestDiscovered=true
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    set udg_Bool_InCinematic=false
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Hermit_Cinematic_1_Q takes nothing returns nothing
    set gg_trg_Hermit_Cinematic_1_Q=CreateTrigger()
    call DisableTrigger(gg_trg_Hermit_Cinematic_1_Q)
    call TriggerAddCondition(gg_trg_Hermit_Cinematic_1_Q, Condition(function Trig_Hermit_Cinematic_1_Q_Conditions))
    call TriggerAddAction(gg_trg_Hermit_Cinematic_1_Q, function Trig_Hermit_Cinematic_1_Q_Actions)
