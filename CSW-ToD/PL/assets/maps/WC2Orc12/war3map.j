function InitTrig_P07DeindexPassengers takes nothing returns nothing
    set gg_trg_P07DeindexPassengers=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_P07DeindexPassengers, "udg_DeathEvent", EQUAL, 1.00)
    call TriggerRegisterVariableEvent(gg_trg_P07DeindexPassengers, "udg_UnitIndexEvent", EQUAL, 2.00)
    call TriggerAddCondition(gg_trg_P07DeindexPassengers, Condition(function Trig_P07DeindexPassengers_Conditions))
