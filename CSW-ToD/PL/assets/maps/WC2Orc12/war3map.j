    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MAX_MANA, 7500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MANA, 7500)
    set udg_OilPatchUnit=gg_unit_n60P_0154
    call s__OilPatch_setOilAmount(udg_OilPatchUnit , 12500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MAX_MANA, 12500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MANA, 12500)
    set udg_OilPatchUnit=gg_unit_u002_0255
    call s__OilPatch_setOilAmount(udg_OilPatchUnit , 13500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MAX_MANA, 13500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MANA, 13500)
    set udg_OilPatchUnit=gg_unit_u002_0230
    call s__OilPatch_setOilAmount(udg_OilPatchUnit , 12500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MAX_MANA, 12500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MANA, 12500)
