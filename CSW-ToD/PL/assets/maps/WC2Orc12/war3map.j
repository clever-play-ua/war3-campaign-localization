function CreateAllDestructables takes nothing returns nothing
    local destructable d
    local trigger t
    local real life
    set gg_dest_B003_1464=BlzCreateDestructableZWithSkin('B003', 2822.7, - 1020.6, 768.7, 129.000, 2.000, 0, 'B003')
    set gg_dest_B004_1463=BlzCreateDestructableZWithSkin('B004', 4608.9, 584.7, 838.8, 305.000, 2.000, 0, 'B004')
    set gg_dest_B005_1469=BlzCreateDestructableZWithSkin('B005', 3647.6, - 328.6, 627.7, 140.000, 1.500, 0, 'B005')
    set gg_dest_B006_1465=BlzCreateDestructableZWithSkin('B006', 4489.4, - 1211.0, 788.2, 111.000, 1.500, 0, 'B006')
    set gg_dest_B00E_8581=BlzCreateDestructableZWithSkin('B00E', - 2976.0, 352.0, 506.9, 0.000, 0.800, 0, 'B00E')
    set t=CreateTrigger()
    call TriggerRegisterDeathEvent(t, gg_dest_B00E_8581)
    call TriggerAddAction(t, function SaveDyingWidget)
    call TriggerAddAction(t, function Doodad008581_DropItems)
