//===========================================================================
// Trigger: Boss Phase 1
//===========================================================================
function Trig_Boss_Phase_1_Actions takes nothing returns nothing
    call SelectGroupBJ(udg_Boss_Heroes)
    set udg_Boss_Phase1=true
    call PlaySoundBJ(gg_snd_ACT_IV_BossThemePhase1)
    call SetSoundVolumeBJ(gg_snd_ACT_IV_BossThemePhase1, 50.00)
    // --------------------------------------------------------------------------------------------------------------------
    call ShowUnitShow(gg_unit_h62K_0229)
    call ShowUnitShow(gg_unit_o621_0141)
    call ShowUnitShow(gg_unit_o621_0133)
    call ShowUnitShow(gg_unit_h62K_0231)
    call ShowUnitShow(gg_unit_n002_0233)
    //  
    call PauseUnitBJ(false, gg_unit_h62K_0229)
    call PauseUnitBJ(false, gg_unit_o621_0141)
    call PauseUnitBJ(false, gg_unit_o621_0133)
    call PauseUnitBJ(false, gg_unit_h62K_0231)
    call PauseUnitBJ(false, gg_unit_n002_0233)
    //  
    call UnitAddAbilityBJ('ACB1', udg_Boss_ChoGall)
    //  
    call ConditionalTriggerExecute(gg_trg_BossfightCheckpoint)
    //  
    call EnableTrigger(gg_trg_Boss_Phase_1_Check_HP)
    call EnableTrigger(gg_trg_Boss_Phase_2_Check_HP)
endfunction

