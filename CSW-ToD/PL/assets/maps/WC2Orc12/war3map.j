//===========================================================================
// Trigger: P07BoardingOrder
//===========================================================================
function Trig_P07BoardingOrder_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07BoardingOrder_Func004Func004C takes nothing returns boolean
    if ( not ( udg_BoardingOrderTimerCount[7] >= udg_BoardingOrderTimerInterval[7] ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07BoardingOrder_Func004Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[7]) <= 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[7]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07BoardingOrder_Func004Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[7]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[7]) <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07BoardingOrder_Func004C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_IdleMarines[7]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_IdleTransports[7]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07BoardingOrder_Actions takes nothing returns nothing
    // //
    // //
    if ( Trig_P07BoardingOrder_Func004C() ) then
        set udg_BoardingOrderTimerCount[7]=( udg_BoardingOrderTimerCount[7] + udg_BoardingOrderTimerPeriod[7] )
        if ( Trig_P07BoardingOrder_Func004Func004C() ) then
            set udg_BoardingOrderTimerCount[7]=0.00
            call BoardingFunc(7)
        else
        endif
        if ( Trig_P07BoardingOrder_Func004Func005C() ) then
            call GroupClear(udg_QueuedMarines[7])
        else
        endif
        if ( Trig_P07BoardingOrder_Func004Func006C() ) then
            call GroupClear(udg_QueuedTransports[7])
        else
        endif
    else
        set udg_BoardingOrderTimerCount[7]=0.00
    endif
    // //
    // //
endfunction

//===========================================================================
function InitTrig_P07BoardingOrder takes nothing returns nothing
    set gg_trg_P07BoardingOrder=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_P07BoardingOrder, udg_BoardingOrderTimer[7])
    call TriggerAddCondition(gg_trg_P07BoardingOrder, Condition(function Trig_P07BoardingOrder_Conditions))
    call TriggerAddAction(gg_trg_P07BoardingOrder, function Trig_P07BoardingOrder_Actions)
endfunction

