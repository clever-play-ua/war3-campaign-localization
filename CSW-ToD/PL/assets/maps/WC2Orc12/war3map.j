    if ( not ( GetOwningPlayer(GetAttacker()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not Trig_AI_P04_Attacker_Being_Attacked_Func005C() ) then
        return false
    endif
    return true
endfunction

