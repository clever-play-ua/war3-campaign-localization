    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE)), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Warlock_Setup_Func017A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_Warlock_Setup_Func023001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o9ZW' )
endfunction

function Trig_Warlock_Setup_Func023001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Warlock_Setup_Func023001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o9ZW'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Warlock_Setup_Func023A takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRectCenter(gg_rct_BFUnloadTransports))
    call IssuePointOrderLocBJ(GetEnumUnit(), "unloadall", GetRectCenter(gg_rct_BFUnloadTransports))
endfunction

function Trig_Warlock_Setup_Func039002002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Warlock_Setup_Func042001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Warlock_Setup_Func045001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Warlock_Setup_Func048001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Warlock_Setup_Func053002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Warlock_Setup_Func054002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Warlock_Setup_Func059002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Warlock_Setup_Func063A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Warlock_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    //  
    // Set Camera Bounds
    //  
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_Camera_Bounds_Extended)
    set udg_Point_CameraReturn=GetCameraTargetPositionLoc()
    //  
    // Weather
    //  
    call SetSkyModel("Environment\\Sky\\VillageFallSky\\VillageFallSky.mdl")
    call SetTerrainFogExBJ(0, 1500.00, 3000.00, 0, 84.00, 60.00, 26.00)
    //  
    //  
    // Kill Creeps
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Fog_Turtle, Condition(function Trig_Warlock_Setup_Func017001002)), function Trig_Warlock_Setup_Func017A)
    //  
    // Unload Player Transports
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Warlock_Setup_Func023001002)), function Trig_Warlock_Setup_Func023A)
    //  
    call TriggerSleepAction(0.25)
    //  
    // Pause Time Of Day
    //  
    call UseTimeOfDayBJ(false)
    //  
    // Pause Units
    //  
    call PauseUnitBJ(false, udg_Unit_TombGuard01)
    call PauseUnitBJ(false, udg_Unit_TombGuard02)
    //  
    // Hide Units
    //  
    //  
    set udg_Group_HiddenUnits=GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Warlock_Setup_Func039002002))
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_ShadowCouncil, Condition(function Trig_Warlock_Setup_Func042001002)), udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_StormWeaver, Condition(function Trig_Warlock_Setup_Func045001002)), udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_TwilightHammer, Condition(function Trig_Warlock_Setup_Func048001002)), udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), udg_Group_HiddenUnits)
    //  
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Warlock_Setup_Func053002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Warlock_Setup_Func054002)
    //  
    //  
    // Remove Twilight Hammer army
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Fog_Twillight, udg_Player_TwilightHammer), function Trig_Warlock_Setup_Func059002)
    //  
    // Show Units
    //  
    call ForGroupBJ(udg_Group_GuldanClans, function Trig_Warlock_Setup_Func063A)
    //  
    // Create Fake Heroes
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeGuldan, GetRectCenter(gg_rct_GuldanStart), 40.00)
    call SetUnitOwner(udg_FakeGuldan, udg_Player_ShadowCouncil, true)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeGuldan, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeGuldan, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeGuldan, true)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_ChoGall_Start), 351.42)
    call SetUnitOwner(udg_FakeChogall, udg_Player_TwilightHammer, true)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeChogall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeChogall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeChogall, true)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_ToS_Zuluhed_A), 70.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeZuluhed, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeZuluhed, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeZuluhed, true)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_ToS_Rend_A), 50.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeRend, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeRend, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeRend, true)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_FakeRend)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_ToS_Maim_A), 60.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeMaim, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeMaim, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeMaim, true)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_FakeMaim)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_ToS_Utok_A), 65.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeUtok, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeUtok, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeUtok, true)
    //  
    call CreateNUnitsAtLoc(1, 'n00F', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_CinematicDaemon), 160.00)
    set udg_Unit_CinematicDaemon=GetLastCreatedUnit()
    //  
    // Remove Buffs
    //  
    //  
    // Disable Abilities
    //  
    call SetPlayerAbilityAvailableBJ(false, 'Ashm', udg_Player_Actual)
    //  
    // Music Theme
    //  
    call EnableDawnDusk(false)
    call SetCineModeVolumeGroupsBJ()
endfunction

