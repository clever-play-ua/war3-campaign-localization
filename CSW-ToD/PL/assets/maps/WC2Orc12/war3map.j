//===========================================================================
// Trigger: Turtle Boss Summon
//===========================================================================
function Trig_Turtle_Boss_Summon_Conditions takes nothing returns boolean
    if ( not ( udg_TurtleEggCount == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Turtle_Boss_Summon_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    //  
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_Turtle_Boss), 1.00)
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 1.00)
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Turtle_Boss), 256.00)
    set udg_VisMod_TurtleMamaShown=GetLastCreatedFogModifier()
    call FogModifierStart(udg_VisMod_TurtleMamaShown)
    call TriggerSleepAction(1.00)
    call PlaySoundAtPointBJ(gg_snd_StoneBridgeRise, 100, GetRectCenter(gg_rct_Turtle_Boss), 0)
    call PlaySoundBJ(gg_snd_StoneBridgeRise)
    call TriggerSleepAction(1.00)
    //  
    call CreateNUnitsAtLoc(1, 'n004', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_Turtle_Boss), bj_UNIT_FACING)
    set udg_Turtle_Boss=GetLastCreatedUnit()
    call SetUnitColor(udg_Turtle_Boss, PLAYER_COLOR_TURQUOISE)
    call SetUnitPathing(udg_Turtle_Boss, false)
    call SetUnitPositionLocFacingBJ(udg_Turtle_Boss, GetRectCenter(gg_rct_Turtle_Boss), 320.00)
    call IssuePointOrderLocBJ(udg_Turtle_Boss, "move", GetRectCenter(gg_rct_Turtle_Move))
    //  
    call TriggerSleepAction(1.00)
    call PlaySoundBJ(gg_snd_NetherDragonYesAttack3)
    call StopSoundBJ(gg_snd_NetherDragonYesAttack3, true)
    call StopSoundBJ(gg_snd_StoneBridgeRise, true)
    call SetUnitOwner(udg_Turtle_Boss, Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    call SetUnitColor(udg_Turtle_Boss, PLAYER_COLOR_TURQUOISE)
    call SetUnitPathing(udg_Turtle_Boss, true)
    call CameraClearNoiseForPlayer(Player(0))
    call DestroyFogModifier(udg_VisMod_TurtleMamaShown)
endfunction

