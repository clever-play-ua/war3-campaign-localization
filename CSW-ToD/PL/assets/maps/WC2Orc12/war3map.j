endfunction

function Trig_Boss_Phase_2_Void_Fall_N_Actions takes nothing returns nothing
    set udg_Boss_Phase2_Chance_Heroes=GetRandomInt(1, 2)
    if ( Trig_Boss_Phase_2_Void_Fall_N_Func002C() ) then
        set udg_Boss_Phase2_TP_N=GetUnitLoc(udg_Hero_Rend)
    else
        set udg_Boss_Phase2_TP_N=GetUnitLoc(udg_Hero_Maim)
    endif
    call QueueUnitAnimationBJ(udg_Boss_Phase2_U_Ogre_N, "spell")
    call QueueUnitAnimationBJ(udg_Boss_Phase2_U_Ogre_N, "spell")
    call QueueUnitAnimationBJ(udg_Boss_Phase2_U_Ogre_N, "spell")
    call QueueUnitAnimationBJ(udg_Boss_Phase2_U_Ogre_N, "spell")
    call QueueUnitAnimationBJ(udg_Boss_Phase2_U_Ogre_N, "spell")
    call AddSpecialEffectLocBJ(udg_Boss_Phase2_TP_N, "CSW\\Doodads\\Cinematic\\ToS\\BossArea.mdx")
    set udg_Boss_Phase2_Effect_N1=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale(udg_Boss_Phase2_Effect_N1, 2.00)
    call BlzSetSpecialEffectColor(udg_Boss_Phase2_Effect_N1, 150, 50, 255)
    call PolledWait(1.50)
    call AddSpecialEffectLocBJ(udg_Boss_Phase2_TP_N, "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidBoltFall.mdx")
    call DestroyEffectBJ(udg_Boss_Phase2_Effect_N2)
    call PolledWait(0.60)
    call DestroyEffectBJ(udg_Boss_Phase2_Effect_N1)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(100.00, udg_Boss_Phase2_TP_N, Condition(function Trig_Boss_Phase_2_Void_Fall_N_Func018001003)), function Trig_Boss_Phase_2_Void_Fall_N_Func018A)
    call RemoveLocation(udg_Boss_Phase2_TP_N)
