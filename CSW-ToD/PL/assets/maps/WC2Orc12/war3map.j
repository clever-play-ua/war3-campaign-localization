function Trig_Boss_Phase_2_Ogres_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(15.00)
    set udg_Boss_Phase2_Chance_Ogres=GetRandomInt(1, 3)
    if ( Trig_Boss_Phase_2_Ogres_Func004C() ) then
        call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres_N)
        call PolledWait(15.00)
        if ( Trig_Boss_Phase_2_Ogres_Func004Func004C() ) then
            call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres_E)
            call PolledWait(15.00)
            if ( Trig_Boss_Phase_2_Ogres_Func004Func004Func003C() ) then
                call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres_W)
            else
            endif
        else
        endif
    else
        if ( Trig_Boss_Phase_2_Ogres_Func004Func001C() ) then
            call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres_E)
            call PolledWait(15.00)
            if ( Trig_Boss_Phase_2_Ogres_Func004Func001Func004C() ) then
                call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres_W)
                call PolledWait(15.00)
                if ( Trig_Boss_Phase_2_Ogres_Func004Func001Func004Func003C() ) then
                    call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres_N)
                else
                endif
            else
            endif
        else
            if ( Trig_Boss_Phase_2_Ogres_Func004Func001Func001C() ) then
                call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres_W)
                call PolledWait(15.00)
                if ( Trig_Boss_Phase_2_Ogres_Func004Func001Func001Func003C() ) then
                    call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres_N)
                    call PolledWait(15.00)
                    if ( Trig_Boss_Phase_2_Ogres_Func004Func001Func001Func003Func003C() ) then
                        call ConditionalTriggerExecute(gg_trg_Boss_Phase_2_Ogres_E)
                    else
                    endif
                else
                endif
            else
            endif
        endif
    endif
endfunction

