        call ShowUnitHide(udg_Boss_Phase2_U_Ogre_E)
    else
    endif
    if ( Trig_Boss_Phase_2_Ogres_Check_Func003C() ) then
        call CreateItemLoc('rman', GetUnitLoc(GetDyingUnit()))
        set udg_Boss_Phase2_W=false
        call DisableTrigger(gg_trg_Boss_Phase_2_Void_Fall_W)
        //  
