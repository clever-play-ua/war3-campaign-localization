//===========================================================================
// Trigger: AI P7 Start
//===========================================================================
function Trig_AI_P7_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call AdjustPlayerStateBJ(30000, udg_Player_StormWeaver, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(30000, udg_Player_StormWeaver, PLAYER_STATE_RESOURCE_LUMBER)
    call AdjustPlayerStateBJ(60, udg_Player_StormWeaver, PLAYER_STATE_RESOURCE_FOOD_CAP)
    // //
    call EnableTrigger(gg_trg_AI_P7_Gold)
    call EnableTrigger(gg_trg_AI_P7_Lumber)
    // //
    call RemoveGuardPosition(gg_unit_nsrh_0159)
    call RemoveGuardPosition(gg_unit_nsrh_0300)
    call RemoveGuardPosition(gg_unit_nfel_0289)
    call RemoveGuardPosition(gg_unit_nfel_0293)
    call RemoveGuardPosition(gg_unit_nsrw_0047)
    call RemoveGuardPosition(gg_unit_o606_0251)
    call RemoveGuardPosition(gg_unit_o606_0250)
    call RemoveGuardPosition(gg_unit_o606_0273)
    // //
    call ConditionalTriggerExecute(gg_trg_P07TransportationConfig)
    // //
    call StartCampaignAI(udg_Player_StormWeaver, "CSW\\Scripts\\ToDScripts\\WC2Orc12\\WC2Orc12P07GroundAI.ai")
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P7_Command_Start_Attack_User)
    // //
endfunction

//===========================================================================
function InitTrig_AI_P7_Start takes nothing returns nothing
    set gg_trg_AI_P7_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_P7_Start, function Trig_AI_P7_Start_Actions)
endfunction

