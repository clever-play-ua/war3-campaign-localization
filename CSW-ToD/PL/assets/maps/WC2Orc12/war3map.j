    if ( Trig_Boss_Phase_2_Ogres_Check_Func001C() ) then
        call CreateItemLoc('rman', GetUnitLoc(GetDyingUnit()))
        set udg_Boss_Phase2_N=false
        call DisableTrigger(gg_trg_Boss_Phase_2_Void_Fall_N)
        //  
        call AddSpecialEffectLocBJ(GetUnitLoc(udg_Boss_Phase2_U_Ogre_N), "Abilities\\Spells\\Items\\AIso\\AIsoTarget.mdl")
        set udg_Boss_Phase2_Effect_N3=GetLastCreatedEffectBJ()
        call DestroyEffectBJ(udg_Boss_Phase2_Effect_N3)
        call PolledWait(3.25)
        call ShowUnitHide(udg_Boss_Phase2_U_Ogre_N)
    else
    endif
    if ( Trig_Boss_Phase_2_Ogres_Check_Func002C() ) then
        call CreateItemLoc('rman', GetUnitLoc(GetDyingUnit()))
