function Trig_P07PlayerMarineLandingOrder_Func003Func003Func005C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07PlayerMarineLandingOrder_Func003Func003Func010C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07PlayerMarineLandingOrder_Func003Func003A takes nothing returns nothing
    local integer isc
    set isc=s__IndexShipCargo_struct[GetUnitUserData(GetEnumUnit())]
    if IsUnitInRangeXY(GetEnumUnit(), s__IndexShipCargo_xC[isc], s__IndexShipCargo_yC[isc], udg_DepartureDetectionRange) or not IsUnitInGroup(GetEnumUnit(), udg_DestinationDetectionGroup[7]) then
    call IssuePointOrderById(GetEnumUnit(), 851986, udg_AttackOrderPointerX[7], udg_AttackOrderPointerY[7])
    if ( Trig_P07PlayerMarineLandingOrder_Func003Func003Func005C() ) then
        call BJDebugMsg("Moving")
    else
    endif
    elseif IsUnitInGroup(GetEnumUnit(), udg_DestinationDetectionGroup[7]) then
    call IssuePointOrderLocBJ(GetEnumUnit(), "unloadall", udg_MarineLandingPoint[7])
    call UnitDamageTargetBJ(udg_U_TransportDummy, GetEnumUnit(), 1.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
    call SetUnitLifeBJ(GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) + 1.00 ))
    if ( Trig_P07PlayerMarineLandingOrder_Func003Func003Func010C() ) then
        call BJDebugMsg("Wydano rozkaz desantu")
    else
    endif
    endif
endfunction

function Trig_P07PlayerMarineLandingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_DepartedTransports[7]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07PlayerMarineLandingOrder_Actions takes nothing returns nothing
    set udg_LandingWarfareHasRan[7]=true
    if ( Trig_P07PlayerMarineLandingOrder_Func003C() ) then
        call MoveLocation(udg_MarineLandingPoint[7], udg_AttackOrderPointerX[7], udg_AttackOrderPointerY[7])
        call GroupEnumUnitsInRange(udg_DestinationDetectionGroup[7], udg_AttackOrderPointerX[7], udg_AttackOrderPointerY[7], udg_DestinationDetectionRange, null)
        call ForGroupBJ(udg_DepartedTransports[7], function Trig_P07PlayerMarineLandingOrder_Func003Func003A)
        call GroupClear(udg_DestinationDetectionGroup[7])
    else
    endif
    set udg_LandingWarfareHasRan[7]=false
endfunction

