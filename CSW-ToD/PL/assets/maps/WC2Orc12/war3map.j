function Trig_WhirlwindRemovedByWanderLeash_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_UDexUnits[udg_UDex]) == 'nXD0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_WhirlwindRemovedByWanderLeash_Actions takes nothing returns nothing
    local unit w
    local unit dk
    // //
    set w=udg_UDexUnits[udg_UDex]
    set dk=LoadUnitHandle(udg_Hashtable_WhirlwindSpell, GetHandleId(w), 0)
    // //
    if dk != null then
    if IsUnitAliveBJ(dk) then
    call IssueImmediateOrder(dk, "stop")
    endif
    endif
    // //
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, GetHandleId(dk))
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, GetHandleId(w))
    // //
    // //
endfunction

