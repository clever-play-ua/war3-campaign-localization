        call DoNothing()
    endif
    //  
    call SetUnitTimeScalePercent(udg_FakeRend, 50.00)
    call SetUnitAnimation(udg_FakeRend, "spell")
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call PlaySoundAtPointBJ(gg_snd_Loading, 80.00, GetRectCenter(gg_rct_Intro_Peon_01A), 0)
    //  
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Intro_Peon_01A), bj_UNIT_FACING)
    set udg_Unit_IntroPeon03=GetLastCreatedUnit()
    call GroupAddUnitSimple(udg_Unit_IntroPeon03, udg_Group_IntroDummyUnits)
    call IssuePointOrderLocBJ(udg_Unit_IntroPeon03, "move", GetRectCenter(gg_rct_Intro_Peon_01B))
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call QueueUnitAnimationBJ(udg_FakeRend, "spell")
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call PlaySoundAtPointBJ(gg_snd_Loading, 80.00, GetRectCenter(gg_rct_Intro_Peon_01A), 0)
    //  
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Intro_Peon_01A), bj_UNIT_FACING)
    set udg_Unit_IntroPeon04=GetLastCreatedUnit()
    call GroupAddUnitSimple(udg_Unit_IntroPeon04, udg_Group_IntroDummyUnits)
    call IssuePointOrderLocBJ(udg_Unit_IntroPeon04, "move", GetRectCenter(gg_rct_Intro_Peon_01B))
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call QueueUnitAnimationBJ(udg_FakeRend, "spell")
    call QueueUnitAnimationBJ(udg_FakeRend, "stand")
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call PlaySoundAtPointBJ(gg_snd_Loading, 80.00, GetRectCenter(gg_rct_Intro_Peon_01A), 0)
    //  
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Intro_Peon_01A), bj_UNIT_FACING)
    set udg_Unit_IntroPeon05=GetLastCreatedUnit()
    call GroupAddUnitSimple(udg_Unit_IntroPeon05, udg_Group_IntroDummyUnits)
    call IssuePointOrderLocBJ(udg_Unit_IntroPeon05, "move", GetRectCenter(gg_rct_Intro_Peon_01B))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.25, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Base Starting Scene
    //  
    call StopSoundBJ(gg_snd_WaterWavesLoop101, true)
    call ResetUnitAnimation(udg_FakeRend)
    //  
    call SetUnitPositionLoc(udg_FakeZuluhed, GetRectCenter(gg_rct_Intro_Zuluhed_D))
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_Intro_Zuluhed_E))
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Gameplay_Rend_Start))
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_Gameplay_Maim_Start))
    call IssuePointOrderLocBJ(udg_Unit_IntroGrunt, "move", GetRectCenter(gg_rct_Gameplay_Grunt_Start))
    call IssuePointOrderLocBJ(udg_Unit_IntroDeathKnight, "move", GetRectCenter(gg_rct_Gameplay_Shaman_Start))
    //  
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 270.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_Gameplay_TrollVoodo_Start))
    //  
    call IssuePointOrderLocBJ(udg_Unit_IntroOgre, "move", GetRectCenter(gg_rct_Gameplay_WolfRider_Start))
    call SetUnitPositionLoc(udg_Unit_IntroPeon01, GetRectCenter(gg_rct_Intro_Builder_01))
    call SetUnitPositionLoc(udg_Unit_IntroPeon02, GetRectCenter(gg_rct_Intro_Builder_02))
    call SetUnitPositionLoc(udg_Unit_IntroPeon03, GetRectCenter(gg_rct_Intro_Builder_03))
    call SetUnitPositionLoc(udg_Unit_IntroPeon04, GetRectCenter(gg_rct_Intro_Builder_04))
    call SetUnitPositionLoc(udg_Unit_IntroPeon05, GetRectCenter(gg_rct_Intro_Builder_05))
    //  
    call TriggerSleepAction(0.30)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call ShowUnitShow(gg_unit_o60G_0053)
    call ShowUnitShow(gg_unit_n001_0266)
    call ShowUnitShow(gg_unit_u000_0177)
    call ShowUnitShow(gg_unit_o60R_0085)
    call ShowUnitShow(gg_unit_o9ZW_0001)
    call ShowUnitShow(gg_unit_o9ZW_0002)
    call ShowUnitShow(gg_unit_o60S_0144)
    call ShowUnitShow(gg_unit_o60R_0086)
    //  
    call SetUnitScalePercent(gg_unit_o9ZW_0002, 120.00, 120.00, 120.00)
    call SetUnitScalePercent(gg_unit_o60R_0086, 160.00, 160.00, 160.00)
    //  
    call SetSoundVolumeBJ(gg_snd_ACT_IV_IntroTheme, 60.00)
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Base_1_a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro_Base_1_b, udg_Player_Actual, 14.00)
    //  
    call PolledWait(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call IssueBuildOrderByIdLocBJ(udg_Unit_IntroPeon01, 'o610', GetRectCenter(gg_rct_Gameplay_Barracksr_Start))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call IssueBuildOrderByIdLocBJ(udg_Unit_IntroPeon02, 'o614', GetRectCenter(gg_rct_Gameplay_Hall_Start))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call IssueBuildOrderByIdLocBJ(udg_Unit_IntroPeon03, 'o60Z', GetRectCenter(gg_rct_Gameplay_Mill_Start))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call IssueBuildOrderByIdLocBJ(udg_Unit_IntroPeon04, 'o60W', GetRectCenter(gg_rct_Gameplay_Protector_Start))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call IssueBuildOrderByIdLocBJ(udg_Unit_IntroPeon05, 'o60X', GetRectCenter(gg_rct_Gameplay_Farm01_Start))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC ENDS - Cinematic Can No Longer Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call DisableTrigger(gg_trg_Intro_Skipped)
    // Fade Out
    call StopSoundBJ(gg_snd_ACT_IV_IntroTheme, true)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call PolledWait(1.00)
    // Cleanup
    call ConditionalTriggerExecute(gg_trg_Intro_Cleanup)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // Fade In
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call PolledWait(1.00)
    // Start Game
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Q takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Q, function Trig_Intro_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Intro Skipped
//===========================================================================
function Trig_Intro_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    // Cleanup
    call DestroyEffectBJ(udg_SE_ZuluhedCastIntro)
    call ConditionalTriggerExecute(gg_trg_Intro_Cleanup)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // Fade In
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    // Start Game
    set udg_Bool_CinIntroOn=false
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
endfunction

//===========================================================================
function InitTrig_Intro_Skipped takes nothing returns nothing
    set gg_trg_Intro_Skipped=CreateTrigger()
    call DisableTrigger(gg_trg_Intro_Skipped)
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Intro_Skipped, Condition(function Trig_Intro_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Skipped, function Trig_Intro_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cleanup
//===========================================================================
function Trig_Intro_Cleanup_Func036002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Intro_Cleanup_Func095002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Intro_Cleanup_Actions takes nothing returns nothing
    //  
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    set udg_Bool_CinIntroOn=false
    set udg_Bool_InCinematic=false
    call EnableTrigger(gg_trg_Hermit_Cinematic_1_Q)
    call EnableTrigger(gg_trg_Hermit_Cinematic_2_Q)
    call EnableTrigger(gg_trg_Warlock_Cinematic_Q)
    //  
    // Sounds and Music
    //  
    call StopSoundBJ(gg_snd_ACT_IV_IntroTheme, false)
    call StopSoundBJ(gg_snd_WaterWavesLoop101, true)
    call StopSoundBJ(gg_snd_ShipExteriorLoop, true)
    call StopSoundBJ(gg_snd_WalkArmorLoop, true)
    //  
    // Restore Abilities
    //  
    call SetPlayerAbilityAvailableBJ(true, 'Ashm', udg_Player_Actual)
    //  
    // Reset Animation
    //  
    call ResetUnitAnimation(udg_Hero_Rend)
    //  
    // Clear Units
    //  
    call RemoveUnit(gg_unit_o60R_0227)
    call RemoveUnit(gg_unit_o60R_0226)
    call RemoveUnit(gg_unit_o9ZW_0219)
    call RemoveUnit(gg_unit_o9ZW_0218)
    call RemoveUnit(gg_unit_o60S_0143)
    call RemoveUnit(gg_unit_o60S_0104)
    call RemoveUnit(gg_unit_o60R_0142)
    call RemoveUnit(udg_FakeRend)
    //  
    call ForGroupBJ(udg_Group_IntroDummyUnits, function Trig_Intro_Cleanup_Func036002)
    //  
    call DisableTrigger(gg_trg_DummyMill)
    call DisableTrigger(gg_trg_DummyBarracks)
    call DisableTrigger(gg_trg_DummyTower)
    call DisableTrigger(gg_trg_DummyHall)
    //  
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    //  
    // Move Units
    //  
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_Gameplay_Zuluhed_Start), 270.00)
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    //  
    call SetUnitPositionLocFacingBJ(udg_Hero_Rend, GetRectCenter(gg_rct_Gameplay_Rend_Start), 140.00)
    call PauseUnitBJ(false, udg_Hero_Rend)
    call ShowUnitShow(udg_Hero_Rend)
    //  
    call SetUnitPositionLocFacingBJ(udg_Hero_Maim, GetRectCenter(gg_rct_Gameplay_Maim_Start), 140.00)
    call PauseUnitBJ(false, udg_Hero_Maim)
    call ShowUnitShow(udg_Hero_Maim)
    //  
    call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_Gameplay_Shaman_Start), 90.00)
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    call ShowUnitShow(udg_SemiHero_Utok)
    //  
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroGrunt, GetRectCenter(gg_rct_Gameplay_Grunt_Start), 90.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroDeathKnight, GetRectCenter(gg_rct_Gameplay_Troll_Start), 90.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroOgre, GetRectCenter(gg_rct_Gameplay_TrollVoodo_Start), 90.00)
    //  
    // Create Units
    //  
    call CreateNUnitsAtLoc(1, 'o614', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Hall_Start), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Farm02_Start), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Farm03_Start), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'o610', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Barracksr_Start), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'o60Z', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Mill_Start), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'o60W', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Protector_Start), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'o60L', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Blacksmith_Start), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Farm01_Start), bj_UNIT_FACING)
    //  
    // Unhide Units
    //  
    call ShowUnitShow(gg_unit_o60G_0053)
    call ShowUnitShow(gg_unit_n001_0266)
    call ShowUnitShow(gg_unit_u000_0177)
    call ShowUnitShow(gg_unit_o9ZW_0001)
    call ShowUnitShow(gg_unit_o9ZW_0002)
    call ShowUnitShow(gg_unit_o60S_0144)
    call ShowUnitShow(gg_unit_o60R_0086)
    //  
    // Remove Cinematic Stuff from Units
    //  
    call SetUnitScalePercent(gg_unit_o9ZW_0002, 120.00, 120.00, 120.00)
    call SetUnitScalePercent(gg_unit_o60R_0086, 160.00, 160.00, 160.00)
    call SetUnitScalePercent(gg_unit_o60R_0085, 160.00, 160.00, 160.00)
    call SetUnitMoveSpeed(gg_unit_o9ZW_0001, GetUnitDefaultMoveSpeed(gg_unit_o9ZW_0001))
    //  
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Intro_Cleanup_Func095002)
    //  
    // Unpause Units
    //  
    call PauseAllUnitsBJ(false)
    call PauseUnitBJ(true, udg_Unit_BlackrockTraitor)
    //  
    // Unpause Time Of Day
    //  
    call UseTimeOfDayBJ(true)
    //  
    // Re-enable XP Gain
    //  
    call SuspendHeroXPBJ(true, udg_Hero_Zuluhed)
    call SuspendHeroXPBJ(true, udg_Hero_Maim)
    call SuspendHeroXPBJ(true, udg_Hero_Rend)
    //  
    //  
    //  
    // Reset Fog
    //  
    call ResetTerrainFogBJ()
    //  
    //  
    // Reset Camera
    //  
    call CameraResetSmoothingFactorBJ()
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_Intro_Skipped), 0)
    call TriggerSleepAction(0.25)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    //  
    // Initial Harvesting
    //  
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Peon01_Start), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestlumber")
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Peon02_Start), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestlumber")
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Peon03_Start), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestgold")
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Peon04_Start), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestgold")
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Peon05_Start), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestgold")
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Peon06_Start), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestlumber")
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Peon07_Start), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestlumber")
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Peon08_Start), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestgold")
    call CreateNUnitsAtLoc(1, 'o61Y', udg_Player_Actual, GetRectCenter(gg_rct_Gameplay_Peon09_Start), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestgold")
    //  
    // Wipe Visibility
    //  
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_MASKED, GetPlayableMapRect())
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Visibility_Start_1), 512)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Visibility_Start_2), 512)
    call DestroyFogModifier(GetLastCreatedFogModifier())
    call SetItemVisibleBJ(false, gg_item_IQL0_0340)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    //  
    // Adjust Player Resources
    //  
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 2000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 1000)
    //  
    // StartQuests
    //  
    call EnableTrigger(gg_trg_HermitCin1Started)
    call ConditionalTriggerExecute(gg_trg_Quest_Locate_Guldan_Create)
    call TriggerSleepAction(0.25)
    call SelectUnitSingle(udg_Hero_Zuluhed)
    call EnableTrigger(gg_trg_Mission_Failed_BaseDead)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_Quest_Locate_Guldan_Discover)
    //  
    //  
endfunction

