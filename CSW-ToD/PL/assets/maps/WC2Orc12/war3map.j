    call TriggerAddCondition(gg_trg_P04DetectSeaLoading, Condition(function Trig_P04DetectSeaLoading_Conditions))
    call TriggerAddAction(gg_trg_P04DetectSeaLoading, function Trig_P04DetectSeaLoading_Actions)
