//===========================================================================
// Trigger: P04LandingOrderReactToDamage
//===========================================================================
function Trig_P04LandingOrderReactToDamage_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(BlzGetEventDamageTarget()) == 'o9Zw' ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(BlzGetEventDamageTarget(), udg_DepartedTransports[4]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P04LandingOrderReactToDamage_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P04LandingOrderReactToDamage_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    if ( Trig_P04LandingOrderReactToDamage_Func003C() ) then
        call BJDebugMsg("Transportowiec Młota Zmierzchu jest atakowany!")
    else
    endif
    // //
    set udg_MarineLandingPoint[4]=Location(udg_AttackOrderPointerX[4], udg_AttackOrderPointerY[4])
    call IssuePointOrderLocBJ(BlzGetEventDamageTarget(), "unloadall", udg_MarineLandingPoint[4])
    call RemoveLocation(udg_MarineLandingPoint[4])
    // //
    call PolledWait(1.00)
    call EnableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_P04LandingOrderReactToDamage takes nothing returns nothing
    set gg_trg_P04LandingOrderReactToDamage=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_P04LandingOrderReactToDamage, Player(3), EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_P04LandingOrderReactToDamage, Condition(function Trig_P04LandingOrderReactToDamage_Conditions))
    call TriggerAddAction(gg_trg_P04LandingOrderReactToDamage, function Trig_P04LandingOrderReactToDamage_Actions)
endfunction

//===========================================================================
// Trigger: P04BoardingOrder
//===========================================================================
function Trig_P04BoardingOrder_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P04BoardingOrder_Func003Func004C takes nothing returns boolean
    if ( not ( udg_BoardingOrderTimerCount[4] >= udg_BoardingOrderTimerInterval[4] ) ) then
        return false
    endif
    return true
endfunction

function Trig_P04BoardingOrder_Func003Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[4]) <= 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[4]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P04BoardingOrder_Func003Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[4]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[4]) <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P04BoardingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_IdleMarines[4]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_IdleTransports[4]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P04BoardingOrder_Actions takes nothing returns nothing
    // //
    if ( Trig_P04BoardingOrder_Func003C() ) then
        set udg_BoardingOrderTimerCount[4]=( udg_BoardingOrderTimerCount[4] + udg_BoardingOrderTimerPeriod[4] )
        if ( Trig_P04BoardingOrder_Func003Func004C() ) then
            set udg_BoardingOrderTimerCount[4]=0.00
            call BoardingFunc(4)
        else
        endif
        if ( Trig_P04BoardingOrder_Func003Func005C() ) then
            call GroupClear(udg_QueuedMarines[4])
        else
        endif
        if ( Trig_P04BoardingOrder_Func003Func006C() ) then
            call GroupClear(udg_QueuedTransports[4])
        else
        endif
    else
        set udg_BoardingOrderTimerCount[4]=0.00
    endif
endfunction

//===========================================================================
function InitTrig_P04BoardingOrder takes nothing returns nothing
    set gg_trg_P04BoardingOrder=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_P04BoardingOrder, udg_BoardingOrderTimer[4])
    call TriggerAddCondition(gg_trg_P04BoardingOrder, Condition(function Trig_P04BoardingOrder_Conditions))
    call TriggerAddAction(gg_trg_P04BoardingOrder, function Trig_P04BoardingOrder_Actions)
endfunction

