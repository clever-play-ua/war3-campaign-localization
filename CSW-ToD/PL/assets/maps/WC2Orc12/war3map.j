    set gg_trg_VODrakThulClickOn=CreateTrigger()
    call TriggerRegisterPlayerSelectionEventBJ(gg_trg_VODrakThulClickOn, Player(0), true)
    call TriggerAddCondition(gg_trg_VODrakThulClickOn, Condition(function Trig_VODrakThulClickOn_Conditions))
    call TriggerAddAction(gg_trg_VODrakThulClickOn, function Trig_VODrakThulClickOn_Actions)
endfunction

