function InitTrig_Hermit_2_Setup takes nothing returns nothing
    set gg_trg_Hermit_2_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Hermit_2_Setup, function Trig_Hermit_2_Setup_Actions)
endfunction

