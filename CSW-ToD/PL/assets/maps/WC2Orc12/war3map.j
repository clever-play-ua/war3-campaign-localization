//===========================================================================
// Trigger: Load Zuluhed
//===========================================================================
function Trig_Load_Zuluhed_Func002Func004C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc06", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Zuluhed_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc06s", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Zuluhed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Load_Zuluhed_Func002C() ) then
        call RestoreUnitLocFacingAngleBJ("Zuluhed", "WC2Orc06s", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_Intro_Zuluhed_Start), 260.00)
        set udg_Hero_Zuluhed=GetLastRestoredUnitBJ()
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60U'))
    else
        if ( Trig_Load_Zuluhed_Func002Func004C() ) then
            call RestoreUnitLocFacingAngleBJ("Zuluhed", "WC2Orc06", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_Intro_Zuluhed_Start), 260.00)
            set udg_Hero_Zuluhed=GetLastRestoredUnitBJ()
        else
            call CreateNUnitsAtLoc(1, 'O61F', udg_Player_Actual, GetRectCenter(gg_rct_Intro_Zuluhed_Start), 260.00)
            set udg_Hero_Zuluhed=GetLastCreatedUnit()
            call SetHeroLevelBJ(udg_Hero_Zuluhed, 6, false)
            call SelectHeroSkill(udg_Hero_Zuluhed, 'A00R')
            call SelectHeroSkill(udg_Hero_Zuluhed, 'A00R')
            call SelectHeroSkill(udg_Hero_Zuluhed, 'A00S')
            call SelectHeroSkill(udg_Hero_Zuluhed, 'A00U')
            call SelectHeroSkill(udg_Hero_Zuluhed, 'A00U')
            call SelectHeroSkill(udg_Hero_Zuluhed, 'A00T')
            call CreateItemLoc('Z007', GetUnitLoc(udg_Hero_Zuluhed))
            call UnitAddItemSwapped(GetLastCreatedItem(), udg_Hero_Zuluhed)
        endif
    endif
    call ShowUnitHide(udg_Hero_Zuluhed)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
endfunction

//===========================================================================
function InitTrig_Load_Zuluhed takes nothing returns nothing
    set gg_trg_Load_Zuluhed=CreateTrigger()
    call TriggerAddAction(gg_trg_Load_Zuluhed, function Trig_Load_Zuluhed_Actions)
endfunction

