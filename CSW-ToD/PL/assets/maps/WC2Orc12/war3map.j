function InitTrig_Ritual_Temple_Check takes nothing returns nothing
    set gg_trg_Ritual_Temple_Check=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Ritual_Temple_Check, 1.00)
    call TriggerAddCondition(gg_trg_Ritual_Temple_Check, Condition(function Trig_Ritual_Temple_Check_Conditions))
    call TriggerAddAction(gg_trg_Ritual_Temple_Check, function Trig_Ritual_Temple_Check_Actions)
endfunction

