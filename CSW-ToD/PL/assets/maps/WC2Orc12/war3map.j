//===========================================================================
// Trigger: PunishCheaters
//===========================================================================
function Trig_PunishCheaters_Func004C takes nothing returns boolean
    if ( ( udg_Boss_Phase1 == true ) ) then
        return true
    endif
    if ( ( udg_Boss_Phase2 == true ) ) then
        return true
    endif
    if ( ( udg_Boss_Phase2_E == true ) ) then
        return true
    endif
    if ( ( udg_Boss_Phase2_N == true ) ) then
        return true
    endif
    if ( ( udg_Boss_Phase2_W == true ) ) then
        return true
    endif
    if ( ( udg_Boss_Phase3 == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_PunishCheaters_Conditions takes nothing returns boolean
    if ( not Trig_PunishCheaters_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_PunishCheaters_Actions takes nothing returns nothing
    call DisplayTimedTextToForce(GetPlayersAll(), 3.00, "TRIGSTR_3336")
    call KillUnit(udg_Hero_Rend)
    call KillUnit(udg_Hero_Maim)
endfunction

