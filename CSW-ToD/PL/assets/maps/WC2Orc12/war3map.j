    set gg_trg_Boss_Earth_Shield=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Boss_Earth_Shield, 1.00)
    call TriggerAddCondition(gg_trg_Boss_Earth_Shield, Condition(function Trig_Boss_Earth_Shield_Conditions))
