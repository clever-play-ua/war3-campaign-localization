function Trig_Hermit_2_Setup_Func022001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Hermit_2_Setup_Func022001002002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Hermit_2_Setup_Func022001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitHiddenBJ(GetFilterUnit()) == false)) // INLINED!!
endfunction

function Trig_Hermit_2_Setup_Func022002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Hermit_2_Setup_Func025001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Hermit_2_Setup_Func028001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Hermit_2_Setup_Func031001002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Hermit_2_Setup_Func036002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Hermit_2_Setup_Func037002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Hermit_2_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    set udg_Point_CameraReturn=GetCameraTargetPositionLoc()
    //  
    // Weather
    //  
    call SetSkyModel("Environment\\Sky\\VillageFallSky\\VillageFallSky.mdl")
    call UseTimeOfDayBJ(false)
    //  
    // Revive Hero
    //  
    set udg_Unit_RevivalHero=udg_Hero_Zuluhed
    set udg_Point_RevivalSpot=GetRectCenter(gg_rct_Hermit1_Zuluhed)
    call ConditionalTriggerExecute(gg_trg_Cinematic_Revival)
    //  
    // General Unit Prep
    //  
    //  
    // Hide Units
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_HermitCinHideUnits, Condition(function Trig_Hermit_2_Setup_Func022001002)), function Trig_Hermit_2_Setup_Func022002)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_ShadowCouncil, Condition(function Trig_Hermit_2_Setup_Func025001002)), udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_StormWeaver, Condition(function Trig_Hermit_2_Setup_Func028001002)), udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_TwilightHammer, Condition(function Trig_Hermit_2_Setup_Func031001002)), udg_Group_HiddenUnits)
    //  
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), udg_Group_HiddenUnits)
    //  
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Hermit_2_Setup_Func036002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Hermit_2_Setup_Func037002)
    //  
    // Hide Items
    //  
    //  
    // Remove Buffs
    //  
    //  
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    //  
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Hermit1_Zuluhed), 75.00)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeZuluhed, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_FakeZuluhed, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
    call SetUnitInvulnerable(udg_FakeZuluhed, true)
    //  
    // Disable Abilities
    //  
    call SetPlayerAbilityAvailableBJ(false, 'Ashm', udg_Player_Actual)
    //  
endfunction

