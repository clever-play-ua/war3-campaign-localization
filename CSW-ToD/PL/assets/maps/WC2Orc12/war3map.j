    return true
endfunction

function Trig_AI_P05_Attacker_Being_Attacked_Func002Func001A takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(GetEnumUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)
endfunction

function Trig_AI_P05_Attacker_Being_Attacked_Func002Func003A takes nothing returns nothing
