function Trig_Boss_Phase_3_Func014A takes nothing returns nothing
    if ( Trig_Boss_Phase_3_Func014Func001C() ) then
        call SetDestAnimationSpeedPercent(GetEnumDestructable(), GetRandomReal(75.00, 150.00))
        call SetDestructableAnimationBJ(GetEnumDestructable(), "birth")
        call QueueDestructableAnimationBJ(GetEnumDestructable(), "stand")
    else
    endif
    if ( Trig_Boss_Phase_3_Func014Func002C() ) then
        call ShowDestructableBJ(true, GetEnumDestructable())
        call SetDestructableAnimationBJ(GetEnumDestructable(), "birth")
        call QueueDestructableAnimationBJ(GetEnumDestructable(), "stand")
        call SetDestAnimationSpeedPercent(GetEnumDestructable(), GetRandomReal(10.00, 20.00))
