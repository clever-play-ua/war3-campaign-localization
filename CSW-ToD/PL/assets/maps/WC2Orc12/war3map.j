    call TriggerRegisterAnyUnitEventBJ(gg_trg_Rend_I_Rend, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Rend_I_Rend, Condition(function Trig_Rend_I_Rend_Conditions))
