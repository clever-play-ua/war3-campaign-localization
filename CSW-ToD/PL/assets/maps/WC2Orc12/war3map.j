//===========================================================================
// Trigger: P04PlayerMarineLandingOrder
//===========================================================================
function Trig_P04PlayerMarineLandingOrder_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( udg_LandingWarfareHasRan[4] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_P04PlayerMarineLandingOrder_Func003Func003A takes nothing returns nothing
    local integer isc
    set isc=s__IndexShipCargo_struct[GetUnitUserData(GetEnumUnit())]
    if IsUnitInRangeXY(GetEnumUnit(), s__IndexShipCargo_xC[isc], s__IndexShipCargo_yC[isc], udg_DepartureDetectionRange) or not IsUnitInGroup(GetEnumUnit(), udg_DestinationDetectionGroup[4]) then
    call IssuePointOrderById(GetEnumUnit(), 851986, udg_AttackOrderPointerX[4], udg_AttackOrderPointerY[4])
    elseif IsUnitInGroup(GetEnumUnit(), udg_DestinationDetectionGroup[4]) then
    call IssuePointOrderLocBJ(GetEnumUnit(), "unloadall", udg_MarineLandingPoint[4])
    endif
endfunction

function Trig_P04PlayerMarineLandingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_DepartedTransports[4]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P04PlayerMarineLandingOrder_Actions takes nothing returns nothing
    set udg_LandingWarfareHasRan[4]=true
    if ( Trig_P04PlayerMarineLandingOrder_Func003C() ) then
        set udg_MarineLandingPoint[4]=Location(udg_AttackOrderPointerX[4], udg_AttackOrderPointerY[4])
        call GroupEnumUnitsInRange(udg_DestinationDetectionGroup[4], udg_AttackOrderPointerX[4], udg_AttackOrderPointerY[4], udg_DestinationDetectionRange, null)
        call ForGroupBJ(udg_DepartedTransports[4], function Trig_P04PlayerMarineLandingOrder_Func003Func003A)
        call RemoveLocation(udg_MarineLandingPoint[4])
        call GroupClear(udg_DestinationDetectionGroup[4])
    else
    endif
    set udg_LandingWarfareHasRan[4]=false
endfunction

