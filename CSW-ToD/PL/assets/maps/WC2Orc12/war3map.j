function Trig_Boss_Phase_3_Func033A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
    call PauseUnitBJ(false, GetEnumUnit())
    call SetUnitAnimation(GetEnumUnit(), "birth")
    call QueueUnitAnimationBJ(GetEnumUnit(), "stand")
endfunction

function Trig_Boss_Phase_3_Actions takes nothing returns nothing
    set udg_Boss_Phase3=true
    // --------------------------------------------------------------------------------------------------------------------
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.20, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 25.00, 0, 100.00, 0.00)
    call PolledWait(0.20)
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call SetTerrainFogExBJ(0, 250.00, 5000.00, 0.00, 5.00, 0.00, 35.00)
    call SetTimeOfDay(0.00)
    call UseTimeOfDayBJ(false)
    call SetSkyModel("Environment\\Sky\\AshenvaleSky\\AshenvaleSky.mdl")
    // --------------------------------------------------------------------------------------------------------------------
    // Old God Stuff
    // --------------------------------------------------------------------------------------------------------------------
    call EnumDestructablesInRectAll(gg_rct_Boss_Battle_Area, function Trig_Boss_Phase_3_Func014A)
    // --------------------------------------------------------------------------------------------------------------------
    // --------------------------------------------------------------------------------------------------------------------
    // Cho'gall Setup
    // --------------------------------------------------------------------------------------------------------------------
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_ChoGall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_ChoGall, UNIT_WEAPON_BF_ATTACK_SHOW_UI, 0, true)
    call SetUnitInvulnerable(udg_Boss_ChoGall, false)
    if ( Trig_Boss_Phase_3_Func022C() ) then
        call BlzSetUnitArmor(udg_Boss_ChoGall, 5.00)
    else
        if ( Trig_Boss_Phase_3_Func022Func002C() ) then
            call BlzSetUnitArmor(udg_Boss_ChoGall, 10.00)
        else
            if ( Trig_Boss_Phase_3_Func022Func002Func002C() ) then
                call BlzSetUnitArmor(udg_Boss_ChoGall, 15.00)
            else
            endif
        endif
    endif
    call BlzSetUnitMaxHP(udg_Boss_ChoGall, 10000)
    if ( Trig_Boss_Phase_3_Func024C() ) then
        call BlzSetUnitArmor(udg_Boss_ChoGall, 10.00)
    else
        if ( Trig_Boss_Phase_3_Func024Func002C() ) then
            call BlzSetUnitArmor(udg_Boss_ChoGall, 15.00)
        else
            if ( Trig_Boss_Phase_3_Func024Func002Func002C() ) then
                call BlzSetUnitArmor(udg_Boss_ChoGall, 20.00)
            else
            endif
        endif
    endif
    call SetUnitLifePercentBJ(udg_Boss_ChoGall, 30.00)
    call UnitAddAbilityBJ('ACB0', udg_Boss_ChoGall)
    call IssuePointOrderLocBJ(udg_Boss_ChoGall, "healingspray", GetRectCenter(gg_rct_Boss_Phase_2_Center))
    call UnitAddAbilityBJ('ACB1', udg_Boss_ChoGall)
    call IssueImmediateOrderBJ(udg_Boss_ChoGall, "holdposition")
    // --------------------------------------------------------------------------------------------------------------------
    // Troops
    // --------------------------------------------------------------------------------------------------------------------
    call ForGroupBJ(udg_Boss_Phase2_U_Tentacles, function Trig_Boss_Phase_3_Func033A)
    // --------------------------------------------------------------------------------------------------------------------
    // Gate
    // --------------------------------------------------------------------------------------------------------------------
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_DIG1_2327)
    call KillDestructable(gg_dest_DMAG_2172)
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_DIG2_2196)
    call KillDestructable(gg_dest_DMAG_7422)
    //  
    // Move Shamans
    //  
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_Zuluhed, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    //  
    call UnitRemoveAbilityBJ('ACB4', udg_Boss_Utok)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Boss_Utok)
    call IssuePointOrderLocBJ(udg_Boss_Utok, "move", GetRectCenter(gg_rct_Boss_Utok_P3))
    call IssuePointOrderLocBJ(udg_Boss_Zuluhed, "move", GetRectCenter(gg_rct_Boss_Zuluhed_P3))
    // --------------------------------------------------------------------------------------------------------------------
    call PolledWait(1.00)
    call ConditionalTriggerExecute(gg_trg_VOChogallBossfight05)
    // --------------------------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Boss_Phase_3_Twillight_Timer)
endfunction

