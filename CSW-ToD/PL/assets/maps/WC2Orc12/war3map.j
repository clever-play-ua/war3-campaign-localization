    set gg_trg_AI_P7_Defeated=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AI_P7_Defeated, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AI_P7_Defeated, Condition(function Trig_AI_P7_Defeated_Conditions))
