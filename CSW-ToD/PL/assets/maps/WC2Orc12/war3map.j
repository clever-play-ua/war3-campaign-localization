function InitTrig_P04PlayerMarineLandingOrder takes nothing returns nothing
    set gg_trg_P04PlayerMarineLandingOrder=CreateTrigger()
    call TriggerAddCondition(gg_trg_P04PlayerMarineLandingOrder, Condition(function Trig_P04PlayerMarineLandingOrder_Conditions))
    call TriggerAddAction(gg_trg_P04PlayerMarineLandingOrder, function Trig_P04PlayerMarineLandingOrder_Actions)
