//===========================================================================
// Trigger: Hermit 1 Cleanup
//===========================================================================
function Trig_Hermit_1_Cleanup_Func008002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Hermit_1_Cleanup_Func010002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Hermit_1_Cleanup_Actions takes nothing returns nothing
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call StopSoundBJ(gg_snd_ACT_IV_CinematicTheme1, true)
    // Restore Abilities
    call SetPlayerAbilityAvailableBJ(true, 'Ashm', udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // Unhide Units
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Hermit_1_Cleanup_Func008002)
    // Unpause Units
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Hermit_1_Cleanup_Func010002)
    call GroupClear(udg_Group_HiddenUnits)
    // Pause Time Of Day
    call UseTimeOfDayBJ(true)
    // Re-enable XP Gain
    // Return Heroes
    // Restore Selection
    // Reset Sky
    // Reset Fog
    call ResetTerrainFogBJ()
    // Reset Camera
    call CameraResetSmoothingFactorBJ()
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, udg_Point_CameraReturn, 0)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call ConditionalTriggerExecute(gg_trg_AI_P4_Start)
    call SetItemVisibleBJ(false, gg_item_IQL0_0340)
endfunction

