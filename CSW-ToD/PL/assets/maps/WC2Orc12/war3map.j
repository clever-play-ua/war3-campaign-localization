    call TriggerAddCondition(gg_trg_P07DetectSeaLoading, Condition(function Trig_P07DetectSeaLoading_Conditions))
    call TriggerAddAction(gg_trg_P07DetectSeaLoading, function Trig_P07DetectSeaLoading_Actions)
