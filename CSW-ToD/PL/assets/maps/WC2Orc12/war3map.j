    endif
    return true
endfunction

function Trig_Quest_Artifact_Completed_Func004C takes nothing returns boolean
    if ( Trig_Quest_Artifact_Completed_Func004Func001C() ) then
        return true
    endif
    if ( Trig_Quest_Artifact_Completed_Func004Func002C() ) then
        return true
    endif
    if ( Trig_Quest_Artifact_Completed_Func004Func003C() ) then
        return true
    endif
    if ( Trig_Quest_Artifact_Completed_Func004Func004C() ) then
        return true
    endif
    return false
endfunction

function Trig_Quest_Artifact_Completed_Conditions takes nothing returns boolean
    if ( not ( IsQuestItemCompleted(udg_QReq_ShadowCouncillKill) == true ) ) then
        return false
    endif
    if ( not Trig_Quest_Artifact_Completed_Func004C() ) then
        return false
    endif
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

