//===========================================================================
// Trigger: InitUnits
//===========================================================================
function Trig_InitUnits_Func023001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_ShadowCouncil )
endfunction

function Trig_InitUnits_Func023001002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false )
endfunction

function Trig_InitUnits_Func023001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_ShadowCouncil), (IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false)) // INLINED!!
endfunction

function Trig_InitUnits_Func023A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_GulDansGuard)
endfunction

function Trig_InitUnits_Func029002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DrakThulGuard)
endfunction

function Trig_InitUnits_Func052A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_InitUnits_Func060A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_InitUnits_Func095001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true )
endfunction

function Trig_InitUnits_Func095001002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) )
endfunction

function Trig_InitUnits_Func095001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true), (GetOwningPlayer(GetFilterUnit()) != Player(PLAYER_NEUTRAL_PASSIVE))) // INLINED!!
endfunction

function Trig_InitUnits_Func095A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_RitualIsland)
endfunction

function Trig_InitUnits_Func097002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_InitUnits_Func098002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_InitUnits_Func120002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_InitUnits_Actions takes nothing returns nothing
    // ///
    set udg_U_TierDummy[0]=gg_unit_o9ZZ_0131
    set udg_U_TierDummy[1]=gg_unit_o9ZZ_0076
    call PauseUnitBJ(true, udg_U_TierDummy[0])
    call PauseUnitBJ(true, udg_U_TierDummy[1])
    call ShowUnitHide(udg_U_TierDummy[0])
    call ShowUnitHide(udg_U_TierDummy[1])
    set udg_U_TransportDummy=gg_unit_u005_0274
    // ///
    set udg_Unit_Drakthul=gg_unit_odkt_0058
    call SetUnitInvulnerable(udg_Unit_Drakthul, true)
    set udg_Unit_DrakthulsHut=gg_unit_n61Y_0083
    call SetUnitInvulnerable(udg_Unit_DrakthulsHut, true)
    call AddSpecialEffectTargetUnitBJ("overhead", udg_Unit_Drakthul, "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl")
    set udg_SE_ExclamationPoint=GetLastCreatedEffectBJ()
    // ///
    // ///
    set udg_Unit_IntroGrunt=gg_unit_o60G_0053
    set udg_Unit_IntroDeathKnight=gg_unit_u000_0177
    set udg_Unit_IntroOgre=gg_unit_n001_0266
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Boss_Battle_Area, Condition(function Trig_InitUnits_Func023001002)), function Trig_InitUnits_Func023A)
    // ///
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_DrakThulGuard, udg_Player_ShadowCouncil), function Trig_InitUnits_Func029002)
    //  
    // Warlock Prep
    //  
    set udg_Unit_DummyDarkEmpowerment[1]=gg_unit_u005_0314
    call UnitAddAbilityBJ('ADE0', udg_Unit_DummyDarkEmpowerment[1])
    //  
    set udg_Unit_DummyDarkEmpowerment[2]=gg_unit_u005_0337
    call UnitAddAbilityBJ('ADE0', udg_Unit_DummyDarkEmpowerment[2])
    //  
    call GroupAddUnitSimple(gg_unit_h62K_0122, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_n002_0252, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_h62K_0120, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_o621_0123, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_o621_0124, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_o621_0117, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_nw2w_0247, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_nw2w_0116, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_nw2w_0248, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_o61D_0115, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_u000_0114, udg_Group_GuldanClans)
    call GroupAddUnitSimple(gg_unit_o61D_0119, udg_Group_GuldanClans)
    //  
    call ForGroupBJ(udg_Group_GuldanClans, function Trig_InitUnits_Func052A)
    //  
    call ShowUnitHide(gg_unit_O007_0000)
    call PauseUnitBJ(true, gg_unit_O007_0000)
    //  
    // Cho'gall - Boss Fight
    //  
    set udg_Boss_Phase2_U_Tentacles=GetUnitsOfTypeIdAll('n006')
    call ForGroupBJ(udg_Boss_Phase2_U_Tentacles, function Trig_InitUnits_Func060A)
    call ShowUnitHide(gg_unit_O001_0087)
    //  
    set udg_Boss_Zuluhed=gg_unit_O002_0140
    set udg_Boss_Utok=gg_unit_oUC1_0136
    //  
    call ShowUnitHide(udg_Boss_Zuluhed)
    call PauseUnitBJ(true, udg_Boss_Zuluhed)
    //  
    call ShowUnitHide(udg_Boss_Utok)
    call PauseUnitBJ(true, udg_Boss_Utok)
    //  
    call ShowUnitHide(gg_unit_h62K_0229)
    call ShowUnitHide(gg_unit_o621_0141)
    call ShowUnitHide(gg_unit_o621_0133)
    call ShowUnitHide(gg_unit_h62K_0231)
    call ShowUnitHide(gg_unit_n002_0233)
    //  
    call PauseUnitBJ(true, gg_unit_h62K_0229)
    call PauseUnitBJ(true, gg_unit_o621_0141)
    call PauseUnitBJ(true, gg_unit_o621_0133)
    call PauseUnitBJ(true, gg_unit_h62K_0231)
    call PauseUnitBJ(true, gg_unit_n002_0233)
    //  
    // Ritual Init
    //  
    set udg_Unit_BlackrockTraitor=gg_unit_ogru_0028
    call SetUnitInvulnerable(udg_Unit_BlackrockTraitor, true)
    call SetUnitAnimation(udg_Unit_BlackrockTraitor, "cinematic injured two")
    call BlzSetUnitName(udg_Unit_BlackrockTraitor, BlzGetItemTooltip(gg_item_IQL0_0340))
    call PauseUnitBJ(true, udg_Unit_BlackrockTraitor)
    //  
    // Hide Ritual Units Untill Quest Is Discovered
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Fog_Ritual, Condition(function Trig_InitUnits_Func095001002)), function Trig_InitUnits_Func095A)
    //  
    call ForGroupBJ(udg_Group_RitualIsland, function Trig_InitUnits_Func097002)
    call ForGroupBJ(udg_Group_RitualIsland, function Trig_InitUnits_Func098002)
    //  
    call ShowUnitHide(gg_unit_u001_0026)
    call ShowUnitHide(gg_unit_u001_0009)
    call ShowUnitHide(gg_unit_u001_0234)
    //  
    call UnitAddAbilityBJ('ABTH', gg_unit_o612_0004)
    call UnitAddAbilityBJ('A64G', gg_unit_o613_0206)
    call UnitRemoveAbilityBJ('ABBT', gg_unit_o613_0206)
    call UnitRemoveAbilityBJ('ABBT', gg_unit_o612_0004)
    //  
    //  
    call UnitRemoveTypeBJ(UNIT_TYPE_TOWNHALL, gg_unit_o612_0342)
    call ShowUnitHide(gg_unit_o612_0342)
    call ShowUnitHide(gg_unit_o60Z_0341)
    call ShowUnitHide(gg_unit_o60Z_0339)
    call ShowUnitHide(gg_unit_o60Z_0361)
    call ShowUnitHide(gg_unit_o60Z_0359)
    //  
    // RemoveDummies
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_CinematicDummy), function Trig_InitUnits_Func120002)
    //  
    call SetItemVisibleBJ(false, gg_item_IQL0_0340)
    //  
    //  
    //  
    //  
    //  
    //  
    //  
    //  
    //  
endfunction

