//===========================================================================
// Trigger: Quest Artifact Found
//===========================================================================
function Trig_Quest_Artifact_Found_Conditions takes nothing returns boolean
    if ( not ( GetManipulatedItem() == udg_Item_SkeletalArtifact ) ) then
        return false
    endif
    return true
endfunction

function Trig_Quest_Artifact_Found_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Ensure that the quest exists
    call ConditionalTriggerExecute(gg_trg_Quest_Find_Artifact_Create)
    // Update the quest
    call QuestSetDiscoveredBJ(udg_OQShadowCouncill, true)
    call QuestItemSetCompletedBJ(udg_QReq_ShadowCouncillKill, true)
    // Display a quest message.
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "TRIGSTR_302")
    // Attach Exclamation Point above Quest Giver
    call AddSpecialEffectTargetUnitBJ("overhead", udg_Unit_Drakthul, "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl")
    set udg_SE_ExclamationPoint=GetLastCreatedEffectBJ()
    call RemoveUnit(udg_Unit_DummyDarkEmpowerment[2])
    // //
    call DestroyMinimapIcon(udg_MinimapIcon_QuestDrakThul)
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_Hermit2_Drakthul01), bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_QuestDrakThul=GetLastCreatedMinimapIcon()
endfunction

