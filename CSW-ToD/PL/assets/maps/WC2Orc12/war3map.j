        return false
    endif
    return true
endfunction

function Trig_Quest_Destroy_TH_Base_Completed_Func002Func001001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_TwilightHammer )
endfunction

function Trig_Quest_Destroy_TH_Base_Completed_Func002Func001001001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_Quest_Destroy_TH_Base_Completed_Func002Func001001001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Quest_Destroy_TH_Base_Completed_Func002Func001001001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Quest_Destroy_TH_Base_Completed_Func002Func001001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_TwilightHammer), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_Quest_Destroy_TH_Base_Completed_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_Fog_Twillight, Condition(function Trig_Quest_Destroy_TH_Base_Completed_Func002Func001001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Quest_Destroy_TH_Base_Completed_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Quest_Destroy_TH_Base_Completed_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QueuedTriggerAddBJ(gg_trg_Quest_Destroy_TH_Base_CompletedQ, true)
    else
    endif
endfunction

