//===========================================================================
// Trigger: Cinematic Revival
//
// Before running this in a cinematic, do the following:
//   - Set "RevivalHero" to the hero you wish to revive.
//   - Set "RevivalSpot" to the place at which you wish the hero to be revived.
// After running this, set the unit facing for the revived hero.
// After the cinematic, move the hero instantly to RevivalReturnSpot.
//===========================================================================
function Trig_Cinematic_Revival_Func003001 takes nothing returns boolean
    return ( IsUnitAliveBJ(udg_Unit_RevivalHero) == true )
endfunction

function Trig_Cinematic_Revival_Func006002001002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Cinematic_Revival_Func006002001002002001001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o614' )
endfunction

function Trig_Cinematic_Revival_Func006002001002002001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o614' )
endfunction

function Trig_Cinematic_Revival_Func006002001002002001 takes nothing returns boolean
    return GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'o614'), (GetUnitTypeId(GetFilterUnit()) == 'o614')) // INLINED!!
endfunction

function Trig_Cinematic_Revival_Func006002001002002002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o613' )
endfunction

function Trig_Cinematic_Revival_Func006002001002002002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o612' )
endfunction

function Trig_Cinematic_Revival_Func006002001002002002 takes nothing returns boolean
    return GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'o613'), (GetUnitTypeId(GetFilterUnit()) == 'o612')) // INLINED!!
endfunction

function Trig_Cinematic_Revival_Func006002001002002 takes nothing returns boolean
    return GetBooleanOr((GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'o614'), (GetUnitTypeId(GetFilterUnit()) == 'o614'))), (GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'o613'), (GetUnitTypeId(GetFilterUnit()) == 'o612')))) // INLINED!!
endfunction

function Trig_Cinematic_Revival_Func006002001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetBooleanOr((GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'o614'), (GetUnitTypeId(GetFilterUnit()) == 'o614'))), (GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'o613'), (GetUnitTypeId(GetFilterUnit()) == 'o612')))))) // INLINED!!
endfunction

function Trig_Cinematic_Revival_Func007001 takes nothing returns boolean
    return ( udg_Unit_RevivalAltar != null )
endfunction

function Trig_Cinematic_Revival_Actions takes nothing returns nothing
    set udg_Point_RevivalReturnSpot=GetUnitLoc(udg_Unit_RevivalHero)
    call SetUnitPositionLoc(udg_Unit_RevivalHero, udg_Point_RevivalSpot)
    if ( (IsUnitAliveBJ(udg_Unit_RevivalHero) == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ReviveHeroLoc(udg_Unit_RevivalHero, udg_Point_RevivalSpot, false)
    set udg_Point_RevivalReturnSpot=udg_Point_RevivalSpot
    set udg_Unit_RevivalAltar=GroupPickRandomUnit(GetUnitsOfPlayerMatching(GetOwningPlayer(udg_Unit_RevivalHero), Condition(function Trig_Cinematic_Revival_Func006002001002)))
    if ( (udg_Unit_RevivalAltar != null) ) then // INLINED!!
        set udg_Point_RevivalReturnSpot=OffsetLocation(GetUnitLoc(udg_Unit_RevivalAltar), 0, - 128.00)
    else
        call DoNothing()
    endif
endfunction

//===========================================================================
function InitTrig_Cinematic_Revival takes nothing returns nothing
    set gg_trg_Cinematic_Revival=CreateTrigger()
    call TriggerAddAction(gg_trg_Cinematic_Revival, function Trig_Cinematic_Revival_Actions)
endfunction

//===========================================================================
// Trigger: Init Reload
//===========================================================================
function Trig_Init_Reload_Actions takes nothing returns nothing
    call SetMapFacialAnimations()
    // Clear any pending music list
    call ClearMapMusicBJ()
    // Play music
    call PolledWait(0.10)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

