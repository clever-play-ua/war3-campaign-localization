    // Hshtable for whirlwind spell tracking
    call InitHashtableBJ()
    set udg_Hashtable_WhirlwindSpell=GetLastCreatedHashtableBJ()
endfunction

//===========================================================================
function InitTrig_WhirlwindInit takes nothing returns nothing
    set gg_trg_WhirlwindInit=CreateTrigger()
    call TriggerAddAction(gg_trg_WhirlwindInit, function Trig_WhirlwindInit_Actions)
endfunction

//===========================================================================
// Trigger: WhirlwindCast
//===========================================================================
function Trig_WhirlwindCast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AWwV' ) ) then
        return false
    endif
    return true
endfunction

function Trig_WhirlwindCast_Func024C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_WhirlwindChannelInterrupted) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_WhirlwindCast_Actions takes nothing returns nothing
    local location Point_WWCast
    local unit w
    local unit dk
    // //
    set dk=GetSpellAbilityUnit()
    set Point_WWCast=GetSpellTargetLoc()
    // //
    // Create Whirlwind
    call CreateNUnitsAtLoc(1, 'nXD0', GetOwningPlayer(GetSpellAbilityUnit()), Point_WWCast, GetRandomDirectionDeg())
    set w=GetLastCreatedUnit()
    // //
    // Add timed life
    call UnitApplyTimedLife(w, 'B002', 60.00)
    // //
    // Store in hashtable
    call SaveUnitHandle(udg_Hashtable_WhirlwindSpell, GetHandleId(w), 0, dk)
    call SaveUnitHandle(udg_Hashtable_WhirlwindSpell, GetHandleId(dk), 0, w)
    // //
    // Leak Cleaner
    // //
    call RemoveLocation(Point_WWCast)
    set Point_WWCast=null
    // //
    if ( Trig_WhirlwindCast_Func024C() ) then
        call EnableTrigger(gg_trg_WhirlwindChannelInterrupted)
    else
    endif
endfunction

//===========================================================================
function InitTrig_WhirlwindCast takes nothing returns nothing
    set gg_trg_WhirlwindCast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_WhirlwindCast, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_WhirlwindCast, Condition(function Trig_WhirlwindCast_Conditions))
    call TriggerAddAction(gg_trg_WhirlwindCast, function Trig_WhirlwindCast_Actions)
endfunction

