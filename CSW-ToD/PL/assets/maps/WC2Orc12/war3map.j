    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nmg0' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nmg1' ) ) then
        return true
    endif
    return false
endfunction

