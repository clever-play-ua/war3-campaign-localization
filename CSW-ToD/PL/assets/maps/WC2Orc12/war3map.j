function InitTrig_Maim_I_Bloodthirst takes nothing returns nothing
    set gg_trg_Maim_I_Bloodthirst=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Maim_I_Bloodthirst, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Maim_I_Bloodthirst, Condition(function Trig_Maim_I_Bloodthirst_Conditions))
