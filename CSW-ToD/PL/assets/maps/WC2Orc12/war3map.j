//===========================================================================
// Trigger: AI P8 Start
//===========================================================================
function Trig_AI_P8_Start_Func006Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P8_Start_Func006C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P8_Start_Func013A takes nothing returns nothing
    call UnitAddTypeBJ(UNIT_TYPE_TOWNHALL, GetEnumUnit())
endfunction

function Trig_AI_P8_Start_Func016A takes nothing returns nothing
    call UnitAddTypeBJ(UNIT_TYPE_PEON, GetEnumUnit())
endfunction

function Trig_AI_P8_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call AdjustPlayerStateBJ(20000, udg_Player_StormReaverNaval, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(20000, udg_Player_StormReaverNaval, PLAYER_STATE_RESOURCE_LUMBER)
    call AdjustPlayerStateBJ(60, udg_Player_StormReaverNaval, PLAYER_STATE_RESOURCE_FOOD_CAP)
    if ( Trig_AI_P8_Start_Func006C() ) then
        call playerAddOil(Player(7) , 90000)
    else
        if ( Trig_AI_P8_Start_Func006Func003C() ) then
            call playerAddOil(Player(7) , 80000)
        else
            call playerAddOil(Player(7) , 60000)
        endif
    endif
    // //
    call EnableTrigger(gg_trg_AI_P8_Gold)
    call EnableTrigger(gg_trg_AI_P8_Lumber)
    call EnableTrigger(gg_trg_AI_P8_Oil)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_StormReaverNaval, 'o60V'), function Trig_AI_P8_Start_Func013A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_StormReaverNaval, 'h000'), function Trig_AI_P8_Start_Func016A)
    // //
    call StartCampaignAI(udg_Player_StormReaverNaval, "CSW\\Scripts\\ToDScripts\\WC2Orc12\\WC2Orc12P08NavalAI.ai")
    // //
    call IssueTargetOrderBJ(gg_unit_h001_0328, "smart", gg_unit_u002_0276)
    // //
    call StartTimerBJ(udg_Timer_P08Oil, true, 1.00)
endfunction

//===========================================================================
function InitTrig_AI_P8_Start takes nothing returns nothing
    set gg_trg_AI_P8_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_P8_Start, function Trig_AI_P8_Start_Actions)
endfunction

