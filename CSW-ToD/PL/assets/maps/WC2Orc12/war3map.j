//===========================================================================
// Trigger: Ritual Temple Check
//===========================================================================
function Trig_Ritual_Temple_Check_Conditions takes nothing returns boolean
    if ( not ( udg_RitualTempleCount == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ritual_Temple_Check_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    //  
    call RemoveDestructable(gg_dest_B005_1469)
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 1.00)
    call UnitShareVisionBJ(true, udg_Unit_BlackrockTraitor, Player(0))
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetUnitLoc(udg_Unit_BlackrockTraitor), 1.00)
    call TriggerSleepAction(1.00)
    //  
    call SetUnitInvulnerable(gg_unit_nsrh_0072, false)
    call SetUnitInvulnerable(gg_unit_nw2w_0318, false)
    call SetUnitInvulnerable(gg_unit_nsra_0091, false)
    //  
    call BlzSetUnitWeaponBooleanFieldBJ(gg_unit_nsrh_0072, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
    call BlzSetUnitWeaponBooleanFieldBJ(gg_unit_nsra_0091, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
    call BlzSetUnitWeaponBooleanFieldBJ(gg_unit_nw2w_0318, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
    //  
    call BlzSetUnitWeaponIntegerFieldBJ(gg_unit_nsrh_0072, UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, 50)
    call BlzSetUnitWeaponIntegerFieldBJ(gg_unit_nsra_0091, UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, 50)
    call BlzSetUnitWeaponIntegerFieldBJ(gg_unit_nw2w_0318, UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, 50)
    //  
    call SetUnitAnimation(gg_unit_ogru_0028, "Spell")
    call TriggerSleepAction(1.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_BookOfTHeDead), "Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl")
    set udg_SE_BlackrockTraitorMorph=GetLastCreatedEffectBJ()
    call TriggerSleepAction(1.00)
    call ReplaceUnitBJ(gg_unit_ogru_0028, 'nchg', bj_UNIT_STATE_METHOD_MAXIMUM)
    set udg_Unit_BlackrockTraitor=GetLastReplacedUnitBJ()
    call UnitShareVisionBJ(true, udg_Unit_BlackrockTraitor, Player(0))
    call SetUnitInvulnerable(udg_Unit_BlackrockTraitor, false)
    call BlzSetUnitName(udg_Unit_BlackrockTraitor, BlzGetItemTooltip(gg_item_IQL0_0340))
    call PauseUnitBJ(false, udg_Unit_BlackrockTraitor)
    //  
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    //  
    call TriggerSleepAction(1.00)
    call DestroyEffectBJ(udg_SE_BlackrockTraitorMorph)
    call QueuedTriggerAddBJ(gg_trg_VOBlackRockTraitorQ, true)
endfunction

