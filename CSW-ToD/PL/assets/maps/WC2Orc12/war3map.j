function Trig_Hermit_Cinematic_2_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_InCinematic=true
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call PlaySoundBJ(gg_snd_ACT_IV_CinematicTheme2)
    call SetSoundVolumeBJ(gg_snd_ACT_IV_CinematicTheme1, 60.00)
    // Set Up Scene
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Hermit_2_Setup)
    call TriggerSleepAction(0.25)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Zuluhed_1, udg_Player_Actual, 0)
    call CameraSetFocalDistance(150.00)
    call SetTerrainFogExBJ(0, 1500.00, 6000.00, 0, 90.00, 60.00, 7.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitFacingTimed(udg_Unit_Drakthul, 310.00, 0.50)
    // Fade In
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call EnableTrigger(gg_trg_Hermit_2_Skipped)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    //  
    // Zuluhed 7
    //  
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_Unit_Drakthul, 0.25)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed7, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Zuluhed7, 0)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call TriggerSleepAction(0.45)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Drakthul_1, udg_Player_Actual, 0)
    //  
    //  
    // Drak'thul 4
    //  
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Drakthul_1, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_Drakthul, 0, gg_snd_WC2Orc12Drakthul4, bj_TIMETYPE_ADD, 0, false)
    //  
    call TriggerSleepAction(7.00)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.30, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.30)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetTerrainFogExBJ(0, 1000.00, 3500.00, 0, 98.00, 57.00, 8.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_2_Islands_1_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_2_Islands_1_b, udg_Player_Actual, 20.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.30, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(10.00)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Zuluhed_1, udg_Player_Actual, 0)
    call WaitForSoundBJ(gg_snd_WC2Orc12Drakthul4, 0)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Zuluhed 8
    //  
    call CameraSetFocalDistance(150.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Zuluhed_1, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed8, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Zuluhed8, 0)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Drak'thul 5
    //  
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Drakthul_1, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_Drakthul, 0, gg_snd_WC2Orc12Drakthul5, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(12.30)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Zuluhed_1, udg_Player_Actual, 0)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc12Drakthul5, 0)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Drak'thul 6
    //  
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_Drakthul, 0, gg_snd_WC2Orc12Drakthul6, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Drakthul_2, udg_Player_Actual, 0)
    //  
    call SetUnitFacingTimed(udg_Unit_Drakthul, 0.00, 1.00)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetTerrainFogExBJ(0, 500.00, 1500.00, 0, 21.00, 34.00, 32.00)
    call CameraSetFocalDistance(125.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Ending_1_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Ending_1_b, udg_Player_Actual, 15.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 3.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(10.00)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Drakthul_1, udg_Player_Actual, 0)
    call SetTerrainFogExBJ(0, 1500.00, 6000.00, 0, 90.00, 60.00, 7.00)
    call SetUnitFacingTimed(udg_Unit_Drakthul, 280.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc12Drakthul6, 5.00)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Zuluhed_1, udg_Player_Actual, 0)
    call WaitForSoundBJ(gg_snd_WC2Orc12Drakthul6, 0)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Zuluhed 9
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Hermit_Zuluhed_2, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed9, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic frustrated one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc12Zuluhed9, 0)
    if ( (udg_Bool_CinHermit2Skipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_Unit_Drakthul, 265.00, 1.00)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC ENDS - Cinematic Can No Longer Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call DisableTrigger(gg_trg_Hermit_2_Skipped)
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // Cleanup
    call ConditionalTriggerExecute(gg_trg_Hermit_2_Cleanup)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // Fade In
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    set udg_Bool_InCinematic=false
endfunction

