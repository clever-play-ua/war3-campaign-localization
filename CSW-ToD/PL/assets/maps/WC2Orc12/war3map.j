function Trig_P07DeindexPassengers_Func011C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oEMa' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oBMa' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oCaM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'oDkM' ) ) then
        return true
    endif
    return false
endfunction

function Trig_P07DeindexPassengers_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_StormWeaver ) ) then
        return false
    endif
    if ( not Trig_P07DeindexPassengers_Func011C() ) then
        return false
    endif
    return true
endfunction

function Trig_P07DeindexPassengers_Actions takes nothing returns nothing
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_IdleMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarinesAdditional[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_UnitsInCargo)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P7MarineCatapults)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P7MarineRanged)
endfunction

