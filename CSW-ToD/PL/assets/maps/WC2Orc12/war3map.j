//===========================================================================
// Trigger: AI P8 Oil
//===========================================================================
function Trig_AI_P8_Oil_Func006A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P08OilRigs)
endfunction

function Trig_AI_P8_Oil_Func017C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P8_Oil_Actions takes nothing returns nothing
    local integer p08OilRigs
    // //
    call GroupClear(udg_Group_P08OilRigs)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_StormReaverNaval, 'u600'), function Trig_AI_P8_Oil_Func006A)
    // //
    set p08OilRigs=CountUnitsInGroup(udg_Group_P08OilRigs)
    // //
    if (OilHarvest__playerOil[GetPlayerId((Player(7)))]) < 700 and p08OilRigs == 0 then // INLINED!!
    call PauseTimerBJ(true, udg_Timer_P08Oil)
    call ConditionalTriggerExecute(gg_trg_AI_P8_Command_Stop_Attack_User)
    // //
    call DisableTrigger(gg_trg_P08OilSpentForDestroyer)
    call DisableTrigger(gg_trg_P08OilSpentForTurtle)
    // //
    if ( Trig_AI_P8_Oil_Func017C() ) then
        call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3551")
    else
    endif
    endif
    // //
    call GroupClear(udg_Group_P08OilRigs)
endfunction

