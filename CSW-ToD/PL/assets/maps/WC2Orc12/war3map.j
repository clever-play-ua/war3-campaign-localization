//===========================================================================
// Trigger: Mission Failed BaseDead
//===========================================================================
function Trig_Mission_Failed_BaseDead_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( udg_Bool_InCinematic == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_MQTHBase) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mission_Failed_BaseDead_Func010001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_Mission_Failed_BaseDead_Func010001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Mission_Failed_BaseDead_Func010001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Mission_Failed_BaseDead_Func010A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerDefeatCondition)
endfunction

function Trig_Mission_Failed_BaseDead_Func013001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_Mission_Failed_BaseDead_Func013001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Mission_Failed_BaseDead_Func013001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Mission_Failed_BaseDead_Func013A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PlayerDefeatCondition)
endfunction

function Trig_Mission_Failed_BaseDead_Func015C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_PlayerDefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mission_Failed_BaseDead_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_PlayerDefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Mission_Failed_BaseDead_Func010001002)), function Trig_Mission_Failed_BaseDead_Func010A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Mission_Failed_BaseDead_Func013001002)), function Trig_Mission_Failed_BaseDead_Func013A)
    // //
    if ( Trig_Mission_Failed_BaseDead_Func015C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_MISSIONFAILED, "TRIGSTR_3541")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call ConditionalTriggerExecute(gg_trg_Defeat)
    else
    endif
    // //
    call GroupClear(udg_Group_PlayerDefeatCondition)
    // //
endfunction

//===========================================================================
function InitTrig_Mission_Failed_BaseDead takes nothing returns nothing
    set gg_trg_Mission_Failed_BaseDead=CreateTrigger()
    call DisableTrigger(gg_trg_Mission_Failed_BaseDead)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Mission_Failed_BaseDead, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Mission_Failed_BaseDead, Condition(function Trig_Mission_Failed_BaseDead_Conditions))
    call TriggerAddAction(gg_trg_Mission_Failed_BaseDead, function Trig_Mission_Failed_BaseDead_Actions)
endfunction

//===========================================================================
// Trigger: MissionFailedBlackhandBratsKilled
//===========================================================================
function Trig_MissionFailedBlackhandBratsKilled_Func008C takes nothing returns boolean
    if ( ( GetDyingUnit() == udg_Hero_Maim ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_Hero_Rend ) ) then
        return true
    endif
    return false
endfunction

function Trig_MissionFailedBlackhandBratsKilled_Conditions takes nothing returns boolean
    if ( not Trig_MissionFailedBlackhandBratsKilled_Func008C() ) then
        return false
    endif
    if ( not ( IsQuestDiscovered(udg_MQKillChogall) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MissionFailedBlackhandBratsKilled_Func002Func002C takes nothing returns boolean
    if ( ( udg_Boss_Phase1 == true ) ) then
        return true
    endif
    if ( ( udg_Boss_Phase2 == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_MissionFailedBlackhandBratsKilled_Func002C takes nothing returns boolean
    if ( not Trig_MissionFailedBlackhandBratsKilled_Func002Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_MissionFailedBlackhandBratsKilled_Func003C takes nothing returns boolean
    if ( not ( udg_Boss_Phase3 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MissionFailedBlackhandBratsKilled_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_MissionFailedBlackhandBratsKilled_Func002C() ) then
        call ConditionalTriggerExecute(gg_trg_VOChogallBossfight06Q)
    else
    endif
    if ( Trig_MissionFailedBlackhandBratsKilled_Func003C() ) then
        call ConditionalTriggerExecute(gg_trg_VOChogallBossfight07Q)
    else
    endif
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_MISSIONFAILED, "TRIGSTR_3307")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_Defeat)
endfunction

