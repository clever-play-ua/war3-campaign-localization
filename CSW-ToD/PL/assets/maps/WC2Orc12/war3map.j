    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_QueuedTransports[GetConvertedPlayerId(udg_Player_TwilightHammer)]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_DepartedTransports[GetConvertedPlayerId(udg_Player_TwilightHammer)]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TRReturnAndRecycle_Func005Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TRReturnAndRecycle_Func005A takes nothing returns nothing
    if ( Trig_TRReturnAndRecycle_Func005Func001C() ) then
        call RecycleGuardPosition(GetEnumUnit())
        // Covering Repair case here
        if ( (true) ) then // INLINED!!
            // Covering Repair case here
        else
        endif
    else
    endif
    if ( Trig_TRReturnAndRecycle_Func005Func002C() ) then
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_P4AITransShipReturnAwait)
    else
    endif
endfunction

function Trig_TRReturnAndRecycle_Actions takes nothing returns nothing
    // //
    call ForGroupBJ(udg_Group_P7AITransShipReturnAwait, function Trig_TRReturnAndRecycle_Func003A)
    // //
    call ForGroupBJ(udg_Group_P4AITransShipReturnAwait, function Trig_TRReturnAndRecycle_Func005A)
    // //
endfunction

//===========================================================================
function InitTrig_TRReturnAndRecycle takes nothing returns nothing
    set gg_trg_TRReturnAndRecycle=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_TRReturnAndRecycle, GetRandomReal(1.50, 3.00))
    call TriggerAddCondition(gg_trg_TRReturnAndRecycle, Condition(function Trig_TRReturnAndRecycle_Conditions))
    call TriggerAddAction(gg_trg_TRReturnAndRecycle, function Trig_TRReturnAndRecycle_Actions)
endfunction

