endfunction

function Trig_GenericCinematicSetUp_Func017002 takes nothing returns nothing
    call SetItemVisibleBJ(false, GetEnumItem())
endfunction

function Trig_GenericCinematicSetUp_Actions takes nothing returns nothing
    // //
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_GenericCinematicSetUp_Func008002)
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
    set udg_Var_PlayerCamera=GetCurrentCameraSetup()
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, true)
    // //
    call SuspendHeroXPBJ(false, udg_Hero_Zuluhed)
    call SuspendHeroXPBJ(false, udg_Hero_Rend)
    call SuspendHeroXPBJ(false, udg_Hero_Maim)
    call EnumItemsInRectBJ(GetPlayableMapRect(), function Trig_GenericCinematicSetUp_Func017002)
endfunction

