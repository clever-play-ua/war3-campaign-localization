//===========================================================================
// Trigger: AI P5 Oil
//===========================================================================
function Trig_AI_P5_Oil_Func007A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P05OilRigs)
endfunction

function Trig_AI_P5_Oil_Func019C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P5_Oil_Actions takes nothing returns nothing
    local integer p05OilRigs
    // //
    call GroupClear(udg_Group_P05OilRigs)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_TwilightHammerNaval, 'u600'), function Trig_AI_P5_Oil_Func007A)
    // //
    set p05OilRigs=CountUnitsInGroup(udg_Group_P05OilRigs)
    // //
    if (OilHarvest__playerOil[GetPlayerId((Player(4)))]) < 700 and p05OilRigs == 0 then // INLINED!!
    call PauseTimerBJ(true, udg_Timer_P05Oil)
    call ConditionalTriggerExecute(gg_trg_AI_P5_Command_Stop_Attack_User)
    // //
    call DisableTrigger(gg_trg_P05OilSpentForDestroyer)
    call DisableTrigger(gg_trg_P05OilSpentForJuggernaurt)
    call DisableTrigger(gg_trg_P05OilSpentForTurtle)
    // //
    if ( Trig_AI_P5_Oil_Func019C() ) then
        call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3550")
    else
    endif
    endif
    // //
    call GroupClear(udg_Group_P05OilRigs)
endfunction

