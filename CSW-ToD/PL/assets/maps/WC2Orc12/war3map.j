function Trig_Maim_I_Rampage_Actions takes nothing returns nothing
    // Sound: Ability_Rampage
    call PlaySoundOnUnitBJ(gg_snd_Ability_Rampage, 30.00, GetSpellTargetUnit())
    // Maim_Rampage_Damage
    // (Level of Rampage (Maim) for (Triggering unit)) Equal to ...
    if ( Trig_Maim_I_Rampage_Func007C() ) then
        set udg_Maim_Rampage_Damage=15.00
    else
        if ( Trig_Maim_I_Rampage_Func007Func001C() ) then
            set udg_Maim_Rampage_Damage=25.00
        else
            if ( Trig_Maim_I_Rampage_Func007Func001Func001C() ) then
                set udg_Maim_Rampage_Damage=40.00
            else
            endif
        endif
    endif
    // Maim_Rampage_Heal
    // (Level of Bloodthirst (Maim) for (Triggering unit)) Equal to ...
    if ( Trig_Maim_I_Rampage_Func010C() ) then
        set udg_Maim_Rampage_Heal=0.20
    else
        if ( Trig_Maim_I_Rampage_Func010Func001C() ) then
            set udg_Maim_Rampage_Heal=0.30
        else
            if ( Trig_Maim_I_Rampage_Func010Func001Func001C() ) then
                set udg_Maim_Rampage_Heal=0.40
            else
            endif
        endif
    endif
    // Maim_Recklessness_Bonus
    // ((Triggering unit) has buff Recjlessness (Maim)) Equal to True
    if ( Trig_Maim_I_Rampage_Func013C() ) then
        set udg_Maim_Recklessness_Bonus=1.50
    else
        set udg_Maim_Recklessness_Bonus=1.00
    endif
    //  
    // Executing Spell
    //  
    //  
    if ( Trig_Maim_I_Rampage_Func018C() ) then
        call UnitDamageTargetBJ(GetTriggerUnit(), GetSpellTargetUnit(), ( ( ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true)) + GetRandomReal(10.00, 20.00) ) + udg_Maim_Rampage_Damage ) * udg_Maim_Recklessness_Bonus ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
        call AddSpecialEffectTargetUnitBJ("chest", GetSpellTargetUnit(), "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        // (Level of Bloodthirst (Maim) for (Triggering unit)) Greater than 0
        // ((Target unit of ability being cast) has buff Maim (Maim)) Equal to True
        if ( Trig_Maim_I_Rampage_Func018Func006C() ) then
            call SetUnitLifeBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( ( ( ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true)) + GetRandomReal(10.00, 20.00) ) + udg_Maim_Rampage_Damage ) * udg_Maim_Recklessness_Bonus ) * udg_Maim_Rampage_Heal ) ))
            call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
        else
        endif
    else
    endif
    call TriggerSleepAction(0.25)
    if ( Trig_Maim_I_Rampage_Func020C() ) then
        call UnitDamageTargetBJ(GetTriggerUnit(), GetSpellTargetUnit(), ( ( ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true)) + GetRandomReal(10.00, 20.00) ) + udg_Maim_Rampage_Damage ) * udg_Maim_Recklessness_Bonus ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
        call AddSpecialEffectTargetUnitBJ("chest", GetSpellTargetUnit(), "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        // (Level of Bloodthirst (Maim) for (Triggering unit)) Greater than 0
        // ((Target unit of ability being cast) has buff Maim (Maim)) Equal to True
        if ( Trig_Maim_I_Rampage_Func020Func006C() ) then
            call SetUnitLifeBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( ( ( ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true)) + GetRandomReal(10.00, 20.00) ) + udg_Maim_Rampage_Damage ) * udg_Maim_Recklessness_Bonus ) * udg_Maim_Rampage_Heal ) ))
            call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
        else
        endif
    else
    endif
    call TriggerSleepAction(0.25)
    if ( Trig_Maim_I_Rampage_Func022C() ) then
        call UnitDamageTargetBJ(GetTriggerUnit(), GetSpellTargetUnit(), ( ( ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true)) + GetRandomReal(10.00, 20.00) ) + udg_Maim_Rampage_Damage ) * udg_Maim_Recklessness_Bonus ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
        call AddSpecialEffectTargetUnitBJ("chest", GetSpellTargetUnit(), "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        // (Level of Bloodthirst (Maim) for (Triggering unit)) Greater than 0
        // ((Target unit of ability being cast) has buff Maim (Maim)) Equal to True
        if ( Trig_Maim_I_Rampage_Func022Func006C() ) then
            call SetUnitLifeBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( ( ( ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true)) + GetRandomReal(10.00, 20.00) ) + udg_Maim_Rampage_Damage ) * udg_Maim_Recklessness_Bonus ) * udg_Maim_Rampage_Heal ) ))
            call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
        else
        endif
    else
    endif
    call TriggerSleepAction(0.30)
    if ( Trig_Maim_I_Rampage_Func024C() ) then
        call UnitDamageTargetBJ(GetTriggerUnit(), GetSpellTargetUnit(), ( ( ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true)) + GetRandomReal(10.00, 20.00) ) + udg_Maim_Rampage_Damage ) * udg_Maim_Recklessness_Bonus ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
        call AddSpecialEffectTargetUnitBJ("chest", GetSpellTargetUnit(), "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        // (Level of Bloodthirst (Maim) for (Triggering unit)) Greater than 0
        // ((Target unit of ability being cast) has buff Maim (Maim)) Equal to True
        if ( Trig_Maim_I_Rampage_Func024Func006C() ) then
            call SetUnitLifeBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( ( ( ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetTriggerUnit(), true)) + GetRandomReal(10.00, 20.00) ) + udg_Maim_Rampage_Damage ) * udg_Maim_Recklessness_Bonus ) * udg_Maim_Rampage_Heal ) ))
            call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
        else
        endif
    else
    endif
endfunction

