function Trig_Warlock_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    set udg_Bool_InCinematic=true
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call PlaySoundFromOffsetBJ(gg_snd_Demonic_Theme_2, 100.00, 5.50)
    call PlaySoundFromOffsetBJ(gg_snd_Demonic_Theme_201, 100.00, 5.50)
    call EnableDawnDusk(false)
    // Set Up Scene
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Warlock_Setup)
    call TriggerSleepAction(0.50)
    call CameraSetupApplyForPlayer(true, gg_cam_ToS_Demon_1, udg_Player_Actual, 0)
    // Fade In
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call EnableTrigger(gg_trg_Warlock_Skipped)
    call SetDestructableAnimationBJ(gg_dest_DMAG_7423, "death")
    call SetDestructableAnimationBJ(gg_dest_DMAG_7422, "death")
    call SetDestructableAnimationBJ(gg_dest_DMAG_2172, "death")
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    //  
    // ToS Classic Remastered
    //  
    // Doomgoard Awaken
    //  
    call SetUnitBlendTimeBJ(udg_Unit_CinematicDaemon, 0.00)
    call SetUnitAnimation(udg_Unit_CinematicDaemon, "spell one")
    call TriggerSleepAction(0.70)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_DoomguardGrowl2)
    //  
    call TriggerSleepAction(2.80)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Gate Start to Open
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 3.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0.00, 0.00, 0.00, 50.00)
    call CameraSetFocalDistance(150.00)
    call PlaySoundBJ(gg_snd_ToSGateOpen)
    call CameraSetupApplyForPlayer(true, gg_cam_ToS_Gate_1, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_ToS_Gate_2, udg_Player_Actual, 15.00)
    call SetDestructableAnimationBJ(gg_dest_B007_7491, "Stand Ready")
    call SetUnitAnimation(udg_Unit_CinematicDaemon, "stand ready")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetDoodadAnimationRectBJ("Death Cinematic", 'D015', gg_rct_TomBGate)
    call TriggerSleepAction(2.50)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Demon Shadow
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 3.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0.00, 0.00, 0.00, 50.00)
    call CameraSetFocalDistance(0.00)
    call SetSoundVolumeBJ(gg_snd_ToSGateOpen, 50.00)
    call PlaySoundBJ(gg_snd_DoomguardGrowl1)
    call CameraSetupApplyForPlayer(true, gg_cam_ToS_Demon_2, udg_Player_Actual, 0)
    call SetUnitAnimation(udg_Unit_CinematicDaemon, "spell two")
    call TriggerSleepAction(4.50)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Gate Open Fully
    //  
    call CameraSetFocalDistance(150.00)
    call SetSoundVolumeBJ(gg_snd_ToSGateOpen, 100.00)
    call SetTerrainFogExBJ(0, 200.00, 3000.00, 0, 84.00, 60.00, 26.00)
    call CameraSetupApplyForPlayer(true, gg_cam_ToS_Gate_1, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_ToS_Gate_2, udg_Player_Actual, 15.00)
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Demon Final
    //  
    call CameraSetFocalDistance(0.00)
    call PlaySoundBJ(gg_snd_DoomguardGrowl1)
    call SetTerrainFogExBJ(0, 1500.00, 3000.00, 0, 84.00, 60.00, 26.00)
    call CameraSetupApplyForPlayer(true, gg_cam_ToS_Demon_2, Player(0), 0)
    call SetUnitAnimation(udg_Unit_CinematicDaemon, "stand")
    call TriggerSleepAction(3.00)
    call PlaySoundBJ(gg_snd_DoomguardRoar)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitTimeScalePercent(udg_Unit_CinematicDaemon, 33.00)
    call SetUnitAnimation(udg_Unit_CinematicDaemon, "spell three")
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 0.50)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    //  
    // Gul'dan 1
    //  
    call SetUnitFacingToFaceUnitTimed(udg_FakeChogall, udg_FakeGuldan, 0.20)
    call EnableDawnDusk(true)
    call CameraSetupApplyForPlayer(true, gg_cam_ToS_Guldan_1, udg_Player_Actual, 0)
    call CameraSetFocalDistance(125.00)
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinWarlockSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call PlaySoundFromOffsetBJ(gg_snd_Demonic_Theme_201, 25.00, 5.50)
