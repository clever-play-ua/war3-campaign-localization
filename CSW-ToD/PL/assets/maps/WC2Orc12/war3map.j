//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func020C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    call QueuedTriggerRemoveBJ(gg_trg_Victory_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call TriggerSleepAction(1.00)
    // //
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    // //
    call ShowUnitShow(udg_Hero_Rend)
    call PauseUnitBJ(false, udg_Hero_Rend)
    // //
    call ShowUnitShow(udg_Hero_Maim)
    call PauseUnitBJ(false, udg_Hero_Maim)
    // //
    call StoreUnitBJ(udg_Hero_Maim, "Maim", "WC2Orc12", udg_Cache)
    // //
    call StoreUnitBJ(udg_Hero_Rend, "Rend", "WC2Orc12", udg_Cache)
    // //
    call StoreUnitBJ(udg_Hero_Zuluhed, "Zuluhed", "WC2Orc12", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func020C() ) then
        call ShowUnitShow(udg_SemiHero_Utok)
        call PauseUnitBJ(false, udg_SemiHero_Utok)
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc12", udg_Cache)
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_Intro_Utok_Start), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc12", udg_Cache)
    endif
    // //
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', udg_Player_Actual), "UtokLevel", "WC2Orc12", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc12", udg_Cache)
    // //
    call SaveGameCacheBJ(udg_Cache)
    // //
    call TriggerSleepAction(0.10)
    // //
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ShowCustomCampaignButton(true, 20)
    call SetNextLevelBJ("WC2Orc13.w3x")
    call CustomVictoryBJ(udg_Player_Actual, true, true)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

