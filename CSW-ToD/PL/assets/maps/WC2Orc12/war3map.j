    call TriggerAddCondition(gg_trg_Boss_Victory, Condition(function Trig_Boss_Victory_Conditions))
    call TriggerAddAction(gg_trg_Boss_Victory, function Trig_Boss_Victory_Actions)
endfunction

//===========================================================================
// Trigger: Boss Earth Shield
//===========================================================================
function Trig_Boss_Earth_Shield_Func002C takes nothing returns boolean
    if ( ( udg_Boss_Phase1 == true ) ) then
        return true
    endif
    if ( ( udg_Boss_Phase2 == true ) ) then
        return true
    endif
    if ( ( udg_Boss_Phase3 == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Boss_Earth_Shield_Conditions takes nothing returns boolean
    if ( not Trig_Boss_Earth_Shield_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Earth_Shield_Func001C takes nothing returns boolean
    if ( not ( udg_Bool_DebugBFOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Earth_Shield_Func003C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_Hero_Rend) < 15.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Earth_Shield_Func004C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(udg_Hero_Maim) < 15.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Earth_Shield_Actions takes nothing returns nothing
    if ( Trig_Boss_Earth_Shield_Func001C() ) then
        call DisableTrigger(GetTriggeringTrigger())
    else
    endif
    if ( Trig_Boss_Earth_Shield_Func003C() ) then
        call IssueTargetOrderBJ(udg_Boss_Zuluhed, "innerfire", udg_Hero_Rend)
        call SetUnitLifeBJ(udg_Hero_Rend, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Rend) + 500.00 ))
        call AddSpecialEffectLocBJ(GetUnitLoc(udg_Hero_Rend), "Abilities\\Spells\\Orc\\HealingWave\\HealingWaveTarget.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    if ( Trig_Boss_Earth_Shield_Func004C() ) then
        call IssueTargetOrderBJ(udg_Boss_Zuluhed, "innerfire", udg_Hero_Maim)
        call SetUnitLifeBJ(udg_Hero_Maim, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Maim) + 500.00 ))
        call AddSpecialEffectLocBJ(GetUnitLoc(udg_Hero_Maim), "Abilities\\Spells\\Orc\\HealingWave\\HealingWaveTarget.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
endfunction

