//===========================================================================
// Trigger: Quest Artifact CompletedQ
//===========================================================================
function Trig_Quest_Artifact_CompletedQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Ensure that the quest exists
    call ConditionalTriggerExecute(gg_trg_Quest_Find_Artifact_Create)
    // Update the quest
    call QuestSetDiscoveredBJ(udg_OQShadowCouncill, true)
    call QuestItemSetCompletedBJ(udg_QReq_ShadowCouncillKill, true)
    call QuestItemSetCompletedBJ(udg_QReq_ShadowCouncillBookReturn, true)
    call QuestSetCompletedBJ(udg_OQShadowCouncill, true)
    // Remove Exclamation Point above Quest Giver
    call DestroyEffectBJ(udg_SE_ExclamationPoint)
    // Display a quest message.
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_303")
    // Remove Dark Empowerment
    call RemoveUnit(udg_Unit_DummyDarkEmpowerment[1])
    call DestroyMinimapIcon(udg_MinimapIcon_QuestDrakThul)
    // ----
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerAddBJ(gg_trg_UtokLevelUp, true)
    // ----
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_Hermit_Cinematic_2_Q, true)
endfunction

