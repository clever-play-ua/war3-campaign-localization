    call QueuedTriggerAddBJ(gg_trg_VORendFoundCultistsQ, true)
    call ShowUnitShow(gg_unit_u001_0234)
    call ShowUnitShow(gg_unit_u001_0009)
    call ShowUnitShow(gg_unit_u001_0026)
    call ForGroupBJ(udg_Group_RitualIsland, function Trig_QuestFind_Artifact_Unhide_Warlocks_Func011002)
    call ForGroupBJ(udg_Group_RitualIsland, function Trig_QuestFind_Artifact_Unhide_Warlocks_Func012002)
    call PauseUnitBJ(true, udg_Unit_BlackrockTraitor)
endfunction

