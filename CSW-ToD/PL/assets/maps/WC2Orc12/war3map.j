//===========================================================================
function Trig_P07LandingOrderReactToDamage_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(BlzGetEventDamageTarget()) == 'o9Zw' ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(BlzGetEventDamageTarget(), udg_DepartedTransports[7]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07LandingOrderReactToDamage_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P07LandingOrderReactToDamage_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    if ( Trig_P07LandingOrderReactToDamage_Func003C() ) then
        call BJDebugMsg("Transportowiec Łupieżców Burzy jest atakowany!")
    else
    endif
    // //
    set udg_MarineLandingPoint[7]=Location(udg_AttackOrderPointerX[7], udg_AttackOrderPointerY[7])
    call IssuePointOrderLocBJ(BlzGetEventDamageTarget(), "unloadall", udg_MarineLandingPoint[7])
    call RemoveLocation(udg_MarineLandingPoint[7])
    // //
    call PolledWait(1.00)
    call EnableTrigger(GetTriggeringTrigger())
endfunction

