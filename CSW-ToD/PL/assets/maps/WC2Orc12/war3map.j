    call TriggerRegisterDestDeathInRegionEvent(gg_trg_Ritual_Chance, gg_rct_CagesSpawn02)
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_Ritual_Chance, gg_rct_CagesSpawn03)
