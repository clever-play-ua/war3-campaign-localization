    endif
    if ( ( GetUnitTypeId(GetOrderedUnit()) == 'oCaM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetOrderedUnit()) == 'oOMa' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetOrderedUnit()) == 'oOmM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetOrderedUnit()) == 'o9Zx' ) ) then
        return true
    endif
    return false
endfunction

