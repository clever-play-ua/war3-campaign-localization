        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_2_CC_Heroes_Func007A takes nothing returns nothing
    if ( Trig_Boss_Phase_2_CC_Heroes_Func007Func001C() ) then
        call IssueTargetOrderBJ(udg_Boss_U_Stun, "entanglingroots", GetEnumUnit())
    else
    endif
    if ( Trig_Boss_Phase_2_CC_Heroes_Func007Func002C() ) then
        call IssueTargetOrderBJ(udg_Boss_U_Stun, "entanglingroots", GetEnumUnit())
    else
    endif
endfunction

function Trig_Boss_Phase_2_CC_Heroes_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CreateNUnitsAtLoc(1, 'u005', udg_Player_TwilightHammer, GetUnitLoc(udg_Boss_ChoGall), bj_UNIT_FACING)
    set udg_Boss_U_Stun=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_Boss_U_Stun)
    call UnitAddAbilityBJ('ACB3', udg_Boss_U_Stun)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Boss_Phase_2_CC_Heroes_Func007A)
endfunction

