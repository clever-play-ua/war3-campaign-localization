// Trigger: Quest Locate Guldan Create
//===========================================================================
function Trig_Quest_Locate_Guldan_Create_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Quest_Locate_Guldan_Create_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Create the quest objects
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_292", "TRIGSTR_293", "ReplaceableTextures\\CommandButtons\\BTNGuldan.blp")
    set udg_MQLocateGuldan=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQLocateGuldan, "TRIGSTR_294")
    set udg_QReq_LocateGuldan=GetLastCreatedQuestItemBJ()
endfunction

//===========================================================================
