//===========================================================================
function Trig_Boss_Phase_3_Twilight_Conditions takes nothing returns boolean
    if ( not ( udg_Boss_Phase3 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_3_Twilight_Func015C takes nothing returns boolean
    if ( not ( udg_Boss_Phase3 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_3_Twilight_Func018Func009001003 takes nothing returns boolean
    return ( IsUnitAlly(GetFilterUnit(), udg_Player_Actual) == true )
endfunction

function Trig_Boss_Phase_3_Twilight_Func018Func009A takes nothing returns nothing
    call SetUnitLifeBJ(GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) - udg_Boss_Twilight_Damage ))
endfunction

function Trig_Boss_Phase_3_Twilight_Func018C takes nothing returns boolean
    if ( not ( udg_Boss_Phase3 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_3_Twilight_Actions takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_ChoGall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call IssueImmediateOrderBJ(udg_Boss_ChoGall, "stop")
    call BlzUnitInterruptAttack(udg_Boss_ChoGall)
    call SetUnitTimeScalePercent(udg_Boss_ChoGall, 8.00)
    call SetUnitAnimation(udg_Boss_ChoGall, "attack slam")
    //  
    set udg_Boss_Phase3_TP_Twilight=GetUnitLoc(udg_Boss_ChoGall)
    call AddSpecialEffectLocBJ(udg_Boss_Phase3_TP_Twilight, "CSW\\Doodads\\Cinematic\\ToS\\BossArea.mdx")
    set udg_Boss_Phase3_Effect_Twilight=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale(udg_Boss_Phase3_Effect_Twilight, 11.00)
    call BlzSetSpecialEffectColor(udg_Boss_Phase3_Effect_Twilight, 150, 50, 255)
    call BlzSetSpecialEffectTimeScale(udg_Boss_Phase3_Effect_Twilight, 0.50)
    //  
    call PolledWait(2.50)
    if ( Trig_Boss_Phase_3_Twilight_Func015C() ) then
        call ConditionalTriggerExecute(gg_trg_Boss_Phase_3_Rune)
    else
    endif
    call PolledWait(2.20)
    //  
    if ( Trig_Boss_Phase_3_Twilight_Func018C() ) then
        call SetUnitTimeScalePercent(udg_Boss_ChoGall, 75.00)
        call AddSpecialEffectLocBJ(udg_Boss_Phase3_TP_Twilight, "CSW\\Abilities\\Spells\\Orc\\ChogallSpells\\VoidStorm.mdx")
        set udg_Boss_Phase3_Effect_Twilight2=GetLastCreatedEffectBJ()
        call BlzSetSpecialEffectScale(udg_Boss_Phase3_Effect_Twilight2, 2.50)
        call BlzSetSpecialEffectTimeScale(udg_Boss_Phase3_Effect_Twilight2, 0.50)
        call DestroyEffectBJ(udg_Boss_Phase3_Effect_Twilight2)
        //  
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(700.00, udg_Boss_Phase3_TP_Twilight, Condition(function Trig_Boss_Phase_3_Twilight_Func018Func009001003)), function Trig_Boss_Phase_3_Twilight_Func018Func009A)
        //  
        call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_ChoGall, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
        call DestroyEffectBJ(udg_Boss_Phase3_Effect_Twilight)
        call RemoveLocation(udg_Boss_Phase3_TP_Twilight)
    else
    endif
endfunction

