//===========================================================================
// Trigger: P07TransportationConfig
//===========================================================================
function Trig_P07TransportationConfig_Actions takes nothing returns nothing
    // //
    // //
    set udg_IdleTransports[7]=CreateGroup()
    set udg_IdleMarines[7]=CreateGroup()
    set udg_QueuedTransports[7]=CreateGroup()
    set udg_DepartedTransports[7]=CreateGroup()
    set udg_QueuedMarines[7]=CreateGroup()
    set udg_QueuedMarinesAdditional[7]=CreateGroup()
    set udg_DestinationDetectionGroup[7]=CreateGroup()
    // //
    set udg_LandingWarfareManipulator[7]=gg_trg_P07PlayerMarineLandingOrder
    // //
    set udg_BoardingOrderTimerPeriod[7]=2.00
    set udg_BoardingOrderTimerInterval[7]=8.00
    // //
    set udg_DepartureDetectionRange=128.00
    // //
    set udg_AttackPointDetectionRange=384.00
    set udg_AdditionalDetectionRange=896.00
    set udg_DestinationDetectionRange=128.00
    // //
    // //
    call StartTimerBJ(udg_BoardingOrderTimer[7], true, udg_BoardingOrderTimerPeriod[7])
    // //
    set udg_TransportationSystemsPrimed=true
    // //
    // debug new
    set udg_MarineAttackPoint[7]=Location(0, 0)
    set udg_MarineLandingPoint[7]=Location(0, 0)
endfunction

