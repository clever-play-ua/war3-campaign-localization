function Trig_Victory_Cinematic_Q_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_InCinematic == false ) ) then
        return false
    endif
    return true
endfunction

