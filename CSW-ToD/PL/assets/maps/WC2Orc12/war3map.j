function Trig_P04TransportationConfig_Actions takes nothing returns nothing
    // //
    // //
    set udg_IdleTransports[4]=CreateGroup()
    set udg_IdleMarines[4]=CreateGroup()
    set udg_QueuedTransports[4]=CreateGroup()
    set udg_DepartedTransports[4]=CreateGroup()
    set udg_QueuedMarines[4]=CreateGroup()
    set udg_QueuedMarinesAdditional[4]=CreateGroup()
    set udg_DestinationDetectionGroup[4]=CreateGroup()
    // //
    set udg_LandingWarfareManipulator[4]=gg_trg_P04PlayerMarineLandingOrder
    // //
    set udg_BoardingOrderTimerPeriod[4]=2.00
    set udg_BoardingOrderTimerInterval[4]=8.00
    // //
    set udg_DepartureDetectionRange=128.00
    // //
    set udg_AttackPointDetectionRange=384.00
    set udg_AdditionalDetectionRange=896.00
    set udg_DestinationDetectionRange=128.00
    // //
    // //
    call StartTimerBJ(udg_BoardingOrderTimer[4], true, udg_BoardingOrderTimerPeriod[4])
    // //
    set udg_TransportationSystemsPrimed=true
    // //
endfunction

//===========================================================================
