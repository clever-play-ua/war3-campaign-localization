    if ( not ( udg_Boss_Phase1_Chance_Orbs == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Phase_1_Orbs_Actions takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Boss_Zuluhed, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
    set udg_Boss_Phase1_Chance_Orbs=GetRandomInt(1, 3)
    if ( Trig_Boss_Phase_1_Orbs_Func003C() ) then
        call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Orb_NW)
        call PolledWait(15.00)
        if ( Trig_Boss_Phase_1_Orbs_Func003Func005C() ) then
            call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Orb_NE)
            call PolledWait(15.00)
            if ( Trig_Boss_Phase_1_Orbs_Func003Func005Func003C() ) then
                call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Orb_S)
            else
            endif
        else
        endif
    else
        if ( Trig_Boss_Phase_1_Orbs_Func003Func001C() ) then
            call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Orb_NE)
            call PolledWait(15.00)
            if ( Trig_Boss_Phase_1_Orbs_Func003Func001Func005C() ) then
                call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Orb_S)
                call PolledWait(15.00)
                if ( Trig_Boss_Phase_1_Orbs_Func003Func001Func005Func003C() ) then
                    call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Orb_NW)
                else
                endif
            else
            endif
        else
            if ( Trig_Boss_Phase_1_Orbs_Func003Func001Func001C() ) then
                call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Orb_S)
                call PolledWait(15.00)
                if ( Trig_Boss_Phase_1_Orbs_Func003Func001Func001Func004C() ) then
                    call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Orb_NW)
                    call PolledWait(15.00)
                    if ( Trig_Boss_Phase_1_Orbs_Func003Func001Func001Func004Func003C() ) then
                        call ConditionalTriggerExecute(gg_trg_Boss_Phase_1_Orb_NE)
                    else
                    endif
                else
                endif
            else
            endif
        endif
    endif
endfunction

