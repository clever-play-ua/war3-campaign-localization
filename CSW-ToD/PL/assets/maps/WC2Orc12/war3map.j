    call SetCameraBounds(- 7040.0 + GetCameraMargin(CAMERA_MARGIN_LEFT), - 11520.0 + GetCameraMargin(CAMERA_MARGIN_BOTTOM), 5376.0 - GetCameraMargin(CAMERA_MARGIN_RIGHT), 10496.0 - GetCameraMargin(CAMERA_MARGIN_TOP), - 7040.0 + GetCameraMargin(CAMERA_MARGIN_LEFT), 10496.0 - GetCameraMargin(CAMERA_MARGIN_TOP), 5376.0 - GetCameraMargin(CAMERA_MARGIN_RIGHT), - 11520.0 + GetCameraMargin(CAMERA_MARGIN_BOTTOM))
