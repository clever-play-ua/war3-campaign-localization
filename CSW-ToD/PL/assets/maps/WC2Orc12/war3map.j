endfunction

function Trig_AI_P8_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_PlayerSRNavalDefeatCond)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_StormReaverNaval, Condition(function Trig_AI_P8_Defeated_Func005001002)), function Trig_AI_P8_Defeated_Func005A)
    // //
    if ( Trig_AI_P8_Defeated_Func007C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_AI_P8_Gold)
        call DisableTrigger(gg_trg_AI_P8_Lumber)
        call ConditionalTriggerExecute(gg_trg_AI_P8_Command_Stop_Attack_User)
        call ConditionalTriggerExecute(gg_trg_AI_P8_Command_Defeat)
    else
    endif
    // //
    call GroupClear(udg_Group_PlayerSRNavalDefeatCond)
    // //
endfunction

