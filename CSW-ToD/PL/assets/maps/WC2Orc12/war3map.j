function Trig_Victory_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_InCinematic=true
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call TriggerSleepAction(0.50)
    call ConditionalTriggerExecute(gg_trg_Victory_Setup)
    call TriggerSleepAction(0.25)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_Camera_Bounds_Gameplay)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call StopSoundBJ(gg_snd_ACT_IV_BossThemePhase3, true)
    call StopSoundBJ(gg_snd_ACT_IV_BossThemePhase301, true)
    call PlaySoundBJ(gg_snd_Horde_Intro_Theme_2)
    call SetSoundVolumeBJ(gg_snd_Horde_Intro_Theme_2, 100)
    // Set Up Scene
    call SetDestructableAnimationBJ(gg_dest_DMAG_7423, "death")
    call SetDestructableAnimationBJ(gg_dest_DMAG_7422, "death")
    call SetDestructableAnimationBJ(gg_dest_DMAG_2172, "death")
    //  
    // Fade In
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.25, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call EnableTrigger(gg_trg_Victory_Skipped)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    //  
    // Rend Slash
    //  
    call SetUnitAnimation(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "spell channel")
    call SetUnitTimeScalePercent(udg_FakeUtok, 25.00)
    //  
    call CameraSetFocalDistance(100.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Rend_1, udg_Player_Actual, 0)
    call SetUnitAnimation(udg_FakeRend, "attack")
    call QueueUnitAnimationBJ(udg_FakeRend, "stand ready")
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call PlaySoundBJ(gg_snd_MetalHeavyChopFlesh3)
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 3)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.25, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 50.00, 0, 5.00, 0)
    //  
    // Maim Slash
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Maim_1, udg_Player_Actual, 0)
    call SetUnitAnimation(udg_FakeMaim, "attack")
    call QueueUnitAnimationBJ(udg_FakeMaim, "stand ready")
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call PlaySoundBJ(gg_snd_MetalHeavySliceFlesh3)
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 3)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.25, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 50.00, 0, 5.00, 0)
    //  
    // Cho Gall "Death"
    //  
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Chogall_1_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Chogall_1_b, udg_Player_Actual, 5.00)
    call SetUnitAnimation(udg_FakeChogall, "death")
    call SetUnitTimeScalePercent(udg_FakeChogall, 20.00)
    call AddSpecialEffectTargetUnitBJ("chest", udg_FakeChogall, "Objects\\Spawnmodels\\Orc\\Orcblood\\OrdBloodWyvernRider.mdl")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 1.50)
    call BlzSetSpecialEffectTimeScale(GetLastCreatedEffectBJ(), 0.75)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call TriggerSleepAction(2.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Void Stuff Disappears
    //  
    call SetTerrainFogExBJ(0, 200.00, 3000.00, 0.00, 5.00, 0.00, 35.00)
    call PlaySoundBJ(gg_snd_OldGodDeath1)
    call SetSoundVolumeBJ(gg_snd_OldGodDeath1, 100)
    call CameraSetFocalDistance(200.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Void_3_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Void_3_b, udg_Player_Actual, 10.00)
    call CameraSetTargetNoiseForPlayer(udg_Player_Actual, 4.00, 0.1)
    call EnumDestructablesInRectAll(gg_rct_Boss_Battle_Area, function Trig_Victory_Cinematic_Q_Func104A)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 3.00, "ReplaceableTextures\\CameraMasks\\DreamFilter_Mask.blp", 50.00, 0, 100.00, 0)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Void_2_a, udg_Player_Actual, 0)
    call CameraSetTargetNoiseForPlayer(udg_Player_Actual, 4.00, 0.1)
    call EnumDestructablesInRectAll(gg_rct_Boss_Battle_Area, function Trig_Victory_Cinematic_Q_Func111A)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 3.00, "ReplaceableTextures\\CameraMasks\\DreamFilter_Mask.blp", 50.00, 0, 100.00, 0)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Void_1_a, udg_Player_Actual, 0)
    call CameraSetTargetNoiseForPlayer(udg_Player_Actual, 4.00, 0.1)
    call EnumDestructablesInRectAll(gg_rct_Boss_Battle_Area, function Trig_Victory_Cinematic_Q_Func118A)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 3.00, "ReplaceableTextures\\CameraMasks\\DreamFilter_Mask.blp", 50.00, 0, 100.00, 0)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetTerrainFogExBJ(0, 200.00, 2000.00, 0.00, 5.00, 0.00, 35.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_Horde_Post_Battle_Theme_1)
    call SetSoundVolumeBJ(gg_snd_Horde_Intro_Theme_2, 30.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call EnumDestructablesInRectAll(gg_rct_Boss_Battle_Area, function Trig_Victory_Cinematic_Q_Func129A)
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    //  
    // Maim 4
    //  
    call CameraSetFocalDistance(150.00)
    call SetDoodadAnimationRectBJ("death", 'D014', gg_rct_Guldan_Clans)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Maim_2_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Maim_2_b, udg_Player_Actual, 8.00)
    call SetTerrainFogExBJ(0, 500.00, 3000.00, 0, 84.00, 60.00, 26.00)
    call SetSkyModel("Environment\\Sky\\VillageFallSky\\VillageFallSky.mdl")
    //  
    call ReplaceUnitBJ(udg_FakeChogall, 'OCHC', bj_UNIT_STATE_METHOD_RELATIVE)
    set udg_FakeChogall=GetLastReplacedUnitBJ()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeChogall)
    call SetUnitAnimation(udg_FakeChogall, "cinematic wounded")
    call SetUnitTimeScalePercent(udg_FakeChogall, 10.00)
    call SetUnitFacingTimed(udg_FakeChogall, 225.00, 0)
    //  
    call SetUnitBlendTimeBJ(udg_FakeMaim, 1.00)
    call SetUnitAnimation(udg_FakeMaim, "stand")
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeChogall, 45.00, 0, 90)
    call ResetUnitLookAt(udg_FakeMaim)
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeChogall, - 45.00, 0, 0.00)
    call SetUnitMoveSpeed(udg_FakeMaim, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 125.00)
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_Victory_Maim_B))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc12Maim4, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Maim4, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call QueueUnitAnimationBJ(udg_FakeMaim, "stand ready")
    //  
    // Rend 10
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Rend_2, udg_Player_Actual, 0)
    //  
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc12Rend10, bj_TIMETYPE_ADD, 0, false)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeRend)
    call SetUnitMoveSpeed(udg_FakeRend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Victory_Rend_B))
    call QueueUnitAnimationBJ(udg_FakeRend, "cinematic listening one")
    //  
    call ShowUnitShow(udg_RendWolfCinematic)
    call SetUnitAnimationWithRarity(udg_RendWolfCinematic, "stand", RARITY_RARE)
    call QueueUnitAnimationBJ(udg_RendWolfCinematic, "stand")
    call WaitForSoundBJ(gg_snd_WC2Orc12Rend10, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Zuluhed 13
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Zuluhed_1, udg_Player_Actual, 0)
    //  
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc12Zuluhed13, bj_TIMETYPE_ADD, 0, false)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic headshake one")
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.50)
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    //  
    call TriggerSleepAction(2.75)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetUnitTimeScalePercent(udg_FakeUtok, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 2.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitFacingTimed(udg_FakeZuluhed, 15.00, 1.00)
    call SetUnitAnimation(udg_FakeUtok, "cinematic injured one")
    call WaitForSoundBJ(gg_snd_WC2Orc12Zuluhed13, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Maim 5
    //  
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Maim_3, udg_Player_Actual, 0)
    //  
    call SetUnitAnimation(udg_FakeMaim, "stand")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc12Maim5, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc12Maim5, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Rend 11
    //  
    call SetUnitAnimation(udg_FakeRend, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc12Rend11, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(2.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call SetUnitAnimation(udg_FakeRend, "cinematic point one")
    call QueueUnitAnimationBJ(udg_FakeRend, "stand ready")
    call WaitForSoundBJ(gg_snd_WC2Orc12Rend11, 1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    // Ending
    //  
    call SetTerrainFogExBJ(0, 500.00, 1500.00, 0, 21.00, 34.00, 32.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Ending_1_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Victory_Ending_1_b, udg_Player_Actual, 10.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    //  
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 4.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC ENDS - Cinematic Can No Longer Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call DisableTrigger(gg_trg_Victory_Skipped)
    // Run Next Level
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

//===========================================================================
function InitTrig_Victory_Cinematic_Q takes nothing returns nothing
    set gg_trg_Victory_Cinematic_Q=CreateTrigger()
    call DisableTrigger(gg_trg_Victory_Cinematic_Q)
    call TriggerAddCondition(gg_trg_Victory_Cinematic_Q, Condition(function Trig_Victory_Cinematic_Q_Conditions))
    call TriggerAddAction(gg_trg_Victory_Cinematic_Q, function Trig_Victory_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Victory Skipped
//===========================================================================
function Trig_Victory_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinOutroSkipped=true
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

//===========================================================================
function InitTrig_Victory_Skipped takes nothing returns nothing
    set gg_trg_Victory_Skipped=CreateTrigger()
    call DisableTrigger(gg_trg_Victory_Skipped)
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Victory_Skipped, Player(0))
    call TriggerAddAction(gg_trg_Victory_Skipped, function Trig_Victory_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Rune of Blood Ogre Magi
//===========================================================================
function Trig_Rune_of_Blood_Ogre_Magi_Func002C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'XCT1' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A655' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'XW0R' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Rune_of_Blood_Ogre_Magi_Conditions takes nothing returns boolean
    if ( not Trig_Rune_of_Blood_Ogre_Magi_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_of_Blood_Ogre_Magi_Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'XCT1' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_of_Blood_Ogre_Magi_Actions takes nothing returns nothing
    if ( Trig_Rune_of_Blood_Ogre_Magi_Func001C() ) then
        set udg_TempPointRune=GetSpellTargetLoc()
        call CreateNUnitsAtLoc(1, 'u602', GetTriggerPlayer(), udg_TempPointRune, bj_UNIT_FACING)
        set udg_DummyRune=GetLastCreatedUnit()
        call UnitAddAbilityBJ('XCT2', udg_DummyRune)
        call IssuePointOrderLocBJ(udg_DummyRune, "stasistrap", udg_TempPointRune)
        call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_DummyRune)
        call RemoveLocation(udg_TempPointRune)
    else
    endif
endfunction

