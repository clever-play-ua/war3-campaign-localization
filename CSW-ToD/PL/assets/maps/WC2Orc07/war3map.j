//===========================================================================
// Trigger: Load Utok
//===========================================================================
function Trig_Load_Utok_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc06", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Utok_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Load_Utok_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Utok", "WC2Orc06", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_UtokInit), GetRectCenter(gg_rct_MaimStart))
        set udg_SemiHero_Utok=GetLastRestoredUnitBJ()
        call SetPlayerTechResearchedSwap('RUX2', GetStoredIntegerBJ("UtokLevel", "WC2Orc06", udg_Cache), Player(20))
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_UtokInit), GetRectCenter(gg_rct_MaimStart))
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call SetPlayerTechResearchedSwap('RUX2', 6, Player(20))
    endif
    call ConditionalTriggerExecute(gg_trg_UtokLevelChecker)
    call SetUnitOwner(udg_SemiHero_Utok, Player(0), true)
    call ShowUnitHide(udg_SemiHero_Utok)
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60O'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I6DX'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60P'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60Q'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60N'))
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_SemiHero_Utok, 'I60R'))
endfunction

