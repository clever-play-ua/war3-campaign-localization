    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3854")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    if ( Trig_Trollbane_Completed_Q_Func006C() ) then
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerAddBJ(gg_trg_Final_Cinematic_Q, true)
    else
    endif
endfunction

