//===========================================================================
// Trigger: AI P17 Start
//===========================================================================
function Trig_AI_P17_Start_Func006Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P17_Start_Func006C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P17_Start_Func014002 takes nothing returns nothing
    call IssueTargetOrderBJ(GetEnumUnit(), "smart", udg_Unit_Naval_OilRigArr[2])
endfunction

function Trig_AI_P17_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerStateBJ(udg_Player_StromgardeNavy, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(udg_Player_StromgardeNavy, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    // //
    if ( Trig_AI_P17_Start_Func006C() ) then
        call playerAddOil(Player(16) , 200000)
    else
        if ( Trig_AI_P17_Start_Func006Func003C() ) then
            call playerAddOil(Player(16) , 150000)
        else
            call playerAddOil(Player(16) , 100000)
        endif
    endif
    call SetPlayerStateBJ(udg_Player_StromgardeNavy, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerStateBJ(udg_Player_StromgardeNavy, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    // //
    call EnableTrigger(gg_trg_AI_P17_Gold)
    call EnableTrigger(gg_trg_AI_P17_Lumber)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_StromgardeNavy, 'h600'), function Trig_AI_P17_Start_Func014002)
    // //
    call StartCampaignAI(udg_Player_StromgardeNavy, "CSW\\Scripts\\ToDScripts\\WC2Orc07\\WC2Orc07P17AllianceNavalAI.ai")
    // //
    call StartTimerBJ(udg_Timer_P17OilChecker, true, 1.00)
endfunction

//===========================================================================
function InitTrig_AI_P17_Start takes nothing returns nothing
    set gg_trg_AI_P17_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_P17_Start, function Trig_AI_P17_Start_Actions)
endfunction

