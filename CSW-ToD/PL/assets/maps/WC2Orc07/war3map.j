    call TriggerRegisterTimerExpireEventBJ(gg_trg_Light_Rain_Begin, udg_Timer_RainLightPause)
    call TriggerAddAction(gg_trg_Light_Rain_Begin, function Trig_Light_Rain_Begin_Actions)
endfunction

