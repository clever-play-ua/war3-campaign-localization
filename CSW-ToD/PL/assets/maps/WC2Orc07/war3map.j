function InitTrig_Preparations_Defeat takes nothing returns nothing
    set gg_trg_Preparations_Defeat=CreateTrigger()
    call TriggerAddCondition(gg_trg_Preparations_Defeat, Condition(function Trig_Preparations_Defeat_Conditions))
    call TriggerAddAction(gg_trg_Preparations_Defeat, function Trig_Preparations_Defeat_Actions)
endfunction

