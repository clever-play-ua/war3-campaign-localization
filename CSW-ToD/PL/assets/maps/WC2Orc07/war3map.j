    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DefeatConditionCheck)
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func016001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o613' )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func016001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func016001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o613'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func016002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DefeatConditionCheck)
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func018C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_DefeatConditionCheck) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_DefeatConditionCheck)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_AllPlayerGroundUnitsAreDead_Func010001002)), function Trig_AllPlayerGroundUnitsAreDead_Func010002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_AllPlayerGroundUnitsAreDead_Func012001002)), function Trig_AllPlayerGroundUnitsAreDead_Func012002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_AllPlayerGroundUnitsAreDead_Func014001002)), function Trig_AllPlayerGroundUnitsAreDead_Func014002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_AllPlayerGroundUnitsAreDead_Func016001002)), function Trig_AllPlayerGroundUnitsAreDead_Func016002)
    // //
    if ( Trig_AllPlayerGroundUnitsAreDead_Func018C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_MISSIONFAILED, "TRIGSTR_3907")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call ConditionalTriggerExecute(gg_trg_MissionFailed)
    else
    endif
    // //
    call GroupClear(udg_Group_DefeatConditionCheck)
endfunction

//===========================================================================
function InitTrig_AllPlayerGroundUnitsAreDead takes nothing returns nothing
    set gg_trg_AllPlayerGroundUnitsAreDead=CreateTrigger()
    call DisableTrigger(gg_trg_AllPlayerGroundUnitsAreDead)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_AllPlayerGroundUnitsAreDead, Player(20), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AllPlayerGroundUnitsAreDead, Condition(function Trig_AllPlayerGroundUnitsAreDead_Conditions))
    call TriggerAddAction(gg_trg_AllPlayerGroundUnitsAreDead, function Trig_AllPlayerGroundUnitsAreDead_Actions)
endfunction

