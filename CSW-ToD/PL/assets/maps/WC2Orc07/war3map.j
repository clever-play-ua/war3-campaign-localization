//===========================================================================
// Trigger: AI P13 Start
//===========================================================================
function Trig_AI_P13_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_TransportationConfig)
    // //
    call SetPlayerStateBJ(udg_Player_Stromgarde, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(udg_Player_Stromgarde, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call playerAddOil(Player(12) , 100000)
    call SetPlayerStateBJ(udg_Player_Stromgarde, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerStateBJ(udg_Player_Stromgarde, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    // //
    call EnableTrigger(gg_trg_AI_P13_Gold)
    call EnableTrigger(gg_trg_AI_P13_Lumber)
    // //
    call StartCampaignAI(udg_Player_Stromgarde, "CSW\\Scripts\\ToDScripts\\WC2Orc07\\WC2Orc07P13AllianceAI.ai")
    // //
    call EnableTrigger(gg_trg_AI_P10_Transports_Availiable_Checker)
    call ConditionalTriggerExecute(gg_trg_AI_P13_Start_Attack_Command)
endfunction

//===========================================================================
function InitTrig_AI_P13_Start takes nothing returns nothing
    set gg_trg_AI_P13_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_P13_Start, function Trig_AI_P13_Start_Actions)
endfunction

