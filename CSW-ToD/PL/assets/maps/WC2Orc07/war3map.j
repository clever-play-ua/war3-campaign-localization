function Trig_KingsFlee_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_KingsFlee_Cinematic_Setup_Func005001002)), function Trig_KingsFlee_Cinematic_Setup_Func005A)
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_KingsFlee_Cinematic_Setup_Func006002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_KingsFlee_Cinematic_Setup_Func009001002)), function Trig_KingsFlee_Cinematic_Setup_Func009A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'h001'), function Trig_KingsFlee_Cinematic_Setup_Func012A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Stromgarde, Condition(function Trig_KingsFlee_Cinematic_Setup_Func015001002)), function Trig_KingsFlee_Cinematic_Setup_Func015A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Stromgarde, Condition(function Trig_KingsFlee_Cinematic_Setup_Func018001002)), function Trig_KingsFlee_Cinematic_Setup_Func018A)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_KingsFlee_Cinematic_Setup_Func020002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_KingsFlee_Cinematic_Setup_Func021002)
    // //
    call SetStackedSoundBJ(true, gg_snd_CityBattlegroundLoop, gg_rct_LiamDefaultLocation)
    call SetStackedSoundBJ(true, gg_snd_CityBattlegroundLoop, gg_rct_GateExit01)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeThoras, GetRectCenter(gg_rct_TorasDefaultLocation), GetRectCenter(gg_rct_LiamDefaultLocation))
    call SetUnitAnimationWithRarity(udg_FakeThoras, "stand", RARITY_FREQUENT)
    call ShowUnitShow(udg_FakeThoras)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeLiam, GetRectCenter(gg_rct_LiamDefaultLocation), GetRectCenter(gg_rct_TorasDefaultLocation))
    call ShowUnitShow(udg_FakeLiam)
    // //
    call CreateNUnitsAtLoc(1, 'Hlgr', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_TorasMounted), 90.00)
    set udg_Unit_TorasMounted=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TorasFleeKnights)
    // //
    call CreateNUnitsAtLoc(1, 'hKSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_TorasEscort01), 90.00)
    set udg_Unit_TorasKnightGuardArr[1]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TorasFleeKnights)
    // //
    call CreateNUnitsAtLoc(1, 'hKSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_TorasEscort02), 90.00)
    set udg_Unit_TorasKnightGuardArr[2]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TorasFleeKnights)
    // //
    call CreateNUnitsAtLoc(1, 'hKSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_TorasEscort03), 90.00)
    set udg_Unit_TorasKnightGuardArr[3]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TorasFleeKnights)
    // //
    call CreateNUnitsAtLoc(1, 'hKSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_TorasEscort04), 90.00)
    set udg_Unit_TorasKnightGuardArr[4]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TorasFleeKnights)
    // //
    // //
endfunction

