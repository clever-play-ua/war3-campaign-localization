    return true
endfunction

function Trig_AI_P17_Being_Attacked_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_AI_P17_Being_Attacked_Func004C() ) then
        call ForGroupBJ(udg_G_P17_Attacker, function Trig_AI_P17_Being_Attacked_Func004Func003A)
        call TriggerSleepAction(6.00)
        call ForGroupBJ(udg_G_P17_Attacker, function Trig_AI_P17_Being_Attacked_Func004Func005A)
    else
        if ( Trig_AI_P17_Being_Attacked_Func004Func001C() ) then
            call ForGroupBJ(udg_G_P17_Attacker, function Trig_AI_P17_Being_Attacked_Func004Func001Func001A)
            call TriggerSleepAction(6.00)
            call ForGroupBJ(udg_G_P17_Attacker, function Trig_AI_P17_Being_Attacked_Func004Func001Func003A)
        else
        endif
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction

