endfunction

function Trig_Intro_Cinematic_Q_Func172001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Setup)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroShips, udg_Player_Actual, 0.00)
    call TriggerSleepAction(0.50)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroShips02, udg_Player_Actual, 4.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call PlaySoundBJ(gg_snd_Orc2)
    // CinematicStarts
    set udg_Bool_CinIntroOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    // Show Ships start
    // //
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Show Ships end
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroGrunt01, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroGrunt02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc07Grunt1) + 1 ))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_IntroMaim02))
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_Unit_IntroGrunt, 0, 0, 90)
    // //
    call SetUnitAnimation(udg_Unit_IntroGrunt, "cinematic angry one")
    call QueueUnitAnimationBJ(udg_Unit_IntroGrunt, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_IntroGrunt, 0, gg_snd_WC2Orc07Grunt1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_IntroGrunt, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroMaim01, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic angry one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc07Maim1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroUtok01, udg_Player_Actual, 0.00)
    call ResetUnitLookAt(udg_FakeMaim)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc07Utok1, bj_TIMETYPE_ADD, 0, false)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_IntroMaim03))
    call PlaySoundBJ(gg_snd_WalkSwampLoop)
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc07Utok1) - 1 ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_WalkSwampLoop, false)
    call SetUnitAnimation(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc07Maim2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    call CameraSetupApplyForPlayer(true, gg_cam_IntroFootman01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_IntroFootman02, udg_Player_Actual, 5.00)
    call IssuePointOrderLocBJ(udg_Unit_IntroFootman02, "move", GetRectCenter(gg_rct_IntroFootman02))
    call PlaySoundBJ(gg_snd_WalkSwampLoop)
    call SetUnitFacingToFaceLocTimed(udg_Unit_IntroFootman01, GetRectCenter(gg_rct_FakeFootman01), 0.50)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Footman Talks
    // //
    call StopSoundBJ(gg_snd_WalkSwampLoop, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_IntroFootman01, 0, gg_snd_WC2Orc07Footman1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_IntroFootman03, "move", GetRectCenter(gg_rct_FakeFootman02))
    call PlaySoundBJ(gg_snd_WalkSwampLoop)
    // //
    call SetUnitFacingToFaceLocTimed(udg_Unit_IntroFootman01, GetRectCenter(gg_rct_IntroFootman02), 0.50)
    call SetUnitAnimation(udg_Unit_IntroFootman02, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_IntroFootman02, 0, gg_snd_WC2Orc07Footman2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroUtok01, udg_Player_Actual, 0)
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeMaim, 1.00)
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeUtok, 0, 0, 90)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_WalkSwampLoop, false)
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic frustrated one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc07Utok2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeMaim, GetRectCenter(gg_rct_MaimStart), GetRectCenter(gg_rct_UtokInit))
    call SetUnitPositionLocFacingLocBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokInit), GetRectCenter(gg_rct_MaimStart))
    call SetUnitPositionLocFacingLocBJ(udg_Unit_IntroGrunt, GetRectCenter(gg_rct_IntroGrunt03), GetRectCenter(gg_rct_MaimStart))
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro02, udg_Player_Actual, 10.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc07Maim3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_Unit_IntroGrunt, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic point three")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic standard one")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_Unit_IntroGrunt, "move", GetRectCenter(gg_rct_IntroGrunt04))
    call PlaySoundBJ(gg_snd_WalkSwampLoop)
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_Unit_IntroGrunt), GetRectCenter(gg_rct_IntroGrunt04)) / GetUnitMoveSpeed(udg_Unit_IntroGrunt) ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call StopSoundBJ(gg_snd_WalkSwampLoop, false)
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc07Utok3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_H01b_Orc_gesture_v2, 100, udg_Unit_IntroGrunt)
    call SetUnitAnimation(udg_Unit_IntroGrunt, "cinematic salute one")
    call TriggerSleepAction(1.90)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_IntroGrunt, "move", GetRectCenter(gg_rct_IntroMaim01))
    call PlaySoundBJ(gg_snd_WalkSwampLoop)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeMaim, 0.50)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call StopSoundBJ(gg_snd_WalkSwampLoop, true)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Q takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Q, function Trig_Intro_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Setup
//===========================================================================
function Trig_Intro_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call SetTimeOfDay(8.00)
    // //
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    // //
    call TriggerSleepAction(0.10)
    // //
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    call ShowUnitHide(udg_SemiHero_Utok)
    // //
    call PauseUnitBJ(true, udg_Hero_Maim)
    call ShowUnitHide(udg_Hero_Maim)
    // //
    // SettingActors
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_IntroUtok01), 101.71)
    call SetUnitAnimation(udg_FakeUtok, "cinematic scope one")
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_IntroMaim01), 19.50)
    // //
    // //
    set udg_Unit_IntroGrunt=gg_unit_o60G_0010
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroGrunt, GetRectCenter(gg_rct_IntroGrunt01), 221.20)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_IntroGrunt)
    call SetUnitMoveSpeed(udg_Unit_IntroGrunt, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroGrunt, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_Unit_IntroGrunt, 0.25)
    call SetUnitAnimation(udg_Unit_IntroGrunt, "cinematic listening one")
    // //
    set udg_Unit_IntroFootman01=gg_unit_hCSt_0025
    call SetUnitAnimation(udg_Unit_IntroFootman01, "cinematic stand")
    call SetUnitBlendTimeBJ(udg_Unit_IntroFootman01, 0.25)
    // //
    set udg_Unit_IntroFootman02=gg_unit_hfSt_0026
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_IntroFootman02)
    call SetUnitMoveSpeed(udg_Unit_IntroFootman02, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroFootman02, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_Unit_IntroFootman02, 0.25)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'hfSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_FakeFootman01), GetRectCenter(gg_rct_IntroFootman01))
    set udg_Unit_IntroFootman03=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_IntroFootman03)
    call SetUnitMoveSpeed(udg_Unit_IntroFootman03, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroFootman03, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_Unit_IntroFootman03, 0.25)
    // //
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Setup takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Setup, function Trig_Intro_Cinematic_Setup_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Skipped
//===========================================================================
function Trig_Intro_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Cinematic_Skipped, Player(20))
    call TriggerAddCondition(gg_trg_Intro_Cinematic_Skipped, Condition(function Trig_Intro_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_Skipped, function Trig_Intro_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Cleanup
//===========================================================================
function Trig_Intro_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func062C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinIntroOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call StopSoundBJ(gg_snd_WalkSwampLoop, false)
    call StopSoundBJ(gg_snd_WC2Orc07Maim1, false)
    call StopSoundBJ(gg_snd_WC2Orc07Maim2, false)
    call StopSoundBJ(gg_snd_WC2Orc07Maim3, false)
    call StopSoundBJ(gg_snd_WC2Orc07Utok1, false)
    call StopSoundBJ(gg_snd_WC2Orc07Utok2, false)
    call StopSoundBJ(gg_snd_WC2Orc07Utok3, false)
    call StopSoundBJ(gg_snd_WC2Orc07Grunt1, false)
    call StopSoundBJ(gg_snd_WC2Orc07Footman1, false)
    call StopSoundBJ(gg_snd_WC2Orc07Footman2, false)
    call StopSoundBJ(gg_snd_Orc2, false)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Maim, GetRectCenter(gg_rct_MaimStart), GetRectCenter(gg_rct_UtokInit))
    call ShowUnitShow(udg_Hero_Maim)
    call PauseUnitBJ(false, udg_Hero_Maim)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_UtokInit), GetRectCenter(gg_rct_MaimStart))
    call ShowUnitShow(udg_SemiHero_Utok)
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    call SetUnitOwner(udg_SemiHero_Utok, udg_Player_Actual, false)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Unit_IntroGrunt, GetRectCenter(gg_rct_IntroGrunt03), GetRectCenter(gg_rct_MaimStart))
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Unit_IntroGrunt)
    call SetUnitMoveSpeed(udg_Unit_IntroGrunt, 270.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroGrunt, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call SetUnitBlendTimeBJ(udg_Unit_IntroGrunt, 0.15)
    // //
    call ResetUnitAnimation(gg_unit_hCSt_0025)
    call ResetUnitAnimation(gg_unit_hfSt_0026)
    // //
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Unit_IntroFootman02)
    call SetUnitMoveSpeed(udg_Unit_IntroFootman02, 270.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroFootman02, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call SetUnitBlendTimeBJ(udg_Unit_IntroFootman02, 0.15)
    // //
    call RemoveUnit(udg_Unit_IntroFootman03)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 1600)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 1200)
    // //
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_GameCamera), 0)
    call TriggerSleepAction(0.10)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_Phase1CameraBounds)
    call BlzChangeMinimapTerrainTex("MinimapStromgardePhaseA.tga")
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    call ConditionalTriggerExecute(gg_trg_SetUpOilPatchCapacity)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func062C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Preparations_Discover)
    call ConditionalTriggerExecute(gg_trg_Creating_and_Setting_Weather)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call SelectUnitSingle(udg_Hero_Maim)
    // ----------------------------------------
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Cleanup, function Trig_Intro_Cinematic_Cleanup_Actions)
endfunction

