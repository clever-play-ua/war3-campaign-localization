//===========================================================================
function Trig_AllPlayerGroundUnitsAreDead_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQ_Stromgarde) == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinKingsFleeOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinDoomhammerOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func010001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o61Y' )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func010001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func010001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o61Y'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func010002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DefeatConditionCheck)
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func012001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n61V' )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func012001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func012001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'n61V'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

