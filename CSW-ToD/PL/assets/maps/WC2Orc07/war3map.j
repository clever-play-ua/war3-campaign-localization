function Trig_Stromgarde_Update_Q_Actions takes nothing returns nothing
    set udg_newLine="\n"
    call TriggerSleepAction(0.00)
    set udg_String_CompletedQuests=( StringIdentity("TRIGSTR_4187") + ( udg_newLine + StringIdentity("TRIGSTR_4188") ) )
    call TriggerSleepAction(0.00)
    if ( Trig_Stromgarde_Update_Q_Func006C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_StromDestroyBarracks, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL7_0614) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL7_0614) ) )
    endif
    if ( Trig_Stromgarde_Update_Q_Func007C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_StromDestroyStables, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL7_0614) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL7_0614) ) )
    endif
    if ( Trig_Stromgarde_Update_Q_Func008C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_StromDestroyPortTower, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL8_0615) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL8_0615) ) )
    endif
    if ( Trig_Stromgarde_Update_Q_Func009C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_StromDestroyTownHall, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL8_0615) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL8_0615) ) )
    endif
    if ( Trig_Stromgarde_Update_Q_Func010C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_StromDestroyKeep, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL9_0616) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL9_0616) ) )
    endif
    call TriggerSleepAction(0.00)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

