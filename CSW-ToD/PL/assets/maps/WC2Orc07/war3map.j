//===========================================================================
// Trigger: Preparations Defeat
//===========================================================================
function Trig_Preparations_Defeat_Conditions takes nothing returns boolean
    if ( not ( IsQuestFailed(udg_MQ_Preparations) == false ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_MQ_Preparations) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Preparations_Defeat_Func005Func001C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_Toilers) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Preparations_Defeat_Func005C takes nothing returns boolean
    if ( not ( IsUnitDeadBJ(udg_Hero_Maim) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Preparations_Defeat_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    if ( Trig_Preparations_Defeat_Func005C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_3911")
    else
        if ( Trig_Preparations_Defeat_Func005Func001C() ) then
            call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_3910")
        else
        endif
    endif
    call QuestSetFailedBJ(udg_MQ_Preparations, true)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_MissionFailed)
endfunction

