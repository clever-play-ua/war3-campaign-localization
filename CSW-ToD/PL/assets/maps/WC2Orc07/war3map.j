function InitTrig_AI_P17_Oil takes nothing returns nothing
    set gg_trg_AI_P17_Oil=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_AI_P17_Oil, udg_Timer_P17OilChecker)
    call TriggerAddAction(gg_trg_AI_P17_Oil, function Trig_AI_P17_Oil_Actions)
endfunction

