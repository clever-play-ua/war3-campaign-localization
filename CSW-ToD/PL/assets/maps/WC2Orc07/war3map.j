//===========================================================================
// Trigger: Doomhammer Cinematic Skipped
//===========================================================================
function Trig_Doomhammer_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinDoomhammerOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinematicSkipped=true
    set udg_Bool_CinDoomSkipped=true
    call ConditionalTriggerExecute(gg_trg_Doomhammer_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Doomhammer_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Doomhammer_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Doomhammer_Cinematic_Skipped, Player(20))
    call TriggerAddCondition(gg_trg_Doomhammer_Cinematic_Skipped, Condition(function Trig_Doomhammer_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Doomhammer_Cinematic_Skipped, function Trig_Doomhammer_Cinematic_Skipped_Actions)
endfunction

