    set gg_trg_OilSpentForBuildings01=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilSpentForBuildings01, Player(20), EVENT_PLAYER_UNIT_CONSTRUCT_START)
