//===========================================================================
// Trigger: CreateFakeActors
//===========================================================================
function Trig_CreateFakeActors_Actions takes nothing returns nothing
    // //
    call CreateNUnitsAtLoc(1, 'o605', udg_Player_BlackRock, udg_Point_FakeUtokSpawn, bj_UNIT_FACING)
    set udg_FakeUtok=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'OMBc', udg_Player_Actual, udg_Point_FakeMaimSpawn, bj_UNIT_FACING)
    set udg_FakeMaim=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMaim)
    call SetUnitMoveSpeed(udg_FakeMaim, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'ODCN', udg_Player_BlackRock, udg_Point_FakeOrgrimSpawn, bj_UNIT_FACING)
    set udg_FakeDoomhammer=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeDoomhammer)
    call SetUnitMoveSpeed(udg_FakeDoomhammer, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeDoomhammer, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeDoomhammer, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'HLTC', udg_Player_StromgardeCinematic, udg_Point_FakeLiamSpawn, bj_UNIT_FACING)
    set udg_FakeLiam=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeLiam)
    call SetUnitBlendTimeBJ(udg_FakeLiam, 0.25)
    call SetUnitColor(udg_FakeLiam, PLAYER_COLOR_MAROON)
    // //
    call CreateNUnitsAtLoc(1, 'HTtC', udg_Player_StromgardeCinematic, udg_Point_FakeThorasSpawn, bj_UNIT_FACING)
    set udg_FakeThoras=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeThoras)
    call SetUnitBlendTimeBJ(udg_FakeThoras, 0.25)
    call SetUnitColor(udg_FakeThoras, PLAYER_COLOR_MAROON)
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_CreateFakeActors takes nothing returns nothing
    set gg_trg_CreateFakeActors=CreateTrigger()
    call TriggerAddAction(gg_trg_CreateFakeActors, function Trig_CreateFakeActors_Actions)
endfunction

