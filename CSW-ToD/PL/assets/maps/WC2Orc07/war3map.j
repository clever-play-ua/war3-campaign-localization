//===========================================================================
function Trig_Stromgarde_Update_Barracks_Func001C takes nothing returns boolean
    if ( ( GetDyingUnit() == udg_Unit_Stromgarde_Barracks[1] ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_Unit_Stromgarde_Barracks[2] ) ) then
        return true
    endif
    return false
endfunction

function Trig_Stromgarde_Update_Barracks_Conditions takes nothing returns boolean
    if ( not Trig_Stromgarde_Update_Barracks_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Stromgarde_Update_Barracks_Func002C takes nothing returns boolean
    if ( not ( IsUnitDeadBJ(udg_Unit_Stromgarde_Barracks[1]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(udg_Unit_Stromgarde_Barracks[2]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stromgarde_Update_Barracks_Actions takes nothing returns nothing
    if ( Trig_Stromgarde_Update_Barracks_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call ConditionalTriggerExecute(gg_trg_Stromgarde_UpdateCompleted)
    else
    endif
endfunction

