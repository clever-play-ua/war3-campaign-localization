function Trig_Doomhammer_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinDoomhammerOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Doomhammer_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call StopSoundBJ(gg_snd_Orc3, false)
    call StopSoundBJ(gg_snd_OrcVictoryShouting, false)
    call StopSoundBJ(gg_snd_WC2Orc07Liam1, false)
    call StopSoundBJ(gg_snd_WC2Orc07Liam2, false)
    call StopSoundBJ(gg_snd_WC2Orc07Thoras1, false)
    call StopSoundBJ(gg_snd_WC2Orc07Thoras2, false)
    call StopSoundBJ(gg_snd_WC2Orc07Doomhammer1, false)
    call StopSoundBJ(gg_snd_WC2Orc07Doomhammer2, false)
    call StopSoundBJ(gg_snd_WC2Orc07Doomhammer3, false)
    call StopSoundBJ(gg_snd_WC2Orc07Doomhammer4, false)
    call StopSoundBJ(gg_snd_WC2Orc07Doomhammer5, false)
    call StopSoundBJ(gg_snd_WC2Orc07Doomhammer6, false)
    call StopSoundBJ(gg_snd_WC2Orc07Doomhammer7, false)
    call StopSoundBJ(gg_snd_WC2Orc07Maim4, false)
    call StopSoundBJ(gg_snd_WC2Orc07Maim5, false)
    call StopSoundBJ(gg_snd_WC2Orc07Utok_OrgrimWelcome1, false)
    call VolumeGroupResetBJ()
    // //
    call SetTerrainFogExBJ(0, 2500.00, 10500.00, 0.02, 78.00, 60.00, 7.80)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(udg_Var_PlayerCamera), 0)
    // //
    call BlzShowTerrain(true)
    // //
    call ForGroupBJ(udg_Group_CinOrcCheerers, function Trig_Doomhammer_Cinematic_Cleanup_Func029002)
    call DestroyGroup(udg_Group_CinOrcCheerers)
    // //
    call ResetUnitAnimation(gg_unit_o004_0543)
    call ResetUnitAnimation(gg_unit_o004_0544)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Doomhammer_Cinematic_Cleanup_Func035002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Doomhammer_Cinematic_Cleanup_Func036002)
    call GroupClear(udg_Group_HiddenUnits)
    // //
    call ShowUnitShow(gg_unit_hFrK_0066)
    call ShowUnitShow(gg_unit_u600_0093)
    call ShowUnitShow(gg_unit_hFrK_0065)
    call ShowUnitShow(gg_unit_hSSt_0483)
    call ShowUnitShow(gg_unit_hSSt_0484)
    call ShowUnitShow(gg_unit_h616_0150)
    call ShowUnitShow(gg_unit_n00F_0152)
    call PauseUnitBJ(false, gg_unit_h600_0038)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CannonsCinematic, Condition(function Trig_Doomhammer_Cinematic_Cleanup_Func049001002)), function Trig_Doomhammer_Cinematic_Cleanup_Func049002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_MidgameFakeShips, Condition(function Trig_Doomhammer_Cinematic_Cleanup_Func051001002)), function Trig_Doomhammer_Cinematic_Cleanup_Func051002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Cinematic_Scenery, udg_Player_StromgardeDefenders), function Trig_Doomhammer_Cinematic_Cleanup_Func053002)
    // //
    call ForGroupBJ(udg_Group_CinDoomhammerActors, function Trig_Doomhammer_Cinematic_Cleanup_Func055002)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call DisableTrigger(gg_trg_Doomhammer_Cinematic_FootmanLoop)
    call DisableTrigger(gg_trg_Doomhammer_Cinematic_SpearmanLoop)
    // //
    call RemoveLocation(udg_Point_CinOrgrimTempLoc)
    call RemoveLocation(udg_Point_CinOrgrimRotateLoc)
    call RemoveLocation(udg_Point_CinFootmanTempLoc)
    call RemoveLocation(udg_Point_CinGuardTempLoc)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Hero_ThorasTrollbane, GetRectCenter(gg_rct_TorasDefaultLocation), GetRectCenter(gg_rct_LiamDefaultLocation))
    call ShowUnitShow(udg_Hero_ThorasTrollbane)
    call PauseUnitBJ(false, udg_Hero_ThorasTrollbane)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Hero_LiamTrollbane, GetRectCenter(gg_rct_LiamDefaultLocation), GetRectCenter(gg_rct_TorasDefaultLocation))
    call ShowUnitShow(udg_Hero_LiamTrollbane)
    call PauseUnitBJ(false, udg_Hero_LiamTrollbane)
    // //
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Doomhammer_Cinematic_Cleanup_Func074A)
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Doomhammer_Cinematic_Cleanup_Func075A)
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Doomhammer_Cinematic_Cleanup_Func076A)
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Doomhammer_Cinematic_Cleanup_Func077A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_MidgameCinShipsArea, udg_Player_BlackRock), function Trig_Doomhammer_Cinematic_Cleanup_Func080A)
    // //
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0526, GetRectCenter(gg_rct_MidgameTransport01), 136.54)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0548, GetRectCenter(gg_rct_MidgameTransport02), 136.54)
    // //
    call SetUnitPositionLocFacingLocBJ(gg_unit_o004_0543, GetRectCenter(gg_rct_MidgameKorkron03), GetRectCenter(gg_rct_GoldMine))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o004_0544, GetRectCenter(gg_rct_MidgameKorkron04), GetRectCenter(gg_rct_GoldMine))
    call SetUnitPositionLocFacingLocBJ(gg_unit_n001_0121, GetRandomLocInRect(gg_rct_OgresDestination), GetRectCenter(gg_rct_GoldMine))
    call SetUnitPositionLocFacingLocBJ(gg_unit_n001_0017, GetRandomLocInRect(gg_rct_OgresDestination), GetRectCenter(gg_rct_GoldMine))
    call ShowUnitShow(gg_unit_n001_0121)
    call ShowUnitShow(gg_unit_n001_0017)
    // //
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_Doomhammer, GetRectCenter(gg_rct_MidgameOrgrim03), 112.86)
    call ShowUnitShow(udg_Hero_Doomhammer)
    call PauseUnitBJ(false, udg_Hero_Doomhammer)
    // //
    call ShowUnitShow(udg_Hero_LiamTrollbane)
    call ShowUnitShow(udg_Hero_ThorasTrollbane)
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_Doomhammer_Cinematic_Cleanup_Func100002)
    call GroupClear(udg_Group_PausedUnits)
    call CameraSetupApplyForPlayer(true, udg_Var_PlayerCamera, udg_Player_Actual, 0)
    call TriggerSleepAction(0.01)
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    call BlzChangeMinimapTerrainTex("MinimapStromgardePhaseB.tga")
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    // //
    call QueuedTriggerRemoveBJ(gg_trg_Doomhammer_Cinematic_Q)
    // //
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Doomhammer_Cinematic_Cleanup_Func115C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Doomhammer_Cinematic_Q)
    call RescueUnitBJ(udg_Hero_Doomhammer, udg_Player_Actual, false)
    call RescueUnitBJ(gg_unit_o004_0544, udg_Player_Actual, false)
    call RescueUnitBJ(gg_unit_o004_0543, udg_Player_Actual, false)
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Doomhammer_Cinematic_Cleanup_Func120002)
    call TriggerExecute(gg_trg_Stromgarde_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

