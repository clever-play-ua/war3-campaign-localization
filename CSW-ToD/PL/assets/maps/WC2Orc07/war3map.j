    set gg_trg_ForceBoardingOrder=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ForceBoardingOrder, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddCondition(gg_trg_ForceBoardingOrder, Condition(function Trig_ForceBoardingOrder_Conditions))
