//===========================================================================
// Trigger: Preparations Discover Q
//===========================================================================
function Trig_Preparations_Discover_Q_Actions takes nothing returns nothing
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_CaptureTransports), 512.00)
    set udg_VisMod_CaptureTransport=GetLastCreatedFogModifier()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_CaptureTransports), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_PrepTransport=GetLastCreatedMinimapIcon()
    call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_CaptureTransports), 1, bj_MINIMAPPINGSTYLE_SIMPLE, 0.00, 100, 0.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_CaptureTransports))
    // //
    call EnableTrigger(gg_trg_Preparations_Transport_Ping)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3803")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

