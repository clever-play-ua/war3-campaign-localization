    return ( GetUnitTypeId(GetFilterUnit()) == 'h60P' )
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func019A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
