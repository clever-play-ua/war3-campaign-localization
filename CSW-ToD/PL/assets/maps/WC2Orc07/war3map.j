endfunction

//===========================================================================
// Trigger: Foothold CompletedFailed
//===========================================================================
function Trig_Foothold_CompletedFailed_Func008C takes nothing returns boolean
    if ( not ( udg_Bool_FootholdBarracksBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdWarMillBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdBlacksmithBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdGoblinLabBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdShipyardBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdRefineryBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdFoundryBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_CompletedFailed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TimerDialogDisplayForPlayerBJ(false, udg_TimerWindow_WarchiefArrives, udg_Player_Actual)
    call TimerDialogDisplayBJ(false, udg_TimerWindow_WarchiefArrives)
    call PolledWait(0.25)
    call DestroyTimerDialogBJ(udg_TimerWindow_WarchiefArrives)
    // Success
    if ( Trig_Foothold_CompletedFailed_Func008C() ) then
        call QueuedTriggerAddBJ(gg_trg_Foothold_Completed_Q, true)
        call QueuedTriggerAddBJ(gg_trg_Doomhammer_Cinematic_Q, true)
    else
        call ConditionalTriggerExecute(gg_trg_Foothold_TimerExpires_Defeat)
    endif
endfunction

