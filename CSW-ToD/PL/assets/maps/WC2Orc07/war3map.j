function InitTrig_TransportationConfig takes nothing returns nothing
    set gg_trg_TransportationConfig=CreateTrigger()
    call TriggerAddAction(gg_trg_TransportationConfig, function Trig_TransportationConfig_Actions)
endfunction

//===========================================================================
// Trigger: TransportationLandingZoneConfig
//===========================================================================
function Trig_TransportationLandingZoneConfig_Actions takes nothing returns nothing
    // //
    // Main Player Camp
    set udg_Point_LandingMainOrcBase01=GetRectCenter(gg_rct_MainBaseUnload01)
