endfunction

function Trig_Doomhammer_Cinematic_Setup_Func024A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func027001002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Stromgarde )
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func027A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func029C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Maim) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Hero_Maim) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func030C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_SemiHero_Utok) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func032002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func033002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func109001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'hCan' )
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func109002 takes nothing returns nothing
