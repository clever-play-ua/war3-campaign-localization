endfunction

//===========================================================================
// Trigger: Preparations Update
//===========================================================================
function Trig_Preparations_Update_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_hFrK_0008) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(gg_unit_hFrK_0009) == false ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Group_IntroAttack01) == 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Group_IntroAttack02) == 0 ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_Maim) == true ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Group_Toilers) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Preparations_Update_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_Preparations_Completed_Check1)
    call SmartCameraPanBJ(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_TransportRescue), 1.00)
    call PolledWait(1.00)
    call SetUnitOwner(gg_unit_o60Q_0003, udg_Player_Actual, false)
    call UnitAddIndicatorBJ(gg_unit_o60Q_0003, 100, 100, 100, 0)
    call SetUnitOwner(gg_unit_o60Q_0002, udg_Player_Actual, false)
    call UnitAddIndicatorBJ(gg_unit_o60Q_0002, 100, 100, 100, 0)
    call PlaySoundAtPointBJ(gg_snd_Rescue, 75.00, GetRectCenter(gg_rct_CaptureTransports), 0)
    call DestroyFogModifier(udg_VisMod_CaptureTransport)
    call QueuedTriggerAddBJ(gg_trg_Preparations_Update_Q, true)
endfunction

//===========================================================================
function InitTrig_Preparations_Update takes nothing returns nothing
    set gg_trg_Preparations_Update=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Preparations_Update, 2)
    call TriggerAddCondition(gg_trg_Preparations_Update, Condition(function Trig_Preparations_Update_Conditions))
    call TriggerAddAction(gg_trg_Preparations_Update, function Trig_Preparations_Update_Actions)
endfunction

//===========================================================================
// Trigger: Preparations Update Q
//===========================================================================
function Trig_Preparations_Update_Q_Actions takes nothing returns nothing
    call DisableTrigger(gg_trg_Preparations_Transport_Ping)
    call DestroyMinimapIcon(udg_MinimapIcon_PrepTransport)
    call QuestItemSetCompletedBJ(udg_QReq_PrepRecaptureTr, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_3804")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    set udg_String_CheckpointPhase=" — Transportowce zdobyte"
    call ConditionalTriggerExecute(gg_trg_CheckpointSave)
    call EnableTrigger(gg_trg_Preparations_Goldmine_Ping)
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_GoldMine), 512.00)
    set udg_VisMod_Goldmine=GetLastCreatedFogModifier()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_GoldMine), bj_CAMPPINGSTYLE_PRIMARY)
    set udg_MinimapIcon_PrepGoldmine=GetLastCreatedMinimapIcon()
    call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_GoldMine), 1, bj_MINIMAPPINGSTYLE_SIMPLE, 0.00, 100, 0.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_GoldMine))
endfunction

//===========================================================================
function InitTrig_Preparations_Update_Q takes nothing returns nothing
    set gg_trg_Preparations_Update_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Preparations_Update_Q, function Trig_Preparations_Update_Q_Actions)
endfunction

//===========================================================================
// Trigger: Preparations Completed Check1
//===========================================================================
function Trig_Preparations_Completed_Check1_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Maim) == true ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Group_Toilers) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Preparations_Completed_Check1_Func002Func003Func006001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_StromgardeDefenders )
endfunction

function Trig_Preparations_Completed_Check1_Func002Func003Func006001001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false )
endfunction

function Trig_Preparations_Completed_Check1_Func002Func003Func006001001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Preparations_Completed_Check1_Func002Func003Func006001001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Preparations_Completed_Check1_Func002Func003Func006001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_StromgardeDefenders), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_Preparations_Completed_Check1_Func002Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_OrcBase, Condition(function Trig_Preparations_Completed_Check1_Func002Func003Func006001001002))) == 0 ) ) then
        return false
    endif
    if ( not ( udg_Bool_MQPrepStructuresCheck == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Preparations_Completed_Check1_Func002Func004001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_StromgardeDefenders )
endfunction

function Trig_Preparations_Completed_Check1_Func002Func004001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Preparations_Completed_Check1_Func002Func004001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_StromgardeDefenders), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Preparations_Completed_Check1_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_OrcBase, Condition(function Trig_Preparations_Completed_Check1_Func002Func004001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Preparations_Completed_Check1_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Preparations_Completed_Check1_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call ConditionalTriggerExecute(gg_trg_Preparations_Completed)
    else
        // Check if player left buildings on purpose
        set bj_wantDestroyGroup=true
        if ( Trig_Preparations_Completed_Check1_Func002Func003C() ) then
            set udg_Bool_MQPrepStructuresCheck=true
            call PolledWait(120.00)
            // Turn off later so Completed can still run if buildings were destoyed before 120 seconds passed
            call DisableTrigger(GetTriggeringTrigger())
            call ConditionalTriggerExecute(gg_trg_Preparations_Completed)
        else
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Preparations_Completed_Check1 takes nothing returns nothing
    set gg_trg_Preparations_Completed_Check1=CreateTrigger()
    call DisableTrigger(gg_trg_Preparations_Completed_Check1)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Preparations_Completed_Check1, 2)
    call TriggerAddCondition(gg_trg_Preparations_Completed_Check1, Condition(function Trig_Preparations_Completed_Check1_Conditions))
