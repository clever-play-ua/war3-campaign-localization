//===========================================================================
function Trig_Stromgarde_UpdateCompleted_Func001Func004C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQ_Trollbane) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stromgarde_UpdateCompleted_Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_Stromgarde_Barracks[1]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_Stromgarde_Barracks[2]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_Stromgarde_Stables) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_Stromgarde_PortTower) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_Stromgarde_TownHall) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_Stromgarde_Keep) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stromgarde_UpdateCompleted_Actions takes nothing returns nothing
    if ( Trig_Stromgarde_UpdateCompleted_Func001C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QueuedTriggerAddBJ(gg_trg_Stromgarde_Completed_Q, true)
        if ( Trig_Stromgarde_UpdateCompleted_Func001Func004C() ) then
            call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
            call QueuedTriggerAddBJ(gg_trg_Final_Cinematic_Q, true)
        else
        endif
    else
        call QueuedTriggerAddBJ(gg_trg_Stromgarde_Update_Q, true)
    endif
endfunction

