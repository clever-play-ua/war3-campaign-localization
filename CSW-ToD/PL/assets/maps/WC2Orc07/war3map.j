function InitTrig_Doomhammer_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Doomhammer_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Doomhammer_Cinematic_Cleanup, function Trig_Doomhammer_Cinematic_Cleanup_Actions)
endfunction

//===========================================================================
// Trigger: Doomhammer Cinematic CannoniersAnimations
//===========================================================================
function Trig_Doomhammer_Cinematic_CannoniersAnimations_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinDoomhammerOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_Cinematic_CannoniersAnimations_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitAnimation(udg_Unit_CinCannonierArr[GetForLoopIndexA()], "stand work")
        call TriggerSleepAction(0.25)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

