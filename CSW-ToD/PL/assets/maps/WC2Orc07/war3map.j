    call DefineStartLocation(7, 128.0, - 6912.0)
    call DefineStartLocation(8, 6656.0, - 13952.0)
    call DefineStartLocation(9, - 5696.0, - 3584.0)

    // Player setup
    call InitCustomPlayerSlots()
    call InitCustomTeams()
    call InitAllyPriorities()
endfunction




