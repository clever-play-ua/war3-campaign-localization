    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_Shark[2]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SharkLoop02_Func002001 takes nothing returns boolean
    return ( udg_Point_SharkNextArr[2] > 12 )
endfunction

function Trig_SharkLoop02_Func006001 takes nothing returns boolean
    return ( IsTriggerEnabled(GetTriggeringTrigger()) == false )
endfunction

function Trig_SharkLoop02_Actions takes nothing returns nothing
    set udg_Point_SharkNextArr[2]=( udg_Point_SharkNextArr[2] + 1 )
    if ( (udg_Point_SharkNextArr[2] > 12) ) then // INLINED!!
        set udg_Point_SharkNextArr[2]=1
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_Shark[2], "move", udg_Point_SharkTargetArr[udg_Point_SharkNextArr[2]])
    call PolledWait(1.00)
    if ( (IsTriggerEnabled(GetTriggeringTrigger()) == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_SharkLoop02 takes nothing returns nothing
    set gg_trg_SharkLoop02=CreateTrigger()
    call TriggerAddCondition(gg_trg_SharkLoop02, Condition(function Trig_SharkLoop02_Conditions))
    call TriggerAddAction(gg_trg_SharkLoop02, function Trig_SharkLoop02_Actions)
endfunction

//===========================================================================
// Trigger: Turtle
//===========================================================================
function Trig_Turtle_Conditions takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetDyingDestructable()) == 'B62T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Turtle_Func004C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Turtle_Actions takes nothing returns nothing
    if ( Trig_Turtle_Func004C() ) then
        set udg_Point_CreateTurtle=GetDestructableLoc(GetDyingDestructable())
        call CreateNUnitsAtLoc(1, 'ntrh', udg_Player_Actual, udg_Point_CreateTurtle, GetRandomDirectionDeg())
        call RemoveLocation(udg_Point_CreateTurtle)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Turtle takes nothing returns nothing
    set gg_trg_Turtle=CreateTrigger()
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_Turtle, gg_rct_TutleEggs01)
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_Turtle, gg_rct_TutleEggs02)
    call TriggerAddCondition(gg_trg_Turtle, Condition(function Trig_Turtle_Conditions))
    call TriggerAddAction(gg_trg_Turtle, function Trig_Turtle_Actions)
endfunction

//===========================================================================
// Trigger: SpawnMurlocks
//===========================================================================
function Trig_SpawnMurlocks_Func004C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nmh0' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nmh1' ) ) then
        return true
    endif
    return false
endfunction

function Trig_SpawnMurlocks_Conditions takes nothing returns boolean
    if ( not Trig_SpawnMurlocks_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_SpawnMurlocks_Actions takes nothing returns nothing
    set udg_Point_SpawnMurlockTemp=GetUnitLoc(GetDyingUnit())
    call CreateNUnitsAtLoc(1, 'nmrl', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Point_SpawnMurlockTemp, GetRandomDirectionDeg())
    call RemoveLocation(udg_Point_SpawnMurlockTemp)
endfunction

//===========================================================================
function InitTrig_SpawnMurlocks takes nothing returns nothing
    set gg_trg_SpawnMurlocks=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpawnMurlocks, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_SpawnMurlocks, Condition(function Trig_SpawnMurlocks_Conditions))
    call TriggerAddAction(gg_trg_SpawnMurlocks, function Trig_SpawnMurlocks_Actions)
endfunction

