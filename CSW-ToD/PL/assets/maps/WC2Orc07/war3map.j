function CreateCameras takes nothing returns nothing

    set gg_cam_Armory=CreateCameraSetup()
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_ZOFFSET, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_ROTATION, 90.0, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_ANGLE_OF_ATTACK, 330.0, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_TARGET_DISTANCE, 477.9, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_ROLL, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_FIELD_OF_VIEW, 70.0, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_FARZ, 5000.0, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_NEARZ, 16.0, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_LOCAL_PITCH, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_LOCAL_YAW, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Armory, CAMERA_FIELD_LOCAL_ROLL, 0.0, 0.0)
    call CameraSetupSetDestPosition(gg_cam_Armory, 4007.5, 18181.8, 0.0)

    set gg_cam_Cannonier01=CreateCameraSetup()
    call CameraSetupSetField(gg_cam_Cannonier01, CAMERA_FIELD_ZOFFSET, 100.0, 0.0)
    call CameraSetupSetField(gg_cam_Cannonier01, CAMERA_FIELD_ROTATION, 90.0, 0.0)
