function Trig_AI_P10_Transports_Availiable_Checker_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    if ( Trig_AI_P10_Transports_Availiable_Checker_Func004C() ) then
        set udg_Bool_P13TransportsAvailable=false
        if ( Trig_AI_P10_Transports_Availiable_Checker_Func004Func003C() ) then
            call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_4177")
        else
        endif
    else
        set udg_Bool_P13TransportsAvailable=true
    endif
    // //
    // //
    if ( Trig_AI_P10_Transports_Availiable_Checker_Func007C() ) then
        call ConditionalTriggerExecute(gg_trg_AI_P13_Stop_Attack_Command)
        if ( Trig_AI_P10_Transports_Availiable_Checker_Func007Func002C() ) then
            call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_4178")
        else
        endif
    else
    endif
    // //
    if ( Trig_AI_P10_Transports_Availiable_Checker_Func009C() ) then
        call ConditionalTriggerExecute(gg_trg_AI_P13_Start_Attack_Command)
        if ( Trig_AI_P10_Transports_Availiable_Checker_Func009Func002C() ) then
            call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_4179")
        else
        endif
    else
    endif
    // //
endfunction

