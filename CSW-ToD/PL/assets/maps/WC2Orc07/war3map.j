function Trig_Preparations_Destroyers_Arrive_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_hFrK_0008) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(gg_unit_hFrK_0009) == true ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Group_IntroAttack01) == 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Group_IntroAttack02) == 0 ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_Maim) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
