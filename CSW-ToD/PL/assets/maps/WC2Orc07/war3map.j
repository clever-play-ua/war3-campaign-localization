//===========================================================================
// Trigger: CityHouseDestroyed
//===========================================================================
function Trig_CityHouseDestroyed_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_CityHouseDestroyed_Func017Func003Func003Func003C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 7) == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CityHouseDestroyed_Func017Func003Func003C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 7) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CityHouseDestroyed_Func017Func003C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 7) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CityHouseDestroyed_Func017C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 5) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CityHouseDestroyed_Actions takes nothing returns nothing
    set udg_Point_CityHouseEffectDyingUnit=GetUnitLoc(GetDyingUnit())
    set udg_Region_CityHouseEffect=RectFromCenterSizeBJ(udg_Point_CityHouseEffectDyingUnit, 128.00, 128.00)
    set udg_Point_CityHouseEffectArr[1]=GetRandomLocInRect(udg_Region_CityHouseEffect)
    set udg_Point_CityHouseEffectArr[2]=GetRandomLocInRect(udg_Region_CityHouseEffect)
    call AddSpecialEffectLocBJ(udg_Point_CityHouseEffectArr[1], "Environment\\LargeBuildingFire\\LargeBuildingFire0.mdl")
    call AddSpecialEffectLocBJ(udg_Point_CityHouseEffectArr[2], "Environment\\LargeBuildingFire\\LargeBuildingFire0.mdl")
    call CreateUbersplatBJ(udg_Point_CityHouseEffectDyingUnit, "DHLB", 100, 100, 100, 0, true, false)
    set udg_Int_UberSplatIndex=( udg_Int_UberSplatIndex + 1 )
    set udg_UberSplat[udg_Int_UberSplatIndex]=GetLastCreatedUbersplat()
    call SetUbersplatRenderAlways(udg_UberSplat[udg_Int_UberSplatIndex], true)
    call ShowUbersplatBJ(true, udg_UberSplat[udg_Int_UberSplatIndex])
    call CreateNUnitsAtLoc(GetRandomInt(1, 2), 'nvl2', udg_Player_StromgardeDefenders, udg_Point_CityHouseEffectDyingUnit, GetRandomReal(1.00, 359.00))
    call CreateNUnitsAtLoc(GetRandomInt(1, 2), 'nvil', udg_Player_StromgardeDefenders, udg_Point_CityHouseEffectDyingUnit, GetRandomReal(1.00, 359.00))
    call SetSpeechVolumeGroupsBJ()
    if ( Trig_CityHouseDestroyed_Func017C() ) then
        call PlaySoundOnUnitBJ(gg_snd_H06VillagerM2501, 100, GetDyingUnit())
        call TriggerSleepAction(GetSoundDurationBJ(GetLastPlayedSound()))
    else
        if ( Trig_CityHouseDestroyed_Func017Func003C() ) then
            call PlaySoundOnUnitBJ(gg_snd_H06VillagerM2601, 100, GetDyingUnit())
            call TriggerSleepAction(GetSoundDurationBJ(GetLastPlayedSound()))
        else
            if ( Trig_CityHouseDestroyed_Func017Func003Func003C() ) then
                call PlaySoundOnUnitBJ(gg_snd_H06VillagerM2801, 100, GetDyingUnit())
                call TriggerSleepAction(GetSoundDurationBJ(GetLastPlayedSound()))
            else
                if ( Trig_CityHouseDestroyed_Func017Func003Func003Func003C() ) then
                    call DoNothing()
                else
                endif
            endif
        endif
    endif
    call VolumeGroupResetBJ()
    call RemoveLocation(udg_Point_CityHouseEffectDyingUnit)
    call RemoveRect(udg_Region_CityHouseEffect)
    call RemoveLocation(udg_Point_CityHouseEffectArr[1])
    call RemoveLocation(udg_Point_CityHouseEffectArr[2])
endfunction

//===========================================================================
function InitTrig_CityHouseDestroyed takes nothing returns nothing
    set gg_trg_CityHouseDestroyed=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_CityHouseDestroyed, Player(8), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_CityHouseDestroyed, Condition(function Trig_CityHouseDestroyed_Conditions))
    call TriggerAddAction(gg_trg_CityHouseDestroyed, function Trig_CityHouseDestroyed_Actions)
endfunction

