function Trig_KingsFlee_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // ////
    call ConditionalTriggerExecute(gg_trg_KingsFlee_Cinematic_Setup)
    call CameraSetupApplyForPlayer(true, gg_cam_Escape01, udg_Player_Actual, 0)
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_Comradeship)
    call TriggerSleepAction(1.00)
    // ////
    set udg_Bool_CinKingsFleeOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    // //
    call SetUnitAnimation(udg_FakeLiam, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeLiam, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeLiam, 0, gg_snd_WC2Orc07Liam_Retreat1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeLiam, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeThoras, "cinematic angry one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeThoras, 0, gg_snd_WC2Orc07Thoras_Retreat1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeThoras, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_LiamWarning01, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_FakeLiam, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeLiam, 0, gg_snd_WC2Orc07Liam_Retreat2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeLiam, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_LiamWarning02, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_FakeThoras, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeThoras, "cinematic angry one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeThoras, 0, gg_snd_WC2Orc07Thoras_Retreat2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeThoras, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeLiam, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeLiam, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeLiam, 0, gg_snd_WC2Orc07Liam_Retreat3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeLiam, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_LiamWarning01, udg_Player_Actual, 0)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Escape01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Escape02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc07Liam_Retreat4) + GetSoundDurationBJ(gg_snd_WC2Orc07Thoras_Retreat3) ))
    // //
    call SetUnitAnimation(udg_FakeThoras, "cinematic idea one")
    call QueueUnitAnimationBJ(udg_FakeThoras, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeThoras, 0, gg_snd_WC2Orc07Thoras_Retreat3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeThoras, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeLiam, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeLiam, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeLiam, 0, gg_snd_WC2Orc07Liam_Retreat4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeLiam, "cinematic listening one")
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_Escape03, udg_Player_Actual, 0)
    call PlaySoundAtPointBJ(gg_snd_LargeCityGateOpen1, 100, GetRectCenter(gg_rct_GateExit01), 0)
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_B606_2075)
    call EnumDestructablesInRectAll(gg_rct_GateExit01, function Trig_KingsFlee_Cinematic_Q_Func073A)
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_B606_2074)
    call EnumDestructablesInRectAll(gg_rct_GateExit02, function Trig_KingsFlee_Cinematic_Q_Func075A)
    // ////
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_Escape04, udg_Player_Actual, 10.00)
    // //
    call PlaySoundAtPointBJ(gg_snd_HoofSteps1, 100, GetRectCenter(gg_rct_TorasMounted), 0)
    call IssuePointOrderLocBJ(udg_Unit_TorasMounted, "move", GetRectCenter(gg_rct_KingEscape02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundAtPointBJ(gg_snd_HorseGallopLoop, 60.00, GetRectCenter(gg_rct_TorasEscort01), 0)
    call IssuePointOrderLocBJ(udg_Unit_TorasKnightGuardArr[1], "move", GetRectCenter(gg_rct_KingEscape02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_TorasKnightGuardArr[2], "move", GetRectCenter(gg_rct_KingEscape02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_TorasKnightGuardArr[3], "move", GetRectCenter(gg_rct_KingEscape02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_TorasKnightGuardArr[4], "move", GetRectCenter(gg_rct_KingEscape02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinKingsFleeSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_Comradeship, true)
    call ConditionalTriggerExecute(gg_trg_KingsFlee_Cinematic_Cleanup)
endfunction

