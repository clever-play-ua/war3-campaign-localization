//===========================================================================
function Trig_Doomhammer_Cinematic_FootmanLoop_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinDoomhammerOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_Cinematic_FootmanLoop_Func007001 takes nothing returns boolean
    return ( udg_Bool_CinDoomSkipped == true )
endfunction

function Trig_Doomhammer_Cinematic_FootmanLoop_Func010001 takes nothing returns boolean
    return ( udg_Bool_CinDoomSkipped == true )
endfunction

function Trig_Doomhammer_Cinematic_FootmanLoop_Func016001 takes nothing returns boolean
    return ( udg_Bool_CinDoomSkipped == true )
endfunction

function Trig_Doomhammer_Cinematic_FootmanLoop_Func020001 takes nothing returns boolean
    return ( udg_Bool_CinDoomSkipped == true )
endfunction

function Trig_Doomhammer_Cinematic_FootmanLoop_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_HumanBarracksWhat1)
    call AddUnitAnimationPropertiesBJ(true, "alternate", udg_Unit_CinDoomhammerArmFootman)
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerArmFootman, "move", GetRectCenter(gg_rct_MidgameCinHuman08))
    set udg_Point_CinFootmanTempLoc=GetUnitLoc(udg_Unit_CinDoomhammerArmFootman)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_CinFootmanTempLoc, GetRectCenter(gg_rct_MidgameCinHuman08)) / GetUnitMoveSpeed(udg_Unit_CinDoomhammerArmFootman) ))
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Gets Sword
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetDoodadAnimationRectBJ("death", 'LOwp', gg_rct_DoorCInematic02)
    call AddUnitAnimationPropertiesBJ(false, "alternate", udg_Unit_CinDoomhammerArmFootman)
    call PlaySoundAtPointBJ(gg_snd_MetalLightChopMetal1, 80.00, GetRectCenter(gg_rct_MidgameCinHuman08), 0)
    call SetUnitAnimation(udg_Unit_CinDoomhammerArmFootman, "stand victory")
    call TriggerSleepAction(2.33)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerArmFootman, "move", GetRectCenter(gg_rct_MidgameCinHuman13))
    set udg_Point_CinFootmanTempLoc=GetUnitLoc(udg_Unit_CinDoomhammerArmFootman)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_CinFootmanTempLoc, GetRectCenter(gg_rct_MidgameCinHuman13)) / GetUnitMoveSpeed(udg_Unit_CinDoomhammerArmFootman) ))
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitPositionLoc(udg_Unit_CinDoomhammerArmFootman, GetRectCenter(gg_rct_MidgameCinHumanCreate01))
endfunction

