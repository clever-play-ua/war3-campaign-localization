//===========================================================================
function Trig_Light_Rain_Begin_Actions takes nothing returns nothing
    set udg_Bool_Raining=true
    call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'RLlr')
    set udg_Weather_RainLight=GetLastCreatedWeatherEffect()
    // //////
    call StartTimerBJ(udg_Timer_RainLightDuration, false, GetRandomReal(60.00, 180.00))
endfunction

