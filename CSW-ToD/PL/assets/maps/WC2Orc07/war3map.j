//===========================================================================
// Trigger: Foothold Update Q
//===========================================================================
function Trig_Foothold_Update_Q_Func001C takes nothing returns boolean
    if ( not ( udg_Bool_FootholdBarracksBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdWarMillBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdBlacksmithBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdGoblinLabBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdShipyardBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdRefineryBuilt == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FootholdFoundryBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Update_Q_Func010C takes nothing returns boolean
    if ( not ( udg_Bool_FootholdBarracksBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Update_Q_Func011C takes nothing returns boolean
    if ( not ( udg_Bool_FootholdWarMillBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Update_Q_Func012C takes nothing returns boolean
    if ( not ( udg_Bool_FootholdBlacksmithBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Update_Q_Func013C takes nothing returns boolean
    if ( not ( udg_Bool_FootholdGoblinLabBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Update_Q_Func014C takes nothing returns boolean
    if ( not ( udg_Bool_FootholdShipyardBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Update_Q_Func015C takes nothing returns boolean
    if ( not ( udg_Bool_FootholdRefineryBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Update_Q_Func016C takes nothing returns boolean
    if ( not ( udg_Bool_FootholdFoundryBuilt == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Update_Q_Actions takes nothing returns nothing
    if ( Trig_Foothold_Update_Q_Func001C() ) then
        call DestroyLeaderboardBJ(udg_Leaderboard_QuestObjectives)
    else
    endif
    set udg_newLine="\n"
    // //
    set udg_String_CompletedQuests=( GetItemName(gg_item_IQL6_0613) + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL5_0612) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL5_0612) ) )
    // //
    if ( Trig_Foothold_Update_Q_Func010C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FootholdBuildBarracks, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL5_0612) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL5_0612) ) )
    endif
    if ( Trig_Foothold_Update_Q_Func011C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FootholdBuildWarMill, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL6_0613) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL6_0613) ) )
    endif
    if ( Trig_Foothold_Update_Q_Func012C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FootholdBuildBlacksmith, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL4_0611) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL4_0611) ) )
    endif
    if ( Trig_Foothold_Update_Q_Func013C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FootholdBuildGoblinLab, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL4_0611) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL4_0611) ) )
    endif
    if ( Trig_Foothold_Update_Q_Func014C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FootholdBuildShipyard, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL3_0610) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL3_0610) ) )
    endif
    if ( Trig_Foothold_Update_Q_Func015C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FootholdBuildRefinery, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL3_0610) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL3_0610) ) )
    endif
    if ( Trig_Foothold_Update_Q_Func016C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_FootholdBuildFoundry, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL2_0609) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL2_0609) ) )
    endif
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

