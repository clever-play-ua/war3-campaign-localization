// Trigger: Naval Completed Q
//===========================================================================
function Trig_Naval_Completed_Q_Actions takes nothing returns nothing
    call QuestSetCompletedBJ(udg_OQ_Naval, true)
    call QuestItemSetCompletedBJ(udg_QReq_NavalDestroyOilRigs, true)
    call QuestItemSetCompletedBJ(udg_QReq_NavalDestroyShipyards, true)
    call QuestItemSetCompletedBJ(udg_QReq_NavalDestroyRefineries, true)
    call QuestItemSetCompletedBJ(udg_QReq_NavalDestroyFoundries, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3897")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Doomhammer, 'O602', gg_snd_WC2Orc07Doomhammer_OilRigComplete1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

