//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func006C takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func010002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Next_Level_Prep_Func011002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Next_Level_Prep_Func019C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    set udg_Bool_CinOutroOn=false
    // //
    if ( Trig_Next_Level_Prep_Func006C() ) then
        call StopSoundBJ(gg_snd_WC2Orc07Utok4, false)
        call StopSoundBJ(gg_snd_WC2Orc07Utok5, false)
        call StopSoundBJ(gg_snd_WC2Orc07Doomhammer8, false)
        call StopSoundBJ(gg_snd_WC2Orc07Doomhammer9, false)
        call StopSoundBJ(gg_snd_WC2Orc07Doomhammer10, false)
        call StopSoundBJ(gg_snd_WC2Orc07Maim6, false)
        call StopSoundBJ(gg_snd_WC2Orc07Maim7, false)
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Next_Level_Prep_Func010002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Next_Level_Prep_Func011002)
    // //
    // Save Hero
    // //
    call StoreUnitBJ(udg_Hero_Maim, "Maim", "WC2Orc07", udg_Cache)
    // //
    call StoreUnitBJ(udg_Hero_Doomhammer, "Doomhammer", "WC2Orc07", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func019C() ) then
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_BlackRock, GetRectCenter(gg_rct_UtokInit), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc07", udg_Cache)
    else
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc07", udg_Cache)
    endif
    // //
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', udg_Player_Actual), "UtokLevel", "WC2Orc07", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc07", udg_Cache)
    // //
    call TriggerSleepAction(0.10)
    call SaveGameCacheBJ(udg_Cache)
    // //
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ShowCustomCampaignButton(true, 11)
    call ShowCustomCampaignButton(true, 12)
    call SetNextLevelBJ("WC2OrcAct3.w3x")
    call CustomVictoryBJ(udg_Player_Actual, true, true)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

//===========================================================================
