    set gg_trg_KingsFlee_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_KingsFlee_Cinematic_Cleanup, function Trig_KingsFlee_Cinematic_Cleanup_Actions)
endfunction

