//===========================================================================
function Trig_Final_Cinematic_Q_Func030001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func038001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func046001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func054001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func064001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func073001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func082001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Func086001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Final_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call ConditionalTriggerExecute(gg_trg_FinalCinematicSetup)
    call DisplayTimedTextToForce(udg_PlayerGroup_PlayerActual, 8.00, "TRIGSTR_4147")
    call TriggerSleepAction(11.00)
    // //
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final03, udg_Player_Actual, 0)
    call TriggerSleepAction(0.50)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call PlaySoundBJ(gg_snd_WC3OrcVictory)
    // //
    // Cinematic Started
    set udg_Bool_CinOutroOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call SetUnitLookAt(udg_FakeDoomhammer, "bone_head", udg_FakeUtok, 0, 0, 90)
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_FakeDoomhammer, 0, 0, 90)
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeUtok, 0, 0, 90)
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic proud one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc07Utok4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeDoomhammer, 0, 0, 90)
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer8, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeUtok, 0, 0, 90)
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic idea one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc07Utok5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeDoomhammer, 0, 0, 90)
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic headnod one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer9, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitLookAt(udg_FakeDoomhammer, "bone_head", udg_Unit_CinHeadPointer, 0, 0, 90)
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_FakeMaim, 0, 0, 90)
    call CameraSetupApplyForPlayer(true, gg_cam_Final02, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic idea one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc07Maim6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_FakeDoomhammer, 0, 0, 90)
    call CameraSetupApplyForPlayer(true, gg_cam_Final01, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic point two")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer10, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_FakeMaim, 0, 0, 90)
    call CameraSetupApplyForPlayer(true, gg_cam_Final01Zoom, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc07Maim7) + 3.00 ))
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic headnod one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc07Maim7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call TriggerSleepAction(2)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

