//===========================================================================
// Trigger: VisibilityControllerU01On
//===========================================================================
function Trig_VisibilityControllerU01On_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_VisMidWallsOn[1] == false ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(20) ) ) then
        return false
    endif
    return true
endfunction

function Trig_VisibilityControllerU01On_Actions takes nothing returns nothing
    set udg_Bool_VisMidWallsOn[1]=true
    call UnitShareVisionBJ(true, gg_unit_h00C_0438, Player(20))
    call EnableTrigger(gg_trg_VisibilityControllerU01Off)
endfunction

//===========================================================================
function InitTrig_VisibilityControllerU01On takes nothing returns nothing
    set gg_trg_VisibilityControllerU01On=CreateTrigger()
    call TriggerRegisterUnitInRangeSimple(gg_trg_VisibilityControllerU01On, 768.00, gg_unit_h00C_0438)
    call TriggerAddCondition(gg_trg_VisibilityControllerU01On, Condition(function Trig_VisibilityControllerU01On_Conditions))
    call TriggerAddAction(gg_trg_VisibilityControllerU01On, function Trig_VisibilityControllerU01On_Actions)
endfunction

//===========================================================================
// Trigger: VisibilityControllerU01Off
//===========================================================================
function Trig_VisibilityControllerU01Off_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_VisMidWallsOn[1] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_VisibilityControllerU01Off_Func002Func004001001002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_VisibilityControllerU01Off_Func002Func004001001002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == Player(20) )
endfunction

function Trig_VisibilityControllerU01Off_Func002Func004001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetOwningPlayer(GetFilterUnit()) == Player(20))) // INLINED!!
endfunction

function Trig_VisibilityControllerU01Off_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_VisibilityControl01, Condition(function Trig_VisibilityControllerU01Off_Func002Func004001001002))) == 0 ) ) then
        return false
    endif
