//===========================================================================
// Trigger: KingsFlee Cinematic Cleanup
//===========================================================================
function Trig_KingsFlee_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_KingsFlee_Cinematic_Cleanup_Func005002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_KingsFlee_Cinematic_Cleanup_Func022002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_KingsFlee_Cinematic_Cleanup_Func023002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_KingsFlee_Cinematic_Cleanup_Func028002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_KingsFlee_Cinematic_Cleanup_Func029002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_KingsFlee_Cinematic_Cleanup_Func040C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_KingsFlee_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinKingsFleeOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_KingsFlee_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call ForGroupBJ(udg_Group_TorasFleeKnights, function Trig_KingsFlee_Cinematic_Cleanup_Func005002)
    call StopSoundBJ(gg_snd_Comradeship, false)
    call StopSoundBJ(gg_snd_WC2Orc07Liam_Retreat1, false)
    call StopSoundBJ(gg_snd_WC2Orc07Liam_Retreat2, false)
    call StopSoundBJ(gg_snd_WC2Orc07Liam_Retreat3, false)
    call StopSoundBJ(gg_snd_WC2Orc07Liam_Retreat4, false)
    call StopSoundBJ(gg_snd_WC2Orc07Thoras_Retreat1, false)
    call StopSoundBJ(gg_snd_WC2Orc07Thoras_Retreat2, false)
    call StopSoundBJ(gg_snd_WC2Orc07Thoras_Retreat3, false)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call RemoveUnit(udg_Hero_ThorasTrollbane)
    call SetUnitPositionLocFacingBJ(udg_Hero_LiamTrollbane, GetRectCenter(gg_rct_LiamDefense), 90.00)
    call ShowUnitShow(udg_Hero_LiamTrollbane)
    call PauseUnitBJ(false, udg_Hero_LiamTrollbane)
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_KingsFlee_Cinematic_Cleanup_Func022002)
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_KingsFlee_Cinematic_Cleanup_Func023002)
    call GroupClear(udg_Group_PausedUnits)
    call SetStackedSoundBJ(false, gg_snd_CityBattlegroundLoop, gg_rct_LiamDefaultLocation)
    call SetStackedSoundBJ(false, gg_snd_CityBattlegroundLoop, gg_rct_GateExit01)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_KingsFlee_Cinematic_Cleanup_Func028002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_KingsFlee_Cinematic_Cleanup_Func029002)
    call GroupClear(udg_Group_HiddenUnits)
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(udg_Var_PlayerCamera), 0)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepOut)
    // //
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_KingsFlee_Cinematic_Cleanup_Func040C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_KingsFlee_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Trollbane_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

