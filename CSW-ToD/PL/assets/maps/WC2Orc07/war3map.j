//===========================================================================
// Trigger: Final Cin CreateCorpses
//===========================================================================
function Trig_Final_Cin_CreateCorpses_Actions takes nothing returns nothing
    // Corpses need to be created earlier to appear on time
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=20
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'hfSt', udg_Player_Stromgarde, GetRandomLocInRect(gg_rct_Corpses), GetRandomDirectionDeg())
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'hSSt', udg_Player_Stromgarde, GetRandomLocInRect(gg_rct_Corpses), GetRandomDirectionDeg())
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'hKSt', udg_Player_Stromgarde, GetRandomLocInRect(gg_rct_Corpses), GetRandomDirectionDeg())
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'nvlw', udg_Player_Citizens, GetRandomLocInRect(gg_rct_Corpses), GetRandomDirectionDeg())
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'nvl2', udg_Player_Citizens, GetRandomLocInRect(gg_rct_Corpses), GetRandomDirectionDeg())
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'nvil', udg_Player_Citizens, GetRandomLocInRect(gg_rct_Corpses), GetRandomDirectionDeg())
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'nvlk', udg_Player_Citizens, GetRandomLocInRect(gg_rct_Corpses), GetRandomDirectionDeg())
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'nvk2', udg_Player_Citizens, GetRandomLocInRect(gg_rct_Corpses), GetRandomDirectionDeg())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

