    return true
endfunction

function Trig_GateVisibilityOff_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_GateVisibilityOff_Func004C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Bool_GateVisible=false
        call FogModifierStop(udg_VisMod_Gate)
    else
    endif
endfunction

