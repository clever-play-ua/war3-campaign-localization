function Trig_Naval_Discover_Q_Func026002 takes nothing returns nothing
    call IssuePointOrderLocBJ(GetEnumUnit(), "attack", GetRectCenter(gg_rct_Ocean06))
endfunction

function Trig_Naval_Discover_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_BlackRock, 'o605', GetCameraTargetPositionLoc(), gg_snd_WC2Orc07Utok_OilRig1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Doomhammer, 'O602', gg_snd_WC2Orc07Doomhammer_OilRigTrigger1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestSetDiscoveredBJ(udg_OQ_Naval, true)
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3912")
    call CampaignMinimapIconUnitBJ(udg_Unit_Naval_ShipyardArr[1], bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_QuestNavalArr[1]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Naval_ShipyardArr[2], bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_QuestNavalArr[2]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Naval_RefineryArr[1], bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_QuestNavalArr[3]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Naval_RefineryArr[2], bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_QuestNavalArr[4]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Naval_FoundryArr[1], bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_QuestNavalArr[5]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Naval_FoundryArr[2], bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_QuestNavalArr[6]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Naval_OilRigArr[1], bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_QuestNavalArr[7]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Naval_OilRigArr[2], bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_QuestNavalArr[8]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_StromgardeDefenders, 'hFrK'), function Trig_Naval_Discover_Q_Func026002)
    call ConditionalTriggerExecute(gg_trg_Naval_Fyling_Attackers_Disable)
endfunction

