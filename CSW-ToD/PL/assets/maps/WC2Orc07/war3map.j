    endif
    return true
endfunction

function Trig_Naval_Update_Q_Actions takes nothing returns nothing
    set udg_newLine="\n"
    set udg_String_CompletedQuests=( GetItemName(gg_item_IQL0_0607) + ( udg_newLine + BlzGetItemDescription(gg_item_IQL0_0607) ) )
    if ( Trig_Naval_Update_Q_Func004C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_NavalDestroyOilRigs, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL0_0607) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL0_0607) ) )
    endif
    if ( Trig_Naval_Update_Q_Func005C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_NavalDestroyShipyards, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemExtendedTooltip(gg_item_IQL1_0608) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL1_0608) ) )
    endif
    if ( Trig_Naval_Update_Q_Func006C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_NavalDestroyRefineries, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL1_0608) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL1_0608) ) )
    endif
    if ( Trig_Naval_Update_Q_Func007C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_NavalDestroyFoundries, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + BlzGetItemDescription(gg_item_IQL2_0609) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL2_0609) ) )
    endif
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

