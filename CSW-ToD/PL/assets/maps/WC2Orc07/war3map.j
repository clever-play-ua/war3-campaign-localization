    // //
    if ( Trig_AI_P13_Detect_Attackers_Train_Func002C() ) then
        call DisplayTimedTextToForce(GetPlayersAll(), 1.00, "Wyszkolono jednostkę szturmową")
    else
        call DisplayTimedTextToForce(GetPlayersAll(), 1.00, "Wyszkolono zwykłą jednostkę")
