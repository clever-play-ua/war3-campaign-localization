    if ( not ( IsUnitAliveBJ(udg_Unit_Naval_RefineryArr[1]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_Naval_RefineryArr[2]) == false ) ) then
        return false
    endif
    return true
endfunction

