    if ( not ( IsUnitAliveBJ(udg_Unit_Naval_FoundryArr[1]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_Naval_FoundryArr[2]) == false ) ) then
