    return (GetUnitUserData((ConstructEvent___eventConstruct))) // INLINED!!
endfunction

function GetStructureBuilder takes unit whichUnit returns unit
    return ConstructEvent___builders[(GetUnitUserData((whichUnit)))] // INLINED!!
endfunction

