    set gg_trg_Foothold_CompletedFailed=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Foothold_CompletedFailed, udg_Timer_WarchiefArrives)
    call TriggerAddAction(gg_trg_Foothold_CompletedFailed, function Trig_Foothold_CompletedFailed_Actions)
endfunction

