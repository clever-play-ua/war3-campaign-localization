    call QueuedTriggerAddBJ(gg_trg_Stromgarde_Discover_Q, true)
    call ConditionalTriggerExecute(gg_trg_Stromgarde_Ogre_Hint)
    call TriggerSleepAction(5.00)
    call PolledWait(25.00)
    call QueuedTriggerAddBJ(gg_trg_Naval_Discover_Q, true)
endfunction

