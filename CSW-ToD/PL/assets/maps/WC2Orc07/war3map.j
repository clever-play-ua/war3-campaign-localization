        else
            if ( Trig_Naval_Update_OilRigs_Func002Func001Func003C() ) then
                set bj_wantDestroyGroup=true
                call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_StromgardeNavy, 'h600'), function Trig_Naval_Update_OilRigs_Func002Func001Func003Func002002)
            else
            endif
