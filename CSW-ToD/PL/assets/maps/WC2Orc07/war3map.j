//===========================================================================
// Trigger: CannonWallsVisibilityOn
//===========================================================================
function Trig_CannonWallsVisibilityOn_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(20) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_VisMidCannonWallsOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_CannonWallsVisibilityOn_Actions takes nothing returns nothing
    set udg_Bool_VisMidCannonWallsOn=true
    call CreateFogModifierRectBJ(true, Player(20), FOG_OF_WAR_VISIBLE, gg_rct_WallCannonsGroup)
    set udg_VisMod_CannonWalls=GetLastCreatedFogModifier()
    call EnableTrigger(gg_trg_CannonWallsVisibilityOff)
endfunction

//===========================================================================
function InitTrig_CannonWallsVisibilityOn takes nothing returns nothing
    set gg_trg_CannonWallsVisibilityOn=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_CannonWallsVisibilityOn, gg_rct_GateCheck)
    call TriggerAddCondition(gg_trg_CannonWallsVisibilityOn, Condition(function Trig_CannonWallsVisibilityOn_Conditions))
    call TriggerAddAction(gg_trg_CannonWallsVisibilityOn, function Trig_CannonWallsVisibilityOn_Actions)
endfunction

