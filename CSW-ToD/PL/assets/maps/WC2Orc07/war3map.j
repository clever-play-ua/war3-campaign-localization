//===========================================================================
function Trig_Initialization_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_FaceAnimationLoader)
    call ConditionalTriggerExecute(gg_trg_Oil_Locale_Setup)
    call SetAllyColorFilterState(0)
    call EnableMinimapFilterButtons(false, false)
    call SetMaxCheckpointSaves(10)
    set udg_String_CheckpointChapter="WC2Orc07"
    // //
    set udg_Point_PingPrepGoldmine=GetRectCenter(gg_rct_GoldMine)
    set udg_Point_PingPrepTransport=GetRectCenter(gg_rct_CaptureTransports)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_01_Players)
    call ConditionalTriggerExecute(gg_trg_Init_03_Audio)
    call ConditionalTriggerExecute(gg_trg_Init_04_Environment)
    call ConditionalTriggerExecute(gg_trg_Init_05_Quests)
    // **********
    // //
    call QueuedTriggerAddBJ(gg_trg_Intro_Cinematic_Q, true)
endfunction

//===========================================================================
function InitTrig_Initialization takes nothing returns nothing
    set gg_trg_Initialization=CreateTrigger()
    call TriggerAddAction(gg_trg_Initialization, function Trig_Initialization_Actions)
endfunction

//===========================================================================
// Trigger: Init 01 Players
//===========================================================================
function Trig_Init_01_Players_Actions takes nothing returns nothing
    // //
    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[20]
    set udg_Player_Actual=Player(20)
    set udg_Player_BlackRock=Player(0)
    set udg_Player_Transport=Player(2)
    call SetPlayerName(udg_Player_Transport, "TRIGSTR_023")
    set udg_Player_TwilightHammer=Player(3)
    // //
    set udg_Player_Stromgarde=Player(12)
    // //
    set udg_Player_StromgardeDefenders=Player(17)
    call SetPlayerName(udg_Player_StromgardeDefenders, "TRIGSTR_4174")
    call SetPlayerColorBJ(udg_Player_StromgardeDefenders, PLAYER_COLOR_MAROON, true)
    // //
    set udg_Player_StromgardeNavy=Player(16)
    call SetPlayerName(udg_Player_StromgardeNavy, "TRIGSTR_4173")
    call SetPlayerColorBJ(udg_Player_StromgardeNavy, PLAYER_COLOR_MAROON, true)
    // //
    set udg_Player_StromgardeCinematic=Player(19)
    call SetPlayerColorBJ(udg_Player_StromgardeCinematic, PLAYER_COLOR_MAROON, true)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_StromgardeCinematic)
    // //
    set udg_Player_Citizens=Player(8)
    // //
    set udg_Player_CinematicDummy=Player(23)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BlackRock, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BlackRock, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StromgardeDefenders, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDefenders, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_TwilightHammer, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammer, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammer, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_TwilightHammer, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Transport, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Transport, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StromgardeCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Stromgarde, udg_Player_StromgardeCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDefenders, udg_Player_StromgardeCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeNavy, udg_Player_StromgardeCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_StromgardeCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeCinematic, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeCinematic, udg_Player_Stromgarde, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeCinematic, udg_Player_StromgardeDefenders, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeCinematic, udg_Player_StromgardeNavy, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeCinematic, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 2200)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 1600)
    call playerAddOil(Player(20) , 1200)
    // //
    call SetPlayerOnScoreScreenBJ(false, udg_Player_Transport)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_TwilightHammer)
    // //
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 10.00)
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Player_Actual)
    // //
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Stromgarde, udg_Player_Transport, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDefenders, udg_Player_Transport, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Transport, udg_Player_Stromgarde, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDefenders, udg_Player_Stromgarde, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerStateBJ(udg_Player_Stromgarde, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Stromgarde, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_Stromgarde, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDefenders, udg_Player_Citizens, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_StromgardeDefenders, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeNavy, udg_Player_Citizens, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_StromgardeNavy, bj_ALLIANCE_ALLIED)
    // //
    call SetPlayerOnScoreScreenBJ(false, udg_Player_Citizens)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Stromgarde, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Stromgarde, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDefenders, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_StromgardeDefenders, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeNavy, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_StromgardeNavy, bj_ALLIANCE_NEUTRAL)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_06a_Hard)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Normal)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Easy)
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Init_01_Players takes nothing returns nothing
    set gg_trg_Init_01_Players=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_01_Players, function Trig_Init_01_Players_Actions)
endfunction

//===========================================================================
// Trigger: Init 02 Units
//===========================================================================
function Trig_Init_02_Units_Func011002 takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), true)
endfunction

function Trig_Init_02_Units_Func014002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Init_02_Units_Func025A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_OrcishArmada)
endfunction

function Trig_Init_02_Units_Func027A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Init_02_Units_Func067A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_Militia)
endfunction

function Trig_Init_02_Units_Func071A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_IntroAttack01)
endfunction

function Trig_Init_02_Units_Func073A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_IntroAttack02)
endfunction

function Trig_Init_02_Units_Func078001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h00H' )
endfunction

function Trig_Init_02_Units_Func078002 takes nothing returns nothing
    call SetUnitAnimation(GetEnumUnit(), "stand alternate")
endfunction

function Trig_Init_02_Units_Func083001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h00H' )
endfunction

function Trig_Init_02_Units_Func083A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_WallCannons)
endfunction

function Trig_Init_02_Units_Func087A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_CitizensHideout)
endfunction

function Trig_Init_02_Units_Func099002 takes nothing returns nothing
    call SetUnitAnimation(GetEnumUnit(), "cinematic saluteidle one")
endfunction

function Trig_Init_02_Units_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Load_Heroes)
    call EnableCreepSleepBJ(false)
    call IssuePointOrderLocBJ(gg_unit_nShP_0347, "patrol", GetRectCenter(gg_rct_Ocean07))
    call IssuePointOrderLocBJ(gg_unit_nShA_0345, "patrol", GetRectCenter(gg_rct_Ocean09))
    // //
    call ShowUnitHide(gg_unit_hASU_0617)
    call ShowUnitHide(gg_unit_hASU_0618)
    call ShowUnitHide(gg_unit_hASU_0621)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_IndestructableWalls, Player(PLAYER_NEUTRAL_PASSIVE)), function Trig_Init_02_Units_Func011002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_CinematicDummy), function Trig_Init_02_Units_Func014002)
    // //
    call UnitAddAbilityBJ('Anl1', gg_unit_u003_0101)
    call ShowUnitHide(gg_unit_n001_0017)
    call ShowUnitHide(gg_unit_n001_0121)
    call ShowUnitHide(gg_unit_o004_0544)
    call ShowUnitHide(gg_unit_o004_0543)
    // //
    set udg_Unit_TowerForAttackIsland=gg_unit_h60Z_0051
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_MidgameCinShipsArea, udg_Player_BlackRock), function Trig_Init_02_Units_Func025A)
    // //
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Init_02_Units_Func027A)
    // //
    call RemoveGuardPosition(gg_unit_n001_0121)
    call RemoveGuardPosition(gg_unit_n001_0017)
    // //
    call GroupAddUnitSimple(gg_unit_o61Y_0019, udg_Group_Toilers)
    call GroupAddUnitSimple(gg_unit_o61Y_0018, udg_Group_Toilers)
    call GroupAddUnitSimple(gg_unit_o61Y_0021, udg_Group_Toilers)
    call GroupAddUnitSimple(gg_unit_o61Y_0020, udg_Group_Toilers)
    // //
    call SuspendHeroXPBJ(false, udg_Hero_LiamTrollbane)
    call SuspendHeroXPBJ(false, udg_Hero_ThorasTrollbane)
    // //
    set udg_Hero_ThorasTrollbane=gg_unit_H62E_0092
    set udg_Hero_LiamTrollbane=gg_unit_H00E_0170
    // //
    // Create Ballistas
    // //
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateBallisae01), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateBallisae02), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateBallisae03), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateBallisae04), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateBallisae05), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateBallisae06), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateBallisae07), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateBallisae08), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateBallisae09), bj_UNIT_FACING)
    // //
    // Create Archers
    // //
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateArcher01), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateArcher02), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateArcher03), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateArcher04), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateArcher05), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'hSSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_CreateArcher06), bj_UNIT_FACING)
    // //
    // Militia
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_StromgardeDefenders, 'hmil'), function Trig_Init_02_Units_Func067A)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_IntroAttackGroup01, udg_Player_StromgardeDefenders), function Trig_Init_02_Units_Func071A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_IntroAttackGroup02, udg_Player_StromgardeDefenders), function Trig_Init_02_Units_Func073A)
    // //
    // CannonsCinematic
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CannonsCinematic, Condition(function Trig_Init_02_Units_Func078001002)), function Trig_Init_02_Units_Func078002)
    // //
    // WallCannons
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_WallCannonsGroup, Condition(function Trig_Init_02_Units_Func083001002)), function Trig_Init_02_Units_Func083A)
    // //
    // Women and Children
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CitizensInit, udg_Player_Citizens), function Trig_Init_02_Units_Func087A)
    // //
    call SetUnitInvulnerable(udg_Hero_LiamTrollbane, true)
    // //
    set udg_Unit_Stromgarde_Barracks[1]=gg_unit_h616_0080
    set udg_Unit_Stromgarde_Barracks[2]=gg_unit_h616_0150
    set udg_Unit_Stromgarde_Stables=gg_unit_h60I_0081
    set udg_Unit_Stromgarde_TownHall=gg_unit_h61C_0310
    set udg_Unit_Stromgarde_PortTower=gg_unit_h61Q_0078
    set udg_Unit_Stromgarde_Keep=gg_unit_h61B_0057
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_RoyalGuardsCinematic, udg_Player_StromgardeDefenders), function Trig_Init_02_Units_Func099002)
    // //
    // Sharks
    // //
    set udg_Unit_Shark[1]=gg_unit_nShA_0270
    set udg_Unit_Shark[2]=gg_unit_nShP_0271
    set udg_Point_SharkNextArr[1]=0
    set udg_Point_SharkNextArr[2]=6
    // ----------
    set udg_Unit_Naval_OilRigArr[1]=gg_unit_u600_0139
    set udg_Unit_Naval_OilRigArr[2]=gg_unit_u600_0093
    set udg_Unit_Naval_FoundryArr[1]=gg_unit_o61A_0091
    set udg_Unit_Naval_FoundryArr[2]=gg_unit_o61A_0427
    set udg_Unit_Naval_RefineryArr[1]=gg_unit_o61C_0426
    set udg_Unit_Naval_RefineryArr[2]=gg_unit_o61C_0094
    set udg_Unit_Naval_ShipyardArr[1]=gg_unit_h60X_0155
    set udg_Unit_Naval_ShipyardArr[2]=gg_unit_h60X_0154
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Init_02_Units takes nothing returns nothing
    set gg_trg_Init_02_Units=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_02_Units, function Trig_Init_02_Units_Actions)
endfunction

//===========================================================================
// Trigger: Init 03 Audio
//===========================================================================
function Trig_Init_03_Audio_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Music_DefaultNames[0]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    set udg_Music_DefaultNames[1]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[2]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3"
    set udg_Music_DefaultNames[3]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[4]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3"
    set udg_Music_DefaultNames[5]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    // //
    set udg_Music_DefaultNamesCount=6
    // //
    // SetMusicList with Randomizer
    set udg_Music_CurrentName=udg_Music_DefaultNames[GetRandomInt(0, 5)]
    set udg_Music_CurrentVolume=0.00
    // //
    call ClearMapMusicBJ()
endfunction

//===========================================================================
function InitTrig_Init_03_Audio takes nothing returns nothing
    set gg_trg_Init_03_Audio=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_03_Audio, function Trig_Init_03_Audio_Actions)
endfunction

//===========================================================================
// Trigger: Init 04 Environment
//===========================================================================
function Trig_Init_04_Environment_Actions takes nothing returns nothing
    call SetSkyModel("Environment\\Sky\\LordaeronFallSky\\LordaeronFallSky.mdl")
    call SetTerrainFogExBJ(0, 2500.00, 10500.00, 0.02, 78.00, 60.00, 7.80)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_FinalCInematicFires01)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_FinalCInematicFires02)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_FinalCInematicFires03)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_FinalCInematicFires04)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_FinalCInematicFires01)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_FinalCInematicFires02)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_FinalCInematicFires03)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_FinalCInematicFires04)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_FinalCInematicFires01)
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_FinalCInematicFires02)
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_FinalCInematicFires03)
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_FinalCInematicFires04)
    // //
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_Wallpaper)
    // //
    call SetDoodadAnimationRectBJ("stand alternate", 'D009', gg_rct_StromgardeFlagsClippingFix01)
    call SetDoodadAnimationRectBJ("stand alternate", 'D009', gg_rct_StromgardeFlagsClippingFix02)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_B60M_1189, true)
    call SetDestructableInvulnerableBJ(gg_dest_B60M_1188, true)
    call SetDestructableInvulnerableBJ(gg_dest_B60M_0932, true)
    call SetDestructableInvulnerableBJ(gg_dest_B60M_2078, true)
    call SetDestructableInvulnerableBJ(gg_dest_B60M_0933, true)
    // OpenPortGates
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_DTg7_2214)
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_B606_2075)
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_B606_2074)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_B606_2074, true)
    call SetDestructableInvulnerableBJ(gg_dest_B606_2075, true)
    // //
    set udg_Region_Shark[1]=gg_rct_Shark01
    set udg_Region_Shark[2]=gg_rct_Shark02
    set udg_Region_Shark[3]=gg_rct_Shark03
    set udg_Region_Shark[4]=gg_rct_Shark04
    set udg_Region_Shark[5]=gg_rct_Shark05
    set udg_Region_Shark[6]=gg_rct_Shark06
    set udg_Region_Shark[7]=gg_rct_Shark07
    set udg_Region_Shark[8]=gg_rct_Shark08
    set udg_Region_Shark[9]=gg_rct_Shark09
    set udg_Region_Shark[10]=gg_rct_Shark10
    set udg_Region_Shark[11]=gg_rct_Shark11
    set udg_Region_Shark[12]=gg_rct_Shark12
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Point_SharkTargetArr[GetForLoopIndexA()]=GetRectCenter(udg_Region_Shark[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set udg_Point_FakeLiamSpawn=GetRectCenter(gg_rct_SpawnFakeLiam)
    set udg_Point_FakeMaimSpawn=GetRectCenter(gg_rct_SpawnFakeMaim)
    set udg_Point_FakeOrgrimSpawn=GetRectCenter(gg_rct_SpawnFakeOrgrim)
    set udg_Point_FakeThorasSpawn=GetRectCenter(gg_rct_SpawnFakeThoras)
    set udg_Point_FakeUtokSpawn=GetRectCenter(gg_rct_SpawnFakeUtok)
    // //
    // //
    call CreateFogModifierRectBJ(false, udg_Player_Actual, FOG_OF_WAR_VISIBLE, gg_rct_GateVisibilityModifier)
    set udg_VisMod_Gate=GetLastCreatedFogModifier()
    // //
    // //
    call SetItemVisibleBJ(false, gg_item_IQL0_0607)
    call SetItemVisibleBJ(false, gg_item_IQL1_0608)
    call SetItemVisibleBJ(false, gg_item_IQL2_0609)
    call SetItemVisibleBJ(false, gg_item_IQL3_0610)
    call SetItemVisibleBJ(false, gg_item_IQL4_0611)
    call SetItemVisibleBJ(false, gg_item_IQL5_0612)
    call SetItemVisibleBJ(false, gg_item_IQL6_0613)
    call SetItemVisibleBJ(false, gg_item_IQL7_0614)
    call SetItemVisibleBJ(false, gg_item_IQL8_0615)
    call SetItemVisibleBJ(false, gg_item_IQL9_0616)
    // //
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

