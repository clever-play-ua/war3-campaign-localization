//===========================================================================
// Trigger: OilSpentForHumanDestroyer
//===========================================================================
function Trig_OilSpentForHumanDestroyer_Func002C takes nothing returns boolean
    if ( ( GetTrainedUnitType() == 'hFrK' ) ) then
        return true
    endif
    if ( ( GetTrainedUnitType() == 'e9ZZ' ) ) then
        return true
    endif
    return false
endfunction

function Trig_OilSpentForHumanDestroyer_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not Trig_OilSpentForHumanDestroyer_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForHumanDestroyer_Func017C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForHumanDestroyer_Actions takes nothing returns nothing
    // -------------------------------------
    // Check the amount of Oil for Player
    if (OilHarvest___playerOil[GetPlayerId((Player(16)))]) < 700 then // INLINED!!
    // // UI Warning
    // No need for it for computer driven player
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(16) , - 700)
    else
    // need to decrease the oil if there was enough of it and ship started to build
    call playerAddOil(Player(16) , - 700)
    endif
    if ( Trig_OilSpentForHumanDestroyer_Func017C() ) then
        call DisplayTextToForce(udg_PlayerGroup_PlayerActual, ( "Marynarka Stromgardu ma obecnie: " + I2S((OilHarvest___playerOil[GetPlayerId((Player(16)))])) + " jednostek ropy" )) // INLINED!!
    else
    endif
    // //
endfunction

