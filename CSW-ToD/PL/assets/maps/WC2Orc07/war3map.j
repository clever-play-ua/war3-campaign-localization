function Trig_Doomhammer_Cinematic_Q_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_GenericCinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ////
    call ConditionalTriggerExecute(gg_trg_Doomhammer_Cinematic_Setup)
    call CameraSetupApplyForPlayer(true, gg_cam_Midgame01, udg_Player_Actual, 0)
    // ////
    call TriggerSleepAction(1.00)
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call PlaySoundBJ(gg_snd_ShipHorn)
    // ////
    set udg_Bool_CinDoomhammerOn=true
    set udg_Bool_CinematicSkipped=false
    call ConditionalTriggerExecute(gg_trg_Doomhammer_Cinematic_ShipsMoveOrder)
    call TriggerSleepAction(2.00)
    call PlaySoundBJ(gg_snd_CS_Orc2x_Theramore_intro_Boats)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlayThematicMusicBJ("sound/music/mp3music/war2intromusic.flac")
    // ////
    // Part 1 - Ships Arrive
    // ////
    // ////
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Midgame02, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Midgame03, udg_Player_Actual, 12.00)
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_Naval_Rowboat_Loop_1)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameShip01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameShip02, udg_Player_Actual, 5.00)
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_Midgame04, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Midgame05, udg_Player_Actual, 7.00)
    // ////
    call PlaySoundBJ(gg_snd_Naval_Rowboat_Loop_2)
    // ////
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerFootman[4], "move", GetRectCenter(gg_rct_MidgameCinHuman07))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerFootman[5], "move", GetRectCenter(gg_rct_MidgameCinHuman06))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CreateNUnitsAtLoc(1, 'h60K', udg_Player_Stromgarde, GetRectCenter(gg_rct_MidgameCinHuman05), 180.00)
    set udg_Unit_CinDoomhammerFootman[6]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // ////
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerFootman[6], "move", GetRectCenter(gg_rct_MidgameCinHuman06))
    // ////
    // Part 2 - Stromgarde
    // ////
    call PlaySoundBJ(gg_snd_HumanBarracksWhat1)
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameWalls, udg_Player_Actual, 0)
    call TriggerSleepAction(2.19)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_HumanBarracksWhat1)
    call TriggerSleepAction(1.88)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    // Cannons and Armory
    call BlzShowTerrain(false)
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_Cannonier01, udg_Player_Actual, 0)
    call ConditionalTriggerExecute(gg_trg_Doomhammer_Cinematic_CannoniersAnimations)
    call PlaySoundAtPointBJ(gg_snd_TheBlackArrow, 60.00, GetRectCenter(gg_rct_MigameCannon01), 0)
    // ////
    call RemoveUnit(udg_Unit_CinDoomhammerFootman[6])
    call RemoveUnit(udg_Unit_CinDoomhammerFootman[5])
    call RemoveUnit(udg_Unit_CinDoomhammerFootman[4])
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_Cannonier02, udg_Player_Actual, 5.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundAtPointBJ(gg_snd_ImmolationDecay1, 60.00, GetRectCenter(gg_rct_MigameCannon02), 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundAtPointBJ(gg_snd_CorrosiveBreathMissileTarget1, 60.00, GetRectCenter(gg_rct_MigameCannon03), 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundAtPointBJ(gg_snd_FlareTarget1, 60.00, GetRectCenter(gg_rct_MigameCannon04), 0)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_Armory, udg_Player_Actual, 0)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call ResetUnitAnimation(udg_Unit_CinCannonierArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call ConditionalTriggerExecute(gg_trg_Doomhammer_Cinematic_FootmanLoop)
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Doomhammer_Cinematic_SpearmanLoop)
    call TriggerSleepAction(7.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call SetUnitPositionLocFacingBJ(udg_Unit_CinDoomhammerCannon[1], GetRectCenter(gg_rct_MigameCannon01), 180.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_CinDoomhammerCannon[2], GetRectCenter(gg_rct_MigameCannon02), 180.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_CinDoomhammerCannon[3], GetRectCenter(gg_rct_MigameCannon03), 180.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_CinDoomhammerCannon[4], GetRectCenter(gg_rct_MigameCannon04), 180.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_CinDoomhammerCannon[5], GetRectCenter(gg_rct_MigameCannon05), 180.00)
    // ////
    call SetUnitPositionLocFacingBJ(udg_Unit_CinCannonierArr[1], GetRectCenter(gg_rct_MigameMilitaPush01), 180.00)
    call SetUnitScalePercent(udg_Unit_CinCannonierArr[1], 110.00, 110.00, 110.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_CinCannonierArr[2], GetRectCenter(gg_rct_MigameMilitaPush02), 180.00)
    call SetUnitScalePercent(udg_Unit_CinCannonierArr[2], 110.00, 110.00, 110.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_CinCannonierArr[3], GetRectCenter(gg_rct_MigameMilitaPush03), 180.00)
    call SetUnitScalePercent(udg_Unit_CinCannonierArr[3], 110.00, 110.00, 110.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_CinCannonierArr[4], GetRectCenter(gg_rct_MigameMilitaPush04), 180.00)
    call SetUnitScalePercent(udg_Unit_CinCannonierArr[4], 110.00, 110.00, 110.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_CinCannonierArr[5], GetRectCenter(gg_rct_MigameMilitaPush05), 180.00)
    call SetUnitScalePercent(udg_Unit_CinCannonierArr[5], 110.00, 110.00, 110.00)
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_Cannonier03, udg_Player_Actual, 0)
    call PlaySoundBJ(gg_snd_CatapultLoop)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Cinematic_Scenery, Condition(function Trig_Doomhammer_Cinematic_Q_Func124001002)), function Trig_Doomhammer_Cinematic_Q_Func124002)
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerCannon[1], "move", GetRectCenter(gg_rct_MigameMilita01))
    call IssuePointOrderLocBJ(udg_Unit_CinCannonierArr[1], "move", GetRectCenter(gg_rct_MigameCannon01))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerCannon[2], "move", GetRectCenter(gg_rct_MigameMilita02))
    call IssuePointOrderLocBJ(udg_Unit_CinCannonierArr[2], "move", GetRectCenter(gg_rct_MigameCannon02))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerCannon[3], "move", GetRectCenter(gg_rct_MigameMilita03))
    call IssuePointOrderLocBJ(udg_Unit_CinCannonierArr[3], "move", GetRectCenter(gg_rct_MigameCannon03))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerCannon[4], "move", GetRectCenter(gg_rct_MigameMilita04))
    call IssuePointOrderLocBJ(udg_Unit_CinCannonierArr[4], "move", GetRectCenter(gg_rct_MigameCannon04))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinDoomhammerCannon[5], "move", GetRectCenter(gg_rct_MigameMilita05))
    call IssuePointOrderLocBJ(udg_Unit_CinCannonierArr[5], "move", GetRectCenter(gg_rct_MigameCannon05))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call BlzShowTerrain(true)
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameCastle, udg_Player_Actual, 0)
    call PlaySoundBJ(gg_snd_GateOpen)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CannonsCinematic, Condition(function Trig_Doomhammer_Cinematic_Q_Func150001002)), function Trig_Doomhammer_Cinematic_Q_Func150002)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CannonsCinematic, Condition(function Trig_Doomhammer_Cinematic_Q_Func154001002)), function Trig_Doomhammer_Cinematic_Q_Func154002)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    // Castle walls
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_Midgame06, udg_Player_Actual, 0)
    call SetUnitFacingTimed(udg_Unit_CinDoomhammerFootman[1], 0.00, 3.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Midgame07, udg_Player_Actual, 12.00)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_HumanCallToArmsWhat1)
    call SetUnitAnimation(udg_Unit_CinDoomhammerFootman[1], "cinematic wave one")
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_CinDoomhammerFootman[1], "cinematic point one")
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_CinDoomhammerFootman[1], "cinematic standard one")
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    // King
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameKing02, udg_Player_Actual, 0)
    // ////
    call SetUnitPositionLocFacingBJ(udg_FakeLiam, GetRectCenter(gg_rct_MidgameCinLiam01), 252.41)
    call SetUnitPositionLocFacingBJ(udg_FakeThoras, GetRectCenter(gg_rct_MidgameCinToras01), 248.23)
    // ////
    call ShowUnitShow(udg_FakeLiam)
    call ShowUnitShow(udg_FakeThoras)
    // ////
    // Music is too lound in this part of the cinematic, we can't hear the dialogue lines
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_MUSIC, 30.00)
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameKing03, udg_Player_Actual, 10.00)
    // ////
    call SetUnitAnimation(udg_FakeLiam, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeLiam, 0, gg_snd_WC2Orc07Liam1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeLiam, "cinematic listening one")
    // ////
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call SetUnitLookAt(udg_FakeLiam, "bone_head", udg_FakeThoras, 0, 0, 90)
    // ////
    call SetUnitAnimation(udg_FakeThoras, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeThoras, "cinematic proud one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeThoras, 0, gg_snd_WC2Orc07Thoras1, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc07Thoras1) - 2.00 ))
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeThoras, "cinematic listening one")
    call SetUnitFacingToFaceLocTimed(udg_FakeThoras, GetRectCenter(gg_rct_MidgameCinLiam01), 1.00)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call SetUnitAnimation(udg_FakeLiam, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeLiam, 0, gg_snd_WC2Orc07Liam2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeLiam, "cinematic listening one")
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameKing01, udg_Player_Actual, 0)
    // ////
    call SetUnitAnimation(udg_FakeThoras, "cinematic idea one")
    call QueueUnitAnimationBJ(udg_FakeThoras, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeThoras, 0, gg_snd_WC2Orc07Thoras2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeThoras, "cinematic listening one")
    call PlaySoundBJ(gg_snd_ClanInvitation)
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    // Part 3 - Doomhammer
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameOrcs04, udg_Player_Actual, 0)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0526, GetRectCenter(gg_rct_MidgameTransport01), 136.54)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0548, GetRectCenter(gg_rct_MidgameTransport02), 136.54)
    call TriggerSleepAction(2.00)
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_Orc3)
    // ////
    call SetUnitAnimation(udg_FakeUtok, "cinematic salute one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    // ////
    call SetUnitAnimation(udg_FakeMaim, "cinematic headnod one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc07Maim4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // ////
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeLiam, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameOrcs01, udg_Player_Actual, 0)
    // ////
    call SetUnitPositionLocFacingLocBJ(udg_FakeDoomhammer, GetRectCenter(gg_rct_MidgameOrgrim02), GetRectCenter(gg_rct_GoldMine))
    call SetUnitPositionLocFacingLocBJ(udg_FakeMaim, GetRectCenter(gg_rct_MidgameCinMaim02), GetRectCenter(gg_rct_MidgameOrgrim02))
    call SetUnitPositionLocFacingLocBJ(udg_FakeUtok, GetRectCenter(gg_rct_MidgameCinUtok02), GetRectCenter(gg_rct_MidgameOrgrim02))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o004_0543, GetRectCenter(gg_rct_MidgameKorkron03), GetRectCenter(gg_rct_MidgameOrgrim03))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o004_0544, GetRectCenter(gg_rct_MidgameKorkron04), GetRectCenter(gg_rct_MidgameOrgrim03))
    call SetUnitPositionLocFacingLocBJ(gg_unit_n001_0121, GetRectCenter(gg_rct_MidgameKorkron01), GetRectCenter(gg_rct_MidgameOrgrim03))
    call SetUnitPositionLocFacingLocBJ(gg_unit_n001_0017, GetRectCenter(gg_rct_MidgameKorkron02), GetRectCenter(gg_rct_MidgameOrgrim03))
    call TriggerSleepAction(2.00)
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // ////
    call SetUnitFacingToFaceUnitTimed(udg_FakeDoomhammer, udg_FakeMaim, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer2, bj_TIMETYPE_ADD, 0, true)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // ////
    call SetUnitAnimation(udg_FakeMaim, "cinematic headnod one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic listening one")
    // ////
    call SetUnitFacingToFaceUnitTimed(udg_FakeDoomhammer, udg_FakeUtok, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameOrcs03, udg_Player_Actual, 0)
    // ////
    call SetUnitAnimation(udg_FakeUtok, "cinematic salute one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc07Utok_OrgrimWelcome1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameOrcs01, udg_Player_Actual, 0)
    // ////
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameOrcs02, udg_Player_Actual, 0)
    call ShowUnitShow(gg_unit_n001_0121)
    call ShowUnitShow(gg_unit_n001_0017)
    call PlaySoundAtPointBJ(gg_snd_Loading, 100, GetRectCenter(gg_rct_MidgameTransport02), 0)
    call IssuePointOrderLocBJ(gg_unit_n001_0017, "move", GetRandomLocInRect(gg_rct_OgresDestination))
    call IssuePointOrderLocBJ(gg_unit_n001_0121, "move", GetRandomLocInRect(gg_rct_OgresDestination))
    // ////
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic point three")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameOrcs01, udg_Player_Actual, 0)
    // ////
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // ////
    call SetUnitAnimation(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc07Maim5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // ////
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic proud one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer7, bj_TIMETYPE_ADD, 0, true)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // ////
    // Orgrim talks to orcs
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameOrcs05, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_MidgameOrcs06, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc07Doomhammer_Rally1) + GetSoundDurationBJ(gg_snd_WC2Orc07Doomhammer_Rally2) ))
    // ////
    // ////
    call IssuePointOrderLocBJ(udg_FakeDoomhammer, "move", GetRectCenter(gg_rct_MidgameOrgrim03))
    set udg_Point_CinOrgrimTempLoc=GetUnitLoc(udg_FakeDoomhammer)
    call SetUnitFacingToFaceLocTimed(udg_FakeMaim, GetRectCenter(gg_rct_MidgameOrgrim03), ( DistanceBetweenPoints(udg_Point_CinOrgrimTempLoc, GetRectCenter(gg_rct_MidgameOrgrim03)) / GetUnitMoveSpeed(udg_FakeDoomhammer) ))
    call SetUnitFacingToFaceLocTimed(udg_FakeUtok, GetRectCenter(gg_rct_MidgameOrgrim03), ( DistanceBetweenPoints(udg_Point_CinOrgrimTempLoc, GetRectCenter(gg_rct_MidgameOrgrim03)) / GetUnitMoveSpeed(udg_FakeDoomhammer) ))
    // ////
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer_Rally1, bj_TIMETYPE_ADD, 0, false)
    // ////
    set udg_Point_CinOrgrimTempLoc=GetUnitLoc(udg_FakeDoomhammer)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_CinOrgrimTempLoc, GetRectCenter(gg_rct_MidgameOrgrim03)) / GetUnitMoveSpeed(udg_FakeDoomhammer) ))
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic proud one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard two")
    // ////
    call WaitForSoundBJ(gg_snd_WC2Orc07Doomhammer_Rally1, 0.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic proud one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc07Doomhammer_Rally2, bj_TIMETYPE_ADD, 0, false)
    // ////
    call WaitForSoundBJ(gg_snd_WC2Orc07Doomhammer_Rally2, 2.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitTimeScalePercent(udg_FakeDoomhammer, 50.00)
    call SetUnitAnimation(udg_FakeDoomhammer, "stand victory")
    // ////
    call PlaySoundBJ(gg_snd_OrcVictoryShouting)
    call SetSoundVolumeBJ(gg_snd_OrcVictoryShouting, 50.00)
    call SetUnitAnimation(gg_unit_o004_0543, "stand victory")
    call SetUnitAnimation(gg_unit_o004_0544, "stand victory")
    call ForGroupBJ(udg_Group_CinOrcCheerers, function Trig_Doomhammer_Cinematic_Q_Func382002)
    // ////
    call StopSoundBJ(gg_snd_Orc3, true)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinDoomSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    // ////
    call ConditionalTriggerExecute(gg_trg_Doomhammer_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Doomhammer_Cinematic_Q takes nothing returns nothing
    set gg_trg_Doomhammer_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Doomhammer_Cinematic_Q, function Trig_Doomhammer_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Doomhammer Cinematic Setup
//===========================================================================
function Trig_Doomhammer_Cinematic_Setup_Func015001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func015001002002 takes nothing returns boolean
    return ( IsUnitHiddenBJ(GetFilterUnit()) == false )
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func015001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitHiddenBJ(GetFilterUnit()) == false)) // INLINED!!
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func015A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func017001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60Q' )
endfunction

function Trig_Doomhammer_Cinematic_Setup_Func017A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

