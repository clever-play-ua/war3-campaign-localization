    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DefeatConditionCheck)
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func014001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o614' )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func014001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func014001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o614'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

