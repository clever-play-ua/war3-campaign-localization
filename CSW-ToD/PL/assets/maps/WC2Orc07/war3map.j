    call RescueUnitBJ(GetEnumUnit(), udg_Player_Actual, true)
endfunction

function Trig_Preparations_Destroyers_Arrive_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(PLAYER_NEUTRAL_PASSIVE), 'o60R'), function Trig_Preparations_Destroyers_Arrive_Func010002)
    call SmartCameraPanBJ(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_Destroyers), 1.00)
    call PolledWait(1.00)
    call PlaySoundOnUnitBJ(gg_snd_WC2TrollDestroyerPissed3, 100, gg_unit_o60R_0007)
endfunction

