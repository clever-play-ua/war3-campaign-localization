function InitTrig_Naval_Update_Q takes nothing returns nothing
    set gg_trg_Naval_Update_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Naval_Update_Q, function Trig_Naval_Update_Q_Actions)
endfunction

