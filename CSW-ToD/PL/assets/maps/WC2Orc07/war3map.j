//===========================================================================
// Trigger: SharkLoop01
//===========================================================================
function Trig_SharkLoop01_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Unit_Shark[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SharkLoop01_Func002001 takes nothing returns boolean
    return ( udg_Point_SharkNextArr[1] > 12 )
endfunction

function Trig_SharkLoop01_Func008001 takes nothing returns boolean
    return ( IsTriggerEnabled(GetTriggeringTrigger()) == false )
endfunction

function Trig_SharkLoop01_Actions takes nothing returns nothing
    set udg_Point_SharkNextArr[1]=( udg_Point_SharkNextArr[1] + 1 )
    if ( (udg_Point_SharkNextArr[1] > 12) ) then // INLINED!!
        set udg_Point_SharkNextArr[1]=1
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_Shark[1], "move", udg_Point_SharkTargetArr[udg_Point_SharkNextArr[1]])
    call PolledWait(1.00)
    if ( (IsTriggerEnabled(GetTriggeringTrigger()) == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_SharkLoop01 takes nothing returns nothing
    set gg_trg_SharkLoop01=CreateTrigger()
    call TriggerAddCondition(gg_trg_SharkLoop01, Condition(function Trig_SharkLoop01_Conditions))
    call TriggerAddAction(gg_trg_SharkLoop01, function Trig_SharkLoop01_Actions)
endfunction

