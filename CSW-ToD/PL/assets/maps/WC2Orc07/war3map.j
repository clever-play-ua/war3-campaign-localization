endfunction

//===========================================================================
// Trigger: Stromgarde Discover Q
//===========================================================================
function Trig_Stromgarde_Discover_Q_Actions takes nothing returns nothing
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, GetRectCenter(gg_rct_StromgardeKeep), 512)
    set udg_VisMod_StromGarde=GetLastCreatedFogModifier()
    // //
    call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_StromgardeKeep), 1, bj_MINIMAPPINGSTYLE_SIMPLE, 0.00, 100, 0.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_StromgardeKeep))
    // //
    call CampaignMinimapIconUnitBJ(udg_Unit_Stromgarde_Barracks[1], bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Stromgarde[1]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Stromgarde_Barracks[2], bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Stromgarde[2]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Stromgarde_Stables, bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Stromgarde[3]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Stromgarde_PortTower, bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Stromgarde[4]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Stromgarde_TownHall, bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Stromgarde[5]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(udg_Unit_Stromgarde_Keep, bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Stromgarde[6]=GetLastCreatedMinimapIcon()
    // //
    call QuestSetDiscoveredBJ(udg_MQ_Stromgarde, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3840")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    set udg_String_CheckpointPhase=" — Atak na miasto"
    call ConditionalTriggerExecute(gg_trg_CheckpointSave)
endfunction

