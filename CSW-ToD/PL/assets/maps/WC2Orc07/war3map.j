function InitTrig_OilSpentForResearchFC takes nothing returns nothing
    set gg_trg_OilSpentForResearchFC=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilSpentForResearchFC, Player(20), EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerAddCondition(gg_trg_OilSpentForResearchFC, Condition(function Trig_OilSpentForResearchFC_Conditions))
    call TriggerAddAction(gg_trg_OilSpentForResearchFC, function Trig_OilSpentForResearchFC_Actions)
