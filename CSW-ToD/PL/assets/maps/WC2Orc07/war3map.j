//===========================================================================
function Trig_EnableExtraAttackForRangedMarine_Func010C takes nothing returns boolean
    if ( ( IsUnitType(GetAttacker(), UNIT_TYPE_ANCIENT) == true ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'h000' ) ) then
        return true
    endif
    return false
endfunction

function Trig_EnableExtraAttackForRangedMarine_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetAttackedUnitBJ()) == udg_Player_Stromgarde ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetAttacker(), udg_Player_Stromgarde) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttackedUnitBJ()) == 'hSjM' ) ) then
        return false
    endif
    if ( not Trig_EnableExtraAttackForRangedMarine_Func010C() ) then
        return false
    endif
    return true
endfunction

