//===========================================================================
// Trigger: Foothold Discover
//===========================================================================
function Trig_Foothold_Discover_Conditions takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_MQ_Foothold) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Discover_Func005C takes nothing returns boolean
    if ( not ( GetPlayerState(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD) < 1200 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Discover_Func006C takes nothing returns boolean
    if ( not ( GetPlayerState(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER) < 800 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Foothold_Discover_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call QueuedTriggerAddBJ(gg_trg_Foothold_Discover_Q, true)
    if ( Trig_Foothold_Discover_Func005C() ) then
        call AdjustPlayerStateBJ(1200, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
    else
    endif
    if ( Trig_Foothold_Discover_Func006C() ) then
        call AdjustPlayerStateBJ(800, udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER)
    else
    endif
    // //
    call StartTimerBJ(udg_Timer_WarchiefArrives, false, 900.00)
    call CreateTimerDialogBJ(udg_Timer_WarchiefArrives, "TRIGSTR_3880")
    set udg_TimerWindow_WarchiefArrives=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ(true, udg_TimerWindow_WarchiefArrives)
    call StartTimerBJ(udg_Timer_WarchiefArrivesChecker, false, 840.00)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerAddBJ(gg_trg_Foothold_Timer_Warning_Q, true)
    call EnableTrigger(gg_trg_AllPlayerGroundUnitsAreDead)
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P13_Start)
    call ConditionalTriggerExecute(gg_trg_AI_P17_Start)
endfunction

//===========================================================================
function InitTrig_Foothold_Discover takes nothing returns nothing
    set gg_trg_Foothold_Discover=CreateTrigger()
    call TriggerAddCondition(gg_trg_Foothold_Discover, Condition(function Trig_Foothold_Discover_Conditions))
    call TriggerAddAction(gg_trg_Foothold_Discover, function Trig_Foothold_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Foothold Discover Q
//===========================================================================
function Trig_Foothold_Discover_Q_Func004001 takes nothing returns boolean
    return ( udg_Bool_FootholdBarracksBuilt == false )
endfunction

function Trig_Foothold_Discover_Q_Func005001 takes nothing returns boolean
    return ( udg_Bool_FootholdWarMillBuilt == false )
endfunction

function Trig_Foothold_Discover_Q_Func006001 takes nothing returns boolean
    return ( udg_Bool_FootholdBlacksmithBuilt == false )
endfunction

function Trig_Foothold_Discover_Q_Func007001 takes nothing returns boolean
    return ( udg_Bool_FootholdGoblinLabBuilt == false )
endfunction

function Trig_Foothold_Discover_Q_Func008001 takes nothing returns boolean
    return ( udg_Bool_FootholdShipyardBuilt == false )
endfunction

function Trig_Foothold_Discover_Q_Func009001 takes nothing returns boolean
    return ( udg_Bool_FootholdRefineryBuilt == false )
endfunction

function Trig_Foothold_Discover_Q_Func010001 takes nothing returns boolean
    return ( udg_Bool_FootholdFoundryBuilt == false )
endfunction

function Trig_Foothold_Discover_Q_Actions takes nothing returns nothing
    call CreateLeaderboardBJ(GetPlayersAll(), "TRIGSTR_3867")
    set udg_Leaderboard_QuestObjectives=GetLastCreatedLeaderboard()
    // //
    if ( (udg_Bool_FootholdBarracksBuilt == false) ) then // INLINED!!
        call LeaderboardAddItemBJ(Player(1), GetLastCreatedLeaderboard(), "TRIGSTR_3882", 0)
    else
        call DoNothing()
    endif
    if ( (udg_Bool_FootholdWarMillBuilt == false) ) then // INLINED!!
        call LeaderboardAddItemBJ(Player(2), GetLastCreatedLeaderboard(), "TRIGSTR_3887", 0)
    else
        call DoNothing()
    endif
    if ( (udg_Bool_FootholdBlacksmithBuilt == false) ) then // INLINED!!
        call LeaderboardAddItemBJ(Player(3), GetLastCreatedLeaderboard(), "TRIGSTR_3886", 0)
    else
        call DoNothing()
    endif
    if ( (udg_Bool_FootholdGoblinLabBuilt == false) ) then // INLINED!!
        call LeaderboardAddItemBJ(Player(7), GetLastCreatedLeaderboard(), "TRIGSTR_3889", 0)
    else
        call DoNothing()
    endif
    if ( (udg_Bool_FootholdShipyardBuilt == false) ) then // INLINED!!
        call LeaderboardAddItemBJ(Player(4), GetLastCreatedLeaderboard(), "TRIGSTR_3891", 0)
    else
        call DoNothing()
    endif
    if ( (udg_Bool_FootholdRefineryBuilt == false) ) then // INLINED!!
        call LeaderboardAddItemBJ(Player(5), GetLastCreatedLeaderboard(), "TRIGSTR_3893", 0)
    else
        call DoNothing()
    endif
    if ( (udg_Bool_FootholdFoundryBuilt == false) ) then // INLINED!!
        call LeaderboardAddItemBJ(Player(6), GetLastCreatedLeaderboard(), "TRIGSTR_3895", 0)
    else
        call DoNothing()
    endif
    // //
    call LeaderboardDisplayBJ(true, udg_Leaderboard_QuestObjectives)
    call LeaderboardSetPlayerItemStyleBJ(Player(1), udg_Leaderboard_QuestObjectives, true, false, true)
    call LeaderboardSetPlayerItemStyleBJ(Player(2), udg_Leaderboard_QuestObjectives, true, false, true)
    call LeaderboardSetPlayerItemStyleBJ(Player(3), udg_Leaderboard_QuestObjectives, true, false, true)
    call LeaderboardSetPlayerItemStyleBJ(Player(4), udg_Leaderboard_QuestObjectives, true, false, true)
    call LeaderboardSetPlayerItemStyleBJ(Player(5), udg_Leaderboard_QuestObjectives, true, false, true)
    call LeaderboardSetPlayerItemStyleBJ(Player(6), udg_Leaderboard_QuestObjectives, true, false, true)
    call LeaderboardSetPlayerItemStyleBJ(Player(7), udg_Leaderboard_QuestObjectives, true, false, true)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(1), udg_Leaderboard_QuestObjectives, 80.00, 70.00, 0.00, 0)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(2), udg_Leaderboard_QuestObjectives, 80.00, 70.00, 0.00, 0)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(3), udg_Leaderboard_QuestObjectives, 80.00, 70.00, 0.00, 0)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(7), udg_Leaderboard_QuestObjectives, 80.00, 70.00, 0.00, 0)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(4), udg_Leaderboard_QuestObjectives, 80.00, 70.00, 0.00, 0)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(5), udg_Leaderboard_QuestObjectives, 80.00, 70.00, 0.00, 0)
    call LeaderboardSetPlayerItemLabelColorBJ(Player(6), udg_Leaderboard_QuestObjectives, 80.00, 70.00, 0.00, 0)
    // //
    call QuestSetDiscoveredBJ(udg_MQ_Foothold, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3877")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

