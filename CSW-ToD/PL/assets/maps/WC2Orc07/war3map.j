    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_FinalCinematicSetup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Stromgarde, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Stromgarde, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StromgardeDefenders, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDefenders, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_FinalCinematicSetup_Func012001002)), function Trig_FinalCinematicSetup_Func012A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'h001'), function Trig_FinalCinematicSetup_Func014A)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_FinalCinematicSetup_Func016002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_FinalCinematicSetup_Func017002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_FinalCinematicSetup_Func020001002)), function Trig_FinalCinematicSetup_Func020A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_FinalCinematicSetup_Func022001002)), function Trig_FinalCinematicSetup_Func022A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_FinalCinematicSetup_Func024001002)), function Trig_FinalCinematicSetup_Func024A)
    // //
    call ConditionalTriggerExecute(gg_trg_Final_Cin_CreateCorpses)
    // //
    call SetDoodadAnimationRectBJ("stand", 'YOtf', gg_rct_FinalCInematicFires01)
    call SetDoodadAnimationRectBJ("stand", 'YOtf', gg_rct_FinalCInematicFires02)
    call SetDoodadAnimationRectBJ("stand", 'YOtf', gg_rct_FinalCInematicFires03)
    call SetDoodadAnimationRectBJ("stand", 'YOtf', gg_rct_FinalCInematicFires04)
    // //
    call SetDoodadAnimationRectBJ("stand", 'YOf3', gg_rct_FinalCInematicFires01)
    call SetDoodadAnimationRectBJ("stand", 'YOf3', gg_rct_FinalCInematicFires02)
    call SetDoodadAnimationRectBJ("stand", 'YOf3', gg_rct_FinalCInematicFires03)
    call SetDoodadAnimationRectBJ("stand", 'YOf3', gg_rct_FinalCInematicFires04)
    // //
    call SetDoodadAnimationRectBJ("stand", 'YOfs', gg_rct_FinalCInematicFires01)
    call SetDoodadAnimationRectBJ("stand", 'YOfs', gg_rct_FinalCInematicFires02)
    call SetDoodadAnimationRectBJ("stand", 'YOfs', gg_rct_FinalCInematicFires03)
    call SetDoodadAnimationRectBJ("stand", 'YOfs', gg_rct_FinalCInematicFires04)
    // //
    call SetDoodadAnimationRectBJ("stand", 'D64K', gg_rct_Wallpaper)
    // //
    call EnumDestructablesInRectAll(gg_rct_DestroyFountain, function Trig_FinalCinematicSetup_Func045002)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeDoomhammer, GetRectCenter(gg_rct_DoomhammerFinal), 207.43)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokFInal), 65.36)
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_MaimFinal), 315.26)
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call CreateNUnitsAtLoc(1, 'u003', udg_Player_BlackRock, GetRectCenter(gg_rct_CinematicHeadPointer), 270.00)
    set udg_Unit_CinHeadPointer=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FinalOgre01), 270.00)
    call CreateNUnitsAtLoc(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FinalOgre02), 132.00)
    call CreateNUnitsAtLoc(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FinalOgre03), 206.00)
    call CreateNUnitsAtLoc(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FinalOgre04), 155.00)
    call CreateNUnitsAtLoc(1, 'n001', udg_Player_Actual, GetRectCenter(gg_rct_FinalOgre05), 181.00)
    call CreateNUnitsAtLoc(1, 'n02F', udg_Player_Actual, GetRectCenter(gg_rct_FinalSpearman), 95.00)
    // //
    call CreateNUnitsAtLoc(1, 'o60G', udg_Player_Actual, GetRectCenter(gg_rct_FinalGrunt), 316.27)
    set udg_Unit_CinOutroGruntArr[1]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_CinOutroGruntArr[1], "cinematic standard three")
    // //
    call CreateNUnitsAtLoc(1, 'o004', udg_Player_Actual, GetRectCenter(gg_rct_FinalKorkron), 170.90)
    set udg_Unit_CinOutroGruntArr[2]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_CinOutroGruntArr[2], "cinematic standard one")
    // //
    // //
    // //
    // //
endfunction

