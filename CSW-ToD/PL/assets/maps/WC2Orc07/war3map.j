function Trig_AI_P13_Detect_Attackers_Train_Func002Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTrainedUnit()) == 'hfSM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTrainedUnit()) == 'hSjM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTrainedUnit()) == 'hBaM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTrainedUnit()) == 'hKsM' ) ) then
        return true
    endif
    return false
endfunction

function Trig_AI_P13_Detect_Attackers_Train_Func002C takes nothing returns boolean
    if ( not Trig_AI_P13_Detect_Attackers_Train_Func002Func001C() ) then
        return false
    endif
    return true
endfunction

