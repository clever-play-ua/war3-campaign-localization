endfunction

function Trig_Doomhammer_Cinematic_Setup_Func143002 takes nothing returns nothing
    call SetUnitMoveSpeed(GetEnumUnit(), 100.00)
endfunction

function Trig_Doomhammer_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetEntireMapRect())
    // //
    call SetPlayerAllianceStateBJ(udg_Player_BlackRock, udg_Player_Stromgarde, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BlackRock, udg_Player_StromgardeDefenders, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Stromgarde, udg_Player_BlackRock, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StromgardeDefenders, udg_Player_BlackRock, bj_ALLIANCE_NEUTRAL)
    // //
    // //
    // We need to pause attack wave of the P 13 during the cinematic
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_MidgameCinShipsArea, Condition(function Trig_Doomhammer_Cinematic_Setup_Func015001002)), function Trig_Doomhammer_Cinematic_Setup_Func015A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Doomhammer_Cinematic_Setup_Func017001002)), function Trig_Doomhammer_Cinematic_Setup_Func017A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Doomhammer_Cinematic_Setup_Func019001002)), function Trig_Doomhammer_Cinematic_Setup_Func019A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Doomhammer_Cinematic_Setup_Func021001002)), function Trig_Doomhammer_Cinematic_Setup_Func021A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_MainOrcBaseA, Condition(function Trig_Doomhammer_Cinematic_Setup_Func024001002)), function Trig_Doomhammer_Cinematic_Setup_Func024A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_MainOrcBaseB, Condition(function Trig_Doomhammer_Cinematic_Setup_Func027001002)), function Trig_Doomhammer_Cinematic_Setup_Func027A)
    // //
    if ( Trig_Doomhammer_Cinematic_Setup_Func029C() ) then
        call GroupAddUnitSimple(udg_Hero_Maim, udg_Group_HiddenUnits)
    else
    endif
    if ( Trig_Doomhammer_Cinematic_Setup_Func030C() ) then
        call GroupAddUnitSimple(udg_SemiHero_Utok, udg_Group_HiddenUnits)
    else
    endif
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Doomhammer_Cinematic_Setup_Func032002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Doomhammer_Cinematic_Setup_Func033002)
    // //
    call ShowUnitHide(gg_unit_hSSt_0484)
    call ShowUnitHide(gg_unit_hSSt_0483)
    call ShowUnitHide(gg_unit_hFrK_0065)
    call ShowUnitHide(gg_unit_hFrK_0066)
    call ShowUnitHide(gg_unit_u600_0093)
    call ShowUnitHide(gg_unit_n00F_0152)
    call ShowUnitHide(gg_unit_h616_0150)
    call PauseUnitBJ(true, gg_unit_h600_0038)
    // //
    call ShowUnitHide(udg_Hero_LiamTrollbane)
    call ShowUnitHide(udg_Hero_ThorasTrollbane)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeLiam, GetRectCenter(gg_rct_MidgameCinLiam01), 252.41)
    call SetUnitOwner(udg_FakeLiam, udg_Player_Stromgarde, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeThoras, GetRectCenter(gg_rct_MidgameCinToras01), 248.23)
    call SetUnitOwner(udg_FakeThoras, udg_Player_Stromgarde, true)
    call SetUnitAnimationWithRarity(udg_FakeThoras, "stand", RARITY_FREQUENT)
    // //
    // Cinematic Footmans
    // //
    call CreateNUnitsAtLoc(1, 'hfSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MidgameCinHuman01), bj_UNIT_FACING)
    set udg_Unit_CinDoomhammerFootman[1]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    call SetUnitBlendTimeBJ(udg_Unit_CinDoomhammerFootman[1], 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'hSrG', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MidgameCinHuman02), bj_UNIT_FACING)
    set udg_Unit_CinDoomhammerFootman[2]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    call CreateNUnitsAtLoc(1, 'hfSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MidgameCinHuman03), bj_UNIT_FACING)
    set udg_Unit_CinDoomhammerFootman[3]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    call SetUnitAnimation(udg_Unit_CinDoomhammerFootman[3], "stand ready")
    // //
    call CreateNUnitsAtLoc(1, 'hfSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MidgameCinHuman04), 0.00)
    set udg_Unit_CinDoomhammerFootman[4]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    call CreateNUnitsAtLoc(1, 'hfSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MidgameCinHuman05), 180.00)
    set udg_Unit_CinDoomhammerFootman[5]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    // Cannons
    // //
    call CreateNUnitsAtLoc(1, 'hCan', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameCannon01), 180.00)
    set udg_Unit_CinDoomhammerCannon[1]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    call SetUnitScalePercent(GetLastCreatedUnit(), 95.00, 95.00, 95.00)
    // //
    call CreateNUnitsAtLoc(1, 'hCan', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameCannon02), 180.00)
    set udg_Unit_CinDoomhammerCannon[2]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    call SetUnitScalePercent(GetLastCreatedUnit(), 95.00, 95.00, 95.00)
    // //
    call CreateNUnitsAtLoc(1, 'hCan', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameCannon03), 180.00)
    set udg_Unit_CinDoomhammerCannon[3]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    call SetUnitScalePercent(GetLastCreatedUnit(), 95.00, 95.00, 95.00)
    // //
    call CreateNUnitsAtLoc(1, 'hCan', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameCannon04), 180.00)
    set udg_Unit_CinDoomhammerCannon[4]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    call SetUnitScalePercent(GetLastCreatedUnit(), 95.00, 95.00, 95.00)
    // //
    call CreateNUnitsAtLoc(1, 'hCan', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameCannon05), 180.00)
    set udg_Unit_CinDoomhammerCannon[5]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    call SetUnitScalePercent(GetLastCreatedUnit(), 95.00, 95.00, 95.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Cinematic_Scenery, Condition(function Trig_Doomhammer_Cinematic_Setup_Func109001002)), function Trig_Doomhammer_Cinematic_Setup_Func109002)
    // //
    // Cannon Workers
    // //
    call CreateNUnitsAtLoc(1, 'h00F', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameMilita01), 0.00)
    set udg_Unit_CinCannonierArr[1]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    call CreateNUnitsAtLoc(1, 'h00F', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameMilita02), 0.00)
    set udg_Unit_CinCannonierArr[2]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    call CreateNUnitsAtLoc(1, 'h00F', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameMilita03), 0.00)
    set udg_Unit_CinCannonierArr[3]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    call CreateNUnitsAtLoc(1, 'h00F', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameMilita04), 0.00)
    set udg_Unit_CinCannonierArr[4]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    call CreateNUnitsAtLoc(1, 'h00F', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MigameMilita05), 0.00)
    set udg_Unit_CinCannonierArr[5]=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitAnimation(udg_Unit_CinCannonierArr[GetForLoopIndexA()], "stand ready")
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Cinematic_Scenery, Condition(function Trig_Doomhammer_Cinematic_Setup_Func136001002)), function Trig_Doomhammer_Cinematic_Setup_Func136002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Cinematic_Scenery, Condition(function Trig_Doomhammer_Cinematic_Setup_Func138001002)), function Trig_Doomhammer_Cinematic_Setup_Func138002)
    // //
    // //
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Doomhammer_Cinematic_Setup_Func141002)
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Doomhammer_Cinematic_Setup_Func142002)
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Doomhammer_Cinematic_Setup_Func143002)
    // //
    // //
    call SetDoodadAnimationRectBJ("death alternate", 'D69S', gg_rct_CinematicGateSmall)
    call SetDoodadAnimationRectBJ("death alternate", 'D69S', gg_rct_DoorCInematic02)
    // //
    call AddSpecialEffectTargetUnitBJ("Origin", gg_unit_o007_0024, "CSW\\Units\\Orc\\ClanOrcs\\BlackrockGrunt.mdx")
    set udg_SE_Grunt[1]=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectColorByPlayer(udg_SE_Grunt[1], udg_Player_BlackRock)
    call BlzSetSpecialEffectY(udg_SE_Grunt[1], - 20.00)
    // //
    // Putting Ships in place
    // //
    call SetUnitPositionLoc(gg_unit_h000_0505, GetRectCenter(gg_rct_MidgameOZStart03))
    call SetUnitPositionLoc(gg_unit_h000_0528, GetRectCenter(gg_rct_MidgameOZStart04))
    call SetUnitPositionLoc(gg_unit_h000_0530, GetRectCenter(gg_rct_MidgameOZStart01))
    call SetUnitPositionLoc(gg_unit_h000_0531, GetRectCenter(gg_rct_MidgameOZStart02))
    call SetUnitPositionLoc(gg_unit_h000_0529, GetRectCenter(gg_rct_MidgameOZStart05))
    // //
    call SetUnitPositionLoc(gg_unit_o60Q_0527, GetRectCenter(gg_rct_MidgameOTStart01))
    call SetUnitPositionLoc(gg_unit_o60Q_0517, GetRectCenter(gg_rct_MidgameOTStart02))
    call SetUnitPositionLoc(gg_unit_o60Q_0503, GetRectCenter(gg_rct_MidgameOTStart03))
    call SetUnitPositionLoc(gg_unit_o60Q_0526, GetRectCenter(gg_rct_MidgameOTStart04))
    // //
    call SetUnitPositionLoc(gg_unit_o60R_0463, GetRectCenter(gg_rct_MidgameTDStart06))
    call SetUnitPositionLoc(gg_unit_o60R_0525, GetRectCenter(gg_rct_MidgameTDStart01))
    call SetUnitPositionLoc(gg_unit_o60R_0502, GetRectCenter(gg_rct_MidgameTDStart02))
    call SetUnitPositionLoc(gg_unit_o60R_0522, GetRectCenter(gg_rct_MidgameTDStart03))
    call SetUnitPositionLoc(gg_unit_o60R_0523, GetRectCenter(gg_rct_MidgameTDStart04))
    call SetUnitPositionLoc(gg_unit_o60R_0524, GetRectCenter(gg_rct_MidgameTDStart05))
    // //
    call SetUnitPositionLoc(gg_unit_oDSS_0468, GetRectCenter(gg_rct_MidgameODStart07))
    call SetUnitPositionLoc(gg_unit_oDSS_0521, GetRectCenter(gg_rct_MidgameODStart06))
    call SetUnitPositionLoc(gg_unit_oDSS_0520, GetRectCenter(gg_rct_MidgameODStart05))
    call SetUnitPositionLoc(gg_unit_oDSS_0504, GetRectCenter(gg_rct_MidgameODStart08))
    call SetUnitPositionLoc(gg_unit_oDSS_0518, GetRectCenter(gg_rct_MidgameODStart04))
    call SetUnitPositionLoc(gg_unit_oDSS_0467, GetRectCenter(gg_rct_MidgameODStart01))
    call SetUnitPositionLoc(gg_unit_oDSS_0516, GetRectCenter(gg_rct_MidgameODStart02))
    call SetUnitPositionLoc(gg_unit_oDSS_0519, GetRectCenter(gg_rct_MidgameODStart03))
    // //
    call CreateNUnitsAtLoc(1, 'hfSt', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MidgameCinHumanCreate01), 180.00)
    set udg_Unit_CinDoomhammerArmFootman=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    call CreateNUnitsAtLoc(1, 'hSrG', udg_Player_StromgardeDefenders, GetRectCenter(gg_rct_MidgameCinHumanCreate01), 180.00)
    set udg_Unit_CinDoomhammerArmSpearman=GetLastCreatedUnit()
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinDoomhammerActors)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_MidgameCinUtok01), 331.24)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeDoomhammer, GetRectCenter(gg_rct_MidgameOrgrim01), 117.20)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_MidgameCinMaim01), 306.47)
    // //
    call ShowUnitShow(gg_unit_o004_0544)
    call ShowUnitShow(gg_unit_o004_0543)
    // //
    set udg_Point_CinOrgrimRotateLoc=GetRectCenter(gg_rct_MidgameOrgrim03)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60G', udg_Player_BlackRock, GetRectCenter(gg_rct_MidgameGruntCin01), udg_Point_CinOrgrimRotateLoc)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinOrcCheerers)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60G', udg_Player_BlackRock, GetRectCenter(gg_rct_MidgameGruntCin02), udg_Point_CinOrgrimRotateLoc)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinOrcCheerers)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60G', udg_Player_BlackRock, GetRectCenter(gg_rct_MidgameGruntCin03), udg_Point_CinOrgrimRotateLoc)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinOrcCheerers)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02F', udg_Player_BlackRock, GetRectCenter(gg_rct_MidgameGruntHunter01), udg_Point_CinOrgrimRotateLoc)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinOrcCheerers)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02F', udg_Player_BlackRock, GetRectCenter(gg_rct_MidgameGruntHunter01), udg_Point_CinOrgrimRotateLoc)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_CinOrcCheerers)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    // //
    // //
endfunction

