//===========================================================================
function Trig_Light_Rain_End_Actions takes nothing returns nothing
    call RemoveWeatherEffectBJ(udg_Weather_RainLight)
    set udg_Bool_Raining=false
    call StartTimerBJ(udg_Timer_RainLightPause, false, GetRandomReal(240.00, 320.00))
endfunction

