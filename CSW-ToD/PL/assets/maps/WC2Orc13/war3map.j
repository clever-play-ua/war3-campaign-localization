    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_Cin_1_Maim_4))
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed5, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_Intro_4_b, udg_Player_Actual, 0)
    // ///
    call PlaySoundBJ(gg_snd_ToSOrcScreamsFX1)
    call ResetUnitLookAt(udg_FakeMaim)
    call SetUnitFacingTimed(udg_FakeRend, 130.00, 2.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeRend, "stand ready")
    call QueueUnitAnimationBJ(udg_FakeRend, "cinematic listening one")
    call TriggerSleepAction(4.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rend 2
    // ----------------------------------------------------------------------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_IntroZuluhedInteresting, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_IntroRendAgreed, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc13Rend2) + 1 ), 1.00, 1.00, 100.00)
    call SetUnitFacingTimed(udg_FakeRend, 80.00, 1.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc13Rend2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rend2, 0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Maim 1
    // ----------------------------------------------------------------------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_Intro_5_a, udg_Player_Actual, 0)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc13Maim1, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitLookAt(udg_FakeZuluhed, "bone_head", udg_FakeMaim, 0, 0, 90)
    call SetUnitAnimation(udg_FakeMaim, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "stand ready")
    call WaitForSoundBJ(gg_snd_WC2Orc13Maim1, 0.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    // ///
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC ENDS - Cinematic Can No Longer Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ///
    call StopSoundBJ(gg_snd_ToSThemeIntro, true)
    call TriggerSleepAction(1.00)
    // ----------------------------------------------------------------------------------------------------
    // Cleanup
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Intro_Cleanup)
    call TriggerSleepAction(1.00)
    // ----------------------------------------------------------------------------------------------------
    // Start Game
    // ----------------------------------------------------------------------------------------------------
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Q takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Q, function Trig_Intro_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Intro Setup
//===========================================================================
function Trig_Intro_Setup_Func030A takes nothing returns nothing
    call SetUnitPathing(GetEnumUnit(), false)
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_Cin_1)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", GetEnumUnit())
    call SetUnitMoveSpeed(GetEnumUnit(), 100.00)
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, GetRandomReal(90.00, 110.00))
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.50)
endfunction

function Trig_Intro_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // ----------------------------------------------------------------------------------------------------
    // Weather
    // ----------------------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 500.00, 3500.00, 0.50, 3.00, 4.00, 6.00)
    call SetSkyModel("Environment\\Sky\\LordaeronFallSky\\LordaeronFallSky.mdl")
    // ----------------------------------------------------------------------------------------------------
    // Create Fake Actors
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // ///
    call SetUnitPositionLoc(udg_FakeMaim, GetRectCenter(gg_rct_Cin_1_Maim_1))
    call SetUnitPositionLoc(udg_FakeRend, GetRectCenter(gg_rct_Cin_1_Rend_1))
    call SetUnitPositionLoc(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_1_Zuluhed_1))
    // ///
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_CinematicBTG, GetRectCenter(gg_rct_Cin_1_Grunt_A_1), 0.00)
    set udg_Unit_Grunt_1=GetLastCreatedUnit()
    // ///
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_CinematicBTG, GetRectCenter(gg_rct_Cin_1_Grunt_B_1), 0.00)
    set udg_Unit_Grunt_2=GetLastCreatedUnit()
    // ///
    call CreateNUnitsAtLoc(1, 'n02F', udg_Player_CinematicBTG, GetRectCenter(gg_rct_Cin_1_Spear_A_1), 0.00)
    set udg_Unit_Spear_1=GetLastCreatedUnit()
    // ///
    call CreateNUnitsAtLoc(1, 'n02F', udg_Player_CinematicBTG, GetRectCenter(gg_rct_Cin_1_Spear_B_1), 0.00)
    set udg_Unit_Spear_2=GetLastCreatedUnit()
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_Cin_1_Group), function Trig_Intro_Setup_Func030A)
    // ----------------------------------------------------------------------------------------------------
    // Hide Units
    // ----------------------------------------------------------------------------------------------------
endfunction

//===========================================================================
function InitTrig_Intro_Setup takes nothing returns nothing
    set gg_trg_Intro_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Setup, function Trig_Intro_Setup_Actions)
endfunction

//===========================================================================
// Trigger: Intro Skipped
//===========================================================================
function Trig_Intro_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    // ----------------------------------------------------------------------------------------------------
    // Fade Out
    // ----------------------------------------------------------------------------------------------------
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    call StopSoundBJ(gg_snd_ToSThemeIntro, false)
    // ----------------------------------------------------------------------------------------------------
    // Cleanup
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Intro_Cleanup)
    call TriggerSleepAction(1.00)
    // ----------------------------------------------------------------------------------------------------
    // Start Game
    // ----------------------------------------------------------------------------------------------------
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
endfunction

//===========================================================================
function InitTrig_Intro_Skipped takes nothing returns nothing
    set gg_trg_Intro_Skipped=CreateTrigger()
    call DisableTrigger(gg_trg_Intro_Skipped)
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Intro_Skipped, Condition(function Trig_Intro_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Skipped, function Trig_Intro_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cleanup
//===========================================================================
function Trig_Intro_Cleanup_Func062Func001Func001C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B017' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B016' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B018' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Intro_Cleanup_Func062Func001C takes nothing returns boolean
    if ( not Trig_Intro_Cleanup_Func062Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cleanup_Func062A takes nothing returns nothing
    if ( Trig_Intro_Cleanup_Func062Func001C() ) then
        call ShowDestructableBJ(false, GetEnumDestructable())
    else
        call DoNothing()
    endif
endfunction

