function Trig_Intro_Cleanup_Func069Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cleanup_Func069A takes nothing returns nothing
    if ( Trig_Intro_Cleanup_Func069Func001C() ) then
        call SelectGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual))
    else
    endif
endfunction

function Trig_Intro_Cleanup_Actions takes nothing returns nothing
    call CameraSetFocalDistance(0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_Gameplay_Cam, udg_Player_Actual, 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // ///
    set udg_Bool_Searching=true
    set udg_Bool_CinIntroOn=false
    set udg_Bool_InCinematic=false
    // ----------------------------------------------------------------------------------------------------
    // Sounds and Music
    // ----------------------------------------------------------------------------------------------------
    call StopSoundBJ(gg_snd_ToSThemeIntro, false)
    // ///
    call StopSoundBJ(gg_snd_ToSEerieFX2, false)
    call StopSoundBJ(gg_snd_ToSOrcScreamsFX1, false)
    call StopSoundBJ(gg_snd_CS_BG_Camp, false)
    call StopSoundBJ(gg_snd_WC2Orc13Rend1, false)
    call StopSoundBJ(gg_snd_WC2Orc13Rend2, false)
    call StopSoundBJ(gg_snd_WC2Orc13Maim1, false)
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed1, false)
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed2, false)
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed3, false)
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed4, false)
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed5, false)
    // ----------------------------------------------------------------------------------------------------
    // Clear Units
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // ///
    call ShowUnitShow(udg_Hero_Rend)
    call AddSpecialEffectTargetUnitBJ("overhead", udg_Hero_Rend, "CSW\\Chapter13\\Lights\\DepthlessGlowAnimated.mdx")
    set udg_SE_LightRend=GetLastCreatedEffectBJ()
    call ShowUnitShow(udg_Hero_Maim)
    call AddSpecialEffectTargetUnitBJ("overhead", udg_Hero_Maim, "CSW\\Chapter13\\Lights\\DepthlessGlowAnimated.mdx")
    set udg_SE_LightMaim=GetLastCreatedEffectBJ()
    call ShowUnitShow(udg_Hero_Zuluhed)
    call AddSpecialEffectTargetUnitBJ("overhead", udg_Hero_Zuluhed, "CSW\\Chapter13\\Lights\\DepthlessGlowAnimated.mdx")
    set udg_SE_LightZuluhed=GetLastCreatedEffectBJ()
    // ///
    call RemoveUnit(udg_Unit_Grunt_1)
    call RemoveUnit(udg_Unit_Grunt_2)
    call RemoveUnit(udg_Unit_Spear_1)
    call RemoveUnit(udg_Unit_Spear_2)
    // ///
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_Actual, GetRectCenter(gg_rct_Cin_1_Grunt_A_2), 320.00)
    call SetUnitColor(GetLastCreatedUnit(), ConvertPlayerColor(24))
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_Actual, GetRectCenter(gg_rct_Cin_1_Grunt_B_2), 30.00)
    call SetUnitColor(GetLastCreatedUnit(), ConvertPlayerColor(24))
    call CreateNUnitsAtLoc(1, 'n02F', udg_Player_Actual, GetRectCenter(gg_rct_Cin_1_Spear_A_2), 350.00)
    call SetUnitColor(GetLastCreatedUnit(), ConvertPlayerColor(24))
    call CreateNUnitsAtLoc(1, 'n02F', udg_Player_Actual, GetRectCenter(gg_rct_Cin_1_Spear_B_2), 20.00)
    call SetUnitColor(GetLastCreatedUnit(), ConvertPlayerColor(24))
    // ///
    call SuspendHeroXPBJ(true, udg_Hero_Zuluhed)
    call SuspendHeroXPBJ(true, udg_Hero_Maim)
    call SuspendHeroXPBJ(true, udg_Hero_Rend)
    // ///
    call ShowDestructableBJ(false, gg_dest_B015_8765)
    call ShowDestructableBJ(false, gg_dest_B015_8766)
    call ShowDestructableBJ(false, gg_dest_B015_9065)
    call EnumDestructablesInRectAll(gg_rct_IntroSceneryWalls, function Trig_Intro_Cleanup_Func062A)
    call EnumDestructablesInRectAll(gg_rct_CinematicWallsBottom01, function Trig_Intro_Cleanup_Func063A)
    call EnumDestructablesInRectAll(gg_rct_CinematicWallsBottom02, function Trig_Intro_Cleanup_Func064A)
    // ///
    // ///
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Intro_Cleanup_Func069A)
    // ----------------------------------------------------------------------------------------------------
    // Weather
    // ----------------------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 500.00, 2500.00, 0.50, 6.00, 8.00, 12.00)
    call SetSkyModel(null)
    // ----------------------------------------------------------------------------------------------------
    // StartQuests
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call TriggerSleepAction(0.25)
    call QueuedTriggerAddBJ(gg_trg_Quest_Guldan_Discover_Q, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
endfunction

//===========================================================================
function InitTrig_Intro_Cleanup takes nothing returns nothing
    set gg_trg_Intro_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cleanup, function Trig_Intro_Cleanup_Actions)
endfunction

