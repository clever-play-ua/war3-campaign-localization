function Trig_Periodic_Horror_Sounds_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_InCinematic == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_BossFight == false ) ) then
        return false
    endif
    return true
endfunction

