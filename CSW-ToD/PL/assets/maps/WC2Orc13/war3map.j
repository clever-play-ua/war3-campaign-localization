function Trig_VisModCave01On_Actions takes nothing returns nothing
    call EnableTrigger(gg_trg_VisModCave01Off)
    set udg_Bool_VisibilityCaveOn[1]=true
    call UnitShareVisionBJ(true, gg_unit_hVCu_0451, Player(0))
endfunction

