    call TriggerAddAction(gg_trg_Quest_Aluneth_Create, function Trig_Quest_Aluneth_Create_Actions)
endfunction

//===========================================================================
// Trigger: Quest Aluneth Discover
//===========================================================================
function Trig_Quest_Aluneth_Discover_Actions takes nothing returns nothing
    // Ensure that the quest exists
    call ConditionalTriggerExecute(gg_trg_Quest_Aluneth_Create)
    // Update the quest
    call QuestSetDiscoveredBJ(udg_OQAluneth, true)
    // Display a quest message.
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3610")
    // //
    set udg_String_CheckpointPhase="AlunethShardsDiscovered"
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
endfunction

