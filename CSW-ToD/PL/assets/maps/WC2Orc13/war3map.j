    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call CreateNUnitsAtLoc(1, 'u60A', udg_Player_ShadowCouncil, udg_Event_Boss_TP3, bj_UNIT_FACING)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Event_Boss_TP_Zuluhed)
    // ///
    call AddSpecialEffectLocBJ(udg_Event_Boss_TP4, "Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call CreateNUnitsAtLoc(1, 'u60A', udg_Player_ShadowCouncil, udg_Event_Boss_TP4, bj_UNIT_FACING)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Event_Boss_TP_Zuluhed)
    // ///
    call RemoveLocation(udg_Event_Boss_TP_Zuluhed)
