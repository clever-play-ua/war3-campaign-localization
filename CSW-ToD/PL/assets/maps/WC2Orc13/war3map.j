        call SelectHeroSkill(udg_Hero_Rend, 'A00O')
        call SelectHeroSkill(udg_Hero_Rend, 'A00P')
        call UnitAddItemByIdSwapped('I60B', udg_Hero_Rend)
    endif
    call SetUnitColor(udg_Hero_Rend, ConvertPlayerColor(24))
