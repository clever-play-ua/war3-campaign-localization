function Trig_Boss_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // ----------------------------------------------------------------------------------------------------
    // Weather
    // ----------------------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 500.00, 5500.00, 0.50, 2.00, 5.00, 3.00)
    // ----------------------------------------------------------------------------------------------------
    // Hide Units
    // ----------------------------------------------------------------------------------------------------
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Boss_Setup_Func010A)
    call PauseAllUnitsBJ(true)
    call DestroyEffectBJ(udg_SE_LightRend)
    call DestroyEffectBJ(udg_SE_LightMaim)
    call DestroyEffectBJ(udg_SE_LightZuluhed)
    // ----------------------------------------------------------------------------------------------------
    // Hide items
    // ----------------------------------------------------------------------------------------------------
    call EnumItemsInRectBJ(GetPlayableMapRect(), function Trig_Boss_Setup_Func018A)
    // ----------------------------------------------------------------------------------------------------
    // ----------------------------------------------------------------------------------------------------
    // Create Fake Actors
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_3_Zuluhed_1), 90.00)
    // ///
    call ShowDestructableBJ(true, gg_dest_B015_8765)
    call ShowDestructableBJ(true, gg_dest_B015_8766)
    call ShowDestructableBJ(true, gg_dest_B015_9065)
    call EnumDestructablesInRectAll(gg_rct_IntroSceneryWalls, function Trig_Boss_Setup_Func030A)
    call EnumDestructablesInRectAll(gg_rct_CinematicWallsBottom01, function Trig_Boss_Setup_Func031A)
    call EnumDestructablesInRectAll(gg_rct_CinematicWallsBottom02, function Trig_Boss_Setup_Func032A)
    // ///
    call CreateNUnitsAtLoc(1, 'U006', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_3_Rakmar_1), 270.00)
    set udg_FakeRakmar=GetLastCreatedUnit()
    call SetUnitColor(udg_FakeRakmar, PLAYER_COLOR_BLUE)
    call SetUnitPathing(udg_FakeRakmar, false)
    call SetUnitPositionLocFacingBJ(udg_FakeRakmar, GetRectCenter(gg_rct_Cin_3_Rakmar_1), 270.00)
    call SetUnitVertexColorBJ(udg_FakeRakmar, 100.00, 100.00, 100.00, 90.00)
    // ///
    call CreateNUnitsAtLoc(1, 'nsrn', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_3_Rakmar_1), 270.00)
    set udg_Unit_RakmarShade=GetLastCreatedUnit()
    call SetUnitPathing(udg_Unit_RakmarShade, false)
    call SetUnitPositionLocFacingBJ(udg_Unit_RakmarShade, OffsetLocation(GetRectCenter(gg_rct_Cin_3_Rakmar_1), 15.00, - 5.00), 270.00)
    call SetUnitVertexColorBJ(udg_Unit_RakmarShade, 20.00, 20.00, 20.00, 10.00)
endfunction

//===========================================================================
function InitTrig_Boss_Setup takes nothing returns nothing
    set gg_trg_Boss_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Boss_Setup, function Trig_Boss_Setup_Actions)
endfunction

