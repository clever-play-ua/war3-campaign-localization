function Trig_Boss_Cinematic_Q_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Boss_Setup)
    call EnableTrigger(gg_trg_Boss_Skipped)
    // ///
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // ///
    set udg_Bool_CinRakmarOn=true
    set udg_Bool_InCinematic=true
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_AMBIENTSOUNDS, 0.00)
    call PlaySoundBJ(gg_snd_Demonic_Theme_2)
    call SetSoundVolumeBJ(gg_snd_Demonic_Theme_2, 60.00)
    // ///
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ///
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_3_Boss_1_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cin_3_Boss_1_b, udg_Player_Actual, 2.00, 0, 0.90, 2.00)
    // ///
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 4.00)
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "blink", GetRectCenter(gg_rct_Cin_3_Zuluhed_2))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PlaySoundBJ(gg_snd_RockChunksDeath1)
    call KillDestructable(gg_dest_B00F_0000)
    call SetDestructableAnimationBJ(gg_dest_B00F_0000, "death")
    call CameraClearNoiseForPlayer(Player(0))
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssueImmediateOrderBJ(udg_FakeZuluhed, "stop")
    call SetUnitFacingTimed(udg_FakeZuluhed, 200.00, 0.50)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 1
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed_RakmarEncounter1, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call SetUnitFacingTimed(udg_FakeZuluhed, 90.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed_RakmarEncounter1, 1.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_Cin_3_Zuluhed_3))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rakmar 1
    // ----------------------------------------------------------------------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_3_Boss_2_a, udg_Player_Actual, 0)
    // ///
    call SetUnitAnimation(udg_FakeRakmar, "stand ready")
    call SetUnitAnimation(udg_Unit_RakmarShade, "stand ready")
    // ///
    call SetPlayerColorBJ(udg_Player_CinematicDummy, PLAYER_COLOR_BLUE, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRakmar, 0, gg_snd_WC2Orc13Rakmar_Encounter1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rakmar_Encounter1, 0.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeRakmar, "spell")
    call QueueUnitAnimationBJ(udg_FakeRakmar, "stand ready")
    call SetUnitAnimation(udg_Unit_RakmarShade, "spell")
    call QueueUnitAnimationBJ(udg_Unit_RakmarShade, "stand ready")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Cin_3_Rakmar_1), "Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call SetUnitVertexColorBJ(udg_FakeRakmar, 100.00, 100.00, 100.00, 0.00)
    call RemoveUnit(udg_Unit_RakmarShade)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 2
    // ----------------------------------------------------------------------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_3_Boss_3_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_3_Boss_3_b, udg_Player_Actual, 40.00)
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed_RakmarEncounter2, bj_TIMETYPE_ADD, 0, false)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_3_Zuluhed_3), 115.00)
    call SetUnitAnimation(udg_FakeRakmar, "stand")
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed_RakmarEncounter2, 0.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rakmar 2
    // ----------------------------------------------------------------------------------------------------
    call SetPlayerColorBJ(udg_Player_CinematicDummy, PLAYER_COLOR_BLUE, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRakmar, 0, gg_snd_WC2Orc13Rakmar_Encounter2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rakmar_Encounter2, 5.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitBlendTimeBJ(udg_FakeRakmar, 2.00)
    call SetUnitAnimation(udg_FakeRakmar, "stand channel")
    call WaitForSoundBJ(gg_snd_WC2Orc13Rakmar_Encounter2, 0.50)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeRakmar, "stand")
    call WaitForSoundBJ(gg_snd_WC2Orc13Rakmar_Encounter2, 0.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 3
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed_RakmarEncounter3, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed_RakmarEncounter3, 0.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rakmar 3
    // ----------------------------------------------------------------------------------------------------
    call SetPlayerColorBJ(udg_Player_CinematicDummy, PLAYER_COLOR_BLUE, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRakmar, 0, gg_snd_WC2Orc13Rakmar_Encounter3, bj_TIMETYPE_ADD, 0, false)
    // ///
    call SetUnitTimeScalePercent(udg_FakeRakmar, 50.00)
    call SetUnitAnimation(udg_FakeRakmar, "spell")
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitTimeScalePercent(udg_FakeRakmar, 100.00)
    call QueueUnitAnimationBJ(udg_FakeRakmar, "stand")
    call WaitForSoundBJ(gg_snd_WC2Orc13Rakmar_Encounter3, 0.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 4
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed_RakmarEncounter4, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic frustrated one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "stand ready")
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed_RakmarEncounter4, 0.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rakmar 4
    // ----------------------------------------------------------------------------------------------------
    call SetPlayerColorBJ(Player(23), PLAYER_COLOR_BLUE, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRakmar, 0, gg_snd_WC2Orc13Rakmar_Encounter4, bj_TIMETYPE_ADD, 0, false)
    // ///
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeRakmar, "stand ready")
    call SetUnitBlendTimeBJ(udg_FakeRakmar, 0.50)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rakmar_Encounter4, 0.00)
    if ( (udg_Bool_CinRakmarSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC ENDS - Cinematic Can No Longer Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ----------------------------------------------------------------------------------------------------
    // Cleanup
    // ----------------------------------------------------------------------------------------------------
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_Boss_Cleanup)
    call TriggerSleepAction(2.00)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Boss_Cinematic_Q takes nothing returns nothing
    set gg_trg_Boss_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Boss_Cinematic_Q, function Trig_Boss_Cinematic_Q_Actions)
