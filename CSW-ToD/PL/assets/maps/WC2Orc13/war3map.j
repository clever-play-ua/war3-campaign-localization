//===========================================================================
// Trigger: Creep Multiplier
//===========================================================================
function Trig_Creep_Multiplier_Func002C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Creep_Multiplier_Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Creep_Multiplier_Func004C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Creep_Multiplier_Func006A takes nothing returns nothing
    call BlzSetUnitMaxHP(GetEnumUnit(), ( BlzGetUnitMaxHP(GetEnumUnit()) + ( GetUnitLevel(GetEnumUnit()) * udg_CreepHP ) ))
    call SetUnitLifePercentBJ(GetEnumUnit(), 100)
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetEnumUnit(), 0) + ( GetUnitLevel(GetEnumUnit()) * udg_CreepDMG ) ))
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetEnumUnit(), 1) + ( GetUnitLevel(GetEnumUnit()) * udg_CreepDMG ) ))
endfunction

function Trig_Creep_Multiplier_Func009A takes nothing returns nothing
    call BlzSetUnitMaxHP(GetEnumUnit(), ( BlzGetUnitMaxHP(GetEnumUnit()) + ( GetUnitLevel(GetEnumUnit()) * udg_CreepHP ) ))
    call SetUnitLifePercentBJ(GetEnumUnit(), 100)
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetEnumUnit(), 0) + ( GetUnitLevel(GetEnumUnit()) * udg_CreepDMG ) ))
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetEnumUnit(), 1) + ( GetUnitLevel(GetEnumUnit()) * udg_CreepDMG ) ))
endfunction

function Trig_Creep_Multiplier_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Creep_Multiplier_Func002C() ) then
        set udg_CreepHP=35
        set udg_CreepDMG=2
    else
    endif
    if ( Trig_Creep_Multiplier_Func003C() ) then
        set udg_CreepHP=60
        set udg_CreepDMG=3
    else
    endif
    if ( Trig_Creep_Multiplier_Func004C() ) then
        set udg_CreepHP=90
        set udg_CreepDMG=4
    else
    endif
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Creep_Multiplier_Func006A)
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_BurningLegion), function Trig_Creep_Multiplier_Func009A)
    //  
endfunction

//===========================================================================
function InitTrig_Creep_Multiplier takes nothing returns nothing
    set gg_trg_Creep_Multiplier=CreateTrigger()
    call TriggerAddAction(gg_trg_Creep_Multiplier, function Trig_Creep_Multiplier_Actions)
endfunction

//===========================================================================
// Trigger: Spawn Multiplier
//===========================================================================
function Trig_Spawn_Multiplier_Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetSummoningUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spawn_Multiplier_Actions takes nothing returns nothing
    if ( Trig_Spawn_Multiplier_Func001C() ) then
        call BlzSetUnitMaxHP(GetSummonedUnit(), ( BlzGetUnitMaxHP(GetSummonedUnit()) + ( GetUnitLevel(GetSummonedUnit()) * udg_CreepHP ) ))
        call SetUnitLifePercentBJ(GetSummonedUnit(), 100)
        call BlzSetUnitWeaponIntegerFieldBJ(GetSummonedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetSummonedUnit(), 0) + ( GetUnitLevel(GetSummonedUnit()) * udg_CreepDMG ) ))
        call BlzSetUnitWeaponIntegerFieldBJ(GetSummonedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetSummonedUnit(), 1) + ( GetUnitLevel(GetSummonedUnit()) * udg_CreepDMG ) ))
    else
    endif
endfunction

//===========================================================================
function InitTrig_Spawn_Multiplier takes nothing returns nothing
    set gg_trg_Spawn_Multiplier=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Spawn_Multiplier, EVENT_PLAYER_UNIT_SUMMON)
    call TriggerAddAction(gg_trg_Spawn_Multiplier, function Trig_Spawn_Multiplier_Actions)
endfunction

