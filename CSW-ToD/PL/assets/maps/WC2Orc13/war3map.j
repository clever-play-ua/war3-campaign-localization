//===========================================================================
// Trigger: Quest Aluneth Completed
//===========================================================================
function Trig_Quest_Aluneth_Completed_Actions takes nothing returns nothing
    // Ensure that the quest exists
    call ConditionalTriggerExecute(gg_trg_Quest_Aluneth_Create)
    // Update the quest
    call QuestItemSetDescriptionBJ(udg_QReq_AlunethFind, "TRIGSTR_3592")
    call QuestSetDiscoveredBJ(udg_OQAluneth, true)
    call QuestItemSetCompletedBJ(udg_QReq_AlunethFind, true)
    call QuestSetCompletedBJ(udg_OQAluneth, true)
    // Display a quest message.
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3593")
    // //
    set udg_String_CheckpointPhase="AlunethStaffAquired"
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
endfunction

