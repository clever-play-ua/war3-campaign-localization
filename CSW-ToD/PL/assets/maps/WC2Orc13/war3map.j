//===========================================================================
// Trigger: Event Cages
//===========================================================================
function Trig_Event_Cages_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_InCinematic == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_Escaping == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Cages_Func007Func001C takes nothing returns boolean
    if ( not ( udg_Event_Cage_Chance == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Cages_Func007Func006C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Cages_Func007C takes nothing returns boolean
    if ( not ( udg_Event_Cage_Chance == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Cages_Actions takes nothing returns nothing
    set udg_Event_Cage_Chance=GetRandomInt(1, 2)
    set udg_Event_Cage_TP=GetDestructableLoc(GetDyingDestructable())
    if ( Trig_Event_Cages_Func007C() ) then
        call CreateNUnitsAtLoc(1, 'o60G', Player(0), udg_Event_Cage_TP, bj_UNIT_FACING)
        call SetUnitColor(GetLastCreatedUnit(), GetPlayerColor(Player(PLAYER_NEUTRAL_AGGRESSIVE)))
        call SetUnitLifePercentBJ(GetLastCreatedUnit(), GetRandomReal(75.00, 90.00))
        call SetSpeechVolumeGroupsBJ()
        if ( Trig_Event_Cages_Func007Func006C() ) then
            call PlaySoundBJ(gg_snd_WC2Orc05GruntRescue3)
        else
            call PlaySoundBJ(gg_snd_WC2Orc05GruntRescue2)
        endif
        call VolumeGroupResetBJ()
    else
        if ( Trig_Event_Cages_Func007Func001C() ) then
            call CreateNUnitsAtLoc(1, 'n02F', Player(0), udg_Event_Cage_TP, bj_UNIT_FACING)
            call SetUnitColor(GetLastCreatedUnit(), GetPlayerColor(Player(PLAYER_NEUTRAL_AGGRESSIVE)))
            call SetUnitLifePercentBJ(GetLastCreatedUnit(), GetRandomReal(75.00, 90.00))
            call SetSpeechVolumeGroupsBJ()
            call PlaySoundBJ(gg_snd_WC2Orc06BHollowGrunt_Free2)
            call VolumeGroupResetBJ()
        else
        endif
    endif
    //  
    call RemoveLocation(udg_Event_Cage_TP)
endfunction

