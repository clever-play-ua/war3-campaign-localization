function Trig_Sargeras_Cinematic_Q_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Sargeras_Setup)
    call EnableTrigger(gg_trg_Sargeras_Skipped)
    // ///
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, GetPlayersAll())
    // ///
    call TriggerSleepAction(0.50)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    set udg_Bool_CinSargerasOn=true
    set udg_Bool_InCinematic=true
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_AMBIENTSOUNDS, 0.00)
    call PlaySoundBJ(gg_snd_ACT_II_WarlockTheme)
    call SetSoundVolumeBJ(gg_snd_ACT_II_WarlockTheme, 60.00)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ----------------------------------------------------------------------------------------------------
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // ----------------------------------------------------------------------------------------------------
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Sargeras_1_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Sargeras_1_b, udg_Player_Actual, 9.00)
    // ///
    call SetUnitAnimation(udg_FakeGuldan, "Walk Wounded 1")
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_Cin_2_Guldan_2))
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Gul'dan 1
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc13Guldan1, bj_TIMETYPE_ADD, 0, false)
    call CameraSetFocalDistance(125.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Sargeras_2_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cin_2_Sargeras_2_b, udg_Player_Actual, 17.00, 0, 6.00, 2.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Guldan1, 0)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PlaySoundBJ(gg_snd_EyeOfSargerasSound)
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetDoodadAnimationBJ("stand", 'ZZys', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 0.30)
    // ///
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_ToSChainSwing1)
    call SetSoundVolumeBJ(gg_snd_ToSChainSwing1, 40.00)
    // ----------------------------------------------------------------------------------------------------
    // Sargeras 1
    // ----------------------------------------------------------------------------------------------------
    call SetDoodadAnimationBJ("stand work", 'D02L', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    call SetDoodadAnimationBJ("stand work", 'D02M', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    call SetDoodadAnimationBJ("stand work", 'D02N', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    // ///
    call PlaySoundBJ(gg_snd_WC2Orc13Sargeras1)
    call TriggerSleepAction(1.00)
    call SetUnitAnimation(udg_FakeGuldan, "stand ready")
    call SetUnitFacingTimed(udg_FakeGuldan, 55.00, 1.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Sargeras_3_a, udg_Player_Actual, 0)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call WaitForSoundBJ(gg_snd_WC2Orc13Sargeras1, 2.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // ----------------------------------------------------------------------------------------------------
    // Gul'dan 2
    // ----------------------------------------------------------------------------------------------------
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Sargeras_3_b, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cin_2_Sargeras_3_c, udg_Player_Actual, 10.00, 0, 3.00, 1.00)
    // ///
    call CreateNUnitsAtLoc(1, 'nmed', udg_Player_CinematicDummy, GetRectCenter(gg_rct_Cin_2_Medivh_1), 270.00)
    set udg_FakeMedivh=GetLastCreatedUnit()
    call UnitAddAbilityBJ('ACSF', udg_FakeMedivh)
    call SetUnitColor(udg_FakeMedivh, ConvertPlayerColor(24))
    call SetUnitMoveSpeed(udg_FakeMedivh, 50.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMedivh, UNIT_RF_ANIMATION_WALK_SPEED, 50.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMedivh)
    call SetUnitVertexColorBJ(udg_FakeMedivh, 55.00, 55.00, 65.00, 10.00)
    call IssuePointOrderLocBJ(udg_FakeMedivh, "move", GetRectCenter(gg_rct_Cin_2_Medivh_2))
    // ///
    call SetDoodadAnimationBJ("stand", 'D02L', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    call SetDoodadAnimationBJ("stand", 'D02M', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    call SetDoodadAnimationBJ("stand", 'D02N', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc13Guldan2, bj_TIMETYPE_ADD, 0, false)
    call SetUnitFacingTimed(udg_FakeGuldan, 300.00, 1.50)
    call WaitForSoundBJ(gg_snd_WC2Orc13Guldan2, 0.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Medivh Visage 1
    // ----------------------------------------------------------------------------------------------------
    call SetPlayerColorBJ(udg_Player_CinematicDummy, ConvertPlayerColor(24), false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMedivh, 0, gg_snd_WC2Orc13Visage_Medivh1, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeMedivh, "cinematic stop one")
    call QueueUnitAnimationBJ(udg_FakeMedivh, "cinematic listening one")
    call SetUnitFacingTimed(udg_FakeGuldan, 60.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Visage_Medivh1, 0)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Gul'dan 3
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc13Guldan3, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeGuldan, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc13Guldan3, 0)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Gul'dan 4
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc13Guldan4, bj_TIMETYPE_ADD, 0, false)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeGuldan)
    call SetUnitAnimation(udg_FakeGuldan, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic listening one")
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_Cin_2_Guldan_3))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Sargeras_4_a, udg_Player_Actual, 0.00)
    call SetUnitFacingTimed(udg_FakeMedivh, 0.00, 2.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Guldan4, 11.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitMoveSpeed(udg_FakeMedivh, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMedivh, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call IssuePointOrderLocBJ(udg_FakeMedivh, "move", GetRectCenter(gg_rct_Cin_2_Medivh_3))
    call WaitForSoundBJ(gg_snd_WC2Orc13Guldan4, 7.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetFocalDistance(100.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Sargeras_4_b, udg_Player_Actual, 0.00)
    // ///
    call SetUnitFacingTimed(udg_FakeMedivh, 310.00, 1.00)
    call SetUnitAnimation(udg_FakeGuldan, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic standard one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc13Guldan4, 0.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Medivh Visage 2
    // ----------------------------------------------------------------------------------------------------
