//===========================================================================
function Trig_Event_Meme_Spider_1_Conditions takes nothing returns boolean
    if ( not ( GetAttacker() == gg_unit_n00O_0315 ) ) then
        return false
    endif
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_Escaping == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Meme_Spider_1_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicBTG, 'N60K', GetCameraTargetPositionLoc(), gg_snd_WC2Orc13Maim1_SpidersTrigger1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
endfunction

//===========================================================================
function InitTrig_Event_Meme_Spider_1 takes nothing returns nothing
    set gg_trg_Event_Meme_Spider_1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Event_Meme_Spider_1, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_Event_Meme_Spider_1, Condition(function Trig_Event_Meme_Spider_1_Conditions))
    call TriggerAddAction(gg_trg_Event_Meme_Spider_1, function Trig_Event_Meme_Spider_1_Actions)
endfunction

