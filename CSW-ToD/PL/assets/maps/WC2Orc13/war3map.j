//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func012C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_OQAluneth) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func016C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_OQAluneth) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    // ----------------------------------------------------------------------------------------------------
    // Store Heroes
    // ----------------------------------------------------------------------------------------------------
    call TriggerSleepAction(0.10)
    // //
    call StoreUnitBJ(udg_Hero_Maim, "Maim", "WC2Orc13", udg_Cache)
    // //
    call BlzSetUnitSkin(udg_Hero_Rend, 'O617')
    call TriggerSleepAction(0.10)
    call StoreUnitBJ(udg_Hero_Rend, "Rend", "WC2Orc13", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func012C() ) then
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, udg_ItemType_ArtifactTypes[udg_Int_ArtifactFragmentsFound]))
    else
    endif
    // //
    call StoreUnitBJ(udg_Hero_Zuluhed, "Zuluhed", "WC2Orc13", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func016C() ) then
        call StoreBooleanBJ(true, "M13StaffFound", "WC2Orc13", udg_Cache)
    else
        call DoNothing()
    endif
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc13", udg_Cache)
    // //
    call TriggerSleepAction(0.10)
    // //
    call SaveGameCacheBJ(udg_Cache)
    // //
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ShowCustomCampaignButton(true, 21)
    call SetNextLevelBJ("WC2Orc14.w3x")
    call CustomVictoryBJ(Player(0), true, true)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

