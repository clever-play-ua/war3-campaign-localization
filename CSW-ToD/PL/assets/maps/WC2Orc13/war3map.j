//===========================================================================
// Trigger: Init Quests
//===========================================================================
function Trig_Init_Quests_Actions takes nothing returns nothing
    // ----------------------------------------------------------------------------------------------------
    // Create Quests
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Quest_Guldan_Create)
    call ConditionalTriggerExecute(gg_trg_Quest_Escape_Create)
    call ConditionalTriggerExecute(gg_trg_Quest_Aluneth_Create)
    // ----------------------------------------------------------------------------------------------------
    // Init Quest Rewards
    // ----------------------------------------------------------------------------------------------------
    set udg_ItemType_ArtifactTypes[1]='I003'
    set udg_ItemType_ArtifactTypes[2]='I005'
    set udg_ItemType_ArtifactTypes[3]='I006'
    set udg_ItemType_ArtifactTypes[4]='I007'
    set udg_ItemType_ArtifactTypes[5]='I008'
    set udg_ItemType_ArtifactTypes[6]='I009'
    set udg_ItemType_ArtifactTypes[7]='I00A'
    set udg_ItemType_ArtifactTypes[8]='I00B'
    set udg_ItemType_ArtifactTypes[9]='I00C'
    set udg_ItemType_ArtifactTypes[10]='ITSX'
    // ----------------------------------------------------------------------------------------------------
    // Make Preplaced Orb Fragments Invulnerable
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Make_Artifact_Invulnerable)
