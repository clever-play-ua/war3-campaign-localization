    endif
    return true
endfunction

function Trig_InitDifficulty_Func014A takes nothing returns nothing
    if ( Trig_InitDifficulty_Func014Func001C() ) then
        call SetUnitAbilityLevelSwapped('AFS0', GetEnumUnit(), 1)
    else
        if ( Trig_InitDifficulty_Func014Func001Func001C() ) then
            call SetUnitAbilityLevelSwapped('AFS0', GetEnumUnit(), 2)
        else
            if ( Trig_InitDifficulty_Func014Func001Func001Func001C() ) then
                call SetUnitAbilityLevelSwapped('AFS0', GetEnumUnit(), 3)
            else
            endif
        endif
    endif
endfunction

function Trig_InitDifficulty_Func017Func001C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

