//===========================================================================
// Trigger: Artifact 01 Q
//===========================================================================
function Trig_Artifact_01_Q_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Artifact_01_Q_Actions takes nothing returns nothing
    // Line
    call SetSpeechVolumeGroupsBJ()
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc13Zuluhed_Staff1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed_Staff1, 0)
    call VolumeGroupResetBJ()
    // Update Leaderboard
    call ConditionalTriggerExecute(gg_trg_Leaderboard_Create)
    // Update Quest
    call ConditionalTriggerExecute(gg_trg_Quest_Aluneth_Discover)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

