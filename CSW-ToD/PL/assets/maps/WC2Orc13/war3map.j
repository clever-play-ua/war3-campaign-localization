function Trig_Event_Faldorei_1_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_Escaping == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Faldorei_1_Func016Func001Func002C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B00R' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Event_Faldorei_1_Func016Func001C takes nothing returns boolean
    if ( not Trig_Event_Faldorei_1_Func016Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Faldorei_1_Func016A takes nothing returns nothing
    if ( Trig_Event_Faldorei_1_Func016Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Event_Faldorei_1_Actions takes nothing returns nothing
    //  
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_ZuluhedReturnFromForbiddenArea03)
    call UnitShareVisionBJ(true, gg_unit_n00L_0033, udg_Player_Actual)
    set udg_Event_Spider_1_TP=GetRectCenter(gg_rct_Spider_Goal_1)
    set udg_Event_Spider_2_TP=GetRectCenter(gg_rct_Spider_Goal_2)
    call SetUnitFacingToFaceLocTimed(gg_unit_n00L_0033, udg_Event_Spider_1_TP, 1.00)
    call TriggerSleepAction(1.00)
    call IssuePointOrderLocBJ(gg_unit_n00L_0033, "attack", udg_Event_Spider_1_TP)
    //  
    call RemoveLocation(udg_Event_Spider_1_TP)
    //  
    call EnumDestructablesInRectAll(gg_rct_UnblockQueenBackDoor, function Trig_Event_Faldorei_1_Func016A)
endfunction

