function InitTrig_Event_Cages takes nothing returns nothing
    set gg_trg_Event_Cages=CreateTrigger()
    call TriggerRegisterDeathEvent(gg_trg_Event_Cages, gg_dest_LOcg_2617)
    call TriggerAddCondition(gg_trg_Event_Cages, Condition(function Trig_Event_Cages_Conditions))
    call TriggerAddAction(gg_trg_Event_Cages, function Trig_Event_Cages_Actions)
endfunction

//===========================================================================
// Trigger: Event Stormreaver 1
//===========================================================================
function Trig_Event_Stormreaver_1_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_Escaping == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_BridgeDestroyed == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Stormreaver_1_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_BridgeDestroyed=true
    // //
    call PauseUnitBJ(false, gg_unit_o61D_0140)
    call PauseUnitBJ(false, gg_unit_o61D_0141)
    call PauseUnitBJ(false, gg_unit_n61A_0040)
    call PauseUnitBJ(false, gg_unit_n61A_0185)
    call PauseUnitBJ(false, gg_unit_n61A_0021)
    call PauseUnitBJ(false, gg_unit_n00T_0243)
    // //
    call TriggerSleepAction(1.00)
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 2.00)
    call KillUnit(gg_unit_o61D_0140)
    call SetDestructableAnimationBJ(gg_dest_B00G_0060, "death")
    call SetDestAnimationSpeedPercent(gg_dest_B00G_0060, 50.00)
    call TriggerSleepAction(1.00)
    call KillUnit(gg_unit_o61D_0141)
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicBTG, 'O60U', GetCameraTargetPositionLoc(), gg_snd_WC2Orc13Rend_OrcScreams1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
endfunction

