function Trig_InitEnvironment_Actions takes nothing returns nothing
    // ----------------------------------------------------------------------------------------------------
    // Weather
    // ----------------------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 500.00, 2500.00, 0.50, 6.00, 8.00, 12.00)
    call SetTimeOfDay(0.00)
    call UseTimeOfDayBJ(false)
    call SetDayNightModels("", "")
    // ----------------------------------------------------------------------------------------------------
    // Sound
    // ----------------------------------------------------------------------------------------------------
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_AMBIENTSOUNDS, 0.00)
    call PlaySoundBJ(gg_snd_ToSAmbience)
    // ----------------------------------------------------------------------------------------------------
    // Doodads
    // ----------------------------------------------------------------------------------------------------
    call ShowDestructableBJ(false, gg_dest_B015_8775)
    call EnumDestructablesInRectAll(GetPlayableMapRect(), function Trig_InitEnvironment_Func017A)
    call EnumDestructablesInRectAll(GetPlayableMapRect(), function Trig_InitEnvironment_Func018A)
    call EnumDestructablesInRectAll(gg_rct_Escape_Blocker_East, function Trig_InitEnvironment_Func019A)
    call EnumDestructablesInRectAll(gg_rct_Escape_Blocker_West_1, function Trig_InitEnvironment_Func020A)
    call EnumDestructablesInRectAll(gg_rct_Escape_Blocker_West_2, function Trig_InitEnvironment_Func021A)
    // ///
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_West, function Trig_InitEnvironment_Func023A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_West, function Trig_InitEnvironment_Func024A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_West, function Trig_InitEnvironment_Func025A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_North, function Trig_InitEnvironment_Func026A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_North, function Trig_InitEnvironment_Func027A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_North, function Trig_InitEnvironment_Func028A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_SouthEast, function Trig_InitEnvironment_Func029A)
    call SetItemPositionLoc(gg_item_I001_0318, GetRectCenter(gg_rct_Boss_Blocker_SouthEast))
    // ///
    // hide drop crates
    call ShowDestructableBJ(false, gg_dest_LTcr_9038)
    call ShowDestructableBJ(false, gg_dest_LTcr_9039)
    call ShowDestructableBJ(false, gg_dest_LTcr_9036)
    call ShowDestructableBJ(false, gg_dest_LTcr_9037)
    call ShowDestructableBJ(false, gg_dest_LTcr_9040)
    call ShowDestructableBJ(false, gg_dest_LTcr_9041)
    call ShowDestructableBJ(false, gg_dest_LTcr_9042)
    call ShowDestructableBJ(false, gg_dest_LTcr_9043)
    call ShowDestructableBJ(false, gg_dest_LTcr_9044)
    call ShowDestructableBJ(false, gg_dest_LTcr_9045)
    call ShowDestructableBJ(false, gg_dest_LTcr_9046)
    call ShowDestructableBJ(false, gg_dest_LTcr_9047)
    call ShowDestructableBJ(false, gg_dest_LTcr_9048)
    call ShowDestructableBJ(false, gg_dest_LTcr_9049)
    call ShowDestructableBJ(false, gg_dest_LTcr_9050)
    call ShowDestructableBJ(false, gg_dest_LTcr_9051)
    call ShowDestructableBJ(false, gg_dest_LTcr_9052)
    call ShowDestructableBJ(false, gg_dest_LTcr_9053)
    // ///
    call SetDoodadAnimationRectBJ("death", 'ZZcd', gg_rct_Escape_Blocker_East)
    call KillDestructable(gg_dest_B603_0259)
    call KillDestructable(gg_dest_B603_8482)
    call KillDestructable(gg_dest_B603_0258)
    call KillDestructable(gg_dest_B603_8480)
    call KillDestructable(gg_dest_B603_8481)
    call KillDestructable(gg_dest_B603_8479)
    call SetDestAnimationSpeedPercent(gg_dest_B00N_1234, 0.00)
    call KillDestructable(gg_dest_B00G_0046)
    call SetDestructableAnimationBJ(gg_dest_B00G_0046, "stand")
    call KillDestructable(gg_dest_B00G_0060)
    call SetDestructableAnimationBJ(gg_dest_B00G_0060, "stand")
    // //
    // //
    // //
endfunction

