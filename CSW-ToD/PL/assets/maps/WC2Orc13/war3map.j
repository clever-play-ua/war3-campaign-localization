function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call EnableTrigger(gg_trg_Intro_Skipped)
    // ///
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // ///
    call ConditionalTriggerExecute(gg_trg_Intro_Setup)
    call TriggerSleepAction(0.50)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 3.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    set udg_Bool_InCinematic=true
    set udg_Bool_CinIntroOn=true
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_AMBIENTSOUNDS, 0.00)
    call PlaySoundBJ(gg_snd_ToSThemeIntro)
    call SetSoundVolumeBJ(gg_snd_ToSThemeIntro, 100.00)
    // ///
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_Intro_1_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_Intro_1_b, udg_Player_Actual, 9.00)
    // ///
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Cin_1_Goal_4))
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_Cin_1_Goal_2))
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_Cin_1_Goal_3))
    call IssuePointOrderLocBJ(udg_Unit_Grunt_1, "move", GetRectCenter(gg_rct_Cin_1_Goal_1))
    call IssuePointOrderLocBJ(udg_Unit_Grunt_2, "move", GetRectCenter(gg_rct_Cin_1_Goal_2))
    call IssuePointOrderLocBJ(udg_Unit_Spear_1, "move", GetRectCenter(gg_rct_Cin_1_Goal_1))
    call IssuePointOrderLocBJ(udg_Unit_Spear_2, "move", GetRectCenter(gg_rct_Cin_1_Goal_2))
    call PlaySoundBJ(gg_snd_CS_BG_Camp)
    call TriggerSleepAction(6.75)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_Intro_2_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cin_1_Intro_2_b, udg_Player_Actual, 4.00, 0, 1.00, 2.00)
    // ///
    call PlaySoundBJ(gg_snd_ToSEerieFX2)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssueImmediateOrderBJ(udg_FakeRend, "stop")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitFacingTimed(udg_FakeRend, 280.00, 1.00)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 1
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed1, bj_TIMETYPE_ADD, 0, false)
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 2.00)
    call SetUnitLookAt(udg_FakeZuluhed, "bone_head", udg_FakeRend, 0, 0, 90)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.50)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call IssueImmediateOrderBJ(udg_FakeZuluhed, "stop")
    call SetUnitAnimation(udg_FakeRend, "cinematic listening one")
    call SetUnitFacingTimed(udg_FakeZuluhed, 270.00, 1.00)
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rend 1
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc13Rend1, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeRend, "cinematic angry one")
    call QueueUnitAnimationBJ(udg_FakeRend, "cinematic standard one")
    call QueueUnitAnimationBJ(udg_FakeRend, "cinematic standard one")
    call WaitForSoundBJ(gg_snd_WC2Orc13Rend1, 2.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeRend, "cinematic point one")
    call QueueUnitAnimationBJ(udg_FakeRend, "cinematic listening one")
    call SetUnitBlendTimeBJ(udg_FakeRend, 2.00)
    call SetUnitLookAt(udg_FakeRend, "bone_head", udg_FakeZuluhed, 0, 0, 90)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rend1, 0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitFacingTimed(udg_FakeRend, 350.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rend1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 2
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed2, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.50)
    call ResetUnitLookAt(udg_FakeZuluhed)
    call ResetUnitLookAt(udg_FakeRend)
    call SetUnitFacingTimed(udg_FakeZuluhed, 0.00, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetFocalDistance(150.00)
    call SetSkyModel(null)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_Intro_3_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cin_1_Intro_3_b, udg_Player_Actual, 17.00, 3.00, 4.00, 2.00)
    // ///
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.50)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    call SetUnitMoveSpeed(udg_FakeRend, 150.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_1_Zuluhed_2), 0.00)
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_Cin_1_Rend_2), 0.00)
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_Cin_1_Maim_2), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_Grunt_1, GetRectCenter(gg_rct_Cin_1_Grunt_A_2), 320.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_Grunt_2, GetRectCenter(gg_rct_Cin_1_Grunt_B_2), 30.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_Spear_1, GetRectCenter(gg_rct_Cin_1_Spear_A_2), 350.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_Spear_2, GetRectCenter(gg_rct_Cin_1_Spear_B_2), 20.00)
    // ///
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_Cin_1_Zuluhed_3))
    call SetUnitFacingTimed(udg_FakeRend, 0.00, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Cin_1_Rend_3))
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 3
    // ----------------------------------------------------------------------------------------------------
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_Intro_4_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cin_1_Intro_4_b, udg_Player_Actual, 10.00, 4.00, 3.00, 2.00)
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed3, bj_TIMETYPE_ADD, 0, false)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_FakeRend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_1_Zuluhed_3), 95.00)
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_Cin_1_Rend_3), 75.00)
    call SetUnitFacingTimed(udg_FakeZuluhed, 130.00, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_Cin_1_Zuluhed_4))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Cin_1_Rend_4))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed3, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 4
    // ----------------------------------------------------------------------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_IntroZuluhedInteresting, udg_Player_Actual, 0)
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed4, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_Cin_1_Maim_3))
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed4, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 5
    // ----------------------------------------------------------------------------------------------------
    call SetUnitFacingTimed(udg_FakeZuluhed, 40.00, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_1_Intro_5_a, udg_Player_Actual, 0)
    call SetUnitLookAt(udg_FakeZuluhed, "bone_head", udg_FakeRend, 0, 0, 90)
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeRend, 0, 0, 90)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed5, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeMaim, "cinematic point one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeMaim, "cinematic listening one")
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeZuluhed, 0, 0, 90)
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_Cin_1_Maim_4))
    call SetUnitFacingTimed(udg_FakeZuluhed, 310.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed4, 1.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
