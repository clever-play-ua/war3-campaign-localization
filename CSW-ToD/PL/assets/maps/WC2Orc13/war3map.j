//===========================================================================
function Trig_Maim_I_Maim_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Maim_I_Maim_Func006C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B008') == true ) ) then
        return false
    endif
    return true
