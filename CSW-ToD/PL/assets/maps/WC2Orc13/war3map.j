    set gg_trg_Pirate_Drink=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Pirate_Drink, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Pirate_Drink, Condition(function Trig_Pirate_Drink_Conditions))
