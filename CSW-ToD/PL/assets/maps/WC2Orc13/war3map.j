//===========================================================================
// Trigger: Quest Guldan Create
//===========================================================================
function Trig_Quest_Guldan_Create_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Quest_Guldan_Create_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Create the quest objects
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3629", "TRIGSTR_3630", "ReplaceableTextures\\CommandButtons\\BTNGuldan.blp")
    set udg_MQLocateGuldan=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQLocateGuldan, "TRIGSTR_3631")
    set udg_QReq_FindGuldan=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQLocateGuldan, "TRIGSTR_3632")
    set udg_QReq_Survive=GetLastCreatedQuestItemBJ()
endfunction

//===========================================================================
function InitTrig_Quest_Guldan_Create takes nothing returns nothing
    set gg_trg_Quest_Guldan_Create=CreateTrigger()
    call TriggerAddCondition(gg_trg_Quest_Guldan_Create, Condition(function Trig_Quest_Guldan_Create_Conditions))
    call TriggerAddAction(gg_trg_Quest_Guldan_Create, function Trig_Quest_Guldan_Create_Actions)
endfunction

//===========================================================================
// Trigger: Quest Guldan Discover
//===========================================================================
function Trig_Quest_Guldan_Discover_Actions takes nothing returns nothing
    // Ensure that the quest exists
    call ConditionalTriggerExecute(gg_trg_Quest_Guldan_Create)
    // Update the quest
    call QuestSetDiscoveredBJ(udg_MQLocateGuldan, true)
    // Display a quest message.
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3628")
endfunction

//===========================================================================
function InitTrig_Quest_Guldan_Discover takes nothing returns nothing
    set gg_trg_Quest_Guldan_Discover=CreateTrigger()
    call TriggerAddAction(gg_trg_Quest_Guldan_Discover, function Trig_Quest_Guldan_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Quest Guldan Completed
//===========================================================================
function Trig_Quest_Guldan_Completed_Actions takes nothing returns nothing
    // Ensure that the quest exists
    call ConditionalTriggerExecute(gg_trg_Quest_Guldan_Create)
    // Update the quest
    call QuestSetDiscoveredBJ(udg_MQLocateGuldan, true)
    call QuestItemSetCompletedBJ(udg_QReq_FindGuldan, true)
    call QuestItemSetCompletedBJ(udg_QReq_Survive, true)
    call QuestSetCompletedBJ(udg_MQLocateGuldan, true)
    // Display a quest message.
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3627")
    call TriggerSleepAction(2)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc13Zuluhed_GuldanLocation1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    call QueuedTriggerAddBJ(gg_trg_Sargeras_Cinematic_Q, true)
endfunction

//===========================================================================
function InitTrig_Quest_Guldan_Completed takes nothing returns nothing
    set gg_trg_Quest_Guldan_Completed=CreateTrigger()
    call TriggerAddAction(gg_trg_Quest_Guldan_Completed, function Trig_Quest_Guldan_Completed_Actions)
endfunction

