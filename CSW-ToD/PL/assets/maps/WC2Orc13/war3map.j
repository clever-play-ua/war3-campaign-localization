//===========================================================================
// Trigger: Escape Units
//===========================================================================
function Trig_Escape_Units_Actions takes nothing returns nothing
    // ----------------------------------------------------------------------------------------------------
    // Make all of the computer players hate each other.
    // ----------------------------------------------------------------------------------------------------
    call SetItemVisibleBJ(true, gg_item_rspd_0394)
    call SetItemVisibleBJ(true, gg_item_rman_0395)
    call SetItemVisibleBJ(true, gg_item_rspd_0333)
    call SetItemVisibleBJ(true, gg_item_rres_0357)
    call SetItemVisibleBJ(true, gg_item_rman_0342)
    call SetItemVisibleBJ(true, gg_item_rres_0361)
    // ///
    call SetUnitManaPercentBJ(udg_Hero_Zuluhed, 100)
    call SetUnitLifePercentBJ(udg_Hero_Zuluhed, 100)
    call UnitResetCooldown(udg_Hero_Zuluhed)
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Hero_Zuluhed)
    call CreateNUnitsAtLoc(1, 'n00U', udg_Player_BurningLegion, GetRectCenter(gg_rct_Escape_Demons_6), 90.00)
    call SetUnitColor(GetLastCreatedUnit(), ConvertPlayerColor(24))
    call CreateNUnitsAtLoc(1, 'n00U', udg_Player_BurningLegion, GetRectCenter(gg_rct_Escape_Demons_7), 90.00)
    call SetUnitColor(GetLastCreatedUnit(), ConvertPlayerColor(24))
    call CreateNUnitsAtLoc(1, 'n00U', udg_Player_BurningLegion, GetRectCenter(gg_rct_Escape_Demons_8), 90.00)
    call SetUnitColor(GetLastCreatedUnit(), ConvertPlayerColor(24))
endfunction

