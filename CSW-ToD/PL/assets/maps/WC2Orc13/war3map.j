//===========================================================================
// Trigger: Artifact 10 Q
//===========================================================================
function Trig_Artifact_10_Q_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Artifact_10_Q_Func003C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Zuluhed) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Artifact_10_Q_Actions takes nothing returns nothing
    // Update Leaderboard
    call ConditionalTriggerExecute(gg_trg_Leaderboard_Update_10)
    if ( Trig_Artifact_10_Q_Func003C() ) then
        call AddSpecialEffectTargetUnitBJ("origin", udg_Hero_Zuluhed, "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        // Line
        call SetSpeechVolumeGroupsBJ()
        call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc13Zuluhed_Vision1, bj_TIMETYPE_ADD, 0, true)
        call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc13Zuluhed_Staff2, bj_TIMETYPE_ADD, 0, true)
        call VolumeGroupResetBJ()
    else
    endif
    // Update Quest
    call ConditionalTriggerExecute(gg_trg_Quest_Aluneth_Completed)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // Remove Leaderboard
    call ConditionalTriggerExecute(gg_trg_Leaderboard_Destroy)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Artifact_10_Q takes nothing returns nothing
    set gg_trg_Artifact_10_Q=CreateTrigger()
    call TriggerAddCondition(gg_trg_Artifact_10_Q, Condition(function Trig_Artifact_10_Q_Conditions))
    call TriggerAddAction(gg_trg_Artifact_10_Q, function Trig_Artifact_10_Q_Actions)
endfunction

//===========================================================================
// Trigger: Artifact Aegwynn
//===========================================================================
function Trig_Artifact_Aegwynn_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I001' ) ) then
        return false
    endif
    if ( not ( udg_Int_ArtifactFragmentsFound == 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Artifact_Aegwynn_Actions takes nothing returns nothing
    set udg_Point_Aluneth=GetItemLoc(GetManipulatedItem())
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'H004', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_Aluneth, GetUnitLoc(udg_Hero_Zuluhed))
    call SetHeroLevelBJ(GetLastCreatedUnit(), 10, false)
    call SetUnitVertexColorBJ(GetLastCreatedUnit(), 100.00, 100.00, 100.00, 75.00)
    call UnitAddAbilityBJ('Aetl', GetLastCreatedUnit())
    call UnitAddAbilityBJ('Avul', GetLastCreatedUnit())
    // //
    call RemoveLocation(udg_Point_Aluneth)
endfunction

//===========================================================================
function InitTrig_Artifact_Aegwynn takes nothing returns nothing
    set gg_trg_Artifact_Aegwynn=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Artifact_Aegwynn, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_Artifact_Aegwynn, Condition(function Trig_Artifact_Aegwynn_Conditions))
    call TriggerAddAction(gg_trg_Artifact_Aegwynn, function Trig_Artifact_Aegwynn_Actions)
endfunction

//===========================================================================
// Trigger: Event Escape Tomb Guard
//===========================================================================
function Trig_Event_Escape_Tomb_Guard_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_Escaping == true ) ) then
        return false
    endif
    if ( not ( BlzGetUnitAbilityCooldownRemaining(GetAttacker(), 'Awrs') == 0.00 ) ) then
        return false
    endif
    if ( not ( GetAttackedUnitBJ() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttacker()) == 'n00K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Escape_Tomb_Guard_Actions takes nothing returns nothing
    call PlaySoundOnUnitBJ(gg_snd_DoomguardRoar, 100, GetAttacker())
    call TriggerSleepAction(2.00)
    call IssueImmediateOrderBJ(GetAttacker(), "stomp")
endfunction

//===========================================================================
function InitTrig_Event_Escape_Tomb_Guard takes nothing returns nothing
    set gg_trg_Event_Escape_Tomb_Guard=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Event_Escape_Tomb_Guard, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_Event_Escape_Tomb_Guard, Condition(function Trig_Event_Escape_Tomb_Guard_Conditions))
    call TriggerAddAction(gg_trg_Event_Escape_Tomb_Guard, function Trig_Event_Escape_Tomb_Guard_Actions)
endfunction

//===========================================================================
// Trigger: Event Escape 1
//===========================================================================
function Trig_Event_Escape_1_Func008Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnumUnit()) == udg_Player_BurningLegion ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Escape_1_Func008A takes nothing returns nothing
    if ( Trig_Event_Escape_1_Func008Func001C() ) then
        call SetUnitColor(GetEnumUnit(), ConvertPlayerColor(24))
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call IssuePointOrderLocBJ(GetEnumUnit(), "attack", udg_Event_Escape_1)
    else
    endif
endfunction

function Trig_Event_Escape_1_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(1.00)
    set udg_Event_Escape_1=GetUnitLoc(udg_Hero_Zuluhed)
    call CreateNUnitsAtLoc(1, 'n00U', udg_Player_BurningLegion, GetRectCenter(gg_rct_Escape_Demons_1), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(2, 'n00U', udg_Player_BurningLegion, GetRectCenter(gg_rct_Escape_Demons_2), bj_UNIT_FACING)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_Escape_Spawn_1), function Trig_Event_Escape_1_Func008A)
    // //
    call TriggerSleepAction(1.00)
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicDragonMaw, 'O61F', GetCameraTargetPositionLoc(), gg_snd_WC2Orc13Zuluhed_Run1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
endfunction

//===========================================================================
function InitTrig_Event_Escape_1 takes nothing returns nothing
    set gg_trg_Event_Escape_1=CreateTrigger()
    call TriggerAddAction(gg_trg_Event_Escape_1, function Trig_Event_Escape_1_Actions)
endfunction

//===========================================================================
// Trigger: Event Escape 2
//===========================================================================
function Trig_Event_Escape_2_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_Escaping == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Escape_2_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(2.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Escape_Demons_3), "Units\\Undead\\Abomination\\AbominationExplosion.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    // //
    call CreateNUnitsAtLoc(1, 'n00K', udg_Player_BurningLegion, GetRectCenter(gg_rct_Escape_Demons_3), 270.00)
    call SetUnitColor(GetLastCreatedUnit(), ConvertPlayerColor(24))
    // //
    call SetUnitAnimation(GetLastCreatedUnit(), "stand victory")
    call TriggerSleepAction(2.00)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", GetUnitLoc(udg_Hero_Zuluhed))
endfunction

