function Trig_Periodic_Horror_Sounds_Actions takes nothing returns nothing
    set udg_Int_SoundChance=GetRandomInt(1, 13)
    if ( Trig_Periodic_Horror_Sounds_Func002C() ) then
        call PlaySoundBJ(gg_snd_ToSEerieFX1)
    else
        if ( Trig_Periodic_Horror_Sounds_Func002Func001C() ) then
            call PlaySoundBJ(gg_snd_ToSOrcScreamsFX1)
        else
            if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001C() ) then
                call PlaySoundBJ(gg_snd_ToSEerieFX2)
            else
                if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001C() ) then
                    call PlaySoundBJ(gg_snd_ToSOrcScreamsFX2)
                else
                    if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001Func001C() ) then
                        call PlaySoundBJ(gg_snd_ToSEerieFX3)
                    else
                        if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001Func001Func001C() ) then
                            call PlaySoundBJ(gg_snd_ToSOrcScreamsFX3)
                        else
                            if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001Func001Func001Func001C() ) then
                                call PlaySoundBJ(gg_snd_ToSEerieFX4)
                            else
                                if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001Func001Func001Func001Func001C() ) then
                                    call PlaySoundBJ(gg_snd_ToSOrcScreamsFX4)
                                else
                                    if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                        call PlaySoundBJ(gg_snd_ToSEerieFX5)
                                    else
                                        if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                            call PlaySoundBJ(gg_snd_ToSOrcScreamsFX5)
                                        else
                                            if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                call PlaySoundBJ(gg_snd_ToSOrcScreamsFX6)
                                            else
                                                if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                    call PlaySoundBJ(gg_snd_ToSOrcScreamsFX7)
                                                else
                                                    if ( Trig_Periodic_Horror_Sounds_Func002Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                        call PlaySoundBJ(gg_snd_ToSOrcScreamsFX8)
                                                    else
                                                    endif
                                                endif
                                            endif
                                        endif
                                    endif
                                endif
                            endif
                        endif
                    endif
                endif
            endif
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Periodic_Horror_Sounds takes nothing returns nothing
    set gg_trg_Periodic_Horror_Sounds=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Periodic_Horror_Sounds, GetRandomReal(15.00, 45.00))
    call TriggerAddCondition(gg_trg_Periodic_Horror_Sounds, Condition(function Trig_Periodic_Horror_Sounds_Conditions))
    call TriggerAddAction(gg_trg_Periodic_Horror_Sounds, function Trig_Periodic_Horror_Sounds_Actions)
endfunction

