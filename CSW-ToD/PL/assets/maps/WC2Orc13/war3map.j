function Trig_Sargeras_Cleanup_Func102A takes nothing returns nothing
    call SetItemVisibleBJ(true, GetEnumItem())
endfunction

function Trig_Sargeras_Cleanup_Func105C takes nothing returns boolean
    if ( not ( UnitInventoryCount(udg_Hero_Zuluhed) == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sargeras_Cleanup_Actions takes nothing returns nothing
    call CameraSetFocalDistance(0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Gameplay_Cam, udg_Player_Actual, 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // ///
    call ShowDestructableBJ(false, gg_dest_B015_8775)
    set udg_Bool_CinSargerasOn=false
    set udg_Bool_InCinematic=false
    // ----------------------------------------------------------------------------------------------------
    // Sounds and Music
    // ----------------------------------------------------------------------------------------------------
    call StopSoundBJ(gg_snd_ToSChainSwing1, true)
    call StopSoundBJ(gg_snd_ToSChainSwing2, true)
    call StopSoundBJ(gg_snd_ToSFelFireLoop, true)
    call StopSoundBJ(gg_snd_ToSGhostWolf, true)
    call StopSoundBJ(gg_snd_ToSGuldanGore, true)
    call StopSoundBJ(gg_snd_ToSSargerasBreakFree, true)
    call StopSoundBJ(gg_snd_RollingThunder1, true)
    call StopSoundBJ(gg_snd_EyeOfSargerasSound, true)
    // ///
    call StopSoundBJ(gg_snd_ACT_II_WarlockTheme, true)
    call StopSoundBJ(gg_snd_Demonic_Theme_2, true)
    call StopSoundBJ(gg_snd_Demonic_Theme_4, true)
    // ///
    call StopSoundBJ(gg_snd_WC2Orc13Guldan1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan2, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan3, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan4, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan5, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan6, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan7, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan8, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan9, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan10, true)
    call StopSoundBJ(gg_snd_WC2Orc13Guldan11, true)
    call StopSoundBJ(gg_snd_WC2Orc13Visage_Awegynn1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Visage_Awegynn2, true)
    call StopSoundBJ(gg_snd_WC2Orc13Visage_Doomhammer1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Visage_Guldan1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Visage_Medivh1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Visage_Medivh2, true)
    call StopSoundBJ(gg_snd_WC2Orc13Visage_Medivh3a, true)
    call StopSoundBJ(gg_snd_WC2Orc13Visage_Nerzhul1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Sargeras1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Sargeras2, true)
    call StopSoundBJ(gg_snd_WC2Orc13Sargeras3, true)
    // ----------------------------------------------------------------------------------------------------
    // Clear Units
    // ----------------------------------------------------------------------------------------------------
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Sargeras_Cleanup_Func050A)
    // ///
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Sargeras_Cleanup_Func052A)
    // ///
    call ForGroupBJ(udg_Group_HiddenUnitsEscape, function Trig_Sargeras_Cleanup_Func054A)
    // ///
    call PauseAllUnitsBJ(false)
    call RemoveUnit(udg_FakeAegwynnVisage)
    call RemoveUnit(udg_Unit_AvatarCinematic)
    call RemoveUnit(udg_FakeDoomhammer)
    call RemoveUnit(udg_FakeMedivh)
    call RemoveUnit(udg_FakeNerzulVisage)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // ///
    call ResetUnitLookAt(udg_FakeZuluhed)
    call ShowUnitHide(udg_FakeZuluhed)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Sargeras_Cleanup_Func068A)
    // ///
    call SetUnitOwner(udg_Hero_Rend, udg_Player_CinematicBTG, false)
    call SetUnitOwner(udg_Hero_Maim, udg_Player_CinematicBTG, false)
    // ///
    call ShowUnitShow(udg_Hero_Zuluhed)
    // ///
    if ( Trig_Sargeras_Cleanup_Func075C() ) then
        call SetHeroLevelBJ(udg_Hero_Zuluhed, 10, false)
        call SetUnitAbilityLevelSwapped('A00S', udg_Hero_Zuluhed, 3)
        call SetUnitAbilityLevelSwapped('A00U', udg_Hero_Zuluhed, 3)
    else
    endif
    // ///
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_ZuluhedEscapeStart), 270.00)
    call AddSpecialEffectTargetUnitBJ("overhead", udg_Hero_Zuluhed, "CSW\\Chapter13\\Lights\\DepthlessGlowAnimated.mdx")
    set udg_SE_LightZuluhed=GetLastCreatedEffectBJ()
    call SuspendHeroXPBJ(false, udg_Hero_Rend)
    call SuspendHeroXPBJ(false, udg_Hero_Maim)
    call SuspendHeroXPBJ(true, udg_Hero_Zuluhed)
    // ----------------------------------------------------------------------------------------------------
    // Environment
    // ----------------------------------------------------------------------------------------------------
    call EnumDestructablesInRectAll(gg_rct_Escape_Blocker_East, function Trig_Sargeras_Cleanup_Func086A)
    call EnumDestructablesInRectAll(gg_rct_Escape_Blocker_West_1, function Trig_Sargeras_Cleanup_Func087A)
    call EnumDestructablesInRectAll(gg_rct_Escape_Blocker_West_2, function Trig_Sargeras_Cleanup_Func088A)
    call DestructableRestoreLife(gg_dest_B603_0258, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
    call DestructableRestoreLife(gg_dest_B603_0259, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
    call DestructableRestoreLife(gg_dest_B603_8479, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
    call DestructableRestoreLife(gg_dest_B603_8480, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
    call DestructableRestoreLife(gg_dest_B603_8481, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
    call DestructableRestoreLife(gg_dest_B603_8482, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
    call SetTerrainFogExBJ(0, 500.00, 2500.00, 0.50, 6.00, 8.00, 12.00)
    call SetSkyModel(null)
    call SetPlayerAllianceStateBJ(udg_Player_BurningLegion, udg_Player_ShadowCouncil, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_ShadowCouncil, udg_Player_BurningLegion, bj_ALLIANCE_UNALLIED)
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // Unhide items
    // ----------------------------------------------------------------------------------------------------
    call EnumItemsInRectBJ(GetPlayableMapRect(), function Trig_Sargeras_Cleanup_Func102A)
    // ----------------------------------------------------------------------------------------------------
    // Give Guldans Head to Zuluhed
    if ( Trig_Sargeras_Cleanup_Func105C() ) then
        call UnitRemoveItemFromSlotSwapped(5, udg_Hero_Zuluhed)
        call UnitRemoveItemFromSlotSwapped(6, udg_Hero_Zuluhed)
        call TriggerSleepAction(0.25)
        call UnitAddItemByIdSwapped('I600', udg_Hero_Zuluhed)
    else
        call UnitAddItemByIdSwapped('I600', udg_Hero_Zuluhed)
    endif
    // ///
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    // ///
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // ----------------------------------------------------------------------------------------------------
    // StartQuests
    // ----------------------------------------------------------------------------------------------------
    call ClearMapMusicBJ()
    set udg_Music_CurrentName="Warcraft2\\Music\\ToSChaseMusic.mp3"
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call TriggerSleepAction(1.00)
    call QueuedTriggerAddBJ(gg_trg_Quest_Escape_Discover_Q, true)
endfunction

//===========================================================================
function InitTrig_Sargeras_Cleanup takes nothing returns nothing
    set gg_trg_Sargeras_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Sargeras_Cleanup, function Trig_Sargeras_Cleanup_Actions)
endfunction

