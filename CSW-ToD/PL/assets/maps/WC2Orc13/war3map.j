    set gg_trg_Artifact_Acquired=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Artifact_Acquired, Player(0), EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_Artifact_Acquired, Condition(function Trig_Artifact_Acquired_Conditions))
