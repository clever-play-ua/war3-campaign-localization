function InitTrig_Escape_Boss_Prep takes nothing returns nothing
    set gg_trg_Escape_Boss_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Escape_Boss_Prep, function Trig_Escape_Boss_Prep_Actions)
endfunction

