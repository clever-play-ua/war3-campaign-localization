function Trig_Victory_Setup_Func020A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Victory_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // ----------------------------------------------------------------------------------------------------
    // Environment
    // ----------------------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 500.00, 5500.00, 0.50, 2.00, 5.00, 3.00)
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetEntireMapRect())
    // ///
    call ShowDestructableBJ(true, gg_dest_B015_8765)
    call ShowDestructableBJ(true, gg_dest_B015_8766)
    call ShowDestructableBJ(true, gg_dest_B015_9065)
    call EnumDestructablesInRectAll(gg_rct_ExitRemovePB, function Trig_Victory_Setup_Func011A)
    call EnumDestructablesInRectAll(gg_rct_IntroSceneryWalls, function Trig_Victory_Setup_Func012A)
    call EnumDestructablesInRectAll(gg_rct_CinematicWallsBottom01, function Trig_Victory_Setup_Func013A)
    call EnumDestructablesInRectAll(gg_rct_CinematicWallsBottom02, function Trig_Victory_Setup_Func014A)
    // ///
    // ----------------------------------------------------------------------------------------------------
    // Hide Units
    // ----------------------------------------------------------------------------------------------------
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Victory_Setup_Func020A)
    call DestroyEffectBJ(udg_SE_LightZuluhed)
    call DestroyEffectBJ(udg_SE_LightFelfireElemental)
    call PauseAllUnitsBJ(true)
    // ----------------------------------------------------------------------------------------------------
    // Create Fake Actors
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_3_Zuluhed_3), 90.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.50)
    // ///
endfunction

//===========================================================================
function InitTrig_Victory_Setup takes nothing returns nothing
    set gg_trg_Victory_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Victory_Setup, function Trig_Victory_Setup_Actions)
endfunction

//===========================================================================
// Trigger: Victory Cinematic Q
//===========================================================================
function Trig_Victory_Cinematic_Q_Func025001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func029001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func046001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func053001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func057001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func062001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func073001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func080001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func088001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func091001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func101001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Func105001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Victory_Cinematic_Q_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Victory_Setup)
    call EnableTrigger(gg_trg_Victory_Skipped)
    // ///
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // ///
    set udg_Bool_CinSargerasOn=true
    set udg_Bool_InCinematic=true
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_AMBIENTSOUNDS, 0.00)
    call PlaySoundBJ(gg_snd_Horde_Intro_Theme_2)
    call SetSoundVolumeBJ(gg_snd_Horde_Intro_Theme_2, 75.00)
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC BEGINS - Cinematic Can Now Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ///
    call CameraSetFocalDistance(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_4_Victory_1_a, udg_Player_Actual, 0)
    // ///
    call PlaySoundBJ(gg_snd_RollingThunder1)
    call SetUnitAnimation(udg_FakeZuluhed, "stand channel")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "attack")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rakmar 1
    // ----------------------------------------------------------------------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_3_Boss_2_a, Player(0), 0)
    // ///
    call PlaySoundBJ(gg_snd_LightningBolt)
    call ShowUnitHide(udg_FakeZuluhed)
    call ShowUnitShow(udg_FakeRakmar)
    call PauseUnitBJ(false, udg_FakeRakmar)
    call SetUnitPositionLocFacingBJ(udg_FakeRakmar, GetRectCenter(gg_rct_Cin_3_Rakmar_1), 270.00)
    call SetUnitAnimation(udg_FakeRakmar, "stand ready")
    call AddSpecialEffectTargetUnitBJ("origin", udg_FakeRakmar, "Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl")
    call PlaySoundBJ(gg_snd_ShadeDeath1)
    call SetUnitAnimation(udg_FakeRakmar, "death")
    call SetUnitTimeScalePercent(udg_FakeRakmar, 10.00)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    // ///
    call StopSoundBJ(gg_snd_ShadeDeath1, true)
    call SetPlayerColorBJ(udg_Player_CinematicDummy, PLAYER_COLOR_BLUE, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRakmar, 0, gg_snd_WC2Orc13Rakmar_death1, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitTimeScalePercent(udg_FakeRakmar, 30.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rakmar_death1, 0.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call AddSpecialEffectTargetUnitBJ("origin", udg_FakeRakmar, "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 1
    // ----------------------------------------------------------------------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_3_Boss_3_b, udg_Player_Actual, 0)
    // ///
    call ShowUnitShow(udg_FakeZuluhed)
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 1.00)
    call SetUnitLookAt(udg_FakeZuluhed, "bone_head", udg_FakeRakmar, 0, 0, 90)
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_Cin_4_Zuluhed_1))
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeZuluhed), GetRectCenter(gg_rct_Cin_4_Zuluhed_1)) / GetUnitMoveSpeed(udg_FakeZuluhed) ))
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitFacingTimed(udg_FakeZuluhed, 180.00, 1.00)
    call ResetUnitLookAt(udg_FakeZuluhed)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "stand")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.50)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed_Final1, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic angry")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "stand")
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed_Final1, 0.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_Cin_1_Zuluhed_2))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_4_Victory_2_a, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cin_4_Victory_2_b, udg_Player_Actual, 8.00, 1.00, 3.00, 2.00)
    call SetSkyModel("Environment\\Sky\\LordaeronFallSky\\LordaeronFallSky.mdl")
    // ///
    call SetTerrainFogExBJ(0, 500.00, 3000.00, 0.50, 2.00, 5.00, 3.00)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_1_Maim_1), 180.00)
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_ZuluhedExit))
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    // ///
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // CINEMATIC ENDS - Cinematic Can No Longer Be Skipped
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ///
    call ConditionalTriggerExecute(gg_trg_Victory_Cleanup)
endfunction

//===========================================================================
function InitTrig_Victory_Cinematic_Q takes nothing returns nothing
    set gg_trg_Victory_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Victory_Cinematic_Q, function Trig_Victory_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Victory Skipped
//===========================================================================
function Trig_Victory_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinOutroSkipped=true
    // ----------------------------------------------------------------------------------------------------
    // Fade Out
    // ----------------------------------------------------------------------------------------------------
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    call StopMusicBJ(false)
    // ----------------------------------------------------------------------------------------------------
    // Cleanup
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Victory_Cleanup)
    call TriggerSleepAction(1.00)
    // ----------------------------------------------------------------------------------------------------
    // Start Game
    // ----------------------------------------------------------------------------------------------------
    call QueuedTriggerRemoveBJ(gg_trg_Victory_Cinematic_Q)
endfunction

//===========================================================================
function InitTrig_Victory_Skipped takes nothing returns nothing
    set gg_trg_Victory_Skipped=CreateTrigger()
    call DisableTrigger(gg_trg_Victory_Skipped)
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Victory_Skipped, Player(0))
    call TriggerAddAction(gg_trg_Victory_Skipped, function Trig_Victory_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Victory Cleanup
//===========================================================================
function Trig_Victory_Cleanup_Actions takes nothing returns nothing
    call CameraSetFocalDistance(0.00)
    // ///
    set udg_Bool_CinOutroOn=false
    set udg_Bool_InCinematic=false
    // ----------------------------------------------------------------------------------------------------
    // Sounds and Music
    // ----------------------------------------------------------------------------------------------------
    call StopSoundBJ(gg_snd_RollingThunder1, true)
    call StopSoundBJ(gg_snd_LightningBolt, true)
    call StopSoundBJ(gg_snd_ShadeDeath1, true)
    call StopSoundBJ(gg_snd_Horde_Intro_Theme_2, true)
    call StopSoundBJ(gg_snd_WC2Orc13Rakmar_death1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed_Final1, true)
    // ----------------------------------------------------------------------------------------------------
    // Clear Units
    // ----------------------------------------------------------------------------------------------------
    call RemoveUnit(udg_FakeRakmar)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // ///
    // ----------------------------------------------------------------------------------------------------
    // Environment
    // ----------------------------------------------------------------------------------------------------
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // ----------------------------------------------------------------------------------------------------
    // StartQuests
    // ----------------------------------------------------------------------------------------------------
    call TriggerSleepAction(0.25)
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

//===========================================================================
function InitTrig_Victory_Cleanup takes nothing returns nothing
    set gg_trg_Victory_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Victory_Cleanup, function Trig_Victory_Cleanup_Actions)
endfunction

