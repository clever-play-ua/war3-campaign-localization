//===========================================================================
// Trigger: Escape Prep
//===========================================================================
function Trig_Escape_Prep_Actions takes nothing returns nothing
    set udg_Bool_Escaping=true
    call ConditionalTriggerExecute(gg_trg_Escape_Environment)
    call ConditionalTriggerExecute(gg_trg_Escape_Units)
    call ConditionalTriggerExecute(gg_trg_Escape_Horror)
    // ----------------------------------------------------------------------------------------------------
    // Prep Timer
    // ----------------------------------------------------------------------------------------------------
    call CreateTimerDialogBJ(udg_Timer_Escape, "TRIGSTR_3661")
    set udg_TimerWindow_Escape=GetLastCreatedTimerDialogBJ()
    // ----------------------------------------------------------------------------------------------------
    // Start Escape Timer
    // ----------------------------------------------------------------------------------------------------
    call StartTimerBJ(udg_Timer_Escape, false, udg_Real_EscapeTime)
    call TimerDialogDisplayForPlayerBJ(true, udg_TimerWindow_Escape, Player(0))
    // ----------------------------------------------------------------------------------------------------
    // Ping the exit
    // ----------------------------------------------------------------------------------------------------
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetUnitLoc(udg_Hero_Zuluhed))
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, udg_Point_EscapeTripwire)
    call SelectUnitSingle(udg_Hero_Zuluhed)
    call ConditionalTriggerExecute(gg_trg_Event_Escape_1)
    call CreateFogModifierRectBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, gg_rct_Escape_Tripwire_2)
    call CameraSetSourceNoiseForPlayer(udg_Player_Actual, 15.00, 0.1)
endfunction

