    if ( not ( GetSpellAbilityId() == 'AOpR' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pirate_Drink_Actions takes nothing returns nothing
    call SetUnitAnimation(GetSpellAbilityUnit(), "spell")
    call QueueUnitAnimationBJ(GetSpellAbilityUnit(), "stand")
endfunction

//===========================================================================
