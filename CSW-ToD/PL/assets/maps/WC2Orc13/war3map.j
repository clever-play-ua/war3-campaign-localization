function Trig_Sargeras_Cinematic_Triggered_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sargeras_Cinematic_Triggered_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_Searching=false
    call QueuedTriggerAddBJ(gg_trg_Quest_Guldan_Completed_Q, true)
endfunction

//===========================================================================
function InitTrig_Sargeras_Cinematic_Triggered takes nothing returns nothing
    set gg_trg_Sargeras_Cinematic_Triggered=CreateTrigger()
    call TriggerRegisterUnitEvent(gg_trg_Sargeras_Cinematic_Triggered, gg_unit_n00S_0011, EVENT_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Sargeras_Cinematic_Triggered, Condition(function Trig_Sargeras_Cinematic_Triggered_Conditions))
    call TriggerAddAction(gg_trg_Sargeras_Cinematic_Triggered, function Trig_Sargeras_Cinematic_Triggered_Actions)
endfunction

//===========================================================================
// Trigger: Sargeras Setup
//===========================================================================
function Trig_Sargeras_Setup_Func012A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Sargeras_Setup_Func026A takes nothing returns nothing
    call SetItemVisibleBJ(false, GetEnumItem())
endfunction

function Trig_Sargeras_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetEntireMapRect())
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_CinematicDummy, GetEntireMapRect())
    // ----------------------------------------------------------------------------------------------------
    // Environment
    // ----------------------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 1000000000.00, 1000000000.00, 0.00, 5.00, 0.00, 35.00)
    // ----------------------------------------------------------------------------------------------------
    // Hide Units
    // ----------------------------------------------------------------------------------------------------
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Sargeras_Setup_Func012A)
    call DestroyEffectBJ(udg_SE_LightRend)
    call DestroyEffectBJ(udg_SE_LightMaim)
    call DestroyEffectBJ(udg_SE_LightZuluhed)
    call PauseAllUnitsBJ(true)
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    call SetPlayerAllianceStateBJ(udg_Player_BurningLegion, udg_Player_ShadowCouncil, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_ShadowCouncil, udg_Player_BurningLegion, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_CinematicBlackrock, udg_Player_BurningLegion, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BurningLegion, udg_Player_CinematicBlackrock, bj_ALLIANCE_NEUTRAL)
    // ----------------------------------------------------------------------------------------------------
    // Hide items
    // ----------------------------------------------------------------------------------------------------
    call EnumItemsInRectBJ(GetPlayableMapRect(), function Trig_Sargeras_Setup_Func026A)
    // ----------------------------------------------------------------------------------------------------
    // Create Fake Actors
    // ----------------------------------------------------------------------------------------------------
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeGuldan, GetRectCenter(gg_rct_Cin_2_Guldan_1), 0.00)
    // ///
    call CreateNUnitsAtLoc(1, 'N00R', Player(23), GetRectCenter(gg_rct_Cin_2_Sargeras), 185.00)
    set udg_Unit_AvatarCinematic=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_AvatarCinematic, "cinematic chained one")
    call SetUnitVertexColorBJ(udg_Unit_AvatarCinematic, 30.00, 30.00, 30.00, 0)
    // ///
    call SetDoodadAnimationBJ("death", 'ZZys', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    call SetDoodadAnimationBJ("death", 'D028', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    call SetDoodadAnimationBJ("death", 'D029', 2000.00, GetRectCenter(gg_rct_Cin_2_Guldan_2))
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_Cin_2_Rend_1), 80.00)
    call SetUnitAnimation(udg_FakeRend, "stand ready")
    call SetUnitMoveSpeed(udg_FakeRend, 200.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 200.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_FakeRend)
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_Cin_2_Maim_1), 90.00)
    call SetUnitAnimation(udg_FakeMaim, "stand ready")
    call SetUnitMoveSpeed(udg_FakeMaim, 200.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 200.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_FakeMaim)
    // ///
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_2_Zuluhed_1), 110.00)
    call SetUnitAnimation(udg_FakeZuluhed, "stand ready")
    call SetUnitMoveSpeed(udg_FakeZuluhed, 200.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 200.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_FakeZuluhed)
    //  
    call ShowDestructableBJ(true, gg_dest_B015_8775)
    // Disable Abilities
    //  
    call SetPlayerAbilityAvailableBJ(false, 'Ashm', udg_Player_Actual)
    //  
endfunction

