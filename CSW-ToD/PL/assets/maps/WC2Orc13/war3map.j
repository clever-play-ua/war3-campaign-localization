    if ( not ( GetUnitAbilityLevelSwapped('A00K', GetKillingUnitBJ()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Maim_I_Bloodthirst_Actions takes nothing returns nothing
    set udg_Maim_TempPoint_W=GetUnitLoc(GetDyingUnit())
    //  
    if ( Trig_Maim_I_Bloodthirst_Func004C() ) then
        set udg_Maim_Bloodthirst_Multiplier=0.04
    else
        if ( Trig_Maim_I_Bloodthirst_Func004Func001C() ) then
            set udg_Maim_Bloodthirst_Multiplier=0.07
        else
            if ( Trig_Maim_I_Bloodthirst_Func004Func001Func001C() ) then
                set udg_Maim_Bloodthirst_Multiplier=0.10
            else
            endif
        endif
    endif
    //  
    call AddSpecialEffectLocBJ(udg_Maim_TempPoint_W, "Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodAbomination.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //  
    call SetUnitLifeBJ(GetKillingUnitBJ(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetKillingUnitBJ()) + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetKillingUnitBJ()) * udg_Maim_Bloodthirst_Multiplier ) ))
    call AddSpecialEffectTargetUnitBJ("origin", GetKillingUnitBJ(), "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    //  
    call RemoveLocation(udg_Maim_TempPoint_W)
endfunction

