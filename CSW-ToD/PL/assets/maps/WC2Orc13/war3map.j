function Trig_Maim_I_Maim_Actions takes nothing returns nothing
    // Sound: Ability_Maim
    call PlaySoundOnUnitBJ(gg_snd_Ability_Maim, 75.00, GetSpellTargetUnit())
    //  
    set udg_Maim_TempPoint_E=GetUnitLoc(GetSpellTargetUnit())
    // Maim_Recklessness_Bonus
    if ( Trig_Maim_I_Maim_Func006C() ) then
        set udg_Maim_Recklessness_Bonus=1.50
    else
        set udg_Maim_Recklessness_Bonus=1.00
    endif
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(150.00, udg_Maim_TempPoint_E, Condition(function Trig_Maim_I_Maim_Func009001003)), function Trig_Maim_I_Maim_Func009A)
    //  
    call RemoveLocation(udg_Maim_TempPoint_E)
endfunction

