function Trig_Boss_Cleanup_Actions takes nothing returns nothing
    call CameraSetFocalDistance(0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_3_Gameplay_Cam, udg_Player_Actual, 0)
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_Boss_Fight_Limit)
    call BlzChangeMinimapTerrainTex("MinimapTombBossFight.tga")
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // ///
    set udg_Bool_CinRakmarOn=false
    set udg_Bool_InCinematic=false
    // ----------------------------------------------------------------------------------------------------
    // Sounds and Music
    // ----------------------------------------------------------------------------------------------------
    call StopSoundBJ(gg_snd_Demonic_Theme_2, false)
    call StopMusicBJ(false)
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_MUSIC, 100)
    // ///
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed_RakmarEncounter1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed_RakmarEncounter2, true)
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed_RakmarEncounter3, true)
    call StopSoundBJ(gg_snd_WC2Orc13Zuluhed_RakmarEncounter4, true)
    call StopSoundBJ(gg_snd_WC2Orc13Rakmar_Encounter1, true)
    call StopSoundBJ(gg_snd_WC2Orc13Rakmar_Encounter2, true)
    call StopSoundBJ(gg_snd_WC2Orc13Rakmar_Encounter3, true)
    // Unhide items
    // ----------------------------------------------------------------------------------------------------
    call EnumItemsInRectBJ(GetPlayableMapRect(), function Trig_Boss_Cleanup_Func027A)
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // ----------------------------------------------------------------------------------------------------
    // Clear Units
    // ----------------------------------------------------------------------------------------------------
    call ShowUnitHide(udg_FakeRakmar)
    call PauseUnitBJ(true, udg_FakeRakmar)
    call RemoveUnit(udg_Unit_RakmarShade)
    call SetUnitVertexColorBJ(udg_FakeRakmar, 100, 100, 100, 0)
    call SetUnitTimeScalePercent(udg_FakeRakmar, 100.00)
    // ///
    // ///
    // ///
    call ShowDestructableBJ(false, gg_dest_B015_8765)
    call ShowDestructableBJ(false, gg_dest_B015_8766)
    call ShowDestructableBJ(false, gg_dest_B015_9065)
    call EnumDestructablesInRectAll(gg_rct_IntroSceneryWalls, function Trig_Boss_Cleanup_Func044A)
    call EnumDestructablesInRectAll(gg_rct_CinematicWallsBottom01, function Trig_Boss_Cleanup_Func045A)
    call EnumDestructablesInRectAll(gg_rct_CinematicWallsBottom02, function Trig_Boss_Cleanup_Func046A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Boss_Cleanup_Func049A)
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    if ( Trig_Boss_Cleanup_Func052C() ) then
        call SetHeroLevelBJ(udg_Hero_Zuluhed, 10, false)
        call SetUnitAbilityLevelSwapped('A00S', udg_Hero_Zuluhed, 3)
        call SetUnitAbilityLevelSwapped('A00U', udg_Hero_Zuluhed, 3)
        call CreateItemLoc('I600', GetUnitLoc(udg_Hero_Zuluhed))
        call UnitAddItemSwapped(GetLastCreatedItem(), udg_Hero_Zuluhed)
    else
    endif
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_Cin_3_Zuluhed_3), 90.00)
    call AddSpecialEffectTargetUnitBJ("overhead", udg_Hero_Zuluhed, "CSW\\Chapter13\\Lights\\DepthlessGlowAnimated.mdx")
    set udg_SE_LightZuluhed=GetLastCreatedEffectBJ()
    call SetUnitAnimation(udg_Hero_Zuluhed, "stand ready")
    // ///
    call SuspendHeroXPBJ(false, udg_Hero_Rend)
    call SuspendHeroXPBJ(false, udg_Hero_Maim)
    call SuspendHeroXPBJ(true, udg_Hero_Zuluhed)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Boss_Cleanup_Func063A)
    // ///
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Boss_Cleanup_Func065A)
    // ----------------------------------------------------------------------------------------------------
    // Weather
    // ----------------------------------------------------------------------------------------------------
    call SetTerrainFogExBJ(0, 500.00, 2500.00, 0.50, 6.00, 8.00, 12.00)
    call SetSkyModel(null)
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // ----------------------------------------------------------------------------------------------------
    // StartQuests
    // ----------------------------------------------------------------------------------------------------
    call ClearMapMusicBJ()
    set udg_Music_CurrentName="Sound\\Music\\mp3music\\Doom.mp3"
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call TriggerSleepAction(0.25)
    call ConditionalTriggerExecute(gg_trg_Escape_Boss_Prep)
    call ConditionalTriggerExecute(gg_trg_Quest_Escape_Boss_Update)
    set udg_Bool_BossFight=true
    // ----------------------------------------------------------------------------------------------------
    // ----------------------------------------------------------------------------------------------------
endfunction

//===========================================================================
function InitTrig_Boss_Cleanup takes nothing returns nothing
    set gg_trg_Boss_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Boss_Cleanup, function Trig_Boss_Cleanup_Actions)
endfunction

