    set gg_trg_Artifact_01_Q=CreateTrigger()
    call TriggerAddCondition(gg_trg_Artifact_01_Q, Condition(function Trig_Artifact_01_Q_Conditions))
    call TriggerAddAction(gg_trg_Artifact_01_Q, function Trig_Artifact_01_Q_Actions)
