//===========================================================================
function Trig_InitUnits_Func004A takes nothing returns nothing
    call RemoveAllGuardPositions(GetEnumPlayer())
endfunction

function Trig_InitUnits_Func011Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'n00U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_InitUnits_Func011A takes nothing returns nothing
    if ( Trig_InitUnits_Func011Func001C() ) then
        call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnitsEscape)
    else
    endif
endfunction

function Trig_InitUnits_Func117A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_InitUnits_Func119A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_InitUnits_Actions takes nothing returns nothing
    // ----------------------------------------------------------------------------------------------------
    // Definition
    // ----------------------------------------------------------------------------------------------------
    call ForForce(GetPlayersAll(), function Trig_InitUnits_Func004A)
    // ///
    // ///
    // ----------------------------------------------------------------------------------------------------
    // Escape Preparation
    // ----------------------------------------------------------------------------------------------------
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_BurningLegion), function Trig_InitUnits_Func011A)
    call GroupAddUnitSimple(gg_unit_n00K_0388, udg_Group_HiddenUnitsEscape)
    call GroupAddUnitSimple(gg_unit_n00K_0389, udg_Group_HiddenUnitsEscape)
    call GroupAddUnitSimple(gg_unit_n00K_0381, udg_Group_HiddenUnitsEscape)
    call GroupAddUnitSimple(gg_unit_n00K_0380, udg_Group_HiddenUnitsEscape)
    call GroupAddUnitSimple(gg_unit_n00K_0416, udg_Group_HiddenUnitsEscape)
    // ----------------------------------------------------------------------------------------------------
    // Hide
    // ----------------------------------------------------------------------------------------------------
    call SetItemVisibleBJ(false, gg_item_rspd_0394)
    call SetItemVisibleBJ(false, gg_item_rman_0395)
    call SetItemVisibleBJ(false, gg_item_rspd_0333)
    call SetItemVisibleBJ(false, gg_item_rres_0357)
    call SetItemVisibleBJ(false, gg_item_rman_0342)
    call SetItemVisibleBJ(false, gg_item_rres_0361)
    // ///
    call GroupAddUnitSimple(gg_unit_u004_0329, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_u004_0344, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_u004_0332, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_u004_0345, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_u004_0346, udg_Group_HiddenUnits)
    // ///
    call PauseUnitBJ(true, gg_unit_o621_0052)
    call GroupAddUnitSimple(gg_unit_nvde_0082, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n617_0027, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n617_0032, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n61B_0038, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n61B_0080, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00K_0010, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00T_0338, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00T_0339, udg_Group_HiddenUnits)
    // ----------------------------------------------------------------------------------------------------
    // Anims etc.
    // ----------------------------------------------------------------------------------------------------
    call SetUnitAnimation(gg_unit_o60D_0235, "stand work")
    call SetUnitAnimation(gg_unit_o60D_0234, "stand work")
    call SetUnitTimeScalePercent(gg_unit_o60D_0234, 50.00)
    // ///
    call SetUnitAnimation(gg_unit_o61D_0253, "stand ready")
    call SetUnitAnimation(gg_unit_o61D_0255, "stand ready")
    call SetUnitAnimation(gg_unit_nsrn_0142, "stand channel")
    call SetUnitAnimation(gg_unit_nsrn_0239, "stand channel")
    call SetUnitAnimation(gg_unit_nsrn_0149, "stand channel")
    // ----------------------------------------------------------------------------------------------------
    // Campfire Heal
    // ----------------------------------------------------------------------------------------------------
    call UnitAddAbilityBJ('Anl1', gg_unit_u005_0327)
    // ----------------------------------------------------------------------------------------------------
    // Stormreaver Clan
    // ----------------------------------------------------------------------------------------------------
    call PauseUnitBJ(true, gg_unit_o61D_0140)
    call PauseUnitBJ(true, gg_unit_o61D_0141)
    call PauseUnitBJ(true, gg_unit_n00T_0243)
    call PauseUnitBJ(true, gg_unit_n61A_0040)
    call PauseUnitBJ(true, gg_unit_n61A_0185)
    call PauseUnitBJ(true, gg_unit_n61A_0021)
    call SetUnitAnimation(gg_unit_o61D_0140, "stand ready")
    call SetUnitAnimation(gg_unit_o61D_0141, "stand ready")
    // ///
    call PauseUnitBJ(true, gg_unit_n00I_0138)
    call PauseUnitBJ(true, gg_unit_n00I_0139)
    call PauseUnitBJ(true, gg_unit_o61D_0134)
    call PauseUnitBJ(true, gg_unit_o61D_0125)
    call PauseUnitBJ(true, gg_unit_nsrn_0147)
    call PauseUnitBJ(true, gg_unit_o61D_0126)
    call SetUnitAnimation(gg_unit_o61D_0125, "stand ready")
    call SetUnitAnimation(gg_unit_o61D_0126, "stand ready")
    call SetUnitAnimation(gg_unit_o61D_0134, "stand ready")
    call SetUnitAnimation(gg_unit_nsrn_0147, "stand ready")
    // ///
    call GroupAddUnitSimple(gg_unit_n00P_0015, udg_Group_HiddenUnits)
    call PauseUnitBJ(true, gg_unit_nsrn_0142)
    call PauseUnitBJ(true, gg_unit_nsrn_0149)
    call PauseUnitBJ(true, gg_unit_nsrn_0239)
    call SetUnitAnimation(gg_unit_nsrn_0142, "stand channel")
    call SetUnitAnimation(gg_unit_nsrn_0149, "stand channel")
    call SetUnitAnimation(gg_unit_nsrn_0239, "stand channel")
    // ///
    call SetUnitAnimation(gg_unit_o606_0228, "cinematic drink one")
    call SetUnitAnimation(gg_unit_o606_0227, "cinematic standard one")
    call SetUnitAnimation(gg_unit_o606_0226, "cinematic standard two")
    // ----------------------------------------------------------------------------------------------------
    // Highborne Ghosts & Fal'dorei
    // ----------------------------------------------------------------------------------------------------
    call GroupAddUnitSimple(gg_unit_n00I_0092, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00I_0069, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00I_0070, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00I_0071, udg_Group_HiddenUnits)
    // ///
    call GroupAddUnitSimple(gg_unit_n00M_0090, udg_Group_HiddenUnits)
    // ///
    call GroupAddUnitSimple(gg_unit_n00M_0124, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00M_0128, udg_Group_HiddenUnits)
    // ///
    call GroupAddUnitSimple(gg_unit_n00M_0179, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00M_0181, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00M_0184, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00M_0237, udg_Group_HiddenUnits)
    // ///
    call GroupAddUnitSimple(gg_unit_n00M_0121, udg_Group_HiddenUnits)
    call GroupAddUnitSimple(gg_unit_n00M_0127, udg_Group_HiddenUnits)
    call SetUnitAnimation(gg_unit_n002_0144, "stand ready")
    call SetUnitAnimation(gg_unit_o61D_0034, "stand ready")
    // ----------------------------------------------------------------------------------------------------
    // HIDE UNITS
    // ----------------------------------------------------------------------------------------------------
    call ForGroupBJ(udg_Group_HiddenUnitsEscape, function Trig_InitUnits_Func117A)
    // ----------------------------------------------------------------------------------------------------
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_InitUnits_Func119A)
    // ----------------------------------------------------------------------------------------------------
    // ----------------------------------------------------------------------------------------------------
    // ----------------------------------------------------------------------------------------------------
    // ----------------------------------------------------------------------------------------------------
endfunction

//===========================================================================
function InitTrig_InitUnits takes nothing returns nothing
    set gg_trg_InitUnits=CreateTrigger()
    call TriggerAddAction(gg_trg_InitUnits, function Trig_InitUnits_Actions)
endfunction

//===========================================================================
// Trigger: InitAudio
//===========================================================================
function Trig_InitAudio_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Music_DefaultNames[0]="Warcraft2\\Music\\ToSWalkTheme1.mp3;Warcraft2\\Music\\ToSWalkTheme3.mp3;Warcraft2\\Music\\ToSWalkTheme2.mp3;Warcraft2\\Music\\ToSWalkTheme4.mp3"
    set udg_Music_DefaultNames[1]="Warcraft2\\Music\\ToSWalkTheme2.mp3;Warcraft2\\Music\\ToSWalkTheme3.mp3;Warcraft2\\Music\\ToSWalkTheme4.mp3;Warcraft2\\Music\\ToSWalkTheme1.mp3"
    set udg_Music_DefaultNames[2]="Warcraft2\\Music\\ToSWalkTheme3.mp3;Warcraft2\\Music\\ToSWalkTheme2.mp3;Warcraft2\\Music\\ToSWalkTheme1.mp3;Warcraft2\\Music\\ToSWalkTheme4.mp3"
    set udg_Music_DefaultNames[3]="Warcraft2\\Music\\ToSWalkTheme2.mp3;Warcraft2\\Music\\ToSWalkTheme4.mp3;Warcraft2\\Music\\ToSWalkTheme1.mp3;Warcraft2\\Music\\ToSWalkTheme3.mp3"
    set udg_Music_DefaultNames[4]="Warcraft2\\Music\\ToSWalkTheme4.mp3;Warcraft2\\Music\\ToSWalkTheme3.mp3;Warcraft2\\Music\\ToSWalkTheme1.mp3;Warcraft2\\Music\\ToSWalkTheme2.mp3"
    set udg_Music_DefaultNames[5]="Warcraft2\\Music\\ToSWalkTheme1.mp3;Warcraft2\\Music\\ToSWalkTheme2.mp3;Warcraft2\\Music\\ToSWalkTheme3.mp3;Warcraft2\\Music\\ToSWalkTheme4.mp3"
    // //
    set udg_Music_DefaultNamesCount=6
    // //
    // SetMusicList with Randomizer
    set udg_Music_CurrentName=udg_Music_DefaultNames[GetRandomInt(0, 5)]
    set udg_Music_CurrentVolume=0.00
    // //
    call ClearMapMusicBJ()
endfunction

//===========================================================================
function InitTrig_InitAudio takes nothing returns nothing
    set gg_trg_InitAudio=CreateTrigger()
    call TriggerAddAction(gg_trg_InitAudio, function Trig_InitAudio_Actions)
endfunction

