    if ( not ( udg_Bool_Cheat == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sargeras_Cleanup_Func086Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B00R' ) ) then
        return false
    endif
    return true
endfunction

