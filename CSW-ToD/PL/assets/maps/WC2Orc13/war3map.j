    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_n00L_0033, 'n00L', gg_snd_ToSFaldoreiQueen2, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call TriggerSleepAction(GetRandomReal(1.00, 4.00))
    call ConditionalTriggerExecute(gg_trg_Event_Spider_1)
    call TriggerSleepAction(GetRandomReal(1.00, 4.00))
    call ConditionalTriggerExecute(gg_trg_Event_Spider_3)
    call TriggerSleepAction(GetRandomReal(1.00, 4.00))
    call ConditionalTriggerExecute(gg_trg_Event_Spider_2)
    call TriggerSleepAction(GetRandomReal(1.00, 4.00))
    call ConditionalTriggerExecute(gg_trg_Event_Spider_4)
endfunction

