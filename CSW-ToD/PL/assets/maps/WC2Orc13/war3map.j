// Trigger: Event Felhound Spawner 1
//===========================================================================
function Trig_Event_Felhound_Spawner_1_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_InCinematic == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Felhound_Spawner_1_Func002Func001001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Event_Felhound_Spawner_1_Func002Func001001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Event_Felhound_Spawner_1_Func002Func001001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Event_Felhound_Spawner_1_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_ClayPots04, Condition(function Trig_Event_Felhound_Spawner_1_Func002Func001001001002))) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Felhound_Spawner_1_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Event_Felhound_Spawner_1_Func002C() ) then
        call CreateNUnitsAtLoc(1, 'n61A', udg_Player_BurningLegion, udg_Event_FelhoundSpawner_1_TP, bj_UNIT_FACING)
        call SetUnitColor(GetLastCreatedUnit(), ConvertPlayerColor(24))
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Event_FelhoundPack_1_TP)
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        // ///
        call BlzSetUnitMaxHP(GetLastCreatedUnit(), ( BlzGetUnitMaxHP(GetLastCreatedUnit()) + ( GetUnitLevel(GetLastCreatedUnit()) * udg_EnemyHP ) ))
        call SetUnitLifePercentBJ(GetLastCreatedUnit(), 100)
        call BlzSetUnitWeaponIntegerFieldBJ(GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetLastCreatedUnit(), 0) + ( GetUnitLevel(GetLastCreatedUnit()) * udg_EnemyDMG ) ))
        call BlzSetUnitWeaponIntegerFieldBJ(GetLastCreatedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetLastCreatedUnit(), 1) + ( GetUnitLevel(GetLastCreatedUnit()) * udg_EnemyDMG ) ))
    else
    endif
endfunction

