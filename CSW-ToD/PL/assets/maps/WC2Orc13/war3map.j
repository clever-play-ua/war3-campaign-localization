function Trig_Escape_Final_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // ///
    call RemoveUnit(gg_unit_u004_0329)
    call RemoveUnit(gg_unit_u004_0344)
    call RemoveUnit(gg_unit_u004_0332)
    call RemoveUnit(gg_unit_u004_0345)
    call RemoveUnit(gg_unit_u004_0346)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_West, function Trig_Escape_Final_Func008A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_West, function Trig_Escape_Final_Func009A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_West, function Trig_Escape_Final_Func010A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_North, function Trig_Escape_Final_Func011A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_North, function Trig_Escape_Final_Func012A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_North, function Trig_Escape_Final_Func013A)
    call EnumDestructablesInRectAll(gg_rct_Boss_Blocker_SouthEast, function Trig_Escape_Final_Func014A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_ShadowCouncil, Condition(function Trig_Escape_Final_Func017001002)), function Trig_Escape_Final_Func017A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Escape_Final_Func019A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Escape_Final_Func021001002)), function Trig_Escape_Final_Func021A)
    call QueuedTriggerAddBJ(gg_trg_Quest_Guldan_Completed_Q, true)
    call QueuedTriggerAddBJ(gg_trg_Sargeras_Cinematic_Q, true)
    call QueuedTriggerAddBJ(gg_trg_Quest_Escape_Discover_Q, true)
endfunction

//===========================================================================
function InitTrig_Escape_Final takes nothing returns nothing
    set gg_trg_Escape_Final=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Escape_Final, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Escape_Final, Condition(function Trig_Escape_Final_Conditions))
    call TriggerAddAction(gg_trg_Escape_Final, function Trig_Escape_Final_Actions)
endfunction

//===========================================================================
// Trigger: Defeat Heroes Dead
//===========================================================================
function Trig_Defeat_Heroes_Dead_Func012C takes nothing returns boolean
    if ( ( GetDyingUnit() == udg_Hero_Rend ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_Hero_Maim ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_Hero_Zuluhed ) ) then
        return true
    endif
    return false
endfunction

function Trig_Defeat_Heroes_Dead_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not Trig_Defeat_Heroes_Dead_Func012C() ) then
        return false
    endif
    return true
endfunction

function Trig_Defeat_Heroes_Dead_Actions takes nothing returns nothing
    set udg_Bool_GameOver=true
    call TriggerSleepAction(2.00)
    call ConditionalTriggerExecute(gg_trg_Mission_Failed_Heroes_Dead)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call ClearSelectionForPlayer(udg_Player_Actual)
    call CinematicModeBJ(true, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
    call TriggerSleepAction(1.00)
    call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_3666")
endfunction

//===========================================================================
function InitTrig_Defeat_Heroes_Dead takes nothing returns nothing
    set gg_trg_Defeat_Heroes_Dead=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Defeat_Heroes_Dead, Player(0), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Defeat_Heroes_Dead, Condition(function Trig_Defeat_Heroes_Dead_Conditions))
    call TriggerAddAction(gg_trg_Defeat_Heroes_Dead, function Trig_Defeat_Heroes_Dead_Actions)
endfunction

//===========================================================================
// Trigger: Defeat Too Slow
//===========================================================================
function Trig_Defeat_Too_Slow_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_Escaping == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Defeat_Too_Slow_Actions takes nothing returns nothing
    set udg_Bool_GameOver=true
    // ///
    call SetDestructableAnimationBJ(gg_dest_B00F_0000, "death")
    call IssueImmediateOrderBJ(udg_Hero_Zuluhed, "stop")
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    call SetUnitTimeScalePercent(udg_Hero_Zuluhed, 50.00)
    call SetUnitAnimation(udg_Hero_Zuluhed, "death")
    // ///
    call QueuedTriggerAddBJ(gg_trg_Quest_Escape_Failed_Q, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call ClearSelectionForPlayer(udg_Player_Actual)
    call CinematicModeBJ(true, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
    call TriggerSleepAction(1.00)
    call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_3752")
endfunction

//===========================================================================
function InitTrig_Defeat_Too_Slow takes nothing returns nothing
    set gg_trg_Defeat_Too_Slow=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Defeat_Too_Slow, udg_Timer_Escape)
    call TriggerAddCondition(gg_trg_Defeat_Too_Slow, Condition(function Trig_Defeat_Too_Slow_Conditions))
    call TriggerAddAction(gg_trg_Defeat_Too_Slow, function Trig_Defeat_Too_Slow_Actions)
endfunction

