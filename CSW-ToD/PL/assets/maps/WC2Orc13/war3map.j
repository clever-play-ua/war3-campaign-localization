    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Pirate_Talk_1_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call UnitShareVisionBJ(true, gg_unit_o606_0232, udg_Player_Actual)
    call SetUnitAnimation(gg_unit_o606_0232, "stand victory")
    call QueueUnitAnimationBJ(gg_unit_o606_0232, "cinematic standard one")
    call QueueUnitAnimationBJ(gg_unit_o606_0232, "cinematic wave one")
    call QueueUnitAnimationBJ(gg_unit_o606_0232, "cinematic listening one")
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_o606_0232, 'o606', gg_snd_WC2Orc13GruntPirate_Encounter1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicBTG, 'O60U', GetCameraTargetPositionLoc(), gg_snd_WC2Orc13Rend_PirateEncounter1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call UnitShareVisionBJ(false, gg_unit_o606_0232, udg_Player_Actual)
    call KillDestructable(gg_dest_Ytlc_8233)
    call KillDestructable(gg_dest_Ytlc_8232)
    call KillDestructable(gg_dest_Ytlc_8231)
    call KillDestructable(gg_dest_Ytlc_8230)
    call KillDestructable(gg_dest_Ytlc_1710)
endfunction

