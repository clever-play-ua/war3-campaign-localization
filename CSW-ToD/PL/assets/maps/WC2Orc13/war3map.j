//===========================================================================
function Trig_VisModCave01On_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_VisibilityCaveOn[1] == false ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(0) ) ) then
        return false
    endif
    return true
