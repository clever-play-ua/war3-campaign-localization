//===========================================================================
// Trigger: InitReload
//===========================================================================
function Trig_InitReload_Func010Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_InitReload_Func010A takes nothing returns nothing
    if ( Trig_InitReload_Func010Func001C() ) then
        call SelectGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual))
    else
    endif
endfunction

function Trig_InitReload_Func018Func001C takes nothing returns boolean
    if ( not ( udg_Bool_BossFight == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_InitReload_Func018C takes nothing returns boolean
    if ( not ( udg_Bool_Escaping == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_InitReload_Actions takes nothing returns nothing
    call SetMapFacialAnimations()
    // //
    // DNC Restore
    // //
    call SetDayNightModels("", "")
    // //
    // Selection Restore
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_InitReload_Func010A)
    // //
    // Music Restore
    // //
    // Clear any pending music list
    call ClearMapMusicBJ()
    // //
    // Change Music list according to the loaded phase
    if ( Trig_InitReload_Func018C() ) then
        set udg_Music_CurrentName="Warcraft2\\Music\\ToSChaseMusic.mp3"
    else
        if ( Trig_InitReload_Func018Func001C() ) then
            set udg_Music_CurrentName="Sound\\Music\\mp3music\\Doom.mp3"
        else
        endif
    endif
    // //
    // Play music
    call PolledWait(0.10)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    // Handle Escape Part
    // //
endfunction

//===========================================================================
function InitTrig_InitReload takes nothing returns nothing
    set gg_trg_InitReload=CreateTrigger()
    call TriggerRegisterGameLoadedEventBJ(gg_trg_InitReload)
    call TriggerAddAction(gg_trg_InitReload, function Trig_InitReload_Actions)
endfunction

//===========================================================================
// Trigger: LaunchInGameMusic
//===========================================================================
function Trig_LaunchInGameMusic_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Music_CurrentVolume < 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LaunchInGameMusic_Actions takes nothing returns nothing
    call PlayMusicBJ(udg_Music_CurrentName)
    set udg_Int_C=1
    loop
        exitwhen udg_Int_C > 100
        if ( Trig_LaunchInGameMusic_Func002Func001C() ) then
            set udg_Music_CurrentVolume=( udg_Music_CurrentVolume + 1 )
            call SetMusicVolumeBJ(udg_Music_CurrentVolume)
            call TriggerSleepAction(0.02)
        else
        endif
        set udg_Int_C=udg_Int_C + 1
    endloop
endfunction

//===========================================================================
function InitTrig_LaunchInGameMusic takes nothing returns nothing
    set gg_trg_LaunchInGameMusic=CreateTrigger()
    call TriggerAddAction(gg_trg_LaunchInGameMusic, function Trig_LaunchInGameMusic_Actions)
endfunction

//===========================================================================
// Trigger: Neutral Smart Attack
//===========================================================================
function Trig_Neutral_Smart_Attack_Conditions takes nothing returns boolean
    if ( not ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetOrderTargetUnit()) != true ) ) then
        return false
    endif
    if ( not ( BlzIsSelectionEnabled() == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetOrderTargetUnit()) == Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetOrderTargetUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Neutral_Smart_Attack_Actions takes nothing returns nothing
    local unit u= GetOrderTargetUnit()
    set u=GetOrderTargetUnit()
    set udg_Neutral_Smart_Order=IssueTargetOrder(GetTriggerUnit(), "attack", u)
endfunction

//===========================================================================
function InitTrig_Neutral_Smart_Attack takes nothing returns nothing
    set gg_trg_Neutral_Smart_Attack=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Neutral_Smart_Attack, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddCondition(gg_trg_Neutral_Smart_Attack, Condition(function Trig_Neutral_Smart_Attack_Conditions))
    call TriggerAddAction(gg_trg_Neutral_Smart_Attack, function Trig_Neutral_Smart_Attack_Actions)
endfunction

