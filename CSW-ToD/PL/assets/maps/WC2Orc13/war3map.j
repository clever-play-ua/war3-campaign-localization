    call TriggerSleepAction(4.50)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitFacingTimed(udg_FakeRend, 135.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rend_Shreds1, 0.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Maim 1
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc13Maim_Shreds1, bj_TIMETYPE_ADD, 0, false)
    call SetUnitFacingTimed(udg_FakeRend, 110.00, 2.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Maim_Shreds1, 0.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 1
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed_GrabHead1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed_GrabHead1, 0.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rend 2
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc13Rend_GrabHead1, bj_TIMETYPE_ADD, 0, false)
    call SetUnitFacingTimed(udg_FakeRend, 80.00, 1.00)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rend_GrabHead1, 0.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call PlaySoundBJ(gg_snd_RollingThunder1)
    call SetUnitAnimation(udg_FakeZuluhed, "stand channel")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "stand channel")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "stand channel")
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Cin_2_Felhound_Head_5), "Abilities\\Spells\\Human\\CloudOfFog\\CloudOfFog.mdl")
    call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(), 2.00)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "blink", GetRectCenter(gg_rct_Cin_2_Felhound_Head_5))
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rend 3
    // ----------------------------------------------------------------------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Head_3_a, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cin_2_Head_3_b, udg_Player_Actual, 6.00, 0, 2.00, 3.00)
    // ///
    call AddSpecialEffectTargetUnitBJ("chest", udg_FakeZuluhed, "CSW\\Objects\\Inventoryitems\\BagAttachment\\BagAttachment.mdx")
    set udg_SE_Bag=GetLastCreatedEffectBJ()
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_Cin_2_Rend_2), 90.00)
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_Cin_2_Maim_2), 90.00)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_2_Zuluhed_2), 90.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Cin_2_Rend_3))
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_Cin_2_Maim_3))
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_Cin_2_Zuluhed_3))
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetDoodadAnimationRectBJ("stand", 'ZZcd', gg_rct_Escape_Blocker_East)
    call IssueImmediateOrderBJ(udg_FakeZuluhed, "stop")
    call SetUnitAnimation(udg_FakeZuluhed, "stand ready")
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUTIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 50.00, 50.00, 30.00, 50.00)
    call CameraSetEQNoiseForPlayer(Player(0), 5.00)
    call PlaySoundBJ(gg_snd_RockChunksDeath1)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call DestructableRestoreLife(gg_dest_B603_0259, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
    call DestructableRestoreLife(gg_dest_B603_8482, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
    call DestructableRestoreLife(gg_dest_B603_0258, GetDestructableMaxLife(GetLastCreatedDestructable()), false)
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_Cin_2_Rend_3), 270.00)
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_Cin_2_Maim_3), 270.00)
    call SetUnitAnimation(udg_FakeRend, "stand ready")
    call SetUnitAnimation(udg_FakeMaim, "stand ready")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Head_4_a, udg_Player_Actual, 0.00)
    // ///
    call CameraSetEQNoiseForPlayer(Player(0), 1.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc13Rend_Farewell1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rend_Farewell1, 0.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Zuluhed 2
    // ----------------------------------------------------------------------------------------------------
    call CameraSetupApplyForPlayer(true, gg_cam_Cin_2_Head_5_a, udg_Player_Actual, 0.00)
    // ///
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_Cin_2_Zuluhed_3), 90.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc13Zuluhed_GrabHead2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Zuluhed_GrabHead2, 0.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ----------------------------------------------------------------------------------------------------
    // Rend 4
    // ----------------------------------------------------------------------------------------------------
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc13Rend_Farewell2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Rend_Farewell2, 0.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic standard one")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call SetUnitFacingTimed(udg_FakeZuluhed, 270.00, 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinSargerasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ///
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_Cin_2_Zuluhed_2))
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    // ----------------------------------------------------------------------------------------------------
    // CINEMATIC ENDS - Cinematic Can No Longer Be Skipped
    // ----------------------------------------------------------------------------------------------------
    // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_Sargeras_Cleanup)
    call TriggerSleepAction(2.00)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Sargeras_Cinematic_Q takes nothing returns nothing
    set gg_trg_Sargeras_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Sargeras_Cinematic_Q, function Trig_Sargeras_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Sargeras Skipped
//===========================================================================
function Trig_Sargeras_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinSargerasOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sargeras_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinSargerasSkipped=true
    // ----------------------------------------------------------------------------------------------------
    // Fade Out
    // ----------------------------------------------------------------------------------------------------
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    // ----------------------------------------------------------------------------------------------------
    // Cleanup
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Sargeras_Cleanup)
    call TriggerSleepAction(1.00)
    // ----------------------------------------------------------------------------------------------------
    // Start Game
    // ----------------------------------------------------------------------------------------------------
    call QueuedTriggerRemoveBJ(gg_trg_Sargeras_Cinematic_Q)
endfunction

//===========================================================================
function InitTrig_Sargeras_Skipped takes nothing returns nothing
    set gg_trg_Sargeras_Skipped=CreateTrigger()
    call DisableTrigger(gg_trg_Sargeras_Skipped)
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Sargeras_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Sargeras_Skipped, Condition(function Trig_Sargeras_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Sargeras_Skipped, function Trig_Sargeras_Skipped_Actions)
endfunction

