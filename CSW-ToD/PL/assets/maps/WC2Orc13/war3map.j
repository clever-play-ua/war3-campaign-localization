//===========================================================================
// Trigger: VOPitLord
//===========================================================================
function Trig_VOPitLord_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetAttacker()) == udg_Player_Actual ) ) then
        return false
    endif
    return true
endfunction

