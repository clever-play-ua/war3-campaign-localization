function Trig_Enemy_Multiplier_Func010A takes nothing returns nothing
    call BlzSetUnitMaxHP(GetEnumUnit(), ( BlzGetUnitMaxHP(GetEnumUnit()) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyHP ) ))
    call SetUnitLifePercentBJ(GetEnumUnit(), 100)
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetEnumUnit(), 0) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyDMG ) ))
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetEnumUnit(), 1) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyDMG ) ))
endfunction

function Trig_Enemy_Multiplier_Func013A takes nothing returns nothing
    call BlzSetUnitMaxHP(GetEnumUnit(), ( BlzGetUnitMaxHP(GetEnumUnit()) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyHP ) ))
    call SetUnitLifePercentBJ(GetEnumUnit(), 100)
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetEnumUnit(), 0) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyDMG ) ))
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetEnumUnit(), 1) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyDMG ) ))
endfunction

function Trig_Enemy_Multiplier_Func016A takes nothing returns nothing
    call BlzSetUnitMaxHP(GetEnumUnit(), ( BlzGetUnitMaxHP(GetEnumUnit()) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyHP ) ))
    call SetUnitLifePercentBJ(GetEnumUnit(), 100)
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetEnumUnit(), 0) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyDMG ) ))
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetEnumUnit(), 1) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyDMG ) ))
endfunction

function Trig_Enemy_Multiplier_Func019A takes nothing returns nothing
    call BlzSetUnitMaxHP(GetEnumUnit(), ( BlzGetUnitMaxHP(GetEnumUnit()) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyHP ) ))
    call SetUnitLifePercentBJ(GetEnumUnit(), 100)
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetEnumUnit(), 0) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyDMG ) ))
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetEnumUnit(), 1) + ( GetUnitLevel(GetEnumUnit()) * udg_EnemyDMG ) ))
endfunction

function Trig_Enemy_Multiplier_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    //  
    if ( Trig_Enemy_Multiplier_Func003C() ) then
        set udg_EnemyHP=25
        set udg_EnemyDMG=1
    else
    endif
    //  
    if ( Trig_Enemy_Multiplier_Func005C() ) then
        set udg_EnemyHP=50
        set udg_EnemyDMG=2
    else
    endif
    //  
    if ( Trig_Enemy_Multiplier_Func007C() ) then
        set udg_EnemyHP=75
        set udg_EnemyDMG=3
    else
    endif
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_ShadowCouncil), function Trig_Enemy_Multiplier_Func010A)
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_TwilightHammer), function Trig_Enemy_Multiplier_Func013A)
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_BurningLegion), function Trig_Enemy_Multiplier_Func016A)
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Ghosts), function Trig_Enemy_Multiplier_Func019A)
    //  
endfunction

