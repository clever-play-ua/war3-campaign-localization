    set gg_trg_Event_Felhound_Spawner_1=CreateTrigger()
    call DisableTrigger(gg_trg_Event_Felhound_Spawner_1)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Event_Felhound_Spawner_1, 6.00)
    call TriggerAddCondition(gg_trg_Event_Felhound_Spawner_1, Condition(function Trig_Event_Felhound_Spawner_1_Conditions))
