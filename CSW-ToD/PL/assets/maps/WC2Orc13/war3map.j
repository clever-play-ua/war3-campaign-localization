    call UnitShareVisionBJ(true, gg_unit_nsrn_0142, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_nsrn_0149, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_nsrn_0239, udg_Player_Actual)
    call GroupAddUnitSimple(gg_unit_nsrn_0142, udg_Group_WarlockTimer)
    call GroupAddUnitSimple(gg_unit_nsrn_0239, udg_Group_WarlockTimer)
    call GroupAddUnitSimple(gg_unit_nsrn_0149, udg_Group_WarlockTimer)
    // ----------------------------------------------------------------------------------------------------
    // Prep Timer
    // ----------------------------------------------------------------------------------------------------
    call CreateTimerDialogBJ(udg_Timer_Warlock, "TRIGSTR_3714")
    set udg_TimerWindow_Warlock=GetLastCreatedTimerDialogBJ()
    // ----------------------------------------------------------------------------------------------------
    // Start Escape Timer
    // ----------------------------------------------------------------------------------------------------
    call StartTimerBJ(udg_Timer_Warlock, false, udg_Real_SummoningBeholderTime)
    call TimerDialogDisplayForPlayerBJ(true, udg_TimerWindow_Escape, udg_Player_Actual)
    // ///
    call EnableTrigger(gg_trg_Event_Stormreaver_3_a)
    call EnableTrigger(gg_trg_Event_Stormreaver_3_b)
    // ///
    call WaitForSoundBJ(gg_snd_WC2Orc13Rend_WarlockServants1, 0.00)
    call VolumeGroupResetBJ()
endfunction

