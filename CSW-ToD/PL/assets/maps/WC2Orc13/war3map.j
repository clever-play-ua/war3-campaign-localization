//===========================================================================
// Trigger: Boss Skipped
//===========================================================================
function Trig_Boss_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinRakmarOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boss_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinRakmarSkipped=true
    // ----------------------------------------------------------------------------------------------------
    // Fade Out
    // ----------------------------------------------------------------------------------------------------
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    // ----------------------------------------------------------------------------------------------------
    // Cleanup
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Boss_Cleanup)
    call TriggerSleepAction(1.00)
    // ----------------------------------------------------------------------------------------------------
    // Start Game
    // ----------------------------------------------------------------------------------------------------
    call QueuedTriggerRemoveBJ(gg_trg_Boss_Cinematic_Q)
endfunction

//===========================================================================
function InitTrig_Boss_Skipped takes nothing returns nothing
    set gg_trg_Boss_Skipped=CreateTrigger()
    call DisableTrigger(gg_trg_Boss_Skipped)
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Boss_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Boss_Skipped, Condition(function Trig_Boss_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Boss_Skipped, function Trig_Boss_Skipped_Actions)
endfunction

