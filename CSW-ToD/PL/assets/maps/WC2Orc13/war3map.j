    endif
    return true
endfunction

function Trig_InitDifficulty_Func020A takes nothing returns nothing
    if ( Trig_InitDifficulty_Func020Func001C() ) then
        call SetUnitAbilityLevelSwapped('ATFF', GetEnumUnit(), 1)
    else
        if ( Trig_InitDifficulty_Func020Func001Func001C() ) then
            call SetUnitAbilityLevelSwapped('ATFF', GetEnumUnit(), 2)
        else
            if ( Trig_InitDifficulty_Func020Func001Func001Func002C() ) then
                call SetUnitAbilityLevelSwapped('ATFF', GetEnumUnit(), 3)
            else
            endif
        endif
    endif
endfunction

function Trig_InitDifficulty_Actions takes nothing returns nothing
    // //
    // Upgrades
    // //
    if ( Trig_InitDifficulty_Func004C() ) then
        // //
        call SetPlayerTechResearchedSwap('R003', 0, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00Q', 0, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00Q', 0, udg_Player_ShadowCouncil)
        // //
        call SetPlayerTechResearchedSwap('R00T', 0, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00S', 0, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R010', 0, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R011', 0, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00Z', 0, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R60K', 0, udg_Player_TwilightHammer)
        // //
        call SetPlayerTechResearchedSwap('R00T', 0, udg_Player_ShadowCouncil)
        call SetPlayerTechResearchedSwap('R00S', 0, udg_Player_ShadowCouncil)
    else
    endif
    // //
    if ( Trig_InitDifficulty_Func006C() ) then
        // //
        call SetPlayerTechResearchedSwap('R003', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00Q', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00Q', 1, udg_Player_ShadowCouncil)
        // //
        call SetPlayerTechResearchedSwap('R00T', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00S', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R010', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R011', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00Z', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R60K', 1, udg_Player_TwilightHammer)
        // //
        call SetPlayerTechResearchedSwap('R00T', 1, udg_Player_ShadowCouncil)
        call SetPlayerTechResearchedSwap('R00S', 1, udg_Player_ShadowCouncil)
    else
    endif
    // //
    if ( Trig_InitDifficulty_Func008C() ) then
        // //
        call SetPlayerTechResearchedSwap('R003', 2, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00Q', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00Q', 1, udg_Player_ShadowCouncil)
        // //
        call SetPlayerTechResearchedSwap('R00T', 2, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00S', 2, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R010', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R011', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R00Z', 1, udg_Player_TwilightHammer)
        call SetPlayerTechResearchedSwap('R60K', 2, udg_Player_TwilightHammer)
        // //
        call SetPlayerTechResearchedSwap('R00T', 2, udg_Player_ShadowCouncil)
        call SetPlayerTechResearchedSwap('R00S', 2, udg_Player_ShadowCouncil)
    else
    endif
    // //
    // //
    if ( Trig_InitDifficulty_Func011C() ) then
        set udg_Real_EscapeTime=180.00
        set udg_Real_SummoningBeholderTime=30.00
        call SetUnitAbilityLevelSwapped('ATFF', gg_unit_n00S_0011, 1)
    else
        if ( Trig_InitDifficulty_Func011Func001C() ) then
            set udg_Real_EscapeTime=150.00
            set udg_Real_SummoningBeholderTime=25.00
            call SetUnitAbilityLevelSwapped('ATFF', gg_unit_n00S_0011, 2)
        else
            if ( Trig_InitDifficulty_Func011Func001Func001C() ) then
                set udg_Real_EscapeTime=120.00
                set udg_Real_SummoningBeholderTime=20.00
                call SetUnitAbilityLevelSwapped('ATFF', gg_unit_n00S_0011, 3)
            else
            endif
        endif
    endif
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_BurningLegion, 'n617'), function Trig_InitDifficulty_Func014A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_BurningLegion, 'n00T'), function Trig_InitDifficulty_Func017A)
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_BurningLegion, 'n00K'), function Trig_InitDifficulty_Func020A)
    // ///
    // ///
    // ///
    // ///
endfunction

