    if ( not ( GetOwningPlayer(GetEventDamageSource()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_Escaping == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_SpiderMemeHappened == false ) ) then
        return false
    endif
    return true
endfunction

