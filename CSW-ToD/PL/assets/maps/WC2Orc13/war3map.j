    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I001' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Artifact_Acquired_Func003001 takes nothing returns boolean
    return ( udg_Item_Artifact != null )
endfunction

function Trig_Artifact_Acquired_Func007001 takes nothing returns boolean
    return ( udg_Int_ArtifactFragmentsFound == 1 )
endfunction

function Trig_Artifact_Acquired_Func008001 takes nothing returns boolean
    return ( udg_Int_ArtifactFragmentsFound == 2 )
endfunction

