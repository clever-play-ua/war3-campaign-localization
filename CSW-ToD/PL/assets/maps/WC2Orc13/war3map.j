//===========================================================================
function Trig_BossKilled_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( GetDyingUnit() == udg_Hero_Rakmar ) ) then
        return false
    endif
    if ( not ( udg_Bool_BossFight == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BossKilled_Actions takes nothing returns nothing
    call ClearMapMusicBJ()
    set udg_Music_CurrentName=udg_Music_DefaultNames[GetRandomInt(0, 5)]
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    set udg_Bool_BossFight=false
    set udg_Bool_GameOver=true
    call ConditionalTriggerExecute(gg_trg_Victory_Cinematic_Q)
endfunction

