    set gg_trg_Event_Faldorei_1=CreateTrigger()
    call DisableTrigger(gg_trg_Event_Faldorei_1)
    call TriggerRegisterEnterRectSimple(gg_trg_Event_Faldorei_1, gg_rct_Spider_Tripwire_1)
    call TriggerAddCondition(gg_trg_Event_Faldorei_1, Condition(function Trig_Event_Faldorei_1_Conditions))
    call TriggerAddAction(gg_trg_Event_Faldorei_1, function Trig_Event_Faldorei_1_Actions)
endfunction

