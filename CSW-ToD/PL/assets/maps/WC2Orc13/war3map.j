//===========================================================================
// Trigger: Leaderboard Create
//===========================================================================
function Trig_Leaderboard_Create_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_ArtifactLeaderboardExists == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leaderboard_Create_Actions takes nothing returns nothing
    set udg_Bool_ArtifactLeaderboardExists=true
    // Create
    call CreateLeaderboardBJ(udg_PlayerGroup_PlayerActual, "TRIGSTR_3655")
    set udg_Leaderboard_Artifact=GetLastCreatedLeaderboard()
    // Add Entries
    call LeaderboardAddItemBJ(Player(0), udg_Leaderboard_Artifact, "TRIGSTR_3590", 0)
    // Customize
    call LeaderboardSetLabelColorBJ(GetLastCreatedLeaderboard(), 100, 80, 20, 0)
    call LeaderboardSetStyleBJ(udg_Leaderboard_Artifact, false, true, false, false)
    call LeaderboardDisplayBJ(true, udg_Leaderboard_Artifact)
endfunction

//===========================================================================
function InitTrig_Leaderboard_Create takes nothing returns nothing
    set gg_trg_Leaderboard_Create=CreateTrigger()
    call TriggerAddCondition(gg_trg_Leaderboard_Create, Condition(function Trig_Leaderboard_Create_Conditions))
    call TriggerAddAction(gg_trg_Leaderboard_Create, function Trig_Leaderboard_Create_Actions)
endfunction

