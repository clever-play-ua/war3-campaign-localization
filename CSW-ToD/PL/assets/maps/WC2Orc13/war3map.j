    set gg_trg_Zuluhed_I_Call_of_the_Elements=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Zuluhed_I_Call_of_the_Elements, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Zuluhed_I_Call_of_the_Elements, Condition(function Trig_Zuluhed_I_Call_of_the_Elements_Conditions))
    call TriggerAddAction(gg_trg_Zuluhed_I_Call_of_the_Elements, function Trig_Zuluhed_I_Call_of_the_Elements_Actions)
