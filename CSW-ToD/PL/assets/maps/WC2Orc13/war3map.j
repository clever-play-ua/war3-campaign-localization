//===========================================================================
// Trigger: Event Void Talk
//===========================================================================
function Trig_Event_Void_Talk_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_Escaping == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Void_Talk_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call UnitShareVisionBJ(true, gg_unit_o621_0052, udg_Player_Actual)
    call SetUnitInvulnerable(gg_unit_o621_0052, true)
    call SetUnitAnimation(gg_unit_o621_0052, "stand victory")
    call QueueUnitAnimationBJ(gg_unit_o621_0052, "stand ready")
    call TriggerSleepAction(1.00)
    // ///
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_o621_0052, 'o621', gg_snd_WC2Orc13Fanatic_THammer1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Fanatic_THammer1, 0)
    // ///
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicBTG, 'O60U', GetCameraTargetPositionLoc(), gg_snd_WC2Orc13Rend_THammer1, bj_TIMETYPE_ADD, 0, true)
    // ///
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_o621_0052, 'o621', gg_snd_WC2Orc13Fanatic_THammer3, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc13Fanatic_THammer3, 8.00)
    call AddSpecialEffectLocBJ(GetUnitLoc(gg_unit_o621_0052), "Abilities\\Spells\\Items\\AIso\\AIsoTarget.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call WaitForSoundBJ(gg_snd_WC2Orc13Fanatic_THammer3, 5.00)
    call ShowUnitHide(gg_unit_o621_0052)
    call PauseUnitBJ(true, gg_unit_o621_0052)
    call ShowUnitShow(gg_unit_nvde_0082)
    call SetUnitPositionLocFacingBJ(gg_unit_nvde_0082, GetUnitLoc(gg_unit_o621_0052), 270.00)
    call PauseUnitBJ(false, gg_unit_nvde_0082)
    call WaitForSoundBJ(gg_snd_WC2Orc13Fanatic_THammer3, 0)
    // ///
    call VolumeGroupResetBJ()
    call PauseUnitBJ(false, gg_unit_o621_0052)
    call SetUnitInvulnerable(gg_unit_o621_0052, false)
    call UnitShareVisionBJ(false, gg_unit_o621_0052, udg_Player_Actual)
endfunction

