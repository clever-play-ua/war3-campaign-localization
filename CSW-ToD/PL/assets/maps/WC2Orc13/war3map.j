    call AddSpecialEffectLocBJ(udg_Event_Boss_TP1, "Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call CreateNUnitsAtLoc(1, 'u60A', udg_Player_ShadowCouncil, udg_Event_Boss_TP1, bj_UNIT_FACING)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Event_Boss_TP_Zuluhed)
    // ///
    call AddSpecialEffectLocBJ(udg_Event_Boss_TP2, "Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl")
