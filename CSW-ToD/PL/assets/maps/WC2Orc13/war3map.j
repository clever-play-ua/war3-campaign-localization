function Trig_Event_Stormreaver_3_c_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Stormreaver_3_c_Func003Func004001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_ShadowCouncil )
endfunction

function Trig_Event_Stormreaver_3_c_Func003Func004001002002 takes nothing returns boolean
    return ( IsUnitDeadBJ(GetFilterUnit()) == true )
endfunction

function Trig_Event_Stormreaver_3_c_Func003Func004001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_ShadowCouncil), (IsUnitDeadBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Event_Stormreaver_3_c_Func003Func004A takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ("origin", GetEnumUnit(), "Units\\Undead\\Abomination\\AbominationExplosion.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
endfunction

function Trig_Event_Stormreaver_3_c_Func003Func016A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Event_Stormreaver_3_c_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_WarlockTimer) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Event_Stormreaver_3_c_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Event_Stormreaver_3_c_Func003C() ) then
        call RemoveDestructable(gg_dest_B003_8236)
        // //
        call CreateItemLoc('rspl', GetRectCenter(gg_rct_Stormreaver_Demon_Summon))
        // //
        call ForGroupBJ(udg_Group_WarlockTimer, function Trig_Event_Stormreaver_3_c_Func003Func016A)
        // //
    else
        call RemoveDestructable(gg_dest_B003_8236)
        // //
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(gg_rct_SummingBeholder, Condition(function Trig_Event_Stormreaver_3_c_Func003Func004001002)), function Trig_Event_Stormreaver_3_c_Func003Func004A)
        // //
        call ShowUnitShow(gg_unit_n00P_0015)
        call PauseUnitBJ(false, gg_unit_n00P_0015)
        // //
        call AddSpecialEffectTargetUnitBJ("origin", gg_unit_n00P_0015, "Objects\\Spawnmodels\\Undead\\UCancelDeath\\UCancelDeath.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        // //
    endif
endfunction

