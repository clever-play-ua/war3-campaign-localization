    return ( udg_Int_ArtifactFragmentsFound == 4 )
endfunction

function Trig_Artifact_Acquired_Func011001 takes nothing returns boolean
    return ( udg_Int_ArtifactFragmentsFound == 5 )
endfunction

function Trig_Artifact_Acquired_Func012001 takes nothing returns boolean
    return ( udg_Int_ArtifactFragmentsFound == 6 )
endfunction

function Trig_Artifact_Acquired_Func013001 takes nothing returns boolean
    return ( udg_Int_ArtifactFragmentsFound == 7 )
endfunction

function Trig_Artifact_Acquired_Func014001 takes nothing returns boolean
    return ( udg_Int_ArtifactFragmentsFound == 8 )
endfunction

function Trig_Artifact_Acquired_Func015001 takes nothing returns boolean
    return ( udg_Int_ArtifactFragmentsFound == 9 )
endfunction

function Trig_Artifact_Acquired_Func016001 takes nothing returns boolean
    return ( udg_Int_ArtifactFragmentsFound == 10 )
endfunction

function Trig_Artifact_Acquired_Actions takes nothing returns nothing
    set udg_Int_ArtifactFragmentsFound=( udg_Int_ArtifactFragmentsFound + 1 )
    // Replace the item
    if ( (udg_Item_Artifact != null) ) then // INLINED!!
        call RemoveItem(udg_Item_Artifact)
    else
        call DoNothing()
    endif
    call UnitAddItemByIdSwapped(udg_ItemType_ArtifactTypes[udg_Int_ArtifactFragmentsFound], udg_Hero_Zuluhed)
    set udg_Item_Artifact=GetLastCreatedItem()
    // Handle Quest Messages
    if ( (udg_Int_ArtifactFragmentsFound == 1) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_01_Q, true)
    else
        call DoNothing()
    endif
    if ( (udg_Int_ArtifactFragmentsFound == 2) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_02_Q, true)
    else
        call DoNothing()
    endif
    if ( (udg_Int_ArtifactFragmentsFound == 3) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_03_Q, true)
    else
        call DoNothing()
    endif
    if ( (udg_Int_ArtifactFragmentsFound == 4) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_04_Q, true)
    else
        call DoNothing()
    endif
    if ( (udg_Int_ArtifactFragmentsFound == 5) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_05_Q, true)
    else
        call DoNothing()
    endif
    if ( (udg_Int_ArtifactFragmentsFound == 6) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_06_Q, true)
    else
        call DoNothing()
    endif
    if ( (udg_Int_ArtifactFragmentsFound == 7) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_07_Q, true)
    else
        call DoNothing()
    endif
    if ( (udg_Int_ArtifactFragmentsFound == 8) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_08_Q, true)
    else
        call DoNothing()
    endif
    if ( (udg_Int_ArtifactFragmentsFound == 9) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_09_Q, true)
    else
        call DoNothing()
    endif
    if ( (udg_Int_ArtifactFragmentsFound == 10) ) then // INLINED!!
        call QueuedTriggerAddBJ(gg_trg_Artifact_10_Q, true)
    else
        call DoNothing()
    endif
endfunction

