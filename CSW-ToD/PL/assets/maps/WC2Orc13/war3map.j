    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_VisModCavern01, Condition(function Trig_VisModCave01Off_Func002Func004001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VisModCave01Off_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_VisModCave01Off_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Bool_VisibilityCaveOn[1]=false
        call UnitShareVisionBJ(false, gg_unit_hVCu_0451, Player(0))
    else
    endif
endfunction

