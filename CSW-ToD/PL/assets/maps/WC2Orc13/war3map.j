//===========================================================================
function InitTrig_FacialAnimationLoad takes nothing returns nothing
    set gg_trg_FacialAnimationLoad=CreateTrigger()
    call TriggerAddAction(gg_trg_FacialAnimationLoad, function Trig_FacialAnimationLoad_Actions)
endfunction

//===========================================================================
// Trigger: Initialization
//===========================================================================
function Trig_Initialization_Actions takes nothing returns nothing
    // //
    call ConditionalTriggerExecute(gg_trg_Oil_Locale_Setup)
    call SetAllyColorFilterState(0)
    call EnableMinimapFilterButtons(false, false)
    call SetMaxCheckpointSaves(10)
    set udg_String_CheckpointChapter="WC2Orc13"
    // //
    call ConditionalTriggerExecute(gg_trg_InitPlayers)
    call ConditionalTriggerExecute(gg_trg_InitEnvironment)
    call ConditionalTriggerExecute(gg_trg_InitEvents)
    call ConditionalTriggerExecute(gg_trg_InitAudio)
    call ConditionalTriggerExecute(gg_trg_Init_Quests)
    // ///
    call ConditionalTriggerExecute(gg_trg_FacialAnimationLoad)
    call ConditionalTriggerExecute(gg_trg_Creep_Multiplier)
    call ConditionalTriggerExecute(gg_trg_Spawn_Multiplier)
    call ConditionalTriggerExecute(gg_trg_Enemy_Multiplier)
    // ///
    set udg_Point_EscapeTripwire=GetRectCenter(gg_rct_Escape_Goal)
    set udg_Point_SpawnFakeRend=GetRectCenter(gg_rct_SpawnFakeRend)
    set udg_Point_SpawnFakeZuluhed=GetRectCenter(gg_rct_SpawnFakeZuluhed)
    set udg_Point_SpawnFakeMaim=GetRectCenter(gg_rct_SpawnFakeMaim)
    set udg_Point_SpawnFakeRakmar=GetRectCenter(gg_rct_SpawnFakeRakmar)
    set udg_Point_SpawnFakeGuldan=GetRectCenter(gg_rct_SpawnFakeGuldan)
    // ///
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Q)
endfunction

//===========================================================================
function InitTrig_Initialization takes nothing returns nothing
    set gg_trg_Initialization=CreateTrigger()
    call TriggerAddAction(gg_trg_Initialization, function Trig_Initialization_Actions)
endfunction

//===========================================================================
// Trigger: InitPlayers
//===========================================================================
function Trig_InitPlayers_Actions takes nothing returns nothing
    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[0]
    call EnableCreepSleepBJ(false)
    // ----------------------------------------------------------------------------------------------------
    // Player Names
    // ----------------------------------------------------------------------------------------------------
    // //
    set udg_Player_Actual=Player(0)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_2848")
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 50.00)
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_COAL, false)
    // //
    set udg_Player_BurningLegion=Player(6)
    call SetPlayerName(udg_Player_BurningLegion, "TRIGSTR_3656")
    // //
    set udg_Player_CinematicBTG=Player(20)
    // //
    set udg_Player_CinematicBlackrock=Player(12)
    // //
    set udg_Player_CinematicDragonMaw=Player(21)
    // //
    set udg_Player_CinematicDummy=Player(23)
    // //
    set udg_Player_ShadowCouncil=Player(1)
    call SetPlayerName(udg_Player_ShadowCouncil, "TRIGSTR_3657")
    // //
    set udg_Player_TwilightHammer=Player(3)
    call SetPlayerName(udg_Player_TwilightHammer, "TRIGSTR_3658")
    // //
    set udg_Player_Ghosts=Player(9)
    call SetPlayerName(udg_Player_Ghosts, "TRIGSTR_3659")
    // //
    // ----------------------------------------------------------------------------------------------------
    // Alliance Settings
    // ----------------------------------------------------------------------------------------------------
    call SetPlayerAllianceStateBJ(udg_Player_ShadowCouncil, udg_Player_TwilightHammer, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Ghosts, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    // ----------------------------------------------------------------------------------------------------
    // ----------------------------------------------------------------------------------------------------
    // Hide Excess Players
    // ----------------------------------------------------------------------------------------------------
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicDummy)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicDragonMaw)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicBlackrock)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicBTG)
    // ----------------------------------------------------------------------------------------------------
    call ConditionalTriggerExecute(gg_trg_LoadCache)
    call ConditionalTriggerExecute(gg_trg_InitUnits)
    call ConditionalTriggerExecute(gg_trg_InitDifficulty)
endfunction

//===========================================================================
function InitTrig_InitPlayers takes nothing returns nothing
    set gg_trg_InitPlayers=CreateTrigger()
    call TriggerAddAction(gg_trg_InitPlayers, function Trig_InitPlayers_Actions)
endfunction

