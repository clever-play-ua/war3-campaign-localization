//===========================================================================
// Trigger: Quest Aluneth Create
//===========================================================================
function Trig_Quest_Aluneth_Create_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Quest_Aluneth_Create_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Create the quest objects
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_3611", "TRIGSTR_3612", "ReplaceableTextures\\CommandButtons\\BTNAlunethShard.dds")
    set udg_OQAluneth=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQAluneth, "TRIGSTR_3613")
    set udg_QReq_AlunethFind=GetLastCreatedQuestItemBJ()
endfunction

