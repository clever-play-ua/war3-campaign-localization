    if ( not ( IsTriggerEnabled(gg_trg_AlexRaid_FightAction_Q) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AlexRaid_FightAction_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call StartTimerBJ(udg_Timer_AlextrasaRaidSustained, false, GetRandomReal(10.00, 30.00))
    if ( Trig_AlexRaid_FightAction_Func003C() ) then
        call QueuedTriggerAddBJ(gg_trg_AlexRaid_FightAction_Q, true)
    else
        call DoNothing()
    endif
endfunction

