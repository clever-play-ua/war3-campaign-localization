//===========================================================================
function Trig_FireLord_WeakRunes_Create1_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    if ( not ( udg_Bool_BossFightFireLord == true ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Zuluhed) <= 400.00 ) ) then
        return false
    endif
