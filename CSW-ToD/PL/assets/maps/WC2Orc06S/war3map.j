// Trigger: Showpath
//===========================================================================
function Trig_Showpath_Func002C takes nothing returns boolean
    if ( not ( udg_BoolCheat_UnmaskedOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Showpath_Actions takes nothing returns nothing
    if ( Trig_Showpath_Func002C() ) then
        set udg_BoolCheat_UnmaskedOn=true
        call FogMaskEnableOff()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_4619")
    else
        set udg_BoolCheat_UnmaskedOn=false
        call FogMaskEnableOn()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_4620")
    endif
endfunction

