function Trig_SaveCheckpoint_Actions takes nothing returns nothing
    call SaveGameCheckPointBJ("DragonQueen", true)
endfunction

//===========================================================================
function InitTrig_SaveCheckpoint takes nothing returns nothing
    set gg_trg_SaveCheckpoint=CreateTrigger()
    call TriggerAddAction(gg_trg_SaveCheckpoint, function Trig_SaveCheckpoint_Actions)
