    call IssueTargetOrderBJ(GetEnumUnit(), "attack", udg_Hero_Zuluhed)
endfunction

function Trig_DarkIron_SpawnGem_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(0.75)
    call CreateItemLoc('engs', GetRectCenter(gg_rct_GemSpawn))
    call SetItemInvulnerableBJ(GetLastCreatedItem(), true)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_FX_vt_fog4_Copy, udg_Player_DarkIron), function Trig_DarkIron_SpawnGem_Func006002)
    // //
    call SetUnitBlendTimeBJ(udg_Unit_DraugrArr[1], 0.50)
    call ResetUnitAnimation(udg_Unit_DraugrArr[1])
    call PolledWait(0.50)
    call PauseUnitBJ(false, udg_Unit_DraugrArr[1])
    call SetUnitBlendTimeBJ(udg_Unit_DraugrArr[1], 0.15)
    call ReplaceUnitBJ(udg_Unit_DraugrArr[1], 'n02P', bj_UNIT_STATE_METHOD_RELATIVE)
    // //
    call ConditionalTriggerExecute(gg_trg_DarkIron_Skeleton_Sound)
endfunction

