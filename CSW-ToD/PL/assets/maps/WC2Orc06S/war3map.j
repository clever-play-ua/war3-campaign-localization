    if ( not ( IsTriggerEnabled(gg_trg_Dragon_Kobolds2_Q) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerQueuedBJ(gg_trg_Dragon_Kobolds2_Q) == false ) ) then
        return false
    endif
    return true
endfunction

