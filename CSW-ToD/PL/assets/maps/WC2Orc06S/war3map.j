    call StartTimerBJ(udg_Timer_AlextrasaSummonWhelps, true, udg_Real_AlexBFWhelpSummonTime)
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Alextrasza, 'O61G', gg_snd_WC2Orc06SAlexstrasza_BossFight2, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

