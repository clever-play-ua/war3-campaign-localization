    endif
    if ( not ( udg_Bool_VisModLavaLakeOn[1] == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_BossFightFireLord == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_Step00_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Bool_VisModLavaLakeOn[1]=true
    call CreateFogModifierRectBJ(true, Player(0), FOG_OF_WAR_VISIBLE, gg_rct_LavaLakeSoundLoop)
    set udg_VisMod_LavaLakeArr[1]=GetLastCreatedFogModifier()
    // //
    set udg_Bool_LavaLakeActive=true
    call EnableTrigger(gg_trg_LavaLake_DamageChecker)
    // //
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    // //
    call QueuedTriggerAddBJ(gg_trg_LavaLake_Step00_Q, true)
endfunction

