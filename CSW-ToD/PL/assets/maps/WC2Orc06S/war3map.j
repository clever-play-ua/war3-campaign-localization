//===========================================================================
// Trigger: AlexRaid Start
//===========================================================================
function Trig_AlexRaid_Start_Func012002 takes nothing returns nothing
    call IssuePointOrderLocBJ(GetEnumUnit(), "attack", udg_Point_AlexstraszaAttack)
endfunction

function Trig_AlexRaid_Start_Actions takes nothing returns nothing
    set udg_Bool_AlextrazaInRaid=true
    // //
    call AddWeatherEffectSaveLast(gg_rct_CameraBoundsRTS, 'WOlw')
    set udg_Weather_AlextraszaWind=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_AlextraszaWind, true)
    // //
    call GroupRemoveGroup(udg_Group_DragonsAttack, udg_Group_DragonsAttack)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_Int_DragonsAttackMaxAmount
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'n60H', udg_Player_RedDragons, GetRectCenter(gg_rct_SpawnDragons), bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_DragonsAttack)
        call CreateNUnitsAtLoc(1, 'nrdr', udg_Player_RedDragons, GetRectCenter(gg_rct_SpawnDragons), bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_DragonsAttack)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call IssuePointOrderLocBJ(udg_Hero_Alextrasza, "attack", udg_Point_AlexstraszaAttack)
    call ForGroupBJ(udg_Group_DragonsAttack, function Trig_AlexRaid_Start_Func012002)
    // //
    call EnableTrigger(gg_trg_AlexRaid_ShieldOn)
    // //
    // //
    call QueuedTriggerAddBJ(gg_trg_AlexRaid_Start_Q, true)
    call QueuedTriggerAddBJ(gg_trg_Alex_Raid_Hint_Q, true)
    // //
    call EnableTrigger(gg_trg_AlexRaid_End)
    call EnableTrigger(gg_trg_AlexGoAttack)
    call EnableTrigger(gg_trg_AlexRaid_FightAction)
endfunction

//===========================================================================
function InitTrig_AlexRaid_Start takes nothing returns nothing
    set gg_trg_AlexRaid_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AlexRaid_Start, function Trig_AlexRaid_Start_Actions)
endfunction

