function Trig_Door_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCInematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidCinDoor01, udg_Player_Actual, 0)
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call UnitRemoveAbilityBJ('Aneu', udg_Hero_VincentTurnCoat)
    call ShowUnitHide(udg_Hero_VincentTurnCoat)
    call PauseUnitBJ(true, udg_Hero_VincentTurnCoat)
    call ShowDestructableBJ(true, gg_dest_B02E_10478)
    // //
    call ShowUnitHide(udg_Hero_Zuluhed)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_MidCinDoorZuluhed01), GetRectCenter(gg_rct_MoveVIncentHere))
    call SetUnitPositionLocFacingLocBJ(udg_FakeVincent, GetRectCenter(gg_rct_MoveVIncentHere), GetRectCenter(gg_rct_MidCinDoorZuluhed01))
    // //
    call ConditionalTriggerExecute(gg_trg_PlaylistDungeon)
    // //
    call SetUnitAnimationWithRarity(udg_FakeVincent, "stand", RARITY_FREQUENT)
    // //
    call PlaySoundBJ(gg_snd_DarkAgents)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinDoorOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    // Cinematic Started
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_QuestComplete1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoorSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidCinDoor02, udg_Player_Actual, 0)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeVincent, 0, gg_snd_WC2Orc06SVincentGoblin_QuestComplete1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoorSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_n000_0054, "move", GetRectCenter(gg_rct_Kaboom))
    call PlaySoundBJ(gg_snd_GoblinSapperYes3)
    // //
    set udg_Point_CinSappersTemp=GetUnitLoc(gg_unit_n000_0054)
    call SetUnitFacingToFaceLocTimed(udg_FakeVincent, GetRectCenter(gg_rct_Kaboom), ( DistanceBetweenPoints(udg_Point_CinSappersTemp, GetRectCenter(gg_rct_Kaboom)) / GetUnitMoveSpeed(gg_unit_n000_0054) ))
    call SetUnitFacingToFaceLocTimed(udg_FakeZuluhed, GetRectCenter(gg_rct_Kaboom), ( DistanceBetweenPoints(udg_Point_CinSappersTemp, GetRectCenter(gg_rct_Kaboom)) / GetUnitMoveSpeed(gg_unit_n000_0054) ))
    // //
    call TriggerSleepAction(2)
    if ( (udg_Bool_CinDoorSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_QuestComplete2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoorSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Showing the DarkIrons
    call ShowDestructableBJ(false, gg_dest_B02E_10478)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ChamberDoor02, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_ChamberDoor01, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc06SVincentGoblin_QuestComplete2))
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDoorSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeVincent, 0, gg_snd_WC2Orc06SVincentGoblin_QuestComplete2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDoorSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_DarkAgents, true)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDoorSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Door_Cinematic_Cleanup)
    // //
endfunction

//===========================================================================
function InitTrig_Door_Cinematic_Q takes nothing returns nothing
    set gg_trg_Door_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Door_Cinematic_Q, function Trig_Door_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Door Cinematic Skipped
//===========================================================================
function Trig_Door_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinDoorOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Door_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinematicSkipped=true
    set udg_Bool_CinDoorSkipped=true
    call ConditionalTriggerExecute(gg_trg_Door_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Door_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Door_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Door_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Door_Cinematic_Skipped, Condition(function Trig_Door_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Door_Cinematic_Skipped, function Trig_Door_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Door Cinematic Cleanup
//===========================================================================
function Trig_Door_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Door_Cinematic_Cleanup_Func005C takes nothing returns boolean
    if ( not ( udg_Bool_CinDoorSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Door_Cinematic_Cleanup_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_CinDoorSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Door_Cinematic_Cleanup_Func038C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Door_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Door_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set udg_Bool_CinDoorOn=false
    if ( Trig_Door_Cinematic_Cleanup_Func005C() ) then
        call StopSoundBJ(gg_snd_DarkAgents, false)
        call StopSoundBJ(gg_snd_WC2Orc06SVincentGoblin_QuestComplete1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SVincentGoblin_QuestComplete2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_QuestComplete1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_QuestComplete2, false)
    else
        call DoNothing()
    endif
    // //
    if ( Trig_Door_Cinematic_Cleanup_Func007C() ) then
        call RemoveUnit(gg_unit_n000_0054)
        call TriggerExecute(gg_trg_DarkIron_Door_Kaboom)
        call SetUnitFacingToFaceLocTimed(udg_Hero_VincentTurnCoat, GetRectCenter(gg_rct_Kaboom), 0)
        call SetUnitFacingToFaceLocTimed(udg_Hero_Zuluhed, GetRectCenter(gg_rct_Kaboom), 0)
    else
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call RemoveUnit(gg_unit_h609_0141)
    call SetUnitPositionLocFacingBJ(udg_Unit_GoblinTrainCart, GetRectCenter(gg_rct_TrainA01), 270.00)
    call SetUnitMoveSpeed(udg_Unit_GoblinTrainCart, 0.00)
    set udg_Bool_TrainInGoblinTown=false
    // //
    call ShowUnitShow(udg_Hero_VincentTurnCoat)
    call PauseUnitBJ(false, udg_Hero_VincentTurnCoat)
    call UnitAddAbilityBJ('Aneu', udg_Hero_VincentTurnCoat)
    call ShowDestructableBJ(false, gg_dest_B02E_10478)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_MidCinDoorZuluhed01), GetRectCenter(gg_rct_MoveVIncentHere))
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    // //
    call RemoveLocation(udg_Point_CinSappersTemp)
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetUnitLoc(udg_Hero_Zuluhed), 0)
    // //
    // //
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_FOOD_CAP, 12)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCInematicCleanUp)
    call SelectUnitForPlayerSingle(udg_Hero_Zuluhed, udg_Player_Actual)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Door_Cinematic_Cleanup_Func038C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Door_Cinematic_Q)
    call QueuedTriggerAddBJ(gg_trg_GoblinMerc_Hint_Q, true)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    // //
    call SetUnitInvulnerable(gg_unit_ngir_0776, false)
    call SetUnitInvulnerable(gg_unit_ngbl_0777, false)
    // //
    call RescueUnitBJ(gg_unit_ngir_0776, Player(0), false)
    call RescueUnitBJ(gg_unit_ngbl_0777, Player(0), false)
endfunction

//===========================================================================
function InitTrig_Door_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Door_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Door_Cinematic_Cleanup, function Trig_Door_Cinematic_Cleanup_Actions)
endfunction

//===========================================================================
// Trigger: Treasury Cinematic Start
//===========================================================================
function Trig_Treasury_Cinematic_Start_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( udg_Int_CounterRings == 7 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Treasury_Cinematic_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_Treasury_Cinematic_Q, true)
endfunction

//===========================================================================
function InitTrig_Treasury_Cinematic_Start takes nothing returns nothing
    set gg_trg_Treasury_Cinematic_Start=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Treasury_Cinematic_Start, gg_rct_TreasuryLights)
    call TriggerAddCondition(gg_trg_Treasury_Cinematic_Start, Condition(function Trig_Treasury_Cinematic_Start_Conditions))
    call TriggerAddAction(gg_trg_Treasury_Cinematic_Start, function Trig_Treasury_Cinematic_Start_Actions)
endfunction

//===========================================================================
// Trigger: TreasuryRemoveSummonedUnit
//
// If treasury is locked and player tries to summon Elemental there
//===========================================================================
function Trig_TreasuryRemoveSummonedUnit_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_SUMMONED) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( udg_Int_CounterRings < 7 ) ) then
        return false
    endif
    if ( not ( udg_Bool_BossFightOrastrasz == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TreasuryRemoveSummonedUnit_Actions takes nothing returns nothing
    call KillUnit(GetEnteringUnit())
endfunction

//===========================================================================
function InitTrig_TreasuryRemoveSummonedUnit takes nothing returns nothing
    set gg_trg_TreasuryRemoveSummonedUnit=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_TreasuryRemoveSummonedUnit, gg_rct_TreasuryLights)
    call TriggerAddCondition(gg_trg_TreasuryRemoveSummonedUnit, Condition(function Trig_TreasuryRemoveSummonedUnit_Conditions))
    call TriggerAddAction(gg_trg_TreasuryRemoveSummonedUnit, function Trig_TreasuryRemoveSummonedUnit_Actions)
endfunction

