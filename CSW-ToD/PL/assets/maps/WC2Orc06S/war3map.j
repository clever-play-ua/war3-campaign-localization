    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Setup_Func085C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Setup_Func087C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Setup_Func091Func001Func001C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Setup_Func091Func001C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Setup_Func091C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_FireLord_Setup_Q)
    call DestroyMinimapIcon(udg_MinimapIcon_FireEssence)
    // ///
    call ConditionalTriggerExecute(gg_trg_PlaylistBossfightDungeon)
    // ///
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_LavaLakeFireLordWakeUp)
    call RemoveDestructable(gg_dest_B01L_10060)
    call RemoveDestructable(gg_dest_B01L_10058)
    call RemoveDestructable(gg_dest_B01L_10052)
    call RemoveDestructable(gg_dest_B01L_10247)
    // ///
    call SetDoodadAnimationRectBJ("stand", 'YOf2', gg_rct_FiretrapsCosmetics02)
    // ///
    call DestructableRestoreLife(gg_dest_B01L_10063, GetDestructableMaxLife(gg_dest_B01L_10063), false)
    call DestructableRestoreLife(gg_dest_B01L_10062, GetDestructableMaxLife(gg_dest_B01L_10062), false)
    // ///
    set udg_Bool_BossFightFireLord=true
    // ///
    call PolledWait(3.00)
    // ///
    call SetUnitPositionLoc(udg_Hero_FireLord, GetRectCenter(gg_rct_FireElementalSpawn01))
    call ShowUnitShow(udg_Hero_FireLord)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_FireElementalSpawn01), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrike.mdl")
    set udg_SE_FireLord=GetLastCreatedEffectBJ()
    // ///
    call CampaignMinimapIconUnitBJ(udg_Hero_FireLord, bj_CAMPPINGSTYLE_BOSS)
    set udg_MinimapIcon_FirelordBoss=GetLastCreatedMinimapIcon()
    // ///
    call PolledWait(1.00)
    // ///
    call DestroyEffectBJ(udg_SE_FireLord)
    // ///
    set udg_Int_LavaPuzzlePreviousLevel=1
    call ConditionalTriggerExecute(gg_trg_LavaLake_RandomCycle)
    // //
    set udg_Point_FireLordEscape[1]=GetRectCenter(gg_rct_FireElementalSpawn01)
    set udg_Point_FireLordEscape[2]=GetRectCenter(gg_rct_FireElementalSpawn02)
    set udg_Point_FireLordEscape[3]=GetRectCenter(gg_rct_FireElementalSpawn03)
    set udg_Point_FireLordEscape[4]=GetRectCenter(gg_rct_FireElementalSpawn04)
    // //
    set udg_Point_LavaLakeMinionSpawn[1]=GetRectCenter(gg_rct_LawaSpawn01)
    set udg_Point_LavaLakeMinionSpawn[2]=GetRectCenter(gg_rct_LawaSpawn02)
    set udg_Point_LavaLakeMinionSpawn[3]=GetRectCenter(gg_rct_LawaSpawn03)
    set udg_Point_LavaLakeMinionSpawn[4]=GetRectCenter(gg_rct_LawaSpawn04)
    set udg_Point_LavaLakeMinionSpawn[5]=GetRectCenter(gg_rct_LawaSpawn05)
    set udg_Point_LavaLakeMinionSpawn[6]=GetRectCenter(gg_rct_LawaSpawn06)
    set udg_Point_LavaLakeMinionSpawn[7]=GetRectCenter(gg_rct_LawaSpawn07)
    set udg_Point_LavaLakeMinionSpawn[8]=GetRectCenter(gg_rct_LawaSpawn08)
    set udg_Point_LavaLakeMinionSpawn[9]=GetRectCenter(gg_rct_LawaSpawn09)
    // //
    set udg_Point_LavaLakeStrongRuneSpawn[1]=GetRectCenter(gg_rct_SpawnRune01)
    set udg_Point_LavaLakeStrongRuneSpawn[2]=GetRectCenter(gg_rct_SpawnRune02)
    set udg_Point_LavaLakeStrongRuneSpawn[3]=GetRectCenter(gg_rct_SpawnRune03)
    set udg_Point_LavaLakeStrongRuneSpawn[4]=GetRectCenter(gg_rct_SpawnRune04)
    set udg_Point_LavaLakeStrongRuneSpawn[5]=GetRectCenter(gg_rct_SpawnRune05)
    set udg_Point_LavaLakeStrongRuneSpawn[6]=GetRectCenter(gg_rct_SpawnRune06)
    set udg_Point_LavaLakeStrongRuneSpawn[7]=GetRectCenter(gg_rct_SpawnRune07)
    set udg_Point_LavaLakeStrongRuneSpawn[8]=GetRectCenter(gg_rct_SpawnRune08)
    set udg_Point_LavaLakeStrongRuneSpawn[9]=GetRectCenter(gg_rct_SpawnRune09)
    set udg_Point_LavaLakeStrongRuneSpawn[10]=GetRectCenter(gg_rct_SpawnRune10)
    set udg_Point_LavaLakeStrongRuneSpawn[11]=GetRectCenter(gg_rct_SpawnRune11)
    set udg_Point_LavaLakeStrongRuneSpawn[12]=GetRectCenter(gg_rct_SpawnRune12)
    set udg_Point_LavaLakeStrongRuneSpawn[13]=GetRectCenter(gg_rct_SpawnRune13)
    set udg_Point_LavaLakeStrongRuneSpawn[14]=GetRectCenter(gg_rct_SpawnRune14)
    set udg_Point_LavaLakeStrongRuneSpawn[15]=GetRectCenter(gg_rct_SpawnRune15)
    set udg_Point_LavaLakeStrongRuneSpawn[16]=GetRectCenter(gg_rct_SpawnRune16)
    set udg_Point_LavaLakeStrongRuneSpawn[17]=GetRectCenter(gg_rct_SpawnRune17)
    set udg_Point_LavaLakeStrongRuneSpawn[18]=GetRectCenter(gg_rct_SpawnRune18)
    // //
    set udg_Point_LavaLakeWeakRuneSpawn[1]=GetRectCenter(gg_rct_SpawnWeakRune01)
    set udg_Point_LavaLakeWeakRuneSpawn[2]=GetRectCenter(gg_rct_SpawnWeakRune02)
    set udg_Point_LavaLakeWeakRuneSpawn[3]=GetRectCenter(gg_rct_SpawnWeakRune03)
    set udg_Point_LavaLakeWeakRuneSpawn[4]=GetRectCenter(gg_rct_SpawnWeakRune04)
    set udg_Point_LavaLakeWeakRuneSpawn[5]=GetRectCenter(gg_rct_SpawnWeakRune05)
    set udg_Point_LavaLakeWeakRuneSpawn[6]=GetRectCenter(gg_rct_SpawnWeakRune06)
    set udg_Point_LavaLakeWeakRuneSpawn[7]=GetRectCenter(gg_rct_SpawnWeakRune07)
    set udg_Point_LavaLakeWeakRuneSpawn[8]=GetRectCenter(gg_rct_SpawnWeakRune08)
    set udg_Point_LavaLakeWeakRuneSpawn[9]=GetRectCenter(gg_rct_SpawnWeakRune09)
    // //
    // Set Lava Spawn Quantity
    // //
    if ( Trig_FireLord_Setup_Func083C() ) then
        set udg_Int_LavaSpawnUnitQuantity=GetRandomInt(1, 2)
    else
    endif
    // //
    if ( Trig_FireLord_Setup_Func085C() ) then
        set udg_Int_LavaSpawnUnitQuantity=GetRandomInt(2, 3)
    else
    endif
    // //
    if ( Trig_FireLord_Setup_Func087C() ) then
        set udg_Int_LavaSpawnUnitQuantity=GetRandomInt(3, 4)
    else
    endif
    // //
    // Set Lava Spawn Level
    // //
    if ( Trig_FireLord_Setup_Func091C() ) then
        set udg_UnitType_LavaSpawnSummon='nlv1'
    else
        if ( Trig_FireLord_Setup_Func091Func001C() ) then
            set udg_UnitType_LavaSpawnSummon='nlv2'
        else
            if ( Trig_FireLord_Setup_Func091Func001Func001C() ) then
                set udg_UnitType_LavaSpawnSummon='nlv2'
            else
                call DoNothing()
            endif
        endif
    endif
    // //
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Hero_Zuluhed)
    call SetUnitManaPercentBJ(udg_Hero_Zuluhed, 100)
    call SetUnitLifePercentBJ(udg_Hero_Zuluhed, 100)
    // //
    call EnableTrigger(gg_trg_FireLord_Escape)
    // //
    call EnableTrigger(gg_trg_FireLord_StrongRunes_Create)
    // //
    // //
endfunction

