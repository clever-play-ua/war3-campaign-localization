    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_Q_Func093001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_Q_Func099001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_Q_Func103001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_GenericCInematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call ConditionalTriggerExecute(gg_trg_Outro_Cinematic_Setup)
    call TriggerSleepAction(0.50)
    call CameraSetupApplyForPlayer(true, gg_cam_Outro01, udg_Player_Actual, 0)
    // //
    call PlaySoundBJ(gg_snd_NightElfDefeat01)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinOutroOn=true
    set udg_Bool_CinematicSkipped=false
    set udg_Bool_BossFightAlextraza=false
    // //
    call SetUnitAnimation(udg_FakeTharbek, "cinematic standard two")
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_RED, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc06STharbek5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro02, udg_Player_Actual, 0)
    // //
    call SetUnitTimeScalePercent(udg_Hero_Alextrasza, 40.00)
    call SetUnitAnimation(udg_Hero_Alextrasza, "Cinematic Dodge 1")
    call QueueUnitAnimationBJ(udg_Hero_Alextrasza, "Cinematic Spell Stun 1")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Alextrasza, 0, gg_snd_WC2Orc06SAlexstrasza1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro03, udg_Player_Actual, 0)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitInvulnerable(udg_Unit_CinematicEggArr[1], false)
    call SetUnitInvulnerable(udg_Unit_CinematicEggArr[2], false)
    call SetUnitInvulnerable(udg_Unit_CinematicEggArr[3], false)
    // //
    call IssueTargetOrderBJ(udg_Unit_OutroHunterArr[1], "attack", udg_Unit_CinematicEggArr[1])
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueTargetOrderBJ(udg_Unit_OutroHunterArr[2], "attack", udg_Unit_CinematicEggArr[2])
    // //
    call CreateNUnitsAtLoc(1, 'nrdk', udg_Player_RedDragons, GetRectCenter(gg_rct_OutroWhelpSpawn), bj_UNIT_FACING)
    set udg_Unit_CinDragonWhelp=GetLastCreatedUnit()
    call SetUnitFlyHeightBJ(udg_Unit_CinDragonWhelp, 100.00, 0.00)
    // //
    call IssueTargetOrderBJ(udg_Unit_OutroHunterArr[2], "attack", udg_Unit_CinDragonWhelp)
    call IssueTargetOrderBJ(udg_Unit_OutroHunterArr[1], "attack", udg_Unit_CinDragonWhelp)
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillUnit(udg_Unit_CinDragonWhelp)
    // //
    call SetUnitAnimation(udg_Hero_Alextrasza, "Cinematic Dodge 1")
    call QueueUnitAnimationBJ(udg_Hero_Alextrasza, "Cinematic Spell Stun 1")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Alextrasza, 0, gg_snd_WC2Orc06SAlexstrasza2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceLocTimed(udg_Unit_OutroHunterArr[1], GetRectCenter(gg_rct_OutroAlextraszaStunned), 0.50)
    call SetUnitFacingToFaceLocTimed(udg_Unit_OutroHunterArr[2], GetRectCenter(gg_rct_OutroAlextraszaStunned), 1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro02, udg_Player_Actual, 0)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros8, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Alextrasza, 0, gg_snd_WC2Orc06SAlexstrasza3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro01, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc06SNekros9) + ( GetSoundDurationBJ(gg_snd_WC2Orc06STharbek6) + GetSoundDurationBJ(gg_snd_WC2Orc06SNekros10) ) ))
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeTharbek, udg_FakeNekros, 0.50)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros9, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeNekros, udg_FakeTharbek, 0.50)
    // //
    call SetUnitAnimation(udg_FakeTharbek, "cinematic standard one")
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_RED, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc06STharbek6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros10, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_NightElfDefeat01, true)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Outro_Cinematic_Cleanup)
endfunction

