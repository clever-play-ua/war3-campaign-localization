//===========================================================================
// Trigger: LavaLake ElevatorApplyLevel
//===========================================================================
function Trig_LavaLake_ElevatorApplyLevel_Func001Func001C takes nothing returns boolean
    if ( not ( udg_Int_LavaPuzzleLevel < udg_Int_LavaPuzzlePreviousLevel ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_ElevatorApplyLevel_Func001C takes nothing returns boolean
    if ( not ( udg_Int_LavaPuzzleLevel > udg_Int_LavaPuzzlePreviousLevel ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_ElevatorApplyLevel_Actions takes nothing returns nothing
    if ( Trig_LavaLake_ElevatorApplyLevel_Func001C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_WARNING, "TRIGSTR_4633")
    else
        if ( Trig_LavaLake_ElevatorApplyLevel_Func001Func001C() ) then
            call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_WARNING, "TRIGSTR_4634")
        else
        endif
    endif
    call PolledWait(2)
    call PlaySoundBJ(gg_snd_LavaRising)
    call ChangeElevatorHeight(udg_Destructable_LavaPuzzle, udg_Int_LavaPuzzleLevel)
endfunction

//===========================================================================
function InitTrig_LavaLake_ElevatorApplyLevel takes nothing returns nothing
    set gg_trg_LavaLake_ElevatorApplyLevel=CreateTrigger()
    call TriggerAddAction(gg_trg_LavaLake_ElevatorApplyLevel, function Trig_LavaLake_ElevatorApplyLevel_Actions)
endfunction

//===========================================================================
// Trigger: LavaLake RandomCycle
//===========================================================================
function Trig_LavaLake_RandomCycle_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightFireLord == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_RandomCycle_Func005C takes nothing returns boolean
    if ( not ( udg_Bool_BossFightFireLord == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_RandomCycle_Func011C takes nothing returns boolean
    if ( not ( udg_Bool_BossFightFireLord == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_RandomCycle_Func014C takes nothing returns boolean
    if ( not ( udg_Bool_BossFightFireLord == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_RandomCycle_Actions takes nothing returns nothing
    // //
    call PolledWait(2.00)
    if ( Trig_LavaLake_RandomCycle_Func005C() ) then
        return
    else
    endif
    // //
    set udg_Int_LavaPuzzlePreviousLevel=udg_Int_LavaPuzzleLevel
    set udg_Int_LavaPuzzleLevel=GetRandomInt(1, 3)
    call ConditionalTriggerExecute(gg_trg_LavaLake_ElevatorApplyLevel)
    call PolledWait(2.00)
    if ( Trig_LavaLake_RandomCycle_Func011C() ) then
        return
    else
    endif
    // //
    call PolledWait(GetRandomReal(7.00, 12.00))
    if ( Trig_LavaLake_RandomCycle_Func014C() ) then
        return
    else
    endif
    // //
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_LavaLake_RandomCycle takes nothing returns nothing
    set gg_trg_LavaLake_RandomCycle=CreateTrigger()
    call TriggerAddCondition(gg_trg_LavaLake_RandomCycle, Condition(function Trig_LavaLake_RandomCycle_Conditions))
    call TriggerAddAction(gg_trg_LavaLake_RandomCycle, function Trig_LavaLake_RandomCycle_Actions)
endfunction

