//===========================================================================
function InitTrig_FaceAnimLoader takes nothing returns nothing
    set gg_trg_FaceAnimLoader=CreateTrigger()
    call TriggerRegisterGameLoadedEventBJ(gg_trg_FaceAnimLoader)
    call TriggerAddAction(gg_trg_FaceAnimLoader, function Trig_FaceAnimLoader_Actions)
endfunction

//===========================================================================
// Trigger: MissionFailed
//===========================================================================
function Trig_MissionFailed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    // //
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
    call TriggerSleepAction(1.00)
    // //
    call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_3926")
endfunction

//===========================================================================
function InitTrig_MissionFailed takes nothing returns nothing
    set gg_trg_MissionFailed=CreateTrigger()
    call TriggerAddAction(gg_trg_MissionFailed, function Trig_MissionFailed_Actions)
endfunction

//===========================================================================
// Trigger: Init Reload
//===========================================================================
function Trig_Init_Reload_Func006C takes nothing returns boolean
    if ( not ( udg_Bool_DungeonAreaPlayable == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_Reload_Actions takes nothing returns nothing
    call SetMapFacialAnimations()
    // Clear any pending music list
    call ClearMapMusicBJ()
    // fix environment
    call SetWaterBaseColorBJ(19.60, 88.23, 89.41, 0)
    if ( Trig_Init_Reload_Func006C() ) then
        call SetDayNightModels("", "")
        call ConditionalTriggerExecute(gg_trg_PlaylistDungeon)
    else
        call SetDayNightModels("Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdl", "Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdl")
        call ConditionalTriggerExecute(gg_trg_PlaylistRTS)
    endif
endfunction

//===========================================================================
function InitTrig_Init_Reload takes nothing returns nothing
    set gg_trg_Init_Reload=CreateTrigger()
    call TriggerRegisterGameLoadedEventBJ(gg_trg_Init_Reload)
    call TriggerAddAction(gg_trg_Init_Reload, function Trig_Init_Reload_Actions)
endfunction

