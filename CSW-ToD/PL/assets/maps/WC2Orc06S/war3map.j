//===========================================================================
// Trigger: DragonSoul Recharged
//===========================================================================
function Trig_DragonSoul_Recharged_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'XBN2') == true ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) <= 50.00 ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonSoul_Recharged_Func037C takes nothing returns boolean
    if ( not ( udg_Int_DragonSoulItemCharges >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonSoul_Recharged_Actions takes nothing returns nothing
    local effect SEDragonSoulSyphon
    local effect SEDragonSoulKillEffect
    local effect SEDragonSoulRecharged
    local unit SoulVictim
    // //
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call QueuedTriggerAddBJ(gg_trg_DragonSoul_Recharged_Hint_Q1, true)
    set udg_Int_DragonSoulItemCharges=( udg_Int_DragonSoulItemCharges + 1 )
    // //
    set SoulVictim=GetTriggerUnit()
    // //
    call AddSpecialEffectTargetUnitBJ("origin", SoulVictim, "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
    set SEDragonSoulKillEffect=GetLastCreatedEffectBJ()
    call PlaySoundBJ(gg_snd_FlashBack1Second)
    // //
    call PolledWait(2)
    call DestroyEffectBJ(SEDragonSoulKillEffect)
    // //
    call KillUnit(SoulVictim)
    set SoulVictim=null
    // //
    call EnableTrigger(GetTriggeringTrigger())
    // //
    call AddSpecialEffectTargetUnitBJ("origin", udg_Hero_Necros, "buildings\\other\\bookofsummoning\\bos_stand.mdl")
    set SEDragonSoulSyphon=GetLastCreatedEffectBJ()
    call PlaySoundBJ(gg_snd_FlashBackHalfSecondSecond)
    // //
    call PolledWait(2)
    call DestroyEffectBJ(SEDragonSoulSyphon)
    // //
    if ( Trig_DragonSoul_Recharged_Func037C() ) then
        call ConditionalTriggerExecute(gg_trg_DragonSoul_Recharged_Hint_Q2)
        call SetItemCharges(udg_Item_DragonSoulActive, ( GetItemCharges(udg_Item_DragonSoulActive) + 1 ))
        set udg_Int_DragonSoulItemCharges=( udg_Int_DragonSoulItemCharges - 3 )
        call AddSpecialEffectTargetUnitBJ("origin", udg_Hero_Necros, "Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
        set SEDragonSoulRecharged=GetLastCreatedEffectBJ()
    else
    endif
    // //
    call PolledWait(2)
    // //
    call DestroyEffectBJ(SEDragonSoulRecharged)
endfunction

//===========================================================================
function InitTrig_DragonSoul_Recharged takes nothing returns nothing
