//===========================================================================
// Trigger: Dragon ZuluhedTornado Start
//===========================================================================
function Trig_Dragon_ZuluhedTornado_Start_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(udg_Hero_Zuluhed, 'I000') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_ZuluhedTornado_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(0.25)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    // //
    // //
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I000'))
    // //
    call PlaySoundAtPointBJ(gg_snd_CycloneBirth1, 100, GetRectCenter(gg_rct_WhirlWindIn), 0)
    // //
    call CreateNUnitsAtLoc(1, 'n02G', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_WhirlWindIn), bj_UNIT_FACING)
    set udg_Unit_Tornado=GetLastCreatedUnit()
    call AddSpecialEffectTargetUnitBJ("sprite first", udg_Unit_Tornado, "CSW\\Units\\Orc\\Zuluhed\\Zuluhed.mdx")
    set udg_SE_ZuluhedTornadoEffect=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectColorByPlayer(udg_SE_ZuluhedTornadoEffect, Player(21))
    call BlzSetSpecialEffectScale(udg_SE_ZuluhedTornadoEffect, 0.80)
    call BlzSpecialEffectAddSubAnimation(udg_SE_ZuluhedTornadoEffect, SUBANIM_TYPE_READY)
    call BlzPlaySpecialEffect(udg_SE_ZuluhedTornadoEffect, ANIM_TYPE_STAND)
    // //
    call UnitShareVisionBJ(true, udg_Unit_Tornado, Player(0))
    call ShowUnitHide(udg_Hero_Zuluhed)
    // //
    call SetCameraTargetControllerNoZForPlayer(udg_Player_Actual, udg_Unit_Tornado, 0, 400.00, false)
    // //
    call AttachSoundToUnitBJ(gg_snd_CycloneLoop1, udg_Unit_Tornado)
    call PlaySoundBJ(gg_snd_CycloneLoop1)
    call IssuePointOrderLocBJ(udg_Unit_Tornado, "move", GetRectCenter(gg_rct_WhirlWindOut))
    // //
    call EnableSelect(false, false)
    // //
endfunction

//===========================================================================
function InitTrig_Dragon_ZuluhedTornado_Start takes nothing returns nothing
    set gg_trg_Dragon_ZuluhedTornado_Start=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Dragon_ZuluhedTornado_Start, gg_rct_WhirlWindIn)
    call TriggerAddCondition(gg_trg_Dragon_ZuluhedTornado_Start, Condition(function Trig_Dragon_ZuluhedTornado_Start_Conditions))
    call TriggerAddAction(gg_trg_Dragon_ZuluhedTornado_Start, function Trig_Dragon_ZuluhedTornado_Start_Actions)
endfunction

//===========================================================================
// Trigger: Dragon ZuluhedTornado End
//===========================================================================
function Trig_Dragon_ZuluhedTornado_End_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Unit_Tornado ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_ZuluhedTornado_End_Func024C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_o006_0292) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_ZuluhedTornado_End_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(0.25)
    // //
    call StopSoundBJ(gg_snd_CycloneLoop1, true)
    call PlaySoundAtPointBJ(gg_snd_CycloneDeath1, 100, GetRectCenter(gg_rct_WhirlWindOut), 0)
    call KillUnit(udg_Unit_Tornado)
    call PolledWait(4.75)
    // //
    // //
    call SetUnitPositionLoc(udg_Hero_Zuluhed, GetRectCenter(gg_rct_WhirlWindOut))
    // //
    call DestroyEffectBJ(udg_SE_ZuluhedTornadoEffect)
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    call PolledWait(1.00)
    // //
    call ResetToGameCameraForPlayer(Player(0), 1.00)
    // //
    call EnableSelect(true, true)
    call SelectUnitForPlayerSingle(udg_Hero_Zuluhed, udg_Player_Actual)
    // //
    if ( Trig_Dragon_ZuluhedTornado_End_Func024C() ) then
        call SetUnitOwner(gg_unit_o006_0292, udg_Player_Goblins, false)
    else
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Dragon_Boat_Becomes_Neutral)
    call QueuedTriggerAddBJ(gg_trg_Dragon_ZuluhedTornado_End_Q, true)
    // //
endfunction

