//===========================================================================
function Trig_DragonSoul_Discharged_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A62X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonSoul_Discharged_Actions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ("origin", udg_Hero_Necros, "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_DragonSoulDischarged=GetLastCreatedEffectBJ()
    call PolledWait(4.00)
    call DestroyEffectBJ(udg_SE_DragonSoulDischarged)
    call QueuedTriggerAddBJ(gg_trg_DragonSoul_Discharged_Hint_Q, true)
endfunction

