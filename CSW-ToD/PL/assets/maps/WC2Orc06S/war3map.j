//===========================================================================
// Trigger: Mother Alextrasza Setup
//===========================================================================
function Trig_Mother_Alextrasza_Setup_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(GetEnteringUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_Alextrasza_Setup_Func023C takes nothing returns boolean
    if ( not ( udg_Bool_AlextrazaInRaid == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_Alextrasza_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Bool_BossFightAlextraza=true
    // //
    set udg_Point_AlexBFRuneSpawn[1]=GetRectCenter(gg_rct_AlextraszaBFSpawnRune01)
    set udg_Point_AlexBFRuneSpawn[2]=GetRectCenter(gg_rct_AlextraszaBFSpawnRune02)
    set udg_Point_AlexBFRuneSpawn[3]=GetRectCenter(gg_rct_AlextraszaBFSpawnRune03)
    set udg_Point_AlexBFRuneSpawn[4]=GetRectCenter(gg_rct_AlextraszaBFSpawnRune04)
    // //
    set udg_Point_AlexLanding=GetRectCenter(gg_rct_OutroAlextraszaStunned)
    // //
    call DestroyGroup(udg_Group_TempLandingMove)
    // //
    call DisableTrigger(gg_trg_AlexRaid_Start)
    call DisableTrigger(gg_trg_AlexRaid_ShieldOn)
    call EnableTrigger(gg_trg_Mother_Alextrasza_Runes_Create)
    call ConditionalTriggerExecute(gg_trg_PlaylistBossfightAlextraza)
    call QueuedTriggerAddBJ(gg_trg_Mother_Alextrasza_Setup_Q, true)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_RedDragons, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_RedDragons, udg_Player_Actual, bj_ALLIANCE_UNALLIED_VISION)
    // //
    if ( Trig_Mother_Alextrasza_Setup_Func023C() ) then
        call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroAlextraszaStunned), "Abilities\\Spells\\Special\\Teleport\\Teleportto.mdx")
        set udg_SE_AlexTeleport=GetLastCreatedEffectBJ()
        call TriggerSleepAction(2)
        call SetUnitPositionLoc(udg_Hero_Alextrasza, GetRectCenter(gg_rct_OutroAlextraszaStunned))
    else
    endif
    // //
    call UnitRemoveAbilityBJ('AHds', udg_Hero_Alextrasza)
    // //
    call ConditionalTriggerExecute(gg_trg_Mother_Alextrasza_Setup_Hint_Q)
    // //
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Hero_Necros)
    call SetUnitManaPercentBJ(udg_Hero_Necros, 100)
    call SetUnitLifePercentBJ(udg_Hero_Necros, 100)
    // //
    call TriggerSleepAction(2)
    call DestroyEffectBJ(udg_SE_AlexTeleport)
    // //
    call PlayMusicBJ(udg_Music_CurrentName)
    // //
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    // //
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Mother_Alextrasza_Setup takes nothing returns nothing
    set gg_trg_Mother_Alextrasza_Setup=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Mother_Alextrasza_Setup, gg_rct_AlextraszaNest)
    call TriggerAddCondition(gg_trg_Mother_Alextrasza_Setup, Condition(function Trig_Mother_Alextrasza_Setup_Conditions))
    call TriggerAddAction(gg_trg_Mother_Alextrasza_Setup, function Trig_Mother_Alextrasza_Setup_Actions)
endfunction

