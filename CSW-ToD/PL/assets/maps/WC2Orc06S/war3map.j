// Trigger: Dragon Kobolds1
//===========================================================================
function Trig_Dragon_Kobolds1_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetAttacker()) == 'nkob' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'nkog' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'nkot' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'nkol' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Dragon_Kobolds1_Conditions takes nothing returns boolean
    if ( not Trig_Dragon_Kobolds1_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Kobolds1_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_Dragon_Kobolds1_Q, true)
endfunction

