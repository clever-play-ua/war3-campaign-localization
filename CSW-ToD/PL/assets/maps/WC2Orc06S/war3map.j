//===========================================================================
// Trigger: CreepMultiplierDifficulty
//===========================================================================
function Trig_CreepMultiplierDifficulty_Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_CreepMultiplierDifficulty_Func004C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_CreepMultiplierDifficulty_Func005C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_CreepMultiplierDifficulty_Func007A takes nothing returns nothing
    call BlzSetUnitMaxHP(GetEnumUnit(), ( BlzGetUnitMaxHP(GetEnumUnit()) + ( GetUnitLevel(GetEnumUnit()) * udg_Int_CreepHP ) ))
    call SetUnitLifePercentBJ(GetEnumUnit(), 100)
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetEnumUnit(), 0) + ( GetUnitLevel(GetEnumUnit()) * udg_Int_CreepDMG ) ))
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetEnumUnit(), 1) + ( GetUnitLevel(GetEnumUnit()) * udg_Int_CreepDMG ) ))
endfunction

function Trig_CreepMultiplierDifficulty_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_CreepMultiplierDifficulty_Func003C() ) then
    else
    endif
    if ( Trig_CreepMultiplierDifficulty_Func004C() ) then
    else
    endif
    if ( Trig_CreepMultiplierDifficulty_Func005C() ) then
    else
    endif
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_DarkIron), function Trig_CreepMultiplierDifficulty_Func007A)
endfunction

//===========================================================================
function InitTrig_CreepMultiplierDifficulty takes nothing returns nothing
    set gg_trg_CreepMultiplierDifficulty=CreateTrigger()
    call TriggerAddAction(gg_trg_CreepMultiplierDifficulty, function Trig_CreepMultiplierDifficulty_Actions)
endfunction

//===========================================================================
// Trigger: SpawnedMultiplierDifficulty
//===========================================================================
function Trig_SpawnedMultiplierDifficulty_Func001C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetSummonedUnit()) == udg_Player_DarkIron ) ) then
        return false
    endif
    return true
endfunction

function Trig_SpawnedMultiplierDifficulty_Actions takes nothing returns nothing
    if ( Trig_SpawnedMultiplierDifficulty_Func001C() ) then
        call BlzSetUnitMaxHP(GetSummonedUnit(), ( BlzGetUnitMaxHP(GetSummonedUnit()) + ( GetUnitLevel(GetSummonedUnit()) * udg_Int_CreepHP ) ))
        call SetUnitLifePercentBJ(GetSummonedUnit(), 100)
        call BlzSetUnitWeaponIntegerFieldBJ(GetSummonedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetSummonedUnit(), 0) + ( GetUnitLevel(GetSummonedUnit()) * udg_Int_CreepDMG ) ))
        call BlzSetUnitWeaponIntegerFieldBJ(GetSummonedUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetSummonedUnit(), 1) + ( GetUnitLevel(GetSummonedUnit()) * udg_Int_CreepDMG ) ))
    else
    endif
endfunction

//===========================================================================
function InitTrig_SpawnedMultiplierDifficulty takes nothing returns nothing
    set gg_trg_SpawnedMultiplierDifficulty=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpawnedMultiplierDifficulty, EVENT_PLAYER_UNIT_SUMMON)
    call TriggerAddAction(gg_trg_SpawnedMultiplierDifficulty, function Trig_SpawnedMultiplierDifficulty_Actions)
endfunction

//===========================================================================
// Trigger: NeutralSmartAttack
//===========================================================================
function Trig_NeutralSmartAttack_Conditions takes nothing returns boolean
    if ( not ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetOrderTargetUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetOrderTargetUnit()) == Player(PLAYER_NEUTRAL_PASSIVE) ) ) then
        return false
    endif
    if ( not ( BlzIsSelectionEnabled() == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(GetOrderTargetUnit()) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_NeutralSmartAttack_Actions takes nothing returns nothing
    local unit u= GetOrderTargetUnit()
    set u=GetOrderTargetUnit()
    set udg_Neutral_Smart_Order=IssueTargetOrder(GetTriggerUnit(), "attack", u)
endfunction

//===========================================================================
function InitTrig_NeutralSmartAttack takes nothing returns nothing
    set gg_trg_NeutralSmartAttack=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_NeutralSmartAttack, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddCondition(gg_trg_NeutralSmartAttack, Condition(function Trig_NeutralSmartAttack_Conditions))
    call TriggerAddAction(gg_trg_NeutralSmartAttack, function Trig_NeutralSmartAttack_Actions)
endfunction

//===========================================================================
// Trigger: Tharbek LevelUp
//===========================================================================
function Trig_Tharbek_LevelUp_Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Tharbek) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tharbek_LevelUp_Actions takes nothing returns nothing
    if ( Trig_Tharbek_LevelUp_Func001C() ) then
        call AddSpecialEffectTargetUnitBJ("origin", udg_SemiHero_Tharbek, "Abilities\\Spells\\Other\\Levelup\\Levelupcaster.mdx")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    call SetPlayerTechResearchedSwap('RTX2', ( GetPlayerTechCountSimple('RTX2', udg_Player_Actual) + 1 ), udg_Player_Actual)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Tharbek_LevelUp takes nothing returns nothing
    set gg_trg_Tharbek_LevelUp=CreateTrigger()
    call TriggerAddAction(gg_trg_Tharbek_LevelUp, function Trig_Tharbek_LevelUp_Actions)
endfunction

