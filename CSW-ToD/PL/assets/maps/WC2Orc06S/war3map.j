//===========================================================================
// Trigger: Dwarves AI Start
//===========================================================================
function Trig_Dwarves_AI_Start_Func004A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Dwarves_AI_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Ironforge), function Trig_Dwarves_AI_Start_Func004A)
    // //
    // //
    call RemoveGuardPosition(gg_unit_n60B_0242)
    call RemoveGuardPosition(gg_unit_dIFo_0278)
    call RemoveGuardPosition(gg_unit_dIFo_0277)
    call RemoveGuardPosition(gg_unit_dISc_0351)
    call RemoveGuardPosition(gg_unit_dISc_0354)
    call RemoveGuardPosition(gg_unit_dISc_0355)
    call RemoveGuardPosition(gg_unit_dISc_0352)
    call RemoveGuardPosition(gg_unit_dIFo_0279)
    call RemoveGuardPosition(gg_unit_dISc_0281)
    call RemoveGuardPosition(gg_unit_dISc_0282)
    call RemoveGuardPosition(gg_unit_dISc_0288)
    call RemoveGuardPosition(gg_unit_dISc_0287)
    call RemoveGuardPosition(gg_unit_dIMn_0286)
    // //
    call SetPlayerStateBJ(udg_Player_Ironforge, PLAYER_STATE_RESOURCE_GOLD, 10000)
    call SetPlayerStateBJ(udg_Player_Ironforge, PLAYER_STATE_RESOURCE_LUMBER, 10000)
    call AdjustPlayerStateBJ(50, udg_Player_Ironforge, PLAYER_STATE_RESOURCE_FOOD_CAP)
    // //
    call EnableTrigger(gg_trg_Dwarves_Gold)
    call EnableTrigger(gg_trg_Dwarves_Lumber)
    call EnableTrigger(gg_trg_Dwarves_AI_Defeated)
    // //
    call StartCampaignAI(udg_Player_Ironforge, "CSW\\Scripts\\ToDScripts\\WC2Orc06S\\WC2Orc06SP06DwarvesAI.ai")
    // //
endfunction

//===========================================================================
function InitTrig_Dwarves_AI_Start takes nothing returns nothing
    set gg_trg_Dwarves_AI_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_Dwarves_AI_Start, function Trig_Dwarves_AI_Start_Actions)
endfunction

