    set gg_trg_Ogres_Completed_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Ogres_Completed_Q, function Trig_Ogres_Completed_Q_Actions)
endfunction

//===========================================================================
// Trigger: Ogres Subjugated01
//===========================================================================
function Trig_Ogres_Subjugated01_Func001C takes nothing returns boolean
    if ( ( GetUnitStateSwap(UNIT_STATE_LIFE, gg_unit_nogo_0263) < 100.00 ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(gg_unit_nogo_0263) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_Ogres_Subjugated01_Conditions takes nothing returns boolean
    if ( not Trig_Ogres_Subjugated01_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Ogres_Subjugated01_Func006C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_nogo_0263) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ogres_Subjugated01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Int_OgreCounter=( udg_Int_OgreCounter + 1 )
    call RescueUnitBJ(gg_unit_nogo_0263, Player(0), true)
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, gg_unit_nogo_0263)
    if ( Trig_Ogres_Subjugated01_Func006C() ) then
        call QueuedTriggerAddBJ(gg_trg_Ogres_Subjugated_Q2, true)
    else
    endif
    call ConditionalTriggerExecute(gg_trg_Ogres_Completed)
endfunction

