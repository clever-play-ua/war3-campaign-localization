function Trig_Mother_Alextrasza_Landing_Func034A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
    if ( Trig_Mother_Alextrasza_Landing_Func034Func002C() ) then
        set udg_Point_ABFMoveAwayTemp=PolarProjectionBJ(udg_Point_AlexLanding, 512.00, 45.00)
        call IssuePointOrderLocBJ(GetEnumUnit(), "move", udg_Point_ABFMoveAwayTemp)
        call RemoveLocation(udg_Point_ABFMoveAwayTemp)
    else
        if ( Trig_Mother_Alextrasza_Landing_Func034Func002Func004C() ) then
            set udg_Point_ABFMoveAwayTemp=PolarProjectionBJ(udg_Point_AlexLanding, 512.00, 135.00)
            call IssuePointOrderLocBJ(GetEnumUnit(), "move", udg_Point_ABFMoveAwayTemp)
            call RemoveLocation(udg_Point_ABFMoveAwayTemp)
        else
            if ( Trig_Mother_Alextrasza_Landing_Func034Func002Func004Func004C() ) then
                set udg_Point_ABFMoveAwayTemp=PolarProjectionBJ(udg_Point_AlexLanding, 512.00, 225.00)
                call IssuePointOrderLocBJ(GetEnumUnit(), "move", udg_Point_ABFMoveAwayTemp)
                call RemoveLocation(udg_Point_ABFMoveAwayTemp)
            else
                if ( Trig_Mother_Alextrasza_Landing_Func034Func002Func004Func004Func004C() ) then
                    set udg_Point_ABFMoveAwayTemp=PolarProjectionBJ(udg_Point_AlexLanding, 512.00, 315.00)
                    call IssuePointOrderLocBJ(GetEnumUnit(), "move", udg_Point_ABFMoveAwayTemp)
                    call RemoveLocation(udg_Point_ABFMoveAwayTemp)
                else
                endif
            endif
        endif
    endif
endfunction

