    call TriggerAddAction(gg_trg_Ogres_Completed, function Trig_Ogres_Completed_Actions)
endfunction

//===========================================================================
// Trigger: Ogres Completed Q
//===========================================================================
function Trig_Ogres_Completed_Q_Func012C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Tharbek) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ogres_Completed_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_RedDragons, 'o608', GetCameraTargetPositionLoc(), gg_snd_WC2Orc06STharbek_OgreQuest2, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestSetCompletedBJ(udg_OQ_Ogres, true)
    call QuestItemSetCompletedBJ(udg_QReq_OgresSubjugate, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_4017")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call SetPlayerUnitAvailableBJ('o60Y', true, udg_Player_Actual)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UNITAVAILABLE, "TRIGSTR_4292")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    if ( Trig_Ogres_Completed_Q_Func012C() ) then
        call QueuedTriggerAddBJ(gg_trg_Tharbek_LevelUp, true)
    else
    endif
endfunction

