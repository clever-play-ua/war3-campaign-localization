    set udg_Unit_SkeletalDwarfArr[1]=GetLastCreatedUnit()
    call PauseUnitBJ(true, udg_Unit_SkeletalDwarfArr[1])
    // //
    call SetUnitAnimation(udg_Unit_SkeletalDwarfArr[1], "birth")
    call PolledWait(2.33)
    call ResetUnitAnimation(udg_Unit_SkeletalDwarfArr[1])
    call PauseUnitBJ(false, udg_Unit_SkeletalDwarfArr[1])
endfunction

