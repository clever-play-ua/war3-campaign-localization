    set gg_trg_Goblin_Gear_Sound=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Goblin_Gear_Sound, gg_rct_MechanicSound01)
    call TriggerRegisterEnterRectSimple(gg_trg_Goblin_Gear_Sound, gg_rct_MechanicSound02)
    call TriggerRegisterEnterRectSimple(gg_trg_Goblin_Gear_Sound, gg_rct_MechanicSound03)
