//===========================================================================
// Trigger: FireLord Victory
//===========================================================================
function Trig_FireLord_Victory_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Hero_FireLord ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Victory_Func005002 takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_FireLord_Victory_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call StopMusicBJ(false)
    call ConditionalTriggerExecute(gg_trg_PlaylistDungeon)
    // //
    call ForGroupBJ(udg_Group_LavaMinions, function Trig_FireLord_Victory_Func005002)
    // //
    call CreateItemLoc('I004', GetUnitLoc(GetDyingUnit()))
    call SetItemInvulnerableBJ(GetLastCreatedItem(), true)
    call PlaySoundBJ(gg_snd_ItemReceived)
    // //
    set udg_Bool_BossFightFireLord=false
    call PlaySoundBJ(gg_snd_WarlockAppears)
    call DisableTrigger(gg_trg_LavaLake_RandomCycle)
    call PolledWait(1.00)
    set udg_Int_LavaPuzzlePreviousLevel=udg_Int_LavaPuzzleLevel
    set udg_Int_LavaPuzzleLevel=2
    // //
    call PolledWait(1.00)
    call ConditionalTriggerExecute(gg_trg_LavaLake_ElevatorApplyLevel)
    // //
    call RemoveDestructable(gg_dest_B01L_10047)
    call RemoveDestructable(gg_dest_B01L_10046)
    call RemoveDestructable(gg_dest_B01L_10062)
    call RemoveDestructable(gg_dest_B01L_10063)
    call RemoveDestructable(gg_dest_B01L_10258)
    call RemoveDestructable(gg_dest_B01L_10259)
    call RemoveDestructable(gg_dest_B01L_10257)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOf2', gg_rct_FiretrapsCosmetics02)
    call SetDoodadAnimationRectBJ("death", 'YOf2', gg_rct_FiretrapsCosmetics01)
    // //
    call DestroyMinimapIcon(udg_MinimapIcon_FirelordBoss)
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_VincentTurnCoat, GetRectCenter(gg_rct_MoveVIncentHere), 340.99)
    call AddSpecialEffectTargetUnitBJ("overhead", udg_Hero_VincentTurnCoat, "Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl")
    set udg_SE_ExclamationMark=GetLastCreatedEffectBJ()
    // ///
    // ///
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_MoveVIncentHere), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Goblin=GetLastCreatedMinimapIcon()
    // ///
    call PlayMusicBJ(udg_Music_CurrentName)
    call PolledWait(1.00)
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
endfunction

//===========================================================================
function InitTrig_FireLord_Victory takes nothing returns nothing
    set gg_trg_FireLord_Victory=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_FireLord_Victory, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_FireLord_Victory, Condition(function Trig_FireLord_Victory_Conditions))
    call TriggerAddAction(gg_trg_FireLord_Victory, function Trig_FireLord_Victory_Actions)
endfunction

//===========================================================================
// Trigger: FireLord Escape
//===========================================================================
function Trig_FireLord_Escape_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightFireLord == true ) ) then
        return false
    endif
    if ( not ( GetTriggerUnit() == udg_Hero_FireLord ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_FireLord) <= ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_FireLord) / 2.00 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Escape_Func009C takes nothing returns boolean
    if ( not ( RectContainsUnit(udg_Region_FirelordEscape, udg_Hero_FireLord) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_Escape_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Point_FireLordCurrentPosition=GetUnitLoc(udg_Hero_FireLord)
    // ////
    set udg_Int_ChanceFireLordEscapeLoc=GetRandomInt(1, 4)
    // ////
    set udg_Region_FirelordEscape=RectFromCenterSizeBJ(udg_Point_FireLordEscape[udg_Int_ChanceFireLordEscapeLoc], 512.00, 512.00)
    // ////
    if ( Trig_FireLord_Escape_Func009C() ) then
        call SetUnitAnimation(udg_Hero_FireLord, "spell")
        call AddSpecialEffectLocBJ(udg_Point_FireLordCurrentPosition, "Abilities\\Spells\\Human\\FlameStrike\\FlameStrike2.mdl")
        set udg_SE_FireLordEscape=GetLastCreatedEffectBJ()
        call PolledWait(1.17)
        call DestroyEffectBJ(udg_SE_FireLordEscape)
        // //
        call SetUnitPositionLoc(udg_Hero_FireLord, udg_Point_FireLordEscape[udg_Int_ChanceFireLordEscapeLoc])
        call AddSpecialEffectLocBJ(udg_Point_FireLordEscape[udg_Int_ChanceFireLordEscapeLoc], "Abilities\\Spells\\Human\\FlameStrike\\FlameStrike.mdl")
        set udg_SE_FireLord=GetLastCreatedEffectBJ()
        call DestroyEffectBJ(udg_SE_FireLord)
        call ResetUnitAnimation(udg_Hero_FireLord)
    else
    endif
    // ////
    call StartTimerBJ(udg_Timer_LLFireLordAllowEscape, false, 60.00)
    // ////
    call RemoveRect(udg_Region_FirelordEscape)
    call RemoveLocation(udg_Point_FireLordCurrentPosition)
    call ConditionalTriggerExecute(gg_trg_FireLord_SpawnMinions)
    call QueuedTriggerAddBJ(gg_trg_FireLord_Escape_Q, true)
endfunction

//===========================================================================
function InitTrig_FireLord_Escape takes nothing returns nothing
    set gg_trg_FireLord_Escape=CreateTrigger()
    call DisableTrigger(gg_trg_FireLord_Escape)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_FireLord_Escape, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_FireLord_Escape, Condition(function Trig_FireLord_Escape_Conditions))
    call TriggerAddAction(gg_trg_FireLord_Escape, function Trig_FireLord_Escape_Actions)
endfunction

