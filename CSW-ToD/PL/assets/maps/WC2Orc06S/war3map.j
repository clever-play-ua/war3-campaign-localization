//===========================================================================
// Trigger: Orastrasz SummonGoblins
//===========================================================================
function Trig_Orastrasz_SummonGoblins_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightOrastrasz == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_OrastraszLanded == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_SummonGoblins_Func002Func001001001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'ngbl' )
endfunction

function Trig_Orastrasz_SummonGoblins_Func002Func001001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Orastrasz_SummonGoblins_Func002Func001001001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'ngbl'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Orastrasz_SummonGoblins_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_TreasuryLights, Condition(function Trig_Orastrasz_SummonGoblins_Func002Func001001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_SummonGoblins_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Orastrasz_SummonGoblins_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call CreateNUnitsAtLoc(1, 'ngbl', udg_Player_Actual, udg_Point_OrastraszOpenChamber, 90.00)
        set udg_Unit_GoblinBlasterHelp=GetLastCreatedUnit()
        call IssueTargetOrderBJ(udg_Unit_GoblinBlasterHelp, "attack", udg_Hero_Orastrasz)
        call PolledWait(60.00)
        call EnableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction

//===========================================================================
function InitTrig_Orastrasz_SummonGoblins takes nothing returns nothing
    set gg_trg_Orastrasz_SummonGoblins=CreateTrigger()
    call DisableTrigger(gg_trg_Orastrasz_SummonGoblins)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Orastrasz_SummonGoblins, 30.00)
    call TriggerAddCondition(gg_trg_Orastrasz_SummonGoblins, Condition(function Trig_Orastrasz_SummonGoblins_Conditions))
    call TriggerAddAction(gg_trg_Orastrasz_SummonGoblins, function Trig_Orastrasz_SummonGoblins_Actions)
endfunction

