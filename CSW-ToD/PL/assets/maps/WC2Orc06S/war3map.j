//===========================================================================
function Trig_Zuluhed_I_Lightning_Strike_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuluhed_I_Lightning_Strike_Func012Func001Func003Func001Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A00U', GetTriggerUnit()) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuluhed_I_Lightning_Strike_Func012Func001Func003Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A00U', GetTriggerUnit()) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuluhed_I_Lightning_Strike_Func012Func001Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A00U', GetTriggerUnit()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuluhed_I_Lightning_Strike_Func012Func001C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    if ( not ( IsDestructableInvulnerableBJ(GetEnumDestructable()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zuluhed_I_Lightning_Strike_Func012A takes nothing returns nothing
    if ( Trig_Zuluhed_I_Lightning_Strike_Func012Func001C() ) then
        if ( Trig_Zuluhed_I_Lightning_Strike_Func012Func001Func003C() ) then
            call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 100.00 ))
        else
            if ( Trig_Zuluhed_I_Lightning_Strike_Func012Func001Func003Func001C() ) then
                call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 150.00 ))
            else
                if ( Trig_Zuluhed_I_Lightning_Strike_Func012Func001Func003Func001Func003C() ) then
                    call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 200.00 ))
                else
                endif
            endif
        endif
    else
    endif
endfunction

function Trig_Zuluhed_I_Lightning_Strike_Actions takes nothing returns nothing
    set udg_Zuluhed_TempPoint_E=GetSpellTargetLoc()
    //  
    // Dummy (Spells)
    call CreateNUnitsAtLoc(1, 'u003', GetOwningPlayer(GetTriggerUnit()), udg_Zuluhed_TempPoint_E, bj_UNIT_FACING)
    set udg_Zuluhed_Dummy_E=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_Zuluhed_Dummy_E)
    // Ability: Lightning Strike (Zuluhed - Effect)
    call UnitAddAbilityBJ('A013', udg_Zuluhed_Dummy_E)
    call SetUnitAbilityLevelSwapped('A013', udg_Zuluhed_Dummy_E, GetUnitAbilityLevelSwapped('A00U', GetTriggerUnit()))
    call IssueImmediateOrderBJ(udg_Zuluhed_Dummy_E, "stomp")
    //  
    call EnumDestructablesInCircleBJ(150.00, udg_Zuluhed_TempPoint_E, function Trig_Zuluhed_I_Lightning_Strike_Func012A)
    //  
    call RemoveLocation(udg_Zuluhed_TempPoint_E)
endfunction

