    set gg_trg_Zuluhed_I_Lightning_Strike=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Zuluhed_I_Lightning_Strike, EVENT_PLAYER_UNIT_SPELL_EFFECT)
