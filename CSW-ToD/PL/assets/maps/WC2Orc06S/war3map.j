endfunction

//===========================================================================
// Trigger: Outro Cinematic Cleanup
//===========================================================================
function Trig_Outro_Cinematic_Cleanup_Func008C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Necros) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Outro_Cinematic_Cleanup_Func010C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Tharbek) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Outro_Cinematic_Cleanup_Func013C takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Outro_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Bool_CinOutroOn=false
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    if ( Trig_Outro_Cinematic_Cleanup_Func008C() ) then
        call ShowUnitShow(udg_Hero_Necros)
        call PauseUnitBJ(false, udg_Hero_Necros)
    else
    endif
    // //
    if ( Trig_Outro_Cinematic_Cleanup_Func010C() ) then
        call CreateNUnitsAtLoc(1, 'o608', udg_Player_Actual, GetRectCenter(gg_rct_OutroTharbek), 90.00)
        set udg_SemiHero_Tharbek=GetLastCreatedUnit()
        call SetUnitColor(udg_SemiHero_Tharbek, PLAYER_COLOR_MAROON)
    else
        call ShowUnitShow(udg_SemiHero_Tharbek)
        call PauseUnitBJ(false, udg_SemiHero_Tharbek)
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    if ( Trig_Outro_Cinematic_Cleanup_Func013C() ) then
        call StopSoundBJ(gg_snd_NightElfDefeat01, false)
        call StopSoundBJ(gg_snd_WC2Orc06STharbek5, false)
        call StopSoundBJ(gg_snd_WC2Orc06STharbek6, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros6, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros7, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros8, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros9, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros10, false)
        call StopSoundBJ(gg_snd_WC2Orc06SAlexstrasza1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SAlexstrasza2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SAlexstrasza3, false)
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(2.00)
    // //
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

