function Trig_FireLord_WeakRunes_Create2_Func014002 takes nothing returns nothing
    call RemoveItem(GetEnumItem())
endfunction

function Trig_FireLord_WeakRunes_Create2_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // Define Type of Rune
    // //
    set udg_Int_ChanceTypeRuneWeak=GetRandomInt(1, 3)
    // //
    if ( Trig_FireLord_WeakRunes_Create2_Func007C() ) then
        set udg_ItemType_RuneWeakLavaLake='rhe2'
    else
        if ( Trig_FireLord_WeakRunes_Create2_Func007Func003C() ) then
            set udg_ItemType_RuneWeakLavaLake='rhe1'
        else
            set udg_ItemType_RuneWeakLavaLake='rman'
        endif
    endif
    // //
    // LocateZuluhed
    if ( Trig_FireLord_WeakRunes_Create2_Func010C() ) then
        set udg_Int_SpawnRuneWeakRange=GetRandomInt(1, 5)
    else
        if ( Trig_FireLord_WeakRunes_Create2_Func010Func002C() ) then
            set udg_Int_SpawnRuneWeakRange=GetRandomInt(6, 7)
        else
            if ( Trig_FireLord_WeakRunes_Create2_Func010Func002Func002C() ) then
                set udg_Int_SpawnRuneWeakRange=8
            else
                if ( Trig_FireLord_WeakRunes_Create2_Func010Func002Func002Func002C() ) then
                    set udg_Int_SpawnRuneWeakRange=GetRandomInt(8, 9)
                else
                    call DoNothing()
                endif
            endif
        endif
    endif
    // //
    // CleanUp Previous Rune
    // //
    call EnumItemsInRectBJ(RectFromCenterSizeBJ(udg_Point_LavaLakeWeakRuneSpawn[udg_Int_SpawnRuneWeakRange], 128.00, 128.00), function Trig_FireLord_WeakRunes_Create2_Func014002)
    // //
    // //
    // SpawnWeakRune
    // //
    call AddSpecialEffectLocBJ(udg_Point_LavaLakeWeakRuneSpawn[udg_Int_SpawnRuneWeakRange], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    set udg_SE_RuneWeakBFFL=GetLastCreatedEffectBJ()
    call CreateItemLoc(udg_ItemType_RuneWeakLavaLake, udg_Point_LavaLakeWeakRuneSpawn[udg_Int_SpawnRuneWeakRange])
    // //
    call StartTimerBJ(udg_Timer_LLWeakRuneReset, false, 60.00)
    // //
    call PolledWait(0.25)
    call DestroyEffectBJ(udg_SE_RuneWeakBFFL)
endfunction

