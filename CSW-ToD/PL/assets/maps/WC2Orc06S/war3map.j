    return ( udg_Bool_CinDungeonExitSkipped == true )
endfunction

function Trig_Exit_Cinematic_Q_Func103001 takes nothing returns boolean
    return ( udg_Bool_CinDungeonExitSkipped == true )
endfunction

function Trig_Exit_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCInematicSetUp)
    call CinematicModeBJ(true, GetPlayersAll())
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinsCheer, udg_Player_Actual, 0)
    // //
    call ConditionalTriggerExecute(gg_trg_Exit_Cinematic_Setup)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinDungeonExitOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call PlaySoundBJ(gg_snd_AmmoDumpWhat1)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ZuluhedDungeonExit, udg_Player_Actual, 0)
    set udg_Point_ZuluhedCinTemp=GetUnitLoc(udg_FakeZuluhed)
    call CameraSetupApplyForPlayer(true, gg_cam_DeathwingExit01, udg_Player_Actual, ( ( DistanceBetweenPoints(udg_Point_ZuluhedCinTemp, GetRectCenter(gg_rct_ZuluhedDungeonExitCinemaitc02a)) / GetUnitMoveSpeed(udg_FakeZuluhed) ) - 2.00 ))
    call SetTerrainFogExBJ(0, 1000.00, 5000.00, 0.10, 0.00, 0.00, 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call PlaySoundBJ(gg_snd_CS_BG_Camp)
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_ZuluhedDungeonExitCinemaitc02a))
    set udg_Point_ZuluhedCinTemp=GetUnitLoc(udg_FakeZuluhed)
    call TriggerSleepAction(( ( DistanceBetweenPoints(udg_Point_ZuluhedCinTemp, GetRectCenter(gg_rct_ZuluhedDungeonExitCinemaitc02a)) / GetUnitMoveSpeed(udg_FakeZuluhed) ) - 2.00 ))
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DeathwingExit02, udg_Player_Actual, 0)
    // //
    call PlaySoundBJ(gg_snd_Mainscreen)
    // //
    call SetDoodadAnimationRectBJ("stand", 'ZZcd', gg_rct_DungeonBossfightZone)
    // //
    call SetUnitScalePercent(gg_unit_O601_0249, 600.00, 600.00, 600.00)
    call ShowUnitShow(udg_Hero_Deathwing)
    call PlaySoundBJ(gg_snd_BridgeDeath)
    call SetUnitAnimation(udg_Hero_Deathwing, "Morph Alternate")
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 3.00)
    call KillDestructable(gg_dest_YT22_10496)
    call TriggerSleepAction(0.50)
    call AddWeatherEffectSaveLast(gg_rct_BurstCeilingRays, 'LRaa')
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetDoodadAnimationRectBJ("stand", 'D02J', gg_rct_DeathwingBursts)
    call TriggerSleepAction(1.80)
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_DeathwingLand)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DeathwingBursts), "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl")
    set udg_SE_DragonLandingClap=GetLastCreatedEffectBJ()
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DeathwingBursts), "units\\undead\\cryptfiend\\cryptfiendburrow.mdl")
    set udg_SE_DragonLandingDust=GetLastCreatedEffectBJ()
    // //
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call SetUnitAnimation(udg_Hero_Deathwing, "stand")
    // //
    call SetDoodadAnimationRectBJ("death", 'ZZcd', gg_rct_DungeonBossfightZone)
    call DestroyEffectBJ(udg_SE_DragonLandingClap)
    call DestroyEffectBJ(udg_SE_DragonLandingDust)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DeathwingExit01, udg_Player_Actual, 0)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Deathwing, 0, gg_snd_WC2Orc06SDeathwing_AfterBoss1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DeathwingExit02, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic frustrated one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_DeathwingIsBack1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DeathwingExit01, udg_Player_Actual, 0)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Deathwing, 0, gg_snd_WC2Orc06SDeathwing_AfterBoss2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Deathwing, 0, gg_snd_WC2Orc06SDeathwing_AfterBoss3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_DeathwingExit02, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_DeathwingIsBack2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_Mainscreen, true)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Deathwing, 0, gg_snd_WC2Orc06SDeathwing_AfterBoss4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDungeonExitSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Exit_Cinematic_Cleanup)
endfunction

