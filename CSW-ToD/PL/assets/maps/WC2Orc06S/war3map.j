endfunction

function Trig_Treasury_Cinematic_Q_Func110001 takes nothing returns boolean
    return ( udg_Bool_CinTreasurySkipped == true )
endfunction

function Trig_Treasury_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_GenericCInematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call ConditionalTriggerExecute(gg_trg_Treasury_Cinematic_Setup)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Treasury01, udg_Player_Actual, 0)
    call TriggerSleepAction(0.50)
    call CameraSetupApplyForPlayer(true, gg_cam_Treasury02, udg_Player_Actual, 10.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinTreasuryOn=true
    set udg_Bool_CinematicSkipped=false
    call PlaySoundBJ(gg_snd_ACT_II_WarlockTheme)
    // //
    call PlaySoundBJ(gg_snd_GateOpen)
    call SetDoodadAnimationRectBJ("death", 'D6B3', gg_rct_ChamberDoor)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_DragonEncounter1, bj_TIMETYPE_ADD, 0, false)
    // //
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_TreasuryZuluhed01))
    call PlaySoundBJ(gg_snd_CS_BG_Camp)
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_GoblinBlasterA, "move", GetRectCenter(gg_rct_BossfightPlayerUnits))
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_GoblinBlasterB, "move", GetRectCenter(gg_rct_BossfightPlayerUnits))
    // //
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Treasury04A, udg_Player_Actual, 0)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_GoblinBlasterC, "move", GetRectCenter(gg_rct_BossfightPlayerUnits))
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_GoblinBlasterD, "move", GetRectCenter(gg_rct_BossfightPlayerUnits))
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Treasury07, udg_Player_Actual, 0)
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Treasury05, udg_Player_Actual, 0)
    call TriggerSleepAction(2.50)
    call SetUnitTimeScalePercent(udg_FakeZuluhed, 25.00)
    call SetUnitAnimation(udg_FakeZuluhed, "attack")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_DragonEncounter1a, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetItemVisibleBJ(false, gg_item_I60U_0057)
    call PlaySoundBJ(gg_snd_HeroDropItem1)
    // //
    // Dragon Awakens
    // //
    call SetUnitAnimation(udg_Hero_Orastrasz, "Cinematic sleep end")
    call QueueUnitAnimationBJ(udg_Hero_Orastrasz, "cinematic standard one")
    call CameraSetupApplyForPlayer(true, gg_cam_TreasuryDragonWakesUp, udg_Player_Actual, 0)
    call SetUnitTimeScalePercent(udg_FakeZuluhed, 100.00)
    // //
    call SetDoodadAnimationRectBJ("stand", 'LOtz', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("stand", 'D020', gg_rct_TreasuryLights)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PauseUnitBJ(false, udg_Hero_Orastrasz)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Orastrasz, 0, gg_snd_WC2Orc06SOrastrasz_Encounter1, bj_TIMETYPE_ADD, 0, false)
    // //
    call SetDoodadAnimationRectBJ("stand", 'OOgr', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("stand", 'AObr', gg_rct_TreasuryLights)
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssueImmediateOrderBJ(udg_Hero_Orastrasz, "ravenform")
    // //
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Treasury06, udg_Player_Actual, 0)
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc06SOrastrasz_Encounter1, 0)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Hero_Orastrasz, "move", GetRectCenter(gg_rct_OrastraszApproachesCin))
    // //
    set udg_Bool_OrastraszFlying=true
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Treasury03, udg_Player_Actual, 0)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_DragonEncounter2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Treasury06, udg_Player_Actual, 0)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Orastrasz, 0, gg_snd_WC2Orc06SOrastrasz_Encounter2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_ACT_II_WarlockTheme, true)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinTreasurySkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Treasury_Cinematic_Cleanup)
endfunction

