    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundBJ(gg_snd_DoorSlam1)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_KoboldSpawn02), "sharedfx\\scarabburrow\\scarabburrow.mdl")
    set udg_SE_Dust[6]=GetLastCreatedEffectBJ()
    // //
    call ShowUnitShow(gg_unit_nkot_0091)
