//===========================================================================
// Trigger: Dragon Boat Capture
//===========================================================================
function Trig_Dragon_Boat_Capture_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Boat_Capture_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitInvulnerable(gg_unit_o006_0292, false)
    // //
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    // //
    // Setting stats to be similar as Hero has
    call BlzSetUnitRealFieldBJ(udg_Unit_ZuluhedBoat, UNIT_RF_HP, BlzGetUnitRealField(udg_Hero_Zuluhed, UNIT_RF_HP))
    call BlzSetUnitRealFieldBJ(udg_Unit_ZuluhedBoat, UNIT_RF_MANA, BlzGetUnitRealField(udg_Hero_Zuluhed, UNIT_RF_MANA))
    call BlzSetUnitWeaponIntegerFieldBJ(udg_Unit_ZuluhedBoat, UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, BlzGetUnitWeaponIntegerField(udg_Hero_Zuluhed, UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0))
    call BlzSetUnitWeaponIntegerFieldBJ(udg_Unit_ZuluhedBoat, UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, BlzGetUnitWeaponIntegerField(udg_Hero_Zuluhed, UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1))
    call BlzSetUnitMaxMana(udg_Unit_ZuluhedBoat, BlzGetUnitMaxMana(udg_Hero_Zuluhed))
    call SetUnitManaPercentBJ(udg_Unit_ZuluhedBoat, 100)
    call BlzSetUnitRealFieldBJ(udg_Unit_ZuluhedBoat, UNIT_RF_MANA_REGENERATION, BlzGetUnitRealField(udg_Hero_Zuluhed, UNIT_RF_MANA_REGENERATION))
    // //
    call RescueUnitBJ(gg_unit_o006_0292, udg_Player_Actual, false)
    call QueuedTriggerAddBJ(gg_trg_Dragon_Boat_Capture_Q, true)
endfunction

//===========================================================================
function InitTrig_Dragon_Boat_Capture takes nothing returns nothing
    set gg_trg_Dragon_Boat_Capture=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Dragon_Boat_Capture, gg_rct_AquireBoat)
    call TriggerAddCondition(gg_trg_Dragon_Boat_Capture, Condition(function Trig_Dragon_Boat_Capture_Conditions))
    call TriggerAddAction(gg_trg_Dragon_Boat_Capture, function Trig_Dragon_Boat_Capture_Actions)
endfunction

//===========================================================================
// Trigger: Dragon Boat Capture Q
//===========================================================================
function Trig_Dragon_Boat_Capture_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc06SZuluhed_UseBoat1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Dragon_Boat_Capture_Q takes nothing returns nothing
    set gg_trg_Dragon_Boat_Capture_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Dragon_Boat_Capture_Q, function Trig_Dragon_Boat_Capture_Q_Actions)
endfunction

//===========================================================================
// Trigger: Dragon Boat Load
//===========================================================================
function Trig_Dragon_Boat_Load_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'Slo3' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityUnit() == udg_Unit_ZuluhedBoat ) ) then
        return false
    endif
    if ( not ( udg_Bool_ZuluhedInBoat == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Boat_Load_Actions takes nothing returns nothing
    // Showing Zuluhed
    set udg_Bool_ZuluhedInBoat=true
    call AddUnitAnimationPropertiesBJ(true, "alternate", udg_Unit_ZuluhedBoat)
    // //
    // Making Organic
    call UnitRemoveTypeBJ(UNIT_TYPE_MECHANICAL, udg_Unit_ZuluhedBoat)
    // //
    // Adding relevant Hero abilities
    call UnitAddAbilityBJ('A00U', udg_Unit_ZuluhedBoat)
    call SetUnitAbilityLevelSwapped('A00U', udg_Unit_ZuluhedBoat, GetUnitAbilityLevelSwapped('A00U', udg_Hero_Zuluhed))
    call UnitAddAbilityBJ('A00R', udg_Unit_ZuluhedBoat)
    call SetUnitAbilityLevelSwapped('A00R', udg_Unit_ZuluhedBoat, GetUnitAbilityLevelSwapped('A00R', udg_Hero_Zuluhed))
    // //
    // Unblocking attack through Upgrade mechanic
    call SetPlayerTechResearchedSwap('RM60', 1, udg_Player_Actual)
    // //
    // Assigning Skin in order to have propper icon and soundkit
    call BlzSetUnitSkin(udg_Unit_ZuluhedBoat, 'o001')
    call BlzSetUnitRealFieldBJ(udg_Unit_ZuluhedBoat, UNIT_RF_HIT_POINTS_REGENERATION_RATE, BlzGetUnitRealField(udg_Hero_Zuluhed, UNIT_RF_HIT_POINTS_REGENERATION_RATE))
    call BlzSetUnitRealFieldBJ(udg_Unit_ZuluhedBoat, UNIT_RF_MANA_REGENERATION, BlzGetUnitRealField(udg_Hero_Zuluhed, UNIT_RF_MANA_REGENERATION))
endfunction

//===========================================================================
function InitTrig_Dragon_Boat_Load takes nothing returns nothing
    set gg_trg_Dragon_Boat_Load=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Dragon_Boat_Load, Player(0), EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddCondition(gg_trg_Dragon_Boat_Load, Condition(function Trig_Dragon_Boat_Load_Conditions))
    call TriggerAddAction(gg_trg_Dragon_Boat_Load, function Trig_Dragon_Boat_Load_Actions)
endfunction

//===========================================================================
// Trigger: Dragon Boat Unload
//===========================================================================
function Trig_Dragon_Boat_Unload_Func006C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'Adri' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'Sdro' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Dragon_Boat_Unload_Conditions takes nothing returns boolean
    if ( not Trig_Dragon_Boat_Unload_Func006C() ) then
        return false
    endif
    if ( not ( GetSpellAbilityUnit() == udg_Unit_ZuluhedBoat ) ) then
        return false
    endif
    if ( not ( udg_Bool_ZuluhedInBoat == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dragon_Boat_Unload_Actions takes nothing returns nothing
    set udg_Bool_ZuluhedInBoat=false
    call AddUnitAnimationPropertiesBJ(false, "alternate", udg_Unit_ZuluhedBoat)
    // //
    call UnitAddTypeBJ(UNIT_TYPE_MECHANICAL, udg_Unit_ZuluhedBoat)
    // //
    call UnitRemoveAbilityBJ('A00R', udg_Unit_ZuluhedBoat)
    call UnitRemoveAbilityBJ('A00U', udg_Unit_ZuluhedBoat)
    // //
    call SetPlayerTechResearchedSwap('RM60', 0, udg_Player_Actual)
    // //
    call BlzSetUnitSkin(udg_Unit_ZuluhedBoat, 'o006')
    call BlzSetUnitRealFieldBJ(udg_Unit_ZuluhedBoat, UNIT_RF_HIT_POINTS_REGENERATION_RATE, 0.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_ZuluhedBoat, UNIT_RF_MANA_REGENERATION, 0.00)
endfunction

//===========================================================================
function InitTrig_Dragon_Boat_Unload takes nothing returns nothing
    set gg_trg_Dragon_Boat_Unload=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Dragon_Boat_Unload, Player(0), EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddCondition(gg_trg_Dragon_Boat_Unload, Condition(function Trig_Dragon_Boat_Unload_Conditions))
    call TriggerAddAction(gg_trg_Dragon_Boat_Unload, function Trig_Dragon_Boat_Unload_Actions)
endfunction

