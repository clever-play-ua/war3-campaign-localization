function InitTrig_OilSpentForBlacksmith takes nothing returns nothing
    set gg_trg_OilSpentForBlacksmith=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilSpentForBlacksmith, Player(0), EVENT_PLAYER_UNIT_CONSTRUCT_START)
    call TriggerAddCondition(gg_trg_OilSpentForBlacksmith, Condition(function Trig_OilSpentForBlacksmith_Conditions))
    call TriggerAddAction(gg_trg_OilSpentForBlacksmith, function Trig_OilSpentForBlacksmith_Actions)
