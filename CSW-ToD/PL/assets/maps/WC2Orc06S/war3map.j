    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_Alextrasza_Setup_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Alextrasza, 'O61G', gg_snd_WC2Orc06SAlexstrasza_BossFight1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Necros, 'O61E', gg_snd_WC2Orc06SNekros_BossFight1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call CampaignMinimapIconUnitBJ(udg_Hero_Alextrasza, bj_CAMPPINGSTYLE_BOSS)
    set udg_MinimapIcon_AlextraszaBoss=GetLastCreatedMinimapIcon()
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

