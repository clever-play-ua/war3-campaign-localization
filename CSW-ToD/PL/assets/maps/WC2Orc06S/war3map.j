//===========================================================================
function Trig_Treasury_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinTreasuryOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Treasury_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinematicSkipped=true
    set udg_Bool_CinTreasurySkipped=true
    call StopSoundBJ(gg_snd_CS_BG_Camp, false)
    call StopSoundBJ(gg_snd_ACT_II_WarlockTheme, false)
    call StopSoundBJ(gg_snd_GateOpen, false)
    call StopSoundBJ(gg_snd_IronGolemWhat1, false)
    call StopSoundBJ(gg_snd_IronGolemWhat2, false)
    call StopSoundBJ(gg_snd_IronGolemYes2, false)
    call StopSoundBJ(gg_snd_HeroDropItem1, false)
    call ConditionalTriggerExecute(gg_trg_Treasury_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Treasury_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Treasury_Cinematic_Skipped=CreateTrigger()
