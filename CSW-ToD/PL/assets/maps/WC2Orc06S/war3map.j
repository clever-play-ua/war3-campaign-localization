    if ( Trig_Orastrasz_Runes_Create_Func011Func001C() ) then
        call AddSpecialEffectLocBJ(udg_Point_RuneCreateOrastraszBF[4], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
        set udg_SE_RuneWeakBFOR=GetLastCreatedEffectBJ()
        call EnumItemsInRectBJ(gg_rct_OrastraszRuneSpawn04, function Trig_Orastrasz_Runes_Create_Func011Func001Func003002)
        call PolledWait(0.25)
        call DestroyEffectBJ(udg_SE_RuneWeakBFOR)
    else
        call DoNothing()
    endif
endfunction

function Trig_Orastrasz_Runes_Create_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // RemoveRunes
    // //
    call EnumItemsInRectBJ(gg_rct_OrastraszRuneSpawn01, function Trig_Orastrasz_Runes_Create_Func005A)
    // //
    call EnumItemsInRectBJ(gg_rct_OrastraszRuneSpawn02, function Trig_Orastrasz_Runes_Create_Func007A)
    // //
    call EnumItemsInRectBJ(gg_rct_OrastraszRuneSpawn03, function Trig_Orastrasz_Runes_Create_Func009A)
    // //
    call EnumItemsInRectBJ(gg_rct_OrastraszRuneSpawn04, function Trig_Orastrasz_Runes_Create_Func011A)
    // //
    // Create Runes
    // //
    call ConditionalTriggerExecute(gg_trg_StrongRune_SetChance)
    call AddSpecialEffectLocBJ(udg_Point_RuneCreateOrastraszBF[1], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    set udg_SE_RuneWeakBFOR=GetLastCreatedEffectBJ()
    call PolledWait(0.25)
    call CreateItemLoc(udg_ItemType_RuneStrongLavaLake, udg_Point_RuneCreateOrastraszBF[1])
    call DestroyEffectBJ(udg_SE_RuneWeakBFOR)
    // //
    call AddSpecialEffectLocBJ(udg_Point_RuneCreateOrastraszBF[2], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    set udg_SE_RuneWeakBFOR=GetLastCreatedEffectBJ()
    call ConditionalTriggerExecute(gg_trg_StrongRune_SetChance)
    call PolledWait(0.25)
    call CreateItemLoc(udg_ItemType_RuneStrongLavaLake, udg_Point_RuneCreateOrastraszBF[2])
    call DestroyEffectBJ(udg_SE_RuneWeakBFOR)
    // //
    call AddSpecialEffectLocBJ(udg_Point_RuneCreateOrastraszBF[3], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    set udg_SE_RuneWeakBFOR=GetLastCreatedEffectBJ()
    call ConditionalTriggerExecute(gg_trg_StrongRune_SetChance)
    call PolledWait(0.25)
    call CreateItemLoc(udg_ItemType_RuneStrongLavaLake, udg_Point_RuneCreateOrastraszBF[3])
    call DestroyEffectBJ(udg_SE_RuneWeakBFOR)
    // //
    call AddSpecialEffectLocBJ(udg_Point_RuneCreateOrastraszBF[4], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
    set udg_SE_RuneWeakBFOR=GetLastCreatedEffectBJ()
    call ConditionalTriggerExecute(gg_trg_StrongRune_SetChance)
    call PolledWait(0.25)
    call CreateItemLoc(udg_ItemType_RuneStrongLavaLake, udg_Point_RuneCreateOrastraszBF[4])
    call DestroyEffectBJ(udg_SE_RuneWeakBFOR)
    // //
    // //
    call StartTimerBJ(udg_Timer_ResetRunesSpawn, false, 120.00)
endfunction

//===========================================================================
function InitTrig_Orastrasz_Runes_Create takes nothing returns nothing
    set gg_trg_Orastrasz_Runes_Create=CreateTrigger()
    call DisableTrigger(gg_trg_Orastrasz_Runes_Create)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Orastrasz_Runes_Create, 2)
    call TriggerAddCondition(gg_trg_Orastrasz_Runes_Create, Condition(function Trig_Orastrasz_Runes_Create_Conditions))
    call TriggerAddAction(gg_trg_Orastrasz_Runes_Create, function Trig_Orastrasz_Runes_Create_Actions)
endfunction

