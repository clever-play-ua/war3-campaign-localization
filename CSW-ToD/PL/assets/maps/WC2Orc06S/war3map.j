//===========================================================================
function Trig_Orastrasz_Runes_Create_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightOrastrasz == true ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Zuluhed) <= 300.00 ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_Runes_Create_Func005Func001Func004002 takes nothing returns nothing
    call RemoveItem(GetEnumItem())
endfunction

function Trig_Orastrasz_Runes_Create_Func005Func001C takes nothing returns boolean
    if ( not ( GetItemType(GetEnumItem()) == ITEM_TYPE_POWERUP ) ) then
        return false
    endif
    if ( not ( GetEnumItem() != null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_Runes_Create_Func005A takes nothing returns nothing
    if ( Trig_Orastrasz_Runes_Create_Func005Func001C() ) then
        call AddSpecialEffectLocBJ(udg_Point_RuneCreateOrastraszBF[1], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
        set udg_SE_RuneWeakBFOR=GetLastCreatedEffectBJ()
        call EnumItemsInRectBJ(gg_rct_OrastraszRuneSpawn01, function Trig_Orastrasz_Runes_Create_Func005Func001Func004002)
        call PolledWait(0.25)
        call DestroyEffectBJ(udg_SE_RuneWeakBFOR)
    else
        call DoNothing()
    endif
endfunction

