    call TriggerAddCondition(gg_trg_Goblin_Gear_Sound, Condition(function Trig_Goblin_Gear_Sound_Conditions))
    call TriggerAddAction(gg_trg_Goblin_Gear_Sound, function Trig_Goblin_Gear_Sound_Actions)
endfunction

//===========================================================================
// Trigger: Goblin SuicidalGoblin
//===========================================================================
function Trig_Goblin_SuicidalGoblin_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_SuicidalGoblin_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call UnitShareVisionBJ(true, gg_unit_h00C_0118, udg_Player_Actual)
    call UnitShareVisionBJ(true, gg_unit_h00C_0403, udg_Player_Actual)
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinDies, udg_Player_Actual, 1.00)
    call PolledWait(1.00)
    // //
    call CreateNUnitsAtLoc(1, 'e002', udg_Player_Goblins, GetRectCenter(gg_rct_GoblinDeathCartStart), 180.00)
    set udg_Unit_SuicideGoblinCart=GetLastCreatedUnit()
    call RemoveGuardPosition(udg_Unit_SuicideGoblinCart)
    // //
    call AddSpecialEffectTargetUnitBJ("origin", udg_Unit_SuicideGoblinCart, "CSW\\Units\\Other\\GoblinLaborer\\Goblin_laborer.mdx")
    // //
    set udg_SE_SuicideGoblin=GetLastCreatedEffectBJ()
    // //
    call BlzSetSpecialEffectColorByPlayer(udg_SE_SuicideGoblin, udg_Player_Goblins)
    call BlzSetSpecialEffectScale(udg_SE_SuicideGoblin, 2.10)
    call BlzPlaySpecialEffect(udg_SE_SuicideGoblin, ANIM_TYPE_STAND)
    // //
    call PlaySoundBJ(gg_snd_goblin2)
    call IssuePointOrderLocBJ(udg_Unit_SuicideGoblinCart, "move", GetRectCenter(gg_rct_BlockGoblinDeath01))
    // //
    set udg_Point_TempFalingGoblinCart=GetUnitLoc(udg_Unit_SuicideGoblinCart)
    call TriggerSleepAction(( ( DistanceBetweenPoints(udg_Point_TempFalingGoblinCart, GetRectCenter(gg_rct_BlockGoblinDeath03)) / GetUnitMoveSpeed(udg_Unit_SuicideGoblinCart) ) - 0.75 ))
    // //
    call KillDestructable(gg_dest_B030_16084)
    call KillDestructable(gg_dest_OTip_9842)
    call KillDestructable(gg_dest_OTip_16128)
    call KillDestructable(gg_dest_OTip_16129)
    call PolledWait(0.50)
    call DestroyEffectBJ(udg_SE_SuicideGoblin)
    call PolledWait(0.50)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_BlockGoblinDeath01), "sharedfx\\phoenix\\phoenixbirthdeath.mdl")
    set udg_SE_LavaGoblinDeath=GetLastCreatedEffectBJ()
    call DestroyEffectBJ(udg_SE_LavaGoblinDeath)
    call PolledWait(0.50)
    call KillUnit(udg_Unit_SuicideGoblinCart)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_BlockGoblinDeath01), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_BlockGoblinDeath02), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_BlockGoblinDeath03), bj_UNIT_FACING, 1, 0)
    // //
    call QueuedTriggerAddBJ(gg_trg_Goblin_SuicidalGoblin_Q, true)
    call PolledWait(4.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_BlockGoblinDeath01), "Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl")
    set udg_SE_Meltdown=GetLastCreatedEffectBJ()
    call PolledWait(1.00)
    call DestroyEffectBJ(udg_SE_Meltdown)
    call RemoveLocation(udg_Point_TempFalingGoblinCart)
endfunction

