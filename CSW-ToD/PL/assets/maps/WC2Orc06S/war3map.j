function Trig_LavaLake_KillWaterElemental_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttackedUnitBJ()) == 'n02T' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttacker()) == 'n034' ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetAttackedUnitBJ()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_KillWaterElemental_Actions takes nothing returns nothing
    call KillUnit(GetAttackedUnitBJ())
endfunction

