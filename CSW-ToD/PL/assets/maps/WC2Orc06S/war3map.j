    set gg_trg_Init_02_Units=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_02_Units, function Trig_Init_02_Units_Actions)
endfunction

//===========================================================================
// Trigger: Init 03 Quests
//===========================================================================
function Trig_Init_03_Quests_Actions takes nothing returns nothing
    // MAIN QUEST: DRAGON SOUL
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_4252", "TRIGSTR_4253", "ReplaceableTextures\\CommandButtons\\BTNPeriapt.blp")
    set udg_MQ_DragonSoul=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQ_DragonSoul, "TRIGSTR_4254")
    set udg_QReq_DragonSoulSecureArtifact=GetLastCreatedQuestItemBJ()
