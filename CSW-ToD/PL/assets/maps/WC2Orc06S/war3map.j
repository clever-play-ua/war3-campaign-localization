function Trig_Mother_Alextrasza_SummonWhelps_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightAlextraza == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_AlextraszaLanded == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_MQ_AlexMother) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_Alextrasza_SummonWhelps_Func005001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Mother_Alextrasza_SummonWhelps_Func005001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Mother_Alextrasza_SummonWhelps_Func005001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Mother_Alextrasza_SummonWhelps_Func005002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_AlexBFAreaChecker)
endfunction

function Trig_Mother_Alextrasza_SummonWhelps_Func008Func002A takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
    call KillUnit(GetEnumUnit())
endfunction

function Trig_Mother_Alextrasza_SummonWhelps_Func008C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_AlexBFAreaChecker) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_Alextrasza_SummonWhelps_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_AlexBFAreaChecker)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_AlextraszaNest, Condition(function Trig_Mother_Alextrasza_SummonWhelps_Func005001002)), function Trig_Mother_Alextrasza_SummonWhelps_Func005002)
    // //
    if ( Trig_Mother_Alextrasza_SummonWhelps_Func008C() ) then
        call ForGroupBJ(GetRandomSubGroup(GetRandomInt(3, 5), udg_Group_DragonEggs), function Trig_Mother_Alextrasza_SummonWhelps_Func008Func002A)
    else
    endif
endfunction

//===========================================================================
