    set gg_trg_Mother_Alextrasza_Landing=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Mother_Alextrasza_Landing, 2)
    call TriggerAddCondition(gg_trg_Mother_Alextrasza_Landing, Condition(function Trig_Mother_Alextrasza_Landing_Conditions))
    call TriggerAddAction(gg_trg_Mother_Alextrasza_Landing, function Trig_Mother_Alextrasza_Landing_Actions)
endfunction

