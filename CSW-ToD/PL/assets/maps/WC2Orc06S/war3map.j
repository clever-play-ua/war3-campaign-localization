function InitTrig_Treasury_Cinematic_Setup takes nothing returns nothing
    set gg_trg_Treasury_Cinematic_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Treasury_Cinematic_Setup, function Trig_Treasury_Cinematic_Setup_Actions)
endfunction

//===========================================================================
