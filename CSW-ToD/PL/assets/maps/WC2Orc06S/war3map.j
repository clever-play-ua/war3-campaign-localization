//===========================================================================
// Trigger: Dwarves AI Defeated
//===========================================================================
function Trig_Dwarves_AI_Defeated_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Ironforge ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarves_AI_Defeated_Func008001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_Dwarves_AI_Defeated_Func008A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P06DefeatCondition)
endfunction

function Trig_Dwarves_AI_Defeated_Func011001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_Dwarves_AI_Defeated_Func011A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P06DefeatCondition)
endfunction

function Trig_Dwarves_AI_Defeated_Func014001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'dBar' )
endfunction

function Trig_Dwarves_AI_Defeated_Func014A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P06DefeatCondition)
endfunction

function Trig_Dwarves_AI_Defeated_Func017001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'dTem' )
endfunction

function Trig_Dwarves_AI_Defeated_Func017A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P06DefeatCondition)
endfunction

function Trig_Dwarves_AI_Defeated_Func020001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'dWor' )
endfunction

function Trig_Dwarves_AI_Defeated_Func020A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P06DefeatCondition)
endfunction

function Trig_Dwarves_AI_Defeated_Func023001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'dIBL' )
endfunction

function Trig_Dwarves_AI_Defeated_Func023A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P06DefeatCondition)
endfunction

function Trig_Dwarves_AI_Defeated_Func025C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P06DefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarves_AI_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_P06DefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Ironforge, Condition(function Trig_Dwarves_AI_Defeated_Func008001002)), function Trig_Dwarves_AI_Defeated_Func008A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Ironforge, Condition(function Trig_Dwarves_AI_Defeated_Func011001002)), function Trig_Dwarves_AI_Defeated_Func011A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Ironforge, Condition(function Trig_Dwarves_AI_Defeated_Func014001002)), function Trig_Dwarves_AI_Defeated_Func014A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Ironforge, Condition(function Trig_Dwarves_AI_Defeated_Func017001002)), function Trig_Dwarves_AI_Defeated_Func017A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Ironforge, Condition(function Trig_Dwarves_AI_Defeated_Func020001002)), function Trig_Dwarves_AI_Defeated_Func020A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Ironforge, Condition(function Trig_Dwarves_AI_Defeated_Func023001002)), function Trig_Dwarves_AI_Defeated_Func023A)
    // //
    if ( Trig_Dwarves_AI_Defeated_Func025C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call ConditionalTriggerExecute(gg_trg_Dwarves_AI_Sttop_Attack_User_Command)
        call ConditionalTriggerExecute(gg_trg_Dwarves_AI_Defeat_Command)
    else
    endif
    // //
    call GroupClear(udg_Group_P06DefeatCondition)
    // //
endfunction

//===========================================================================
function InitTrig_Dwarves_AI_Defeated takes nothing returns nothing
    set gg_trg_Dwarves_AI_Defeated=CreateTrigger()
    call DisableTrigger(gg_trg_Dwarves_AI_Defeated)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Dwarves_AI_Defeated, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Dwarves_AI_Defeated, Condition(function Trig_Dwarves_AI_Defeated_Conditions))
    call TriggerAddAction(gg_trg_Dwarves_AI_Defeated, function Trig_Dwarves_AI_Defeated_Actions)
endfunction

