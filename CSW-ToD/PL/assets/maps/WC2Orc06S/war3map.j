function InitTrig_Goblin_SuicidalGoblin takes nothing returns nothing
    set gg_trg_Goblin_SuicidalGoblin=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Goblin_SuicidalGoblin, gg_rct_PoorGoblinDies)
    call TriggerAddCondition(gg_trg_Goblin_SuicidalGoblin, Condition(function Trig_Goblin_SuicidalGoblin_Conditions))
    call TriggerAddAction(gg_trg_Goblin_SuicidalGoblin, function Trig_Goblin_SuicidalGoblin_Actions)
endfunction

