//===========================================================================
function Trig_Orastrasz_CheckIdle_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightOrastrasz == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_Orastrasz) == true ) ) then
        return false
    endif
    if ( not ( BlzIsUnitInvulnerable(udg_Hero_Orastrasz) == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_OrastraszLanded == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_OrastraszInFight == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_CheckIdle_Actions takes nothing returns nothing
    set udg_Point_OrastraszZuluhedMove=GetUnitLoc(udg_Hero_Zuluhed)
    call IssuePointOrderLocBJ(udg_Hero_Orastrasz, "attack", udg_Point_OrastraszZuluhedMove)
    call RemoveLocation(udg_Point_OrastraszZuluhedMove)
endfunction

