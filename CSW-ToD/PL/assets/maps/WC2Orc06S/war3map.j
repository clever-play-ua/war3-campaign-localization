endfunction

//===========================================================================
// Trigger: Treasury Cinematic Cleanup
//===========================================================================
function Trig_Treasury_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Treasury_Cinematic_Cleanup_Func014C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_OrastraszFlying == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Treasury_Cinematic_Cleanup_Func035002 takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_BossfightPlayerUnits))
endfunction

function Trig_Treasury_Cinematic_Cleanup_Func036002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Treasury_Cinematic_Cleanup_Func037002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Treasury_Cinematic_Cleanup_Func071C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Treasury_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Treasury_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
        call StopSoundBJ(gg_snd_ACT_II_WarlockTheme, false)
    endif
    // ----------------------------------------
    set udg_Bool_CinTreasuryOn=false
    // ----------------------------------------
    call StopSoundBJ(gg_snd_CS_BG_Camp, false)
    call StopSoundBJ(gg_snd_CS_Prologue2_Foley2, false)
    call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_DragonEncounter1, false)
    call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_DragonEncounter1a, false)
    call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_DragonEncounter2, false)
    call StopSoundBJ(gg_snd_WC2Orc06SOrastrasz_Encounter1, false)
    call StopSoundBJ(gg_snd_WC2Orc06SOrastrasz_Encounter2, false)
    // ----------------------------------------
    if ( Trig_Treasury_Cinematic_Cleanup_Func014C() ) then
        call ReplaceUnitBJ(udg_Hero_Orastrasz, 'O008', bj_UNIT_STATE_METHOD_RELATIVE)
        set udg_Hero_Orastrasz=GetLastReplacedUnitBJ()
    else
    endif
    // //
    // //
    call ShowDestructableBJ(false, gg_dest_B02N_12480)
    call ShowDestructableBJ(false, gg_dest_B02N_12760)
    call SetPlayerTechResearchedSwap('R074', 1, udg_Player_Actual)
    // //
    // //
    call RemoveUnit(udg_FakeZuluhed)
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_TreasuryZuluhed01), 90.00)
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    call SetItemVisibleBJ(true, gg_item_I60U_0057)
    call UnitAddItemSwapped(gg_item_I60U_0057, udg_Hero_Zuluhed)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Unit_GoblinBlasterA, GetRectCenter(gg_rct_BlasterA02), GetRectCenter(gg_rct_TreasuryZuluhed01))
    call SetUnitPositionLocFacingLocBJ(udg_Unit_GoblinBlasterB, GetRectCenter(gg_rct_BlasterB02), GetRectCenter(gg_rct_TreasuryZuluhed01))
    call SetUnitPositionLocFacingLocBJ(udg_Unit_GoblinBlasterC, GetRectCenter(gg_rct_BlasterC02), GetRectCenter(gg_rct_TreasuryZuluhed01))
    call SetUnitPositionLocFacingLocBJ(udg_Unit_GoblinBlasterD, GetRectCenter(gg_rct_BlasterD02), GetRectCenter(gg_rct_TreasuryZuluhed01))
    // //
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Treasury_Cinematic_Cleanup_Func035002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Treasury_Cinematic_Cleanup_Func036002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Treasury_Cinematic_Cleanup_Func037002)
    call GroupRemoveGroup(udg_Group_HiddenUnits, udg_Group_HiddenUnits)
    // //
    // //
    call SetUnitBlendTimeBJ(udg_Hero_Orastrasz, 0.25)
    call ResetUnitAnimation(udg_Hero_Orastrasz)
    // //
    // //
    // Set Treasury Env
    // //
    call SetDoodadAnimationRectBJ("stand", 'OOgr', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("stand", 'LOtz', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("stand", 'AObr', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("stand", 'D020', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("stand", 'D04G', gg_rct_TreasuryLights)
    call CreateFogModifierRectBJ(true, Player(0), FOG_OF_WAR_VISIBLE, gg_rct_TreasuryLights)
    set udg_VisMod_Treasury=GetLastCreatedFogModifier()
    // //
    // //
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_TreasuryBossFigthStarts), 0)
    call TriggerSleepAction(0.01)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // ----------------------------------------
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_DungeonBossfightZone)
    call BlzChangeMinimapTerrainTex("MinimapDungeonB.tga")
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCInematicCleanUp)
    call CinematicModeBJ(false, GetPlayersAll())
    // //
    // Fade Faster If Cinematic Skipped
    // //
    if ( Trig_Treasury_Cinematic_Cleanup_Func071C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    call QueuedTriggerRemoveBJ(gg_trg_Treasury_Cinematic_Q)
    call SelectUnitForPlayerSingle(udg_Hero_Zuluhed, udg_Player_Actual)
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_PlaylistBossfightDungeon)
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_Orastrasz_FirstAttack)
    call ConditionalTriggerExecute(gg_trg_Guardian_Discover)
endfunction

//===========================================================================
function InitTrig_Treasury_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Treasury_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Treasury_Cinematic_Cleanup, function Trig_Treasury_Cinematic_Cleanup_Actions)
endfunction

