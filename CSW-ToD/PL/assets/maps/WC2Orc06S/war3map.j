//===========================================================================
// Trigger: OilSpentForBlacksmith
//===========================================================================
function Trig_OilSpentForBlacksmith_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'o60L' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForBlacksmith_Actions takes nothing returns nothing
    local sound OrcUI_InsufficientOil
    local string Sound_Path= "Sound\\Interface\\Warning\\Orc\\GruntNoOil1.mp3"
    // //
    // Check The Oil amount
    if (OilHarvest__playerOil[GetPlayerId((Player(0)))]) < 100 then // INLINED!!
    // UI Warning
    set OrcUI_InsufficientOil=CreateSound(Sound_Path, false, false, false, 1, 1, "DefaultEAXON")
    call SetSoundParamsFromLabel(OrcUI_InsufficientOil, "User Interface")
    call SetSoundVolume(OrcUI_InsufficientOil, 127)
    call SetSoundPitch(OrcUI_InsufficientOil, 1.0)
    call StartSound(OrcUI_InsufficientOil)
    call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_4071")
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // compensate return
    call playerAddOil(Player(0) , - 100)
    else
    // compensate return if there was not enough oil
    call playerAddOil(Player(0) , - 100)
    endif
    // //
    call KillSoundWhenDone(OrcUI_InsufficientOil)
    set OrcUI_InsufficientOil=null
endfunction

