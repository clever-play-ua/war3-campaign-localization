//===========================================================================
function Trig_Mother_BaseDestroyed_Defeat_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_DungeonAreaPlayable == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_BaseDestroyed_Defeat_Func002Func007001001002001001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_Mother_BaseDestroyed_Defeat_Func002Func007001001002001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_Mother_BaseDestroyed_Defeat_Func002Func007001001002001 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true)) // INLINED!!
endfunction

function Trig_Mother_BaseDestroyed_Defeat_Func002Func007001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Mother_BaseDestroyed_Defeat_Func002Func007001001002 takes nothing returns boolean
    return GetBooleanAnd((GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true))), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Mother_BaseDestroyed_Defeat_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Mother_BaseDestroyed_Defeat_Func002Func007001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_BaseDestroyed_Defeat_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Mother_BaseDestroyed_Defeat_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QuestSetFailedBJ(udg_MQ_AlexMother, true)
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_4314")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call ConditionalTriggerExecute(gg_trg_MissionFailed)
    else
    endif
endfunction

