function Trig_Exit_Cinematic_Setup_Func017001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false )
endfunction

function Trig_Exit_Cinematic_Setup_Func017A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_Exit_Cinematic_Setup_Func019002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Exit_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call ShowDestructableBJ(true, gg_dest_B02N_12480)
    call ShowDestructableBJ(true, gg_dest_B02N_12760)
    // //
    call ShowDestructableBJ(true, gg_dest_B02Y_11537)
    call SetDestructableAnimationBJ(gg_dest_B02Y_11537, "death")
    // //
    call SetSkyModel("Environment\\Sky\\BarrensSky\\BarrensSky.mdl")
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_Deathwing, GetRectCenter(gg_rct_DeathwingBursts), 175.65)
    // //
    call ShowUnitHide(udg_Hero_Zuluhed)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Exit_Cinematic_Setup_Func017001002)), function Trig_Exit_Cinematic_Setup_Func017A)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Exit_Cinematic_Setup_Func019002)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_ZuluhedDungeonExitCinemaitc01), 0.00)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeVincent, GetRectCenter(gg_rct_ExitCinGoblinTinker), 297.82)
    // //
    call CreateNUnitsAtLoc(1, 'h609', udg_Player_Goblins, GetRectCenter(gg_rct_ExitCinGoblinWorker01), 290.82)
    set udg_Unit_CinGoblinWorkerArr[1]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_CinGoblinWorkerArr[1], "stand work")
    // //
    call CreateNUnitsAtLoc(1, 'h609', udg_Player_Goblins, GetRectCenter(gg_rct_ExitCinGoblinWorker02), 320.03)
    set udg_Unit_CinGoblinWorkerArr[2]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_CinGoblinWorkerArr[2], "stand work gold")
    // //
    call CreateNUnitsAtLoc(1, 'ngir', udg_Player_Goblins, GetRectCenter(gg_rct_ExitCinGoblinWorker03), 76.46)
    set udg_Unit_CinGoblinWorkerArr[3]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_CinGoblinWorkerArr[3], "attack")
    call ConditionalTriggerExecute(gg_trg_Exit_Cinematic_GoblinShredderLoop)
    // //
    call CreateNUnitsAtLoc(1, 'h609', udg_Player_Goblins, GetRectCenter(gg_rct_ExitCinGoblinWorker04), 251.88)
    set udg_Unit_CinGoblinWorkerArr[4]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_CinGoblinWorkerArr[4], "stand work")
    // //
    call CreateNUnitsAtLoc(1, 'h609', udg_Player_Goblins, GetRectCenter(gg_rct_ExitCinGoblinWorker05), 197.26)
    set udg_Unit_CinGoblinWorkerArr[5]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_CinGoblinWorkerArr[5], "stand work")
    // //
    call CreateNUnitsAtLoc(1, 'h609', udg_Player_Goblins, GetRectCenter(gg_rct_ExitCinGoblinWorker06), 121.87)
    set udg_Unit_CinGoblinWorkerArr[6]=GetLastCreatedUnit()
    // //
endfunction

