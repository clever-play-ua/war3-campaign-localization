//===========================================================================
function CreateUnitsForPlayer3 takes nothing returns nothing
    local player p= Player(3)
    local unit u
    local integer unitID
    local trigger t
    local real life

    set gg_unit_O601_0334=BlzCreateUnitWithSkin(p, 'O601', 3245.4, 12631.7, 180.650, 'O601')
    call SetUnitColor(gg_unit_O601_0334, ConvertPlayerColor(20))
endfunction

