function InitTrig_BladeDamageFloaty takes nothing returns nothing
    set gg_trg_BladeDamageFloaty=CreateTrigger()
    call TriggerAddAction(gg_trg_BladeDamageFloaty, function Trig_BladeDamageFloaty_Actions)
endfunction

