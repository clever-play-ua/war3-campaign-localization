// Trigger: FireLord Escape Q
//===========================================================================
function Trig_FireLord_Escape_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_Elementals, 'Nfir', GetCameraTargetPositionLoc(), gg_snd_WC2Orc06SFireElemental2, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

