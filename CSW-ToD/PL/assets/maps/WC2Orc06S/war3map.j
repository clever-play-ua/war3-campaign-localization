    set gg_trg_Goblin_TrainCart_TravelToTown=CreateTrigger()
    call TriggerAddAction(gg_trg_Goblin_TrainCart_TravelToTown, function Trig_Goblin_TrainCart_TravelToTown_Actions)
endfunction

