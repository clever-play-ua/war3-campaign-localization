endfunction

//===========================================================================
// Trigger: Orastrasz FirstAttack
//===========================================================================
function Trig_Orastrasz_FirstAttack_Func036C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_FirstAttack_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_RedDragons, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_RedDragons, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    set udg_Bool_BossFightOrastrasz=true
    // //
    call UnitRemoveAbilityBJ('AOws', udg_Hero_Orastrasz)
    call UnitRemoveAbilityBJ('AEim', udg_Hero_Orastrasz)
    call UnitRemoveAbilityBJ('ANbf', udg_Hero_Orastrasz)
    call UnitRemoveAbilityBJ('AUts', udg_Hero_Orastrasz)
    // //
    call UnitAddAbilityBJ('AEfn', udg_Hero_Orastrasz)
    call UnitAddAbilityBJ('AHfs', udg_Hero_Orastrasz)
    // //
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AHfs')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AHfs')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AHfs')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AEfn')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AEfn')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AEfn')
    // //
    call SetUnitOwner(udg_Hero_Orastrasz, udg_Player_RedDragons, false)
    // //
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Hero_Zuluhed)
    call SetUnitManaPercentBJ(udg_Hero_Zuluhed, 100)
    call SetUnitLifePercentBJ(udg_Hero_Zuluhed, 100)
    // //
    call EnableTrigger(gg_trg_Orastrasz_Landing)
    call EnableTrigger(gg_trg_Orastrasz_Runes_Create)
    call EnableTrigger(gg_trg_Orastrasz_SummonGoblins)
    // //
    call PauseUnitBJ(false, udg_Hero_Orastrasz)
    // //
    call IssuePointOrderLocBJ(udg_Hero_Orastrasz, "flamestrike", GetRectCenter(gg_rct_OrastraszLanding))
    call PolledWait(2)
    if ( Trig_Orastrasz_FirstAttack_Func036C() ) then
        call QueuedTriggerAddBJ(gg_trg_Orastrasz_FirstAttack_Q, true)
    else
    endif
    call EnableTrigger(gg_trg_Orastrasz_CheckIdle)
endfunction

//===========================================================================
function InitTrig_Orastrasz_FirstAttack takes nothing returns nothing
    set gg_trg_Orastrasz_FirstAttack=CreateTrigger()
    call TriggerAddAction(gg_trg_Orastrasz_FirstAttack, function Trig_Orastrasz_FirstAttack_Actions)
endfunction

//===========================================================================
// Trigger: Orastrasz FirstAttack Q
//===========================================================================
function Trig_Orastrasz_FirstAttack_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Orastrasz, 'O007', gg_snd_WC2Orc06SOrastrasz_BossFight1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Orastrasz_FirstAttack_Q takes nothing returns nothing
    set gg_trg_Orastrasz_FirstAttack_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Orastrasz_FirstAttack_Q, function Trig_Orastrasz_FirstAttack_Q_Actions)
endfunction

//===========================================================================
// Trigger: Orastrasz Landing
//===========================================================================
function Trig_Orastrasz_Landing_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightOrastrasz == true ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Orastrasz) <= 2000.00 ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_Landing_Func018001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_OrastraszLanding, udg_Hero_Orastrasz) == true )
endfunction

function Trig_Orastrasz_Landing_Func021A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_BFCollisionOff)
endfunction

function Trig_Orastrasz_Landing_Func023002 takes nothing returns nothing
    call SetUnitPathing(GetEnumUnit(), false)
endfunction

function Trig_Orastrasz_Landing_Func062002 takes nothing returns nothing
    call SetUnitPathing(GetEnumUnit(), true)
endfunction

function Trig_Orastrasz_Landing_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_OrastraszLanded=true
    call DisableTrigger(gg_trg_Orastrasz_LeavesToHeal)
    call SetUnitInvulnerable(udg_Hero_Orastrasz, true)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Hero_Orastrasz, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    // //
    call SetUnitPathing(udg_Hero_Orastrasz, false)
    call RemoveGuardPosition(udg_Hero_Orastrasz)
    call IssueImmediateOrderBJ(udg_Hero_Orastrasz, "stop")
    // //
    set udg_Point_OrastraszPosition=GetUnitLoc(udg_Hero_Orastrasz)
    set udg_Point_OrastraszLanding=GetRectCenter(gg_rct_OrastraszLanding)
    call IssuePointOrderLocBJ(udg_Hero_Orastrasz, "move", udg_Point_OrastraszLanding)
    loop
        exitwhen ( (RectContainsUnit(gg_rct_OrastraszLanding, udg_Hero_Orastrasz) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_OrastraszLanding), function Trig_Orastrasz_Landing_Func021A)
    // //
    call ForGroupBJ(udg_Group_BFCollisionOff, function Trig_Orastrasz_Landing_Func023002)
    // //
    call IssueImmediateOrderBJ(udg_Hero_Orastrasz, "unravenform")
    call PlaySoundBJ(gg_snd_DeathwingLand)
    // //
    call PolledWait(2.50)
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 4.00)
    // //
    call AddSpecialEffectLocBJ(udg_Point_OrastraszLanding, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl")
    set udg_SE_DragonLandingClap=GetLastCreatedEffectBJ()
    call AddSpecialEffectLocBJ(udg_Point_OrastraszLanding, "units\\undead\\cryptfiend\\cryptfiendburrow.mdl")
    set udg_SE_DragonLandingDust=GetLastCreatedEffectBJ()
    // //
    call PolledWait(1.00)
    // //
    // //
    call UnitRemoveAbilityBJ('AOhw', udg_Hero_Orastrasz)
    call UnitRemoveAbilityBJ('AEfn', udg_Hero_Orastrasz)
    call UnitRemoveAbilityBJ('AHfs', udg_Hero_Orastrasz)
    // //
    call UnitAddAbilityBJ('AOws', udg_Hero_Orastrasz)
    call UnitAddAbilityBJ('AEim', udg_Hero_Orastrasz)
    call UnitAddAbilityBJ('ANbf', udg_Hero_Orastrasz)
    call UnitAddAbilityBJ('AUts', udg_Hero_Orastrasz)
    // //
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AUts')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AUts')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AUts')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AOws')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AOws')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AOws')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'ANbf')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'ANbf')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'ANbf')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AEim')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AEim')
    call SelectHeroSkill(udg_Hero_Orastrasz, 'AEim')
    // //
    call SetUnitPathing(udg_Hero_Orastrasz, true)
    call ForGroupBJ(udg_Group_BFCollisionOff, function Trig_Orastrasz_Landing_Func062002)
    call SetUnitInvulnerable(udg_Hero_Orastrasz, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Hero_Orastrasz, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
    // //
    call PolledWait(2)
    call CameraClearNoiseForPlayer(Player(0))
    call DestroyEffectBJ(udg_SE_DragonLandingClap)
    call DestroyEffectBJ(udg_SE_DragonLandingDust)
    set udg_Bool_OrastraszFlying=false
    call RemoveLocation(udg_Point_OrastraszPosition)
    call RemoveLocation(udg_Point_OrastraszLanding)
    call QueuedTriggerAddBJ(gg_trg_Orastrasz_Landing_Q, true)
endfunction

//===========================================================================
function InitTrig_Orastrasz_Landing takes nothing returns nothing
    set gg_trg_Orastrasz_Landing=CreateTrigger()
    call DisableTrigger(gg_trg_Orastrasz_Landing)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Orastrasz_Landing, 2)
    call TriggerAddCondition(gg_trg_Orastrasz_Landing, Condition(function Trig_Orastrasz_Landing_Conditions))
    call TriggerAddAction(gg_trg_Orastrasz_Landing, function Trig_Orastrasz_Landing_Actions)
endfunction

