//===========================================================================
function Trig_GoldCoin_Gather_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttacker()) == 'h00E' ) ) then
        return false
    endif
    return true
endfunction

function Trig_GoldCoin_Gather_Actions takes nothing returns nothing
    call UnitRemoveAbilityBJ('Aloc', GetAttacker())
    call UnitDamageTargetBJ(GetAttackedUnitBJ(), GetAttacker(), 500, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
    call PlaySoundBJ(gg_snd_GoldCoinLoop)
endfunction

