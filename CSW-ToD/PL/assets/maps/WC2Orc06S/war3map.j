//===========================================================================
// Trigger: Load Zuluhed
//===========================================================================
function Trig_Load_Zuluhed_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc06", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Zuluhed_Actions takes nothing returns nothing
    // DefaultHero
    if ( Trig_Load_Zuluhed_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Zuluhed", "WC2Orc06", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_LoadZuluhed), GetRectCenter(gg_rct_WaterFallLoop06))
        set udg_Hero_Zuluhed=GetLastRestoredUnitBJ()
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60O'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I6DX'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60Q'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60R'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60N'))
        call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I60P'))
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'O61F', udg_Player_Actual, GetRectCenter(gg_rct_LoadZuluhed), GetRectCenter(gg_rct_KoboldPatrol06))
        set udg_Hero_Zuluhed=GetLastCreatedUnit()
        call SetHeroLevelBJ(udg_Hero_Zuluhed, 6, false)
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00R')
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00R')
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00S')
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00S')
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00U')
        call SelectHeroSkill(udg_Hero_Zuluhed, 'A00T')
        call UnitAddItemByIdSwapped('Z007', udg_Hero_Zuluhed)
    endif
endfunction

//===========================================================================
function InitTrig_Load_Zuluhed takes nothing returns nothing
    set gg_trg_Load_Zuluhed=CreateTrigger()
    call TriggerAddAction(gg_trg_Load_Zuluhed, function Trig_Load_Zuluhed_Actions)
endfunction

