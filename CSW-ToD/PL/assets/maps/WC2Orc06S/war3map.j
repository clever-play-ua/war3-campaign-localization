    call PlaySoundBJ(gg_snd_DoorSlam101)
    // //
    call ShowUnitShow(gg_unit_nkot_0093)
    // //
    call DestroyEffectBJ(udg_SE_Dust[6])
    // //
    if ( Trig_Dragon_Kobolds2A_Func018C() ) then
        call QueuedTriggerAddBJ(gg_trg_Dragon_Kobolds2_Q, true)
    else
        call DoNothing()
    endif
