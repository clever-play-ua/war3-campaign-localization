//===========================================================================
function Trig_Exit_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinDungeonExitOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Exit_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinematicSkipped=true
    set udg_Bool_CinDungeonExitSkipped=true
    call ConditionalTriggerExecute(gg_trg_Exit_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Exit_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Exit_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Exit_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Exit_Cinematic_Skipped, Condition(function Trig_Exit_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Exit_Cinematic_Skipped, function Trig_Exit_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Exit Cinematic Cleanup
//===========================================================================
function Trig_Exit_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Exit_Cinematic_Cleanup_Func005C takes nothing returns boolean
    if ( not ( udg_Bool_CinDungeonExitSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Exit_Cinematic_Cleanup_Func013C takes nothing returns boolean
    if ( not ( udg_Bool_CinDungeonExitSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Exit_Cinematic_Cleanup_Func024002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Exit_Cinematic_Cleanup_Func042C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Exit_Cinematic_Cleanup_Func050001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Exit_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Exit_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set udg_Bool_CinDungeonExitOn=false
    if ( Trig_Exit_Cinematic_Cleanup_Func005C() ) then
        call StopSoundBJ(gg_snd_Mainscreen, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_DeathwingIsBack1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_DeathwingIsBack2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing_AfterBoss1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing_AfterBoss2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing_AfterBoss3, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing_AfterBoss4, false)
    else
        call DoNothing()
    endif
    // //
    call ShowDestructableBJ(false, gg_dest_B02N_12480)
    call ShowDestructableBJ(false, gg_dest_B02N_12760)
    call ShowDestructableBJ(false, gg_dest_B02Y_11537)
    // //
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // //
    if ( Trig_Exit_Cinematic_Cleanup_Func013C() ) then
        call ShowUnitShow(udg_Hero_Deathwing)
        call KillDestructable(gg_dest_YT22_10496)
        call AddWeatherEffectSaveLast(gg_rct_BurstCeilingRays, 'LRaa')
        call SetDoodadAnimationRectBJ("stand", 'D6AE', gg_rct_DeathwingBursts)
    else
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_ZuluhedDungeonExitCinemaitc03), 90.00)
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    call UnitShareVisionBJ(true, udg_Hero_Deathwing, udg_Player_Actual)
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_VincentTurnCoat, GetRectCenter(gg_rct_ExitCinGoblinTinker), 297.82)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Exit_Cinematic_Cleanup_Func024002)
    call GroupRemoveGroup(udg_Group_HiddenUnits, udg_Group_HiddenUnits)
    // //
    call SetUnitFacingTimed(udg_Hero_Deathwing, 0.00, 1.00)
    call SetHeroLevelBJ(udg_Hero_Deathwing, 10, false)
    call SetUnitInvulnerable(udg_Hero_Deathwing, true)
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_DungeonExit01), 0)
    call TriggerSleepAction(0.10)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call CinematicModeBJ(false, GetPlayersAll())
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCInematicCleanUp)
    // //
    call EnableTrigger(gg_trg_DarkIron_GoblinRant)
    call SelectUnitForPlayerSingle(udg_Hero_Zuluhed, udg_Player_Actual)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Exit_Cinematic_Cleanup_Func042C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Exit_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_PlaylistDungeon)
    // //
    call PlaySoundBJ(gg_snd_DeathwingTakeoff)
    call SetUnitAnimation(udg_Hero_Deathwing, "Morph")
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 1.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DeathwingBursts), "units\\undead\\cryptfiend\\cryptfiendburrow.mdl")
    set udg_SE_DragonLandingDust=GetLastCreatedEffectBJ()
    call TriggerSleepAction(2.00)
    // //
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // //
    call ShowUnitHide(udg_Hero_Deathwing)
    // //
    call TriggerSleepAction(2.00)
    call DestroyEffectBJ(udg_SE_DragonLandingDust)
endfunction

//===========================================================================
function InitTrig_Exit_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Exit_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Exit_Cinematic_Cleanup, function Trig_Exit_Cinematic_Cleanup_Actions)
endfunction

