function Trig_Guardian_Completed_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Hero_Orastrasz ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Completed_Func011Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'DTrx' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Completed_Func011A takes nothing returns nothing
    if ( Trig_Guardian_Completed_Func011Func001C() ) then
        call ChangeElevatorHeight(GetEnumDestructable(), 2)
    else
    endif
endfunction

function Trig_Guardian_Completed_Func013Func001Func001C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B01L' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B01S' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B01R' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Guardian_Completed_Func013Func001C takes nothing returns boolean
    if ( not Trig_Guardian_Completed_Func013Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Guardian_Completed_Func013A takes nothing returns nothing
    if ( Trig_Guardian_Completed_Func013Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Guardian_Completed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Orastrasz_CheckIdle)
    set udg_Bool_BossFightOrastrasz=false
    call StopMusicBJ(false)
    call ConditionalTriggerExecute(gg_trg_PlaylistDungeon)
    call QueuedTriggerAddBJ(gg_trg_Guardian_Completed_Q, true)
    call PlayMusicBJ(udg_Music_CurrentName)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // /
    call PlaySoundBJ(gg_snd_Elevator)
    call EnumDestructablesInRectAll(gg_rct_Staircase, function Trig_Guardian_Completed_Func011A)
    // /
    call EnumDestructablesInRectAll(gg_rct_PathingBlockersDungeonExt, function Trig_Guardian_Completed_Func013A)
    call ConditionalTriggerExecute(gg_trg_Dragon_Update)
endfunction

