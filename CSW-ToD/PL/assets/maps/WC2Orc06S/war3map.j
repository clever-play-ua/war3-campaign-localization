function InitTrig_Outro_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Outro_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Outro_Cinematic_Cleanup, function Trig_Outro_Cinematic_Cleanup_Actions)
