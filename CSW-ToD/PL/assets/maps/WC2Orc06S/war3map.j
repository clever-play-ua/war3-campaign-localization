//===========================================================================
// Trigger: AlexRaid Cancel
//===========================================================================
function Trig_AlexRaid_Cancel_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AlexRaid_Cancel_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_AlextrazaInRaid=false
    call IssueImmediateOrderBJ(udg_Hero_Alextrasza, "stop")
    call PolledWait(0.50)
    call IssueImmediateOrderBJ(udg_Hero_Alextrasza, "divineshield")
    call PolledWait(0.50)
    call BlzUnitInterruptAttack(udg_Hero_Alextrasza)
    call PolledWait(0.50)
    call IssuePointOrderLocBJ(udg_Hero_Alextrasza, "move", GetRectCenter(gg_rct_NestDust))
    call EnableTrigger(gg_trg_AlexGoHome)
    call DisableTrigger(gg_trg_AlexGoAttack)
endfunction

//===========================================================================
function InitTrig_AlexRaid_Cancel takes nothing returns nothing
    set gg_trg_AlexRaid_Cancel=CreateTrigger()
    call TriggerAddCondition(gg_trg_AlexRaid_Cancel, Condition(function Trig_AlexRaid_Cancel_Conditions))
    call TriggerAddAction(gg_trg_AlexRaid_Cancel, function Trig_AlexRaid_Cancel_Actions)
endfunction

