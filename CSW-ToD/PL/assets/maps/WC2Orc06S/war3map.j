    call UnitRemoveAbilityBJ('Aneu', udg_Hero_VincentTurnCoat)
    call ShowUnitHide(udg_Hero_VincentTurnCoat)
    call PauseUnitBJ(true, udg_Hero_VincentTurnCoat)
    // //
    call ShowDestructableBJ(true, gg_dest_B02E_10477)
    // //
    call ShowUnitHide(udg_Hero_Zuluhed)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_MidCinGoblinsZuluhed01), 58.46)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeVincent, GetRectCenter(gg_rct_VincentCinematicDefault), 297.82)
    // //
    // //
endfunction

