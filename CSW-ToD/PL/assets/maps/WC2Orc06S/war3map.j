//===========================================================================
// Trigger: PeonSwap
//===========================================================================
function Trig_PeonSwap_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A610' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PeonSwap_Func001Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellAbilityUnit()) == 'n61W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PeonSwap_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellAbilityUnit()) == 'o61Z' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PeonSwap_Actions takes nothing returns nothing
    if ( Trig_PeonSwap_Func001C() ) then
        call ReplaceUnitBJ(GetSpellAbilityUnit(), 'n61W', bj_UNIT_STATE_METHOD_RELATIVE)
        call SelectUnitForPlayerSingle(GetLastReplacedUnitBJ(), Player(0))
    else
        if ( Trig_PeonSwap_Func001Func003C() ) then
            call ReplaceUnitBJ(GetSpellAbilityUnit(), 'o61Z', bj_UNIT_STATE_METHOD_RELATIVE)
            call SelectUnitForPlayerSingle(GetLastReplacedUnitBJ(), Player(0))
        else
            call DoNothing()
        endif
    endif
endfunction

