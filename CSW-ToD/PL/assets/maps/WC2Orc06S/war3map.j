    return ( udg_Bool_CinCampSkipped == true )
endfunction

function Trig_Camp_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCInematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call ConditionalTriggerExecute(gg_trg_Camp_Cinematic_Setup)
    // //
    call TriggerSleepAction(1.00)
    // //
    call DisplayTimedTextToForce(udg_PlayerGroup_PlayerActual, 4.00, "TRIGSTR_4671")
    call TriggerSleepAction(6.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_TharbekAnnoyed01, udg_Player_Actual, 6.00)
    // //
    call PlaySoundBJ(gg_snd_Orc2)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinCampOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeTharbek, "cinematic angry one")
    call QueueUnitAnimationBJ(udg_FakeTharbek, "cinematic standard one")
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_RED, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc06STharbek1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
    call SetUnitFacingTimed(udg_FakeNekros, 22.55, 0.50)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeTharbek, udg_FakeNekros, 0.50)
    call SetUnitLookAt(udg_FakeTharbek, "bone_head", udg_FakeNekros, 0, 0, 90)
    // //
    call SetUnitAnimation(udg_FakeTharbek, "cinematic standard three")
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_RED, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc06STharbek2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeTharbek, "cinematic standard two")
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_RED, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc06STharbek3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_ZuluhedArrivesInCamp02))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ZuluhedArrivesInChat01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_ZuluhedArrivesInChat02, udg_Player_Actual, 15.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call PlaySoundBJ(gg_snd_CS_BG_Camp)
    // //
    set udg_Point_ZuluhedCinTemp=GetUnitLoc(udg_FakeZuluhed)
    call TriggerSleepAction(( ( DistanceBetweenPoints(udg_Point_ZuluhedCinTemp, GetRectCenter(gg_rct_ZuluhedArrivesInCamp02)) / GetUnitMoveSpeed(udg_FakeZuluhed) ) - 5.00 ))
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley1)
    call ResetUnitLookAt(udg_FakeTharbek)
    call SetUnitFacingToFaceUnitTimed(udg_FakeNekros, udg_FakeZuluhed, 0.50)
    call SetUnitFacingToFaceUnitTimed(udg_FakeTharbek, udg_FakeZuluhed, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeTharbek, "cinematic point one")
    call QueueUnitAnimationBJ(udg_FakeTharbek, "cinematic standard one")
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_RED, false)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc06STharbek4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_Camp1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_Orc2, true)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeNekros, GetRectCenter(gg_rct_NekrosCamp03), GetRectCenter(gg_rct_ZuluhedArrivesInCamp03))
    call SetUnitPositionLocFacingLocBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_ZuluhedArrivesInCamp03), GetRectCenter(gg_rct_NekrosCamp03))
    // //
    call PlaySoundBJ(gg_snd_DarkAgents)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Warlocks02, udg_Player_Actual, 0)
    call ResetUnitAnimation(udg_FakeNekros)
    call DisplayTimedTextToForce(udg_PlayerGroup_PlayerActual, 2.00, "TRIGSTR_4672")
    call TriggerSleepAction(4.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Warlocks01, udg_Player_Actual, ( 2.00 + ( GetSoundDurationBJ(gg_snd_WC2Orc06SNekros5) + ( GetSoundDurationBJ(gg_snd_WC2Orc06SNekros4) + ( GetSoundDurationBJ(gg_snd_WC2Orc06SZuluhed_Camp2) + 1.00 ) ) ) ))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_Camp2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_Camp3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_DarkAgents, true)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeNekros, 0, gg_snd_WC2Orc06SNekros5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Camp_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Camp_Cinematic_Q takes nothing returns nothing
    set gg_trg_Camp_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Camp_Cinematic_Q, function Trig_Camp_Cinematic_Q_Actions)
