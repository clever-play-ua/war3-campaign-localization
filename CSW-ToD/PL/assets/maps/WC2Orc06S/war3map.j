endfunction

//===========================================================================
// Trigger: Goblin PuzzleA Loop
//===========================================================================
function Trig_Goblin_PuzzleA_Loop_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_PuzzleA_Loop_Func002001 takes nothing returns boolean
    return ( IsTriggerEnabled(GetTriggeringTrigger()) == false )
endfunction

function Trig_Goblin_PuzzleA_Loop_Func006001 takes nothing returns boolean
    return ( IsTriggerEnabled(GetTriggeringTrigger()) == false )
endfunction

function Trig_Goblin_PuzzleA_Loop_Func009001 takes nothing returns boolean
    return ( IsTriggerEnabled(GetTriggeringTrigger()) == false )
endfunction

function Trig_Goblin_PuzzleA_Loop_Func012001 takes nothing returns boolean
    return ( IsTriggerEnabled(GetTriggeringTrigger()) == false )
endfunction

function Trig_Goblin_PuzzleA_Loop_Actions takes nothing returns nothing
    call PolledWait(2.00)
    if ( (IsTriggerEnabled(GetTriggeringTrigger()) == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Goblin_PuzzleA_Green1)
    call PolledWait(3.00)
    if ( (IsTriggerEnabled(GetTriggeringTrigger()) == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Goblin_PuzzleA_Green2)
    call PolledWait(3.00)
    if ( (IsTriggerEnabled(GetTriggeringTrigger()) == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Goblin_PuzzleA_Green3)
    call PolledWait(3.00)
    if ( (IsTriggerEnabled(GetTriggeringTrigger()) == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_Goblin_PuzzleA_Green4)
    call PolledWait(2.00)
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

