function Trig_Init_02_Units_Func224002 takes nothing returns nothing
    call UnitAddAbilityBJ('AS64', GetEnumUnit())
endfunction

function Trig_Init_02_Units_Func228A takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), true)
endfunction

function Trig_Init_02_Units_Func231A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Init_02_Units_Actions takes nothing returns nothing
    set udg_Hero_Deathwing=gg_unit_O601_0249
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_CinematicDummy), function Trig_Init_02_Units_Func004002)
    // //
    call SetUnitAnimation(gg_unit_ugho_0771, "stand channel")
    // //
    set udg_Item_DragonSoulQuest=gg_item_I60U_0057
    // //
    call SetItemCharges(udg_Item_DragonSoulQuest, 0)
    // //
    set udg_Unit_CinematicEggArr[1]=gg_unit_h00F_0152
    set udg_Unit_CinematicEggArr[2]=gg_unit_h00G_0727
    set udg_Unit_CinematicEggArr[3]=gg_unit_h00F_0728
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_AlextraszaNest, Condition(function Trig_Init_02_Units_Func017001002)), function Trig_Init_02_Units_Func017A)
    // //
    call ForGroupBJ(udg_Group_DragonEggs, function Trig_Init_02_Units_Func019A)
    // //
    call GroupRemoveUnitSimple(udg_Unit_CinematicEggArr[1], udg_Group_DragonEggs)
    call GroupRemoveUnitSimple(udg_Unit_CinematicEggArr[2], udg_Group_DragonEggs)
    call GroupRemoveUnitSimple(udg_Unit_CinematicEggArr[3], udg_Group_DragonEggs)
    // //
    // Goblin Train Cart
    set udg_Unit_GoblinTrainCart=gg_unit_e002_0142
    set udg_Point_Goblin_TrainCart_Camera[1]=CameraSetupGetDestPositionLoc(gg_cam_TrainStation01)
    set udg_Point_Goblin_TrainCart_Camera[2]=CameraSetupGetDestPositionLoc(gg_cam_TrainStation2)
    set udg_Point_Goblin_TrainCart_Target[1]=GetRectCenter(gg_rct_TrainA01)
    set udg_Point_Goblin_TrainCart_Target[2]=GetRectCenter(gg_rct_TrainA02)
    set udg_Point_GoblinTrainCartUnload[1]=GetRectCenter(gg_rct_TrainB01)
    set udg_Point_GoblinTrainCartUnload[2]=GetRectCenter(gg_rct_TrainB02)
    // //
    set udg_Hero_Deathwing=gg_unit_O601_0334
    set udg_Hero_Alextrasza=gg_unit_O61T_0074
    set udg_Point_AlexstraszaAttack=GetRectCenter(gg_rct_Orc_Camp)
    set udg_Hero_Orastrasz=gg_unit_O007_0726
    // //
    call PauseUnitBJ(true, udg_Hero_Orastrasz)
    call SuspendHeroXPBJ(false, udg_Hero_Orastrasz)
    // //
    // Initialize Goblin Town
    // //
    set udg_Hero_VincentTurnCoat=gg_unit_Ntin_0122
    // //
    call SetUnitAnimation(gg_unit_h609_0141, "stand work")
    call SetUnitAnimation(gg_unit_h609_0108, "stand work")
    call SetUnitAnimation(gg_unit_h609_0112, "stand work")
    call SetUnitAnimation(gg_unit_h609_0123, "stand work")
    call SetUnitAnimation(gg_unit_h609_0081, "stand work gold")
    // //
    // Initialize Kobold Area
    // //
    call IssueImmediateOrderBJ(gg_unit_nkog_0056, "channel")
    call IssueImmediateOrderBJ(gg_unit_nkog_0086, "channel")
    call IssueImmediateOrderBJ(gg_unit_nkog_0079, "channel")
    call IssueImmediateOrderBJ(gg_unit_nkog_0026, "channel")
    call IssueImmediateOrderBJ(gg_unit_nkog_0088, "channel")
    call IssueImmediateOrderBJ(gg_unit_nkog_0084, "channel")
    // //
    call PauseUnitBJ(true, gg_unit_nkog_0086)
    call PauseUnitBJ(true, gg_unit_nkog_0088)
    call PauseUnitBJ(true, gg_unit_nkog_0026)
    call PauseUnitBJ(true, gg_unit_nkog_0079)
    call PauseUnitBJ(true, gg_unit_nkog_0056)
    // //
    call IssuePointOrderLocBJ(gg_unit_nkol_0032, "patrol", GetRectCenter(gg_rct_KoboldPatrol01))
    call IssuePointOrderLocBJ(gg_unit_nkob_0102, "patrol", GetRectCenter(gg_rct_KoboldPatrol02))
    call IssuePointOrderLocBJ(gg_unit_nkob_0082, "patrol", GetRectCenter(gg_rct_KoboldPatrol03))
    call IssuePointOrderLocBJ(gg_unit_nkob_0025, "patrol", GetRectCenter(gg_rct_KoboldPatrol04))
    call IssuePointOrderLocBJ(gg_unit_nkot_0034, "patrol", GetRectCenter(gg_rct_KoboldPatrol05))
    call IssuePointOrderLocBJ(gg_unit_nkol_0101, "patrol", GetRectCenter(gg_rct_KoboldPatrol06))
    // //
    call ShowUnitHide(gg_unit_nkot_0094)
    call ShowUnitHide(gg_unit_nkot_0092)
    // //
    call ShowUnitHide(gg_unit_nkot_0091)
    call ShowUnitHide(gg_unit_nkot_0093)
    // //
    call SetUnitInvulnerable(gg_unit_o006_0292, true)
    // //
    // Kobold Golems
    // //
    set udg_Unit_KoboldGolemArr[1]=gg_unit_ngst_0058
    call SetUnitInvulnerable(gg_unit_ngst_0058, true)
    call PauseUnitBJ(true, gg_unit_ngst_0058)
    call SetUnitAnimation(gg_unit_ngst_0058, "sleep")
    call UnitAddAbility(udg_Unit_KoboldGolemArr[1], 'Aloc')
    // //
    set udg_Unit_KoboldGolemArr[2]=gg_unit_nggr_0023
    call SetUnitInvulnerable(gg_unit_nggr_0023, true)
    call PauseUnitBJ(true, gg_unit_nggr_0023)
    call SetUnitAnimation(gg_unit_nggr_0023, "sleep")
    call UnitAddAbility(udg_Unit_KoboldGolemArr[2], 'Aloc')
    // //
    set udg_Unit_KoboldGolemArr[3]=gg_unit_ngst_0000
    call SetUnitInvulnerable(gg_unit_ngst_0000, true)
    call PauseUnitBJ(true, gg_unit_ngst_0000)
    call SetUnitAnimation(gg_unit_ngst_0000, "sleep")
    call UnitAddAbility(udg_Unit_KoboldGolemArr[3], 'Aloc')
    // //
    set udg_Unit_KoboldGolemArr[4]=gg_unit_ngrk_0022
    call SetUnitInvulnerable(gg_unit_ngrk_0022, true)
    call PauseUnitBJ(true, gg_unit_ngrk_0022)
    call SetUnitAnimation(gg_unit_ngrk_0022, "sleep")
    call UnitAddAbility(udg_Unit_KoboldGolemArr[4], 'Aloc')
    // //
    // //
    // SetUp Healing Points
    // //
    call UnitAddAbilityBJ('Anl1', gg_unit_u003_0712)
    call UnitAddAbilityBJ('Anl1', gg_unit_u003_0035)
    call UnitAddAbilityBJ('Anl1', gg_unit_u003_0375)
    call UnitAddAbilityBJ('Anm1', gg_unit_u003_0089)
    call UnitAddAbilityBJ('Anl1', gg_unit_u003_0004)
    // //
    // //////////////
    // //
    set udg_Unit_ZuluhedBoat=gg_unit_o006_0292
    call BlzSetUnitRealFieldBJ(udg_Unit_ZuluhedBoat, UNIT_RF_HIT_POINTS_REGENERATION_RATE, 0.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_ZuluhedBoat, UNIT_RF_MANA_REGENERATION, 0.00)
    // //
    // Air Elementals
    // //
    call PauseUnitBJ(true, gg_unit_n02I_0392)
    call ShowUnitHide(gg_unit_n02I_0392)
    // //
    call PauseUnitBJ(true, gg_unit_n02I_0391)
    call ShowUnitHide(gg_unit_n02I_0391)
    // //
    call PauseUnitBJ(true, gg_unit_n02I_0393)
    call ShowUnitHide(gg_unit_n02I_0393)
    // //
    call PauseUnitBJ(true, gg_unit_n02J_0390)
    call ShowUnitHide(gg_unit_n02J_0390)
    // //
    call PauseUnitBJ(true, gg_unit_n02J_0388)
    call ShowUnitHide(gg_unit_n02J_0388)
    // //
    call PauseUnitBJ(true, gg_unit_n02I_0395)
    call ShowUnitHide(gg_unit_n02I_0395)
    // //
    call PauseUnitBJ(true, gg_unit_n02I_0394)
    call ShowUnitHide(gg_unit_n02I_0394)
    // //
    call PauseUnitBJ(true, gg_unit_n02J_0389)
    call ShowUnitHide(gg_unit_n02J_0389)
    // //
    call PauseUnitBJ(true, gg_unit_n02M_0055)
    call ShowUnitHide(gg_unit_n02M_0055)
    // //
    // Lizards
    // //
    call IssuePointOrderLocBJ(gg_unit_ndsa_0158, "patrol", GetRectCenter(gg_rct_LizardPatrol01))
    call IssuePointOrderLocBJ(gg_unit_nsll_0121, "patrol", GetRectCenter(gg_rct_LizardPatrol02))
    // //
    // Dwarven Ghosts
    // //
    call ShowUnitHide(gg_unit_n02K_0318)
    call ShowUnitHide(gg_unit_n02K_0166)
    call ShowUnitHide(gg_unit_n02K_0206)
    call ShowUnitHide(gg_unit_n02K_0321)
    call ShowUnitHide(gg_unit_n02K_0322)
    call ShowUnitHide(gg_unit_n02K_0323)
    call ShowUnitHide(gg_unit_n02K_0406)
    call ShowUnitHide(gg_unit_n02K_0407)
    // //
    call ShowUnitHide(gg_unit_n033_0170)
    call ShowUnitHide(gg_unit_n033_0295)
    call ShowUnitHide(gg_unit_n033_0319)
    call ShowUnitHide(gg_unit_n033_0305)
    call ShowUnitHide(gg_unit_n033_0324)
    call ShowUnitHide(gg_unit_n033_0320)
    call ShowUnitHide(gg_unit_n033_0405)
    // //
    // Dwarven Golems
    // //
    set udg_Unit_DwarfGolemArr[1]=gg_unit_nwrg_0168
    set udg_Unit_DwarfGolemArr[2]=gg_unit_n603_0145
    set udg_Unit_DwarfGolemArr[3]=gg_unit_n603_0147
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call PauseUnitBJ(true, udg_Unit_DwarfGolemArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call SetUnitAnimation(udg_Unit_DwarfGolemArr[1], "sleep")
    // //
    call SetUnitTimeScalePercent(udg_Unit_DwarfGolemArr[2], 0.00)
    call SetUnitTimeScalePercent(udg_Unit_DwarfGolemArr[3], 0.00)
    // //
    call UnitAddAbility(udg_Unit_DwarfGolemArr[1], 'Aloc')
    call UnitAddAbility(udg_Unit_DwarfGolemArr[2], 'Aloc')
    call UnitAddAbility(udg_Unit_DwarfGolemArr[3], 'Aloc')
    // //
    // Sitting Draughrs
    // //
    set udg_Unit_DraugrArr[1]=gg_unit_n02P_0410
    set udg_Unit_DraugrArr[2]=gg_unit_n02P_0411
    set udg_Unit_DraugrArr[3]=gg_unit_n02P_0413
    set udg_Unit_DraugrArr[4]=gg_unit_n02P_0412
    set udg_Unit_DraugrArr[5]=gg_unit_n02P_0414
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=5
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call PauseUnitBJ(true, udg_Unit_DraugrArr[GetForLoopIndexB()])
        call SetUnitAnimation(udg_Unit_DraugrArr[GetForLoopIndexB()], "cinematic sitting one")
        call UnitAddAbility(udg_Unit_DraugrArr[GetForLoopIndexB()], 'Aloc')
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    // FireLord
    // //
    set udg_Hero_FireLord=gg_unit_Nfir_0085
    call ShowUnitHide(udg_Hero_FireLord)
    // //
    call TriggerSleepAction(0.25)
    // //
    // Spider Critters
    // //
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(PLAYER_NEUTRAL_PASSIVE), 'n60Z'), function Trig_Init_02_Units_Func212A)
    // //
    // Traps
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_LavaLakeSoundLoop, Condition(function Trig_Init_02_Units_Func217001002)), function Trig_Init_02_Units_Func217A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_LavaLakeSoundLoop, Condition(function Trig_Init_02_Units_Func220001002)), function Trig_Init_02_Units_Func220A)
    // //
    call ForGroupBJ(udg_Group_LavaLakeDamageBottom, function Trig_Init_02_Units_Func222002)
    // //
    call ForGroupBJ(udg_Group_LavaLakeDamageMiddle, function Trig_Init_02_Units_Func224002)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Goblins), function Trig_Init_02_Units_Func228A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Ironforge), function Trig_Init_02_Units_Func231A)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_06a_Hard)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Normal)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Easy)
endfunction

