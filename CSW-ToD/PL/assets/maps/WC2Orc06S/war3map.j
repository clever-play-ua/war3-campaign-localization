//===========================================================================
// Trigger: Orastrasz SummonsGolems
//===========================================================================
function Trig_Orastrasz_SummonsGolems_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AEfn' ) ) then
        return false
    endif
    if ( not ( udg_Bool_BossFightOrastrasz == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_SummonsGolems_Func003Func002001001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n037' )
endfunction

function Trig_Orastrasz_SummonsGolems_Func003Func002001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Orastrasz_SummonsGolems_Func003Func002001001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'n037'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Orastrasz_SummonsGolems_Func003Func006C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_SummonsGolems_Func003Func008C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Orastrasz_LeavesToHeal) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_OrastraszLanded == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_SummonsGolems_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_DungeonFog01, Condition(function Trig_Orastrasz_SummonsGolems_Func003Func002001001002))) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_SummonsGolems_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    if ( Trig_Orastrasz_SummonsGolems_Func003C() ) then
        call PlaySoundBJ(gg_snd_GoldCoinLoop)
        call PolledWait(2)
        // //
        if ( Trig_Orastrasz_SummonsGolems_Func003Func006C() ) then
            call QueuedTriggerAddBJ(gg_trg_Orastrasz_SummonsGolems_Q, true)
        else
        endif
        // //
        if ( Trig_Orastrasz_SummonsGolems_Func003Func008C() ) then
            call ConditionalTriggerExecute(gg_trg_Orastrasz_LeavesToHeal)
        else
            call DoNothing()
        endif
        // //
    else
        call DoNothing()
    endif
endfunction

//===========================================================================
function InitTrig_Orastrasz_SummonsGolems takes nothing returns nothing
    set gg_trg_Orastrasz_SummonsGolems=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Orastrasz_SummonsGolems, EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddCondition(gg_trg_Orastrasz_SummonsGolems, Condition(function Trig_Orastrasz_SummonsGolems_Conditions))
    call TriggerAddAction(gg_trg_Orastrasz_SummonsGolems, function Trig_Orastrasz_SummonsGolems_Actions)
endfunction

