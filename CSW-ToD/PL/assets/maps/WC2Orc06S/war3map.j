//===========================================================================
function Trig_FireLord_SpawnMinions_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightFireLord == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_SpawnMinions_Actions takes nothing returns nothing
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_Int_LavaSpawnUnitQuantity
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, udg_UnitType_LavaSpawnSummon, udg_Player_Elementals, udg_Point_LavaLakeMinionSpawn[GetForLoopIndexA()], GetRandomDirectionDeg())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_LavaMinions)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "attack", udg_Hero_Zuluhed)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

