    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_06c_Easy_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), 75.00)
    set udg_Int_BladeDamage=150
    set udg_Int_LavaDamage=100
    set udg_Real_PuzzleFlameDamage=200.00
    set udg_PuzzleFlameDamageText="200!"
    // //
    set udg_Int_DragonsAttackMaxAmount=1
    // //
    // //
    call BlzSetUnitBaseDamage(udg_Hero_Orastrasz, 20, 0)
    call BlzSetUnitBaseDamage(udg_Hero_Alextrasza, 25, 0)
    // //
    set udg_Int_CreepHP=20
    set udg_Int_CreepDMG=1
    // //
    call BlzSetUnitMaxHP(udg_Hero_FireLord, 1500)
    call SetUnitLifeBJ(udg_Hero_FireLord, GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_FireLord))
    // //
    // Set Alexstrasza's max life to 75%
    // //
    call BlzSetUnitMaxHP(udg_Hero_Alextrasza, 9000)
    call SetUnitLifePercentBJ(udg_Hero_Alextrasza, 100)
    // //
    set udg_Real_AlexBFWhelpSummonTime=17.00
endfunction

