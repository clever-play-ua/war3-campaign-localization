//===========================================================================
// Trigger: Initialization
//
// Default melee game initialization for all players
//===========================================================================
function Trig_Initialization_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_FaceAnimLoader)
    call ConditionalTriggerExecute(gg_trg_Oil_Locale_Setup)
    call SetAllyColorFilterState(0)
    call EnableMinimapFilterButtons(false, false)
    call SetMaxCheckpointSaves(10)
    // **********
    set udg_Point_SpawnFakeNekros=GetRectCenter(gg_rct_SpawnFakeNekros)
    set udg_Point_SpawnFakeTharbek=GetRectCenter(gg_rct_SpawnFakeTharbek)
    set udg_Point_SpawnFakeVincent=GetRectCenter(gg_rct_SpawnFakeVincent)
    set udg_Point_SpawnFakeZuluhed=GetRectCenter(gg_rct_SpawnFakeZuluhed)
    // **********
    call ConditionalTriggerExecute(gg_trg_Init_01_Players)
    call ConditionalTriggerExecute(gg_trg_Init_03_Quests)
    call ConditionalTriggerExecute(gg_trg_Init_04_Environment)
    call ConditionalTriggerExecute(gg_trg_Init_05_Audio)
    // **********
    call QueuedTriggerAddBJ(gg_trg_Intro_Cinematic_Q, true)
endfunction

//===========================================================================
function InitTrig_Initialization takes nothing returns nothing
    set gg_trg_Initialization=CreateTrigger()
    call TriggerAddAction(gg_trg_Initialization, function Trig_Initialization_Actions)
endfunction

//===========================================================================
// Trigger: Init 01 Players
//===========================================================================
function Trig_Init_01_Players_Actions takes nothing returns nothing
    call EnableCreepSleepBJ(false)
    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[0]
    // //
    set udg_Player_Actual=Player(0)
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, true)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_3778")
    call SetPlayerTechResearchedSwap('R074', 1, udg_Player_Actual)
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 50.00)
    call SetPlayerTechMaxAllowedSwap('o608', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o605', 0, udg_Player_Actual)
    // //
    set udg_Player_CinematicDragonMaw=Player(21)
    // //
    set udg_Player_CinematicDummy=Player(23)
    // //
    set udg_Player_DarkIron=Player(11)
    // //
    set udg_Player_Elementals=Player(4)
    call SetPlayerColorBJ(udg_Player_Elementals, PLAYER_COLOR_MAROON, true)
    // //
    set udg_Player_Goblins=Player(20)
    // //
    set udg_Player_Ironforge=Player(5)
    call SetPlayerName(udg_Player_Ironforge, "TRIGSTR_4636")
    call SetPlayerStateBJ(udg_Player_Ironforge, PLAYER_STATE_RESOURCE_GOLD, 10000)
    call SetPlayerStateBJ(udg_Player_Ironforge, PLAYER_STATE_RESOURCE_LUMBER, 10000)
    call SetPlayerTechResearchedSwap('R016', 1, udg_Player_Ironforge)
    call SetPlayerTechMaxAllowedSwap('dICa', 1, udg_Player_Ironforge)
    // //
    set udg_Player_Ogres=Player(16)
    // //
    set udg_Player_RedDragons=Player(12)
    // //
    set udg_Player_BlackDragon=Player(3)
    call SetPlayerName(udg_Player_BlackDragon, "TRIGSTR_240")
    call SetPlayerOnScoreScreenBJ(false, udg_Player_BlackDragon)
    // //
    // Neutrality for intro cinematic
    // //
    call SetPlayerAllianceStateBJ(udg_Player_BlackDragon, udg_Player_CinematicDragonMaw, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_CinematicDragonMaw, udg_Player_BlackDragon, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BlackDragon, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BlackDragon, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BlackDragon, udg_Player_DarkIron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_DarkIron, udg_Player_BlackDragon, bj_ALLIANCE_NEUTRAL)
    // //
    // Alliances
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Ironforge, udg_Player_RedDragons, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_RedDragons, udg_Player_Ironforge, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_DarkIron, udg_Player_CinematicDragonMaw, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_CinematicDragonMaw, udg_Player_DarkIron, bj_ALLIANCE_UNALLIED_VISION)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Ironforge, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Ironforge, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Ogres, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Ogres, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_RedDragons, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_RedDragons, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Ogres, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Ogres, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // //
endfunction

//===========================================================================
function InitTrig_Init_01_Players takes nothing returns nothing
    set gg_trg_Init_01_Players=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_01_Players, function Trig_Init_01_Players_Actions)
endfunction

