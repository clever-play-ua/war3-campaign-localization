    set gg_trg_DragonSoul_Discharged=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_DragonSoul_Discharged, EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddCondition(gg_trg_DragonSoul_Discharged, Condition(function Trig_DragonSoul_Discharged_Conditions))
    call TriggerAddAction(gg_trg_DragonSoul_Discharged, function Trig_DragonSoul_Discharged_Actions)
endfunction

