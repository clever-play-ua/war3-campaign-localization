    set gg_trg_Mother_Alextrasza_SummonWhelps=CreateTrigger()
    call DisableTrigger(gg_trg_Mother_Alextrasza_SummonWhelps)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Mother_Alextrasza_SummonWhelps, udg_Timer_AlextrasaSummonWhelps)
    call TriggerAddCondition(gg_trg_Mother_Alextrasza_SummonWhelps, Condition(function Trig_Mother_Alextrasza_SummonWhelps_Conditions))
