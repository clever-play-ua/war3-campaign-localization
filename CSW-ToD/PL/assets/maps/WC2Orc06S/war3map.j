endfunction

function Trig_Mother_Alextrasza_Landing_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_Mother_Completed)
    // //
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Hero_Alextrasza)
    call SetUnitInvulnerable(udg_Hero_Alextrasza, true)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Hero_Alextrasza, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call SetPlayerAllianceStateBJ(udg_Player_RedDragons, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_RedDragons, bj_ALLIANCE_NEUTRAL)
    call SetUnitPathing(udg_Hero_Alextrasza, false)
    call RemoveGuardPosition(udg_Hero_Alextrasza)
    call IssueImmediateOrderBJ(udg_Hero_Alextrasza, "stop")
    // //
    call IssuePointOrderLocBJ(udg_Hero_Alextrasza, "move", udg_Point_AlexLanding)
    call EnableTrigger(gg_trg_Mother_Alextrasza_Landing_Order_Loop)
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_OutroAlextraszaStunned, udg_Hero_Alextrasza) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
    endloop
    call TriggerSleepAction(0.50)
    // //
    call SetUserControlForceOff(udg_PlayerGroup_PlayerActual)
    call SetCameraTargetControllerNoZForPlayer(udg_Player_Actual, udg_Hero_Alextrasza, 0, 0, false)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Mother_Alextrasza_Landing_Func023002)
    // //
    // Clearing the Landing Zone
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_AlextraszaNest, Condition(function Trig_Mother_Alextrasza_Landing_Func027001002)), function Trig_Mother_Alextrasza_Landing_Func027A)
    // //
    call ForGroupBJ(udg_Group_BFCollisionOff, function Trig_Mother_Alextrasza_Landing_Func029A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Mother_Alextrasza_Landing_Func032001002)), function Trig_Mother_Alextrasza_Landing_Func032A)
    // //
    call ForGroupBJ(udg_Group_TempLandingMove, function Trig_Mother_Alextrasza_Landing_Func034A)
    // //
    call EnableTrigger(gg_trg_Mother_Alextrasza_Landing_Zone_Free)
    // //
    loop
        exitwhen ( (udg_Bool_LandingSiteAlexClear == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
    endloop
    call TriggerSleepAction(0.50)
    // //
    call IssueImmediateOrderBJ(udg_Hero_Alextrasza, "unravenform")
    call PlaySoundBJ(gg_snd_DeathwingLand)
    // //
    call TriggerSleepAction(5.00)
    // fallback and enforce the transformation if its failed
    if ( Trig_Mother_Alextrasza_Landing_Func046C() ) then
        call ReplaceUnitBJ(udg_Hero_Alextrasza, 'O61G', bj_UNIT_STATE_METHOD_RELATIVE)
        set udg_Hero_Alextrasza=GetLastReplacedUnitBJ()
    else
    endif
    // //
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 4.00)
    // //
    call AddSpecialEffectLocBJ(udg_Point_AlexstraszaNestDust, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl")
    set udg_SE_DragonLandingClap=GetLastCreatedEffectBJ()
    call AddSpecialEffectLocBJ(udg_Point_AlexstraszaNestDust, "units\\undead\\cryptfiend\\cryptfiendburrow.mdl")
    set udg_SE_DragonLandingDust=GetLastCreatedEffectBJ()
    // //
    call UnitRemoveAbilityBJ('A62R', udg_Hero_Alextrasza)
    call UnitRemoveAbilityBJ('AHfs', udg_Hero_Alextrasza)
    // //
    call UnitAddAbilityBJ('ANbf', udg_Hero_Alextrasza)
    call UnitAddAbilityBJ('AOws', udg_Hero_Alextrasza)
    call UnitAddAbilityBJ('AUts', udg_Hero_Alextrasza)
    call UnitAddAbilityBJ('Aamk', udg_Hero_Alextrasza)
    call UnitAddAbilityBJ('AOhw', udg_Hero_Alextrasza)
    // //
    call SelectHeroSkill(udg_Hero_Alextrasza, 'AOw2')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'AOw2')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'AOw2')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'ANbf')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'ANbf')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'ANbf')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'AUts')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'AUts')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'AUts')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'Aamk')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'Aamk')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'Aamk')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'AOhw')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'AOhw')
    call SelectHeroSkill(udg_Hero_Alextrasza, 'AOhw')
    // //
    call ForGroupBJ(udg_Group_BFCollisionOff, function Trig_Mother_Alextrasza_Landing_Func080A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Mother_Alextrasza_Landing_Func083002)
    // //
    call GroupClear(udg_Group_BFCollisionOff)
    call GroupClear(udg_Group_TempLandingMove)
    // //
    call SetUnitPathing(udg_Hero_Alextrasza, true)
    // //
    call SetUnitInvulnerable(udg_Hero_Alextrasza, false)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Hero_Alextrasza, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
    // //
    set udg_Bool_AlextraszaLanded=true
    // //
    call SetPlayerAllianceStateBJ(udg_Player_RedDragons, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_RedDragons, bj_ALLIANCE_UNALLIED)
    // //
    call PolledWait(1.00)
    // //
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call SetUserControlForceOn(udg_PlayerGroup_PlayerActual)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    call DestroyEffectBJ(udg_SE_DragonLandingClap)
    call DestroyEffectBJ(udg_SE_DragonLandingDust)
    // //
    call ConditionalTriggerExecute(gg_trg_Mother_Alextrasza_Landing_Q)
endfunction

