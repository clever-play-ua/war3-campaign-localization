//===========================================================================
function Trig_LavaLake_DamageChecker_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_LavaLakeActive == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_DamageChecker_Func001Func001Func001C takes nothing returns boolean
    if ( not ( udg_Int_LavaPuzzleLevel == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_DamageChecker_Func001Func001C takes nothing returns boolean
    if ( not ( udg_Int_LavaPuzzleLevel == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_DamageChecker_Func001C takes nothing returns boolean
    if ( not ( udg_Int_LavaPuzzleLevel == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LavaLake_DamageChecker_Actions takes nothing returns nothing
    if ( Trig_LavaLake_DamageChecker_Func001C() ) then
        call SetPlayerTechResearchedSwap('R072', 0, Player(4))
        call SetPlayerTechResearchedSwap('R073', 0, Player(4))
    else
        if ( Trig_LavaLake_DamageChecker_Func001Func001C() ) then
            call SetPlayerTechResearchedSwap('R072', 1, Player(4))
            call SetPlayerTechResearchedSwap('R073', 0, Player(4))
        else
            if ( Trig_LavaLake_DamageChecker_Func001Func001Func001C() ) then
                call SetPlayerTechResearchedSwap('R072', 1, Player(4))
                call SetPlayerTechResearchedSwap('R073', 1, Player(4))
            else
                call DoNothing()
            endif
        endif
    endif
endfunction

//===========================================================================
function InitTrig_LavaLake_DamageChecker takes nothing returns nothing
    set gg_trg_LavaLake_DamageChecker=CreateTrigger()
    call DisableTrigger(gg_trg_LavaLake_DamageChecker)
    call TriggerRegisterTimerEventPeriodic(gg_trg_LavaLake_DamageChecker, 1.00)
    call TriggerAddCondition(gg_trg_LavaLake_DamageChecker, Condition(function Trig_LavaLake_DamageChecker_Conditions))
    call TriggerAddAction(gg_trg_LavaLake_DamageChecker, function Trig_LavaLake_DamageChecker_Actions)
endfunction

