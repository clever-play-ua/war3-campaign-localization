    set udg_QReq_AlexMotherEnslave=GetLastCreatedQuestItemBJ()
    // OPTIONAL QUEST: RECRUIT OGRES
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_4287", "TRIGSTR_4288", "ReplaceableTextures\\CommandButtons\\BTNWC2Ogre.dds")
