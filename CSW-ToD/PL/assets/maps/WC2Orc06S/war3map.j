function Trig_Intro_Cinematic_Q_Func327001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_GenericCInematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call TriggerSleepAction(1.00)
    // //
    call ShowUnitHide(udg_Hero_Deathwing)
    call SetItemVisibleBJ(true, udg_Item_DragonSoulQuest)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_RedDragons), function Trig_Intro_Cinematic_Q_Func013002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Intro_Cinematic_Q_Func014002)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_IntroZuluhed01), 0.00)
    call ShowUnitHide(udg_FakeZuluhed)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'O61M', udg_Player_BlackDragon, GetRectCenter(gg_rct_IntroDeathwing01), GetRectCenter(gg_rct_IntroZuluhed02))
    set udg_Unit_DeathwingFlyingCinematic=GetLastCreatedUnit()
    call RemoveGuardPosition(udg_Unit_DeathwingFlyingCinematic)
    call ShowUnitHide(udg_Unit_DeathwingFlyingCinematic)
    // //
    call SetUnitScalePercent(gg_unit_h000_0358, 200.00, 200.00, 200.00)
    call SetUnitFlyHeightBJ(gg_unit_h000_0358, 500.00, 0.00)
    // //
    call SetSkyModel("Environment\\Sky\\DalaranSky\\DalaranSky.mdl")
    call SetTimeOfDay(8.00)
    call SetTerrainFogExBJ(0, 1200.00, 10500.00, 0.10, 85.00, 45.00, 14.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroZuluhed01, udg_Player_Actual, 0)
    call CameraSetFocalDistance(100.00)
    // //
    call IssuePointOrderLocBJ(gg_unit_h000_0358, "move", GetRectCenter(gg_rct_IntroZuluhed01))
    call PlaySoundBJ(gg_snd_ZeppelinPropellerBlades)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // //
    call PlaySoundBJ(gg_snd_CS_orc3_outro_zepp)
    // //
    // //
    call PlaySoundBJ(gg_snd_DarkAgents)
    // //
    call TriggerSleepAction(2.00)
    // Cinematic Started
    // //
    set udg_Bool_CinIntroOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    set udg_Point_ZepelinTemp=GetUnitLoc(gg_unit_h000_0358)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_ZepelinTemp, GetRectCenter(gg_rct_IntroZuluhed01)) / GetUnitMoveSpeed(gg_unit_h000_0358) ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_h000_0358, "spell")
    call PlaySoundBJ(gg_snd_Loading)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroZuluhed04, udg_Player_Actual, 0)
    call SetTerrainFogExBJ(0, 1000.00, 5000.00, 0.10, 85.00, 45.00, 14.00)
    call CameraSetFocalDistance(150.00)
    // //
    call ShowUnitShow(udg_FakeZuluhed)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_DarkAgents, true)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroZuluhed02, udg_Player_Actual, 15.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ResetUnitAnimation(gg_unit_h000_0358)
    call IssuePointOrderLocBJ(gg_unit_h000_0358, "move", GetRectCenter(gg_rct_BigLake))
    // //
