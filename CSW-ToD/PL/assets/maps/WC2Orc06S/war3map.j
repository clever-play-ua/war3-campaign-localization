endfunction

//===========================================================================
// Trigger: Orastrasz LeavesToHeal
//===========================================================================
function Trig_Orastrasz_LeavesToHeal_Conditions takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Orastrasz) <= 3000.00 ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Orastrasz) > 2200.00 ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_BossFightOrastrasz == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_OrastraszLanded == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_LeavesToHeal_Func005C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_OrastraszExcapeZone01, udg_Hero_Zuluhed) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_LeavesToHeal_Func007C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_OrastraszExcapeZone02, udg_Hero_Zuluhed) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_LeavesToHeal_Func009C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_OrastraszExcapeZone03, udg_Hero_Zuluhed) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_LeavesToHeal_Func011C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_OrastraszExcapeZone04, udg_Hero_Zuluhed) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Orastrasz_LeavesToHeal_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    if ( Trig_Orastrasz_LeavesToHeal_Func005C() ) then
        set udg_Point_OrastraszEscapeArr[1]=GetRectCenter(gg_rct_OrastraszExcapeZone01)
    else
        set udg_Point_OrastraszEscapeArr[1]=GetRectCenter(gg_rct_OrastraszLanding)
    endif
    // //
    if ( Trig_Orastrasz_LeavesToHeal_Func007C() ) then
        set udg_Point_OrastraszEscapeArr[2]=GetRectCenter(gg_rct_OrastraszExcapeZone02)
    else
        set udg_Point_OrastraszEscapeArr[2]=GetRectCenter(gg_rct_OrastraszLanding)
    endif
    // //
    if ( Trig_Orastrasz_LeavesToHeal_Func009C() ) then
        set udg_Point_OrastraszEscapeArr[3]=GetRectCenter(gg_rct_OrastraszExcapeZone03)
    else
        set udg_Point_OrastraszEscapeArr[3]=GetRectCenter(gg_rct_OrastraszLanding)
    endif
    // //
    if ( Trig_Orastrasz_LeavesToHeal_Func011C() ) then
        set udg_Point_OrastraszEscapeArr[4]=GetRectCenter(gg_rct_OrastraszExcapeZone04)
    else
        set udg_Point_OrastraszEscapeArr[4]=GetRectCenter(gg_rct_OrastraszLanding)
    endif
    // //
    // //
    set udg_Int_ChanceOrastraszEscape=GetRandomInt(1, 4)
    // //
    call IssuePointOrderLocBJ(udg_Hero_Orastrasz, "move", udg_Point_OrastraszEscapeArr[udg_Int_ChanceOrastraszEscape])
    // //
    call RemoveLocation(udg_Point_OrastraszEscapeArr[1])
    call RemoveLocation(udg_Point_OrastraszEscapeArr[2])
    call RemoveLocation(udg_Point_OrastraszEscapeArr[3])
    call RemoveLocation(udg_Point_OrastraszEscapeArr[4])
    set udg_Point_OrastraszPosition=GetUnitLoc(udg_Hero_Orastrasz)
    call PolledWait(( DistanceBetweenPoints(udg_Point_OrastraszPosition, udg_Point_OrastraszEscapeArr[udg_Int_ChanceOrastraszEscape]) / GetUnitMoveSpeed(udg_Hero_Orastrasz) ))
    call RemoveLocation(udg_Point_OrastraszPosition)
    // //
    call UnitAddItemByIdSwapped('hslv', udg_Hero_Orastrasz)
    call StartTimerBJ(udg_Timer_OrastraszHealsResume, false, 120.00)
    // //
endfunction

//===========================================================================
function InitTrig_Orastrasz_LeavesToHeal takes nothing returns nothing
    set gg_trg_Orastrasz_LeavesToHeal=CreateTrigger()
    call TriggerAddCondition(gg_trg_Orastrasz_LeavesToHeal, Condition(function Trig_Orastrasz_LeavesToHeal_Conditions))
    call TriggerAddAction(gg_trg_Orastrasz_LeavesToHeal, function Trig_Orastrasz_LeavesToHeal_Actions)
endfunction

//===========================================================================
