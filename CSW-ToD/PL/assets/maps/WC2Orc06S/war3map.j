    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'Ytlc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_TrainCart_TravelToTown_Func020A takes nothing returns nothing
    if ( Trig_Goblin_TrainCart_TravelToTown_Func020Func001C() ) then
        call DestructableRestoreLife(GetEnumDestructable(), GetDestructableMaxLife(GetEnumDestructable()), false)
    else
    endif
endfunction

function Trig_Goblin_TrainCart_TravelToTown_Func021Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'Ytlc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_TrainCart_TravelToTown_Func021A takes nothing returns nothing
    if ( Trig_Goblin_TrainCart_TravelToTown_Func021Func001C() ) then
        call DestructableRestoreLife(GetEnumDestructable(), GetDestructableMaxLife(GetEnumDestructable()), false)
    else
    endif
endfunction

function Trig_Goblin_TrainCart_TravelToTown_Actions takes nothing returns nothing
    call SmartCameraPanBJ(udg_Player_Actual, udg_Point_Goblin_TrainCart_Camera[2], 0.00)
    // //
    call EnumDestructablesInRectAll(gg_rct_TrainLineOfSightBlockerLarge01, function Trig_Goblin_TrainCart_TravelToTown_Func003A)
    call EnumDestructablesInRectAll(gg_rct_TrainLineOfSightBlockerLarge02, function Trig_Goblin_TrainCart_TravelToTown_Func004A)
    // //
    call UnitAddAbilityBJ('A01N', udg_Unit_GoblinTrainCart)
    // //
    call ClearSelectionForPlayer(udg_Player_Actual)
    call EnableSelect(false, false)
    call SetUnitMoveSpeed(udg_Unit_GoblinTrainCart, 400.00)
    // //
    call IssuePointOrderLocBJ(udg_Unit_GoblinTrainCart, "move", udg_Point_Goblin_TrainCart_Target[2])
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_TrainStation01, udg_Player_Actual, 8.75)
    // //
    call PolledWait(9.00)
    // //
    call UnitRemoveAbilityBJ('A01N', udg_Unit_GoblinTrainCart)
    // //
    call EnumDestructablesInRectAll(gg_rct_TrainLineOfSightBlockerLarge01, function Trig_Goblin_TrainCart_TravelToTown_Func020A)
    call EnumDestructablesInRectAll(gg_rct_TrainLineOfSightBlockerLarge02, function Trig_Goblin_TrainCart_TravelToTown_Func021A)
    // //
    call IssuePointOrderLocBJ(udg_Unit_GoblinTrainCart, "unloadall", udg_Point_GoblinTrainCartUnload[2])
    // //
    set udg_Bool_TrainInGoblinTown=true
    call EnableSelect(true, true)
    call SetUnitFacingTimed(udg_Unit_GoblinTrainCart, 90.00, 0.50)
    // //
    call TriggerSleepAction(0.50)
    // //
endfunction

