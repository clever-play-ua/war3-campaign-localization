// Trigger: DragonSoul Discharged Hint Q
//===========================================================================
function Trig_DragonSoul_Discharged_Hint_Q_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragonSoul_Discharged_Hint_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_DragonSoul_Recharged)
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_SECRET, "TRIGSTR_4301")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

