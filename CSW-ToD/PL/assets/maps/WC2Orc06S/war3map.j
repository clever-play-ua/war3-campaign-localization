//===========================================================================
// Trigger: Goblins Cinematic Q
//===========================================================================
function Trig_Goblins_Cinematic_Q_Func027001 takes nothing returns boolean
    return ( udg_Bool_CinGoblinsSkipped == true )
endfunction

function Trig_Goblins_Cinematic_Q_Func030001 takes nothing returns boolean
    return ( udg_Bool_CinGoblinsSkipped == true )
endfunction

function Trig_Goblins_Cinematic_Q_Func035001 takes nothing returns boolean
    return ( udg_Bool_CinGoblinsSkipped == true )
endfunction

function Trig_Goblins_Cinematic_Q_Func046001 takes nothing returns boolean
    return ( udg_Bool_CinGoblinsSkipped == true )
endfunction

function Trig_Goblins_Cinematic_Q_Func051001 takes nothing returns boolean
    return ( udg_Bool_CinGoblinsSkipped == true )
endfunction

function Trig_Goblins_Cinematic_Q_Func065001 takes nothing returns boolean
    return ( udg_Bool_CinGoblinsSkipped == true )
endfunction

function Trig_Goblins_Cinematic_Q_Func068001 takes nothing returns boolean
    return ( udg_Bool_CinGoblinsSkipped == true )
endfunction

function Trig_Goblins_Cinematic_Q_Func075001 takes nothing returns boolean
    return ( udg_Bool_CinGoblinsSkipped == true )
endfunction

function Trig_Goblins_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCInematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinDialogue03, udg_Player_Actual, 0)
    // //
    call ConditionalTriggerExecute(gg_trg_Goblins_Cinematic_Setup)
    call TriggerSleepAction(1.00)
    // //
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_MidCinGoblinsZuluhed02))
    call PlaySoundBJ(gg_snd_DarkAgents)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call PlaySoundBJ(gg_snd_CS_Prologue2_Foley2)
    // //
    set udg_Bool_CinGoblinsOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    // Cinematic Started
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_GoblinDialogue02, udg_Player_Actual, 10.00, 0.00, 4.00, 2.00)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_GoblinMeet1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeVincent, 0, gg_snd_WC2Orc06SVincentGoblin_GoblinMeet1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_GoblinMeet2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Showing the Door
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ChamberDoor01, udg_Player_Actual, 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGoblinsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ChamberDoor02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc06SVincentGoblin_GoblinMeet2))
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeVincent, 0, gg_snd_WC2Orc06SVincentGoblin_GoblinMeet2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Back to Town
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_MidCinGoblinsZuluhed03), 156.76)
    call SetUnitFacingToFaceUnitTimed(udg_FakeVincent, udg_FakeZuluhed, 0)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinDialogue01, udg_Player_Actual, 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGoblinsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_VincentTurnCoat, 0, gg_snd_WC2Orc06SVincentGoblin_GoblinMeet3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_DarkAgents, true)
    // //
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic frustrated one")
    call QueueUnitAnimationBJ(udg_FakeZuluhed, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc06SZuluhed_GoblinMeet3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGoblinsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Goblins_Cinematic_Cleanup)
endfunction

