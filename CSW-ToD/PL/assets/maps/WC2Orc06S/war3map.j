// Trigger: Mother Completed
//===========================================================================
function Trig_Mother_Completed_Conditions takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Alextrasza) <= 300.00 ) ) then
        return false
    endif
    if ( not ( udg_Bool_BossFightAlextraza == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_AlextraszaLanded == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_Completed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PauseTimerBJ(true, udg_Timer_AlextrasaSummonWhelps)
    call PauseUnitBJ(true, udg_Hero_Alextrasza)
    call SetUnitInvulnerable(udg_Hero_Alextrasza, true)
    call BlzUnitDisableAbility(udg_Hero_Alextrasza, 'AOhw', true, true)
    call BlzSetUnitWeaponBooleanFieldBJ(udg_Hero_Alextrasza, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
    call SetUnitBlendTimeBJ(udg_Hero_Alextrasza, 0.75)
    call SetUnitAnimation(udg_Hero_Alextrasza, "Cinematic Spell Stun 1")
    // //
    call AddSpecialEffectTargetUnitBJ("origin", udg_Hero_Alextrasza, "Abilities\\Spells\\Human\\AerialShackles\\AerialShacklesTarget.mdl")
    set udg_SE_AerialShacklesCage=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectScale(udg_SE_AerialShacklesCage, 2.00)
    set udg_Bool_GameOver=true
    call QueuedTriggerAddBJ(gg_trg_Mother_Completed_Q, true)
    call QueuedTriggerAddBJ(gg_trg_Outro_Cinematic_Q, true)
endfunction

