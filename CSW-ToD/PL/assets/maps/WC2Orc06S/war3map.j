function InitTrig_AlexRaid_Start_Q takes nothing returns nothing
    set gg_trg_AlexRaid_Start_Q=CreateTrigger()
    call TriggerAddCondition(gg_trg_AlexRaid_Start_Q, Condition(function Trig_AlexRaid_Start_Q_Conditions))
    call TriggerAddAction(gg_trg_AlexRaid_Start_Q, function Trig_AlexRaid_Start_Q_Actions)
endfunction

