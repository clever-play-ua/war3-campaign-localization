//===========================================================================
// Trigger: Outro Cinematic Setup
//===========================================================================
function Trig_Outro_Cinematic_Setup_Func017001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false )
endfunction

function Trig_Outro_Cinematic_Setup_Func017001002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_FLYING) == true )
endfunction

function Trig_Outro_Cinematic_Setup_Func017001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false), (IsUnitType(GetFilterUnit(), UNIT_TYPE_FLYING) == true)) // INLINED!!
endfunction

function Trig_Outro_Cinematic_Setup_Func017A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Outro_Cinematic_Setup_Func020A takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_Orc_Camp))
endfunction

function Trig_Outro_Cinematic_Setup_Func022C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Necros) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Outro_Cinematic_Setup_Func024C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Tharbek) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Outro_Cinematic_Setup_Actions takes nothing returns nothing
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_RedDragons, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_RedDragons, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_RedDragons, udg_Player_CinematicDragonMaw, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_CinematicDragonMaw, udg_Player_RedDragons, bj_ALLIANCE_NEUTRAL)
    // //
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Hero_Alextrasza)
    // //
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call SetSkyModel("Environment\\Sky\\DalaranRuinsSky\\DalaranRuinsSky.mdl")
    // //
    call UnitRemoveAbilityBJ('A01V', udg_Unit_CinematicEggArr[1])
    call UnitRemoveAbilityBJ('A01V', udg_Unit_CinematicEggArr[2])
    call UnitRemoveAbilityBJ('A01V', udg_Unit_CinematicEggArr[3])
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_RedDragons, Condition(function Trig_Outro_Cinematic_Setup_Func017001002)), function Trig_Outro_Cinematic_Setup_Func017A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_AlextraszaNest, udg_Player_Actual), function Trig_Outro_Cinematic_Setup_Func020A)
    // //
    if ( Trig_Outro_Cinematic_Setup_Func022C() ) then
        call ShowUnitHide(udg_Hero_Necros)
        call PauseUnitBJ(true, udg_Hero_Necros)
    else
    endif
    // //
    if ( Trig_Outro_Cinematic_Setup_Func024C() ) then
        call ShowUnitHide(udg_SemiHero_Tharbek)
        call PauseUnitBJ(true, udg_SemiHero_Tharbek)
    else
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeNekros, GetRectCenter(gg_rct_OutroNekros), GetRectCenter(gg_rct_OutroAlextraszaStunned))
    call SetUnitPathing(udg_FakeNekros, false)
    call SetUnitFacingTimed(udg_FakeNekros, 31.95, 0)
    call SetUnitAnimation(udg_FakeNekros, "stand channel")
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeTharbek, GetRectCenter(gg_rct_OutroTharbek), GetRectCenter(gg_rct_OutroAlextraszaStunned))
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    call SetUnitOwner(udg_FakeTharbek, udg_Player_RedDragons, true)
    // //
    call CreateNUnitsAtLoc(1, 'nvlk', udg_Player_Actual, GetRectCenter(gg_rct_OutroDragonSoul), bj_UNIT_FACING)
    set udg_Unit_OutroDragonSoulEmitter=GetLastCreatedUnit()
    call SetUnitVertexColorBJ(udg_Unit_OutroDragonSoulEmitter, 100, 100, 100, 100.00)
    // //
    call UnitAddAbilityBJ('AS65', udg_Unit_OutroDragonSoulEmitter)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Alextrasza, GetRectCenter(gg_rct_OutroAlextraszaStunned), GetRectCenter(gg_rct_OutroTharbek))
    // //
    // //
    call CreateNUnitsAtLoc(1, 'oWyh', udg_Player_Actual, GetRectCenter(gg_rct_OutroSpearman01), 80.01)
    set udg_Unit_OutroHunterArr[1]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'oWyh', udg_Player_Actual, GetRectCenter(gg_rct_OutroSpearman02), 39.69)
    set udg_Unit_OutroHunterArr[2]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'oWyh', udg_Player_Actual, GetRectCenter(gg_rct_OutroSpearman03), 346.86)
    set udg_Unit_OutroHunterArr[3]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'oWyh', udg_Player_Actual, GetRectCenter(gg_rct_OutroSpearman04), 218.97)
    set udg_Unit_OutroHunterArr[4]=GetLastCreatedUnit()
    // //
    call UnitRemoveAbilityBJ('ACrk', udg_Hero_Alextrasza)
    call UnitRemoveAbilityBJ('Adev', udg_Hero_Alextrasza)
    call UnitRemoveAbilityBJ('Advc', udg_Hero_Alextrasza)
    call SetUnitInvulnerable(udg_Hero_Alextrasza, false)
    call SetUnitLifePercentBJ(udg_Hero_Alextrasza, 100)
    // //
    call IssueTargetOrderBJ(udg_Unit_OutroDragonSoulEmitter, "magicleash", udg_Hero_Alextrasza)
    // //
    // //
endfunction

