//===========================================================================
// Trigger: Goblin TrainCart Unload
//===========================================================================
function Trig_Goblin_TrainCart_Unload_Func013C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'Adri' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'Sdro' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Goblin_TrainCart_Unload_Conditions takes nothing returns boolean
    if ( not Trig_Goblin_TrainCart_Unload_Func013C() ) then
        return false
    endif
    if ( not ( GetSpellAbilityUnit() == udg_Unit_GoblinTrainCart ) ) then
        return false
    endif
    if ( not ( udg_Bool_ZuluhedInTrain == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_CartUnlocked == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_TrainCart_Unload_Actions takes nothing returns nothing
    set udg_Bool_ZuluhedInTrain=false
    // //
    call DestroyEffectBJ(udg_SE_ZuluhedCartPassenger)
    // //
    // //
    call ReplaceUnitBJ(udg_Unit_GoblinTrainCart, 'e002', bj_UNIT_STATE_METHOD_RELATIVE)
    set udg_Unit_GoblinTrainCart=GetLastReplacedUnitBJ()
    // //
    // //
    call BlzSetUnitBooleanFieldBJ(udg_Unit_GoblinTrainCart, UNIT_BF_IS_A_BUILDING, true)
    call PauseUnitBJ(true, udg_Unit_GoblinTrainCart)
    call SelectUnitForPlayerSingle(udg_Hero_Zuluhed, udg_Player_Actual)
endfunction

//===========================================================================
function InitTrig_Goblin_TrainCart_Unload takes nothing returns nothing
    set gg_trg_Goblin_TrainCart_Unload=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Goblin_TrainCart_Unload, Player(0), EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddCondition(gg_trg_Goblin_TrainCart_Unload, Condition(function Trig_Goblin_TrainCart_Unload_Conditions))
    call TriggerAddAction(gg_trg_Goblin_TrainCart_Unload, function Trig_Goblin_TrainCart_Unload_Actions)
endfunction

