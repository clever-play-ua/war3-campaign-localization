//===========================================================================
// Trigger: Camp Cinematic Setup
//===========================================================================
function Trig_Camp_Cinematic_Setup_Func068A takes nothing returns nothing
    call BlzSetUnitMaxHP(GetEnumUnit(), ( BlzGetUnitMaxHP(GetEnumUnit()) + ( GetUnitLevel(GetEnumUnit()) * udg_Int_CreepHP ) ))
    call SetUnitLifePercentBJ(GetEnumUnit(), 100)
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetEnumUnit(), 0) + ( GetUnitLevel(GetEnumUnit()) * udg_Int_CreepDMG ) ))
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetEnumUnit(), 1) + ( GetUnitLevel(GetEnumUnit()) * udg_Int_CreepDMG ) ))
endfunction

function Trig_Camp_Cinematic_Setup_Func073A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Camp_Cinematic_Setup_Func076A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Camp_Cinematic_Setup_Actions takes nothing returns nothing
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    // //
    call TriggerSleepAction(0.01)
    call CameraSetupApplyForPlayer(true, gg_cam_TharbekAnnoyed02, udg_Player_Actual, 0)
    call TriggerSleepAction(0.01)
    // //
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call CreateNUnitsAtLoc(1, 'o608', Player(0), GetRectCenter(gg_rct_CreateTharbek), 266.84)
    set udg_SemiHero_Tharbek=GetLastCreatedUnit()
    call SetUnitColor(udg_SemiHero_Tharbek, PLAYER_COLOR_MAROON)
    call UnitAddItemByIdSwapped('ankh', udg_SemiHero_Tharbek)
    call ShowUnitHide(udg_SemiHero_Tharbek)
    call PauseUnitBJ(true, udg_SemiHero_Tharbek)
    // //
    call CreateNUnitsAtLoc(1, 'O61E', Player(0), GetRectCenter(gg_rct_CreateNekros), 25.31)
    set udg_Hero_Necros=GetLastCreatedUnit()
    call SelectHeroSkill(udg_Hero_Necros, 'XAN1')
    call UnitAddItemByIdSwapped('X004', udg_Hero_Necros)
    call UnitAddItemByIdSwapped('I60U', udg_Hero_Necros)
    set udg_Item_DragonSoulActive=GetLastCreatedItem()
    call ShowUnitHide(udg_Hero_Necros)
    call PauseUnitBJ(true, udg_Hero_Necros)
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_ZuluhedArrivesInCamp01), 90.00)
    call SetUnitOwner(udg_Hero_Zuluhed, udg_Player_CinematicDragonMaw, true)
    call ShowUnitHide(udg_Hero_Zuluhed)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_ZuluhedArrivesInCamp01), 90.00)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeNekros, GetRectCenter(gg_rct_CreateNekros), 322.34)
    call SetUnitAnimation(udg_FakeNekros, "cinematic listening one")
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeTharbek, GetRectCenter(gg_rct_CreateTharbek), 270.00)
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
    // //
    call PauseUnitBJ(true, gg_unit_n001_0064)
    call SetUnitAnimation(gg_unit_n001_0064, "sleep")
    call SetUnitInvulnerable(gg_unit_n001_0064, true)
    // //
    call PauseUnitBJ(true, gg_unit_nogo_0053)
    call SetUnitAnimation(gg_unit_nogo_0053, "sleep")
    call SetUnitInvulnerable(gg_unit_nogo_0053, true)
    // //
    call PauseUnitBJ(true, gg_unit_nogo_0312)
    call SetUnitAnimation(gg_unit_nogo_0312, "sleep")
    call SetUnitInvulnerable(gg_unit_nogo_0312, true)
    // //
    call PauseUnitBJ(true, gg_unit_nogo_0314)
    call SetUnitAnimation(gg_unit_nogo_0314, "sleep")
    call SetUnitInvulnerable(gg_unit_nogo_0314, true)
    // //
    call PauseUnitBJ(true, gg_unit_nogo_0263)
    call SetUnitAnimation(gg_unit_nogo_0263, "sleep")
    call SetUnitInvulnerable(gg_unit_nogo_0263, true)
    // //
    call PauseUnitBJ(true, gg_unit_n001_0310)
    call SetUnitAnimation(gg_unit_n001_0310, "sleep")
    call SetUnitInvulnerable(gg_unit_n001_0310, true)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Camp_Cinematic_Setup_Func068A)
    // /
    set udg_Bool_DungeonAreaPlayable=false
    // /
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_CameraBoundsDungeon), function Trig_Camp_Cinematic_Setup_Func073A)
    call DisableTrigger(gg_trg_Goblin_PuzzleB_StateRoll)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_DungeonBossfightZone), function Trig_Camp_Cinematic_Setup_Func076A)
    // /
    // /
    call SetAmbientNightSound("BarrensNight")
    call SetAmbientDaySound("BarrensDay")
    call EnableDawnDusk(true)
    call VolumeGroupResetBJ()
    // /
    call SetDayNightModels("Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdl", "Environment\\DNC\\DNCLordaeron\\DNCLordaeronUnit\\DNCLordaeronUnit.mdl")
    // /
    call SetTerrainFogExBJ(0, 1200.00, 8500.00, 0.10, 85.00, 45.00, 14.00)
    // //
    // //
    call UseTimeOfDayBJ(true)
    call SetTimeOfDay(10.00)
    call SetSkyModel("Environment\\Sky\\BarrensSky\\BarrensSky.mdl")
    // /
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 70.00)
    // /
    // /
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Camp_Cinematic_Setup takes nothing returns nothing
    set gg_trg_Camp_Cinematic_Setup=CreateTrigger()
    call TriggerAddAction(gg_trg_Camp_Cinematic_Setup, function Trig_Camp_Cinematic_Setup_Actions)
endfunction

//===========================================================================
// Trigger: Camp Cinematic Skipped
//===========================================================================
function Trig_Camp_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinCampOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Bool_CinematicSkipped=true
    set udg_Bool_CinCampSkipped=true
    // //
    call ConditionalTriggerExecute(gg_trg_Camp_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Camp_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Camp_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Camp_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Camp_Cinematic_Skipped, Condition(function Trig_Camp_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Camp_Cinematic_Skipped, function Trig_Camp_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Camp Cinematic Cleanup
//===========================================================================
function Trig_Camp_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Cleanup_Func006C takes nothing returns boolean
    if ( not ( udg_Bool_CinCampSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Cleanup_Func018002 takes nothing returns nothing
    call SetUnitOwner(GetEnumUnit(), udg_Player_Actual, false)
endfunction

function Trig_Camp_Cinematic_Cleanup_Func028C takes nothing returns boolean
    if ( not ( GetPlayerState(Player(0), PLAYER_STATE_RESOURCE_GOLD) < 2000 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Cleanup_Func029C takes nothing returns boolean
    if ( not ( GetPlayerState(Player(0), PLAYER_STATE_RESOURCE_LUMBER) < 400 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Cleanup_Func055C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Camp_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
        call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_SNOW, false)
    endif
    // ----------------------------------------
    set udg_Bool_CinCampOn=false
    // //
    if ( Trig_Camp_Cinematic_Cleanup_Func006C() ) then
        call StopSoundBJ(gg_snd_Orc2, false)
        call StopSoundBJ(gg_snd_DarkAgents, false)
        call StopSoundBJ(gg_snd_WC2Orc06STharbek1, false)
        call StopSoundBJ(gg_snd_WC2Orc06STharbek2, false)
        call StopSoundBJ(gg_snd_WC2Orc06STharbek3, false)
        call StopSoundBJ(gg_snd_WC2Orc06STharbek4, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros3, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros4, false)
        call StopSoundBJ(gg_snd_WC2Orc06SNekros5, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_Camp1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_Camp2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_Camp3, false)
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call SetUnitPositionLoc(udg_Hero_Necros, GetRectCenter(gg_rct_CreateNekros))
    call ShowUnitShow(udg_Hero_Necros)
    call PauseUnitBJ(false, udg_Hero_Necros)
    // //
    call ShowUnitShow(udg_SemiHero_Tharbek)
    call PauseUnitBJ(false, udg_SemiHero_Tharbek)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_Orc_Camp, udg_Player_CinematicDragonMaw), function Trig_Camp_Cinematic_Cleanup_Func018002)
    // //
    call SetUnitOwner(gg_unit_nmrm_0179, Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    call SetUnitOwner(gg_unit_nmrl_0097, Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    call SetUnitOwner(gg_unit_nmrr_0105, Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    call SetUnitOwner(gg_unit_nmrl_0184, Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    call SetUnitOwner(gg_unit_nmrl_0180, Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    call SetUnitOwner(gg_unit_nmrr_0181, Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_MountWallpaper01)
    // //
    if ( Trig_Camp_Cinematic_Cleanup_Func028C() ) then
        call AdjustPlayerStateBJ(2000, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
    else
    endif
    if ( Trig_Camp_Cinematic_Cleanup_Func029C() ) then
        call AdjustPlayerStateBJ(400, udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER)
    else
    endif
    call playerAddOil(Player(0) , 1000)
    // //
    call IssueTargetDestructableOrder(gg_unit_o61Z_0159, "harvest", gg_dest_CTtr_5620)
    call IssueTargetDestructableOrder(gg_unit_o61Z_0553, "harvest", gg_dest_CTtr_5620)
    call IssueTargetDestructableOrder(gg_unit_o61Z_0336, "harvest", gg_dest_CTtr_5620)
    // //
    call IssueTargetOrderBJ(gg_unit_o61Z_0211, "harvest", gg_unit_ngol_0049)
    call IssueTargetOrderBJ(gg_unit_o61Z_0065, "harvest", gg_unit_ngol_0049)
    call IssueTargetOrderBJ(gg_unit_o61Z_0257, "harvest", gg_unit_ngol_0049)
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_RTSStart), 0)
    // /
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_CameraBoundsRTS)
    // /
    call BlzChangeMinimapTerrainTex("MinimapRedridge.tga")
    call TriggerSleepAction(0.25)
    // /
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCInematicCleanUp)
    call ConditionalTriggerExecute(gg_trg_Dwarves_AI_Start)
    // //
    call SelectUnitSingle(udg_Hero_Necros)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Camp_Cinematic_Cleanup_Func055C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Camp_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_PlaylistRTS)
    // //
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    // //
    call QueuedTriggerAddBJ(gg_trg_Mother_Discover_Q, true)
    call StartTimerBJ(udg_Timer_OgresDiscoverDelay, false, 60.00)
endfunction

//===========================================================================
function InitTrig_Camp_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Camp_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Camp_Cinematic_Cleanup, function Trig_Camp_Cinematic_Cleanup_Actions)
endfunction

