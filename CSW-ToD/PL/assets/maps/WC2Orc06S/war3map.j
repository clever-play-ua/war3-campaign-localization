//===========================================================================
function Trig_AlexRaid_FightAction_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_AlextrazaInRaid == true ) ) then
        return false
    endif
    if ( not ( GetAttacker() == udg_Hero_Alextrasza ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetAttackedUnitBJ()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

