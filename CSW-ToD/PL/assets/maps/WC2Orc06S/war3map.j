    set gg_trg_FireLord_WeakRunes_Create2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_FireLord_WeakRunes_Create2, EVENT_PLAYER_UNIT_DAMAGED)
