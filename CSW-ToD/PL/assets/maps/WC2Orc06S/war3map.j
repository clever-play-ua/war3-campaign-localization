function InitTrig_Goblins_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Goblins_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Goblins_Cinematic_Cleanup, function Trig_Goblins_Cinematic_Cleanup_Actions)
endfunction

