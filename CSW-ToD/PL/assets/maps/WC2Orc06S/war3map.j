function InitTrig_Dragon_ZuluhedTornado_End takes nothing returns nothing
    set gg_trg_Dragon_ZuluhedTornado_End=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Dragon_ZuluhedTornado_End, gg_rct_WhirlWindOut)
    call TriggerAddCondition(gg_trg_Dragon_ZuluhedTornado_End, Condition(function Trig_Dragon_ZuluhedTornado_End_Conditions))
    call TriggerAddAction(gg_trg_Dragon_ZuluhedTornado_End, function Trig_Dragon_ZuluhedTornado_End_Actions)
endfunction

