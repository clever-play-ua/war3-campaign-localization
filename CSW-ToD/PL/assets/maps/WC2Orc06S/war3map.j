endfunction

function Trig_FireLord_StrongRunes_Create_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // LocateZuluhed
    // //
    if ( Trig_FireLord_StrongRunes_Create_Func006C() ) then
        set udg_Int_SpawnRuneStrongRangeStart=1
        set udg_Int_SpawnRuneStrongRangeEnd=9
    else
        if ( Trig_FireLord_StrongRunes_Create_Func006Func003C() ) then
            set udg_Int_SpawnRuneStrongRangeStart=10
            set udg_Int_SpawnRuneStrongRangeEnd=13
        else
            if ( Trig_FireLord_StrongRunes_Create_Func006Func003Func003C() ) then
                set udg_Int_SpawnRuneStrongRangeStart=14
                set udg_Int_SpawnRuneStrongRangeEnd=16
            else
                if ( Trig_FireLord_StrongRunes_Create_Func006Func003Func003Func003C() ) then
                    set udg_Int_SpawnRuneStrongRangeStart=17
                    set udg_Int_SpawnRuneStrongRangeEnd=18
                else
                    call DoNothing()
                endif
            endif
        endif
    endif
    // //
    // //
    // SpawnStrongRune
    // //
    set bj_forLoopAIndex=udg_Int_SpawnRuneStrongRangeStart
    set bj_forLoopAIndexEnd=udg_Int_SpawnRuneStrongRangeEnd
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        // //
        // Define Type of Rune
        // //
        call ConditionalTriggerExecute(gg_trg_StrongRune_SetChance)
        // //
        // //
        call CreateItemLoc(udg_ItemType_RuneStrongLavaLake, udg_Point_LavaLakeStrongRuneSpawn[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call EnableTrigger(gg_trg_FireLord_StrongRunes_Remove)
    // //
endfunction

//===========================================================================
function InitTrig_FireLord_StrongRunes_Create takes nothing returns nothing
    set gg_trg_FireLord_StrongRunes_Create=CreateTrigger()
    call DisableTrigger(gg_trg_FireLord_StrongRunes_Create)
    call TriggerRegisterTimerEventPeriodic(gg_trg_FireLord_StrongRunes_Create, 1.00)
    call TriggerAddCondition(gg_trg_FireLord_StrongRunes_Create, Condition(function Trig_FireLord_StrongRunes_Create_Conditions))
    call TriggerAddAction(gg_trg_FireLord_StrongRunes_Create, function Trig_FireLord_StrongRunes_Create_Actions)
endfunction

