//===========================================================================
// Trigger: Goblin PuzzleB Disable
//===========================================================================
function Trig_Goblin_PuzzleB_Disable_Conditions takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(gg_dest_DTfx_10251) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_PuzzleB_Disable_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Goblin_PuzzleB_Regions)
    call DisableTrigger(gg_trg_Goblin_PuzzleB_StateRoll)
    call PlaySoundAtPointBJ(gg_snd_Switch, 100, GetRectCenter(gg_rct_FootSwitchB_Disable), 0)
    call KillDestructable(gg_dest_DTfx_10251)
    call SetDoodadAnimationRectBJ("death", 'YOf2', gg_rct_LavaTrap02)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=28
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Bool_PuzzleBFlamesActiveArr[GetForLoopIndexA()]=false
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call PolledWait(2)
    // Twice because some flames need time
    call SetDoodadAnimationRectBJ("death", 'YOf2', gg_rct_LavaTrap02)
endfunction

