//===========================================================================
// Trigger: Goblin TrainCart Load
//===========================================================================
function Trig_Goblin_TrainCart_Load_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_ZuluhedInTrain == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CartUnlocked == true ) ) then
        return false
    endif
    if ( not ( GetTransportUnitBJ() == udg_Unit_GoblinTrainCart ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_TrainCart_Load_Func014C takes nothing returns boolean
    if ( not ( udg_Bool_TrainInGoblinTown == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_TrainCart_Load_Actions takes nothing returns nothing
    set udg_Bool_ZuluhedInTrain=true
    // //
    call BlzSetUnitBooleanFieldBJ(udg_Unit_GoblinTrainCart, UNIT_BF_IS_A_BUILDING, false)
    // //
    call AddSpecialEffectTargetUnitBJ("origin", udg_Unit_GoblinTrainCart, "CSW\\Units\\Orc\\Zuluhed\\ZuluhedNoGlow.mdx")
    set udg_SE_ZuluhedCartPassenger=GetLastCreatedEffectBJ()
    // //
    call BlzSetSpecialEffectColorByPlayer(udg_SE_ZuluhedCartPassenger, Player(21))
    call BlzSetSpecialEffectScale(udg_SE_ZuluhedCartPassenger, 2.00)
    call BlzSpecialEffectAddSubAnimation(udg_SE_ZuluhedCartPassenger, SUBANIM_TYPE_READY)
    call BlzPlaySpecialEffect(udg_SE_ZuluhedCartPassenger, ANIM_TYPE_STAND)
    // //
    // //
    if ( Trig_Goblin_TrainCart_Load_Func014C() ) then
        call ConditionalTriggerExecute(gg_trg_Goblin_TrainCart_TravelFromTown)
    else
        call ConditionalTriggerExecute(gg_trg_Goblin_TrainCart_TravelToTown)
    endif
endfunction

//===========================================================================
function InitTrig_Goblin_TrainCart_Load takes nothing returns nothing
    set gg_trg_Goblin_TrainCart_Load=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Goblin_TrainCart_Load, EVENT_PLAYER_UNIT_LOADED)
    call TriggerAddCondition(gg_trg_Goblin_TrainCart_Load, Condition(function Trig_Goblin_TrainCart_Load_Conditions))
    call TriggerAddAction(gg_trg_Goblin_TrainCart_Load, function Trig_Goblin_TrainCart_Load_Actions)
endfunction

