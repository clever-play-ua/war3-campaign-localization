//===========================================================================
function Trig_StrongRune_SetChance_Func004Func003Func001Func002Func002Func002C takes nothing returns boolean
    if ( not ( udg_Int_ChanceTypeRuneStrong == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StrongRune_SetChance_Func004Func003Func001Func002Func002C takes nothing returns boolean
    if ( not ( udg_Int_ChanceTypeRuneStrong == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StrongRune_SetChance_Func004Func003Func001Func002C takes nothing returns boolean
    if ( not ( udg_Int_ChanceTypeRuneStrong == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StrongRune_SetChance_Func004Func003Func001C takes nothing returns boolean
    if ( not ( udg_Int_ChanceTypeRuneStrong == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StrongRune_SetChance_Func004Func003C takes nothing returns boolean
    if ( not ( udg_Int_ChanceTypeRuneStrong == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StrongRune_SetChance_Func004C takes nothing returns boolean
    if ( not ( udg_Int_ChanceTypeRuneStrong == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StrongRune_SetChance_Actions takes nothing returns nothing
    // //
    set udg_Int_ChanceTypeRuneStrong=GetRandomInt(1, 6)
    // //
    if ( Trig_StrongRune_SetChance_Func004C() ) then
        set udg_ItemType_RuneStrongLavaLake='rhe3'
    else
        if ( Trig_StrongRune_SetChance_Func004Func003C() ) then
            set udg_ItemType_RuneStrongLavaLake='rhe1'
        else
            if ( Trig_StrongRune_SetChance_Func004Func003Func001C() ) then
                set udg_ItemType_RuneStrongLavaLake='rma2'
            else
                if ( Trig_StrongRune_SetChance_Func004Func003Func001Func002C() ) then
                    set udg_ItemType_RuneStrongLavaLake='rres'
                else
                    if ( Trig_StrongRune_SetChance_Func004Func003Func001Func002Func002C() ) then
                        set udg_ItemType_RuneStrongLavaLake='rman'
                    else
                        if ( Trig_StrongRune_SetChance_Func004Func003Func001Func002Func002Func002C() ) then
                            set udg_ItemType_RuneStrongLavaLake='rspd'
                        else
                            call DoNothing()
                        endif
                    endif
                endif
            endif
        endif
    endif
endfunction

