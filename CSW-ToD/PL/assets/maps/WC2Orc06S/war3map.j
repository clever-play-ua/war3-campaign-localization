//===========================================================================
// Trigger: DarkIron03 Ghosts
//===========================================================================
function Trig_DarkIron03_Ghosts_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    return true
endfunction

function Trig_DarkIron03_Ghosts_Func010C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_DarkIron03_Ghosts_Func014Func003C takes nothing returns boolean
    if ( ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return true
    endif
    if ( ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return true
    endif
    return false
endfunction

function Trig_DarkIron03_Ghosts_Func014C takes nothing returns boolean
    if ( not Trig_DarkIron03_Ghosts_Func014Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_DarkIron03_Ghosts_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(0.50)
    // //
    call KillDestructable(gg_dest_B02I_9891)
    // //
    call PolledWait(0.25)
    // //
    if ( Trig_DarkIron03_Ghosts_Func010C() ) then
        call DoNothing()
    else
        call KillDestructable(gg_dest_B02K_9892)
    endif
    // //
    call PolledWait(0.50)
    // //
    if ( Trig_DarkIron03_Ghosts_Func014C() ) then
        call KillDestructable(gg_dest_B02J_9893)
    else
        call DoNothing()
    endif
    // //
    call PolledWait(10.00)
    call SetUnitBlendTimeBJ(udg_Unit_DraugrArr[2], 0.50)
    call ResetUnitAnimation(udg_Unit_DraugrArr[2])
    call PolledWait(0.50)
    call PauseUnitBJ(false, udg_Unit_DraugrArr[2])
    call SetUnitBlendTimeBJ(udg_Unit_DraugrArr[2], 0.15)
    call ReplaceUnitBJ(udg_Unit_DraugrArr[2], 'n02P', bj_UNIT_STATE_METHOD_RELATIVE)
    // //
    call ConditionalTriggerExecute(gg_trg_DarkIron_Skeleton_Sound)
endfunction

//===========================================================================
function InitTrig_DarkIron03_Ghosts takes nothing returns nothing
    set gg_trg_DarkIron03_Ghosts=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_DarkIron03_Ghosts, gg_rct_ActivateGhosts01)
    call TriggerAddCondition(gg_trg_DarkIron03_Ghosts, Condition(function Trig_DarkIron03_Ghosts_Conditions))
    call TriggerAddAction(gg_trg_DarkIron03_Ghosts, function Trig_DarkIron03_Ghosts_Actions)
endfunction

