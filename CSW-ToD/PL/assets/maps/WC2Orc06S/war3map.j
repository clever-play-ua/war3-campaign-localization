//===========================================================================
// Trigger: DarkIron15 DraugrsExit
//===========================================================================
function Trig_DarkIron15_DraugrsExit_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(udg_Hero_Zuluhed, 'I003') == true ) ) then
        return false
    endif
    if ( not ( udg_Int_CounterRings >= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DarkIron15_DraugrsExit_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetUnitBlendTimeBJ(udg_Unit_DraugrArr[3], 0.50)
    call SetUnitBlendTimeBJ(udg_Unit_DraugrArr[4], 0.50)
    call ResetUnitAnimation(udg_Unit_DraugrArr[3])
    call ResetUnitAnimation(udg_Unit_DraugrArr[4])
    // //
    call PolledWait(0.50)
    // //
    call ConditionalTriggerExecute(gg_trg_DarkIron_Skeleton_Sound)
    // //
    call PauseUnitBJ(false, udg_Unit_DraugrArr[3])
    call PauseUnitBJ(false, udg_Unit_DraugrArr[4])
    call SetUnitBlendTimeBJ(udg_Unit_DraugrArr[3], 0.15)
    call SetUnitBlendTimeBJ(udg_Unit_DraugrArr[4], 0.15)
    call ReplaceUnitBJ(udg_Unit_DraugrArr[3], 'n02P', bj_UNIT_STATE_METHOD_RELATIVE)
    call ReplaceUnitBJ(udg_Unit_DraugrArr[4], 'n02P', bj_UNIT_STATE_METHOD_RELATIVE)
    // //
    call EnableTrigger(gg_trg_DarkIron_TreasuryOpen)
endfunction

