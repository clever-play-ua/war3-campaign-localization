function Trig_Goblin_TrainCart_RightClick_Conditions takes nothing returns boolean
    if ( not ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
        return false
    endif
    if ( not ( GetOrderedUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    if ( not ( GetOrderTargetUnit() == udg_Unit_GoblinTrainCart ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_Zuluhed), GetUnitLoc(udg_Unit_GoblinTrainCart)) <= 200.00 ) ) then
        return false
    endif
    return true
endfunction

