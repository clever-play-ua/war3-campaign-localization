function InitTrig_Goblin_PuzzleB_StateRoll takes nothing returns nothing
    set gg_trg_Goblin_PuzzleB_StateRoll=CreateTrigger()
    call TriggerAddCondition(gg_trg_Goblin_PuzzleB_StateRoll, Condition(function Trig_Goblin_PuzzleB_StateRoll_Conditions))
    call TriggerAddAction(gg_trg_Goblin_PuzzleB_StateRoll, function Trig_Goblin_PuzzleB_StateRoll_Actions)
