//===========================================================================
// Trigger: Dwarves Encounter1
//===========================================================================
function Trig_Dwarves_Encounter1_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(0) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(GetEnteringUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsQuestDiscovered(udg_OQ_Dwarves) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_OQ_Dwarves) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dwarves_Encounter1_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_Dwarves_Encounter1_Q, true)
endfunction

