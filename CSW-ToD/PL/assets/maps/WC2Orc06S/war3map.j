//===========================================================================
// Trigger: AlexRaid End
//===========================================================================
function Trig_AlexRaid_End_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Hero_Alextrasza ) ) then
        return false
    endif
    return true
endfunction

function Trig_AlexRaid_End_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_BossFightAlextraza == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AlexRaid_End_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_AlexRaid_Cancel)
    if ( Trig_AlexRaid_End_Func003C() ) then
        call StartTimerBJ(udg_Timer_AlextrasaRaidPaused, false, GetRandomReal(240.00, 360.00))
    else
    endif
    call ConditionalTriggerExecute(gg_trg_AlexRaid_ShieldOff)
    call PolledWait(1.00)
    call IssueImmediateOrderBJ(udg_Hero_Alextrasza, "holdposition")
    call RemoveWeatherEffectBJ(udg_Weather_AlextraszaWind)
endfunction

