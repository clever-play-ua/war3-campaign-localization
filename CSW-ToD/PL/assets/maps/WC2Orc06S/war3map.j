//===========================================================================
// Trigger: BladeDamageDefaultSpeed
//===========================================================================
function Trig_BladeDamageDefaultSpeed_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_BladeActivated == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BladeDamageDefaultSpeed_Func002001002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_BladeDamageDefaultSpeed_Func002Func003C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BladeDamageDefaultSpeed_Func002A takes nothing returns nothing
    call SetUnitLifeBJ(GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnumUnit()) - I2R(udg_Int_BladeDamage) ))
    call ConditionalTriggerExecute(gg_trg_BladeDamageFloaty)
    if ( Trig_BladeDamageDefaultSpeed_Func002Func003C() ) then
        call AddSpecialEffectTargetUnitBJ("chest", GetEnumUnit(), "Objects\\Spawnmodels\\Other\\BeastmasterBlood\\BeastmasterBlood.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
endfunction

function Trig_BladeDamageDefaultSpeed_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_ChopperDamageArea, Condition(function Trig_BladeDamageDefaultSpeed_Func002001002)), function Trig_BladeDamageDefaultSpeed_Func002A)
endfunction

