function Trig_FireLord_StrongRunes_Remove_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightFireLord == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( udg_Int_LavaPuzzleLevel > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireLord_StrongRunes_Remove_Func003Func001002 takes nothing returns nothing
    call RemoveItem(GetEnumItem())
endfunction

function Trig_FireLord_StrongRunes_Remove_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_FireLord_StrongRunes_Create)
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=18
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call EnumItemsInRectBJ(RectFromCenterSizeBJ(udg_Point_LavaLakeStrongRuneSpawn[GetForLoopIndexB()], 128.00, 128.00), function Trig_FireLord_StrongRunes_Remove_Func003Func001002)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
endfunction

