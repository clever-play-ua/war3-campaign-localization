//===========================================================================
function InitTrig_Intro_Cinematic_Q takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Q, function Trig_Intro_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Skipped
//===========================================================================
function Trig_Intro_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinematicSkipped=true
    set udg_Bool_CinIntroSkipped=true
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Intro_Cinematic_Skipped, Condition(function Trig_Intro_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_Skipped, function Trig_Intro_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Cleanup
//===========================================================================
function Trig_Intro_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func018C takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func028002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_Cleanup_Func043C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set udg_Bool_CinIntroOn=false
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call SetTerrainFogExBJ(0, 1000.00, 6500.00, 0.50, 40.00, 10.00, 5.00)
    call SetSkyModel(null)
    call SetTimeOfDay(0.00)
    call UseTimeOfDayBJ(false)
    call SetDayNightModels("", "")
    // //
    call SetAmbientNightSound("DungeonNight")
    call EnableDawnDusk(false)
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func018C() ) then
        call StopSoundBJ(gg_snd_CS_orc3_outro_zepp, false)
        call StopSoundBJ(gg_snd_ZeppelinPropellerBlades, false)
        call StopSoundBJ(gg_snd_DeathwingLand, false)
        call StopSoundBJ(gg_snd_DeathwingRoar, false)
        call StopSoundBJ(gg_snd_DeathwingTakeoff, false)
        call StopSoundBJ(gg_snd_DeathwingWind, false)
        call StopSoundBJ(gg_snd_DarkAgents, false)
        call StopSoundBJ(gg_snd_Tension, false)
        call StopSoundBJ(gg_snd_Mainscreen, false)
        call StopSoundBJ(gg_snd_Demonic_Theme_2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed3, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed4, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed5, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed6, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing3, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing3a, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing4, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing4a, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing5, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing5a, false)
        call StopSoundBJ(gg_snd_WC2Orc06SDeathwing6, false)
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call ShowUnitHide(udg_Hero_Deathwing)
    call RemoveUnit(udg_Unit_DeathwingFlyingCinematic)
    call RemoveUnit(gg_unit_h000_0358)
    call UnitAddAbilityBJ('AS62', udg_Hero_Zuluhed)
    call RemoveLocation(udg_Point_ZepelinTemp)
    call RemoveLocation(udg_Point_ZuluhedCinTemp)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Intro_Cinematic_Cleanup_Func028002)
    call GroupRemoveGroup(udg_Group_HiddenUnits, udg_Group_HiddenUnits)
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_CameraBoundsDungeon)
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_StartGame), 0)
    // //
    call BlzChangeMinimapTerrainTex("MinimapDungeonA.tga")
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCInematicCleanUp)
    call SelectUnitForPlayerSingle(udg_Hero_Zuluhed, udg_Player_Actual)
    call IssuePointOrderLocBJ(udg_Hero_Zuluhed, "move", GetRectCenter(gg_rct_ZuluhedWalksIntoCavern))
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func043C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Dragon_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

