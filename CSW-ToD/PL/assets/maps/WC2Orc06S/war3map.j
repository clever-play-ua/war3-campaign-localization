//===========================================================================
// Trigger: Goblin PuzzleA Prepare
//===========================================================================
function Trig_Goblin_PuzzleA_Prepare_Func009Func003001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n034' )
endfunction

function Trig_Goblin_PuzzleA_Prepare_Func009Func003002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Goblin_PuzzleA_Prepare_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetDoodadAnimationRectBJ("death", 'OOgr', gg_rct_DWRuinVisibility01)
    // //
    call DestructableRestoreLife(gg_dest_DTfx_9911, GetDestructableMaxLife(gg_dest_DTfx_9911), true)
    // //
    call SetDoodadAnimationRectBJ("stand", 'YOf2', gg_rct_LavaTrap01)
    call SetDoodadAnimationRectBJ("morph", 'D646', gg_rct_LavaTrap01)
    call PolledWait(4.77)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetDoodadAnimationRectBJ("stand", 'YOf2', udg_Region_GoblinPuzzleARedArr[GetForLoopIndexA()])
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(udg_Region_GoblinPuzzleARedArr[GetForLoopIndexA()], Condition(function Trig_Goblin_PuzzleA_Prepare_Func009Func003001002)), function Trig_Goblin_PuzzleA_Prepare_Func009Func003002)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call EnableTrigger(gg_trg_Goblin_PuzzleA_Disable)
    call ConditionalTriggerExecute(gg_trg_Goblin_PuzzleA_Loop)
endfunction

//===========================================================================
