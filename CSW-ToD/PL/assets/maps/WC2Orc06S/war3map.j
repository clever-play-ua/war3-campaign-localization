//===========================================================================
// Trigger: Goblin PuzzleB StateRoll
//===========================================================================
function Trig_Goblin_PuzzleB_StateRoll_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_DungeonAreaPlayable == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_PuzzleB_StateRoll_Actions takes nothing returns nothing
    // Start
    call Goblin_PuzzleB_StateRoll_SetFire(15 , 1)
    // //
    // Left/Up/Right
    call Goblin_PuzzleB_StateRoll_SetFire(16 , 2)
    call Goblin_PuzzleB_StateRoll_SetFire(17 , 3)
    call Goblin_PuzzleB_StateRoll_SetFire(18 , 4)
    // Up
    call Goblin_PuzzleB_StateRoll_SetFire(19 , 5)
    // Left/Up/Right
    call Goblin_PuzzleB_StateRoll_SetFire(20 , 6)
    call Goblin_PuzzleB_StateRoll_SetFire(21 , 7)
    call Goblin_PuzzleB_StateRoll_SetFire(22 , 8)
    // Right
    call Goblin_PuzzleB_StateRoll_SetFire(23 , 9)
    // //
    // Down
    call Goblin_PuzzleB_StateRoll_SetFire(24 , 10)
    call Goblin_PuzzleB_StateRoll_SetFire(25 , 11)
    call Goblin_PuzzleB_StateRoll_SetFire(26 , 12)
    // //
    // Right
    call Goblin_PuzzleB_StateRoll_SetFire(27 , 13)
    call Goblin_PuzzleB_StateRoll_SetFire(28 , 14)
    call Goblin_PuzzleB_StateRoll_SetFire(1 , 15)
    call Goblin_PuzzleB_StateRoll_SetFire(2 , 16)
    // //
    // Up
    call Goblin_PuzzleB_StateRoll_SetFire(3 , 17)
    // //
    // Left
    call Goblin_PuzzleB_StateRoll_SetFire(4 , 18)
    call Goblin_PuzzleB_StateRoll_SetFire(5 , 19)
    call Goblin_PuzzleB_StateRoll_SetFire(6 , 20)
    // //
    // Up
    call Goblin_PuzzleB_StateRoll_SetFire(7 , 21)
    call Goblin_PuzzleB_StateRoll_SetFire(8 , 22)
    // //
    // Right/Down
    call Goblin_PuzzleB_StateRoll_SetFire(9 , 23)
    call Goblin_PuzzleB_StateRoll_SetFire(10 , 24)
    // Right
    call Goblin_PuzzleB_StateRoll_SetFire(11 , 25)
    call Goblin_PuzzleB_StateRoll_SetFire(12 , 26)
    // //
    // Up/Left
    call Goblin_PuzzleB_StateRoll_SetFire(13 , 27)
    call Goblin_PuzzleB_StateRoll_SetFire(14 , 28)
    // //
    // Loop
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

