//===========================================================================
// Trigger: Goblins Cinematic Cleanup
//===========================================================================
function Trig_Goblins_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblins_Cinematic_Cleanup_Func005C takes nothing returns boolean
    if ( not ( udg_Bool_CinGoblinsSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblins_Cinematic_Cleanup_Func028C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblins_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Goblins_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set udg_Bool_CinGoblinsOn=false
    if ( Trig_Goblins_Cinematic_Cleanup_Func005C() ) then
        call StopSoundBJ(gg_snd_DarkAgents, false)
        call StopSoundBJ(gg_snd_WC2Orc06SVincentGoblin_GoblinMeet1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SVincentGoblin_GoblinMeet2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SVincentGoblin_GoblinMeet3, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_GoblinMeet1, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_GoblinMeet2, false)
        call StopSoundBJ(gg_snd_WC2Orc06SZuluhed_GoblinMeet3, false)
    else
        call DoNothing()
    endif
    // //
    call ShowDestructableBJ(false, gg_dest_B02E_10477)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuluhed, GetRectCenter(gg_rct_MidCinGoblinsZuluhed03), 156.76)
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    // //
    call RemoveDestructable(gg_dest_B01L_10474)
    call ShowUnitShow(udg_Hero_VincentTurnCoat)
    call PauseUnitBJ(false, udg_Hero_VincentTurnCoat)
    call SetUnitFacingToFaceUnitTimed(udg_Hero_VincentTurnCoat, udg_Hero_Zuluhed, 0)
    call UnitAddAbilityBJ('Aneu', udg_Hero_VincentTurnCoat)
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetUnitLoc(udg_Hero_Zuluhed), 0)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCInematicCleanUp)
    call SelectUnitForPlayerSingle(udg_Hero_Zuluhed, udg_Player_Actual)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Goblins_Cinematic_Cleanup_Func028C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Goblins_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    call TriggerExecute(gg_trg_Goblin_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

