//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func005C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Tharbek) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    call TriggerSleepAction(0.01)
    call ShowUnitShow(udg_Hero_Zuluhed)
    call PauseUnitBJ(false, udg_Hero_Zuluhed)
    call StoreUnitBJ(udg_Hero_Zuluhed, "Zuluhed", "WC2Orc06s", udg_Cache)
    if ( Trig_Next_Level_Prep_Func005C() ) then
        call CreateNUnitsAtLoc(1, 'o608', udg_Player_Actual, GetRectCenter(gg_rct_CreateTharbek), bj_UNIT_FACING)
        set udg_SemiHero_Tharbek=GetLastCreatedUnit()
    else
        call ShowUnitShow(udg_SemiHero_Tharbek)
        call PauseUnitBJ(false, udg_SemiHero_Tharbek)
    endif
    call TriggerSleepAction(0.01)
    call StoreUnitBJ(udg_SemiHero_Tharbek, "Tharbek", "WC2Orc06s", udg_Cache)
    call StoreIntegerBJ(GetPlayerTechCountSimple('RTX2', udg_Player_Actual), "TharbekLevel", "WC2Orc06s", udg_Cache)
    call StoreBooleanBJ(true, "Completed", "WC2Orc06s", udg_Cache)
    call TriggerSleepAction(0.01)
    call SaveGameCacheBJ(udg_Cache)
    call ShowCustomCampaignButton(true, 10)
    call SetNextLevelBJ("WC2Orc07.w3x")
    // //
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CustomVictoryBJ(udg_Player_Actual, true, true)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

