//===========================================================================
// Trigger: Nekros I Cursed Ground
//
// Conditions
// (Ability being cast) Equal to Cursed Ground (Nekros)
//===========================================================================
function Trig_Nekros_I_Cursed_Ground_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'XAN4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nekros_I_Cursed_Ground_Func004002001003 takes nothing returns boolean
    return ( UnitHasBuffBJ(GetFilterUnit(), 'B00F') == true )
endfunction

function Trig_Nekros_I_Cursed_Ground_Func006002001003 takes nothing returns boolean
    return ( UnitHasBuffBJ(GetFilterUnit(), 'B00C') == true )
endfunction

function Trig_Nekros_I_Cursed_Ground_Func008002001003 takes nothing returns boolean
    return ( UnitHasBuffBJ(GetFilterUnit(), 'B008') == true )
endfunction

function Trig_Nekros_I_Cursed_Ground_Func011001003 takes nothing returns boolean
    return ( IsUnitAlly(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == false )
endfunction

function Trig_Nekros_I_Cursed_Ground_Func011Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nekros_I_Cursed_Ground_Func011A takes nothing returns nothing
    if ( Trig_Nekros_I_Cursed_Ground_Func011Func001C() ) then
        call UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), ( 200.00 + ( 50.00 * ( I2R(udg_Nekros_Ultimate_Count_Q) + ( I2R(udg_Nekros_Ultimate_Count_W) + I2R(udg_Nekros_Ultimate_Count_E) ) ) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
    else
    endif
endfunction

function Trig_Nekros_I_Cursed_Ground_Actions takes nothing returns nothing
    set udg_Nekros_TempPoint_R=GetSpellTargetLoc()
    //  
    // Buff: Seed of Corruption (Nekros)
    set udg_Nekros_Ultimate_Count_Q=CountUnitsInGroup(GetUnitsInRangeOfLocMatching(300.00, udg_Nekros_TempPoint_R, Condition(function Trig_Nekros_I_Cursed_Ground_Func004002001003)))
    // Buff: Corruption (Nekros)
    set udg_Nekros_Ultimate_Count_W=CountUnitsInGroup(GetUnitsInRangeOfLocMatching(300.00, udg_Nekros_TempPoint_R, Condition(function Trig_Nekros_I_Cursed_Ground_Func006002001003)))
    // Buff: Fear (Nekros)
    set udg_Nekros_Ultimate_Count_E=CountUnitsInGroup(GetUnitsInRangeOfLocMatching(300.00, udg_Nekros_TempPoint_R, Condition(function Trig_Nekros_I_Cursed_Ground_Func008002001003)))
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_Nekros_TempPoint_R, Condition(function Trig_Nekros_I_Cursed_Ground_Func011001003)), function Trig_Nekros_I_Cursed_Ground_Func011A)
    //  
    call RemoveLocation(udg_Nekros_TempPoint_R)
endfunction

//===========================================================================
function InitTrig_Nekros_I_Cursed_Ground takes nothing returns nothing
    set gg_trg_Nekros_I_Cursed_Ground=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Nekros_I_Cursed_Ground, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Nekros_I_Cursed_Ground, Condition(function Trig_Nekros_I_Cursed_Ground_Conditions))
    call TriggerAddAction(gg_trg_Nekros_I_Cursed_Ground, function Trig_Nekros_I_Cursed_Ground_Actions)
