    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, GetAttacker(), GetUnitTypeId(GetAttacker()), gg_snd_WC2Orc06SKobold_KoboldEncounter1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc06SZuluhed_KoboldEncounter1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

