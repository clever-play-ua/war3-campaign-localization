function Trig_Goblin_TrainCart_TravelToTown_Func003Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'Ytlc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_TrainCart_TravelToTown_Func003A takes nothing returns nothing
    if ( Trig_Goblin_TrainCart_TravelToTown_Func003Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

