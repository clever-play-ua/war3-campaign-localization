//===========================================================================
// Trigger: Init 06a Hard
//===========================================================================
function Trig_Init_06a_Hard_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_06a_Hard_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Int_BladeDamage=250
    set udg_Int_LavaDamage=200
    set udg_Real_PuzzleFlameDamage=400.00
    set udg_PuzzleFlameDamageText="400!"
    // //
    set udg_Int_DragonsAttackMaxAmount=2
    // //
    // //
    call BlzSetUnitMaxHP(udg_Hero_Alextrasza, 11000)
    call SetUnitLifePercentBJ(udg_Hero_Alextrasza, 100)
    call BlzSetUnitBaseDamage(udg_Hero_Alextrasza, 35, 0)
    // //
    call BlzSetUnitMaxHP(udg_Hero_Orastrasz, 6125)
    call SetUnitLifePercentBJ(udg_Hero_Orastrasz, 100)
    call BlzSetUnitBaseDamage(udg_Hero_Orastrasz, 30, 0)
    // //
    call BlzSetUnitMaxHP(udg_Hero_FireLord, 2100)
    call SetUnitLifeBJ(udg_Hero_FireLord, GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_FireLord))
    call SelectHeroSkill(udg_Hero_FireLord, 'ANvc')
    // //
    set udg_Int_CreepHP=75
    set udg_Int_CreepDMG=3
    // //
    set udg_Real_AlexBFWhelpSummonTime=12.00
endfunction

//===========================================================================
function InitTrig_Init_06a_Hard takes nothing returns nothing
    set gg_trg_Init_06a_Hard=CreateTrigger()
    call TriggerAddCondition(gg_trg_Init_06a_Hard, Condition(function Trig_Init_06a_Hard_Conditions))
    call TriggerAddAction(gg_trg_Init_06a_Hard, function Trig_Init_06a_Hard_Actions)
endfunction

