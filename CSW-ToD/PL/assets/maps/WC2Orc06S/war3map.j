endfunction

//===========================================================================
// Trigger: Ogres Discover Q
//===========================================================================
function Trig_Ogres_Discover_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_RedDragons, 'o608', GetCameraTargetPositionLoc(), gg_snd_WC2Orc06STharbek_OgreQuest1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Necros, 'O61E', gg_snd_WC2Orc06SNekros_OgreQuest1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestSetDiscoveredBJ(udg_OQ_Ogres, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_4291")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

