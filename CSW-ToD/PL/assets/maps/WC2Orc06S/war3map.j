function Trig_BoatActivateUnload_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Unit_ZuluhedBoat ) ) then
        return false
    endif
    if ( not ( udg_Bool_ZuluhedInBoat == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoatActivateUnload_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
