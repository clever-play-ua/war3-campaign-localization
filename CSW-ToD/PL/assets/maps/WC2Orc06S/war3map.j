    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Treasury_Cinematic_Setup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_RedDragons, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_RedDragons, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    // //
    call SetUnitOwner(udg_Unit_GoblinTrainCart, udg_Player_Goblins, true)
    // //
    call ShowDestructableBJ(true, gg_dest_B02N_12480)
    call ShowDestructableBJ(true, gg_dest_B02N_12760)
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_DarkIron), function Trig_Treasury_Cinematic_Setup_Func015A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Treasury_Cinematic_Setup_Func018001002)), function Trig_Treasury_Cinematic_Setup_Func018A)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Treasury_Cinematic_Setup_Func020002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_Treasury_Cinematic_Setup_Func021002)
    // //
    call CreateNUnitsAtLoc(1, 'ngbl', udg_Player_Actual, GetRectCenter(gg_rct_BlasterA01), 90.00)
    set udg_Unit_GoblinBlasterA=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'ngbl', udg_Player_Actual, GetRectCenter(gg_rct_BlasterB01), 90.00)
    set udg_Unit_GoblinBlasterB=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'ngbl', udg_Player_Actual, GetRectCenter(gg_rct_BlasterC01), 90.00)
    set udg_Unit_GoblinBlasterC=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'ngbl', udg_Player_Actual, GetRectCenter(gg_rct_BlasterD01), 90.00)
    set udg_Unit_GoblinBlasterD=GetLastCreatedUnit()
    // //
    call RemoveItem(GetItemOfTypeFromUnitBJ(udg_Hero_Zuluhed, 'I003'))
    // //
    call ShowUnitHide(udg_Hero_Zuluhed)
    call PauseUnitBJ(true, udg_Hero_Zuluhed)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_TreasuryZuluhed00), 90.00)
    // //
    call SetDoodadAnimationRectBJ("stand", 'D6B3', gg_rct_ChamberDoor)
    // //
    call SetUnitAnimation(udg_Hero_Orastrasz, "Cinematic sleep loop")
    call SetUnitBlendTimeBJ(udg_Hero_Orastrasz, 1.00)
    // //
    call SetItemVisibleBJ(true, udg_Item_DragonSoulQuest)
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

