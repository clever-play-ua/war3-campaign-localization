//===========================================================================
// Trigger: Goblin PuzzleB Prepare
//===========================================================================
function Trig_Goblin_PuzzleB_Prepare_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ConditionalTriggerExecute(gg_trg_Goblin_PuzzleB_StateDefault)
    call SetDoodadAnimationRectBJ("morph", 'D646', gg_rct_LavaTrap02)
    call PolledWait(4.77)
    call SetDoodadAnimationRectBJ("stand alternate", 'D646', gg_rct_LavaTrap02)
    // //
    // Reset All
    call SetDoodadAnimationRectBJ("death", 'YOf2', gg_rct_LavaTrap02)
    // //
    call PolledWait(1.00)
    // //
    // InitializeSnake
    call SetDoodadAnimationRectBJ("stand", 'YOf2', gg_rct_LavaTrap02)
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_Goblin_PuzzleB_StateRoll)
    call EnableTrigger(gg_trg_Goblin_PuzzleB_Disable)
    call DestructableRestoreLife(gg_dest_DTfx_10251, GetDestructableMaxLife(gg_dest_DTfx_10251), true)
endfunction

