    if ( not ( udg_Int_ChanceGearSound == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Goblin_Gear_Sound_Actions takes nothing returns nothing
    set udg_Int_ChanceGearSound=GetRandomInt(1, 9)
    if ( Trig_Goblin_Gear_Sound_Func002C() ) then
        call PlaySoundBJ(gg_snd_SteamTankPissed1)
    else
        if ( Trig_Goblin_Gear_Sound_Func002Func003C() ) then
            call PlaySoundBJ(gg_snd_SteamTankPissed2)
        else
            if ( Trig_Goblin_Gear_Sound_Func002Func003Func003C() ) then
                call PlaySoundBJ(gg_snd_SteamTankReady1)
            else
                if ( Trig_Goblin_Gear_Sound_Func002Func003Func003Func003C() ) then
                    call PlaySoundBJ(gg_snd_SteamTankWhat1)
                else
                    if ( Trig_Goblin_Gear_Sound_Func002Func003Func003Func003Func003C() ) then
                        call PlaySoundBJ(gg_snd_SteamTankWhat2)
                    else
                        if ( Trig_Goblin_Gear_Sound_Func002Func003Func003Func003Func003Func003C() ) then
                            call PlaySoundBJ(gg_snd_SteamTankWhat3)
                        else
                            if ( Trig_Goblin_Gear_Sound_Func002Func003Func003Func003Func003Func003Func003C() ) then
                                call PlaySoundBJ(gg_snd_SteamTankYes1)
                            else
                                if ( Trig_Goblin_Gear_Sound_Func002Func003Func003Func003Func003Func003Func003Func003C() ) then
                                    call PlaySoundBJ(gg_snd_SteamTankYes2)
                                else
                                    call PlaySoundBJ(gg_snd_SteamTankYes3)
                                endif
                            endif
                        endif
                    endif
                endif
            endif
        endif
    endif
endfunction

