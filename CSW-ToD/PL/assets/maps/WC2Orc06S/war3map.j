//===========================================================================
// Trigger: Mother Alextrasza Runes Create
//===========================================================================
function Trig_Mother_Alextrasza_Runes_Create_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BossFightAlextraza == true ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Necros) <= 400.00 ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_Alextrasza_Runes_Create_Func004Func001Func001Func004002 takes nothing returns nothing
    call RemoveItem(GetEnumItem())
endfunction

function Trig_Mother_Alextrasza_Runes_Create_Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetItemType(GetEnumItem()) == ITEM_TYPE_POWERUP ) ) then
        return false
    endif
    if ( not ( GetEnumItem() != null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mother_Alextrasza_Runes_Create_Func004Func001A takes nothing returns nothing
    if ( Trig_Mother_Alextrasza_Runes_Create_Func004Func001Func001C() ) then
        call AddSpecialEffectLocBJ(udg_Point_AlexBFRuneSpawn[GetForLoopIndexA()], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
        set udg_SE_RuneWeakBFAL=GetLastCreatedEffectBJ()
        call EnumItemsInRectBJ(RectFromCenterSizeBJ(udg_Point_AlexBFRuneSpawn[GetForLoopIndexA()], 128.00, 128.00), function Trig_Mother_Alextrasza_Runes_Create_Func004Func001Func001Func004002)
        call PolledWait(0.25)
        call DestroyEffectBJ(udg_SE_RuneWeakBFAL)
    else
        call DoNothing()
    endif
endfunction

function Trig_Mother_Alextrasza_Runes_Create_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // RemoveRunes
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call EnumItemsInRectBJ(RectFromCenterSizeBJ(udg_Point_AlexBFRuneSpawn[GetForLoopIndexA()], 128.00, 128.00), function Trig_Mother_Alextrasza_Runes_Create_Func004Func001A)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    // Create Runes
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=4
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call ConditionalTriggerExecute(gg_trg_StrongRune_SetChance)
        call AddSpecialEffectLocBJ(udg_Point_AlexBFRuneSpawn[GetForLoopIndexB()], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl")
        set udg_SE_RuneWeakBFAL=GetLastCreatedEffectBJ()
        call PolledWait(0.25)
        call CreateItemLoc(udg_ItemType_RuneStrongLavaLake, udg_Point_AlexBFRuneSpawn[GetForLoopIndexB()])
        call DestroyEffectBJ(udg_SE_RuneWeakBFAL)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    // //
    call StartTimerBJ(udg_Timer_ResetRunesSpawn, false, 120.00)
endfunction

//===========================================================================
function InitTrig_Mother_Alextrasza_Runes_Create takes nothing returns nothing
    set gg_trg_Mother_Alextrasza_Runes_Create=CreateTrigger()
    call DisableTrigger(gg_trg_Mother_Alextrasza_Runes_Create)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Mother_Alextrasza_Runes_Create, 2)
    call TriggerAddCondition(gg_trg_Mother_Alextrasza_Runes_Create, Condition(function Trig_Mother_Alextrasza_Runes_Create_Conditions))
    call TriggerAddAction(gg_trg_Mother_Alextrasza_Runes_Create, function Trig_Mother_Alextrasza_Runes_Create_Actions)
endfunction

