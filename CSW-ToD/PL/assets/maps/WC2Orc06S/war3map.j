//===========================================================================
// Trigger: Init 04 Environment
//===========================================================================
function Trig_Init_04_Environment_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ShowDestructableBJ(false, gg_dest_B02Y_11537)
    // //
    call SetDayNightModels("Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdl", "Environment\\DNC\\DNCLordaeron\\DNCLordaeronUnit\\DNCLordaeronUnit.mdl")
    // //
    call KillDestructable(gg_dest_YT31_0146)
    // //
    set udg_Bool_DungeonAreaPlayable=true
    // //
    set udg_Bool_DungeonAreaPlayable=true
    // //
    call KillDestructable(gg_dest_DTfx_9911)
    call KillDestructable(gg_dest_DTfx_10251)
    // //
    call ShowDestructableBJ(false, gg_dest_B02E_10477)
    call ShowDestructableBJ(false, gg_dest_B02E_10478)
    call ShowDestructableBJ(false, gg_dest_B02N_12480)
    call ShowDestructableBJ(false, gg_dest_B02N_12760)
    call ShowDestructableBJ(false, gg_dest_B02O_12481)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_ITd2_0548, true)
    call SetDestructableInvulnerableBJ(gg_dest_ITd2_2224, true)
    // //
    call KillDestructable(gg_dest_B01L_10062)
    call KillDestructable(gg_dest_B01L_10063)
    // //
    call SetDoodadAnimationRectBJ("death", 'D039', gg_rct_GoblinTorch)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOf2', gg_rct_FiretrapsCosmetics02)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOf2', gg_rct_LavaTrap01)
    call SetDoodadAnimationRectBJ("death", 'YOf2', gg_rct_LavaTrap02)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_StoneGolem01), "sharedfx\\scarabburrow\\scarabburrow.mdl")
    set udg_SE_Dust[1]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_StoneGolem02), "sharedfx\\scarabburrow\\scarabburrow.mdl")
    set udg_SE_Dust[2]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_StoneGolem03), "sharedfx\\scarabburrow\\scarabburrow.mdl")
    set udg_SE_Dust[3]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_StoneGolem04), "sharedfx\\scarabburrow\\scarabburrow.mdl")
    set udg_SE_Dust[4]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DustFX), "sharedfx\\scarabburrow\\scarabburrow.mdl")
    set udg_SE_Dust[5]=GetLastCreatedEffectBJ()
    // //
    call SetDoodadAnimationRectBJ("death", 'OOgr', gg_rct_FlameGrate)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_DTg1_9851, true)
    // //
    // Bridges
    // //
    call KillDestructable(gg_dest_DTs2_9908)
    // //
    // Lava Lake
    // //
    set udg_Destructable_LavaPuzzle=gg_dest_B02C_10048
    // //
    set udg_Int_LavaPuzzlePreviousLevel=3
    set udg_Int_LavaPuzzleLevel=3
    call SetPlayerTechResearchedSwap('R072', 1, udg_Player_Elementals)
    call SetPlayerTechResearchedSwap('R073', 1, udg_Player_Elementals)
    // //
    // Lava Traps
    // Set Treasury Env
    // //
    call SetDoodadAnimationRectBJ("death", 'OOgr', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("death", 'LOtz', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("death alternate", 'AObr', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("death", 'D020', gg_rct_TreasuryLights)
    call SetDoodadAnimationRectBJ("death", 'ZZcd', gg_rct_DungeonBossfightZone)
    call SetDoodadAnimationRectBJ("death", 'D004', gg_rct_TreasuryLights)
    // //
    call SetDoodadAnimationRectBJ("death", 'D02J', gg_rct_DeathwingBursts)
    // //
    // Fire Puzzle A
    set udg_Region_GoblinPuzzleAGreenArr[1]=gg_rct_Goblin_PuzzleA_Green1
    set udg_Region_GoblinPuzzleAGreenArr[2]=gg_rct_Goblin_PuzzleA_Green2
    set udg_Region_GoblinPuzzleAGreenArr[3]=gg_rct_Goblin_PuzzleA_Green3
    set udg_Region_GoblinPuzzleAGreenArr[4]=gg_rct_Goblin_PuzzleA_Green4
    set udg_Region_GoblinPuzzleARedArr[1]=gg_rct_Goblin_PuzzleA_Red1
    set udg_Region_GoblinPuzzleARedArr[2]=gg_rct_Goblin_PuzzleA_Red2
    set udg_Region_GoblinPuzzleARedArr[3]=gg_rct_Goblin_PuzzleA_Red3
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Bool_PuzzleAFlamesActiveArr[GetForLoopIndexA()]=true
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // Fire Puzzle B
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=28
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Bool_PuzzleBFlamesActiveArr[GetForLoopIndexA()]=true
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set udg_Region_GoblinPuzzleBFireArr[1]=gg_rct_Goblin_PuzzleB_Fire01
    set udg_Region_GoblinPuzzleBFireArr[2]=gg_rct_Goblin_PuzzleB_Fire02
    set udg_Region_GoblinPuzzleBFireArr[3]=gg_rct_Goblin_PuzzleB_Fire03
    set udg_Region_GoblinPuzzleBFireArr[4]=gg_rct_Goblin_PuzzleB_Fire04
    set udg_Region_GoblinPuzzleBFireArr[5]=gg_rct_Goblin_PuzzleB_Fire05
    set udg_Region_GoblinPuzzleBFireArr[6]=gg_rct_Goblin_PuzzleB_Fire06
    set udg_Region_GoblinPuzzleBFireArr[7]=gg_rct_Goblin_PuzzleB_Fire07
    set udg_Region_GoblinPuzzleBFireArr[8]=gg_rct_Goblin_PuzzleB_Fire08
    set udg_Region_GoblinPuzzleBFireArr[9]=gg_rct_Goblin_PuzzleB_Fire09
    set udg_Region_GoblinPuzzleBFireArr[10]=gg_rct_Goblin_PuzzleB_Fire10
    set udg_Region_GoblinPuzzleBFireArr[11]=gg_rct_Goblin_PuzzleB_Fire11
    set udg_Region_GoblinPuzzleBFireArr[12]=gg_rct_Goblin_PuzzleB_Fire12
    set udg_Region_GoblinPuzzleBFireArr[13]=gg_rct_Goblin_PuzzleB_Fire13
    set udg_Region_GoblinPuzzleBFireArr[14]=gg_rct_Goblin_PuzzleB_Fire14
    set udg_Region_GoblinPuzzleBFireArr[15]=gg_rct_Goblin_PuzzleB_Fire15
    set udg_Region_GoblinPuzzleBFireArr[16]=gg_rct_Goblin_PuzzleB_Fire16
    set udg_Region_GoblinPuzzleBFireArr[17]=gg_rct_Goblin_PuzzleB_Fire17
    set udg_Region_GoblinPuzzleBFireArr[18]=gg_rct_Goblin_PuzzleB_Fire18
    set udg_Region_GoblinPuzzleBFireArr[19]=gg_rct_Goblin_PuzzleB_Fire19
    set udg_Region_GoblinPuzzleBFireArr[20]=gg_rct_Goblin_PuzzleB_Fire20
    set udg_Region_GoblinPuzzleBFireArr[21]=gg_rct_Goblin_PuzzleB_Fire21
    set udg_Region_GoblinPuzzleBFireArr[22]=gg_rct_Goblin_PuzzleB_Fire22
    set udg_Region_GoblinPuzzleBFireArr[23]=gg_rct_Goblin_PuzzleB_Fire23
    set udg_Region_GoblinPuzzleBFireArr[24]=gg_rct_Goblin_PuzzleB_Fire24
    set udg_Region_GoblinPuzzleBFireArr[25]=gg_rct_Goblin_PuzzleB_Fire25
    set udg_Region_GoblinPuzzleBFireArr[26]=gg_rct_Goblin_PuzzleB_Fire26
    set udg_Region_GoblinPuzzleBFireArr[27]=gg_rct_Goblin_PuzzleB_Fire27
    set udg_Region_GoblinPuzzleBFireArr[28]=gg_rct_Goblin_PuzzleB_Fire28
    // //
    // Orastrasz
    set udg_Point_RuneCreateOrastraszBF[1]=GetRectCenter(gg_rct_OrastraszRuneSpawn01)
    set udg_Point_RuneCreateOrastraszBF[2]=GetRectCenter(gg_rct_OrastraszRuneSpawn02)
    set udg_Point_RuneCreateOrastraszBF[3]=GetRectCenter(gg_rct_OrastraszRuneSpawn03)
    set udg_Point_RuneCreateOrastraszBF[4]=GetRectCenter(gg_rct_OrastraszRuneSpawn04)
    set udg_Point_RuneCreateOrastraszBF[5]=GetRectCenter(gg_rct_OrastraszRuneSpawn05)
    set udg_Point_OrastraszOpenChamber=GetRectCenter(gg_rct_OpenChamber)
    set udg_Point_AlexstraszaNestDust=GetRectCenter(gg_rct_NestDust)
    // Tunnel Teleport
    set udg_Point_TunnelTeleport[1]=GetRectCenter(gg_rct_FlameGrate)
    set udg_Point_TunnelTeleport[2]=GetRectCenter(gg_rct_Tunnell02)
    set udg_Point_TunnelTeleport[3]=GetRectCenter(gg_rct_Tunnell04)
    set udg_Point_TunnelTeleport[4]=GetRectCenter(gg_rct_Tunnell06)
    set udg_Point_TunnelTeleport[5]=GetRectCenter(gg_rct_Tunnell07)
    set udg_Point_TunnelTeleport[6]=GetRectCenter(gg_rct_Tunnell08)
    set udg_Point_TunnelTeleport[7]=GetRectCenter(gg_rct_DIDoorAction02)
    call PolledWait(1.00)
    call ChangeElevatorHeight(udg_Destructable_LavaPuzzle, udg_Int_LavaPuzzleLevel)
endfunction

