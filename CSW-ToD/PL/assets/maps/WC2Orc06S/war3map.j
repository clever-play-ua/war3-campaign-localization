function Trig_Init_02_Units_Func004002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Init_02_Units_Func017001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h00F' )
endfunction

function Trig_Init_02_Units_Func017001002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h00G' )
endfunction

function Trig_Init_02_Units_Func017001002 takes nothing returns boolean
    return GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'h00F'), (GetUnitTypeId(GetFilterUnit()) == 'h00G')) // INLINED!!
endfunction

function Trig_Init_02_Units_Func017A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DragonEggs)
endfunction

function Trig_Init_02_Units_Func019A takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), true)
endfunction

function Trig_Init_02_Units_Func212A takes nothing returns nothing
    call UnitAddAbility(GetEnumUnit(), 'Aloc')
endfunction

function Trig_Init_02_Units_Func217001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n034' )
endfunction

function Trig_Init_02_Units_Func217A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_LavaLakeDamageBottom)
    call BlzSetUnitBaseDamage(GetEnumUnit(), udg_Int_LavaDamage, 0)
    call UnitAddAbility(GetEnumUnit(), 'Aloc')
endfunction

function Trig_Init_02_Units_Func220001002 takes nothing returns boolean
