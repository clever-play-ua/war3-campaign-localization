endfunction

//===========================================================================
// Trigger: RunestoneWaterKill
//===========================================================================
function Trig_RunestoneWaterKill_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetDoodadAnimationRectBJ("death", 'XOmr', gg_rct_RuneStoneWaterEffects)
    call SetDoodadAnimationRectBJ("death", 'D60D', gg_rct_RSActivationWater)
    // //
    call RemoveUnit(gg_unit_ncop_0017)
    call SetUnitInvulnerable(gg_unit_n60R_0011, false)
    // //
    call TriggerSleepAction(1.00)
    // //
    call PlaySoundOnUnitBJ(gg_snd_BridgeDeath, 100, gg_unit_n60R_0011)
    call AddSpecialEffectTargetUnitBJ("origin", gg_unit_n60R_0011, "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    set udg_SE_WaterRSDeath=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectTargetUnitBJ("origin", gg_unit_n60R_0011, "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    set udg_SE_WaterRSExplosion=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectLocBJ(GetUnitLoc(gg_unit_n60R_0011), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
    set udg_SE_RunestoneDeathEnergyBlast=GetLastCreatedEffectBJ()
    // //
    call KillUnit(gg_unit_n60R_0011)
    // //
    call ConditionalTriggerExecute(gg_trg_RunestoneKillDecreaseBuffForElves)
    // //
    call PauseUnitBJ(false, udg_Hero_Guldan)
    // //
    call TriggerSleepAction(1.00)
    // //
    call DestroyEffectBJ(udg_SE_RunestoneDeathEnergyBlast)
    call DestroyEffectBJ(udg_SE_WaterRSDeath)
    // //
    call RemoveWeatherEffectBJ(udg_Weather_RunestoneWater)
    // //
    call TriggerSleepAction(3.00)
    call DestroyEffectBJ(udg_SE_WaterRSExplosion)
    call TriggerSleepAction(1.00)
    // //
    call UnitRemoveAbilityBJ('Avul', gg_unit_nwgt_0489)
    call KillUnit(gg_unit_nwgt_0489)
    // //
    // Cutscene
    call QueuedTriggerAddBJ(gg_trg_RunestoneCinematicWater, true)
    call QueuedTriggerAddBJ(gg_trg_QuestRSUpdWater, true)
endfunction

//===========================================================================
function InitTrig_RunestoneWaterKill takes nothing returns nothing
    set gg_trg_RunestoneWaterKill=CreateTrigger()
    call TriggerAddAction(gg_trg_RunestoneWaterKill, function Trig_RunestoneWaterKill_Actions)
endfunction

