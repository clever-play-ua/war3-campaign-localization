//===========================================================================
// Trigger: ManaDrainCreate
//===========================================================================
function Trig_ManaDrainCreate_Actions takes nothing returns nothing
    call AddSpecialEffectLocBJ(udg_Point_RSManaDrain, "Abilities\\Spells\\Other\\Drain\\ManaDrainCaster.mdl")
    set udg_SE_RunestoneManaDrain=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.50)
    set udg_Point_GuldanManaDrain=GetUnitLoc(udg_Hero_Guldan)
    call AddLightningLoc("DRAM", udg_Point_GuldanManaDrain, udg_Point_RSManaDrain)
    call RemoveLocation(udg_Point_GuldanManaDrain)
    set udg_SE_ManaDrainChannel=GetLastCreatedLightningBJ()
    call TriggerSleepAction(0.50)
    call AddSpecialEffectTargetUnitBJ("origin", udg_Hero_Guldan, "Abilities\\Spells\\Other\\Drain\\ManaDrainTarget.mdl")
    set udg_SE_GuldanManaDrain=GetLastCreatedEffectBJ()
endfunction

