//===========================================================================
function Trig_Defeat_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Defeat_Func007001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Defeat_Func007001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_Defeat_Func007001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Defeat_Func007001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Defeat_Func007001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_Defeat_Func007002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DefeatConditionTownHalls)
endfunction

function Trig_Defeat_Func010001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_Defeat_Func010001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_Defeat_Func010001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Defeat_Func010001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Defeat_Func010001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_Defeat_Func010002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DefeatConditionTownHalls)
endfunction

function Trig_Defeat_Func013Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_DefeatConditionTownHalls) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Defeat_Func013C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_DefeatConditionWorkers) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Defeat_Actions takes nothing returns nothing
    call GroupClear(udg_Group_DefeatConditionTownHalls)
    call GroupClear(udg_Group_DefeatConditionWorkers)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Defeat_Func007001002)), function Trig_Defeat_Func007002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Defeat_Func010001002)), function Trig_Defeat_Func010002)
    // //
    // //
    if ( Trig_Defeat_Func013C() ) then
        if ( Trig_Defeat_Func013Func002C() ) then
            call DisableTrigger(GetTriggeringTrigger())
            call CommandAI(udg_Player_ElvesMain, udg_P2_COMMAND_ATTACK_USER, udg_P2_DATA_ATTACK_USER_DISABLE)
            call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
            call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_MISSIONFAILED, "TRIGSTR_3296")
            call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
            call ConditionalTriggerExecute(gg_trg_OilUIHide)
            call ClearSelectionForPlayer(udg_Player_Actual)
            call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
            call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
            call TriggerSleepAction(1.00)
            call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_3297")
        else
        endif
    else
    endif
endfunction

