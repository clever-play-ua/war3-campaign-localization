//===========================================================================
// Trigger: ElvenBuildingConstructed
//===========================================================================
function Trig_ElvenBuildingConstructed_Func002C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetConstructedStructure()) == udg_Player_ElvesMain ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetConstructedStructure()) == udg_Player_Farstriders ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetConstructedStructure()) == udg_Player_Magisters ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetConstructedStructure()) == udg_Player_ElvesSupport ) ) then
        return true
    endif
    return false
endfunction

function Trig_ElvenBuildingConstructed_Conditions takes nothing returns boolean
    if ( not Trig_ElvenBuildingConstructed_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_ElvenBuildingConstructed_Func001C takes nothing returns boolean
    if ( not ( udg_Int_RunestoneOwnedCount < 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ElvenBuildingConstructed_Actions takes nothing returns nothing
    if ( Trig_ElvenBuildingConstructed_Func001C() ) then
        call SetUnitAbilityLevelSwapped('ARsD', GetConstructedStructure(), ( 5 - udg_Int_RunestoneOwnedCount ))
    else
        call UnitRemoveAbilityBJ('ARsD', GetConstructedStructure())
    endif
endfunction

