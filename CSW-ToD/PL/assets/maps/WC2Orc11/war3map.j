function Trig_IntroCinematic_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // //
    call ConditionalTriggerExecute(gg_trg_IntroCinSetUp)
    // PrepareCinematic
    // //
    call SetTerrainFogExBJ(0, 1500.00, 7500.00, 0.50, 81.50, 52.94, 30.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro02, udg_Player_Actual, 9.00, 0, 3.00, 100.00)
    // //
    call TriggerSleepAction(0.25)
    call IssuePointOrderLocBJ(udg_FakeChogall, "move", GetRectCenter(gg_rct_Chogall02))
    call IssuePointOrderLocBJ(gg_unit_u000_0272, "move", GetRectCenter(gg_rct_IntroDeathKnight01))
