//===========================================================================
// Trigger: CreepsApeear
//===========================================================================
function Trig_CreepsApeear_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'h000' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n003' ) ) then
        return false
    endif
    return true
endfunction

function Trig_CreepsApeear_Func003002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_CreepsApeear_Func004002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_CreepsApeear_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ForGroupBJ(udg_Group_WaterRSGuard, function Trig_CreepsApeear_Func003002)
    call ForGroupBJ(udg_Group_WaterRSGuard, function Trig_CreepsApeear_Func004002)
    // //
    call GroupClear(udg_Group_WaterRSGuard)
    // //
    call IssuePointOrderLocBJ(gg_unit_nhyh_0160, "attack", GetRandomLocInRect(gg_rct_RuneStoneWaterEffects))
    call IssuePointOrderLocBJ(gg_unit_nhyh_0159, "attack", GetRandomLocInRect(gg_rct_RuneStoneWaterEffects))
    call IssuePointOrderLocBJ(gg_unit_nhyh_0158, "attack", GetRandomLocInRect(gg_rct_RuneStoneWaterEffects))
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_RSActivationWater), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl")
    set udg_SE_Hydra=GetLastCreatedEffectBJ()
    call PlaySoundAtPointBJ(gg_snd_BreathOfFrost1, 85.00, GetRectCenter(gg_rct_RSActivationWater), 0)
    call TriggerSleepAction(0.50)
    call ShowUnitShow(gg_unit_nahy_0304)
    // Water Elmentals
    // 1
    call ShowUnitShow(gg_unit_hwt3_0155)
    call PauseUnitBJ(true, gg_unit_hwt3_0155)
    call SetUnitAnimation(gg_unit_hwt3_0155, "birth")
    call QueueUnitAnimationBJ(gg_unit_hwt3_0155, "stand")
    // 2
    call ShowUnitShow(gg_unit_hwt2_0151)
    call PauseUnitBJ(true, gg_unit_hwt2_0151)
    call SetUnitAnimation(gg_unit_hwt2_0151, "birth")
    call QueueUnitAnimationBJ(gg_unit_hwt2_0151, "stand")
    // 3
    call ShowUnitShow(gg_unit_hwt2_0156)
    call PauseUnitBJ(true, gg_unit_hwt2_0156)
    call SetUnitAnimation(gg_unit_hwt2_0156, "birth")
    call QueueUnitAnimationBJ(gg_unit_hwt2_0156, "stand")
    // 4
    call ShowUnitShow(gg_unit_hwt3_0152)
    call PauseUnitBJ(true, gg_unit_hwt3_0152)
    call SetUnitAnimation(gg_unit_hwt3_0152, "birth")
    call QueueUnitAnimationBJ(gg_unit_hwt3_0152, "stand")
    // 5
    call ShowUnitShow(gg_unit_hwt2_0157)
    call PauseUnitBJ(true, gg_unit_hwt2_0157)
    call SetUnitAnimation(gg_unit_hwt2_0157, "birth")
    call QueueUnitAnimationBJ(gg_unit_hwt2_0157, "stand")
    // 6
    call ShowUnitShow(gg_unit_hwt2_0153)
    call PauseUnitBJ(true, gg_unit_hwt2_0153)
    call SetUnitAnimation(gg_unit_hwt2_0153, "birth")
    call QueueUnitAnimationBJ(gg_unit_hwt2_0153, "stand")
    // 7
    call ShowUnitShow(gg_unit_hwt3_0154)
    call PauseUnitBJ(true, gg_unit_hwt3_0154)
    call SetUnitAnimation(gg_unit_hwt3_0154, "birth")
    call QueueUnitAnimationBJ(gg_unit_hwt3_0154, "stand")
    // To battle
    call TriggerSleepAction(1.00)
    call DestroyEffectBJ(udg_SE_Hydra)
    call PauseUnitBJ(false, gg_unit_hwt3_0155)
    call PauseUnitBJ(false, gg_unit_hwt2_0151)
    call PauseUnitBJ(false, gg_unit_hwt2_0156)
    call PauseUnitBJ(false, gg_unit_hwt3_0152)
    call PauseUnitBJ(false, gg_unit_hwt2_0157)
    call PauseUnitBJ(false, gg_unit_hwt2_0153)
    call PauseUnitBJ(false, gg_unit_hwt3_0154)
endfunction

