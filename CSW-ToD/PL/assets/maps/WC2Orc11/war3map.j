//===========================================================================
// Trigger: RunestoneKillDecreaseBuffForElves
//===========================================================================
function Trig_RunestoneKillDecreaseBuffForElves_Func001Func003001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func003001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func003001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func003002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_ElvenBuildings)
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func006001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func006001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func006001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func006002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_ElvenBuildings)
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func009001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func009001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func009001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func009002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_ElvenBuildings)
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001Func011A takes nothing returns nothing
    call DecUnitAbilityLevelSwapped('ARsD', GetEnumUnit())
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Func001C takes nothing returns boolean
    if ( not ( udg_Int_RunestoneOwnedCount == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RunestoneKillDecreaseBuffForElves_Actions takes nothing returns nothing
    if ( Trig_RunestoneKillDecreaseBuffForElves_Func001C() ) then
        call SetPlayerAbilityAvailableBJ(false, 'ARsD', udg_Player_ElvesMain)
        call SetPlayerAbilityAvailableBJ(false, 'ARsD', udg_Player_Farstriders)
        call SetPlayerAbilityAvailableBJ(false, 'ARsD', udg_Player_Magisters)
    else
        // //
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_ElvesMain, Condition(function Trig_RunestoneKillDecreaseBuffForElves_Func001Func003001002)), function Trig_RunestoneKillDecreaseBuffForElves_Func001Func003002)
        // //
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Farstriders, Condition(function Trig_RunestoneKillDecreaseBuffForElves_Func001Func006001002)), function Trig_RunestoneKillDecreaseBuffForElves_Func001Func006002)
        // //
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Magisters, Condition(function Trig_RunestoneKillDecreaseBuffForElves_Func001Func009001002)), function Trig_RunestoneKillDecreaseBuffForElves_Func001Func009002)
        // //
        call ForGroupBJ(udg_Group_ElvenBuildings, function Trig_RunestoneKillDecreaseBuffForElves_Func001Func011A)
        // //
        call GroupClear(udg_Group_ElvenBuildings)
    endif
endfunction

