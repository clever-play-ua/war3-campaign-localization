//===========================================================================
// Trigger: Golems01
//===========================================================================
function Trig_Golems01_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n003' ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Golems01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitAnimation(gg_unit_ngst_0119, "birth")
    call QueueUnitAnimationBJ(gg_unit_ngst_0119, "stand")
    call PlaySoundFromOffsetBJ(gg_snd_StoneBridgeRise, 85.00, 2.37)
    call TriggerSleepAction(1.63)
    call UnitRemoveAbility(udg_Unit_Golem[5], 'Aloc')
    call ReplaceUnitBJ(udg_Unit_Golem[5], 'ngst', bj_UNIT_STATE_METHOD_RELATIVE)
    set udg_Unit_Golem[5]=GetLastReplacedUnitBJ()
    call SetUnitOwner(udg_Unit_Golem[5], Player(7), true)
    call PauseUnitBJ(false, udg_Unit_Golem[5])
endfunction

//===========================================================================
function InitTrig_Golems01 takes nothing returns nothing
    set gg_trg_Golems01=CreateTrigger()
    call TriggerRegisterUnitInRangeSimple(gg_trg_Golems01, 256.00, gg_unit_ngst_0119)
    call TriggerAddCondition(gg_trg_Golems01, Condition(function Trig_Golems01_Conditions))
    call TriggerAddAction(gg_trg_Golems01, function Trig_Golems01_Actions)
endfunction

