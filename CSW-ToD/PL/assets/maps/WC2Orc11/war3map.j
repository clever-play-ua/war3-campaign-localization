//===========================================================================
// Trigger: RunestoneEarthTimer
//===========================================================================
function Trig_RunestoneEarthTimer_Actions takes nothing returns nothing
    // Check for Dialogue
    // Start Timer
    call StartTimerBJ(udg_Timer_Earth, false, udg_Real_SummoningTime)
    call CreateTimerDialogBJ(udg_Timer_Earth, "TRIGSTR_261")
    set udg_TimerWindow_Runestone=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ(true, udg_TimerWindow_Runestone)
    // Obelisk Animation
    call SetUnitAnimationWithRarity(gg_unit_n60R_0012, "stand work", RARITY_RARE)
    // Obelisk Sound
    call PlaySoundOnUnitBJ(gg_snd_ShimmeringPortalBirth, 85.00, gg_unit_n60R_0012)
    // Special Effect
    set udg_Point_RSManaDrain=GetUnitLoc(gg_unit_n60R_0012)
    call ConditionalTriggerExecute(gg_trg_Guldan_Effect_Start)
    call ConditionalTriggerExecute(gg_trg_ManaDrainCreate)
    // Music
    call PlayThematicMusicBJ("Doom")
endfunction

