    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hard_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // ////
    // Making Trolls Weaker for Quest
    call SetPlayerHandicapDamageBJ(udg_Player_Trolls, 75.00)
    // ////
    call SetPlayerTechResearchedSwap('RESU', 3, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REAU', 3, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REDE', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REAW', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('RHEP', 3, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('RESO', 3, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REMS', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('R00A', 3, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('R00J', 3, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('R00B', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('R00C', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('R00D', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('R00E', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REBO', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REGM', 2, udg_Player_Magisters)
    // ////
    call SetPlayerTechResearchedSwap('RESU', 3, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('REAU', 3, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('REDE', 1, udg_Player_Farstriders)
