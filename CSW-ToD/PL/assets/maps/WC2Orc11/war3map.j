//===========================================================================
function Trig_UnicornQuestCompleted_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'n007' ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_OQUnicorns) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_UnicornQuestCompleted_Func005Func009C takes nothing returns boolean
    if ( not ( udg_Bool_UtokInPit == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_UnicornQuestCompleted_Func005Func011001001002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_UnicornQuestCompleted_Func005Func011001001002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n007' )
endfunction

function Trig_UnicornQuestCompleted_Func005Func011001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetUnitTypeId(GetFilterUnit()) == 'n007')) // INLINED!!
endfunction

function Trig_UnicornQuestCompleted_Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(udg_Player_Unicorns, Condition(function Trig_UnicornQuestCompleted_Func005Func011001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_UnicornQuestCompleted_Actions takes nothing returns nothing
    set udg_Int_UnicornsKilledCounter=( udg_Int_UnicornsKilledCounter + 1 )
    call LeaderboardSetPlayerItemValueBJ(Player(21), udg_LeaderBoard_Unicorns, udg_Int_UnicornsKilledCounter)
    call TriggerSleepAction(2)
    set bj_wantDestroyGroup=true
    if ( Trig_UnicornQuestCompleted_Func005C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QuestSetCompletedBJ(udg_OQUnicorns, true)
        call QuestItemSetCompletedBJ(udg_QReq_Unicorns, true)
        call TriggerSleepAction(3.00)
        call DestroyLeaderboardBJ(udg_LeaderBoard_Unicorns)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2739")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerAddBJ(gg_trg_VOUnicornCompleted, true)
        if ( Trig_UnicornQuestCompleted_Func005Func009C() ) then
            call QueuedTriggerAddBJ(gg_trg_UtokLevelUp, true)
        else
        endif
        call QueuedTriggerAddBJ(gg_trg_UnicornsCompletedHintQ, true)
    else
    endif
endfunction

