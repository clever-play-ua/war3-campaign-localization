//===========================================================================
function Trig_OgreMagiTransform_Conditions takes nothing returns boolean
    if ( not ( GetResearched() == 'R00X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgreMagiTransform_Func005001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n001' )
endfunction

function Trig_OgreMagiTransform_Func005001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_OgreMagiTransform_Func005001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'n001'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_OgreMagiTransform_Func005A takes nothing returns nothing
    set udg_Point_OgreTransform=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_Point_OgreTransform, "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
    call ReplaceUnitBJ(GetEnumUnit(), 'n002', bj_UNIT_STATE_METHOD_DEFAULTS)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_Point_OgreTransform)
endfunction

function Trig_OgreMagiTransform_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_OgreMagiTransform_Func005001002)), function Trig_OgreMagiTransform_Func005A)
endfunction

//===========================================================================
function InitTrig_OgreMagiTransform takes nothing returns nothing
    set gg_trg_OgreMagiTransform=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OgreMagiTransform, Player(0), EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_OgreMagiTransform, Condition(function Trig_OgreMagiTransform_Conditions))
    call TriggerAddAction(gg_trg_OgreMagiTransform, function Trig_OgreMagiTransform_Actions)
endfunction

//===========================================================================
// Trigger: RSPetrification
//===========================================================================
function Trig_RSPetrification_Func002C takes nothing returns boolean
    if ( not ( GetOwningPlayer(gg_unit_H007_0486) != udg_Player_Actual ) ) then
        return false
    endif
    return true
endfunction

function Trig_RSPetrification_Func006C takes nothing returns boolean
    if ( not ( udg_Int_RunestoneOwnedCount >= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RSPetrification_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_RSPetrification_Func002C() ) then
        call SetUnitOwner(gg_unit_H007_0486, udg_Player_Actual, true)
        call ShowUnitShow(gg_unit_H007_0486)
    else
    endif
    call SetPlayerAbilityAvailableBJ(true, 'XARS', udg_Player_Actual)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_3295")
    call TriggerSleepAction(2.00)
    if ( Trig_RSPetrification_Func006C() ) then
        call QueuedTriggerAddBJ(gg_trg_QuestRunestoneCompleted, true)
    else
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_RSPetrification takes nothing returns nothing
    set gg_trg_RSPetrification=CreateTrigger()
    call TriggerAddAction(gg_trg_RSPetrification, function Trig_RSPetrification_Actions)
endfunction

