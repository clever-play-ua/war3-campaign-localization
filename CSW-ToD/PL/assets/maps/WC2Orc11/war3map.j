function Trig_BonusCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QueuedTriggerRemoveBJ(gg_trg_BetreyalCinematicQ)
    call PlaySoundBJ(gg_snd_Comradeship01)
    // //
    call ForGroupBJ(udg_Group_StormreaverArmy, function Trig_BonusCinematicQ_Func005002)
    // //
    call RemoveUnit(udg_FakeChogall)
    call RemoveUnit(udg_FakeGuldan)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro05, udg_Player_Actual, 0)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=GetRandomInt(2, 3)
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Point_UtokFoodTemp=GetRandomLocInRect(gg_rct_DeadCritters)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_BONE, 'nfro', Player(bj_PLAYER_NEUTRAL_EXTRA), udg_Point_UtokFoodTemp, GetRandomDirectionDeg())
        call UnitSuspendDecayBJ(true, GetLastCreatedUnit())
        call RemoveLocation(udg_Point_UtokFoodTemp)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=GetRandomInt(2, 3)
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set udg_Point_UtokFoodTemp=GetRandomLocInRect(gg_rct_DeadCritters)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_BONE, 'nrac', Player(bj_PLAYER_NEUTRAL_EXTRA), udg_Point_UtokFoodTemp, GetRandomDirectionDeg())
        call UnitSuspendDecayBJ(true, GetLastCreatedUnit())
        call RemoveLocation(udg_Point_UtokFoodTemp)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=GetRandomInt(2, 3)
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Point_UtokFoodTemp=GetRandomLocInRect(gg_rct_DeadCritters)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_BONE, 'nrat', Player(bj_PLAYER_NEUTRAL_EXTRA), udg_Point_UtokFoodTemp, GetRandomDirectionDeg())
        call UnitSuspendDecayBJ(true, GetLastCreatedUnit())
        call RemoveLocation(udg_Point_UtokFoodTemp)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeZuljin, GetRectCenter(gg_rct_ZuljinSeeUtok), GetRectCenter(gg_rct_GuldanLooksAtUtok))
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuljin)
    call BlzSetUnitRealFieldBJ(udg_FakeZuljin, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_FakeZuljin, 100.00)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeTharbek, GetRectCenter(gg_rct_TharbekSeeUtok01), GetRectCenter(gg_rct_TharbekSeeUtok02))
    // //
    call ShowUnitShow(udg_FakeUtok)
    call SetUnitPositionLocFacingLocBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokWounded), GetRectCenter(gg_rct_TharbekSeeUtok02))
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitAnimation(udg_FakeUtok, "cinematic injured one")
    // //
    call EnumDestructablesInRectAll(gg_rct_PitBlocker03, function Trig_BonusCinematicQ_Func030A)
    // //
    call DisplayTimedTextToForce(udg_PlayerGroup_PlayerActual, 5.00, "TRIGSTR_2842")
    call TriggerSleepAction(5.00)
    // //
    call EnumDestructablesInRectAll(gg_rct_PitBlocker01, function Trig_BonusCinematicQ_Func035A)
    // ***
    call CreateNUnitsAtLoc(1, 'h000', Player(12), GetRectCenter(gg_rct_UtokWounded), 225.00)
    set udg_Unit_CinZeppelin=GetLastCreatedUnit()
    call SetUnitTimeScalePercent(udg_Unit_CinZeppelin, 50.00)
    call SetUnitScalePercent(udg_Unit_CinZeppelin, 200.00, 200.00, 200.00)
    // ***
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Outro06, udg_Player_Actual, 6.00, 0, 1.00, 100.00)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeTharbek, GetRectCenter(gg_rct_TharbekSeeUtok01), 0.00)
    call PauseUnitBJ(false, udg_FakeTharbek)
    call ShowUnitShow(udg_FakeTharbek)
    call IssuePointOrderLocBJ(udg_FakeTharbek, "move", GetRectCenter(gg_rct_TharbekSeeUtok02))
    call TriggerSleepAction(0.25)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc11Utok4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_FakeTharbek, 0, 0, - 90.00)
    call SetUnitLookAt(udg_Unit_CinTharbek, "bone_head", udg_SemiHero_Utok, 0, 0, 0.00)
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_TharbekSeeUtok02, udg_FakeTharbek) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.50))
    endloop
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingToFaceUnitTimed(udg_FakeTharbek, udg_FakeUtok, 0.25)
    // //
    call IssuePointOrderLocBJ(udg_FakeZuljin, "move", GetRectCenter(gg_rct_GuldanLooksAtUtok))
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidA03, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeTharbek, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_CinTharbek, 0, gg_snd_WC2Orc11xTharbek2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeTharbek, "Cinematic Listening One")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidA04CloseUp, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Outro06, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11xUtok2))
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc11xUtok2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidA03CloseUp, udg_Player_Actual, 0.00)
    // //
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_FakeZuljin, 0, 0, - 90.00)
    call SetUnitLookAt(udg_FakeZuljin, "bone_head", udg_FakeUtok, 0, 0, 0.00)
    // //
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Standard Two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuljin, 0, gg_snd_WC2Orc11Zuljin10, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Listening One")
    // ***
    call SetUnitFlyHeightBJ(udg_Unit_CinZeppelin, 250.00, 10.00)
    // ***
    call CameraSetupApplyForPlayer(true, gg_cam_Outro06, udg_Player_Actual, 0.00)
    // ***
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc11Utok5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ***
    call SetUnitAnimation(udg_Unit_CinZeppelin, "spell")
    call QueueUnitAnimationBJ(udg_Unit_CinZeppelin, "stand")
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ***
    // Utok is saved
    // ***
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro08A, udg_Player_Actual, 0)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeZuljin, GetRectCenter(gg_rct_ZuljinBonusCin01), GetRectCenter(gg_rct_UtokBonusCin01))
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokBonusCin01), GetRectCenter(gg_rct_ZuljinBonusCin01))
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeTharbek, GetRectCenter(gg_rct_GruntBonusCin03), GetRectCenter(gg_rct_UtokBonusCin01))
    call ResetUnitLookAt(udg_FakeTharbek)
    // //
    call CreateNUnitsAtLoc(1, 'o60G', Player(12), GetRectCenter(gg_rct_GruntBonusCin02), 10.18)
    set udg_Unit_CinGrunt[2]=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_CinGrunt[2], PLAYER_COLOR_COAL)
    call SetUnitAnimationWithRarity(udg_Unit_CinGrunt[2], "stand", RARITY_FREQUENT)
    // //
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_GruntBonusCin01), 157.55)
    set udg_Unit_CinGrunt[3]=GetLastCreatedUnit()
    call SetUnitAnimationWithRarity(udg_Unit_CinGrunt[3], "stand", RARITY_FREQUENT)
    // //
    call CreateNUnitsAtLoc(1, 'n006', Player(0), GetRectCenter(gg_rct_AmaniTrollBonusCin01), 238.67)
    set udg_Unit_CinGrunt[4]=GetLastCreatedUnit()
    call SetUnitAnimationWithRarity(udg_Unit_CinGrunt[4], "stand", RARITY_FREQUENT)
    // //
    call SetUnitColor(udg_Unit_CinGrunt[4], PLAYER_COLOR_AQUA)
    // //
    call UnitRemoveAbilityBJ('Ashm', udg_Unit_CinGrunt[4])
    // //
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_Unit_CinGrunt[3], 0, 0, 90.00)
    call SetUnitLookAt(udg_FakeZuljin, "bone_head", udg_Unit_CinGrunt[2], 0, 0, 90.00)
    // //
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro08, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11Zuljin11))
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    // ***
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuljin, 0, gg_snd_WC2Orc11Zuljin11, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Outro07, udg_Player_Actual, 0)
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Listening One")
    // ***
    call CameraSetupApplyForPlayer(true, gg_cam_Outro07A, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11Utok6))
    // //
    call SetUnitAnimation(udg_SemiHero_Utok, "Cinematic Standard Two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc11Utok6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    // //
