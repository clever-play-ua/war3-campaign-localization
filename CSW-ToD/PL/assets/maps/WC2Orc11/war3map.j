    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == 'u000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_WhirlwindCasterUnderSpellDamage_Actions takes nothing returns nothing
    local unit w
    local unit dk
    // //
    set dk=GetSpellTargetUnit()
    // //
     if ( ( UnitHasBuffBJ(dk, 'BPSE') == true ) or ( UnitHasBuffBJ(dk, 'BNsi') == true ) or ( UnitHasBuffBJ(dk, 'BPac') == true ) ) then
    set w=LoadUnitHandle(udg_Hashtable_WhirlwindSpell, GetHandleId(dk), 0)
    if w != null then
    call KillUnit(w)
    endif
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, GetHandleId(dk))
    endif
    // //
endfunction

