//===========================================================================
// Trigger: QuestRunestoneCompleted
//===========================================================================
function Trig_QuestRunestoneCompleted_Func023C takes nothing returns boolean
    if ( not ( udg_Bool_UtokInPit == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_QuestRunestoneCompleted_Func024C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQElvenCitadel) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_MQRuneStones) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_QuestRunestoneCompleted_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_P02Gold)
    call DisableTrigger(gg_trg_P02Lumber)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_RunestonesControlPanel), "CSW\\Abilities\\Spells\\Other\\DeathNova\\Death Nova.mdx")
    set udg_SE_PentagramSpawnEffect=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.25)
    call SetDoodadAnimationRectBJ("stand", 'KOdr', gg_rct_Pentagram)
    call SetDoodadAnimationRectBJ("stand", 'KOdr', gg_rct_PoerGen01)
    call SetDoodadAnimationRectBJ("stand", 'KOdr', gg_rct_PoerGen02)
    call SetDoodadAnimationRectBJ("stand", 'KOdr', gg_rct_PoerGen03)
    call SetDoodadAnimationRectBJ("stand", 'KOdr', gg_rct_PoerGen04)
    call SetDoodadAnimationRectBJ("stand", 'KOdr', gg_rct_PoerGen05)
    call QuestSetCompletedBJ(udg_MQRuneStones, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_283")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call DestroyEffectBJ(udg_SE_PentagramSpawnEffect)
    set udg_String_CheckpointPhaseName="RunestonesConsumed"
    call QueuedTriggerAddBJ(gg_trg_SaveCheckpoint, true)
    call TriggerSleepAction(2.00)
    call QueuedTriggerAddBJ(gg_trg_VOElvenTaunt04Q, true)
    call TriggerSleepAction(2.00)
    if ( Trig_QuestRunestoneCompleted_Func023C() ) then
        call QueuedTriggerAddBJ(gg_trg_UtokFallsCinematicQ, true)
    else
    endif
    if ( Trig_QuestRunestoneCompleted_Func024C() ) then
        call QueuedTriggerAddBJ(gg_trg_UnicornQuestFailedQ, true)
        call QueuedTriggerAddBJ(gg_trg_OutroCinematicQ, true)
    else
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_QuestRunestoneCompleted takes nothing returns nothing
    set gg_trg_QuestRunestoneCompleted=CreateTrigger()
    call TriggerAddAction(gg_trg_QuestRunestoneCompleted, function Trig_QuestRunestoneCompleted_Actions)
endfunction

//===========================================================================
// Trigger: DiscoveringElvenQuestTriggered
//===========================================================================
function Trig_DiscoveringElvenQuestTriggered_Func004C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetAttacker()) == udg_Player_ElvesMain ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetAttacker()) == udg_Player_Farstriders ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetAttacker()) == udg_Player_Magisters ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetAttacker()) == udg_Player_ElvesSupport ) ) then
        return true
    endif
    return false
endfunction

function Trig_DiscoveringElvenQuestTriggered_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( GetAttacker() != udg_Hero_Lireesa ) ) then
        return false
    endif
    if ( not Trig_DiscoveringElvenQuestTriggered_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_DiscoveringElvenQuestTriggered_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_UnitType_ElvenSpeaker=GetUnitTypeId(GetAttacker())
    call QueuedTriggerAddBJ(gg_trg_VOFirstAttackQ, true)
    call QueuedTriggerAddBJ(gg_trg_DiscoveringElvenQuestQ, true)
endfunction

//===========================================================================
function InitTrig_DiscoveringElvenQuestTriggered takes nothing returns nothing
    set gg_trg_DiscoveringElvenQuestTriggered=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_DiscoveringElvenQuestTriggered, Player(0), EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_DiscoveringElvenQuestTriggered, Condition(function Trig_DiscoveringElvenQuestTriggered_Conditions))
    call TriggerAddAction(gg_trg_DiscoveringElvenQuestTriggered, function Trig_DiscoveringElvenQuestTriggered_Actions)
endfunction

//===========================================================================
// Trigger: DiscoveringElvenQuestQ
//===========================================================================
function Trig_DiscoveringElvenQuestQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetDiscoveredBJ(udg_MQElvenCitadel, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2852")
    // //
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_RaysOfLigth), 5.00)
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, GetRectCenter(gg_rct_RaysOfLigth), 512)
    set udg_VisMod_QuestElves=GetLastCreatedFogModifier()
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_RaysOfLigth), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Elves=GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible(udg_MinimapIcon_Elves, true)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_RaysOfLigth))
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call ConditionalTriggerExecute(gg_trg_P02StartAttackingUser)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

