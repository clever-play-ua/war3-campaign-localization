//===========================================================================
// Trigger: InitEnvironment
//===========================================================================
function Trig_InitEnvironment_Actions takes nothing returns nothing
    // //
    call SetTimeOfDay(11.00)
    call SetSkyModel("Environment\\Sky\\DalaranSky\\DalaranSky.mdl")
    call SetDayNightModels("DNCQuelThalasTerrain.mdx", "DNCQuelThalasUnit.mdx")
    // //
    // //
    set udg_Real_ChangeWeatherBot=60.00
    set udg_Real_ChangeWeatherTop=240.00
    // //
    set udg_Real_LightRainDurBot=60.00
    set udg_Real_LightRainDurTop=180.00
    // //
    // //
    // //
    // PentagramHide
    call SetDoodadAnimationRectBJ("death", 'KOdr', gg_rct_Pentagram)
    call SetDoodadAnimationRectBJ("death", 'KOdr', gg_rct_PoerGen01)
    call SetDoodadAnimationRectBJ("death", 'KOdr', gg_rct_PoerGen02)
    call SetDoodadAnimationRectBJ("death", 'KOdr', gg_rct_PoerGen03)
    call SetDoodadAnimationRectBJ("death", 'KOdr', gg_rct_PoerGen04)
    call SetDoodadAnimationRectBJ("death", 'KOdr', gg_rct_PoerGen05)
    // FireEffectsHide
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_OutroFireWall)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_FireEffects01)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_FireEffects01)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_FireEffects02)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_FireEffects02)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_FireEffects03)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_FireEffects03)
    // Init Puddles
    call SetDestructableAnimationBJ(gg_dest_B007_7715, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7716, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7717, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7718, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7719, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7720, "death")
    call SetDestructableInvulnerableBJ(gg_dest_B60R_9639, true)
    call SetDestructableInvulnerableBJ(gg_dest_B60R_9640, true)
    call SetDestructableInvulnerableBJ(gg_dest_LTba_9641, true)
    // //
    call SetItemVisibleBJ(false, gg_item_IQL0_0478)
    // //
    // //
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'necr', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_RabbitCorpse), GetRandomDirectionDeg())
    // //
endfunction

