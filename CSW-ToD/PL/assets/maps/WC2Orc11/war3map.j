//===========================================================================
// Trigger: IntroDialogue
//===========================================================================
function Trig_IntroDialogue_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroDialogue_Func004001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_IntroDialogue_Func008001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_IntroDialogue_Func011001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_IntroDialogue_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call WaitForSoundBJ(gg_snd_WC2Orc11Zuljin2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Listening One")
    // *
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc11Guldan2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Standard Two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuljin, 0, gg_snd_WC2Orc11Zuljin3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Listening One")
    // *
endfunction

