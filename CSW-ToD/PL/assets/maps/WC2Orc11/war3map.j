//===========================================================================
// Trigger: EarthSpawn
//===========================================================================
function Trig_EarthSpawn_Conditions takes nothing returns boolean
    if ( not ( IsQuestItemCompleted(udg_QReq_RSEarth) == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_GuldanSummoning == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_EarthSpawn_Func002Func002C takes nothing returns boolean
    if ( not ( IsTriggerQueuedBJ(gg_trg_WaygatesHintQ) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_EarthSpawn_Func002C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_WaygatesHint) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_EarthSpawn_Func004Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'Yts1' ) ) then
        return false
    endif
    return true
endfunction

function Trig_EarthSpawn_Func004A takes nothing returns nothing
    if ( Trig_EarthSpawn_Func004Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_EarthSpawn_Func026A takes nothing returns nothing
    call IssueTargetOrderBJ(GetEnumUnit(), "attack", udg_Hero_Guldan)
endfunction

function Trig_EarthSpawn_Actions takes nothing returns nothing
    // //
    if ( Trig_EarthSpawn_Func002C() ) then
        call DisableTrigger(gg_trg_WaygatesHint)
        if ( Trig_EarthSpawn_Func002Func002C() ) then
            call QueuedTriggerAddBJ(gg_trg_WaygatesHintQ, true)
        else
        endif
    else
    endif
    // //
    call EnumDestructablesInRectAll(gg_rct_DestroyTrees01, function Trig_EarthSpawn_Func004A)
    // //
    call AddSpecialEffectLocBJ(udg_Point_SpawnElf[1], "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl")
    set udg_SE_TeleportEffect=GetLastCreatedEffectBJ()
    // //
    call CreateNUnitsAtLoc(1, 'eSWO', udg_Player_Magisters, udg_Point_SpawnElf[1], bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_ElvenDefendersEarth)
    call CreateNUnitsAtLoc(1, 'ePRI', udg_Player_Magisters, udg_Point_SpawnElf[1], bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_ElvenDefendersEarth)
    call CreateNUnitsAtLoc(1, 'eSOR', udg_Player_Magisters, udg_Point_SpawnElf[1], bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_ElvenDefendersEarth)
