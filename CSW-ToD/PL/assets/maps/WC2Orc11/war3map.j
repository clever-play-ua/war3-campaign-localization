//===========================================================================
// Trigger: Light Rain Begin
//===========================================================================
function Trig_Light_Rain_Begin_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_Rain_Begin_Func021C takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_Rain_Begin_Actions takes nothing returns nothing
    call AddWeatherEffectSaveLast(GetEntireMapRect(), 'RLlr')
    set udg_Weather_RainLight=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_RainLight, true)
    set udg_Bool_Raining=true
    // AddPuddles
    call SetDestructableAnimationBJ(gg_dest_B007_7715, "birth")
    call QueueDestructableAnimationBJ(gg_dest_B007_7715, "stand")
    call SetDestructableAnimationBJ(gg_dest_B007_7716, "birth")
    call QueueDestructableAnimationBJ(gg_dest_B007_7716, "stand")
    call SetDestructableAnimationBJ(gg_dest_B007_7717, "birth")
    call QueueDestructableAnimationBJ(gg_dest_B007_7717, "stand")
    call SetDestructableAnimationBJ(gg_dest_B007_7718, "birth")
    call QueueDestructableAnimationBJ(gg_dest_B007_7718, "stand")
    call SetDestructableAnimationBJ(gg_dest_B007_7719, "birth")
    call QueueDestructableAnimationBJ(gg_dest_B007_7719, "stand")
    call SetDestructableAnimationBJ(gg_dest_B007_7720, "birth")
    call QueueDestructableAnimationBJ(gg_dest_B007_7720, "stand")
    call TriggerSleepAction(10.00)
    if ( Trig_Light_Rain_Begin_Func021C() ) then
        return
    else
    endif
    // //
    call StartTimerBJ(udg_Timer_LightRainDur, false, GetRandomReal(udg_Real_LightRainDurBot, udg_Real_LightRainDurTop))
endfunction

//===========================================================================
function InitTrig_Light_Rain_Begin takes nothing returns nothing
    set gg_trg_Light_Rain_Begin=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Light_Rain_Begin, udg_Timer_ChangeWeather)
    call TriggerAddCondition(gg_trg_Light_Rain_Begin, Condition(function Trig_Light_Rain_Begin_Conditions))
    call TriggerAddAction(gg_trg_Light_Rain_Begin, function Trig_Light_Rain_Begin_Actions)
