function Trig_InitUnits_Func083A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped('ARsD', GetEnumUnit(), 5)
endfunction

function Trig_InitUnits_Actions takes nothing returns nothing
    // //
    call ShowUnitHide(gg_unit_Nfir_0303)
    call ShowUnitHide(gg_unit_nlv2_0179)
    call ShowUnitHide(gg_unit_nlv3_0180)
    call ShowUnitHide(gg_unit_nlv1_0182)
    call ShowUnitHide(gg_unit_nlv3_0181)
    call ShowUnitHide(gg_unit_nlv2_0183)
    call ShowUnitHide(gg_unit_nlv1_0178)
    call ShowUnitHide(gg_unit_hASU_0542)
    // //
    call PauseUnitBJ(true, gg_unit_emtg_0302)
    // //
    call SetUnitAnimation(gg_unit_emtg_0302, "death")
    call SetUnitAnimation(gg_unit_ngst_0122, "sleep")
    call SetUnitAnimation(gg_unit_ngrk_0123, "sleep")
    call SetUnitAnimation(gg_unit_ngst_0119, "sleep")
    call SetUnitAnimation(gg_unit_nggr_0120, "sleep")
    call SetUnitAnimation(gg_unit_ngrk_0121, "sleep")
    call SetUnitAnimation(gg_unit_ngrk_0124, "sleep")
    call SetUnitAnimation(gg_unit_ngrk_0118, "sleep")
    // //
    // Golems
    // //
    set udg_Unit_Golem[1]=gg_unit_ngrk_0118
    set udg_Unit_Golem[2]=gg_unit_ngrk_0124
    set udg_Unit_Golem[3]=gg_unit_ngrk_0121
    set udg_Unit_Golem[4]=gg_unit_ngrk_0123
    set udg_Unit_Golem[5]=gg_unit_ngst_0119
    set udg_Unit_Golem[6]=gg_unit_ngst_0122
    set udg_Unit_Golem[7]=gg_unit_nggr_0120
    set udg_Unit_Golem[8]=gg_unit_emtg_0302
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call GroupAddUnitSimple(udg_Unit_Golem[GetForLoopIndexA()], udg_Group_StoneGolems)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call ForGroupBJ(udg_Group_StoneGolems, function Trig_InitUnits_Func034002)
    call ForGroupBJ(udg_Group_StoneGolems, function Trig_InitUnits_Func035002)
    // //
    call ForGroupBJ(udg_Group_StoneGolems, function Trig_InitUnits_Func037A)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_RuneStoneWaterEffects, Condition(function Trig_InitUnits_Func041001002)), function Trig_InitUnits_Func041002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_RuneStoneWaterEffects, Condition(function Trig_InitUnits_Func044001002)), function Trig_InitUnits_Func044002)
    // //
    call ForGroupBJ(udg_Group_WaterRSGuard, function Trig_InitUnits_Func046002)
    call ForGroupBJ(udg_Group_WaterRSGuard, function Trig_InitUnits_Func047002)
    // //
    call RemoveGuardPosition(gg_unit_eWOR_0409)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_P2Lumber, Condition(function Trig_InitUnits_Func053001002)), function Trig_InitUnits_Func053002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_P2Lumber, Condition(function Trig_InitUnits_Func056001002)), function Trig_InitUnits_Func056002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_P2Gold, Condition(function Trig_InitUnits_Func059001002)), function Trig_InitUnits_Func059002)
    // //
    call ForGroupBJ(udg_Group_P02GoldWorkers, function Trig_InitUnits_Func061002)
    // //
    // //
    call ShowUnitHide(gg_unit_H007_0486)
    call UnitAddAbilityBJ('Anl1', gg_unit_u003_0427)
    // //
    call IssueTrainOrderByIdBJ(gg_unit_o61J_0052, 'O60B')
    // //
    // Setting Up the Runestone shield
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_ElvesMain, Condition(function Trig_InitUnits_Func072001002)), function Trig_InitUnits_Func072002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Farstriders, Condition(function Trig_InitUnits_Func075001002)), function Trig_InitUnits_Func075002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Magisters, Condition(function Trig_InitUnits_Func078001002)), function Trig_InitUnits_Func078002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_ElvesSupport, Condition(function Trig_InitUnits_Func081001002)), function Trig_InitUnits_Func081002)
    // //
    call ForGroupBJ(udg_Group_ElvenBuildings, function Trig_InitUnits_Func083A)
    // //
    call GroupClear(udg_Group_ElvenBuildings)
    // //
    // //
    // //
    // //
endfunction

