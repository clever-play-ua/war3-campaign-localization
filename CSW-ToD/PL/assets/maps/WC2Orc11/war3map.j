//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func025C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func036C takes nothing returns boolean
    if ( not ( udg_Bool_TrollsDefeated == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    call DisableTrigger(gg_trg_OutroCinDragonFire01)
    call DisableTrigger(gg_trg_OutroCinDragonFire02)
    call DisableTrigger(gg_trg_OutroCinDragonFire03)
    call DisableTrigger(gg_trg_OutroCinDragonFire04)
    call DisableTrigger(gg_trg_OutroCinDragonFire05)
    call RemoveLocation(udg_Point_DragonFireSpawn[1])
    call RemoveLocation(udg_Point_DragonFireSpawn[2])
    call RemoveLocation(udg_Point_DragonFireSpawn[3])
    call RemoveLocation(udg_Point_DragonFireSpawn[4])
    call RemoveLocation(udg_Point_DragonFireSpawn[5])
    // //
    call QueuedTriggerRemoveBJ(gg_trg_BetreyalCinematicQ)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_ElvesMain, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_ElvesMain, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call ShowUnitShow(udg_Hero_Guldan)
    call PauseUnitBJ(false, udg_Hero_Guldan)
    call StoreUnitBJ(udg_Hero_Guldan, "Guldan", "WC2Orc11", udg_Cache)
    // //
    call ShowUnitShow(udg_Hero_Chogall)
    call PauseUnitBJ(false, udg_Hero_Chogall)
    call StoreUnitBJ(udg_Hero_Chogall, "Chogall", "WC2Orc11", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func025C() ) then
        call ShowUnitShow(udg_SemiHero_Utok)
        call PauseUnitBJ(false, udg_SemiHero_Utok)
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc11", udg_Cache)
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_UtokStart), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc11", udg_Cache)
    endif
    // //
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', udg_Player_Actual), "UtokLevel", "WC2Orc11", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc11", udg_Cache)
    // //
    call TriggerSleepAction(0.10)
    call SaveGameCacheBJ(udg_Cache)
    // //
    // SecretMission
    // //
    if ( Trig_Next_Level_Prep_Func036C() ) then
        call ShowCustomCampaignButton(true, 17)
        call SetNextLevelBJ("WC2Orc11s.w3x")
    else
        call SetNextLevelBJ("WC2OrcAct4.w3x")
    endif
    // Act4
    call ShowCustomCampaignButton(true, 18)
    call ShowCustomCampaignButton(true, 19)
    // Victory
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
