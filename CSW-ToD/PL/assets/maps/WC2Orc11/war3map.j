//===========================================================================
// Trigger: P11AITrollsDefeated
//===========================================================================
function Trig_P11AITrollsDefeated_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_P11Gold)
    call DisableTrigger(gg_trg_P11Lumber)
    // //
    call CommandAI(udg_Player_ElvesMain, udg_P2_COMMAND_ATTACK_TROLLS, udg_P2_DATA_ATTACK_TROLLS_DISABLE)
    call CommandAI(udg_Player_ElvesSupport, udg_P20_COMMAND_ATTACK_TROLLS, udg_P20_DATA_ATTACK_TROLLS_DISABLE)
    call TriggerSleepAction(2.00)
    // //
    call CommandAI(udg_Player_Trolls, udg_P11_COMMAND_ATTACK_GROUND, udg_P11_DATA_ATTACK_GROUND_DISABLE)
    call TriggerSleepAction(2.00)
    // //
    call CommandAI(udg_Player_Trolls, udg_P11_COMMAND_DEFEAT, udg_P11_DATA_DEFEAT_ENABLE)
    call TriggerSleepAction(2.00)
    // //
endfunction

