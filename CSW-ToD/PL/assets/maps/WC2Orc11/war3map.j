    set udg_Region_GruntFinalArr[12]=gg_rct_GruntFinal12
    set udg_Region_GruntFinalArr[13]=gg_rct_GruntFinal13
    set udg_Region_GruntFinalArr[14]=gg_rct_GruntFinal14
    set udg_Region_GruntFinalArr[15]=gg_rct_GruntFinal15
    set udg_Region_GruntFinalArr[16]=gg_rct_GruntFinal16
    set udg_Region_GruntFinalArr[17]=gg_rct_GruntFinal17
    set udg_Region_GruntFinalArr[18]=gg_rct_GruntFinal18
    set udg_Region_GruntFinalArr[19]=gg_rct_GruntFinal19
    set udg_Region_GruntFinalArr[20]=gg_rct_GruntFinal20
    // Goblins
    set udg_Region_GoblinFinalArr[1]=gg_rct_GoblinFInal01
    set udg_Region_GoblinFinalArr[2]=gg_rct_GoblinFInal02
    set udg_Region_GoblinFinalArr[3]=gg_rct_GoblinFInal03
    set udg_Region_GoblinFinalArr[4]=gg_rct_GoblinFInal04
    set udg_Region_GoblinFinalArr[5]=gg_rct_GoblinFInal05
    set udg_Region_GoblinFinalArr[6]=gg_rct_GoblinFInal06
    set udg_Region_GoblinFinalArr[7]=gg_rct_GoblinFInal07
    set udg_Region_GoblinFinalArr[8]=gg_rct_GoblinFInal08
    set udg_Region_GoblinFinalArr[9]=gg_rct_GoblinFInal09
    set udg_Region_GoblinFinalArr[10]=gg_rct_GoblinFInal10
    // Catapults
    set udg_Region_CatapultFinaArrl[1]=gg_rct_CatapultFinal01
    set udg_Region_CatapultFinaArrl[2]=gg_rct_CatapultFinal02
    set udg_Region_CatapultFinaArrl[3]=gg_rct_CatapultFinal03
    set udg_Region_CatapultFinaArrl[4]=gg_rct_CatapultFinal04
    set udg_Region_CatapultFinaArrl[5]=gg_rct_CatapultFinal05
    set udg_Region_CatapultFinaArrl[6]=gg_rct_CatapultFinal06
    // Zeppelins
    set udg_Region_ZeppelinFinalArr[1]=gg_rct_ZeppelinFina01
    set udg_Region_ZeppelinFinalArr[2]=gg_rct_ZeppelinFina02
    set udg_Region_ZeppelinFinalArr[3]=gg_rct_ZeppelinFina03
