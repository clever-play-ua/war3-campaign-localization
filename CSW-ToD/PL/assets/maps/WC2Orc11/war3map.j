function InitTrig_RunestoneCinematicCleanUp takes nothing returns nothing
    set gg_trg_RunestoneCinematicCleanUp=CreateTrigger()
    call TriggerAddAction(gg_trg_RunestoneCinematicCleanUp, function Trig_RunestoneCinematicCleanUp_Actions)
endfunction

//===========================================================================
// Trigger: UtokFallsCinematicTriggered
//===========================================================================
function Trig_UtokFallsCinematicTriggered_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_SemiHero_Utok ) ) then
        return false
    endif
    if ( not ( udg_Bool_UtokInPit == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokFallsCinematicTriggered_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_UtokFallsCinematicQ, true)
endfunction

//===========================================================================
function InitTrig_UtokFallsCinematicTriggered takes nothing returns nothing
    set gg_trg_UtokFallsCinematicTriggered=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_UtokFallsCinematicTriggered, gg_rct_RockCollapse01)
