//===========================================================================
// Trigger: RunestoneWaterGuldan
//===========================================================================
function Trig_RunestoneWaterGuldan_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Guldan) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_GuldanSummoning == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_RunestoneWaterOwned == false ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_Hero_Guldan ) ) then
        return false
    endif
    return true
endfunction

function Trig_RunestoneWaterGuldan_Actions takes nothing returns nothing
    set udg_Point_GuldanTeleport[1]=GetUnitLoc(GetTriggerUnit())
    set udg_Point_GuldanTeleport[2]=GetRectCenter(gg_rct_RSActivationWater)
    // -----------
    call AddSpecialEffectLocBJ(udg_Point_GuldanTeleport[1], "Abilities\\Spells\\Undead\\Darksummoning\\DarkSummonTarget.mdl")
    set udg_SE_GuldanTeleport_A=GetLastCreatedEffectBJ()
    call AddSpecialEffectLocBJ(udg_Point_GuldanTeleport[2], "Abilities\\Spells\\Undead\\Darksummoning\\DarkSummonTarget.mdl")
    set udg_SE_GuldanTeleport_B=GetLastCreatedEffectBJ()
    call RemoveLocation(udg_Point_GuldanTeleport[1])
    call RemoveLocation(udg_Point_GuldanTeleport[2])
    // -----------
    call SetUnitPositionLocFacingBJ(udg_Hero_Guldan, udg_Point_RSWater, 90.00)
    set udg_Bool_GuldanSummoning=true
    call ConditionalTriggerExecute(gg_trg_RunestoneWaterTimer)
    // Weaken Guldan
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Hero_Guldan)
    call PauseUnitBJ(true, udg_Hero_Guldan)
    call ConditionalTriggerExecute(gg_trg_Guldan_Damaged_Event_Registration)
    // -----------
    call ConditionalTriggerExecute(gg_trg_GuldanSpellAnimation)
    // AI Ticked Off
    call ConditionalTriggerExecute(gg_trg_WaterSpawn)
    call TriggerSleepAction(2.00)
    call DestroyEffectBJ(udg_SE_GuldanTeleport_A)
    call DestroyEffectBJ(udg_SE_GuldanTeleport_B)
endfunction

//===========================================================================
