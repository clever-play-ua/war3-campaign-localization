//===========================================================================
// Trigger: DefendRequest
//===========================================================================
function Trig_DefendRequest_Func004C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetAttacker()) == udg_Player_ElvesMain ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetAttacker()) == udg_Player_ElvesSupport ) ) then
        return true
    endif
    return false
endfunction

function Trig_DefendRequest_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    if ( not Trig_DefendRequest_Func004C() ) then
        return false
    endif
    if ( not ( udg_Bool_TrollsAttacked == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DefendRequest_Func002Func001001 takes nothing returns boolean
    return ( IsUnitDeadBJ(udg_Hero_ZulJeen) == true )
endfunction

function Trig_DefendRequest_Func002Func003Func001001 takes nothing returns boolean
    return ( IsUnitDeadBJ(udg_Hero_ZulJeen) == true )
endfunction

function Trig_DefendRequest_Func002Func003C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 6) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DefendRequest_Func002C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 6) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DefendRequest_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_DefendRequest_Func002C() ) then
        if ( (IsUnitDeadBJ(udg_Hero_ZulJeen) == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
        call QueuedTriggerAddBJ(gg_trg_VODefendRequestQ1, true)
    else
        if ( Trig_DefendRequest_Func002Func003C() ) then
            if ( (IsUnitDeadBJ(udg_Hero_ZulJeen) == true) ) then // INLINED!!
                return
            else
                call DoNothing()
            endif
            call QueuedTriggerAddBJ(gg_trg_VODefendRequestQ2, true)
        else
        endif
    endif
endfunction

//===========================================================================
function InitTrig_DefendRequest takes nothing returns nothing
    set gg_trg_DefendRequest=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_DefendRequest, Player(10), EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_DefendRequest, Condition(function Trig_DefendRequest_Conditions))
    call TriggerAddAction(gg_trg_DefendRequest, function Trig_DefendRequest_Actions)
endfunction

//===========================================================================
// Trigger: OilSpentForResearchBO
//===========================================================================
function Trig_OilSpentForResearchBO_Conditions takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('RBOo', udg_Player_Actual) == 0 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetOrderedUnit()) == 'o60L' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForResearchBO_Actions takes nothing returns nothing
    local sound OrcUI_InsufficientOill
    local string Sound_Path= "Sound\\Interface\\Warning\\Orc\\GruntNoOil1.mp3"
    // -------------------------------------
    // Check the Order to research the cannons
    if ( ( GetIssuedOrderId() == 1380077423 ) ) then
    // Check the amount of Oil for Player
    if (OilHarvest___playerOil[GetPlayerId((Player(0)))]) < 1000 then // INLINED!!
    // // UI Warning
    set OrcUI_InsufficientOill=CreateSound(Sound_Path, false, false, false, 1, 1, "DefaultEAXON")
    call SetSoundParamsFromLabel(OrcUI_InsufficientOill, "User Interface")
    call SetSoundVolume(OrcUI_InsufficientOill, 127)
    call SetSoundPitch(OrcUI_InsufficientOill, 1.0)
    call StartSound(OrcUI_InsufficientOill)
    call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3617")
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(0) , - 1000)
    else
    // need to decrease the oil if there was enough of it and the train/upgrade started
    call playerAddOil(Player(0) , - 1000)
    endif
    endif
    // // leak cleaner
    call KillSoundWhenDone(OrcUI_InsufficientOill)
    set OrcUI_InsufficientOill=null
endfunction

//===========================================================================
function InitTrig_OilSpentForResearchBO takes nothing returns nothing
    set gg_trg_OilSpentForResearchBO=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilSpentForResearchBO, Player(0), EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerAddCondition(gg_trg_OilSpentForResearchBO, Condition(function Trig_OilSpentForResearchBO_Conditions))
    call TriggerAddAction(gg_trg_OilSpentForResearchBO, function Trig_OilSpentForResearchBO_Actions)
