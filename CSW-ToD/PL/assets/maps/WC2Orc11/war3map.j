function InitTrig_ElvenBuildingConstructed takes nothing returns nothing
    set gg_trg_ElvenBuildingConstructed=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ElvenBuildingConstructed, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
    call TriggerAddCondition(gg_trg_ElvenBuildingConstructed, Condition(function Trig_ElvenBuildingConstructed_Conditions))
    call TriggerAddAction(gg_trg_ElvenBuildingConstructed, function Trig_ElvenBuildingConstructed_Actions)
endfunction

