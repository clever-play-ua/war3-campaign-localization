function InitTrig_DiscoveringMainQuest takes nothing returns nothing
    set gg_trg_DiscoveringMainQuest=CreateTrigger()
    call TriggerAddAction(gg_trg_DiscoveringMainQuest, function Trig_DiscoveringMainQuest_Actions)
endfunction

