//===========================================================================
// Trigger: InitPlayers
//===========================================================================
function Trig_InitPlayers_Func030002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_InitPlayers_Actions takes nothing returns nothing
    // //
    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[0]
    set udg_Player_Actual=Player(0)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_255")
    call SetPlayerColorBJ(Player(0), PLAYER_COLOR_NAVY, true)
    call EnableOcclusionBJ(true, udg_PlayerGroup_PlayerActual)
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 25.00)
    // //
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 1000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 1000)
    call playerAddOil(Player(0) , 4000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    // //
    call SetPlayerUnitAvailableBJ('o60N', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60V', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60M', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('n002', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('otbk', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60T', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('n60L', false, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('RZeR', 0, udg_Player_Actual)
    // //
    set udg_Player_BTGCinematic=Player(20)
    // //
    set udg_Player_CinematicChogall=Player(3)
    // //
    set udg_Player_CinematicDummy=Player(23)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_CinematicDummy), function Trig_InitPlayers_Func030002)
    // //
    set udg_Player_CinematicGuldan=Player(13)
    // //
    set udg_Player_CinematicZuljin=Player(2)
    // //
    set udg_Player_CinematicZuluhed=Player(21)
    // //
    set udg_Player_ElvesMain=Player(1)
    call SetPlayerColorBJ(udg_Player_ElvesMain, PLAYER_COLOR_TURQUOISE, true)
    call SetPlayerStateBJ(udg_Player_ElvesMain, PLAYER_STATE_RESOURCE_FOOD_CAP, 300)
    // //
    set udg_Player_ElvesSupport=Player(19)
    call SetPlayerColorBJ(udg_Player_ElvesSupport, PLAYER_COLOR_TURQUOISE, true)
    call SetPlayerStateBJ(udg_Player_ElvesSupport, PLAYER_STATE_RESOURCE_FOOD_CAP, 300)
    // //
    set udg_Player_Farstriders=Player(6)
    call SetPlayerColorBJ(udg_Player_Farstriders, PLAYER_COLOR_MINT, true)
    // //
    set udg_Player_Magisters=Player(7)
    call SetPlayerColorBJ(udg_Player_Magisters, PLAYER_COLOR_VIOLET, true)
    // //
    set udg_Player_Trolls=Player(10)
    call SetPlayerStateBJ(udg_Player_Trolls, PLAYER_STATE_RESOURCE_LUMBER, 10000)
    call SetPlayerStateBJ(udg_Player_Trolls, PLAYER_STATE_RESOURCE_GOLD, 10000)
    call SetPlayerStateBJ(udg_Player_Trolls, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    call SetPlayerName(udg_Player_Trolls, "TRIGSTR_3563")
    call SetPlayerMaxHeroesAllowed(1, udg_Player_Trolls)
    call SetPlayerColorBJ(udg_Player_Trolls, PLAYER_COLOR_RED, true)
    // //
    set udg_Player_Utok=Player(12)
    // //
    set udg_Player_RuneStoneForest=Player(22)
    set udg_Player_RuneStoneAir=Player(8)
    set udg_Player_RuneStoneEarth=Player(11)
    set udg_Player_RuneStoneFire=Player(5)
    set udg_Player_RuneStoneWater=Player(9)
    // //
    set udg_Player_Wildlife=Player(18)
    call SetPlayerColorBJ(udg_Player_Wildlife, PLAYER_COLOR_COAL, true)
    // //
    set udg_Player_Unicorns=Player(14)
    call SetPlayerColorBJ(udg_Player_Unicorns, PLAYER_COLOR_SNOW, true)
    // //
    // //
    // Alliances
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Trolls, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Trolls, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Wildlife, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Wildlife, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Unicorns, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Unicorns, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Wildlife, udg_Player_Trolls, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_Wildlife, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_Unicorns, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Unicorns, udg_Player_Trolls, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Utok, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Utok, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    // //
    // //
    call ForceAddPlayerSimple(udg_Player_ElvesMain, udg_PlayerGroup_Elfs)
    call ForceAddPlayerSimple(udg_Player_ElvesSupport, udg_PlayerGroup_Elfs)
    call ForceAddPlayerSimple(udg_Player_Farstriders, udg_PlayerGroup_Elfs)
    call ForceAddPlayerSimple(udg_Player_Magisters, udg_PlayerGroup_Elfs)
    // //
    call SetForceAllianceStateBJ(udg_PlayerGroup_Elfs, bj_FORCE_PLAYER[PLAYER_NEUTRAL_AGGRESSIVE], bj_ALLIANCE_ALLIED_VISION)
    call SetForceAllianceStateBJ(bj_FORCE_PLAYER[PLAYER_NEUTRAL_AGGRESSIVE], udg_PlayerGroup_Elfs, bj_ALLIANCE_ALLIED_VISION)
    call SetForceAllianceStateBJ(udg_PlayerGroup_Elfs, bj_FORCE_PLAYER[18], bj_ALLIANCE_ALLIED_VISION)
    call SetForceAllianceStateBJ(bj_FORCE_PLAYER[18], udg_PlayerGroup_Elfs, bj_ALLIANCE_ALLIED_VISION)
    call SetForceAllianceStateBJ(udg_PlayerGroup_Elfs, bj_FORCE_PLAYER[14], bj_ALLIANCE_ALLIED_VISION)
    call SetForceAllianceStateBJ(bj_FORCE_PLAYER[14], udg_PlayerGroup_Elfs, bj_ALLIANCE_ALLIED_VISION)
    // //
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicZuljin)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicChogall)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_Utok)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicGuldan)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicDummy)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicZuluhed)
    // //
    // //
    call EnableCreepSleepBJ(false)
    // //
    call ConditionalTriggerExecute(gg_trg_RunestoneInit)
    // //
    call ConditionalTriggerExecute(gg_trg_InitUnits)
    call ConditionalTriggerExecute(gg_trg_LoadCache)
    // //
    call ConditionalTriggerExecute(gg_trg_Easy)
    call ConditionalTriggerExecute(gg_trg_Normal)
    call ConditionalTriggerExecute(gg_trg_Hard)
    // //
endfunction

