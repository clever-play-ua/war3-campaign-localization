    call StopSoundBJ(gg_snd_DarkAgents, false)
    call StopSoundBJ(gg_snd_WC2Orc11Guldan4, false)
    call StopSoundBJ(gg_snd_WC2Orc11Guldan5, false)
    call StopSoundBJ(gg_snd_WC2Orc11Utok1, false)
    call StopSoundBJ(gg_snd_WC2Orc11Utok2, false)
    call StopSoundBJ(gg_snd_WC2Orc11Utok3, false)
endfunction

