//===========================================================================
// Trigger: StartAITrolls
//===========================================================================
function Trig_StartAITrolls_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetAttacker()) == udg_Player_ElvesMain ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartAITrolls_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Trolls, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_Actual, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_CinematicZuljin, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_CinematicZuljin, udg_Player_Trolls, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_ElvesMain, bj_ALLIANCE_UNALLIED)
    // //
    call AdjustPlayerStateBJ(5000, udg_Player_Trolls, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(5000, udg_Player_Trolls, PLAYER_STATE_RESOURCE_LUMBER)
    // //
    call StartCampaignAI(udg_Player_Trolls, "CSW\\Scripts\\ToDScripts\\WC2Orc11\\WC2Orc11TrollsAdvancedAI.ai")
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetUnitLoc(GetAttackedUnitBJ()), 1.00)
    call TriggerSleepAction(1.00)
    call PlaySoundOnUnitBJ(gg_snd_ArrangedTeamInvitation, 85.00, GetAttackedUnitBJ())
    call QueuedTriggerAddBJ(gg_trg_DiscoveringTrollQuestQ, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call CommandAI(udg_Player_Trolls, udg_P11_COMMAND_ATTACK_GROUND, udg_P11_DATA_ATTACK_GROUND_ENABLE)
    // //
    set udg_Bool_TrollsAttacked=true
endfunction

//===========================================================================
