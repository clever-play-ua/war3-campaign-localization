//===========================================================================
// Trigger: OutroCinSpawnElves
//===========================================================================
function Trig_OutroCinSpawnElves_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OutroCinSpawnElves_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set bj_forLoopAIndex=5
    set bj_forLoopAIndexEnd=GetRandomInt(10, 15)
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Point_SpawnFinalCinematic=GetRandomLocInRect(gg_rct_ForestFireFog)
        call CreateNUnitsAtLoc(GetRandomInt(1, 3), 'nhem', udg_Player_ElvesMain, udg_Point_SpawnFinalCinematic, GetRandomDirectionDeg())
        call UnitAddAbilityBJ('Awan', GetLastCreatedUnit())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=5
    set bj_forLoopBIndexEnd=GetRandomInt(10, 15)
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set udg_Point_SpawnFinalCinematic=GetRandomLocInRect(gg_rct_ForestFireFog)
        call CreateNUnitsAtLoc(GetRandomInt(1, 3), 'nhef', udg_Player_ElvesMain, udg_Point_SpawnFinalCinematic, GetRandomDirectionDeg())
        call UnitAddAbilityBJ('Awan', GetLastCreatedUnit())
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    set bj_forLoopAIndex=5
    set bj_forLoopAIndexEnd=GetRandomInt(10, 15)
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Point_SpawnFinalCinematic=GetRandomLocInRect(gg_rct_ForestFireFog)
        call CreateNUnitsAtLoc(GetRandomInt(1, 3), 'h60O', udg_Player_ElvesMain, udg_Point_SpawnFinalCinematic, GetRandomDirectionDeg())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=5
    set bj_forLoopBIndexEnd=GetRandomInt(7, 8)
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set udg_Point_SpawnFinalCinematic=GetRandomLocInRect(gg_rct_ForestFireFog)
        call CreateNUnitsAtLoc(1, 'necr', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFinalCinematic, GetRandomDirectionDeg())
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
endfunction

