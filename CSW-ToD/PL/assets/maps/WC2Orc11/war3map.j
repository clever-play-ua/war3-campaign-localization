//===========================================================================
// Trigger: InitAudio
//===========================================================================
function Trig_InitAudio_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Music_DefaultNames[0]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    set udg_Music_DefaultNames[1]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[2]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3"
    set udg_Music_DefaultNames[3]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[4]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3"
    set udg_Music_DefaultNames[5]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    // //
    set udg_Music_DefaultNamesCount=6
    // //
    // SetMusicList with Randomizer
    set udg_Music_CurrentName=udg_Music_DefaultNames[GetRandomInt(0, 5)]
    set udg_Music_CurrentVolume=0.00
    // //
    call ClearMapMusicBJ()
endfunction

//===========================================================================
function InitTrig_InitAudio takes nothing returns nothing
    set gg_trg_InitAudio=CreateTrigger()
    call TriggerAddAction(gg_trg_InitAudio, function Trig_InitAudio_Actions)
endfunction

//===========================================================================
// Trigger: RunestoneInit
//===========================================================================
function Trig_RunestoneInit_Func010002 takes nothing returns nothing
    call SetForceAllianceStateBJ(udg_PlayerGroup_RuneStone, GetPlayersAll(), bj_ALLIANCE_NEUTRAL)
endfunction

function Trig_RunestoneInit_Func011002 takes nothing returns nothing
    call SetForceAllianceStateBJ(udg_PlayerGroup_PlayerActual, udg_PlayerGroup_RuneStone, bj_ALLIANCE_NEUTRAL)
endfunction

function Trig_RunestoneInit_Func012002 takes nothing returns nothing
    call SetForceAllianceStateBJ(udg_PlayerGroup_Elfs, udg_PlayerGroup_RuneStone, bj_ALLIANCE_NEUTRAL)
endfunction

function Trig_RunestoneInit_Actions takes nothing returns nothing
    // //
    // Init
    // //
    call ForceAddPlayerSimple(udg_Player_RuneStoneEarth, udg_PlayerGroup_RuneStone)
    call ForceAddPlayerSimple(udg_Player_RuneStoneWater, udg_PlayerGroup_RuneStone)
    call ForceAddPlayerSimple(udg_Player_RuneStoneForest, udg_PlayerGroup_RuneStone)
    call ForceAddPlayerSimple(udg_Player_RuneStoneFire, udg_PlayerGroup_RuneStone)
    call ForceAddPlayerSimple(udg_Player_RuneStoneAir, udg_PlayerGroup_RuneStone)
    // //
    call ForForce(udg_PlayerGroup_RuneStone, function Trig_RunestoneInit_Func010002)
    call ForForce(udg_PlayerGroup_PlayerActual, function Trig_RunestoneInit_Func011002)
    call ForForce(udg_PlayerGroup_Elfs, function Trig_RunestoneInit_Func012002)
    // //
    // RuneStoneForest
    // //
    call SetPlayerName(udg_Player_RuneStoneForest, "TRIGSTR_244")
    call SetPlayerColorBJ(udg_Player_RuneStoneForest, PLAYER_COLOR_AQUA, true)
    call SetUnitOwner(gg_unit_n60R_0010, udg_Player_RuneStoneForest, true)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Runestone01Forest), "CSW\\Doodads\\Cinematic\\EffectLeaves\\EffectLeaves.mdx")
    set udg_SE_LeavesEffect[1]=GetLastCreatedEffectBJ()
    // //
    // RuneStoneWind
    // //
    call SetPlayerName(udg_Player_RuneStoneAir, "TRIGSTR_242")
    call SetUnitOwner(gg_unit_n60R_0013, udg_Player_RuneStoneAir, true)
    call AddWeatherEffectSaveLast(gg_rct_Runestone03Wind, 'MEds')
    set udg_Weather_RunestoneWind=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_RunestoneWind, true)
    call SetStackedSoundBJ(true, gg_snd_WindLoopStereo, gg_rct_Runestone03Wind)
    // //
    // RuneStoneEarth
    // //
    call SetPlayerName(udg_Player_RuneStoneEarth, "TRIGSTR_241")
    call SetUnitOwner(gg_unit_n60R_0012, udg_Player_RuneStoneEarth, true)
    call AddWeatherEffectSaveLast(gg_rct_Runestone04Earth, 'FDwl')
    set udg_Weather_RunestoneEarth=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_RunestoneEarth, true)
    call SetStackedSoundBJ(true, gg_snd_AshenvaleBrazierLoop1, gg_rct_Runestone04Earth)
    // //
    // RuneStoneFire
    // //
    call SetPlayerName(udg_Player_RuneStoneFire, "TRIGSTR_240")
    call SetUnitOwner(gg_unit_n60R_0014, udg_Player_RuneStoneFire, true)
    call AddWeatherEffectSaveLast(gg_rct_Runestone05Fire, 'FDrl')
    set udg_Weather_RunestoneFire=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_RunestoneFire, true)
    call SetStackedSoundBJ(true, gg_snd_LordaeronSummerBrazierLoop1, gg_rct_Runestone05Fire)
    // //
    // RuneStoneWater
    // //
    call SetPlayerName(udg_Player_RuneStoneWater, "TRIGSTR_239")
    call SetUnitOwner(gg_unit_n60R_0011, udg_Player_RuneStoneWater, true)
    call AddWeatherEffectSaveLast(gg_rct_Runestone02Water, 'RLlr')
    set udg_Weather_RunestoneWater=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_RunestoneWater, true)
    call SetStackedSoundBJ(true, gg_snd_RainAmbience, gg_rct_Runestone02Water)
    // //
    // DisableAbilities
    // //
    call SetPlayerAbilityAvailableBJ(false, 'AAcR', udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(false, 'AQRP', udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(false, 'ARCF', udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(false, 'AQWR', udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(false, 'XARS', udg_Player_Actual)
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_RunestoneInit takes nothing returns nothing
    set gg_trg_RunestoneInit=CreateTrigger()
    call TriggerAddAction(gg_trg_RunestoneInit, function Trig_RunestoneInit_Actions)
endfunction

