//===========================================================================
// Trigger: TrollsKilled
//===========================================================================
function Trig_TrollsKilled_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollsKilled_Func003Func001001001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_TrollsKilled_Func003Func001001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_TrollsKilled_Func003Func001001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_TrollsKilled_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(udg_Player_Trolls, Condition(function Trig_TrollsKilled_Func003Func001001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollsKilled_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_TrollsKilled_Func003C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Bool_TrollsDefeated=true
        call ConditionalTriggerExecute(gg_trg_P11AITrollsDefeated)
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QuestSetFailedBJ(udg_OQTrollCamp, true)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_3579")
        call DestroyMinimapIcon(udg_MinimapIcon_Trolls)
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerAddBJ(gg_trg_VOTrollsDefeatedQ, true)
    else
    endif
endfunction

