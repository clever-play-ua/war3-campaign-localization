function Trig_UtokFallsCinematicCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Bool_CinUtokOn=false
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_UtokFallsCinematicCleanUp_Func009002)
    call ForGroupBJ(udg_Group_CinHiddenUnits, function Trig_UtokFallsCinematicCleanUp_Func010002)
    call ForGroupBJ(udg_Group_CinHiddenUnits, function Trig_UtokFallsCinematicCleanUp_Func011002)
    call ForGroupBJ(udg_Group_CinHiddenUnits, function Trig_UtokFallsCinematicCleanUp_Func012002)
    // //
    call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_UtokWounded), 180.00)
    call ShowUnitShow(udg_SemiHero_Utok)
    call SetUnitInvulnerable(udg_SemiHero_Utok, true)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    call SetUnitAnimation(udg_SemiHero_Utok, "cinematic injured two")
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_RockCollapse01, Condition(function Trig_UtokFallsCinematicCleanUp_Func021001002)), function Trig_UtokFallsCinematicCleanUp_Func021A)
    // //
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker01), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker02), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker03), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker04), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker05), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker06), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker07), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker08), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker09), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker10), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker11), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker12), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_PitBlocker13), bj_UNIT_FACING, 1, 0)
    // //
    call SetDoodadAnimationBJ("stand", 'D6AD', 256.00, GetRectCenter(gg_rct_RockCollapse01))
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call TriggerSleepAction(0.10)
    call CameraSetupApplyForPlayer(true, udg_Var_PlayerCamera, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // //
    call QueuedTriggerRemoveBJ(gg_trg_UtokFallsCinematicQ)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

