function Trig_BetreyalCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call StopSoundBJ(gg_snd_Doom01, true)
    // //
    call RemoveUnit(udg_FakeDoomhammer)
    call RemoveUnit(udg_FakeMaim)
    call RemoveUnit(udg_FakeRend)
    call RemoveUnit(udg_FakeZuluhed)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=16
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveUnit(udg_Unit_OutroBlackrockGrunt[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=7
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call RemoveUnit(udg_Unit_CinStormReaverUnitArr[GetForLoopIndexB()])
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeZuljin, GetRectCenter(gg_rct_ZulJeenFinal01), GetRectCenter(gg_rct_ChogalFinal01))
    call SetUnitPositionLocFacingLocBJ(udg_FakeGuldan, GetRectCenter(gg_rct_GuldanFinal01), GetRectCenter(gg_rct_ZulJeenFinal01))
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro02A, udg_Player_Actual, 0.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_BattleGroundA), function Trig_BetreyalCinematicQ_Func018A)
    call TriggerSleepAction(2.00)
    // //
    call SetDoodadAnimationRectBJ("stand", 'YOtf', gg_rct_OutroFireWall)
    call CameraSetupApplyForPlayer(true, gg_cam_Outro02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11ChoGall5))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // //
    call SetDoodadAnimationBJ("death", 'D6AD', 256.00, GetRectCenter(gg_rct_RockCollapse01))
    // //
    call EnumDestructablesInRectAll(gg_rct_OutroTrees, function Trig_BetreyalCinematicQ_Func028A)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_RaminDjawadi___Guldan)
    // //
    // Scene 5 - Betreyal
    // //
    // //
    // //
    call SetUnitAnimation(udg_FakeChogall, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc11ChoGall5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeChogall, "Cinematic Listening One")
    // ***
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Outro03, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11Guldan12), 0, 1.00, 100.00)
    // ***
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc11Guldan12, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Listening One")
    // ***
    call CameraSetupApplyForPlayer(true, gg_cam_Outro03B, udg_Player_Actual, 0.00)
    call SetUnitFacingToFaceUnitTimed(udg_FakeChogall, udg_FakeZuljin, 0.30)
    // ***
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Angry One")
