    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuljin, 0, gg_snd_WC2Orc11Zuljin12, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Listening One")
    // ***
    call CameraSetupApplyForPlayer(true, gg_cam_Outro08, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Outro09, udg_Player_Actual, 7.00, 0, 3.00, 100.00)
    call PlaySoundOnUnitBJ(gg_snd_CS_H01b_Orc_gesture_v2, 100.00, udg_SemiHero_Utok)
    call SetUnitAnimation(udg_FakeUtok, "cinematic salute one")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    call KillDestructable(gg_dest_YTpb_5032)
    // //
