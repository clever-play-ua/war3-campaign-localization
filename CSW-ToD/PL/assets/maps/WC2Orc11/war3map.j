//===========================================================================
// Trigger: WaterColorRunToGreen
//===========================================================================
function Trig_WaterColorRunToGreen_Actions takes nothing returns nothing
    call SetWaterBaseColorBJ(100, 100, 100, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(95.00, 100, 95.00, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(90.00, 100, 90.00, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(85.00, 100, 85.00, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(80.00, 100, 80.00, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(75.00, 100, 75.00, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(70.00, 100, 70.00, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(65.00, 100, 65.00, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(60.00, 100, 60.00, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(55.00, 100, 55.00, 0)
    call TriggerSleepAction(0.25)
    call SetWaterBaseColorBJ(50.00, 100, 50.00, 0)
