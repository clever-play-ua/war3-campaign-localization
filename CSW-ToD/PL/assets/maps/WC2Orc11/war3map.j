//===========================================================================
// Trigger: P20AIElvesSupportDefeated
//===========================================================================
function Trig_P20AIElvesSupportDefeated_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_ElvesSupport ) ) then
        return false
    endif
    return true
endfunction

function Trig_P20AIElvesSupportDefeated_Func005001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'nheb' )
endfunction

function Trig_P20AIElvesSupportDefeated_Func005001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_P20AIElvesSupportDefeated_Func005001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'nheb'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_P20AIElvesSupportDefeated_Func005002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_ElvesSupportBuildings)
endfunction

function Trig_P20AIElvesSupportDefeated_Func008001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_P20AIElvesSupportDefeated_Func008001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_P20AIElvesSupportDefeated_Func008001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_P20AIElvesSupportDefeated_Func008002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_ElvesSupportBuildings)
endfunction

function Trig_P20AIElvesSupportDefeated_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_ElvesSupportBuildings) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P20AIElvesSupportDefeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_ElvesSupportBuildings)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_ElvesSupport, Condition(function Trig_P20AIElvesSupportDefeated_Func005001002)), function Trig_P20AIElvesSupportDefeated_Func005002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_ElvesSupport, Condition(function Trig_P20AIElvesSupportDefeated_Func008001002)), function Trig_P20AIElvesSupportDefeated_Func008002)
    // //
    // //
    if ( Trig_P20AIElvesSupportDefeated_Func011C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_P20Gold)
        call DisableTrigger(gg_trg_P20Lumber)
        // //
        call CommandAI(udg_Player_ElvesMain, udg_P2_COMMAND_GATHER_SOUTH, udg_P2_DATA_GATHER_SOUTH_ENABLE)
        // //
        call CommandAI(udg_Player_ElvesSupport, udg_P20_COMMAND_ATTACK_TROLLS, udg_P20_DATA_ATTACK_TROLLS_DISABLE)
        call TriggerSleepAction(2.00)
        // //
        call CommandAI(udg_Player_ElvesSupport, udg_P20_COMMAND_DEFEAT, udg_P20_DATA_DEFEAT_ENABLE)
        // //
        // //
    else
    endif
    // //
    call GroupClear(udg_Group_ElvesSupportBuildings)
    // //
endfunction

