function InitTrig_DiscoveringElvenQuestQ takes nothing returns nothing
    set gg_trg_DiscoveringElvenQuestQ=CreateTrigger()
    call TriggerAddAction(gg_trg_DiscoveringElvenQuestQ, function Trig_DiscoveringElvenQuestQ_Actions)
endfunction

//===========================================================================
// Trigger: ElvenQuestCompletedTriggered
//===========================================================================
function Trig_ElvenQuestCompletedTriggered_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ElvenQuestCompletedTriggered_Func002Func003001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_ElvesMain )
endfunction

function Trig_ElvenQuestCompletedTriggered_Func002Func003001001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_ElvenQuestCompletedTriggered_Func002Func003001001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_ElvenQuestCompletedTriggered_Func002Func003001001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_ElvenQuestCompletedTriggered_Func002Func003001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_ElvesMain), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_ElvenQuestCompletedTriggered_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_ElvenCampDeathChecker, Condition(function Trig_ElvenQuestCompletedTriggered_Func002Func003001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ElvenQuestCompletedTriggered_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_ElvenQuestCompletedTriggered_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QueuedTriggerAddBJ(gg_trg_ElvenQuestCompletedQ, true)
    else
    endif
endfunction

//===========================================================================
function InitTrig_ElvenQuestCompletedTriggered takes nothing returns nothing
    set gg_trg_ElvenQuestCompletedTriggered=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ElvenQuestCompletedTriggered, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_ElvenQuestCompletedTriggered, Condition(function Trig_ElvenQuestCompletedTriggered_Conditions))
    call TriggerAddAction(gg_trg_ElvenQuestCompletedTriggered, function Trig_ElvenQuestCompletedTriggered_Actions)
endfunction

//===========================================================================
// Trigger: ElvenQuestCompletedQ
//===========================================================================
function Trig_ElvenQuestCompletedQ_Func010C takes nothing returns boolean
    if ( not ( udg_Bool_TrollsDefeated == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ElvenQuestCompletedQ_Func011C takes nothing returns boolean
    if ( not ( udg_Bool_UtokInPit == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ElvenQuestCompletedQ_Func012Func001C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_OQUnicorns) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ElvenQuestCompletedQ_Func012C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQElvenCitadel) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_MQRuneStones) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ElvenQuestCompletedQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_P02AIElvesDefeated)
    call QuestItemSetCompletedBJ(udg_QReq_ElvenCamp, true)
    call QuestSetCompletedBJ(udg_MQElvenCitadel, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_285")
    call DestroyMinimapIcon(udg_MinimapIcon_Elves)
    call DestroyFogModifier(udg_VisMod_QuestElves)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    if ( Trig_ElvenQuestCompletedQ_Func010C() ) then
        call DisableTrigger(gg_trg_TrollsKilled)
        call QuestSetDiscoveredBJ(udg_OQTrollCamp, true)
        call QuestItemSetCompletedBJ(udg_QReq_TrolCamp[1], true)
        call QuestItemSetCompletedBJ(udg_QReq_TrolCamp[2], true)
        call QuestSetCompletedBJ(udg_OQTrollCamp, true)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2961")
        call DestroyMinimapIcon(udg_MinimapIcon_Trolls)
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    else
    endif
    if ( Trig_ElvenQuestCompletedQ_Func011C() ) then
        call QueuedTriggerAddBJ(gg_trg_UtokFallsCinematicQ, true)
    else
    endif
    if ( Trig_ElvenQuestCompletedQ_Func012C() ) then
        if ( Trig_ElvenQuestCompletedQ_Func012Func001C() ) then
            call QueuedTriggerAddBJ(gg_trg_UnicornQuestFailedQ, true)
        else
        endif
        call QueuedTriggerAddBJ(gg_trg_OutroCinematicQ, true)
    else
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_ElvenQuestCompletedQ takes nothing returns nothing
    set gg_trg_ElvenQuestCompletedQ=CreateTrigger()
    call TriggerAddAction(gg_trg_ElvenQuestCompletedQ, function Trig_ElvenQuestCompletedQ_Actions)
endfunction

