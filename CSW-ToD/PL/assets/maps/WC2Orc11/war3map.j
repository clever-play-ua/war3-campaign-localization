    if ( not ( GetHeroLevel(udg_Hero_Guldan) >= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Guldan_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Load_Guldan_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Guldan", "WC2Orc10", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_GulDanStart), GetRectCenter(gg_rct_Chogall01))
        set udg_Hero_Guldan=GetLastRestoredUnitBJ()
        call SetUnitColor(udg_Hero_Guldan, PLAYER_COLOR_BLUE)
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'U60B', udg_Player_Actual, GetRectCenter(gg_rct_GulDanStart), GetRectCenter(gg_rct_Chogall01))
        set udg_Hero_Guldan=GetLastCreatedUnit()
        call SetUnitColor(udg_Hero_Guldan, PLAYER_COLOR_BLUE)
        call SetHeroLevelBJ(udg_Hero_Guldan, 5, false)
        call SelectHeroSkill(udg_Hero_Guldan, 'XAG1')
        call SelectHeroSkill(udg_Hero_Guldan, 'XAG1')
        call SelectHeroSkill(udg_Hero_Guldan, 'XAG2')
        call SelectHeroSkill(udg_Hero_Guldan, 'XAG3')
        call SelectHeroSkill(udg_Hero_Guldan, 'XAG3')
        call SuspendHeroXPBJ(false, udg_Hero_Guldan)
    endif
    call ShowUnitHide(udg_Hero_Guldan)
    call PauseUnitBJ(true, udg_Hero_Guldan)
    // //
    if ( Trig_Load_Guldan_Func006C() ) then
        call SuspendHeroXPBJ(false, udg_Hero_Guldan)
    else
    endif
