    call CameraSetupApplyForPlayer(true, gg_cam_Outro02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc11Guldan13) + GetSoundDurationBJ(gg_snd_WC2Orc11Guldan14) ))
    // ***
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Headshake One")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "Cinematic Standard one")
