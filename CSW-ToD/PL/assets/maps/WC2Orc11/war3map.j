    // Run update leaderboard
    // Special Effect
    call ConditionalTriggerExecute(gg_trg_Guldan_Effect_Stop)
    call ConditionalTriggerExecute(gg_trg_RunestoneWaterKill)
    call ConditionalTriggerExecute(gg_trg_ManaDrainDestroy)
    // AI command to Illidan
    // Give Armor Back
endfunction

//===========================================================================
function InitTrig_Runestone_Water_Timer_Expires takes nothing returns nothing
    set gg_trg_Runestone_Water_Timer_Expires=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Runestone_Water_Timer_Expires, udg_Timer_Water)
    call TriggerAddCondition(gg_trg_Runestone_Water_Timer_Expires, Condition(function Trig_Runestone_Water_Timer_Expires_Conditions))
    call TriggerAddAction(gg_trg_Runestone_Water_Timer_Expires, function Trig_Runestone_Water_Timer_Expires_Actions)
endfunction

//===========================================================================
// Trigger: Runestone Fire Timer Expires
//===========================================================================
function Trig_Runestone_Fire_Timer_Expires_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_Guldan) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Runestone_Fire_Timer_Expires_Actions takes nothing returns nothing
    call ResetUnitAnimation(udg_Hero_Guldan)
    call SetUnitInvulnerable(udg_Hero_Guldan, true)
    set udg_Int_RunestoneOwnedCount=( udg_Int_RunestoneOwnedCount + 1 )
    call DestroyTimerDialogBJ(udg_TimerWindow_Runestone)
    // Decrement
    // Send AI signal
    // Set variables
    set udg_Bool_RunestoneFireOwned=true
    set udg_Bool_GuldanSummoning=false
    // Run update leaderboard
    // Special Effect
    call ConditionalTriggerExecute(gg_trg_Guldan_Effect_Stop)
    call ConditionalTriggerExecute(gg_trg_RunestoneFireKill)
    call ConditionalTriggerExecute(gg_trg_ManaDrainDestroy)
    // AI command to Illidan
    // Give Armor Back
endfunction

//===========================================================================
function InitTrig_Runestone_Fire_Timer_Expires takes nothing returns nothing
    set gg_trg_Runestone_Fire_Timer_Expires=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Runestone_Fire_Timer_Expires, udg_Timer_Fire)
    call TriggerAddCondition(gg_trg_Runestone_Fire_Timer_Expires, Condition(function Trig_Runestone_Fire_Timer_Expires_Conditions))
    call TriggerAddAction(gg_trg_Runestone_Fire_Timer_Expires, function Trig_Runestone_Fire_Timer_Expires_Actions)
endfunction

//===========================================================================
// Trigger: Guldan Damaged Event Registration
//===========================================================================
function Trig_Guldan_Damaged_Event_Registration_Actions takes nothing returns nothing
    call TriggerRegisterUnitEvent(gg_trg_GuldanDamaged, udg_Hero_Guldan, EVENT_UNIT_DAMAGED)
endfunction

//===========================================================================
function InitTrig_Guldan_Damaged_Event_Registration takes nothing returns nothing
    set gg_trg_Guldan_Damaged_Event_Registration=CreateTrigger()
    call TriggerAddAction(gg_trg_Guldan_Damaged_Event_Registration, function Trig_Guldan_Damaged_Event_Registration_Actions)
endfunction

//===========================================================================
// Trigger: GuldanDamaged
//===========================================================================
function Trig_GuldanDamaged_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Guldan) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_GuldanSummoning == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_GuldanDamaged_Actions takes nothing returns nothing
    set udg_Real_GuldanDamageAmount=( GetEventDamage() * 2.00 )
    call SetUnitLifeBJ(udg_Hero_Guldan, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Guldan) - udg_Real_GuldanDamageAmount ))
endfunction

//===========================================================================
function InitTrig_GuldanDamaged takes nothing returns nothing
    set gg_trg_GuldanDamaged=CreateTrigger()
    call TriggerAddCondition(gg_trg_GuldanDamaged, Condition(function Trig_GuldanDamaged_Conditions))
    call TriggerAddAction(gg_trg_GuldanDamaged, function Trig_GuldanDamaged_Actions)
endfunction

