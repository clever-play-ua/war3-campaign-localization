    call CreateNUnitsAtLoc(1, 'HLWC', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeLiressa, bj_UNIT_FACING)
    set udg_FakeLireesa=GetLastCreatedUnit()
