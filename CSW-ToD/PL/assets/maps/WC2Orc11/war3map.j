//===========================================================================
// Trigger: OutroCinDragonFire01
//===========================================================================
function Trig_OutroCinDragonFire01_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OutroCinDragonFire01_Func006001 takes nothing returns boolean
    return ( IsTriggerEnabled(GetTriggeringTrigger()) == false )
endfunction

function Trig_OutroCinDragonFire01_Func020001 takes nothing returns boolean
    return ( IsTriggerEnabled(GetTriggeringTrigger()) == false )
endfunction

function Trig_OutroCinDragonFire01_Actions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ("weapon", udg_Unit_CinDragon[1], "Doodads\\Cinematic\\FireTrapSide\\FireTrapSide.mdl")
    set udg_SE_DragonFlamePuke[1]=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectOrientation(udg_SE_DragonFlamePuke[1], 0.00, - 30.00, 0.0)
    // //
    call TriggerSleepAction(GetRandomReal(1.00, 3.00))
    if ( (IsTriggerEnabled(GetTriggeringTrigger()) == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    set udg_Point_DragonFireSpawn[1]=OffsetLocation(GetUnitLoc(udg_Unit_CinDragon[1]), 0, 400.00)
    // //
    call CreateNUnitsAtLoc(1, 'u602', udg_Player_Actual, udg_Point_DragonFireSpawn[1], bj_UNIT_FACING)
    set udg_Unit_DummyDragonFire[1]=GetLastCreatedUnit()
    // //
    call UnitAddAbilityBJ('XCDF', udg_Unit_DummyDragonFire[1])
    call IssuePointOrderLocBJ(udg_Unit_DummyDragonFire[1], "flamestrike", udg_Point_DragonFireSpawn[1])
    // //
    call DestroyEffectBJ(udg_SE_DragonFlamePuke[1])
    // //
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_Unit_DummyDragonFire[1])
    call TriggerSleepAction(2)
    if ( (IsTriggerEnabled(GetTriggeringTrigger()) == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call RemoveUnit(udg_Unit_DummyDragonFire[1])
    call RemoveLocation(udg_Point_DragonFireSpawn[1])
    // //
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_OutroCinDragonFire01 takes nothing returns nothing
    set gg_trg_OutroCinDragonFire01=CreateTrigger()
    call TriggerAddCondition(gg_trg_OutroCinDragonFire01, Condition(function Trig_OutroCinDragonFire01_Conditions))
    call TriggerAddAction(gg_trg_OutroCinDragonFire01, function Trig_OutroCinDragonFire01_Actions)
endfunction

