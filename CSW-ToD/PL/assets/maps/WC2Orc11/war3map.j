function InitTrig_P20AIElvesSupportDefeated takes nothing returns nothing
    set gg_trg_P20AIElvesSupportDefeated=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_P20AIElvesSupportDefeated, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_P20AIElvesSupportDefeated, Condition(function Trig_P20AIElvesSupportDefeated_Conditions))
    call TriggerAddAction(gg_trg_P20AIElvesSupportDefeated, function Trig_P20AIElvesSupportDefeated_Actions)
