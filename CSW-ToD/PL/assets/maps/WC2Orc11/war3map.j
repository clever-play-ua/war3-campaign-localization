//===========================================================================
// Trigger: Load Chogall
//===========================================================================
function Trig_Load_Chogall_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc10", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Chogall_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Load_Chogall_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Chogall", "WC2Orc10", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_Chogall01), GetRectCenter(gg_rct_GulDanStart))
        set udg_Hero_Chogall=GetLastRestoredUnitBJ()
        call SetUnitColor(udg_Hero_Chogall, PLAYER_COLOR_PURPLE)
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'O61R', udg_Player_Actual, GetRectCenter(gg_rct_Chogall02), GetRectCenter(gg_rct_GulDanStart))
        set udg_Hero_Chogall=GetLastCreatedUnit()
        call SetUnitColor(udg_Hero_Chogall, PLAYER_COLOR_PURPLE)
        call SetHeroLevelBJ(udg_Hero_Chogall, 9, false)
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC2')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC2')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC2')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC1')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC1')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC1')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC3')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC3')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC4')
        call CreateItemLoc('rst1', GetRectCenter(gg_rct_Chogall01))
        call UnitAddItemSwapped(GetLastCreatedItem(), udg_Hero_Chogall)
        call CreateItemLoc('brac', GetRectCenter(gg_rct_Chogall01))
        call UnitAddItemSwapped(GetLastCreatedItem(), udg_Hero_Chogall)
        call CreateItemLoc('I60D', GetRectCenter(gg_rct_Chogall01))
        call UnitAddItemSwapped(GetLastCreatedItem(), udg_Hero_Chogall)
    endif
    call ShowUnitHide(udg_Hero_Chogall)
    call PauseUnitBJ(true, udg_Hero_Chogall)
endfunction

