    set udg_Region_GruntFinalArr[7]=gg_rct_GruntFinal07
    set udg_Region_GruntFinalArr[8]=gg_rct_GruntFinal08
    set udg_Region_GruntFinalArr[9]=gg_rct_GruntFinal09
    set udg_Region_GruntFinalArr[10]=gg_rct_GruntFinal10
