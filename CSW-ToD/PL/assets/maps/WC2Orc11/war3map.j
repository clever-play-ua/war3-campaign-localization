    call ShowUnitShow(gg_unit_nlv1_0178)
    call ShowUnitShow(gg_unit_nlv2_0183)
    call ShowUnitShow(gg_unit_Nfir_0303)
    call PauseUnitBJ(true, gg_unit_nlv1_0178)
    call PauseUnitBJ(true, gg_unit_nlv1_0182)
    call PauseUnitBJ(true, gg_unit_nlv2_0179)
    call PauseUnitBJ(true, gg_unit_nlv2_0183)
    call PauseUnitBJ(true, gg_unit_nlv3_0180)
