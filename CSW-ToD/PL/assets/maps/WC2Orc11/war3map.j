    call QueueUnitAnimationBJ(gg_unit_nlv3_0180, "stand")
    call QueueUnitAnimationBJ(gg_unit_nlv2_0179, "stand")
    call QueueUnitAnimationBJ(gg_unit_nlv1_0178, "stand")
    call QueueUnitAnimationBJ(gg_unit_nlv2_0183, "stand")
    call QueueUnitAnimationBJ(gg_unit_nlv3_0181, "stand")
    call TriggerSleepAction(0.60)
    call PauseUnitBJ(false, gg_unit_Nfir_0303)
    call PauseUnitBJ(false, gg_unit_nlv3_0181)
    call PauseUnitBJ(false, gg_unit_nlv3_0180)
    call PauseUnitBJ(false, gg_unit_nlv2_0183)
    call PauseUnitBJ(false, gg_unit_nlv2_0179)
    call PauseUnitBJ(false, gg_unit_nlv1_0182)
    call PauseUnitBJ(false, gg_unit_nlv1_0178)
    call TriggerSleepAction(2.00)
    call DestroyEffectBJ(udg_SE_Firelordappear)
endfunction

