endfunction

function Trig_UtokFallsCinematicQ_Func065001 takes nothing returns boolean
    return ( udg_Bool_CinUtokSkipped == true )
endfunction

function Trig_UtokFallsCinematicQ_Func074001 takes nothing returns boolean
    return ( udg_Bool_CinUtokSkipped == true )
endfunction

function Trig_UtokFallsCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_UtokFallsCinematicTriggered)
    // //
    if ( Trig_UtokFallsCinematicQ_Func004C() ) then
        call ConditionalTriggerExecute(gg_trg_UtokFallsCinematicSkipped)
        return
    else
    endif
    // //
    set udg_Bool_UtokInPit=true
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, GetPlayersAll())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_UtokFallsCinematicSetUp)
    call TriggerSleepAction(0.50)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidA01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_MidA02, udg_Player_Actual, 5.00, 0, 1.00, 100.00)
    // //
    call TriggerSleepAction(0.25)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call SetDoodadAnimationBJ("death", 'D6AD', 256.00, GetRectCenter(gg_rct_RockCollapse01))
    call TriggerSleepAction(1.00)
    // //
    // CinematicStarted
    // //
    set udg_Bool_CinUtokOn=true
    call PlaySoundBJ(gg_snd_DarkAgents)
    // ***
    call PlaySoundAtPointBJ(gg_snd_BridgeDeath01, 100, GetRectCenter(gg_rct_RockCollapse01), 0)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinUtokSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call KillDestructable(gg_dest_OG10_4610)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinUtokSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic injured two")
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_GuldanLooksAtUtok))
    call SetUnitFacingToFaceLocTimed(udg_FakeUtok, GetRectCenter(gg_rct_GuldanLooksAtUtok), 1.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc11Utok1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinUtokSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidA03CloseUp, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_MidA03, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11Guldan4))
    // //
    call SetUnitLookAt(udg_FakeUtok, "bone_head", udg_FakeGuldan, 0, 0, - 90.00)
    call PauseUnitBJ(true, udg_FakeUtok)
    // //
    call SetUnitLookAt(udg_FakeGuldan, "bone_head", udg_FakeUtok, 0, 0, 0.00)
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc11Guldan4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinUtokSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Listening One")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidA04, udg_Player_Actual, 0)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc11Utok2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinUtokSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidA03, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Wave One")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc11Guldan5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinUtokSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Listening One")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidA04, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_MidA04CloseUp, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11Utok3))
    // //
    call ResetUnitLookAt(udg_FakeGuldan)
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_GuldanLooksAtUtok0))
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc11Utok3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinUtokSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // CinematicEnded
    // //
    call StopSoundBJ(gg_snd_DarkAgents, true)
    call ConditionalTriggerExecute(gg_trg_UtokFallsCinematicCleanUp)
endfunction

