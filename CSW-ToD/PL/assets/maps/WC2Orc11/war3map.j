//===========================================================================
// Trigger: DiscoveringTrollQuestQ
//===========================================================================
function Trig_DiscoveringTrollQuestQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Lireesa, 'H008', gg_snd_WC2Orc11Lireesa_ZuljinBase, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicZuljin, 'O60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc11Zuljin4, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestSetDiscoveredBJ(udg_OQTrollCamp, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_282")
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollsCamp), bj_CAMPPINGSTYLE_PRIMARY_GREEN)
    set udg_MinimapIcon_Trolls=GetLastCreatedMinimapIcon()
    call SetMinimapIconVisible(udg_MinimapIcon_Trolls, true)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_TrollsCamp))
    set udg_Bool_TrollsAttacked=true
    call EnableTrigger(gg_trg_TrollsKilled)
    call ConditionalTriggerExecute(gg_trg_P20SupportStartAttackingTrolls)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

