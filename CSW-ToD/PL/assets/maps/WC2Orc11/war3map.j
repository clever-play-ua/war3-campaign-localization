function InitTrig_TrollsKilled takes nothing returns nothing
    set gg_trg_TrollsKilled=CreateTrigger()
    call DisableTrigger(gg_trg_TrollsKilled)
    call TriggerRegisterTimerEventPeriodic(gg_trg_TrollsKilled, 2)
    call TriggerAddCondition(gg_trg_TrollsKilled, Condition(function Trig_TrollsKilled_Conditions))
    call TriggerAddAction(gg_trg_TrollsKilled, function Trig_TrollsKilled_Actions)
endfunction

