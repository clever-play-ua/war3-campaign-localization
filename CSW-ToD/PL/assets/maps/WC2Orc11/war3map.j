//===========================================================================
// Trigger: OutroArmyMarching
//===========================================================================
function Trig_OutroArmyMarching_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Point_OutroArmyGoesAway=GetRectCenter(gg_rct_UtokBonusCin02)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=16
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call IssuePointOrderLocBJ(udg_Unit_OutroBlackrockGrunt[GetForLoopIndexA()], "move", GetRectCenter(gg_rct_UtokBonusCin02))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveLocation(udg_Point_OutroArmyGoesAway)
endfunction

