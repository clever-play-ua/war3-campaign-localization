//===========================================================================
// Trigger: DiscoveringMainQuest
//===========================================================================
function Trig_DiscoveringMainQuest_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_279")
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_Runestone04Earth), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_RuneEarth=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_Runestone05Fire), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_RuneFire=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_Runestone01Forest), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_RuneForest=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_Runestone02Water), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_RuneWater=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_Runestone03Wind), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_RuneWind=GetLastCreatedMinimapIcon()
    // //
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Runestone01Forest), 5.00)
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Runestone02Water), 5.00)
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Runestone03Wind), 5.00)
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Runestone04Earth), 5.00)
    call PingMinimapLocForForce(GetPlayersAll(), GetRectCenter(gg_rct_Runestone05Fire), 5.00)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

