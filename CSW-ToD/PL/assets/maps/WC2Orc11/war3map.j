function Trig_OutroCinRotateZuluhed_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_FakeZuluhed ) ) then
        return false
    endif
    return true
endfunction

function Trig_OutroCinRotateZuluhed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeZuluhed), GetRectCenter(gg_rct_FinalZuluhed01)) / GetUnitMoveSpeed(udg_FakeZuluhed) ))
    call TriggerSleepAction(0.25)
    call SetUnitFacingTimed(udg_FakeZuluhed, 177.11, 0.50)
endfunction

