//===========================================================================
// Trigger: Light Rain End
//===========================================================================
function Trig_Light_Rain_End_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_Rain_End_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_Rain_End_Actions takes nothing returns nothing
    if ( Trig_Light_Rain_End_Func003C() ) then
        return
    else
    endif
    // RemovePuddles
    call SetDestructableAnimationBJ(gg_dest_B007_7715, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7716, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7717, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7718, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7719, "death")
    call SetDestructableAnimationBJ(gg_dest_B007_7720, "death")
    call EnableWeatherEffect(udg_Weather_RainLight, false)
    call RemoveWeatherEffectBJ(udg_Weather_RainLight)
    set udg_Bool_Raining=false
    call StartTimerBJ(udg_Timer_ChangeWeather, false, GetRandomReal(udg_Real_ChangeWeatherBot, udg_Real_ChangeWeatherTop))
endfunction

//===========================================================================
function InitTrig_Light_Rain_End takes nothing returns nothing
    set gg_trg_Light_Rain_End=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Light_Rain_End, udg_Timer_LightRainDur)
    call TriggerAddCondition(gg_trg_Light_Rain_End, Condition(function Trig_Light_Rain_End_Conditions))
    call TriggerAddAction(gg_trg_Light_Rain_End, function Trig_Light_Rain_End_Actions)
