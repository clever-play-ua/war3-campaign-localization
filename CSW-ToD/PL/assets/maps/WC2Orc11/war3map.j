//===========================================================================
// Trigger: Guldan Dies While Capturing
//===========================================================================
function Trig_Guldan_Dies_While_Capturing_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Hero_Guldan ) ) then
        return false
    endif
    if ( not ( udg_Bool_GuldanSummoning == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guldan_Dies_While_Capturing_Func014C takes nothing returns boolean
    if ( not ( udg_Bool_RunestoneEarthOwned == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guldan_Dies_While_Capturing_Func015C takes nothing returns boolean
    if ( not ( udg_Bool_RunestoneForestOwned == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guldan_Dies_While_Capturing_Func016C takes nothing returns boolean
    if ( not ( udg_Bool_RunestoneWindOwned == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guldan_Dies_While_Capturing_Func018C takes nothing returns boolean
    if ( not ( udg_Bool_RunestoneWaterOwned == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guldan_Dies_While_Capturing_Func019C takes nothing returns boolean
    if ( not ( udg_Bool_RunestoneFireOwned == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Guldan_Dies_While_Capturing_Actions takes nothing returns nothing
    call DestroyTimerDialogBJ(udg_TimerWindow_Runestone)
    call PauseTimerBJ(true, udg_Timer_Earth)
    call PauseTimerBJ(true, udg_Timer_Forest)
    call PauseTimerBJ(true, udg_Timer_Wind)
    call PauseTimerBJ(true, udg_Timer_Water)
    call PauseTimerBJ(true, udg_Timer_Fire)
    call PauseUnitBJ(false, udg_Hero_Guldan)
    set udg_Bool_GuldanSummoning=false
    call StopMusicBJ(false)
    // Reset Obelisk Animations
    if ( Trig_Guldan_Dies_While_Capturing_Func014C() ) then
        call SetUnitAnimationWithRarity(gg_unit_n60R_0012, "stand", RARITY_RARE)
    else
        call SetUnitAnimationWithRarity(gg_unit_n60R_0012, "stand alternate", RARITY_RARE)
    endif
    if ( Trig_Guldan_Dies_While_Capturing_Func015C() ) then
        call SetUnitAnimationWithRarity(gg_unit_n60R_0010, "stand", RARITY_RARE)
    else
        call SetUnitAnimationWithRarity(gg_unit_n60R_0010, "stand alternate", RARITY_RARE)
    endif
    if ( Trig_Guldan_Dies_While_Capturing_Func016C() ) then
        call SetUnitAnimationWithRarity(gg_unit_n60R_0013, "stand", RARITY_RARE)
    else
        call SetUnitAnimationWithRarity(gg_unit_n60R_0013, "stand alternate", RARITY_RARE)
    endif
    // ****
    if ( Trig_Guldan_Dies_While_Capturing_Func018C() ) then
        call SetUnitAnimationWithRarity(gg_unit_n60R_0011, "stand", RARITY_RARE)
    else
    endif
    if ( Trig_Guldan_Dies_While_Capturing_Func019C() ) then
        call SetUnitAnimationWithRarity(gg_unit_n60R_0014, "stand", RARITY_RARE)
    else
    endif
    // Special Effect
    call ConditionalTriggerExecute(gg_trg_Guldan_Effect_Stop)
    call ConditionalTriggerExecute(gg_trg_ManaDrainDestroy)
    // Give Armor Back
    call ModifyHeroStat(bj_HEROSTAT_AGI, udg_Hero_Guldan, bj_MODIFYMETHOD_ADD, 15)
endfunction

//===========================================================================
function InitTrig_Guldan_Dies_While_Capturing takes nothing returns nothing
    set gg_trg_Guldan_Dies_While_Capturing=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Guldan_Dies_While_Capturing, Player(0), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Guldan_Dies_While_Capturing, Condition(function Trig_Guldan_Dies_While_Capturing_Conditions))
    call TriggerAddAction(gg_trg_Guldan_Dies_While_Capturing, function Trig_Guldan_Dies_While_Capturing_Actions)
endfunction

