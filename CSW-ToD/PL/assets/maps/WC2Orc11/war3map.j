    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokFallsCinematicSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call SetPlayerTechMaxAllowedSwap('o605', 0, udg_Player_Actual)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_UtokFallsCinematicSetUp_Func006001002)), function Trig_UtokFallsCinematicSetUp_Func006A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_ElvesMain, Condition(function Trig_UtokFallsCinematicSetUp_Func008001002)), function Trig_UtokFallsCinematicSetUp_Func008A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Magisters, Condition(function Trig_UtokFallsCinematicSetUp_Func010001002)), function Trig_UtokFallsCinematicSetUp_Func010A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Farstriders, Condition(function Trig_UtokFallsCinematicSetUp_Func012001002)), function Trig_UtokFallsCinematicSetUp_Func012A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Trolls, Condition(function Trig_UtokFallsCinematicSetUp_Func014001002)), function Trig_UtokFallsCinematicSetUp_Func014A)
    // //
    call GroupRemoveUnitSimple(udg_SemiHero_Utok, udg_Group_PausedUnits)
    // //
    call ForGroupBJ(udg_Group_PausedUnits, function Trig_UtokFallsCinematicSetUp_Func018002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_UtokCinematicUnitsHidden, Condition(function Trig_UtokFallsCinematicSetUp_Func021001002)), function Trig_UtokFallsCinematicSetUp_Func021A)
    // //
    call ForGroupBJ(udg_Group_CinHiddenUnits, function Trig_UtokFallsCinematicSetUp_Func023002)
    call ForGroupBJ(udg_Group_CinHiddenUnits, function Trig_UtokFallsCinematicSetUp_Func024002)
    // //
    if ( Trig_UtokFallsCinematicSetUp_Func026C() ) then
        call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_UtokWounded), GetRectCenter(gg_rct_UtokWounded))
        call SetUnitOwner(udg_SemiHero_Utok, udg_Player_Utok, true)
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'o605', udg_Player_Utok, GetRectCenter(gg_rct_UtokWounded), GetRectCenter(gg_rct_UtokWounded))
        set udg_SemiHero_Utok=GetLastCreatedUnit()
    endif
    // //
    call ShowUnitHide(udg_SemiHero_Utok)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokWalksIntoDitch), 200.00)
    call SetUnitPositionLocFacingLocBJ(udg_FakeGuldan, GetRectCenter(gg_rct_GuldanLooksAtUtok0), GetRectCenter(gg_rct_GuldanLooksAtUtok))
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_UtokWounded))
    // //
endfunction

