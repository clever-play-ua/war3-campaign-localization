//===========================================================================
// Trigger: RunestoneCinematicWind
//===========================================================================
function Trig_RunestoneCinematicWind_Func029001 takes nothing returns boolean
    return ( udg_Bool_CinRuestoneSkipped == true )
endfunction

function Trig_RunestoneCinematicWind_Func039001 takes nothing returns boolean
    return ( udg_Bool_CinRuestoneSkipped == true )
endfunction

function Trig_RunestoneCinematicWind_Func056001 takes nothing returns boolean
    return ( udg_Bool_CinRuestoneSkipped == true )
endfunction

function Trig_RunestoneCinematicWind_Actions takes nothing returns nothing
    // //
    set udg_Bool_CinRuestoneSkipped=false
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidCapWindFace01, udg_Player_Actual, 0)
    call ConditionalTriggerExecute(gg_trg_PentagramZoneSetUpCinematic)
    call PlaySoundBJ(gg_snd_Demonic_Theme_4)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidCapWindFace02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11Guldan8))
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    // //
    set udg_Bool_CinRunestoneOn=true
    // //
    set udg_Int_RunedShardVersion=5
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_RunestonesControlPanel), "Abilities\\Spells\\Undead\\Darksummoning\\DarkSummonTarget.mdl")
    set udg_SE_GuldanTeleport_A=GetLastCreatedEffectBJ()
    // //
    call SetUnitFacingTimed(udg_FakeGuldan, 145.00, 0)
    call PauseUnitBJ(true, udg_FakeGuldan)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinRuestoneSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitPositionLoc(udg_FakeGuldan, udg_Point_PentagramControlPanel)
    set udg_Bool_RunestoneMove=true
    // //
    call SetUnitAnimation(udg_FakeGuldan, "stand ready")
    call DestroyEffectBJ(udg_SE_GuldanTeleport_A)
    // //
    // Dialogue
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc11Guldan8, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinRuestoneSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_MidCapWind, udg_Player_Actual, 0)
    // //
    call SetUnitBlendTimeBJ(udg_FakeGuldan, 0.25)
    call SetUnitAnimation(udg_FakeGuldan, "spell")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "stand ready")
    set udg_Bool_GuldanTalkWind=true
    // //
    call AddSpecialEffectLocBJ(GetUnitLoc(gg_unit_npgr_0279), "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl")
    set udg_SE_RunestoneShardEffect=GetLastCreatedEffectBJ()
    // //
    call ReplaceUnitBJ(gg_unit_npgr_0279, 'n009', bj_UNIT_STATE_METHOD_RELATIVE)
    set udg_Bool_RunedShardReplaced=true
    // //
    call StopSoundBJ(gg_snd_Demonic_Theme_4, true)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinRuestoneSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Quest
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_RunestoneCinematicCleanUp)
endfunction

//===========================================================================
function InitTrig_RunestoneCinematicWind takes nothing returns nothing
    set gg_trg_RunestoneCinematicWind=CreateTrigger()
    call TriggerAddAction(gg_trg_RunestoneCinematicWind, function Trig_RunestoneCinematicWind_Actions)
endfunction

