    call SetUnitMoveSpeed(udg_FakeMaim, udg_Real_CinWalkSpeed150)
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    call SetUnitColor(udg_FakeMaim, PLAYER_COLOR_COAL)
