    endif
    return true
endfunction

function Trig_RunestoneCinematicCleanUp_Func020C takes nothing returns boolean
    if ( not ( udg_Bool_RunedShardReplaced == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_RunestoneCinematicCleanUp_Func028C takes nothing returns boolean
    if ( not ( udg_Int_RunestoneOwnedCount >= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RunestoneCinematicCleanUp_Actions takes nothing returns nothing
    call QueuedTriggerRemoveBJ(gg_trg_RunestoneCinematicWind)
    call QueuedTriggerRemoveBJ(gg_trg_RunestoneCinematicEarth)
    call QueuedTriggerRemoveBJ(gg_trg_RunestoneCinematicFire)
    call QueuedTriggerRemoveBJ(gg_trg_RunestoneCinematicForest)
    call QueuedTriggerRemoveBJ(gg_trg_RunestoneCinematicWater)
    // //
    set udg_Bool_CinRunestoneOn=false
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    // //
    call ConditionalTriggerExecute(gg_trg_PentagramZoneCleanUpCinematic)
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    call DestroyEffectBJ(udg_SE_GuldanTeleport_A)
    // //
    if ( Trig_RunestoneCinematicCleanUp_Func018C() ) then
        if ( Trig_RunestoneCinematicCleanUp_Func018Func001C() ) then
            call SetUnitFacingTimed(udg_Hero_Guldan, 80.00, 0)
            call SetUnitPositionLoc(udg_Hero_Guldan, GetRectCenter(gg_rct_RunestonesControlPanel))
        else
            if ( Trig_RunestoneCinematicCleanUp_Func018Func001Func001C() ) then
                call SetUnitFacingTimed(udg_Hero_Guldan, 300.00, 0)
                call SetUnitPositionLoc(udg_Hero_Guldan, GetRectCenter(gg_rct_RunestonesControlPanel))
            else
                if ( Trig_RunestoneCinematicCleanUp_Func018Func001Func001Func001C() ) then
                    call SetUnitFacingTimed(udg_Hero_Guldan, 220.00, 0)
                    call SetUnitPositionLoc(udg_Hero_Guldan, GetRectCenter(gg_rct_RunestonesControlPanel))
                else
                    if ( Trig_RunestoneCinematicCleanUp_Func018Func001Func001Func001Func001C() ) then
                        call SetUnitFacingTimed(udg_Hero_Guldan, 15.00, 0)
                        call SetUnitPositionLoc(udg_Hero_Guldan, GetRectCenter(gg_rct_RunestonesControlPanel))
                    else
                        if ( Trig_RunestoneCinematicCleanUp_Func018Func001Func001Func001Func001Func001C() ) then
                            call SetUnitFacingTimed(udg_Hero_Guldan, 145.00, 0)
                            call SetUnitPositionLoc(udg_Hero_Guldan, GetRectCenter(gg_rct_RunestonesControlPanel))
                        else
                        endif
                    endif
                endif
            endif
        endif
    else
    endif
    // //
    if ( Trig_RunestoneCinematicCleanUp_Func020C() ) then
        if ( Trig_RunestoneCinematicCleanUp_Func020Func001C() ) then
            call ReplaceUnitBJ(gg_unit_npgr_0318, 'n00C', bj_UNIT_STATE_METHOD_RELATIVE)
        else
            if ( Trig_RunestoneCinematicCleanUp_Func020Func001Func002C() ) then
                call ReplaceUnitBJ(gg_unit_npgr_0317, 'n00B', bj_UNIT_STATE_METHOD_RELATIVE)
            else
                if ( Trig_RunestoneCinematicCleanUp_Func020Func001Func002Func002C() ) then
                    call ReplaceUnitBJ(gg_unit_npgr_0316, 'n00A', bj_UNIT_STATE_METHOD_RELATIVE)
                else
                    if ( Trig_RunestoneCinematicCleanUp_Func020Func001Func002Func002Func002C() ) then
                        call ReplaceUnitBJ(gg_unit_npgr_0319, 'n008', bj_UNIT_STATE_METHOD_RELATIVE)
                    else
                        if ( Trig_RunestoneCinematicCleanUp_Func020Func001Func002Func002Func002Func002C() ) then
                            call ReplaceUnitBJ(gg_unit_npgr_0279, 'n009', bj_UNIT_STATE_METHOD_RELATIVE)
                        else
                        endif
                    endif
                endif
            endif
        endif
    else
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call TriggerSleepAction(0.25)
    call SetUnitInvulnerable(udg_Hero_Guldan, false)
    call PauseUnitBJ(false, udg_Hero_Guldan)
    call IssueImmediateOrderBJ(udg_Hero_Guldan, "stop")
    // //
    if ( Trig_RunestoneCinematicCleanUp_Func028C() ) then
        set udg_Var_PlayerCamera=gg_cam_Pentagram
        call SetUnitPositionLocFacingBJ(udg_Hero_Guldan, GetRectCenter(gg_rct_RunestonesControlPanel), bj_UNIT_FACING)
    else
    endif
    // //
    call CameraSetupApplyForPlayer(true, udg_Var_PlayerCamera, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    call CinematicModeBJ(false, GetPlayersAll())
    call DestroyEffectBJ(udg_SE_RunestoneShardEffect)
    set udg_Bool_RunedShardReplaced=false
    set udg_Bool_RunestoneMove=false
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    call SuspendHeroXPBJ(true, udg_Hero_Guldan)
    call SetHeroLevelBJ(udg_Hero_Guldan, ( GetHeroLevel(udg_Hero_Guldan) + 1 ), true)
    call SuspendHeroXPBJ(false, udg_Hero_Guldan)
    // //
    // //
endfunction

