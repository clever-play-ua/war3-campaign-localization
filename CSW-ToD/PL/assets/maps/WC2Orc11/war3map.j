//===========================================================================
// Trigger: ProduceCitizens
//===========================================================================
function Trig_ProduceCitizens_Func004C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nefm' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nef0' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nef1' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nef2' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nef3' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nef4' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nef5' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nef6' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'nef7' ) ) then
        return true
    endif
    return false
endfunction

function Trig_ProduceCitizens_Conditions takes nothing returns boolean
    if ( not Trig_ProduceCitizens_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_ProduceCitizens_Func002Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ProduceCitizens_Func002C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 3) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ProduceCitizens_Actions takes nothing returns nothing
    set udg_Point_ProduceCitizensDying=GetUnitLoc(GetDyingUnit())
    if ( Trig_ProduceCitizens_Func002C() ) then
        call CreateNUnitsAtLoc(1, 'nhef', GetOwningPlayer(GetDyingUnit()), udg_Point_ProduceCitizensDying, GetRandomDirectionDeg())
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_ElvenRefugees)
        set udg_Point_ProduceCitizensRandom=GetRandomLocInRect(gg_rct_EscapeA)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_ProduceCitizensRandom)
        call RemoveLocation(udg_Point_ProduceCitizensRandom)
        // -------------------
        call CreateNUnitsAtLoc(1, 'nhem', GetOwningPlayer(GetDyingUnit()), udg_Point_ProduceCitizensDying, GetRandomDirectionDeg())
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_ElvenRefugees)
        set udg_Point_ProduceCitizensRandom=GetRandomLocInRect(gg_rct_EscapeA)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_ProduceCitizensRandom)
        call RemoveLocation(udg_Point_ProduceCitizensRandom)
    else
        if ( Trig_ProduceCitizens_Func002Func001C() ) then
            call CreateNUnitsAtLoc(1, 'nhef', GetOwningPlayer(GetDyingUnit()), udg_Point_ProduceCitizensDying, GetRandomDirectionDeg())
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_ElvenRefugees)
            set udg_Point_ProduceCitizensRandom=GetRandomLocInRect(gg_rct_EscapeA)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_ProduceCitizensRandom)
            call RemoveLocation(udg_Point_ProduceCitizensRandom)
        else
            call CreateNUnitsAtLoc(1, 'nhem', GetOwningPlayer(GetDyingUnit()), udg_Point_ProduceCitizensDying, GetRandomDirectionDeg())
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_ElvenRefugees)
            set udg_Point_ProduceCitizensRandom=GetRandomLocInRect(gg_rct_EscapeA)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_ProduceCitizensRandom)
            call RemoveLocation(udg_Point_ProduceCitizensRandom)
        endif
    endif
    call RemoveLocation(udg_Point_ProduceCitizensDying)
endfunction

//===========================================================================
function InitTrig_ProduceCitizens takes nothing returns nothing
    set gg_trg_ProduceCitizens=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ProduceCitizens, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_ProduceCitizens, Condition(function Trig_ProduceCitizens_Conditions))
    call TriggerAddAction(gg_trg_ProduceCitizens, function Trig_ProduceCitizens_Actions)
endfunction

