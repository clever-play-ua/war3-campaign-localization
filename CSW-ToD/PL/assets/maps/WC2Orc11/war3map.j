//===========================================================================
function Trig_On_screen_Func001C takes nothing returns boolean
    if ( not ( udg_BoolCheat_VisibilityOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_On_screen_Actions takes nothing returns nothing
    if ( Trig_On_screen_Func001C() ) then
        set udg_BoolCheat_VisibilityOn=true
        call FogMaskEnableOff()
        call FogEnableOff()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_3556")
    else
        set udg_BoolCheat_VisibilityOn=false
        call FogMaskEnableOn()
        call FogEnableOn()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_3557")
    endif
endfunction

