    call CameraSetupApplyForPlayer(true, gg_cam_Outro08B, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc11xTharbek3))
    // ***
    call SetUnitAnimation(udg_FakeTharbek, "Cinematic Standard Two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc11xTharbek3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
