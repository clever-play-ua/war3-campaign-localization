function Trig_FinalCinematicSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // Killing trolls AI for sure
    call CommandAI(udg_Player_Trolls, udg_P11_COMMAND_DEFEAT, udg_P11_DATA_DEFEAT_ENABLE)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_ElvesMain, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_ElvesMain, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    // SettingZones/
    call EnableWeatherEffect(udg_Weather_RaysOfMoonLight, false)
    call RemoveWeatherEffectBJ(udg_Weather_RaysOfMoonLight)
    call EnableWeatherEffect(udg_Weather_RaysOfSunLight, false)
    call RemoveWeatherEffectBJ(udg_Weather_RaysOfSunLight)
    call EnableWeatherEffect(udg_Weather_RainLight, false)
    call RemoveWeatherEffectBJ(udg_Weather_RainLight)
    call EnableWeatherEffect(udg_Weather_Wind, false)
    call RemoveWeatherEffectBJ(udg_Weather_Wind)
    call RemoveDestructable(gg_dest_B60R_9639)
    call RemoveDestructable(gg_dest_B60R_9640)
    call RemoveDestructable(gg_dest_LTba_9641)
    call RemoveDestructable(gg_dest_YTpb_5032)
    // Grunts
    set udg_Region_GruntFinalArr[1]=gg_rct_GruntFinal01
    set udg_Region_GruntFinalArr[2]=gg_rct_GruntFinal02
