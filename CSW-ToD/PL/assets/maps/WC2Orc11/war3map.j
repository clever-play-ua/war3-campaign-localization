//===========================================================================
// Trigger: SpellMarkOfTheGrove
//===========================================================================
function Trig_SpellMarkOfTheGrove_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDecayingUnit()) == 'eDRB' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('REGM', GetOwningPlayer(GetDecayingUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SpellMarkOfTheGrove_Func009C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_SpellMarkOfTheGrove_Actions takes nothing returns nothing
    set udg_Point_MarkOfTheGrove=GetUnitLoc(GetDecayingUnit())
    // //
    call AddSpecialEffectLocBJ(udg_Point_MarkOfTheGrove, "objects\\spawnmodels\\nightelf\\entbirthtarget\\entbirthtarget.mdl")
    set udg_SE_MarkOfTheGrove=GetLastCreatedEffectBJ()
    // //
    call CreateNUnitsAtLoc(1, 'eTRE', GetOwningPlayer(GetDecayingUnit()), udg_Point_MarkOfTheGrove, GetRandomDirectionDeg())
    call SetUnitAnimation(GetLastCreatedUnit(), "birth")
    call QueueUnitAnimationBJ(GetLastCreatedUnit(), "stand")
    if ( Trig_SpellMarkOfTheGrove_Func009C() ) then
        call UnitApplyTimedLifeBJ(55.00, 'BEfn', GetLastCreatedUnit())
    else
        call UnitApplyTimedLifeBJ(40.00, 'BEfn', GetLastCreatedUnit())
    endif
    call RemoveUnit(GetDecayingUnit())
    // //
    call RemoveLocation(udg_Point_MarkOfTheGrove)
    call DestroyEffect(udg_SE_MarkOfTheGrove)
endfunction

