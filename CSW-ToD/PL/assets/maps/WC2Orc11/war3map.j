       call SetSoundFacialAnimationSetFilepath(soundHandle, "units/creeps/ogre/ogre_portrait.sd.animset_ingame")
    elseif ( soundDuration >= 1.440 ) then
       call SetSoundFacialAnimationLabel(soundHandle, "OgreWhat2")
