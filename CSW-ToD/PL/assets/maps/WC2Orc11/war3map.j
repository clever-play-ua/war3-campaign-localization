//===========================================================================
// Trigger: InitQuests
//===========================================================================
function Trig_InitQuests_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // RequiredQuests
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_265", "TRIGSTR_266", "ReplaceableTextures\\CommandButtons\\BTNRunestone.blp")
    set udg_MQRuneStones=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQRuneStones, "TRIGSTR_271")
    set udg_QReq_RSEarth=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQRuneStones, "TRIGSTR_2949")
    set udg_QReq_RSFire=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQRuneStones, "TRIGSTR_2950")
    set udg_QReq_RSForest=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQRuneStones, "TRIGSTR_272")
    set udg_QReq_RSWater=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQRuneStones, "TRIGSTR_274")
    set udg_QReq_RSWind=GetLastCreatedQuestItemBJ()
    // Elves
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_269", "TRIGSTR_270", "ReplaceableTextures\\CommandButtons\\BTNLiressaWindrunner.dds")
    set udg_MQElvenCitadel=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQElvenCitadel, "TRIGSTR_278")
    set udg_QReq_ElvenCamp=GetLastCreatedQuestItemBJ()
    // Trolls
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2729", "TRIGSTR_2730", "ReplaceableTextures\\CommandButtons\\BTNZuljin.BLP")
    set udg_OQTrollCamp=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQTrollCamp, "TRIGSTR_2731")
    set udg_QReq_TrolCamp[1]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_OQTrollCamp, "TRIGSTR_2732")
    set udg_QReq_TrolCamp[2]=GetLastCreatedQuestItemBJ()
    // Unicorns
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2735", "TRIGSTR_2736", "ReplaceableTextures\\CommandButtons\\BTNUnicorn.blp")
    set udg_OQUnicorns=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQUnicorns, "TRIGSTR_2737")
    set udg_QReq_Unicorns=GetLastCreatedQuestItemBJ()
endfunction

