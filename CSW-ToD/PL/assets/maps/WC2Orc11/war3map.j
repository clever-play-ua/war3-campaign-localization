//===========================================================================
function Trig_OutroCinRotateDoomhammer_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_FakeDoomhammer ) ) then
        return false
    endif
    return true
endfunction

function Trig_OutroCinRotateDoomhammer_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_FakeDoomhammer), GetRectCenter(gg_rct_FinalDoomhammer01)) / GetUnitMoveSpeed(udg_FakeDoomhammer) ))
    call TriggerSleepAction(0.75)
    call SetUnitFacingTimed(udg_FakeDoomhammer, 203.74, 0.50)
endfunction

