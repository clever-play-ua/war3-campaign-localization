//===========================================================================
function InitTrig_IntroCinematic takes nothing returns nothing
    set gg_trg_IntroCinematic=CreateTrigger()
    call TriggerAddAction(gg_trg_IntroCinematic, function Trig_IntroCinematic_Actions)
endfunction

//===========================================================================
// Trigger: IntroCinSetUp
//===========================================================================
function Trig_IntroCinSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // Setup Actors
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeGuldan, GetRectCenter(gg_rct_GulDanStart), 307.83)
    // /
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_Chogall01), 170.27)
    // /
    call SetUnitPositionLocFacingBJ(udg_FakeZuljin, GetRectCenter(gg_rct_ZuljinIntro01), 21.77)
    // /
    call CreateNUnitsAtLocFacingLocBJ(1, 'n006', Player(10), GetRectCenter(gg_rct_ATrollIntro01), GetRectCenter(gg_rct_UtokStart))
    set udg_Unit_CinMeleeTroll[1]=GetLastCreatedUnit()
    call RemoveGuardPosition(GetLastCreatedUnit())
    // /
    call CreateNUnitsAtLocFacingLocBJ(1, 'n006', Player(10), GetRectCenter(gg_rct_BTrollIntro01), GetRectCenter(gg_rct_UtokStart))
    set udg_Unit_CinMeleeTroll[2]=GetLastCreatedUnit()
    call RemoveGuardPosition(GetLastCreatedUnit())
    // /
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokStart), 256.27)
    // /
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_u000_0030)
    call BlzSetUnitRealFieldBJ(gg_unit_u000_0030, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitMoveSpeed(gg_unit_u000_0030, udg_Real_CinWalkSpeed150)
    // /
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_u000_0272)
    call BlzSetUnitRealFieldBJ(gg_unit_u000_0272, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitMoveSpeed(gg_unit_u000_0272, udg_Real_CinWalkSpeed150)
    // /
    call SetUnitLookAt(udg_FakeGuldan, "bone_head", udg_FakeChogall, 0, 0, 90)
    // //
endfunction

//===========================================================================
function InitTrig_IntroCinSetUp takes nothing returns nothing
    set gg_trg_IntroCinSetUp=CreateTrigger()
    call TriggerAddAction(gg_trg_IntroCinSetUp, function Trig_IntroCinSetUp_Actions)
endfunction

//===========================================================================
// Trigger: IntroSkipped
//===========================================================================
function Trig_IntroSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    call ConditionalTriggerExecute(gg_trg_IntroCleanUp)
    call StopSoundBJ(gg_snd_RaminDjawadi___Guldan, false)
    call StopSoundBJ(gg_snd_WC2Orc11Guldan1, false)
    call StopSoundBJ(gg_snd_WC2Orc11Guldan2, false)
    call StopSoundBJ(gg_snd_WC2Orc11Guldan3, false)
    call StopSoundBJ(gg_snd_WC2Orc11Zuljin1, false)
    call StopSoundBJ(gg_snd_WC2Orc11Zuljin2, false)
    call StopSoundBJ(gg_snd_WC2Orc11ChoGall1, false)
    call StopSoundBJ(gg_snd_WC2Orc11ChoGall2, false)
    call StopSoundBJ(gg_snd_WC2Orc11ChoGall3, false)
endfunction

//===========================================================================
function InitTrig_IntroSkipped takes nothing returns nothing
    set gg_trg_IntroSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_IntroSkipped, Player(0))
    call TriggerAddCondition(gg_trg_IntroSkipped, Condition(function Trig_IntroSkipped_Conditions))
    call TriggerAddAction(gg_trg_IntroSkipped, function Trig_IntroSkipped_Actions)
endfunction

//===========================================================================
// Trigger: IntroCleanUp
//===========================================================================
function Trig_IntroCleanUp_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_IntroTulips == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroOn=false
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    if ( Trig_IntroCleanUp_Func007C() ) then
        call TriggerExecute(gg_trg_TulipsDie)
    else
    endif
    // //
    // ResetActors
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call ShowUnitShow(udg_Hero_Chogall)
    call PauseUnitBJ(false, udg_Hero_Chogall)
    // /
    call ShowUnitShow(udg_Hero_Guldan)
    call PauseUnitBJ(false, udg_Hero_Guldan)
    // /
    call RemoveUnit(udg_Unit_CinMeleeTroll[1])
    call RemoveUnit(udg_Unit_CinMeleeTroll[2])
    call RecycleGuardPosition(udg_Hero_ZulJeen)
    // /
    call ShowUnitShow(udg_SemiHero_Utok)
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    call SetUnitOwner(udg_SemiHero_Utok, udg_Player_Actual, false)
    // /
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_u000_0030)
    call BlzSetUnitRealFieldBJ(gg_unit_u000_0030, UNIT_RF_ANIMATION_WALK_SPEED, 380.00)
    call SetUnitMoveSpeed(gg_unit_u000_0030, GetUnitDefaultMoveSpeed(gg_unit_u000_0030))
    // /
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_u000_0272)
    call BlzSetUnitRealFieldBJ(gg_unit_u000_0272, UNIT_RF_ANIMATION_WALK_SPEED, 380.00)
    call SetUnitMoveSpeed(gg_unit_u000_0272, GetUnitDefaultMoveSpeed(gg_unit_u000_0272))
    // /
    call RemoveUnit(gg_unit_H006_0476)
    // //
    // ResetFog
    // //
    call SetTerrainFogExBJ(0, 1500.00, 5000.00, 0.50, 88.20, 60.78, 9.38)
    // //
    // //
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call TriggerSleepAction(0.01)
    call CameraSetupApplyForPlayer(true, gg_cam_IntroGameCam, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // //
    call ResetUnitAnimation(gg_unit_o60L_0021)
    // //
    // Reset Selection
    call SelectUnitForPlayerSingle(udg_Hero_Guldan, udg_Player_Actual)
    call SelectUnitAddForPlayer(udg_Hero_Chogall, udg_Player_Actual)
    // //
    call ConditionalTriggerExecute(gg_trg_Creating_and_Setting_Weather)
    call ConditionalTriggerExecute(gg_trg_P02StartAI)
    call ConditionalTriggerExecute(gg_trg_P20StartAI)
    call QueuedTriggerAddBJ(gg_trg_DiscoveringMainQuest, true)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    // //
    // //
endfunction

