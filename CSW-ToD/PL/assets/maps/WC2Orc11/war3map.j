    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_P02StartAI_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call AdjustPlayerStateBJ(30000, udg_Player_ElvesMain, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(30000, udg_Player_ElvesMain, PLAYER_STATE_RESOURCE_LUMBER)
    // //
    // //
    call ForGroupBJ(udg_Group_P02GoldWorkers, function Trig_P02StartAI_Func007002)
    // //
    // //
    // //
    call StartCampaignAI(udg_Player_ElvesMain, "CSW\\Scripts\\ToDScripts\\WC2Orc11\\WC2Orc11ElvesAdvancedAI.ai")
    // //
    call CommandAI(udg_Player_ElvesMain, udg_P2_COMMAND_ATTACK_TROLLS, udg_P2_DATA_ATTACK_TROLLS_ENABLE)
    // //
    // //
    // //
endfunction

