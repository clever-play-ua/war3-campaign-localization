       call SetSoundFacialAnimationSetFilepath(soundHandle, "units/creeps/ogre/ogre_portrait.sd.animset_ingame")
    elseif ( soundDuration >= 1.411 ) then
       call SetSoundFacialAnimationLabel(soundHandle, "OgreYes2")
       call SetSoundFacialAnimationGroupLabel(soundHandle, "BaseSD")
       call SetSoundFacialAnimationSetFilepath(soundHandle, "units/creeps/ogre/ogre_portrait.sd.animset_ingame")
    elseif ( soundDuration >= 1.097 ) then
       call SetSoundFacialAnimationLabel(soundHandle, "OgreWhat4")
       call SetSoundFacialAnimationGroupLabel(soundHandle, "BaseSD")
       call SetSoundFacialAnimationSetFilepath(soundHandle, "units/creeps/ogre/ogre_portrait.sd.animset_ingame")
    elseif ( soundDuration >= 1.065 ) then
       call SetSoundFacialAnimationLabel(soundHandle, "OgreWhat3")
