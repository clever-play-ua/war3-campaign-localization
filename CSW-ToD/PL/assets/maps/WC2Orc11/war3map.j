//===========================================================================
function Trig_CreateFakeActors_Actions takes nothing returns nothing
    // //
    call CreateNUnitsAtLoc(1, 'OMDC', udg_Player_Utok, udg_Point_SpawnFakeOrgrim, bj_UNIT_FACING)
    set udg_FakeDoomhammer=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeDoomhammer, 0.50)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeDoomhammer)
    call BlzSetUnitRealFieldBJ(udg_FakeDoomhammer, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitMoveSpeed(udg_FakeDoomhammer, udg_Real_CinWalkSpeed150)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    call SuspendHeroXPBJ(false, udg_FakeDoomhammer)
    // //
    call CreateNUnitsAtLoc(1, 'o608', udg_Player_Utok, udg_Point_SpawnFakeTharbek, bj_UNIT_FACING)
    set udg_FakeTharbek=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeTharbek, 0.50)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeTharbek)
    call BlzSetUnitRealFieldBJ(udg_FakeTharbek, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitMoveSpeed(udg_FakeTharbek, udg_Real_CinWalkSpeed150)
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
    call CreateNUnitsAtLoc(1, 'o605', udg_Player_Utok, udg_Point_SpawnFakeUtok, bj_UNIT_FACING)
    set udg_FakeUtok=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    // //
    call CreateNUnitsAtLoc(1, 'OWGC', udg_Player_CinematicGuldan, udg_Point_SpawnFakeGuldan, bj_UNIT_FACING)
    set udg_FakeGuldan=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeGuldan, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeGuldan)
    call BlzSetUnitRealFieldBJ(udg_FakeGuldan, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitMoveSpeed(udg_FakeGuldan, udg_Real_CinWalkSpeed150)
