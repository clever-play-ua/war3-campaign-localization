    set udg_Region_OrgeFinalArr[18]=gg_rct_OgreFinal18
    set udg_Region_OrgeFinalArr[19]=gg_rct_OgreFinal19
    set udg_Region_OrgeFinalArr[20]=gg_rct_OgreFinal20
    // //
    // //
    call EnumItemsInRectBJ(GetPlayableMapRect(), function Trig_FinalCinematicSetUp_Func118002)
    // //
    // Hide Units
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_Player_Actual), function Trig_FinalCinematicSetUp_Func123A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_FinalCinematicSetUp_Func125A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), Player(PLAYER_NEUTRAL_PASSIVE)), function Trig_FinalCinematicSetUp_Func127A)
    // //
    if ( Trig_FinalCinematicSetUp_Func129C() ) then
        call GroupAddUnitSimple(udg_Hero_Lireesa, udg_Group_HiddenUnits)
    else
    endif
    if ( Trig_FinalCinematicSetUp_Func130C() ) then
        call GroupAddUnitSimple(udg_Hero_ElfCommander, udg_Group_HiddenUnits)
    else
    endif
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_FinalCinematicSetUp_Func132A)
    // //
    // /SettingZones
    // //
    if ( Trig_FinalCinematicSetUp_Func136C() ) then
        call ShowUnitHide(udg_Hero_Chogall)
        call PauseUnitBJ(true, udg_Hero_Chogall)
    else
        call DoNothing()
    endif
    // //
    if ( Trig_FinalCinematicSetUp_Func138C() ) then
        call ShowUnitHide(udg_Hero_Guldan)
        call PauseUnitBJ(true, udg_Hero_Guldan)
    else
        call DoNothing()
    endif
    // //
    if ( Trig_FinalCinematicSetUp_Func140C() ) then
        call ShowUnitHide(udg_Hero_ZulJeen)
        call PauseUnitBJ(true, udg_Hero_ZulJeen)
    else
        call DoNothing()
    endif
    // //
    call ShowUnitHide(udg_SemiHero_Utok)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    // //
    // /Setting Actors
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_ChogalFinal01), 277.15)
    call SetUnitFacingTimed(udg_FakeChogall, 316.11, 0)
    // ***
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeGuldan, GetRectCenter(gg_rct_GuldanLeerFinalCin), 180.83)
    // //
    // ***
    call SetUnitPositionLocFacingBJ(udg_FakeZuljin, GetRectCenter(gg_rct_ZuljinLeerFinalCin), 241.04)
    call SetUnitBlendTimeBJ(udg_FakeZuljin, 0.50)
    call SelectHeroSkill(udg_FakeZuljin, 'XAZ1')
    call UnitRemoveAbilityBJ('A60C', udg_FakeZuljin)
    // ***
    call SetUnitPositionLocFacingBJ(udg_FakeLireesa, GetRectCenter(gg_rct_LereesaDeath), 12.37)
    // ***
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=GetRandomInt(10, 15)
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        // //
        set udg_Point_OutroCorpsesTemp=GetRandomLocInRect(gg_rct_FinalDeadBodiesA)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'hhes', Player(1), udg_Point_OutroCorpsesTemp, GetRandomDirectionDeg())
        call RemoveLocation(udg_Point_OutroCorpsesTemp)
        // //
        set udg_Point_OutroCorpsesTemp=GetRandomLocInRect(gg_rct_FinalDeadBodiesA)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'h60S', Player(1), udg_Point_OutroCorpsesTemp, GetRandomDirectionDeg())
        call RemoveLocation(udg_Point_OutroCorpsesTemp)
        // //
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=GetRandomInt(7, 10)
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        // //
        set udg_Point_OutroCorpsesTemp=GetRandomLocInRect(gg_rct_FinalDeadBodiesB)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'hhes', Player(1), udg_Point_OutroCorpsesTemp, GetRandomDirectionDeg())
        call RemoveLocation(udg_Point_OutroCorpsesTemp)
        // //
        set udg_Point_OutroCorpsesTemp=GetRandomLocInRect(gg_rct_FinalDeadBodiesB)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'h60S', Player(1), udg_Point_OutroCorpsesTemp, GetRandomDirectionDeg())
        call RemoveLocation(udg_Point_OutroCorpsesTemp)
        // //
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=GetRandomInt(10, 15)
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        // //
        set udg_Point_OutroCorpsesTemp=GetRandomLocInRect(gg_rct_FinalDeadBodiesC)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'hhes', Player(1), udg_Point_OutroCorpsesTemp, GetRandomDirectionDeg())
        call RemoveLocation(udg_Point_OutroCorpsesTemp)
        // //
        set udg_Point_OutroCorpsesTemp=GetRandomLocInRect(gg_rct_FinalDeadBodiesC)
        call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'h60S', Player(1), udg_Point_OutroCorpsesTemp, GetRandomDirectionDeg())
        call RemoveLocation(udg_Point_OutroCorpsesTemp)
        // //
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // ***
    // ***
    call SetUnitPositionLocFacingBJ(udg_FakeDoomhammer, GetRectCenter(gg_rct_FinalDoomhammer00), 203.74)
    // ***
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_FinalMaim00), 229.00)
    // ***
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_FinalRend00), 209.85)
    // ***
    call SetUnitPositionLocFacingBJ(udg_FakeTharbek, GetRectCenter(gg_rct_FinalTharbek00), 212.30)
    // ***
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_FinalZuluhed00), 177.11)
    // ***
