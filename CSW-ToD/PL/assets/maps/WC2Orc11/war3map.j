    call SetUnitFacingToFaceUnitTimed(udg_FakeGuldan, udg_FakeChogall, 1.00)
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Standard One")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc11Guldan15, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "Cinematic Listening One")
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_OutroGuldanExit))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeChogall, "move", GetRectCenter(gg_rct_OutroGuldanExit))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundBJ(gg_snd_OrcArmyMarchLoop)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_BetreyalCinematicQ_Func105001002)), function Trig_BetreyalCinematicQ_Func105A)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    call StopSoundBJ(gg_snd_RaminDjawadi___Guldan, true)
    call StopSoundBJ(gg_snd_OrcArmyMarchLoop, false)
    if ( Trig_BetreyalCinematicQ_Func112C() ) then
        call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
    else
        call ConditionalTriggerExecute(gg_trg_BonusCinematicQ)
    endif
endfunction

