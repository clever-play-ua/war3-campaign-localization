    set udg_Unit_OutroBlackrockGrunt[4]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt05), 180.00)
    set udg_Unit_OutroBlackrockGrunt[5]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt06), 180.00)
    set udg_Unit_OutroBlackrockGrunt[6]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt07), 180.00)
    set udg_Unit_OutroBlackrockGrunt[7]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt08), 180.00)
    set udg_Unit_OutroBlackrockGrunt[8]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt09), 180.00)
    set udg_Unit_OutroBlackrockGrunt[9]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt10), 180.00)
    set udg_Unit_OutroBlackrockGrunt[10]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt11), 180.00)
    set udg_Unit_OutroBlackrockGrunt[11]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt12), 180.00)
    set udg_Unit_OutroBlackrockGrunt[12]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt13), 180.00)
    set udg_Unit_OutroBlackrockGrunt[13]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt14), 180.00)
    set udg_Unit_OutroBlackrockGrunt[14]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt15), 180.00)
    set udg_Unit_OutroBlackrockGrunt[15]=GetLastCreatedUnit()
    // ***
    call CreateNUnitsAtLoc(1, 'ogru', Player(12), GetRectCenter(gg_rct_FinalBRGrunt16), 180.00)
    set udg_Unit_OutroBlackrockGrunt[16]=GetLastCreatedUnit()
    // ***
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=16
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_OutroBlackrockGrunt[GetForLoopIndexA()])
        call BlzSetUnitRealFieldBJ(udg_Unit_OutroBlackrockGrunt[GetForLoopIndexA()], UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
        call SetUnitMoveSpeed(udg_Unit_OutroBlackrockGrunt[GetForLoopIndexA()], udg_Real_CinWalkSpeed150)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // ***
    // /Army
    // //
    set udg_Point_OutroArmyFacing=GetRectCenter(gg_rct_GoblinFInal01)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=20
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'o61D', Player(0), GetRectCenter(udg_Region_GruntFinalArr[GetForLoopIndexA()]), udg_Point_OutroArmyFacing)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_StormreaverArmy)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=20
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'n002', Player(0), GetRectCenter(udg_Region_OrgeFinalArr[GetForLoopIndexB()]), udg_Point_OutroArmyFacing)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_StormreaverArmy)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=20
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'otbk', Player(10), GetRectCenter(udg_Region_TrollFinalArr[GetForLoopIndexA()]), udg_Point_OutroArmyFacing)
        call UnitRemoveAbilityBJ('A60C', GetLastCreatedUnit())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=6
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'o60P', Player(0), GetRectCenter(udg_Region_CatapultFinaArrl[GetForLoopIndexB()]), udg_Point_OutroArmyFacing)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_StormreaverArmy)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'n000', Player(0), GetRectCenter(udg_Region_GoblinFinalArr[GetForLoopIndexA()]), udg_Point_OutroArmyFacing)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_StormreaverArmy)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=6
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'h000', Player(0), GetRectCenter(udg_Region_ZeppelinFinalArr[GetForLoopIndexB()]), udg_Point_OutroArmyFacing)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_StormreaverArmy)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'u000', Player(0), GetRectCenter(udg_Region_DeathKnightFinalArr[GetForLoopIndexA()]), udg_Point_OutroArmyFacing)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_StormreaverArmy)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call RemoveLocation(udg_Point_OutroArmyFacing)
    // //
    // Army/
    call SetTerrainFogExBJ(0, 2500.00, 10000.00, 0.50, 58.80, 58.80, 78.40)
    // ***
    call EnumDestructablesInRectAll(gg_rct_DestroyTreesToPass05, function Trig_FinalCinematicSetUp_Func270A)
    // ***
endfunction

