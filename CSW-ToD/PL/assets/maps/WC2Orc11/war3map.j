    // ***
    call SetUnitAnimation(udg_FakeZuljin, "Cinematic Standard Two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuljin, 0, gg_snd_WC2Orc11Zuljin9, bj_TIMETYPE_ADD, 0, true)
