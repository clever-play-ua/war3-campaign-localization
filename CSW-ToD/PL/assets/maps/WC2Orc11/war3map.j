//===========================================================================
// Trigger: RockCollapse
//===========================================================================
function Trig_RockCollapse_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_RockCollapse_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call KillDestructable(gg_dest_YT51_4608)
endfunction

//===========================================================================
function InitTrig_RockCollapse takes nothing returns nothing
    set gg_trg_RockCollapse=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_RockCollapse, gg_rct_RockCollapse02)
    call TriggerAddCondition(gg_trg_RockCollapse, Condition(function Trig_RockCollapse_Conditions))
    call TriggerAddAction(gg_trg_RockCollapse, function Trig_RockCollapse_Actions)
endfunction

//===========================================================================
// Trigger: Creep Multiplier
//===========================================================================
function Trig_Creep_Multiplier_Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Creep_Multiplier_Func004C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Creep_Multiplier_Func005C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_Creep_Multiplier_Func007A takes nothing returns nothing
    call BlzSetUnitMaxHP(GetEnumUnit(), ( BlzGetUnitMaxHP(GetEnumUnit()) + ( GetUnitLevel(GetEnumUnit()) * udg_Int_CreepHP ) ))
    call SetUnitLifePercentBJ(GetEnumUnit(), 100)
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitBaseDamage(GetEnumUnit(), 0) + ( GetUnitLevel(GetEnumUnit()) * udg_Int_CreepDMG ) ))
    call BlzSetUnitWeaponIntegerFieldBJ(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 1, ( BlzGetUnitBaseDamage(GetEnumUnit(), 1) + ( GetUnitLevel(GetEnumUnit()) * udg_Int_CreepDMG ) ))
endfunction

function Trig_Creep_Multiplier_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Creep_Multiplier_Func003C() ) then
        set udg_Int_CreepHP=50
        set udg_Int_CreepDMG=2
    else
    endif
    if ( Trig_Creep_Multiplier_Func004C() ) then
        set udg_Int_CreepHP=100
        set udg_Int_CreepDMG=4
    else
    endif
    if ( Trig_Creep_Multiplier_Func005C() ) then
        set udg_Int_CreepHP=150
        set udg_Int_CreepDMG=6
    else
    endif
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Creep_Multiplier_Func007A)
endfunction

//===========================================================================
function InitTrig_Creep_Multiplier takes nothing returns nothing
    set gg_trg_Creep_Multiplier=CreateTrigger()
    call TriggerAddAction(gg_trg_Creep_Multiplier, function Trig_Creep_Multiplier_Actions)
endfunction

//===========================================================================
// Trigger: Easy
//===========================================================================
function Trig_Easy_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Easy_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // ////
    // Making Trolls Weaker for Quest
    call SetPlayerHandicapDamageBJ(udg_Player_Trolls, 80.00)
    // ////
    call SetPlayerTechResearchedSwap('RESU', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REAU', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REDE', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REAW', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('RHEP', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('RESO', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('REMS', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('R00A', 1, udg_Player_Magisters)
    call SetPlayerTechResearchedSwap('R00J', 1, udg_Player_Magisters)
    // ////
    call SetPlayerTechResearchedSwap('RESU', 1, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('REAU', 1, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('REDE', 1, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('REAW', 1, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('RHEP', 1, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('RESO', 1, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('REMS', 1, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('R00A', 1, udg_Player_Farstriders)
    call SetPlayerTechResearchedSwap('R00J', 1, udg_Player_Farstriders)
    // ////
    // ////
endfunction

//===========================================================================
function InitTrig_Easy takes nothing returns nothing
    set gg_trg_Easy=CreateTrigger()
    call TriggerAddCondition(gg_trg_Easy, Condition(function Trig_Easy_Conditions))
    call TriggerAddAction(gg_trg_Easy, function Trig_Easy_Actions)
endfunction

