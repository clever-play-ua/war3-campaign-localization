    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeLireesa)
    call SetUnitBlendTimeBJ(udg_FakeLireesa, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeLireesa)
    // //
    // //
    // //
