function Trig_WhirlwindCasterDies_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'u000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_WhirlwindCasterDies_Actions takes nothing returns nothing
    local unit w
    local unit dk
    set dk=GetDyingUnit()
    set w=LoadUnitHandle(udg_Hashtable_WhirlwindSpell, GetHandleId(dk), 0)
    if w != null then
    call KillUnit(w)
    endif
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, GetHandleId(dk))
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, GetHandleId(w))
endfunction

