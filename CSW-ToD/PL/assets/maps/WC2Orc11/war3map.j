    set gg_trg_OutroCinSpawnElves=CreateTrigger()
    call TriggerAddCondition(gg_trg_OutroCinSpawnElves, Condition(function Trig_OutroCinSpawnElves_Conditions))
    call TriggerAddAction(gg_trg_OutroCinSpawnElves, function Trig_OutroCinSpawnElves_Actions)
