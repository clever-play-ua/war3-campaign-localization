    call IssuePointOrderLocBJ(udg_FakeZuljin, "move", GetRectCenter(gg_rct_RockCollapseOut))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
