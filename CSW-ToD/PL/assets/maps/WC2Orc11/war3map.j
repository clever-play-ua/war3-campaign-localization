    elseif ( soundDuration >= 2.462 ) then
       call SetSoundFacialAnimationLabel(soundHandle, "OgreReady1")
       call SetSoundFacialAnimationGroupLabel(soundHandle, "BaseSD")
       call SetSoundFacialAnimationSetFilepath(soundHandle, "units/creeps/ogre/ogre_portrait.sd.animset_ingame")
    elseif ( soundDuration >= 1.897 ) then
       call SetSoundFacialAnimationLabel(soundHandle, "OgreWhat1")
       call SetSoundFacialAnimationGroupLabel(soundHandle, "BaseSD")
       call SetSoundFacialAnimationSetFilepath(soundHandle, "units/creeps/ogre/ogre_portrait.sd.animset_ingame")
    elseif ( soundDuration >= 1.803 ) then
       call SetSoundFacialAnimationLabel(soundHandle, "OgreYesAttack1")
       call SetSoundFacialAnimationGroupLabel(soundHandle, "BaseSD")
       call SetSoundFacialAnimationSetFilepath(soundHandle, "units/creeps/ogre/ogre_portrait.sd.animset_ingame")
    elseif ( soundDuration >= 1.606 ) then
       call SetSoundFacialAnimationLabel(soundHandle, "OgreWarcry1")
