    call SetUnitMoveSpeed(udg_FakeChogall, udg_Real_CinWalkSpeed150)
    call SuspendHeroXPBJ(false, udg_FakeChogall)
    // //
    call CreateNUnitsAtLoc(1, 'OZaC', udg_Player_CinematicZuluhed, udg_Point_SpawnFakeZuluhed, bj_UNIT_FACING)
    set udg_FakeZuluhed=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeZuluhed)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitMoveSpeed(udg_FakeZuluhed, udg_Real_CinWalkSpeed150)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // //
    call CreateNUnitsAtLoc(1, 'OZcN', udg_Player_CinematicZuljin, udg_Point_SpawnFakeZuljin, bj_UNIT_FACING)
    set udg_FakeZuljin=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeZuljin, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeZuljin)
    // //
    call CreateNUnitsAtLoc(1, 'ORbC', udg_Player_BTGCinematic, udg_Point_SpawnFakeRend, bj_UNIT_FACING)
    set udg_FakeRend=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeRend)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeRend)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitMoveSpeed(udg_FakeRend, udg_Real_CinWalkSpeed150)
    call SetUnitAnimation(udg_FakeRend, "cinematic listening one")
    call SetUnitColor(udg_FakeRend, PLAYER_COLOR_COAL)
    // //
    call CreateNUnitsAtLoc(1, 'OMBc', udg_Player_BTGCinematic, udg_Point_SpawnFakeMaim, bj_UNIT_FACING)
    set udg_FakeMaim=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.50)
    call SuspendHeroXPBJ(false, udg_FakeMaim)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMaim)
