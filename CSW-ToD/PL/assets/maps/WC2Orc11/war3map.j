    if ( not ( udg_Bool_OutroDebug == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokFallsCinematicQ_Func031001 takes nothing returns boolean
    return ( udg_Bool_CinUtokSkipped == true )
endfunction

function Trig_UtokFallsCinematicQ_Func035001 takes nothing returns boolean
    return ( udg_Bool_CinUtokSkipped == true )
endfunction

function Trig_UtokFallsCinematicQ_Func041001 takes nothing returns boolean
    return ( udg_Bool_CinUtokSkipped == true )
