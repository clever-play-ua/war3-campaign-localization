//===========================================================================
// Trigger: AIP18 Start
//===========================================================================
function Trig_AIP18_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerStateBJ(udg_Player18_Stromgarde_Ground, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(udg_Player18_Stromgarde_Ground, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call SetPlayerStateBJ(udg_Player18_Stromgarde_Ground, PLAYER_STATE_FOOD_CAP_CEILING, 400)
    call SetPlayerStateBJ(udg_Player18_Stromgarde_Ground, PLAYER_STATE_RESOURCE_FOOD_CAP, 400)
    // //
    // //
    call EnableTrigger(gg_trg_AIP18_Gold)
    call EnableTrigger(gg_trg_AIP18_Lumber)
    // //
    call ConditionalTriggerExecute(gg_trg_TransportationConfig)
    // //
    call StartCampaignAI(udg_Player18_Stromgarde_Ground, "CSW\\Scripts\\ToDScripts\\WC2Orc09\\WC2Orc09P18AllianceAI.ai")
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P18_Command_Stat_Attack_User)
endfunction

