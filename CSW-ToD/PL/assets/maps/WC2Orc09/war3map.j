    // //////
    // Cinematic Started
    // //////
    set udg_Bool_TyrsHandCinOn=true
    set udg_Bool_CinematicSkipped=false
    call PlaySoundBJ(gg_snd_HumanX1)
    // //////
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Cathedral01, udg_Player_Actual, 10.00, 0, 3.00, 100.00)
    call TriggerSleepAction(10.00)
    if ( (udg_Bool_TyrsHandCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //////
    call CreateNUnitsAtLocFacingLocBJ(1, 'h627', udg_Player_Silverhand, GetRectCenter(gg_rct_Alonso), GetRectCenter(gg_rct_FootmanReports))
    set udg_Unit_TyrsHandCinCleric=GetLastCreatedUnit()
