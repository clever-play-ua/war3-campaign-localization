function Trig_Ambush_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetup)
    // Ensure Setup completes
    call TriggerSleepAction(0.01)
    call ConditionalTriggerExecute(gg_trg_Ambush_Cinematic_SetUp)
    call TriggerSleepAction(0.01)
    // Set the Camera
    call CameraSetupApplyForPlayer(true, gg_cam_Trap02, udg_Player_Actual, 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // ***
    // Cinematic Started and can now be skipped
    // ***
    set udg_Bool_AmbushCinOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call PlaySoundBJ(gg_snd_Tension01)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Trap03, udg_Player_Actual, 5.00, 0, 1.00, 100.00)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc09Utok3, bj_TIMETYPE_ADD, 0, false)
    // //
    call TriggerSleepAction(GetSoundDurationBJ(gg_snd_WC2Orc09Utok3))
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ForGroupBJ(udg_Group_Ambush, function Trig_Ambush_Cinematic_Q_Func027A)
    call ForGroupBJ(udg_Group_Ambush, function Trig_Ambush_Cinematic_Q_Func028002)
    // //
    call SetUnitAcquireRangeBJ(gg_unit_h60S_0151, 5000.00)
    call BlzSetUnitWeaponRealFieldBJ(gg_unit_h60S_0151, UNIT_WEAPON_RF_ATTACK_RANGE, 0, 5000.00)
    call SetUnitAcquireRangeBJ(gg_unit_h60S_0152, 5000.00)
    call BlzSetUnitWeaponRealFieldBJ(gg_unit_h60S_0152, UNIT_WEAPON_RF_ATTACK_RANGE, 0, 5000.00)
    call SetUnitAcquireRangeBJ(gg_unit_h60S_0153, 5000.00)
    call BlzSetUnitWeaponRealFieldBJ(gg_unit_h60S_0153, UNIT_WEAPON_RF_ATTACK_RANGE, 0, 5000.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Trap01, udg_Player_Actual, 0.00)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_h60S_0147, 0, gg_snd_WC2Orc09ElvenRanger1, bj_TIMETYPE_ADD, 0, false)
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Elf is Shooting
    // //
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_COMBAT, 100)
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_SPELLS, 100)
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_COMBAT, 100)
    // //
    call ForGroupBJ(udg_Group_Ambush, function Trig_Ambush_Cinematic_Q_Func050002)
    call PauseUnitBJ(true, gg_unit_h60S_0151)
    call PauseUnitBJ(true, gg_unit_h60S_0153)
    call IssueTargetOrderBJ(gg_unit_h60S_0152, "attack", udg_FakeUtok)
    // //
    call TriggerSleepAction(0.90)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic injured one")
    call PlaySoundOnUnitBJ(gg_snd_WC2Orc09UtokWounded, 60.00, udg_FakeUtok)
    call PauseUnitBJ(true, udg_FakeUtok)
    call IssueImmediateOrderBJ(gg_unit_h60S_0152, "stop")
    // //
    // Enemy Agro is On
    // //
    call PauseUnitBJ(true, udg_FakeRend)
    call SetUnitAnimation(udg_FakeRend, "stand ready")
    // //
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_Alliance, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Alliance, udg_Player_BTGCinematic, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Alliance, udg_Player_MaroonCinematic, bj_ALLIANCE_UNALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_MaroonCinematic, udg_Player_Alliance, bj_ALLIANCE_UNALLIED_VISION)
    // //
    call ForGroupBJ(udg_Group_FakeGrunts, function Trig_Ambush_Cinematic_Q_Func073A)
    // //
    call SetCineModeVolumeGroupsBJ()
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc09Rend3, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
