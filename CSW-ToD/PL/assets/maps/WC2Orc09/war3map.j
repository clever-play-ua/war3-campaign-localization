//===========================================================================
function Trig_Razing_Discover_Func002A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Razing_Discover_Func004A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Razing_Discover_Actions takes nothing returns nothing
    // //
    call ForGroupBJ(udg_Group_TyrsBayBallistas, function Trig_Razing_Discover_Func002A)
    // //
    call ForGroupBJ(udg_Group_TyrsBayRangers, function Trig_Razing_Discover_Func004A)
    // //
    call EnableTrigger(gg_trg_Razing_Update_DestroyCitadel)
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P18_Command_Stat_Attack_User_Amf)
    call ConditionalTriggerExecute(gg_trg_Razing_AI_Regular_Attacker_Disable)
    // //
    call QueuedTriggerAddBJ(gg_trg_Razing_Discover_Q, true)
endfunction

