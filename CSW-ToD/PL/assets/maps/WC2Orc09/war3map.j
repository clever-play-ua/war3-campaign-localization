//===========================================================================
// Trigger: Cliff01VisibilityOn
//===========================================================================
function Trig_Cliff01VisibilityOn_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(0) ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnteringUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_VisModCliff01On == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cliff01VisibilityOn_Actions takes nothing returns nothing
    set udg_Bool_VisModCliff01On=true
    set udg_Point_CreateVisibilityModifier=GetRectCenter(gg_rct_CliffShow)
    call CreateFogModifierRadiusLocBJ(true, Player(0), FOG_OF_WAR_VISIBLE, udg_Point_CreateVisibilityModifier, 512.00)
    set udg_VisMod_Cliff01=GetLastCreatedFogModifier()
    call RemoveLocation(udg_Point_CreateVisibilityModifier)
    call EnableTrigger(gg_trg_Cliff01VisibilityOff)
endfunction

//===========================================================================
function InitTrig_Cliff01VisibilityOn takes nothing returns nothing
    set gg_trg_Cliff01VisibilityOn=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Cliff01VisibilityOn, gg_rct_Cliffvisibility)
    call TriggerAddCondition(gg_trg_Cliff01VisibilityOn, Condition(function Trig_Cliff01VisibilityOn_Conditions))
    call TriggerAddAction(gg_trg_Cliff01VisibilityOn, function Trig_Cliff01VisibilityOn_Actions)
endfunction

