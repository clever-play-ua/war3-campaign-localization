    set udg_Point_TempOilRigBuild=GetUnitLoc(GetConstructedStructure())
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(512, udg_Point_TempOilRigBuild, Condition(function Trig_TankerBuildsRig_Func003001003)), function Trig_TankerBuildsRig_Func003A)
    call RemoveLocation(udg_Point_TempOilRigBuild)
endfunction

