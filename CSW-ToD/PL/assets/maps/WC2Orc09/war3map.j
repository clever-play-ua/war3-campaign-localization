//===========================================================================
// Trigger: Navy Discover
//===========================================================================
function Trig_Navy_Discover_Func019A takes nothing returns nothing
    call RescueUnitBJ(GetEnumUnit(), udg_Player_Actual, false)
endfunction

function Trig_Navy_Discover_Actions takes nothing returns nothing
    // //
    set udg_Point_CaravanEscort[1]=GetRectCenter(gg_rct_CaravanEscort01)
    set udg_Point_CaravanEscort[2]=GetRectCenter(gg_rct_CaravanEscort02)
    set udg_Point_CaravanEscort[3]=GetRectCenter(gg_rct_CaravanEscort03)
    set udg_Point_CaravanExit=GetRectCenter(gg_rct_CaravanOut)
    set udg_Point_CaravanFarm[1]=GetUnitLoc(gg_unit_h619_0232)
    set udg_Point_CaravanFarm[2]=GetUnitLoc(gg_unit_h619_0256)
    set udg_Point_CaravanFarm[3]=GetUnitLoc(gg_unit_h619_0251)
    set udg_Point_CaravanFarm[4]=GetUnitLoc(gg_unit_h619_0276)
    set udg_Point_CaravanFarm[5]=GetUnitLoc(gg_unit_h619_0255)
    set udg_Point_CaravanFarm[6]=GetUnitLoc(gg_unit_h619_0244)
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_AIP03_Start)
    call ConditionalTriggerExecute(gg_trg_AIP18_Start)
    call ConditionalTriggerExecute(gg_trg_AIP16_Start)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_BTG), function Trig_Navy_Discover_Func019A)
    // //
    call RescueUnitBJ(gg_unit_o60V_0023, udg_Player_Actual, true)
    // //
    // Change ownership of ships
    // //
    call SetUnitOwner(gg_unit_o60S_0003, udg_Player_Actual, true)
    call SetUnitOwner(gg_unit_o60R_0017, udg_Player_Actual, true)
    call PauseUnitBJ(false, gg_unit_o60P_0018)
    call PauseUnitBJ(false, gg_unit_o60P_0019)
    call PauseUnitBJ(false, gg_unit_o60S_0003)
    call PauseUnitBJ(false, gg_unit_o60R_0017)
    call ShowUnitShow(gg_unit_o61Y_0022)
    call ShowUnitShow(gg_unit_o61Y_0021)
    call IssueTargetOrderBJ(gg_unit_o61Y_0022, "repair", gg_unit_o614_0009)
    call IssueTargetOrderBJ(gg_unit_o61Y_0021, "repair", gg_unit_o614_0009)
    // //
    call PolledWait(1.00)
    // //
    // Need to Update oil System Dependencies after units changed player owners
    // //
    call updateNearestRigDepot(5)
    call PolledWait(0.50)
    // //
    call updateNearestRigDepot(0)
    // //
    call ReplaceUnitBJ(gg_unit_o60V_0023, 'o60V', bj_UNIT_STATE_METHOD_RELATIVE)
    call IssueTargetOrderBJ(gg_unit_h001_0526, "smart", udg_Unit_PlatformCreated)
    call UnitAddAbilityBJ('A634', GetLastReplacedUnitBJ())
    // //
    call QueuedTriggerAddBJ(gg_trg_Navy_Discover_Q, true)
    call EnableTrigger(gg_trg_Navy_Update_Completed)
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Navy_Discover takes nothing returns nothing
    set gg_trg_Navy_Discover=CreateTrigger()
    call TriggerAddAction(gg_trg_Navy_Discover, function Trig_Navy_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Navy Discover Q
//===========================================================================
function Trig_Navy_Discover_Q_Actions takes nothing returns nothing
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_o61A_0076, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[1]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h60X_0469, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[2]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(gg_unit_o61A_0106, bj_CAMPPINGSTYLE_PRIMARY_RED)
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_o61C_0052, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[4]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h60X_0074, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[5]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_o61C_0102, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[6]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h60X_0105, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[7]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h60X_0378, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[8]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h60X_0379, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[9]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h60X_0380, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[10]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h60X_0105, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_NavalBuildings[11]=GetLastCreatedMinimapIcon()
    // //
    call CreateLeaderboardBJ(udg_PlayerGroup_PlayerActual, ( BlzGetItemDescription(gg_item_IQL3_0617) + ( I2S(udg_Int_CaravansAllowedToFlee) + BlzGetItemDescription(gg_item_IQL1_0614) ) ))
    // //
    set udg_Leaderboard_Navy=GetLastCreatedLeaderboard()
    call LeaderboardAddItemBJ(Player(0), udg_Leaderboard_Navy, "TRIGSTR_3170", 0)
    call LeaderboardSetStyleBJ(udg_Leaderboard_Navy, true, true, true, false)
    call LeaderboardSetLabelColorBJ(udg_Leaderboard_Navy, 100, 80, 20, 0)
    call LeaderboardSetValueColorBJ(udg_Leaderboard_Navy, 100, 100.00, 100.00, 0)
    call LeaderboardDisplayBJ(true, udg_Leaderboard_Navy)
    // //
    call QuestSetDiscoveredBJ(udg_MQNavy, true)
    // //
    call CreateQuestItemBJ(udg_MQNavy, ( BlzGetItemDescription(gg_item_IQL3_0617) + ( I2S(udg_Int_CaravansAllowedToFlee) + BlzGetItemDescription(gg_item_IQL1_0614) ) ))
    set udg_QReq_CaravanLeave=GetLastCreatedQuestItemBJ()
    // //
    set udg_newLine="\n"
    // //
    set udg_String_CompletedQuests=( BlzGetItemDescription(gg_item_IQL0_0615) + ( "\n" + GetItemName(gg_item_IQL0_0615) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + BlzGetItemTooltip(gg_item_IQL0_0615) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + BlzGetItemExtendedTooltip(gg_item_IQL0_0615) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + BlzGetItemExtendedTooltip(gg_item_IQL1_0614) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + GetItemName(gg_item_IQL1_0614) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + ( BlzGetItemTooltip(gg_item_IQL1_0614) + ( I2S(udg_Int_CaravansAllowedToFlee) + BlzGetItemDescription(gg_item_IQL1_0614) ) ) ) )
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, udg_String_CompletedQuests)
    call PolledWait(bj_QUEUE_DELAY_QUEST)
    // //
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    call PolledWait(bj_QUEUE_DELAY_QUEST)
    // //
    call EnableTrigger(gg_trg_PlayerUnitsDead)
    call ConditionalTriggerExecute(gg_trg_Navy_Caravan_Timer_Start)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

