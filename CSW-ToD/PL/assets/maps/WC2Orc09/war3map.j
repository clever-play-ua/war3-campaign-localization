//===========================================================================
// Trigger: Razing Completed Q
//===========================================================================
function Trig_Razing_Completed_Q_Func002001 takes nothing returns boolean
    return ( IsTriggerQueuedBJ(gg_trg_Razing_Update_Destroy_BarracksQ) == false )
endfunction

function Trig_Razing_Completed_Q_Func003001 takes nothing returns boolean
    return ( IsTriggerQueuedBJ(gg_trg_Razing_Update_DestroyCitadel_Q2) == false )
endfunction

function Trig_Razing_Completed_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    loop
        exitwhen ( (IsTriggerQueuedBJ(gg_trg_Razing_Update_Destroy_BarracksQ) == false) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    loop
        exitwhen ( (IsTriggerQueuedBJ(gg_trg_Razing_Update_DestroyCitadel_Q2) == false) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    call QuestSetCompletedBJ(udg_MQRazing, true)
    call QuestItemSetCompletedBJ(udg_QReq_DestroyStromgardeKeep, true)
    // //
    call QuestItemSetCompletedBJ(udg_QReq_KillMage, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3629")
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

