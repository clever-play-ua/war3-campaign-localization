//===========================================================================
function Trig_Ogre_Update1_Runestone_Q_Func018Func001Func002C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Ogre_Update1_Runestone_Q_Func018Func001C takes nothing returns boolean
    if ( not Trig_Ogre_Update1_Runestone_Q_Func018Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Ogre_Update1_Runestone_Q_Func018A takes nothing returns nothing
    if ( Trig_Ogre_Update1_Runestone_Q_Func018Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Ogre_Update1_Runestone_Q_Func020Func001Func002C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Ogre_Update1_Runestone_Q_Func020Func001C takes nothing returns boolean
    if ( not Trig_Ogre_Update1_Runestone_Q_Func020Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Ogre_Update1_Runestone_Q_Func020A takes nothing returns nothing
    if ( Trig_Ogre_Update1_Runestone_Q_Func020Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Ogre_Update1_Runestone_Q_Actions takes nothing returns nothing
    call SetUnitAnimation(gg_unit_n002_0131, "spell")
    call QueueUnitAnimationBJ(gg_unit_n002_0131, "stand")
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_n002_0131, 'n002', gg_snd_WC2OgreMagiReady1, bj_TIMETYPE_ADD, 0, false)
    // //
    call TriggerExecute(gg_trg_VisibilityForceBridgeOn)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_ForceBridge), 2.00)
    // //
    call PolledWait(2)
    call SetDoodadAnimationRectBJ("stand", 'XOmr', gg_rct_ForceBridgeVisibility)
    // //
    call PolledWait(1.00)
    call PlaySoundAtPointBJ(gg_snd_ShimmeringPortalEntrance, 100, GetRectCenter(gg_rct_ForceBridge), 100.00)
    // //
    call DestructableRestoreLife(gg_dest_DTs2_1160, GetDestructableMaxLife(gg_dest_DTs2_1160), true)
    // //
    call EnumDestructablesInRectAll(gg_rct_ArcaneBridgeBlockA, function Trig_Ogre_Update1_Runestone_Q_Func018A)
    // //
    call EnumDestructablesInRectAll(gg_rct_ArcaneBridgeBlockB, function Trig_Ogre_Update1_Runestone_Q_Func020A)
    // //
    call RescueUnitBJ(gg_unit_n002_0131, Player(0), false)
    // //
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_TaurenReady1) - 2.00 ))
    call VolumeGroupResetBJ()
    // //
    call QuestItemSetCompletedBJ(udg_QReq_FindRunestoneShard, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_3264")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // //
    // //
endfunction

