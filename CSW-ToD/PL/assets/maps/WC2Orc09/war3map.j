//===========================================================================
// Trigger: Blizzard Start
//===========================================================================
function Trig_Blizzard_Start_Actions takes nothing returns nothing
    // //
    set udg_Bool_BlizzardStarted=true
    // //
    call DisableTrigger(gg_trg_Light_Snow_Begin)
    call DisableTrigger(gg_trg_Light_Snow_End)
    call DisableTrigger(gg_trg_Heavy_Snow_Begin)
    call DisableTrigger(gg_trg_Heavy_Snow_End)
    // //
    call EnableWeatherEffect(udg_Weather_SnowLight, false)
    call RemoveWeatherEffectBJ(udg_Weather_SnowLight)
    // //
    call StartTimerBJ(udg_Timer_SnowIn, true, 1.00)
    call PolledWait(1.00)
    call EnableWeatherEffect(udg_Weather_SnowHeavy, false)
    call RemoveWeatherEffectBJ(udg_Weather_SnowHeavy)
    call PolledWait(1.00)
    call SetStackedSoundBJ(true, gg_snd_WindLoopStereo, GetPlayableMapRect())
    // //
    call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'SNbs')
    set udg_Weather_Blizzard=GetLastCreatedWeatherEffect()
    // //
    call EnableWeatherEffect(udg_Weather_Blizzard, true)
    // //
    call PolledWait(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_Blizzard_Freeze_Start)
    // //
    // Change weeather after some time because Blizzard is annoying
    // //
    call StartTimerBJ(udg_Timer_BlizzardWeather, false, udg_Real_BlizzardWeatherDuration)
endfunction

//===========================================================================
function InitTrig_Blizzard_Start takes nothing returns nothing
    set gg_trg_Blizzard_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_Blizzard_Start, function Trig_Blizzard_Start_Actions)
endfunction

//===========================================================================
// Trigger: Blizzard Weather Fades
//===========================================================================
function Trig_Blizzard_Weather_Fades_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call RemoveWeatherEffectBJ(udg_Weather_Blizzard)
    call AddWeatherEffectSaveLast(GetPlayableMapRect(), 'SNhs')
    set udg_Weather_Blizzard=GetLastCreatedWeatherEffect()
endfunction

