    set gg_trg_Ogre_Update1_Runestone_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Ogre_Update1_Runestone_Q, function Trig_Ogre_Update1_Runestone_Q_Actions)
endfunction

