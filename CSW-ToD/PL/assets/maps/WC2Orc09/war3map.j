//===========================================================================
function Trig_Rune_of_Blood_Ogre_Magi_Func002C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'XCT1' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A655' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'XW0R' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Rune_of_Blood_Ogre_Magi_Conditions takes nothing returns boolean
    if ( not Trig_Rune_of_Blood_Ogre_Magi_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_of_Blood_Ogre_Magi_Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'XCT1' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_of_Blood_Ogre_Magi_Actions takes nothing returns nothing
    if ( Trig_Rune_of_Blood_Ogre_Magi_Func001C() ) then
        set udg_TempPointRune=GetSpellTargetLoc()
        call CreateNUnitsAtLoc(1, 'u602', GetTriggerPlayer(), udg_TempPointRune, bj_UNIT_FACING)
        set udg_DummyRune=GetLastCreatedUnit()
        call UnitAddAbilityBJ('XCT2', udg_DummyRune)
        call IssuePointOrderLocBJ(udg_DummyRune, "stasistrap", udg_TempPointRune)
        call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_DummyRune)
        call RemoveLocation(udg_TempPointRune)
    else
    endif
endfunction

