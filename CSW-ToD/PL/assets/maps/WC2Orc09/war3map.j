//===========================================================================
// Trigger: OgreMagi Cinematic Q
//===========================================================================
function Trig_OgreMagi_Cinematic_Q_Func003C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQNavy) == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CaravanIsBeingSent == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgreMagi_Cinematic_Q_Func013A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_CinematicPausedUnits)
endfunction

function Trig_OgreMagi_Cinematic_Q_Func015A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_OgreMagi_Cinematic_Q_Func018001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false )
endfunction

function Trig_OgreMagi_Cinematic_Q_Func018001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == false )
endfunction

function Trig_OgreMagi_Cinematic_Q_Func018001002002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) != 'h001' )
endfunction

function Trig_OgreMagi_Cinematic_Q_Func018001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == false), (GetUnitTypeId(GetFilterUnit()) != 'h001')) // INLINED!!
endfunction

function Trig_OgreMagi_Cinematic_Q_Func018001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == false), (GetUnitTypeId(GetFilterUnit()) != 'h001')))) // INLINED!!
endfunction

function Trig_OgreMagi_Cinematic_Q_Func018A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P1GroundTroopsToHide)
endfunction

function Trig_OgreMagi_Cinematic_Q_Func020002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_OgreMagi_Cinematic_Q_Func043001 takes nothing returns boolean
    return ( udg_Bool_OgreMagiCinSkipped == true )
endfunction

function Trig_OgreMagi_Cinematic_Q_Func050001 takes nothing returns boolean
    return ( udg_Bool_OgreMagiCinSkipped == true )
endfunction

function Trig_OgreMagi_Cinematic_Q_Func057001 takes nothing returns boolean
    return ( udg_Bool_OgreMagiCinSkipped == true )
endfunction

function Trig_OgreMagi_Cinematic_Q_Func065001 takes nothing returns boolean
    return ( udg_Bool_OgreMagiCinSkipped == true )
endfunction

function Trig_OgreMagi_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( Trig_OgreMagi_Cinematic_Q_Func003C() ) then
        call PauseTimerBJ(true, udg_Timer_CaravanPause)
        call TimerDialogDisplayForPlayerBJ(false, udg_TimerWindow_Caravan, Player(0))
    else
    endif
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetup)
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    // Ensure Setup completes
    call TriggerSleepAction(0.01)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player18_Stromgarde_Ground), function Trig_OgreMagi_Cinematic_Q_Func013A)
    // //
    call ForGroupBJ(udg_Group_CinematicPausedUnits, function Trig_OgreMagi_Cinematic_Q_Func015A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_OgreMagi_Cinematic_Q_Func018001002)), function Trig_OgreMagi_Cinematic_Q_Func018A)
    // //
    call ForGroupBJ(udg_Group_P1GroundTroopsToHide, function Trig_OgreMagi_Cinematic_Q_Func020002)
    // //
    call ShowUnitShow(udg_FakeMaim)
    call ShowUnitShow(udg_FakeUtok)
    call PauseUnitBJ(false, udg_FakeMaim)
    call PauseUnitBJ(false, udg_FakeUtok)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeMaim, GetRectCenter(gg_rct_MaimRuneCinemTalking), GetRectCenter(gg_rct_UtokRuneCinemTalking_Copy))
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokRuneCinemTalking_Copy), 22.63)
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Listening One")
    call SetUnitAnimation(udg_FakeMaim, "Cinematic Listening One")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_RuneTalking01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_RuneTalking02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc09Maim4) - 0.00 ), 0, 2.00, 100.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_DarkAgents)
    call TriggerSleepAction(1.00)
    set udg_Bool_OgreMagiCinOn=true
    set udg_Bool_CinematicSkipped=false
    // ***
    call SetUnitAnimation(udg_FakeMaim, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc09Maim4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_OgreMagiCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // ***
    call CameraSetupApplyForPlayer(true, gg_cam_RuneTalking03, udg_Player_Actual, 0.00)
    // ***
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc09Utok7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_OgreMagiCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_RuneTalking02, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc09Maim5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_OgreMagiCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_RuneTalking03, udg_Player_Actual, 0.00)
    // ***
    call StopSoundBJ(gg_snd_DarkAgents, true)
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc09Utok8, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_OgreMagiCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // ***
    call ConditionalTriggerExecute(gg_trg_OgreMagi_Cinematic_Cleanup)
endfunction

