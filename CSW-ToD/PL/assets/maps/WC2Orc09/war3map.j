//===========================================================================
// Trigger: Init 06a Easy
//===========================================================================
function Trig_Init_06a_Easy_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_06a_Easy_Actions takes nothing returns nothing
    // Caravan
    set udg_Real_CaravanPreparation=240.00
    set udg_Real_CaravanSpeed=150.00
    set udg_Int_CaravansAllowedToFlee=4
    // Razing/Hold
    set udg_Real_TyrsHandAttackGap=90.00
    set udg_Int_TyrsHandAttackSize=1
    // Naval
    // Remove Normal/Hard units
    // Camp
    call BlzUnitDisableAbility(gg_unit_nsqa_0467, 'ACrn', true, true)
    call BlzUnitDisableAbility(gg_unit_nsqa_0467, 'ACtc', true, true)
    call ReplaceUnitBJ(gg_unit_nsqe_0397, 'nwen', bj_UNIT_STATE_METHOD_RELATIVE)
    call RemoveUnit(gg_unit_hSSt_0476)
    call RemoveUnit(gg_unit_hSSt_0475)
    call RemoveUnit(gg_unit_hKSt_0474)
    call RemoveUnit(gg_unit_hKSt_0480)
    call RemoveUnit(gg_unit_hfSt_0183)
    call RemoveUnit(gg_unit_hfSt_0184)
    call RemoveUnit(gg_unit_hSSt_0179)
    // Sea
    call RemoveUnit(gg_unit_e60C_0096)
    call RemoveUnit(gg_unit_e60C_0092)
    call RemoveUnit(gg_unit_e60C_0094)
    call RemoveUnit(gg_unit_hBsS_0090)
    call RemoveUnit(gg_unit_e000_0086)
    call RemoveUnit(gg_unit_e000_0078)
    // Keep
    call RemoveUnit(gg_unit_h60S_0376)
    call RemoveUnit(gg_unit_h60S_0195)
    call RemoveUnit(gg_unit_h60S_0197)
    call RemoveUnit(gg_unit_h60S_0211)
