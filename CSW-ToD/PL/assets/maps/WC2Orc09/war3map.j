//===========================================================================
// Trigger: AIP03 Start
//===========================================================================
function Trig_AIP03_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerStateBJ(udg_Player03_Stromgarde_Keep, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(udg_Player03_Stromgarde_Keep, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call SetPlayerStateBJ(udg_Player03_Stromgarde_Keep, PLAYER_STATE_FOOD_CAP_CEILING, 400)
    // //
    call EnableTrigger(gg_trg_AIP03_Gold)
    call EnableTrigger(gg_trg_AIP03_Lumber)
    // //
    call StartCampaignAI(udg_Player03_Stromgarde_Keep, "CSW\\Scripts\\ToDScripts\\WC2Orc09\\WC2Orc09P03AllianceAI.ai")
endfunction

//===========================================================================
function InitTrig_AIP03_Start takes nothing returns nothing
    set gg_trg_AIP03_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AIP03_Start, function Trig_AIP03_Start_Actions)
endfunction

