//===========================================================================
// Trigger: Light Snow Begin
//===========================================================================
function Trig_Light_Snow_Begin_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_BlizzardStarted == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_Snow_Begin_Func003001 takes nothing returns boolean
    return ( udg_Bool_BlizzardStarted == true )
endfunction

function Trig_Light_Snow_Begin_Actions takes nothing returns nothing
    if ( (udg_Bool_BlizzardStarted == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call AddWeatherEffectSaveLast(GetEntireMapRect(), 'SNls')
    set udg_Weather_SnowLight=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_SnowLight, true)
    set udg_Bool_Snowing=true
    call StartTimerBJ(udg_Timer_SnowIn, true, 1.00)
    call StartTimerBJ(udg_Timer_LightSnowStop, false, GetRandomReal(60.00, 120.00))
endfunction

//===========================================================================
function InitTrig_Light_Snow_Begin takes nothing returns nothing
    set gg_trg_Light_Snow_Begin=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Light_Snow_Begin, udg_Timer_LightSnowFall)
    call TriggerAddCondition(gg_trg_Light_Snow_Begin, Condition(function Trig_Light_Snow_Begin_Conditions))
    call TriggerAddAction(gg_trg_Light_Snow_Begin, function Trig_Light_Snow_Begin_Actions)
endfunction

