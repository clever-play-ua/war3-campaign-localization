//===========================================================================
// Trigger: Hold Discover
//===========================================================================
function Trig_Hold_Discover_Func006C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_OQBerserker) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hold_Discover_Func008C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_OQOgre) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hold_Discover_Actions takes nothing returns nothing
    set udg_Point_HoldCreateAttackWave=GetRectCenter(gg_rct_SpawnPoint)
    set udg_Point_HoldAttackWaveStart=GetRectCenter(gg_rct_THBuild)
    set udg_Point_HoldAttackWaveHero=GetRectCenter(gg_rct_Veldemar02)
    call ConditionalTriggerExecute(gg_trg_Hold_AttackWave_Create)
    // //
    if ( Trig_Hold_Discover_Func006C() ) then
        call QuestSetFailedBJ(udg_OQBerserker, true)
    else
    endif
    // //
    if ( Trig_Hold_Discover_Func008C() ) then
        call QuestSetFailedBJ(udg_OQOgre, true)
    else
    endif
    // //
    call StartTimerBJ(udg_Timer_TyrsHandAttack, false, udg_Real_TyrsHandAttackGap)
    call QueuedTriggerAddBJ(gg_trg_Hold_Discover_Q, true)
endfunction

//===========================================================================
function InitTrig_Hold_Discover takes nothing returns nothing
    set gg_trg_Hold_Discover=CreateTrigger()
    call TriggerAddAction(gg_trg_Hold_Discover, function Trig_Hold_Discover_Actions)
endfunction

//===========================================================================
// Trigger: Hold Discover Q
//===========================================================================
function Trig_Hold_Discover_Q_Actions takes nothing returns nothing
    // //
    // //
    call StartTimerBJ(udg_Timer_LastStand, false, 390.00)
    // //
    call CreateTimerDialogBJ(udg_Timer_LastStand, "TRIGSTR_3504")
    set udg_TimerWindow_LastStand=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayBJ(true, udg_TimerWindow_LastStand)
    // //
    call QuestSetDiscoveredBJ(udg_MQHold, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3236")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call StopMusicBJ(false)
    call ClearMapMusicBJ()
    call PlaySoundBJ(gg_snd_OrcCinematicThemeTension)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_BTGCinematic, 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc09Rend10, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_BTGCinematic, 'N60K', GetCameraTargetPositionLoc(), gg_snd_WC2Orc09Maim7, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_MaroonCinematic, 'o605', GetCameraTargetPositionLoc(), gg_snd_WC2Orc09Utok10, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    call EnableTrigger(gg_trg_Hold_ArmyDead_Defeat)
endfunction

//===========================================================================
function InitTrig_Hold_Discover_Q takes nothing returns nothing
    set gg_trg_Hold_Discover_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Hold_Discover_Q, function Trig_Hold_Discover_Q_Actions)
endfunction

