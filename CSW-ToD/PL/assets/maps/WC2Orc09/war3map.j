//===========================================================================
// Trigger: TransportationSystemOff
//===========================================================================
function Trig_TransportationSystemOff_Actions takes nothing returns nothing
    // //
    set udg_TransportationSystemsPrimed=false
    // //
    call DisableTrigger(gg_trg_PlayerSurfaceUnitsIndex)
    call DisableTrigger(gg_trg_PlayerSurfaceUnitsDeIndex)
    call DisableTrigger(gg_trg_PlayerMarineAttackOrderPoint)
    call DisableTrigger(gg_trg_IndexTransports)
    call DisableTrigger(gg_trg_DeindexPassengers)
    call DisableTrigger(gg_trg_BoardingOrder)
    call DisableTrigger(gg_trg_DetectSeaLoading)
    call DisableTrigger(gg_trg_DetectSeaUnloading)
    call DisableTrigger(gg_trg_PlayerMarineTRReturnAwaitIndex)
    call DisableTrigger(gg_trg_PlayerMarineTRReturnDeIndex)
    call DisableTrigger(gg_trg_TRReturnAndRecycle)
    // //
    call GroupClear(udg_Group_PlayerSurfaceStructures)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_IdleMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarinesAdditional[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupClear(udg_UnitsInCargo)
    call GroupClear(udg_Group_P18MarineBallistas)
    call GroupClear(udg_Group_P18MarineJaveliners)
    call GroupClear(udg_Group_AITransShipReturnAwait)
    // //
endfunction

