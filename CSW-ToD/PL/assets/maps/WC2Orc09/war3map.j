// Trigger: Camp Completed Q
//===========================================================================
function Trig_Camp_Completed_Q_Actions takes nothing returns nothing
    call QuestItemSetCompletedBJ(udg_QReq_CampLocateClan, true)
    call QuestItemSetCompletedBJ(udg_QReq_CampRendSurvive, true)
    call QuestSetCompletedBJ(udg_MQCamp, true)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3161")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Camp_Completed_Q takes nothing returns nothing
    set gg_trg_Camp_Completed_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Camp_Completed_Q, function Trig_Camp_Completed_Q_Actions)
endfunction

//===========================================================================
// Trigger: Camp CaveDiscovered
//===========================================================================
function Trig_Camp_CaveDiscovered_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_CaveDiscovered_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call WaygateActivateBJ(true, gg_unit_nSW2_0608)
    call WaygateActivateBJ(true, gg_unit_nSW2_0609)
    // //
    call TriggerExecute(gg_trg_VisibilityCaveOn)
    call CameraSetupApplyForPlayer(true, gg_cam_CaveOut, udg_Player_Actual, 1.00)
    call PolledWait(1.00)
    // //
    call KillDestructable(gg_dest_ITcr_1162)
    call KillDestructable(gg_dest_ITcr_2619)
    // //
    call ShowUnitShow(gg_unit_nSW2_0609)
endfunction

//===========================================================================
function InitTrig_Camp_CaveDiscovered takes nothing returns nothing
    set gg_trg_Camp_CaveDiscovered=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Camp_CaveDiscovered, gg_rct_CaveOut1Zone)
    call TriggerAddCondition(gg_trg_Camp_CaveDiscovered, Condition(function Trig_Camp_CaveDiscovered_Conditions))
    call TriggerAddAction(gg_trg_Camp_CaveDiscovered, function Trig_Camp_CaveDiscovered_Actions)
endfunction

