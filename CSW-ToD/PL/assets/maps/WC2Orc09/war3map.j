//===========================================================================
// Trigger: Camp Found
//===========================================================================
function Trig_Camp_Found_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n611' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Found_Func006002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Camp_Found_Func007002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Camp_Found_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ForGroupBJ(udg_Group_BTAtatck, function Trig_Camp_Found_Func006002)
    call ForGroupBJ(udg_Group_BTAtatck, function Trig_Camp_Found_Func007002)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BTG, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player03_Stromgarde_Keep, udg_Player_BTG, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player_Actual, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player03_Stromgarde_Keep, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player18_Stromgarde_Ground, bj_ALLIANCE_UNALLIED)
    // //
    // Corpses
    // //
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n02F', udg_Player_BTG, GetRectCenter(gg_rct_SpearmanCorpse01), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n02F', udg_Player_BTG, GetRectCenter(gg_rct_SpearmanCorpse03), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n02F', udg_Player_BTG, GetRectCenter(gg_rct_SpearmanCorpse02), GetRandomDirectionDeg())
    // //
    call SmartCameraPanBJ(udg_Player_Actual, GetUnitLoc(gg_unit_o614_0009), 1.00)
    // //
    call TriggerSleepAction(1.00)
    call QueuedTriggerAddBJ(gg_trg_Camp_Found_Q, true)
endfunction

//===========================================================================
function InitTrig_Camp_Found takes nothing returns nothing
    set gg_trg_Camp_Found=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Camp_Found, gg_rct_BlackToothCampEnter)
    call TriggerAddCondition(gg_trg_Camp_Found, Condition(function Trig_Camp_Found_Conditions))
    call TriggerAddAction(gg_trg_Camp_Found, function Trig_Camp_Found_Actions)
endfunction

//===========================================================================
// Trigger: Camp Found Q
//===========================================================================
function Trig_Camp_Found_Q_Actions takes nothing returns nothing
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_Actual, 'o60G', GetCameraTargetPositionLoc(), gg_snd_GruntTownAttack1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Maim, 'N60K', gg_snd_WC2Orc09Maim1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call KillUnit(gg_unit_ofor_0016)
    // //
    call EnableTrigger(gg_trg_Camp_Completed)
endfunction

