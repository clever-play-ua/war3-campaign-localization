//===========================================================================
function InitTrig_Ambush_Cinematic_Q takes nothing returns nothing
    set gg_trg_Ambush_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Ambush_Cinematic_Q, function Trig_Ambush_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Ambush Cinematic SetUp
//===========================================================================
function Trig_Ambush_Cinematic_SetUp_Func056001002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Ambush_Cinematic_SetUp_Func056A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P1GroundTroopsToHide)
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Ambush_Cinematic_SetUp_Func070002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Ambush_Cinematic_SetUp_Func075002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Ambush_Cinematic_SetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // CreateTrolls
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60O', udg_Player_Trolls, GetRectCenter(gg_rct_Berserker01), GetUnitLoc(gg_unit_h60S_0145))
    set udg_Unit_CinTroll[1]=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_CinTroll[1])
    call RemoveGuardPosition(udg_Unit_CinTroll[1])
    call GroupAddUnitSimple(udg_Unit_CinTroll[1], udg_Group_ZulJeenBerserkers)
    // ///
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60O', udg_Player_Trolls, GetRectCenter(gg_rct_Berserker02), GetUnitLoc(gg_unit_h60S_0146))
    set udg_Unit_CinTroll[2]=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_CinTroll[2])
    call RemoveGuardPosition(udg_Unit_CinTroll[2])
    call GroupAddUnitSimple(udg_Unit_CinTroll[2], udg_Group_ZulJeenBerserkers)
    // ///
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60O', udg_Player_Trolls, GetRectCenter(gg_rct_Berserker03), GetUnitLoc(gg_unit_h60S_0147))
    set udg_Unit_CinTroll[3]=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_CinTroll[3])
    call RemoveGuardPosition(udg_Unit_CinTroll[3])
    call GroupAddUnitSimple(udg_Unit_CinTroll[3], udg_Group_ZulJeenBerserkers)
    // ///
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60O', udg_Player_Trolls, GetRectCenter(gg_rct_Berserker04), GetUnitLoc(gg_unit_h60S_0148))
    set udg_Unit_CinTroll[4]=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_CinTroll[4])
    call RemoveGuardPosition(udg_Unit_CinTroll[4])
    call GroupAddUnitSimple(udg_Unit_CinTroll[4], udg_Group_ZulJeenBerserkers)
    // ///
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60O', udg_Player_Trolls, GetRectCenter(gg_rct_Berserker05), GetUnitLoc(gg_unit_h60S_0153))
    set udg_Unit_CinTroll[5]=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_CinTroll[5])
    call RemoveGuardPosition(udg_Unit_CinTroll[5])
    call GroupAddUnitSimple(udg_Unit_CinTroll[5], udg_Group_ZulJeenBerserkers)
    // ///
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60O', udg_Player_Silverhand, GetRectCenter(gg_rct_Berserker06), GetUnitLoc(gg_unit_h60S_0149))
    set udg_Unit_CinTroll[6]=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_CinTroll[6])
    call RemoveGuardPosition(udg_Unit_CinTroll[6])
    call GroupAddUnitSimple(udg_Unit_CinTroll[6], udg_Group_ZulJeenBerserkers)
    // ///
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60O', udg_Player_Trolls, GetRectCenter(gg_rct_Berserker07), GetUnitLoc(gg_unit_h60S_0152))
    set udg_Unit_CinTroll[7]=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_CinTroll[7])
    call RemoveGuardPosition(udg_Unit_CinTroll[7])
    call GroupAddUnitSimple(udg_Unit_CinTroll[7], udg_Group_ZulJeenBerserkers)
    // ///
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60T', udg_Player_Trolls, GetRectCenter(gg_rct_BerserkerStart), GetUnitLoc(gg_unit_h60S_0151))
    set udg_Unit_BerserkerCinematic=GetLastCreatedUnit()
    call ShowUnitHide(udg_Unit_BerserkerCinematic)
    call RemoveGuardPosition(udg_Unit_BerserkerCinematic)
    // ///
    // Hide real player Units
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Ambush_Cinematic_SetUp_Func056001002)), function Trig_Ambush_Cinematic_SetUp_Func056A)
    // ///
    // Set up fake actors
    // ///
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_Mid01FakeRend01), GetRectCenter(gg_rct_RendAmbush))
    call SetUnitPositionLocFacingLocBJ(udg_FakeUtok, GetRectCenter(gg_rct_Mid01FakeUtok01), GetRectCenter(gg_rct_Mid01FakeUtokWounded))
    set udg_Point_CinAmbTrollTemp=GetRectCenter(gg_rct_CinAmbushTrollsStaging)
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[1], GetRectCenter(gg_rct_Mid01FakeGrunt01), udg_Point_CinAmbTrollTemp)
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[2], GetRectCenter(gg_rct_Mid01FakeGrunt02), udg_Point_CinAmbTrollTemp)
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[3], GetRectCenter(gg_rct_Mid01FakeGrunt03), udg_Point_CinAmbTrollTemp)
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[4], GetRectCenter(gg_rct_Mid01FakeGrunt04), udg_Point_CinAmbTrollTemp)
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[5], GetRectCenter(gg_rct_Mid01FakeGrunt05), udg_Point_CinAmbTrollTemp)
    call RemoveLocation(udg_Point_CinAmbTrollTemp)
    // ///
    call ForGroupBJ(udg_Group_FakeGrunts, function Trig_Ambush_Cinematic_SetUp_Func070002)
    // ///
    call ShowUnitShow(udg_FakeRend)
    call ShowUnitShow(udg_FakeUtok)
    // ///
    call ForGroupBJ(udg_Group_FakeGrunts, function Trig_Ambush_Cinematic_SetUp_Func075002)
    // ///
    call PauseUnitBJ(false, udg_FakeRend)
    call PauseUnitBJ(false, udg_FakeUtok)
    // ///
    // FakeActors are walking
    call ConditionalTriggerExecute(gg_trg_Ambush_Cinematic_OrcsRoute)
    // Pause Elven Rangers
    // ///
    // ///
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_Alliance, bj_ALLIANCE_NEUTRAL_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Alliance, udg_Player_BTGCinematic, bj_ALLIANCE_NEUTRAL_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_Alliance, udg_Player_MaroonCinematic, bj_ALLIANCE_NEUTRAL_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_MaroonCinematic, udg_Player_Alliance, bj_ALLIANCE_NEUTRAL_VISION)
    // ///
    // ///
endfunction

