//===========================================================================
// Trigger: Razing Discover Q
//===========================================================================
function Trig_Razing_Discover_Q_Func015C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_BarracksToDestroyArr[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Razing_Discover_Q_Func017C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_BarracksToDestroyArr[2]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Razing_Discover_Q_Func019C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_BarracksToDestroyArr[3]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Razing_Discover_Q_Func021C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_BarracksToDestroyArr[4]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Razing_Discover_Q_Actions takes nothing returns nothing
    call StartTimerBJ(udg_Timer_RazingDebug, true, 2.50)
    call SetPlayerTechMaxAllowedSwap('o006', 1, udg_Player_Actual)
    // //
    call SetSpeechVolumeGroupsBJ()
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), udg_Player_MaroonCinematic, 'o605', "TRIGSTR_3218", GetCameraTargetPositionLoc(), gg_snd_WC2Orc09Utok9, "TRIGSTR_3219", bj_TIMETYPE_ADD, 0, true)
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), udg_Player_BTGCinematic, 'O617', "TRIGSTR_3220", GetCameraTargetPositionLoc(), gg_snd_WC2Orc09Rend9, "TRIGSTR_3221", bj_TIMETYPE_ADD, 0, true)
    call TransmissionFromUnitTypeWithNameBJ(GetPlayersAll(), udg_Player_BTGCinematic, 'N60K', "TRIGSTR_3222", GetCameraTargetPositionLoc(), gg_snd_WC2Orc09Maim6, "TRIGSTR_3223", bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call QuestSetDiscoveredBJ(udg_MQRazing, true)
    // //
    call CampaignMinimapIconUnitBJ(udg_Hero_MageBoss, bj_CAMPPINGSTYLE_BOSS)
    set udg_MinimapIcon_Mage=GetLastCreatedMinimapIcon()
    // //
    if ( Trig_Razing_Discover_Q_Func015C() ) then
        call CampaignMinimapIconUnitBJ(gg_unit_h616_0629, bj_CAMPPINGSTYLE_PRIMARY_GREEN)
        set udg_MinimapIcon_BarracksArr[1]=GetLastCreatedMinimapIcon()
    else
    endif
    // //
    if ( Trig_Razing_Discover_Q_Func017C() ) then
        call CampaignMinimapIconUnitBJ(gg_unit_h616_0628, bj_CAMPPINGSTYLE_PRIMARY_GREEN)
        set udg_MinimapIcon_BarracksArr[2]=GetLastCreatedMinimapIcon()
    else
    endif
    // //
    if ( Trig_Razing_Discover_Q_Func019C() ) then
        call CampaignMinimapIconUnitBJ(gg_unit_h616_0630, bj_CAMPPINGSTYLE_PRIMARY_GREEN)
        set udg_MinimapIcon_BarracksArr[3]=GetLastCreatedMinimapIcon()
    else
    endif
    // //
    if ( Trig_Razing_Discover_Q_Func021C() ) then
        call CampaignMinimapIconUnitBJ(gg_unit_h616_0039, bj_CAMPPINGSTYLE_PRIMARY_GREEN)
        set udg_MinimapIcon_BarracksArr[4]=GetLastCreatedMinimapIcon()
    else
    endif
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3224")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_ALWAYSHINT, "TRIGSTR_3225")
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // //
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, udg_Point_RazingCitadel, 2048.00)
    set udg_VisMod_TyrsKeep=GetLastCreatedFogModifier()
    // //
    call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, udg_Point_RazingCitadel, 5.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    // //
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, udg_Point_RazingCitadel)
    // //
    call EnableTrigger(gg_trg_Razing_Citadel_Ping)
    // //
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
endfunction

//===========================================================================
function InitTrig_Razing_Discover_Q takes nothing returns nothing
    set gg_trg_Razing_Discover_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Razing_Discover_Q, function Trig_Razing_Discover_Q_Actions)
endfunction

//===========================================================================
// Trigger: Razing Update DestroyCitadel
//
// Fortress is cleared
//===========================================================================
function Trig_Razing_Update_DestroyCitadel_Func003002002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player03_Stromgarde_Keep )
endfunction

function Trig_Razing_Update_DestroyCitadel_Func003002002002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Razing_Update_DestroyCitadel_Func003002002002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_Razing_Update_DestroyCitadel_Func003002002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true)) // INLINED!!
endfunction

function Trig_Razing_Update_DestroyCitadel_Func003002002 takes nothing returns boolean
