function Trig_Ambush_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_AmbushCinOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ambush_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_AmbushCinSkipped=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_Ambush_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Ambush_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Ambush_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Ambush_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Ambush_Cinematic_Skipped, Condition(function Trig_Ambush_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Ambush_Cinematic_Skipped, function Trig_Ambush_Cinematic_Skipped_Actions)
endfunction

