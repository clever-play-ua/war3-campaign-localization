//===========================================================================
// Trigger: GateDeath
//===========================================================================
function Trig_GateDeath_Func007Func001Func001C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return true
    endif
    return false
endfunction

function Trig_GateDeath_Func007Func001C takes nothing returns boolean
    if ( not Trig_GateDeath_Func007Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_GateDeath_Func007A takes nothing returns nothing
    if ( Trig_GateDeath_Func007Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_GateDeath_Func009C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(gg_dest_B60A_1070) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_GateDeath_Func010C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(gg_dest_B60A_1069) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_GateDeath_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call KillDestructable(gg_dest_LTba_5045)
    call KillDestructable(gg_dest_LTba_5044)
    call RemoveDestructable(gg_dest_DTlv_5043)
    call RemoveDestructable(gg_dest_B61C_6125)
    call RemoveDestructable(gg_dest_B61C_10205)
    call EnumDestructablesInRectAll(gg_rct_TyrsGateDeathKillBlocker, function Trig_GateDeath_Func007A)
    // CheckNeighborWall
    if ( Trig_GateDeath_Func009C() ) then
        set bj_forLoopBIndex=112
        set bj_forLoopBIndexEnd=115
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call CreateDestructableLoc('YTpb', GetRectCenter(udg_TyrsKeepWallBlockers[GetForLoopIndexB()]), bj_UNIT_FACING, 1, 0)
            set bj_forLoopBIndex=bj_forLoopBIndex + 1
        endloop
    else
    endif
    if ( Trig_GateDeath_Func010C() ) then
        set bj_forLoopBIndex=10
        set bj_forLoopBIndexEnd=14
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call CreateDestructableLoc('YTpb', GetRectCenter(udg_TyrsKeepWallBlockers[GetForLoopIndexB()]), bj_UNIT_FACING, 1, 0)
            set bj_forLoopBIndex=bj_forLoopBIndex + 1
        endloop
    else
    endif
endfunction

//===========================================================================
function InitTrig_GateDeath takes nothing returns nothing
    set gg_trg_GateDeath=CreateTrigger()
    call TriggerRegisterDeathEvent(gg_trg_GateDeath, gg_dest_B61J_3805)
    call TriggerAddAction(gg_trg_GateDeath, function Trig_GateDeath_Actions)
endfunction

