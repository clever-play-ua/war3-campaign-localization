    call TriggerAddAction(gg_trg_Blizzard_Weather_Fades, function Trig_Blizzard_Weather_Fades_Actions)
endfunction

//===========================================================================
// Trigger: Blizzard Freeze Start
//===========================================================================
function Trig_Blizzard_Freeze_Start_Func007Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B61S' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blizzard_Freeze_Start_Func007A takes nothing returns nothing
    if ( Trig_Blizzard_Freeze_Start_Func007Func001C() ) then
        call DestructableRestoreLife(GetEnumDestructable(), GetDestructableMaxLife(GetEnumDestructable()), true)
    else
    endif
endfunction

function Trig_Blizzard_Freeze_Start_Func034A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_Blizzard_Freeze_Start_Func039A takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_TransportAreaForUnload))
    call IssuePointOrderLocBJ(GetEnumUnit(), "unloadall", GetRectCenter(gg_rct_TransportAreaForUnload))
endfunction

function Trig_Blizzard_Freeze_Start_Func111002 takes nothing returns nothing
    call SetUnitOwner(GetEnumUnit(), udg_Player_BTG, false)
endfunction

function Trig_Blizzard_Freeze_Start_Func113002 takes nothing returns nothing
    call UnitShareVisionBJ(true, GetEnumUnit(), udg_Player_Actual)
endfunction

function Trig_Blizzard_Freeze_Start_Actions takes nothing returns nothing
    set udg_Transporting01Blocked=true
    set udg_Transporting02Blocked=true
    set udg_Transporting03Blocked=true
    // //
    set udg_Bool_SeaIsForzen=true
    // //
    call EnumDestructablesInRectAll(GetPlayableMapRect(), function Trig_Blizzard_Freeze_Start_Func007A)
    // //
    call PlaySoundBJ(gg_snd_Ice_Cracking)
    // //
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 10.00)
    call PolledWait(0.50)
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 20.00)
    call PolledWait(0.50)
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 30.00)
    call PolledWait(0.50)
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 40.00)
    call PolledWait(0.50)
    call ConditionalTriggerExecute(gg_trg_Blizzard_SetUnitAmphibious)
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 50.00)
    call PolledWait(0.50)
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 60.00)
    call PolledWait(0.50)
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 70.00)
    // //
    // Disable AI transportation system
    call DisableTrigger(gg_trg_TransportationSystemOff)
    // //
    // Make Units capable on ice walking
    // //
    // Kill all enemy Transports
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player18_Stromgarde_Ground, 'h60P'), function Trig_Blizzard_Freeze_Start_Func034A)
    // //
    // Ulnload Player Units from Transports
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'o60Q'), function Trig_Blizzard_Freeze_Start_Func039A)
    // //
    call PolledWait(1.00)
    // //
    // Freeze Naval Buildings
    // //
    call ConditionalTriggerExecute(gg_trg_Blizzard_Freeze_Simple)
    // Horde
    // //
    // Freeze Naval Units
    // //
    // //
    // Horde
    // //
    call PolledWait(0.50)
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 80.00)
    call PolledWait(0.50)
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 90.00)
    call PolledWait(0.50)
    call SetWaterBaseColorBJ(50.00, 50.00, 100, 100.00)
    call PolledWait(2.00)
    // //
    // //
    // //
    call ForGroupBJ(udg_Group_FrozenUnits, function Trig_Blizzard_Freeze_Start_Func111002)
    // //
    call ForGroupBJ(udg_Group_FrozenUnits, function Trig_Blizzard_Freeze_Start_Func113002)
    // //
    call SetPlayerUnitAvailableBJ('o60V', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60N', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('u002', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60M', false, udg_Player_Actual)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player18_Stromgarde_Ground, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player18_Stromgarde_Ground, udg_Player_BTG, bj_ALLIANCE_NEUTRAL)
    call SetPlayerName(udg_Player_BTG, "TRIGSTR_3286")
    call SetPlayerTechMaxAllowedSwap('o605', 0, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o006', 1, udg_Player_Actual)
    // //
endfunction

//===========================================================================
function InitTrig_Blizzard_Freeze_Start takes nothing returns nothing
    set gg_trg_Blizzard_Freeze_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_Blizzard_Freeze_Start, function Trig_Blizzard_Freeze_Start_Actions)
endfunction

//===========================================================================
// Trigger: Blizzard Freeze Simple
//===========================================================================
function Trig_Blizzard_Freeze_Simple_Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blizzard_Freeze_Simple_Func001A takes nothing returns nothing
    if ( Trig_Blizzard_Freeze_Simple_Func001Func001C() ) then
        call PauseUnitBJ(true, GetEnumUnit())
        call UnitAddAbilityBJ('A624', GetEnumUnit())
        call SetUnitTimeScalePercent(GetEnumUnit(), 0.00)
        call SetUnitVertexColorBJ(GetEnumUnit(), 80.00, 80.00, 100, 0)
        call SetUnitInvulnerable(GetEnumUnit(), true)
        call GroupAddUnitSimple(GetEnumUnit(), udg_Group_FrozenUnits)
    else
    endif
endfunction

function Trig_Blizzard_Freeze_Simple_Actions takes nothing returns nothing
    call ForGroupBJ(udg_G_NavalQueueForFreeze, function Trig_Blizzard_Freeze_Simple_Func001A)
endfunction

//===========================================================================
