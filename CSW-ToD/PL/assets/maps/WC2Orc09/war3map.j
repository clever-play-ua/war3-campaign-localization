//===========================================================================
// Trigger: ForceBoardingOrder
//===========================================================================
function Trig_ForceBoardingOrder_Conditions takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetOrderedUnit())) != MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ForceBoardingOrder_Actions takes nothing returns nothing
    local integer fb
    if s__ForceBoarding_struct[GetUnitUserData(GetOrderedUnit())] != 0 then
    set fb=s__ForceBoarding_struct[GetUnitUserData(GetOrderedUnit())]
    if UnitAlive(s__ForceBoarding_marine[fb]) and UnitAlive(s__ForceBoarding_transport[fb]) then
    call IssueTargetOrderById(s__ForceBoarding_marine[fb], 851971, s__ForceBoarding_transport[fb])
    endif
    endif
endfunction

//===========================================================================
function InitTrig_ForceBoardingOrder takes nothing returns nothing
    set gg_trg_ForceBoardingOrder=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ForceBoardingOrder, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddCondition(gg_trg_ForceBoardingOrder, Condition(function Trig_ForceBoardingOrder_Conditions))
    call TriggerAddAction(gg_trg_ForceBoardingOrder, function Trig_ForceBoardingOrder_Actions)
endfunction

//===========================================================================
// Trigger: TransportationConfig
//===========================================================================
function Trig_TransportationConfig_Actions takes nothing returns nothing
    // //
    set udg_TempPlayer=udg_Player18_Stromgarde_Ground
    set udg_TempInteger=GetConvertedPlayerId(udg_TempPlayer)
    // //
    set udg_IdleTransports[udg_TempInteger]=CreateGroup()
    set udg_IdleMarines[udg_TempInteger]=CreateGroup()
    set udg_QueuedTransports[udg_TempInteger]=CreateGroup()
    set udg_DepartedTransports[udg_TempInteger]=CreateGroup()
    set udg_QueuedMarines[udg_TempInteger]=CreateGroup()
    set udg_QueuedMarinesAdditional[udg_TempInteger]=CreateGroup()
    // //
    set udg_LandingWarfareManipulator[udg_TempInteger]=gg_trg_PlayerMarineLandingOrder
    // //
    set udg_BoardingOrderTimerPeriod=2.00
    set udg_BoardingOrderTimerInterval=8.00
    // //
    set udg_DepartureDetectionRange=512.00
    // //
    set udg_AttackPointDetectionRange=384.00
    set udg_AdditionalDetectionRange=896.00
    // //
    // //
    call StartTimerBJ(udg_BoardingOrderTimer, true, udg_BoardingOrderTimerPeriod)
    // //
    set udg_TransportationSystemsPrimed=true
    // //
    call ConditionalTriggerExecute(gg_trg_TransportationLandingZoneConfig)
endfunction

