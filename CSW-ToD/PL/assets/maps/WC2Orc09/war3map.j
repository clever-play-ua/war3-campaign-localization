//===========================================================================
// Trigger: NextLevelPrep
//===========================================================================
function Trig_NextLevelPrep_Func003C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Maim) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_NextLevelPrep_Func004C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Rend) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_NextLevelPrep_Func006C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_NextLevelPrep_Actions takes nothing returns nothing
    // //
    // //
    if ( Trig_NextLevelPrep_Func003C() ) then
        call ReviveHeroLoc(udg_Hero_Maim, GetRectCenter(gg_rct_HoldTheLineMaim), false)
    else
        call ShowUnitShow(udg_Hero_Maim)
    endif
    if ( Trig_NextLevelPrep_Func004C() ) then
        call ReviveHeroLoc(udg_Hero_Rend, GetRectCenter(gg_rct_HoldTheLineRend), false)
    else
        call ShowUnitShow(udg_Hero_Rend)
    endif
    // //
    if ( Trig_NextLevelPrep_Func006C() ) then
        call ShowUnitShow(udg_SemiHero_Utok)
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_Capitan), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
    endif
    // //
    // Need to replace amphibious units with default one
    call SetPlayerTechResearchedSwap('RTI0', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('RtI0', 1, udg_Player_Actual)
    // //
    call PolledWait(0.50)
    // //
    // Store characters into cache
    // //
    call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc09", udg_Cache)
    call StoreUnitBJ(udg_Hero_Rend, "Rend", "WC2Orc09", udg_Cache)
    call StoreUnitBJ(udg_Hero_Maim, "Maim", "WC2Orc09", udg_Cache)
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', udg_Player_Actual), "UtokLevel", "WC2Orc09", udg_Cache)
    call StoreBooleanBJ(true, "Completed", "WC2Orc09", udg_Cache)
    // //
    call PolledWait(0.50)
    // //
    call SaveGameCacheBJ(udg_Cache)
    // //
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call ShowCustomCampaignButton(true, 15)
    call SetNextLevelBJ("WC2Orc10.w3x")
    call CustomVictoryBJ(udg_Player_Actual, true, true)
    // //
    // //
endfunction

//===========================================================================
function InitTrig_NextLevelPrep takes nothing returns nothing
    set gg_trg_NextLevelPrep=CreateTrigger()
    call TriggerAddAction(gg_trg_NextLevelPrep, function Trig_NextLevelPrep_Actions)
endfunction

