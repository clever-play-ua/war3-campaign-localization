        return false
    endif
    return true
endfunction

function Trig_AI_P16_Attacker_Being_Attacked_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_AI_P16_Attacker_Being_Attacked_Func002C() ) then
        call ForGroupBJ(udg_G_P16_Attacker, function Trig_AI_P16_Attacker_Being_Attacked_Func002Func001A)
        call PolledWait(6.00)
        call ForGroupBJ(udg_G_P16_Attacker, function Trig_AI_P16_Attacker_Being_Attacked_Func002Func003A)
    else
        if ( Trig_AI_P16_Attacker_Being_Attacked_Func002Func004C() ) then
            call ForGroupBJ(udg_G_P16_Attacker, function Trig_AI_P16_Attacker_Being_Attacked_Func002Func004Func002A)
            call PolledWait(6.00)
        else
            call ForGroupBJ(udg_G_P16_Attacker, function Trig_AI_P16_Attacker_Being_Attacked_Func002Func004Func001A)
        endif
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction

