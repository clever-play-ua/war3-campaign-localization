endfunction

//===========================================================================
// Trigger: OgreMagi Cinematic Cleanup
//===========================================================================
function Trig_OgreMagi_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgreMagi_Cinematic_Cleanup_Func008002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_OgreMagi_Cinematic_Cleanup_Func010A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_OgreMagi_Cinematic_Cleanup_Func012C takes nothing returns boolean
    if ( not ( udg_Bool_OgreMagiCinSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgreMagi_Cinematic_Cleanup_Func021C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgreMagi_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_OgreMagi_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set udg_Bool_OgreMagiCinOn=false
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call TriggerSleepAction(0.50)
    // //
    call ForGroupBJ(udg_Group_P1GroundTroopsToHide, function Trig_OgreMagi_Cinematic_Cleanup_Func008002)
    // //
    call ForGroupBJ(udg_Group_CinematicPausedUnits, function Trig_OgreMagi_Cinematic_Cleanup_Func010A)
    // //
    if ( Trig_OgreMagi_Cinematic_Cleanup_Func012C() ) then
        // SoundsOff
        call StopSoundBJ(gg_snd_DarkAgents, false)
        call StopSoundBJ(gg_snd_WC2Orc09Utok7, false)
        call StopSoundBJ(gg_snd_WC2Orc09Utok8, false)
        call StopSoundBJ(gg_snd_WC2Orc09Maim4, false)
        call StopSoundBJ(gg_snd_WC2Orc09Maim5, false)
        // //
    else
    endif
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call TriggerSleepAction(0.01)
    // Restore Camera
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(udg_VarCurrentCamera), 0)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_OgreMagi_Cinematic_Cleanup_Func021C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_OgreMagi_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Ogre_Discover)
endfunction

