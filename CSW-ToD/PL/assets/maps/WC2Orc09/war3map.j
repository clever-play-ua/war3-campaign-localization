//===========================================================================
// Trigger: Init 03 Audio
//===========================================================================
function Trig_Init_03_Audio_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Music_DefaultNames[0]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    set udg_Music_DefaultNames[1]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[2]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3"
    set udg_Music_DefaultNames[3]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[4]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3"
    set udg_Music_DefaultNames[5]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    // //
    set udg_Music_DefaultNamesCount=6
    // //
    // SetMusicList with Randomizer
    set udg_Music_CurrentName=udg_Music_DefaultNames[GetRandomInt(0, 5)]
    set udg_Music_CurrentVolume=0.00
    // //
    call ClearMapMusicBJ()
endfunction

//===========================================================================
function InitTrig_Init_03_Audio takes nothing returns nothing
    set gg_trg_Init_03_Audio=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_03_Audio, function Trig_Init_03_Audio_Actions)
endfunction

//===========================================================================
// Trigger: Init 04 Environment
//===========================================================================
function Trig_Init_04_Environment_Func012Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'B61S' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_04_Environment_Func012A takes nothing returns nothing
    if ( Trig_Init_04_Environment_Func012Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Init_04_Environment_Func034002 takes nothing returns nothing
    call SetDestructableInvulnerableBJ(GetEnumDestructable(), true)
endfunction

function Trig_Init_04_Environment_Actions takes nothing returns nothing
    // //
    call SetTimeOfDay(9.00)
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    call SetTerrainFogExBJ(0, 2500.00, 10500.00, 0.20, 41.50, 55.00, 58.80)
    // //
    call SetDayNightModels("csw\\environment\\dnc\\LordaeronWinter\\dnclordaeronwinterterrain.mdx", "csw\\environment\\dnc\\LordaeronWinter\\dnclordaeronwinterunit.mdx")
    // //
    set udg_Real_BlizzardWeatherDuration=30.00
    // //
    // Remove Ice
    // //
    call EnumDestructablesInRectAll(GetPlayableMapRect(), function Trig_Init_04_Environment_Func012A)
    // //
    call SetDestructableOccluderHeight(gg_dest_B60I_7963, 300.00)
    call SetDestructableOccluderHeight(gg_dest_B60L_7962, 300.00)
    // //
    call SetDoodadAnimationRectBJ("death", 'D6CF', gg_rct_TyrsQuest)
    call SetDoodadAnimationRectBJ("death", 'XOmr', gg_rct_ForceBridgeVisibility)
    call SetDoodadAnimationRectBJ("death", 'XOmr', gg_rct_RunesHintWay)
    // //
    call KillDestructable(gg_dest_DTs2_1160)
    call KillDestructable(gg_dest_DTep_8308)
    call KillDestructable(gg_dest_DTep_8307)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_B004_8324, true)
    call SetDestructableInvulnerableBJ(gg_dest_B004_8341, true)
    call SetDestructableInvulnerableBJ(gg_dest_B004_8325, true)
    call SetDestructableInvulnerableBJ(gg_dest_B004_8323, true)
    // //
    set udg_Point_RazingCitadel=GetRectCenter(gg_rct_TyrsQuest)
    // //
    // Make the Mage Tower Invulnerable
    // //
    call EnumDestructablesInRectAll(gg_rct_TyrsQuest, function Trig_Init_04_Environment_Func034002)
    // //
    // Regions for Pathing Blockers
    // //
    // Regions for Pathing Blockers At the Gate
    // //
    set udg_TyrsKeepGateBlockers[1]=gg_rct_PathingBlockerTyrsGate01
    set udg_TyrsKeepGateBlockers[2]=gg_rct_PathingBlockerTyrsGate02
    set udg_TyrsKeepGateBlockers[3]=gg_rct_PathingBlockerTyrsGate03
    set udg_TyrsKeepGateBlockers[4]=gg_rct_PathingBlockerTyrsGate04
    set udg_TyrsKeepGateBlockers[5]=gg_rct_PathingBlockerTyrsGate05
    set udg_TyrsKeepGateBlockers[6]=gg_rct_PathingBlockerTyrsGate06
    set udg_TyrsKeepGateBlockers[7]=gg_rct_PathingBlockerTyrsGate07
    set udg_TyrsKeepGateBlockers[8]=gg_rct_PathingBlockerTyrsGate08
    set udg_TyrsKeepGateBlockers[9]=gg_rct_PathingBlockerTyrsGate09
    // //
    // Regions for Pathing Blockers after destroyed walls
    // //
    call Trig_InitTyrCastleWalls_Actions()
    // //
    // Castle Gate Bridge Init
    // //
    set udg_CastleBridgePlatform[1]=gg_rct_BridgePatch01
    set udg_CastleBridgePlatform[2]=gg_rct_BridgePatch02
    set udg_CastleBridgePlatform[3]=gg_rct_BridgePatch03
    set udg_CastleBridgePlatform[4]=gg_rct_BridgePatch04
    set udg_CastleBridgePlatform[5]=gg_rct_BridgePatch05
    set udg_CastleBridgePlatform[6]=gg_rct_BridgePatch06
    set udg_CastleBridgePlatform[7]=gg_rct_BridgePatch07
    set udg_CastleBridgePlatform[8]=gg_rct_BridgePatch08
    // //
    // Close The Gate
    // //
    call SetDestructableInvulnerableBJ(gg_dest_DTlv_5043, true)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=9
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateDestructableLoc('YTpb', GetRectCenter(udg_TyrsKeepGateBlockers[GetForLoopIndexA()]), bj_UNIT_FACING, 1, 0)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    // Close the Gates of Island Keep
    // //
    call ConditionalTriggerExecute(gg_trg_Razing_Gate_Close)
    // ***
    call KillDestructable(gg_dest_BD07_6127)
    // //
    // //
    // //
    call SetItemVisibleBJ(false, gg_item_IQL1_0614)
    call SetItemVisibleBJ(false, gg_item_IQL0_0615)
    call SetItemVisibleBJ(false, gg_item_IQL2_0616)
    call SetItemVisibleBJ(false, gg_item_IQL3_0617)
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

