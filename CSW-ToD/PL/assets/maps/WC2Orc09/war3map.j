function Trig_Camp_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetup)
    // Ensure Setup completes
    call TriggerSleepAction(0.01)
    // //
    call ConditionalTriggerExecute(gg_trg_Camp_Cinematic_SetUp)
    call TriggerSleepAction(0.01)
    // ***
    call CameraSetupApplyForPlayer(true, gg_cam_OrcCamp, udg_Player_Actual, 0)
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_ReunionCinRend02))
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_ReunionCinUtok02))
    // ***
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_CampMeet, udg_Player_Actual, 7.00, 0, 2.00, 100.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley2, 100, udg_FakeRend)
    set udg_Bool_CampCinOn=true
    set udg_Bool_CinematicSkipped=false
    call PlaySoundBJ(gg_snd_OrcX1)
    // //
    // Cinematic Started and can be skipped now
    // Rend and Maim Arguing
    // //
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_ReunionCinRend02, udg_FakeRend) == true), (udg_Bool_CinematicSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    set udg_Bool_RendTalks=true
    call SetUnitAnimation(udg_FakeRend, "cinematic Standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc09Rend6, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(GetSoundDurationBJ(gg_snd_WC2Orc09Rend6))
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeRend, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic angry one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc09Maim2, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(GetSoundDurationBJ(gg_snd_WC2Orc09Maim2))
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeRend, "cinematic Standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc09Rend7, bj_TIMETYPE_ADD, 0, false)
    // //
    call ConditionalTriggerExecute(gg_trg_Camp_Cinematic_MaimArguingSound)
    call TriggerSleepAction(1.90)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Utok is disapointed
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic headshake one")
    call TriggerSleepAction(1.90)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_ReunionCinUtok04))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, udg_FakeUtok)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Peons, udg_Player_Actual, ( DistanceBetweenPoints(GetUnitLoc(udg_FakeUtok), GetRectCenter(gg_rct_ReunionCinUtok04)) / GetUnitMoveSpeed(udg_FakeUtok) ), 0, 2.00, 100.00)
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_ReunionCinUtok04, udg_FakeUtok) == true), (udg_Bool_CinematicSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeGruntArr[1], 0.25)
    // Utok is giving orders
    call SetUnitAnimation(udg_FakeUtok, "cinematic point one")
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc09Utok4, bj_TIMETYPE_ADD, 0, false)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    call SetUnitFacingToFaceLocTimed(udg_FakeUtok, GetRectCenter(gg_rct_ReunionCinPeon01), 0.60)
    call TriggerSleepAction(0.60)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic point two")
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeGruntArr[1], "cinematic salute one")
    call PlaySoundOnUnitBJ(gg_snd_CS_H01b_Orc_gesture_v2, 100, udg_FakeGruntArr[1])
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGruntArr[1], 0, gg_snd_WC2Orc09Grunt1, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceLocTimed(udg_FakeGruntArr[1], GetRectCenter(gg_rct_ReunionCinPeon01), 0.60)
    call TriggerSleepAction(0.60)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceLocTimed(udg_FakeUtok, GetRectCenter(gg_rct_ReunionCinPeon03), 0.60)
    call SetUnitAnimation(udg_FakeGruntArr[1], "cinematic point three")
    call TriggerSleepAction(0.60)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc09Utok5, bj_TIMETYPE_ADD, 0, false)
    call IssuePointOrderLocBJ(udg_FakePeonArr[3], "move", GetRectCenter(gg_rct_P1RandomUnitZone))
    call TriggerSleepAction(1.20)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic wave two")
    // //
    call SetUnitAnimation(udg_FakeGruntArr[1], "cinematic listening one")
    call PlaySoundAtPointBJ(gg_snd_CS_Prologue2_Foley2, 100, GetRectCenter(gg_rct_ReunionCinBrute01), 0)
    call IssuePointOrderLocBJ(udg_FakePeonArr[4], "move", GetRectCenter(gg_rct_P1RandomUnitZone))
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeGruntArr[1], "move", GetRectCenter(gg_rct_P1RandomUnitZone))
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc09Utok5) - 1.70 ))
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // **
    call IssuePointOrderLocBJ(udg_FakePeonArr[1], "move", GetRectCenter(gg_rct_ReunionCinPeonLoad))
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_ReunionCinUtok05))
    call PlaySoundOnUnitBJ(gg_snd_CS_HU_2_Intro_Foley2, 100, udg_FakeUtok)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_ScopeTime, udg_Player_Actual, 12.00, 0, 1.00, 100.00)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakePeonArr[2], "move", GetRectCenter(gg_rct_ReunionCinPeonLoad))
    loop
        exitwhen ( (GetBooleanOr((RectContainsUnit(gg_rct_ReunionCinUtok05, udg_FakeUtok) == true), (udg_Bool_CinematicSkipped == true))) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Utok is Lookinginto a scope
    // //
    call SetUnitTimeScalePercent(udg_FakeUtok, 25.00)
    call SetUnitAnimation(udg_FakeUtok, "cinematic scope one")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0.00, 0.00, 0.00, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_UtokScope02, udg_Player_Actual, 0.00)
    // //
    set udg_Real_FocalDistance=400.00
    set udg_Real_DepthOfField=200.00
    call ConditionalTriggerExecute(gg_trg_Camp_Cinematic_CameraFocusRun)
    // //
    call CameraSetSourceNoiseForPlayer(udg_Player_Actual, 40.00, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Scope_Mask.blp", 100.00, 100.00, 100.00, 0)
    // //
    call SetCameraFieldForPlayer(udg_Player_Actual, CAMERA_FIELD_ZOFFSET, 100.00, 5.00)
    call SetCameraFieldForPlayer(udg_Player_Actual, CAMERA_FIELD_TARGET_DISTANCE, 525.74, 5.00)
    call SetCameraFieldForPlayer(udg_Player_Actual, CAMERA_FIELD_FIELD_OF_VIEW, 60.00, 5.00)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc09Utok6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_OrcX1, true)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CampCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Camp_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Camp_Cinematic_Q takes nothing returns nothing
    set gg_trg_Camp_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Camp_Cinematic_Q, function Trig_Camp_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Camp Cinematic SetUp
//===========================================================================
function Trig_Camp_Cinematic_SetUp_Func006A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P1GroundTroopsToHide)
endfunction

function Trig_Camp_Cinematic_SetUp_Func009A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P1GroundTroopsToHide)
endfunction

function Trig_Camp_Cinematic_SetUp_Func012001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true )
endfunction

function Trig_Camp_Cinematic_SetUp_Func012001002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) != 'o60P' )
endfunction

function Trig_Camp_Cinematic_SetUp_Func012001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true), (GetUnitTypeId(GetFilterUnit()) != 'o60P')) // INLINED!!
endfunction

function Trig_Camp_Cinematic_SetUp_Func012A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P1GroundTroopsToHide)
endfunction

function Trig_Camp_Cinematic_SetUp_Func014002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Camp_Cinematic_SetUp_Func026002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Camp_Cinematic_SetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // Hiding those who can interfiere
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_PASSIVE)), function Trig_Camp_Cinematic_SetUp_Func006A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Camp_Cinematic_SetUp_Func009A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_BTG, Condition(function Trig_Camp_Cinematic_SetUp_Func012001002)), function Trig_Camp_Cinematic_SetUp_Func012A)
    // //
    call ForGroupBJ(udg_Group_P1GroundTroopsToHide, function Trig_Camp_Cinematic_SetUp_Func014002)
    // //
    // Setting Actors
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call ShowUnitShow(udg_FakeMaim)
    call ShowUnitShow(udg_FakeRend)
    call ShowUnitShow(udg_FakeUtok)
    // //
    call ForGroupBJ(udg_Group_FakeGrunts, function Trig_Camp_Cinematic_SetUp_Func026002)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeMaim, GetRectCenter(gg_rct_ReunionCinMaim), GetRectCenter(gg_rct_ReunionCinRend02))
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    set udg_Point_CampCinFacing=GetRectCenter(gg_rct_ReunionCinMaim)
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_ReunionCinRen01), udg_Point_CampCinFacing)
    call SetUnitPositionLocFacingLocBJ(udg_FakeUtok, GetRectCenter(gg_rct_ReunionCinUtok01), udg_Point_CampCinFacing)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[1], GetRectCenter(gg_rct_ReunionCinBrute01), GetRectCenter(gg_rct_ReunionCinUtok04))
    call SetUnitAnimation(udg_FakeGruntArr[1], "cinematic listening one")
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[2], GetRectCenter(gg_rct_WoundedGrunt01), udg_Point_CampCinFacing)
    call SetUnitAnimation(udg_FakeGruntArr[2], "cinematic injured one")
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[3], GetRectCenter(gg_rct_WoundedGrunt03), udg_Point_CampCinFacing)
    call SetUnitAnimation(udg_FakeGruntArr[3], "cinematic injured one")
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[4], GetRectCenter(gg_rct_WoundedGrunt02), udg_Point_CampCinFacing)
    call SetUnitAnimation(udg_FakeGruntArr[4], "cinematic injured two")
    // //
    call CreateNUnitsAtLoc(1, 'n001', udg_Player_BTGCinematic, GetRectCenter(gg_rct_WoundedOgre), 250.00)
    set udg_FakeOgreArr[1]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_FakeOgreArr[1], "sleep")
    // //
    set udg_Point_CampCinFacing=GetRectCenter(gg_rct_ReunionCinUtok04)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61Y', udg_Player_BTGCinematic, GetRectCenter(gg_rct_ReunionCinPeon03), udg_Point_CampCinFacing)
    set udg_FakePeonArr[1]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61Y', udg_Player_BTGCinematic, GetRectCenter(gg_rct_ReunionCinPeon04), udg_Point_CampCinFacing)
    set udg_FakePeonArr[2]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61Y', udg_Player_BTGCinematic, GetRectCenter(gg_rct_ReunionCinPeon02), udg_Point_CampCinFacing)
    set udg_FakePeonArr[3]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61Y', udg_Player_BTGCinematic, GetRectCenter(gg_rct_ReunionCinPeon01), udg_Point_CampCinFacing)
    set udg_FakePeonArr[4]=GetLastCreatedUnit()
    call RemoveLocation(udg_Point_CampCinFacing)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=2
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call AddUnitAnimationPropertiesBJ(true, "lumber", udg_FakePeonArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Camp_Cinematic_SetUp takes nothing returns nothing
    set gg_trg_Camp_Cinematic_SetUp=CreateTrigger()
    call TriggerAddAction(gg_trg_Camp_Cinematic_SetUp, function Trig_Camp_Cinematic_SetUp_Actions)
endfunction

//===========================================================================
// Trigger: Camp Cinematic Skipped
//===========================================================================
function Trig_Camp_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CampCinOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CampCinSkipped=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_Camp_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Camp_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Camp_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Camp_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Camp_Cinematic_Skipped, Condition(function Trig_Camp_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Camp_Cinematic_Skipped, function Trig_Camp_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Camp Cinematic Cleanup
//
// Need to add order for building oil Rig
//===========================================================================
function Trig_Camp_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Cleanup_Func016002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Camp_Cinematic_Cleanup_Func019001002001 takes nothing returns boolean
    return ( GetFilterUnit() != udg_Hero_Maim )
endfunction

function Trig_Camp_Cinematic_Cleanup_Func019001002002001 takes nothing returns boolean
    return ( GetFilterUnit() != udg_Hero_Rend )
endfunction

function Trig_Camp_Cinematic_Cleanup_Func019001002002002 takes nothing returns boolean
    return ( GetFilterUnit() != udg_SemiHero_Utok )
endfunction

function Trig_Camp_Cinematic_Cleanup_Func019001002002 takes nothing returns boolean
    return GetBooleanAnd((GetFilterUnit() != udg_Hero_Rend), (GetFilterUnit() != udg_SemiHero_Utok)) // INLINED!!
endfunction

function Trig_Camp_Cinematic_Cleanup_Func019001002 takes nothing returns boolean
    return GetBooleanAnd((GetFilterUnit() != udg_Hero_Maim), (GetBooleanAnd((GetFilterUnit() != udg_Hero_Rend), (GetFilterUnit() != udg_SemiHero_Utok)))) // INLINED!!
endfunction

function Trig_Camp_Cinematic_Cleanup_Func019A takes nothing returns nothing
    call SetUnitPositionLocFacingBJ(GetEnumUnit(), GetRandomLocInRect(gg_rct_P1RandomUnitZone), GetRandomDirectionDeg())
endfunction

function Trig_Camp_Cinematic_Cleanup_Func034C takes nothing returns boolean
    if ( not ( udg_Bool_CampCinSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Cleanup_Func055C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CampCinOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Camp_Cinematic_Cleanup_Func003C() ) then
        call CinematicFilterGenericBJ(1.00, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0.00, 100.00, 100.00, 100.00, 0.00)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    // //
    // Cleaning Up Scene
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call PauseUnitBJ(false, gg_unit_o61Y_0022)
    call PauseUnitBJ(false, gg_unit_o61Y_0021)
    // //
    call ForGroupBJ(udg_Group_P1GroundTroopsToHide, function Trig_Camp_Cinematic_Cleanup_Func016002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Camp_Cinematic_Cleanup_Func019001002)), function Trig_Camp_Cinematic_Cleanup_Func019A)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Maim, GetRectCenter(gg_rct_ReunionCinMaim), GetRectCenter(gg_rct_BlackToothCamp))
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_ReunionCinRend02), GetRectCenter(gg_rct_ReunionCinMaim))
    call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_ReunionCinUtok05), 109.71)
    // //
    call RemoveUnit(udg_FakeOgreArr[1])
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=4
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call RemoveUnit(udg_FakePeonArr[GetForLoopIndexB()])
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    call KillDestructable(gg_dest_YT30_2437)
    // //
    call DestructableRestoreLife(gg_dest_DTep_8308, GetDestructableMaxLife(gg_dest_DTep_8308), false)
    call DestructableRestoreLife(gg_dest_DTep_8307, GetDestructableMaxLife(gg_dest_DTep_8307), false)
    // //
    // Need to provide Oil Rig
    if ( Trig_Camp_Cinematic_Cleanup_Func034C() ) then
        // SoundsOff
        call StopSoundBJ(gg_snd_OrcX1, false)
        call StopSoundBJ(gg_snd_WC2Orc09Rend6, false)
        call StopSoundBJ(gg_snd_WC2Orc09Rend7, false)
        call StopSoundBJ(gg_snd_WC2Orc09Utok4, false)
        call StopSoundBJ(gg_snd_WC2Orc09Utok5, false)
        call StopSoundBJ(gg_snd_WC2Orc09Utok6, false)
        call StopSoundBJ(gg_snd_WC2Orc09Grunt1, false)
        call StopSoundBJ(gg_snd_WC2Orc09Maim3, false)
        call StopSoundBJ(gg_snd_WC2Orc09Maim2, false)
        // //
        call SetUnitPositionLoc(gg_unit_h001_0526, GetRectCenter(gg_rct_TankerStop))
    else
    endif
    // //
    call ReplaceUnitBJ(udg_Unit_OilPatchCamp, 'u002', bj_UNIT_STATE_METHOD_DEFAULTS)
    set udg_Unit_PlatformCreated=GetLastReplacedUnitBJ()
    call UnitAddAbilityBJ('A637', udg_Unit_PlatformCreated)
    call SetUnitOwner(udg_Unit_PlatformCreated, Player(0), false)
    // //
    // //
    // ***
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call TriggerSleepAction(0.01)
    // Restore Camera and Selection
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(udg_VarCurrentCamera), 0)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Camp_Cinematic_Cleanup_Func055C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Camp_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Navy_Discover)
endfunction

//===========================================================================
function InitTrig_Camp_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Camp_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Camp_Cinematic_Cleanup, function Trig_Camp_Cinematic_Cleanup_Actions)
endfunction

