    return true
endfunction

function Trig_Ogre_Discover_Actions takes nothing returns nothing
    // //
    call SetDoodadAnimationRectBJ("stand", 'XOmr', gg_rct_RunesHintWay)
    // //
    call RemoveDestructable(gg_dest_B004_8324)
    call RemoveDestructable(gg_dest_B004_8323)
    call RemoveDestructable(gg_dest_B004_8341)
    call RemoveDestructable(gg_dest_B004_8325)
    // //
    call ForGroupBJ(udg_Group_StromgardeAttackOgre, function Trig_Ogre_Discover_Func009002)
    call ForGroupBJ(udg_Group_StromgardeAttackOgre, function Trig_Ogre_Discover_Func010002)
    // //
    if ( Trig_Ogre_Discover_Func012C() ) then
        call PauseTimerBJ(false, udg_Timer_CaravanPause)
        call TimerDialogDisplayForPlayerBJ(true, udg_TimerWindow_Caravan, udg_Player_Actual)
    else
    endif
    // //
