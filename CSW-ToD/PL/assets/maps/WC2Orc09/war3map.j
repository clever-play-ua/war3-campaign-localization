function Trig_Final_Cinematic_Q_Actions takes nothing returns nothing
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetup)
    // Ensure Setup completes
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    call ConditionalTriggerExecute(gg_trg_Hold_Gate_Up)
    // //
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_SetUp)
    call CameraSetupApplyForPlayer(true, gg_cam_OutroTurtles01, udg_Player_Actual, 0)
    call TriggerSleepAction(0.25)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call ConditionalTriggerExecute(gg_trg_Blizzard_Melt)
    // //
    // Cinematic Started
    // //
    set udg_Bool_OutroCinOn=true
    call PlaySoundBJ(gg_snd_TheHorde)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_OutroTurtles02, udg_Player_Actual, 7.00, 0, 2.00, 100.00)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ForGroupBJ(udg_Group_CinFootmansIce, function Trig_Final_Cinematic_Q_Func033A)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'e003', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_FinalShipWreckageA), GetRectCenter(gg_rct_FinalTurtleC05))
    set udg_Unit_CinematicWreckageShip01=GetLastCreatedUnit()
    call SetUnitTimeScalePercent(udg_Unit_CinematicWreckageShip01, 15.00)
    call SetUnitAnimation(udg_Unit_CinematicWreckageShip01, "death")
    // //
    call TriggerSleepAction(1.00)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DrwonedFoormanIce01), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl")
    set udg_SE_FinalCinWaterSplashArr[1]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DrwonedFoormanIce02), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl")
    set udg_SE_FinalCinWaterSplashArr[2]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DrwonedFoormanIce03), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl")
    set udg_SE_FinalCinWaterSplashArr[3]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DrwonedFoormanIce04), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl")
    set udg_SE_FinalCinWaterSplashArr[4]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_DrwonedFoormanIce05), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl")
    set udg_SE_FinalCinWaterSplashArr[5]=GetLastCreatedEffectBJ()
    // //
    call EnumDestructablesInRectAll(GetPlayableMapRect(), function Trig_Final_Cinematic_Q_Func057A)
    // //
    call KillUnit(udg_Unit_CinematicWreckageShip02)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call ResetUnitAnimation(udg_Unit_CinFootmanOnIceArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // ///////
    // ///////
    // Go underwater
    // ///////
    // ///////
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_CameraBoundsUnderwater)
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_SPELLS, 0.00)
    // //
    call SetSkyModel(null)
    call SetTerrainFogExBJ(0, 50.00, 2500.00, 0.50, 0.00, 0.00, 50.00)
    call AddWeatherEffectSaveLast(gg_rct_Moonrays, 'LRma')
    set udg_Weather_Moonrays=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_Moonrays, true)
    // //
    call SetSoundPositionLocBJ(gg_snd_undwaterloop, GetRectCenter(gg_rct_Moonrays), 50.00)
    // //
    call CameraSetFocalDistance(600.00)
    call CameraSetDepthOfFieldScale(300.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o00A', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FinalTurtleA01), GetRectCenter(gg_rct_FinalTurtleA02))
    set udg_Unit_CinematicTurtleArr[1]=GetLastCreatedUnit()
    // //
    call SetUnitBlendTimeBJ(udg_Unit_CinematicTurtleArr[1], 0.25)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o00A', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FinalTurtleB01), GetRectCenter(gg_rct_FinalTurtleB02))
    set udg_Unit_CinematicTurtleArr[2]=GetLastCreatedUnit()
    // //
    call SetUnitBlendTimeBJ(udg_Unit_CinematicTurtleArr[2], 0.25)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o00A', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FinalTurtleC01), GetRectCenter(gg_rct_FinalTurtleC03))
    set udg_Unit_CinematicTurtleArr[3]=GetLastCreatedUnit()
    // //
    call SetUnitBlendTimeBJ(udg_Unit_CinematicTurtleArr[3], 0.25)
    // //
    // footman drowning
    // //
    call CreateNUnitsAtLoc(1, 'h00E', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_FinalTurtleC04), 300.00)
    set udg_Unit_CinDrownedFootmanArr[1]=GetLastCreatedUnit()
    call SetUnitTimeScalePercent(udg_Unit_CinDrownedFootmanArr[1], 10.00)
    call SetUnitColor(udg_Unit_CinDrownedFootmanArr[1], PLAYER_COLOR_LIGHT_BLUE)
    // //
    call AddSpecialEffectTargetUnitBJ("head", udg_Unit_CinDrownedFootmanArr[1], "Doodads\\Ruins\\Water\\BubbleGeyser\\BubbleGeyser.mdl")
    set udg_SE_BubblesArr[1]=GetLastCreatedEffectBJ()
    // //
    // footman drowning
    // //
    call CreateNUnitsAtLoc(1, 'h00E', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_FinalTurtleA03), 0.00)
    set udg_Unit_CinDrownedFootmanArr[2]=GetLastCreatedUnit()
    call SetUnitScalePercent(udg_Unit_CinDrownedFootmanArr[2], 85.00, 85.00, 85.00)
    call SetUnitColor(udg_Unit_CinDrownedFootmanArr[2], PLAYER_COLOR_LIGHT_BLUE)
    call SetUnitTimeScalePercent(udg_Unit_CinDrownedFootmanArr[2], 10.00)
    call SetUnitAnimation(udg_Unit_CinDrownedFootmanArr[2], "death")
    call SetUnitFlyHeightBJ(udg_Unit_CinDrownedFootmanArr[2], 0.00, 20.00)
    // //
    call AddSpecialEffectTargetUnitBJ("head", udg_Unit_CinDrownedFootmanArr[2], "Doodads\\Ruins\\Water\\BubbleGeyser\\BubbleGeyser.mdl")
    set udg_SE_BubblesArr[2]=GetLastCreatedEffectBJ()
    // //
    // footman drowning
    // //
    call CreateNUnitsAtLoc(1, 'h00E', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DrownedFootman3), 90.00)
    set udg_Unit_CinDrownedFootmanArr[3]=GetLastCreatedUnit()
    call SetUnitScalePercent(udg_Unit_CinDrownedFootmanArr[3], 85.00, 85.00, 85.00)
    call SetUnitColor(udg_Unit_CinDrownedFootmanArr[3], PLAYER_COLOR_LIGHT_BLUE)
    call SetUnitTimeScalePercent(udg_Unit_CinDrownedFootmanArr[3], 10.00)
    call SetUnitAnimation(udg_Unit_CinDrownedFootmanArr[3], "death")
    call SetUnitFlyHeightBJ(udg_Unit_CinDrownedFootmanArr[3], 0.00, 20.00)
    // //
    call AddSpecialEffectTargetUnitBJ("head", udg_Unit_CinDrownedFootmanArr[3], "Doodads\\Ruins\\Water\\BubbleGeyser\\BubbleGeyser.mdl")
    set udg_SE_BubblesArr[3]=GetLastCreatedEffectBJ()
    // ***
    call CameraSetupApplyForPlayer(true, gg_cam_OutroUnderwater01, udg_Player_Actual, 0)
    // ***
    call SetUnitTimeScalePercent(udg_Unit_CinDrownedFootmanArr[3], 5.00)
    call SetUnitAnimation(udg_Unit_CinDrownedFootmanArr[1], "death")
    call SetUnitFlyHeightBJ(udg_Unit_CinDrownedFootmanArr[1], 0.00, 20.00)
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_TurtleRouteA)
    // //
    // UnderwaterScene
    // //
    call CinematicFilterGenericBJ(1.00, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0.00, 0.00, 50.00, 100, 0.00, 0, 50.00, 50.00)
    set udg_Bool_UnderwaterOn=true
    // ***
    call PlaySoundBJ(gg_snd_undwaterloop)
    // ***
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetCineModeVolumeGroupsBJ()
    call PlaySoundOnUnitBJ(gg_snd_Subpiss1, 50.00, udg_Unit_CinDrownedFootmanArr[2])
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_TurtleRouteB)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_TurtleRouteC)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call DestroyEffectBJ(udg_SE_BubblesArr[3])
    call TriggerSleepAction(7.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_FinalShipWreckageA), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    set udg_SE_Dust=GetLastCreatedEffectBJ()
    call BlzSetSpecialEffectTimeScale(udg_SE_Dust, 0.50)
    call BlzSetSpecialEffectTime(udg_SE_Dust, 3.00)
    call BlzSetSpecialEffectScale(udg_SE_Dust, 2.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitTimeScalePercent(udg_Unit_CinematicWreckageShip01, 0.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // cleanUp Underwater Scene
    // //
    call CinematicFilterGenericBJ(0.50, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0.00, 0.00, 50.00, 50.00, 0.00, 0, 0.00, 0)
    set udg_Bool_UnderwaterOn=false
    call TriggerSleepAction(0.50)
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    call CameraSetupApplyForPlayer(true, gg_cam_OutroParty01, udg_Player_Actual, 0)
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call StopSoundBJ(gg_snd_undwaterloop, false)
    call RemoveUnit(udg_Unit_CinematicWreckageShip01)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroDec01Pig), "Doodads\\Northrend\\Props\\FirePitPig\\FirePitPig.mdl")
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroDec02), "Doodads\\Northrend\\Props\\FirePit\\FirePit.mdl")
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroDec03), "Doodads/Terrain/LumberStash/LumberStash2.mdx")
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroDec04Pig), "Doodads\\Northrend\\Props\\FirePitPig\\FirePitPig.mdl")
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveUnit(udg_Unit_CinematicTurtleArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=3
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call RemoveUnit(udg_Unit_CinDrownedFootmanArr[GetForLoopIndexB()])
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    call RemoveWeatherEffectBJ(udg_Weather_Moonrays)
    call SetTerrainFogExBJ(0, 2500.00, 10500.00, 0.20, 41.50, 55.00, 58.80)
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    // //
    // Remove Human Units
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Final_Cinematic_Q_Func212001002)), function Trig_Final_Cinematic_Q_Func212A)
    // //
    // SetUp DialogueScene
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_TyrsKeepQuestUnitCheck, Condition(function Trig_Final_Cinematic_Q_Func217001002)), function Trig_Final_Cinematic_Q_Func217A)
    // //
    call ForGroupBJ(udg_Group_P1GroundTroopsToHide, function Trig_Final_Cinematic_Q_Func219002)
    call ShowUnitShow(udg_FakeMaim)
    call ShowUnitShow(udg_FakeRend)
    call ShowUnitShow(udg_FakeUtok)
    call SetUnitPositionLocFacingLocBJ(udg_FakeUtok, GetRectCenter(gg_rct_FinalCinUtok01), GetRectCenter(gg_rct_FinalCinRend))
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_FinalCinRend), GetRectCenter(gg_rct_FinalCinUtok01))
    call SetUnitAnimation(udg_FakeRend, "cinematic listening one")
    call SetUnitLookAt(udg_FakeRend, "bone_head", udg_FakeUtok, 0, 0, 90)
    call SetUnitPositionLocFacingLocBJ(udg_FakeMaim, GetRectCenter(gg_rct_FinalCinMaim), GetRectCenter(gg_rct_FinalCinUtok01))
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeUtok, 0, 0, 90)
    // //
    call ForGroupBJ(udg_Group_FakeGrunts, function Trig_Final_Cinematic_Q_Func231A)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[1], GetRectCenter(gg_rct_FinalCinGrunt01), GetRectCenter(gg_rct_FinalCinUtok01))
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[2], GetRectCenter(gg_rct_FinalCinGrunt02), GetRectCenter(gg_rct_FinalCinUtok01))
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[3], GetRectCenter(gg_rct_FinalCinGrunt03), GetRectCenter(gg_rct_FinalCinUtok01))
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[4], GetRectCenter(gg_rct_FinalCinGrunt04), GetRectCenter(gg_rct_FinalCinUtok01))
    call SetUnitPositionLocFacingLocBJ(udg_FakeGruntArr[5], GetRectCenter(gg_rct_FinalCinGrunt05), GetRectCenter(gg_rct_FinalCinUtok01))
    // //
    call TriggerSleepAction(1.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0.00, 0.00, 0.00, 0)
    call TriggerSleepAction(2)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // DialogueScene
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc09Utok11, bj_TIMETYPE_ADD, 0, true)
    call SetUnitAnimation(udg_FakeUtok, "cinematic salute one")
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_H01b_Orc_gesture_v2, 100, udg_FakeUtok)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ForGroupBJ(udg_Group_FakeGrunts, function Trig_Final_Cinematic_Q_Func254A)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_BuildOrcBlacksmith))
    call PlaySoundAtPointBJ(gg_snd_CS_BG_Camp, 80.00, GetRectCenter(gg_rct_FinalCinRend), 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeGruntArr[1], "move", GetRectCenter(gg_rct_FinalCinGrunt01B))
    call IssuePointOrderLocBJ(udg_FakeGruntArr[2], "move", GetRectCenter(gg_rct_FinalCinGrunt02B))
    call IssuePointOrderLocBJ(udg_FakeGruntArr[3], "move", GetRectCenter(gg_rct_FinalCinGrunt03B))
    call IssuePointOrderLocBJ(udg_FakeGruntArr[4], "move", GetRectCenter(gg_rct_FinalCinGrunt04B))
    call IssuePointOrderLocBJ(udg_FakeGruntArr[5], "move", GetRectCenter(gg_rct_FinalCinGrunt05B))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_OutroParty02, udg_Player_Actual, 0)
    call ResetUnitLookAt(udg_FakeRend)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc09Maim8, bj_TIMETYPE_ADD, 0, false)
    call SetUnitAnimation(udg_FakeMaim, "cinematic agree one")
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeRend, 0, 0, 90)
    call SetUnitFacingToFaceUnitTimed(udg_FakeMaim, udg_FakeRend, 2.00)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc09Maim8) - 2.00 ))
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // ***
    call SetUnitAnimation(udg_FakeRend, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc09Rend11, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeRend, "cinematic listening one")
    // ***
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMaim, 0, gg_snd_WC2Orc09Maim9, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic proud one")
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc09Maim9) - 6.00 ))
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ***
    call SetUnitAnimation(udg_FakeRend, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc09Rend12, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeRend, "stand victory")
    call QueueUnitAnimationBJ(udg_FakeRend, "cinematic standard one")
    call WaitForSoundBJ(gg_snd_WC2Orc09Rend12, 0)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ***
    call StopSoundBJ(gg_snd_TheHorde, true)
    // //
    // DialogueScene
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_Cleanup)
    // //
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_Q takes nothing returns nothing
    set gg_trg_Final_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Final_Cinematic_Q, function Trig_Final_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Final Cinematic SetUp
//===========================================================================
function Trig_Final_Cinematic_SetUp_Func007002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Final_Cinematic_SetUp_Func034A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Final_Cinematic_SetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    call DisableTrigger(gg_trg_Hold_AttackWave_Create)
    call DisableTrigger(gg_trg_Hold_AttackWave_Order)
    // //
    call ForGroupBJ(udg_Group_TyrsKeepAttackWave, function Trig_Final_Cinematic_SetUp_Func007002)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    call PauseUnitBJ(true, udg_Hero_Maim)
    call ShowUnitHide(udg_Hero_Maim)
    // //
    call PauseUnitBJ(true, udg_Hero_Rend)
    call ShowUnitHide(udg_Hero_Rend)
    // //
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    call ShowUnitHide(udg_SemiHero_Utok)
    // //
    // //
    call SetUnitPositionLoc(udg_FakeRend, GetRectCenter(gg_rct_BlackhandStart))
    call ShowUnitShow(udg_FakeRend)
    // //
    call SetUnitPositionLoc(udg_FakeUtok, GetRectCenter(gg_rct_UtokStartB))
    call ShowUnitShow(udg_FakeUtok)
    // //
    call SetUnitPositionLoc(udg_FakeMaim, GetRectCenter(gg_rct_UtokStart))
    call ShowUnitShow(udg_FakeMaim)
    // //
    // Hide Flying Machines
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfTypeIdAll('h60M'), function Trig_Final_Cinematic_SetUp_Func034A)
    // //
    // Footmans on Ice
    call CreateNUnitsAtLoc(1, 'h00E', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DrwonedFoormanIce01), 0.00)
    set udg_Unit_CinFootmanOnIceArr[1]=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_CinFootmanOnIceArr[1], PLAYER_COLOR_LIGHT_BLUE)
    call BlzSetUnitRealFieldBJ(udg_Unit_CinFootmanOnIceArr[1], UNIT_RF_FLY_HEIGHT, 0.00)
    call SetUnitBlendTimeBJ(udg_Unit_CinFootmanOnIceArr[1], 0.25)
    // *
    call CreateNUnitsAtLoc(1, 'h00E', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DrwonedFoormanIce02), 335.00)
    set udg_Unit_CinFootmanOnIceArr[2]=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_CinFootmanOnIceArr[2], PLAYER_COLOR_LIGHT_BLUE)
    call BlzSetUnitRealFieldBJ(udg_Unit_CinFootmanOnIceArr[2], UNIT_RF_FLY_HEIGHT, 0.00)
    call SetUnitBlendTimeBJ(udg_Unit_CinFootmanOnIceArr[2], 0.25)
    // *
    call CreateNUnitsAtLoc(1, 'h00E', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DrwonedFoormanIce04), 325.00)
    set udg_Unit_CinFootmanOnIceArr[3]=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_CinFootmanOnIceArr[3], PLAYER_COLOR_LIGHT_BLUE)
    call BlzSetUnitRealFieldBJ(udg_Unit_CinFootmanOnIceArr[3], UNIT_RF_FLY_HEIGHT, 0.00)
    call SetUnitBlendTimeBJ(udg_Unit_CinFootmanOnIceArr[3], 0.25)
    // *
    call CreateNUnitsAtLoc(1, 'h00E', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DrwonedFoormanIce03), 315.00)
    set udg_Unit_CinFootmanOnIceArr[4]=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_CinFootmanOnIceArr[4], PLAYER_COLOR_LIGHT_BLUE)
    call BlzSetUnitRealFieldBJ(udg_Unit_CinFootmanOnIceArr[4], UNIT_RF_FLY_HEIGHT, 0.00)
    call SetUnitBlendTimeBJ(udg_Unit_CinFootmanOnIceArr[4], 0.25)
    // *
    call CreateNUnitsAtLoc(1, 'h00E', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DrwonedFoormanIce04), 305.00)
    set udg_Unit_CinFootmanOnIceArr[5]=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_CinFootmanOnIceArr[5], PLAYER_COLOR_LIGHT_BLUE)
    call BlzSetUnitRealFieldBJ(udg_Unit_CinFootmanOnIceArr[5], UNIT_RF_FLY_HEIGHT, 0.00)
    call SetUnitBlendTimeBJ(udg_Unit_CinFootmanOnIceArr[5], 0.25)
    // *
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitBlendTimeBJ(udg_Unit_CinFootmanOnIceArr[GetForLoopIndexA()], 0.25)
        call SetUnitAnimation(udg_Unit_CinFootmanOnIceArr[GetForLoopIndexA()], "stand ready")
        call GroupAddUnitSimple(udg_Unit_CinFootmanOnIceArr[GetForLoopIndexA()], udg_Group_CinFootmansIce)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // Ship
    call CreateNUnitsAtLoc(1, 'e60C', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_FinalCinWreckedShip), 337.29)
    set udg_Unit_CinematicWreckageShip02=GetLastCreatedUnit()
    call SetUnitScalePercent(udg_Unit_CinematicWreckageShip02, 230.00, 230.00, 230.00)
    call SetUnitTimeScalePercent(udg_Unit_CinematicWreckageShip02, 0.00)
    call SetUnitVertexColorBJ(udg_Unit_CinematicWreckageShip02, 80.00, 80.00, 100, 0)
    call GroupAddUnitSimple(udg_Unit_CinematicWreckageShip02, udg_Group_FrozenUnits)
    // //
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_SetUp takes nothing returns nothing
    set gg_trg_Final_Cinematic_SetUp=CreateTrigger()
    call TriggerAddAction(gg_trg_Final_Cinematic_SetUp, function Trig_Final_Cinematic_SetUp_Actions)
endfunction

//===========================================================================
// Trigger: Final Cinematic Skipped
//===========================================================================
function Trig_Final_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_OutroCinOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_OutroCinSkipped=true
    call ConditionalTriggerExecute(gg_trg_Final_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Final_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Final_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Final_Cinematic_Skipped, Condition(function Trig_Final_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Final_Cinematic_Skipped, function Trig_Final_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Final Cinematic Cleanup
//===========================================================================
function Trig_Final_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_UnderwaterOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_Cleanup_Func016C takes nothing returns boolean
    if ( not ( udg_Bool_OutroCinSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Final_Cinematic_Cleanup_Func002C() ) then
        call CinematicFilterGenericBJ(0.50, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0.00, 0.00, 50.00, 50.00, 0.00, 0, 0.00, 0)
        call TriggerSleepAction(0.50)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    endif
    set udg_Bool_OutroCinOn=false
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call PauseUnitBJ(false, udg_Hero_Maim)
    call ShowUnitShow(udg_Hero_Maim)
    // //
    call PauseUnitBJ(false, udg_Hero_Rend)
    call ShowUnitShow(udg_Hero_Rend)
    // //
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    call ShowUnitShow(udg_SemiHero_Utok)
    // //
    if ( Trig_Final_Cinematic_Cleanup_Func016C() ) then
        // SoundsOff
        call StopSoundBJ(gg_snd_TheHorde, false)
        call StopSoundBJ(gg_snd_WC2Orc09Maim8, false)
        call StopSoundBJ(gg_snd_WC2Orc09Maim9, false)
        call StopSoundBJ(gg_snd_WC2Orc09Rend11, false)
        call StopSoundBJ(gg_snd_WC2Orc09Rend12, false)
        call StopSoundBJ(gg_snd_WC2Orc09Utok11, false)
        // //
    else
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_NextLevelPrep)
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Final_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Final_Cinematic_Cleanup, function Trig_Final_Cinematic_Cleanup_Actions)
endfunction

