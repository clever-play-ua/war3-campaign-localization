//===========================================================================
// Trigger: SnowInFogLoop
//===========================================================================
function Trig_SnowInFogLoop_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_OutroCinOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SnowInFogLoop_Func003001 takes nothing returns boolean
    return ( udg_Real_FogMax <= 7000.00 )
endfunction

function Trig_SnowInFogLoop_Actions takes nothing returns nothing
    if ( (udg_Real_FogMax <= 7000.00) ) then // INLINED!!
        call PauseTimerBJ(true, udg_Timer_SnowIn)
    else
        call DoNothing()
    endif
    set udg_Real_FogMax=( udg_Real_FogMax - 100.00 )
    set udg_Real_FogMin=( udg_Real_FogMin - 100.00 )
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, 41.50, 55.00, 58.80)
endfunction

//===========================================================================
function InitTrig_SnowInFogLoop takes nothing returns nothing
    set gg_trg_SnowInFogLoop=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_SnowInFogLoop, udg_Timer_SnowIn)
