    set gg_trg_Navy_Discover_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Navy_Discover_Q, function Trig_Navy_Discover_Q_Actions)
endfunction

//===========================================================================
// Trigger: Navy Update Shipyards
//===========================================================================
function Trig_Navy_Update_Shipyards_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQNavy) == false ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'h60X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Update_Shipyards_Func002Func004001001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60X' )
endfunction

function Trig_Navy_Update_Shipyards_Func002Func004001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Navy_Update_Shipyards_Func002Func004001001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h60X'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Navy_Update_Shipyards_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Navy_Update_Shipyards_Func002Func004001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Update_Shipyards_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Navy_Update_Shipyards_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Bool_ShipyardsDestroyed=true
        call ConditionalTriggerExecute(gg_trg_Navy_Update_Completed)
    else
    endif
endfunction

