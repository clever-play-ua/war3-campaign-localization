    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_Razing_Update_KillMage_Func021001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == false )
endfunction

function Trig_Razing_Update_KillMage_Func021002 takes nothing returns nothing
    call ExplodeUnitBJ(GetEnumUnit())
endfunction

function Trig_Razing_Update_KillMage_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Bool_MageKilled=true
    // //
    call DestroyMinimapIcon(udg_MinimapIcon_Mage)
    // //
    if ( Trig_Razing_Update_KillMage_Func009C() ) then
        call QueuedTriggerAddBJ(gg_trg_Razing_Update_KillMage_Q, true)
    else
        if ( Trig_Razing_Update_KillMage_Func009Func001C() ) then
            call QueuedTriggerAddBJ(gg_trg_Razing_Completed_Q, true)
            call QueuedTriggerAddBJ(gg_trg_TyrsKeep_Cinematic_Q, true)
        else
        endif
    endif
    // //
    call EnumDestructablesInRectAll(gg_rct_TyrsQuest, function Trig_Razing_Update_KillMage_Func011002)
    call EnumDestructablesInRectAll(gg_rct_TyrsQuest, function Trig_Razing_Update_KillMage_Func012002)
    // //
    call SetDoodadAnimationRectBJ("death", 'D6CF', gg_rct_TyrsQuest)
    // //
    call RemoveDestructable(gg_dest_B62N_1090)
    call RemoveDestructable(gg_dest_B61W_1091)
    // //
    call PolledWait(1.00)
    // //
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_TowerFallsAndKills, Condition(function Trig_Razing_Update_KillMage_Func021001002)), function Trig_Razing_Update_KillMage_Func021002)
    call DestructableRestoreLife(gg_dest_BD07_6127, GetDestructableMaxLife(gg_dest_BD07_6127), false)
    // //
endfunction

