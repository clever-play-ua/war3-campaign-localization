endfunction

//===========================================================================
// Trigger: Razing AI Regular Attacker Disable
//===========================================================================
function Trig_Razing_AI_Regular_Attacker_Disable_Actions takes nothing returns nothing
    call SetPlayerUnitAvailableBJ('hfSM', false, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('hfSM', false, udg_Player16_Stromgarde_Navy)
    call SetPlayerUnitAvailableBJ('hfSM', false, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('hKsM', false, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('hKsM', false, udg_Player16_Stromgarde_Navy)
    call SetPlayerUnitAvailableBJ('hKsM', false, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('hSjM', false, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('hSjM', false, udg_Player16_Stromgarde_Navy)
    call SetPlayerUnitAvailableBJ('hSjM', false, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('hBaM', false, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('hBaM', false, udg_Player16_Stromgarde_Navy)
    call SetPlayerUnitAvailableBJ('hBaM', false, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('hBAM', false, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('hBAM', false, udg_Player16_Stromgarde_Navy)
    call SetPlayerUnitAvailableBJ('hBAM', false, udg_Player18_Stromgarde_Ground)
endfunction

