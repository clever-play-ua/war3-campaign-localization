endfunction

function Trig_Razing_Update_DestroyCitadel_Actions takes nothing returns nothing
    set udg_Group_TyrRazingTemp=GetUnitsInRectMatching(gg_rct_TyrsKeepQuestUnitCheck, Condition(function Trig_Razing_Update_DestroyCitadel_Func003002002))
    if ( Trig_Razing_Update_DestroyCitadel_Func004C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Bool_StromgardeDestroyedRazing=true
        call PauseTimerBJ(true, udg_Timer_RazingDebug)
        if ( Trig_Razing_Update_DestroyCitadel_Func004Func004C() ) then
            call QueuedTriggerAddBJ(gg_trg_Razing_Update_DestroyCitadel_Q, true)
        else
            call QueuedTriggerAddBJ(gg_trg_Razing_Update_DestroyCitadel_Q2, true)
            if ( Trig_Razing_Update_DestroyCitadel_Func004Func004Func002C() ) then
                call QueuedTriggerAddBJ(gg_trg_Razing_Completed_Q, true)
                call QueuedTriggerAddBJ(gg_trg_TyrsKeep_Cinematic_Q, true)
            else
            endif
        endif
    else
    endif
    call DestroyGroup(udg_Group_TyrRazingTemp)
endfunction

