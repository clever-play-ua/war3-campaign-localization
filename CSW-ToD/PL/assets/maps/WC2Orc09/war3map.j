    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_BerserkerCinematic, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeRend, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeRend, 0, gg_snd_WC2Orc09Rend4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeRend, "cinematic listening one")
    // ***
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Bloodvine01, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Bloodwine02, udg_Player_Actual, 7.00, 0, 1.00, 100.00)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_BerserkerCinematic, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_BerserkerCinematic, 0, gg_snd_WC2Orc09Berserker2, bj_TIMETYPE_ADD, 0, false)
    // //
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ***
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
