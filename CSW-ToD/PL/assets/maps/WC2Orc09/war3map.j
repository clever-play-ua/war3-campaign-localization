function Trig_Intro_Cinematic_RendRoute_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_IntroCinOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_RendRoute_Func009001 takes nothing returns boolean
    return ( udg_Bool_IntroCinSkipped == true )
endfunction

function Trig_Intro_Cinematic_RendRoute_Func014001 takes nothing returns boolean
    return ( udg_Bool_IntroCinSkipped == true )
endfunction

function Trig_Intro_Cinematic_RendRoute_Func019001 takes nothing returns boolean
    return ( udg_Bool_IntroCinSkipped == true )
