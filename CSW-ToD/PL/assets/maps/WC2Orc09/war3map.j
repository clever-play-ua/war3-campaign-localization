//===========================================================================
// Trigger: Init 06b Normal
//===========================================================================
function Trig_Init_06b_Normal_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_06b_Normal_Actions takes nothing returns nothing
    // ////
    set udg_Real_CaravanPreparation=220.00
    set udg_Real_CaravanSpeed=180.00
    set udg_Int_CaravansAllowedToFlee=4
    // ////
    set udg_Real_TyrsHandAttackGap=80.00
    set udg_Int_TyrsHandAttackSize=1
    // ////
    // ////
    call SetPlayerTechResearchedSwap('R013', 1, udg_Player_Silverhand)
    call SetPlayerTechResearchedSwap('R014', 1, udg_Player_MaroonCinematic)
    call SetPlayerTechResearchedSwap('R00J', 1, udg_Player_Silverhand)
    call SetPlayerTechResearchedSwap('R01A', 1, udg_Player_Silverhand)
    call SetPlayerTechResearchedSwap('R00E', 1, udg_Player_Silverhand)
    call SetPlayerTechResearchedSwap('R017', 1, udg_Player_Silverhand)
    call SetPlayerTechResearchedSwap('R00C', 1, udg_Player_Silverhand)
    call SetPlayerTechResearchedSwap('R604', 1, udg_Player_Silverhand)
    call SetPlayerTechResearchedSwap('R00B', 1, udg_Player_Silverhand)
    // Naval
    // ////
    call SetPlayerHandicapBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), 150.00)
    call SetPlayerHandicapDamageBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), 125.00)
endfunction

