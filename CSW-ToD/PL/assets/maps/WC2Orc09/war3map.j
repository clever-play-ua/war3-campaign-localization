//===========================================================================
// Trigger: Maim I Bloodthirst
//===========================================================================
function Trig_Maim_I_Bloodthirst_Conditions takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A00K', GetKillingUnitBJ()) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Maim_I_Bloodthirst_Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A00K', GetKillingUnitBJ()) == 3 ) ) then
        return false
    endif
    return true
endfunction

