//===========================================================================
// Trigger: Hold Gate Up
//===========================================================================
function Trig_Hold_Gate_Up_Actions takes nothing returns nothing
    set udg_Bool_IslandGateIsDown=false
    set udg_Point_GateHold=GetRectCenter(gg_rct_BridgePatch04)
    // //
    call PlaySoundAtPointBJ(gg_snd_LargeCityGateOpen1, 50.00, udg_Point_GateHold, 100.00)
    // //
    call RemoveLocation(udg_Point_GateHold)
    // //
    call DestructableRestoreLife(gg_dest_DTlv_2227, 500.00, true)
    call SetDestructableInvulnerableBJ(gg_dest_DTlv_2227, true)
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=8
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set udg_Point_GateHold=GetRectCenter(udg_CastleBridgePlatform[GetForLoopIndexB()])
        call CreateDestructableLoc('YTpc', udg_Point_GateHold, bj_UNIT_FACING, 1, 0)
        call RemoveLocation(udg_Point_GateHold)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    call SetDestructableAnimationBJ(gg_dest_B000_4154, "morph alternate")
    set udg_Point_GateHold=GetRectCenter(gg_rct_BridgePatch03)
    // //
    call PlaySoundAtPointBJ(gg_snd_GateOpen, 50.00, udg_Point_GateHold, 100.00)
    call RemoveLocation(udg_Point_GateHold)
    // //
    call TriggerSleepAction(2.67)
    // //
    call SetDestructableAnimationBJ(gg_dest_B000_4154, "stand")
    // //
    call PolledWait(1.00)
    // //
    call ModifyGateBJ(bj_GATEOPERATION_CLOSE, gg_dest_YTcx_1011)
    call DestructableRestoreLife(gg_dest_DTlv_4160, 500.00, true)
    call SetDestructableInvulnerableBJ(gg_dest_DTlv_4160, true)
endfunction

//===========================================================================
function InitTrig_Hold_Gate_Up takes nothing returns nothing
    set gg_trg_Hold_Gate_Up=CreateTrigger()
    call TriggerAddAction(gg_trg_Hold_Gate_Up, function Trig_Hold_Gate_Up_Actions)
endfunction

//===========================================================================
// Trigger: Hold Gate Down
//===========================================================================
function Trig_Hold_Gate_Down_Func006C takes nothing returns boolean
    if ( not ( udg_Bool_TyrsHandCinSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hold_Gate_Down_Func012C takes nothing returns boolean
    if ( not ( udg_Bool_TyrsHandCinSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hold_Gate_Down_Func022Func001Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hold_Gate_Down_Func022Func001A takes nothing returns nothing
    if ( Trig_Hold_Gate_Down_Func022Func001Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Hold_Gate_Down_Actions takes nothing returns nothing
    set udg_Bool_IslandGateIsDown=true
    // //
    call SetDestructableInvulnerableBJ(gg_dest_DTlv_2227, false)
    call SetDestructableLifePercentBJ(gg_dest_DTlv_2227, 1.00)
    // //
    if ( Trig_Hold_Gate_Down_Func006C() ) then
        call KillDestructable(gg_dest_DTlv_2227)
    else
    endif
    // //
    // Down the Bridge
    // //
    call SetDestructableInvulnerableBJ(gg_dest_DTlv_4160, false)
    call KillDestructable(gg_dest_DTlv_4160)
    if ( Trig_Hold_Gate_Down_Func012C() ) then
        call PolledWait(1.00)
    else
    endif
    // //
    call SetDestructableAnimationBJ(gg_dest_B000_4154, "morph")
    // //
    set udg_Point_GateHold=GetRectCenter(gg_rct_BridgePatch03)
    call PlaySoundAtPointBJ(gg_snd_GateOpen, 50.00, udg_Point_GateHold, 100.00)
    call RemoveLocation(udg_Point_GateHold)
    // //
    call TriggerSleepAction(3.33)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call EnumDestructablesInRectAll(udg_CastleBridgePlatform[GetForLoopIndexA()], function Trig_Hold_Gate_Down_Func022Func001A)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call SetDestructableAnimationBJ(gg_dest_B000_4154, "stand alternate")
    // //
    call PolledWait(1.00)
    // //
    // OpenGates
    // //
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_YTcx_1011)
    set udg_Point_GateHold=GetRectCenter(gg_rct_BridgePatch04)
    call PlaySoundAtPointBJ(gg_snd_LargeCityGateOpen1, 50.00, udg_Point_GateHold, 100.00)
    call RemoveLocation(udg_Point_GateHold)
    // //
    call PolledWait(1.00)
    // //
    set udg_Bool_TyrsGateDown=true
    // //
endfunction

//===========================================================================
function InitTrig_Hold_Gate_Down takes nothing returns nothing
    set gg_trg_Hold_Gate_Down=CreateTrigger()
    call TriggerAddAction(gg_trg_Hold_Gate_Down, function Trig_Hold_Gate_Down_Actions)
endfunction

//===========================================================================
// Trigger: Hold AttackWave Create
//===========================================================================
function Trig_Hold_AttackWave_Create_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQHold) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hold_AttackWave_Create_Actions takes nothing returns nothing
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_Int_TyrsHandAttackSize
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'h623', udg_Player_Silverhand, udg_Point_HoldCreateAttackWave, bj_UNIT_FACING)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TyrsKeepAttackWave)
        set udg_Point_HoldGatherAttackWave=GetRandomLocInRect(gg_rct_RedirectionPoint)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_HoldGatherAttackWave)
        call RemoveLocation(udg_Point_HoldGatherAttackWave)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call PolledWait(0.50)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_Int_TyrsHandAttackSize
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'h60B', udg_Player_Silverhand, udg_Point_HoldCreateAttackWave, bj_UNIT_FACING)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TyrsKeepAttackWave)
        set udg_Point_HoldGatherAttackWave=GetRandomLocInRect(gg_rct_RedirectionPoint)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_HoldGatherAttackWave)
        call RemoveLocation(udg_Point_HoldGatherAttackWave)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call PolledWait(0.50)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_Int_TyrsHandAttackSize
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'h006', udg_Player_Silverhand, udg_Point_HoldCreateAttackWave, bj_UNIT_FACING)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TyrsKeepAttackWave)
        set udg_Point_HoldGatherAttackWave=GetRandomLocInRect(gg_rct_RedirectionPoint)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_HoldGatherAttackWave)
        call RemoveLocation(udg_Point_HoldGatherAttackWave)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call PolledWait(0.50)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_Int_TyrsHandAttackSize
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'h009', udg_Player_Silverhand, udg_Point_HoldCreateAttackWave, bj_UNIT_FACING)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TyrsKeepAttackWave)
        set udg_Point_HoldGatherAttackWave=GetRandomLocInRect(gg_rct_RedirectionPoint)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_HoldGatherAttackWave)
        call RemoveLocation(udg_Point_HoldGatherAttackWave)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call PolledWait(0.50)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_Int_TyrsHandAttackSize
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'e002', udg_Player_Silverhand, udg_Point_HoldCreateAttackWave, bj_UNIT_FACING)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TyrsKeepAttackWave)
        set udg_Point_HoldGatherAttackWave=GetRandomLocInRect(gg_rct_RedirectionPoint)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_HoldGatherAttackWave)
        call RemoveLocation(udg_Point_HoldGatherAttackWave)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call PolledWait(10.00)
    // //
    call ConditionalTriggerExecute(gg_trg_Hold_AttackWave_Order)
    // //
    // //
    // //
endfunction

