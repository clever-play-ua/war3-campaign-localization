//===========================================================================
// Trigger: Navy Completed Q
//===========================================================================
function Trig_Navy_Completed_Q_Actions takes nothing returns nothing
    // //
    call PauseTimerBJ(true, udg_Timer_CaravanPause)
    call DestroyTimerDialogBJ(udg_TimerWindow_Caravan)
    // //
    call DestroyLeaderboardBJ(udg_Leaderboard_CaravanMessage)
    call DestroyLeaderboardBJ(udg_Leaderboard_Navy)
    // //
    call DestroyMinimapIcon(udg_MinimapIcon_Caravan)
    call QuestSetCompletedBJ(udg_MQNavy, true)
    // //
    call QuestItemSetCompletedBJ(udg_QReq_DestroyShipyards, true)
    call QuestItemSetCompletedBJ(udg_QReq_DestroyFoundries, true)
    call QuestItemSetCompletedBJ(udg_QReq_DestroyRefineries, true)
    call QuestItemSetCompletedBJ(udg_QReq_DestroyCaravans, true)
    call QuestItemSetCompletedBJ(udg_QReq_CaravanLeave, true)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3177")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

