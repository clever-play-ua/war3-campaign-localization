    set gg_trg_Intro_Cinematic_DoorGuard=CreateTrigger()
    call DisableTrigger(gg_trg_Intro_Cinematic_DoorGuard)
    call TriggerAddAction(gg_trg_Intro_Cinematic_DoorGuard, function Trig_Intro_Cinematic_DoorGuard_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic CaptainMove
//===========================================================================
function Trig_Intro_Cinematic_CaptainMove_Func002001 takes nothing returns boolean
    return ( udg_Bool_IntroCinSkipped == true )
endfunction

function Trig_Intro_Cinematic_CaptainMove_Func006001 takes nothing returns boolean
    return ( udg_Bool_IntroCinSkipped == true )
endfunction

function Trig_Intro_Cinematic_CaptainMove_Actions takes nothing returns nothing
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Fake_Saidan, "move", GetRectCenter(gg_rct_IntroCaptainMove))
    call SetUnitLookAt(udg_Fake_Saidan, "bone_head", udg_Unit_CinematicCaptain, 0, 0, 90)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
