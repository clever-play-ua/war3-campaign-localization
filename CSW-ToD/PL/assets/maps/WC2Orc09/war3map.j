    if ( not ( GetResearched() == 'R00F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BerserkerTransform_Func006Func004001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o60O' )
endfunction

function Trig_BerserkerTransform_Func006Func004001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_BerserkerTransform_Func006Func004001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o60O'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_BerserkerTransform_Func006Func004A takes nothing returns nothing
    set udg_Point_BerserkerTransform=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_Point_BerserkerTransform, "CSW\\Abilities\\Spells\\Orc\\ZuljinSpells\\TazdingoTarget.mdx")
    call RemoveLocation(udg_Point_BerserkerTransform)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
endfunction

function Trig_BerserkerTransform_Func006Func011001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'oTA1' )
endfunction

function Trig_BerserkerTransform_Func006Func011001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_BerserkerTransform_Func006Func011001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'oTA1'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_BerserkerTransform_Func006Func011A takes nothing returns nothing
    set udg_Point_BerserkerTransform=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_Point_BerserkerTransform, "CSW\\Abilities\\Spells\\Orc\\ZuljinSpells\\TazdingoTarget.mdx")
    call RemoveLocation(udg_Point_BerserkerTransform)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
endfunction

function Trig_BerserkerTransform_Func006C takes nothing returns boolean
    if ( not ( udg_Bool_SeaIsForzen == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BerserkerTransform_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerTechResearchedSwap('R00F', 1, Player(20))
    call SetPlayerTechResearchedSwap('R00F', 1, Player(5))
    if ( Trig_BerserkerTransform_Func006C() ) then
        call SetPlayerUnitAvailableBJ('o007', true, udg_Player_Actual)
        call SetPlayerUnitAvailableBJ('o60T', false, udg_Player_Actual)
        call SetPlayerUnitAvailableBJ('oTA1', false, udg_Player_Actual)
        call SetPlayerUnitAvailableBJ('o60O', false, udg_Player_Actual)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_BerserkerTransform_Func006Func011001002)), function Trig_BerserkerTransform_Func006Func011A)
    else
        call SetPlayerUnitAvailableBJ('o60T', true, udg_Player_Actual)
        call SetPlayerUnitAvailableBJ('o60O', false, udg_Player_Actual)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_BerserkerTransform_Func006Func004001002)), function Trig_BerserkerTransform_Func006Func004A)
    endif
endfunction

