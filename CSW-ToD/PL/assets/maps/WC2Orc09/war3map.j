//===========================================================================
// Trigger: Navy Caravan2 Wave
//===========================================================================
function Trig_Navy_Caravan2_Wave_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQNavy) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Caravan2_Wave_Func007Func038002 takes nothing returns nothing
    call SetUnitMoveSpeed(GetEnumUnit(), udg_Real_CaravanSpeed)
endfunction

function Trig_Navy_Caravan2_Wave_Func007C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_h60X_0380) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(gg_unit_h60X_0379) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(gg_unit_h60X_0378) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Caravan2_Wave_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_WARNING, "TRIGSTR_3604")
    // //
    call TimerDialogDisplayForPlayerBJ(false, udg_TimerWindow_Caravan, udg_Player_Actual)
    // //
    if ( Trig_Navy_Caravan2_Wave_Func007C() ) then
        call DoNothing()
    else
        call PlaySoundBJ(gg_snd_Warning)
        set udg_Bool_CaravanIsBeingSent=true
        // //
        call LeaderboardSetLabelBJ(udg_Leaderboard_Navy, "TRIGSTR_3529")
        call LeaderboardDisplayBJ(true, udg_Leaderboard_CaravanMessage)
        // //
        call ConditionalTriggerExecute(gg_trg_Navy_Caravan2_FarmA)
        call ConditionalTriggerExecute(gg_trg_Navy_Caravan5_FarmB)
        // //
        call CreateNUnitsAtLoc(1, 'e60C', udg_Player_Caravan, udg_Point_CaravanEscort[2], bj_UNIT_FACING)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_Caravan)
        call SetUnitMoveSpeed(GetLastCreatedUnit(), udg_Real_CaravanSpeed)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_CaravanExit)
        call UnitShareVisionBJ(true, GetLastCreatedUnit(), udg_Player_Actual)
        call PolledWait(2)
        // //
        call ConditionalTriggerExecute(gg_trg_Navy_Caravan2_Transport)
        call TriggerSleepAction(0.10)
        // //
        call GroupAddUnitSimple(udg_Unit_CaravanTransportArr[2], udg_Group_Caravan)
        call RemoveGuardPosition(udg_Unit_CaravanTransportArr[2])
        call SetUnitMoveSpeed(udg_Unit_CaravanTransportArr[2], udg_Real_CaravanSpeed)
        call IssuePointOrderLocBJ(udg_Unit_CaravanTransportArr[2], "move", GetRectCenter(gg_rct_CaravanOut))
        call UnitShareVisionBJ(true, udg_Unit_CaravanTransportArr[2], udg_Player_Actual)
        // //
        call CampaignMinimapIconUnitBJ(udg_Unit_CaravanTransportArr[2], bj_CAMPPINGSTYLE_BONUS)
        set udg_MinimapIcon_Caravan=GetLastCreatedMinimapIcon()
        call PolledWait(2)
        // //
        call CreateNUnitsAtLoc(1, 'hBsS', udg_Player_Caravan, udg_Point_CaravanEscort[2], bj_UNIT_FACING)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call SetUnitMoveSpeed(GetLastCreatedUnit(), udg_Real_CaravanSpeed)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_Caravan)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_CaravanExit)
        call UnitShareVisionBJ(true, GetLastCreatedUnit(), udg_Player_Actual)
        // //
        call ForGroupBJ(udg_Group_Caravan, function Trig_Navy_Caravan2_Wave_Func007Func038002)
        call SetUnitMoveSpeed(udg_Unit_CaravanTransportArr[2], udg_Real_CaravanSpeed)
        // //
        call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetUnitLoc(udg_Unit_CaravanTransportArr[2]), 2.00)
        call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetUnitLoc(udg_Unit_CaravanTransportArr[2]))
        // //
        call EnableTrigger(gg_trg_Navy_Caravan3_Wave)
        call EnableTrigger(gg_trg_Navy_Caravan2_Transport)
        // //
    endif
    // //
endfunction

