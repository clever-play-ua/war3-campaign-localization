function Trig_Berserker_Update2_GoblinAlchemist_Func002C takes nothing returns boolean
    if ( ( UnitItemInSlotBJ(GetEnteringUnit(), 1) == udg_Item_Bloodvine ) ) then
        return true
    endif
    if ( ( UnitItemInSlotBJ(GetEnteringUnit(), 2) == udg_Item_Bloodvine ) ) then
        return true
    endif
    if ( ( UnitItemInSlotBJ(GetEnteringUnit(), 3) == udg_Item_Bloodvine ) ) then
        return true
    endif
    if ( ( UnitItemInSlotBJ(GetEnteringUnit(), 4) == udg_Item_Bloodvine ) ) then
        return true
    endif
    if ( ( UnitItemInSlotBJ(GetEnteringUnit(), 5) == udg_Item_Bloodvine ) ) then
        return true
    endif
    if ( ( UnitItemInSlotBJ(GetEnteringUnit(), 6) == udg_Item_Bloodvine ) ) then
        return true
    endif
    return false
endfunction

