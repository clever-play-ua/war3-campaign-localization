endfunction

function Trig_Ambush_Cinematic_Cleanup_Actions takes nothing returns nothing
    // //
    set udg_Bool_AmbushCinOn=false
    // //
    // Fade Faster If Cinematic Skipped
    // //
    if ( Trig_Ambush_Cinematic_Cleanup_Func006C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    call KillDestructable(gg_dest_YTpc_3357)
    call KillDestructable(gg_dest_YTpc_3511)
    call KillDestructable(gg_dest_YTpc_3361)
    // //
    call GroupAddUnitSimple(udg_Unit_CinTroll[1], udg_Group_ZulJeenBerserkers)
    call GroupAddUnitSimple(udg_Unit_CinTroll[2], udg_Group_ZulJeenBerserkers)
    call GroupAddUnitSimple(udg_Unit_CinTroll[3], udg_Group_ZulJeenBerserkers)
    call GroupAddUnitSimple(udg_Unit_CinTroll[3], udg_Group_ZulJeenBerserkers)
    call GroupAddUnitSimple(udg_Unit_CinTroll[4], udg_Group_ZulJeenBerserkers)
    // //
    if ( Trig_Ambush_Cinematic_Cleanup_Func018C() ) then
        call GroupAddUnitSimple(udg_Unit_CinTroll[5], udg_Group_ZulJeenBerserkers)
    else
        call RemoveUnit(udg_Unit_CinTroll[5])
    endif
    // //
    if ( Trig_Ambush_Cinematic_Cleanup_Func020C() ) then
        call GroupAddUnitSimple(udg_Unit_CinTroll[6], udg_Group_ZulJeenBerserkers)
    else
        call RemoveUnit(udg_Unit_CinTroll[6])
    endif
    // //
    if ( Trig_Ambush_Cinematic_Cleanup_Func022C() ) then
        call GroupAddUnitSimple(udg_Unit_CinTroll[7], udg_Group_ZulJeenBerserkers)
    else
        call RemoveUnit(udg_Unit_CinTroll[7])
    endif
    // //
    call GroupAddUnitSimple(udg_Unit_BerserkerCinematic, udg_Group_ZulJeenBerserkers)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Trolls, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    // //
    call ForGroupBJ(udg_Group_ZulJeenBerserkers, function Trig_Ambush_Cinematic_Cleanup_Func031002)
    call ForGroupBJ(udg_Group_P1GroundTroopsToHide, function Trig_Ambush_Cinematic_Cleanup_Func032002)
    call ForGroupBJ(udg_Group_P1GroundTroopsToHide, function Trig_Ambush_Cinematic_Cleanup_Func033002)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_RendAmbush), GetRectCenter(gg_rct_BerserkerCinematic))
    call SetUnitPositionLocFacingLocBJ(udg_Unit_BerserkerCinematic, GetRectCenter(gg_rct_BerserkerCinematic), GetRectCenter(gg_rct_RendAmbush))
    call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_Mid01FakeUtokWounded), GetRectCenter(gg_rct_RendAmbush))
    // //
    if ( Trig_Ambush_Cinematic_Cleanup_Func039C() ) then
        // SoundsOff
        call StopSoundBJ(gg_snd_ZulamanTheme01, false)
        call StopSoundBJ(gg_snd_Tension01, false)
        call StopSoundBJ(gg_snd_WC2Orc09Rend3, false)
        call StopSoundBJ(gg_snd_WC2Orc09Utok3, false)
        call StopSoundBJ(gg_snd_WC2Orc09ElvenRanger1, false)
        call StopSoundBJ(gg_snd_WC2Orc09TrollTaunt01, false)
        call StopSoundBJ(gg_snd_WC2Orc09TrollTaunt02, false)
        call StopSoundBJ(gg_snd_WC2Orc09Berserker1, false)
        call StopSoundBJ(gg_snd_WC2Orc09Berserker2, false)
        call StopSoundBJ(gg_snd_WC2Orc09Rend4, false)
        call StopSoundBJ(gg_snd_WC2Orc09Rend5, false)
        // //
        call ShowUnitShow(udg_Unit_CinTroll[1])
        call ShowUnitShow(udg_Unit_CinTroll[2])
        call ShowUnitShow(udg_Unit_CinTroll[3])
        call ShowUnitShow(udg_Unit_CinTroll[4])
        call ShowUnitShow(udg_Unit_CinTroll[5])
        call ShowUnitShow(udg_Unit_CinTroll[6])
        call ShowUnitShow(udg_Unit_CinTroll[7])
        call ShowUnitShow(udg_Unit_BerserkerCinematic)
        call ForGroupBJ(udg_Group_Ambush, function Trig_Ambush_Cinematic_Cleanup_Func039Func022002)
        call ForGroupBJ(udg_Group_Ambush, function Trig_Ambush_Cinematic_Cleanup_Func039Func023002)
        call PauseUnitBJ(false, udg_Unit_BerserkerCinematic)
        call SetDoodadAnimationRectBJ("stand", 'D003', gg_rct_ElvenAmbush)
        call SetDoodadAnimationRectBJ("stand", 'D6D8', gg_rct_ElvenAmbush)
        call SetDoodadAnimationRectBJ("stand", 'D6D9', gg_rct_ElvenAmbush)
        call SetDoodadAnimationRectBJ("stand", 'D6DA', gg_rct_ElvenAmbush)
        call SetDoodadAnimationRectBJ("stand", 'D6DB', gg_rct_ElvenAmbush)
        call SetDoodadAnimationRectBJ("stand", 'D6DC', gg_rct_ElvenAmbush)
        call SetDoodadAnimationRectBJ("stand", 'D6DD', gg_rct_ElvenAmbush)
    else
    endif
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_AmbushCinematic_Ended), 0)
    call TriggerSleepAction(0.01)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_Ambush_Cinematic_Cleanup_Func046001002)), function Trig_Ambush_Cinematic_Cleanup_Func046A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CinAmbushTrollsStaging, udg_Player_Trolls), function Trig_Ambush_Cinematic_Cleanup_Func049A)
    // //
    call SetUnitLifePercentBJ(udg_SemiHero_Utok, 50.00)
    call SetUnitLifePercentBJ(udg_Hero_Rend, 85.00)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // //
    call ForGroupBJ(udg_Group_ZulJeenBerserkers, function Trig_Ambush_Cinematic_Cleanup_Func057002)
    call BlzUnitDisableAbility(udg_Unit_BerserkerCinematic, 'A60C', false, false)
    // ----------------------------------------
    // Unhide Creeps
    // //
    call ShowUnitShow(gg_unit_ngz3_0394)
    call ShowUnitShow(gg_unit_nsqe_0398)
    call ShowUnitShow(gg_unit_nsqe_0399)
    call ShowUnitShow(gg_unit_nsqo_0468)
    call ShowUnitShow(gg_unit_nsqa_0467)
    // //
    // Fade Faster If Cinematic Skipped
    // //
    if ( Trig_Ambush_Cinematic_Cleanup_Func070C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    call QueuedTriggerRemoveBJ(gg_trg_Ambush_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Berserker_Discover)
    call TriggerSleepAction(0.70)
    call ForGroupBJ(udg_Group_ZulJeenBerserkers, function Trig_Ambush_Cinematic_Cleanup_Func075002)
    // //
endfunction

//===========================================================================
function InitTrig_Ambush_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Ambush_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Ambush_Cinematic_Cleanup, function Trig_Ambush_Cinematic_Cleanup_Actions)
endfunction

//===========================================================================
// Trigger: Ambush Cinematic OrcsRoute
//===========================================================================
function Trig_Ambush_Cinematic_OrcsRoute_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_RendAmbush))
    call PlaySoundOnUnitBJ(gg_snd_CS_H01a_soldiers_walk_RtoL_a, 60.00, udg_FakeRend)
    call TriggerSleepAction(0.50)
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_Mid01FakeUtokWounded))
    call TriggerSleepAction(0.50)
    set udg_Point_CinAmbTrollTemp=GetRandomLocInRect(gg_rct_CinAmbushTrollsStaging)
    call IssuePointOrderLocBJ(udg_FakeGruntArr[1], "move", udg_Point_CinAmbTrollTemp)
    call TriggerSleepAction(0.50)
    set udg_Point_CinAmbTrollTemp=GetRandomLocInRect(gg_rct_CinAmbushTrollsStaging)
    call IssuePointOrderLocBJ(udg_FakeGruntArr[2], "move", udg_Point_CinAmbTrollTemp)
    call TriggerSleepAction(0.50)
    set udg_Point_CinAmbTrollTemp=GetRandomLocInRect(gg_rct_CinAmbushTrollsStaging)
    call IssuePointOrderLocBJ(udg_FakeGruntArr[3], "move", udg_Point_CinAmbTrollTemp)
    call TriggerSleepAction(0.50)
    set udg_Point_CinAmbTrollTemp=GetRandomLocInRect(gg_rct_CinAmbushTrollsStaging)
    call IssuePointOrderLocBJ(udg_FakeGruntArr[4], "move", udg_Point_CinAmbTrollTemp)
    call TriggerSleepAction(0.50)
    set udg_Point_CinAmbTrollTemp=GetRandomLocInRect(gg_rct_CinAmbushTrollsStaging)
    call IssuePointOrderLocBJ(udg_FakeGruntArr[5], "move", udg_Point_CinAmbTrollTemp)
    call RemoveLocation(udg_Point_CinAmbTrollTemp)
endfunction

