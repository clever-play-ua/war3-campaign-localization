    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_TyrsKeep_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_TyrsKeep_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_TyrsKeep_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_TyrsKeep_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_TyrsKeep_Cinematic_Skipped, Condition(function Trig_TyrsKeep_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_TyrsKeep_Cinematic_Skipped, function Trig_TyrsKeep_Cinematic_Skipped_Actions)
endfunction

