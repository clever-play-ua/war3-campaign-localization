    return ( udg_Bool_OutroCinSkipped == true )
endfunction

function Trig_Final_Cinematic_TurtleRouteA_Actions takes nothing returns nothing
    call IssuePointOrderLocBJ(udg_Unit_CinematicTurtleArr[1], "move", GetRectCenter(gg_rct_FinalTurtleA02))
    call TriggerSleepAction(( ( DistanceBetweenPoints(GetUnitLoc(udg_Unit_CinematicTurtleArr[1]), GetRectCenter(gg_rct_FinalTurtleA02)) / GetUnitMoveSpeed(udg_Unit_CinematicTurtleArr[1]) ) - 0.25 ))
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinematicTurtleArr[1], "move", GetRectCenter(gg_rct_FinalTurtleA03))
    call TriggerSleepAction(( ( DistanceBetweenPoints(GetUnitLoc(udg_Unit_CinematicTurtleArr[1]), GetRectCenter(gg_rct_FinalTurtleA03)) / GetUnitMoveSpeed(udg_Unit_CinematicTurtleArr[1]) ) - 1 ))
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssueImmediateOrderBJ(udg_Unit_CinematicTurtleArr[1], "stop")
    call SetUnitAnimation(udg_Unit_CinematicTurtleArr[1], "spell")
    call PlaySoundOnUnitBJ(gg_snd_Devour, 80.00, udg_Unit_CinematicTurtleArr[1])
    call TriggerSleepAction(0.40)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitVertexColorBJ(udg_Unit_CinDrownedFootmanArr[2], 100, 100, 100, 100.00)
    call AddSpecialEffectTargetUnitBJ("chest", udg_Unit_CinDrownedFootmanArr[2], "Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl")
    set udg_SE_TurtleBloodEffectArr[1]=GetLastCreatedEffectBJ()
    call DestroyEffectBJ(udg_SE_BubblesArr[2])
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFlyHeightBJ(udg_Unit_CinematicTurtleArr[1], 150.00, 15.00)
    call IssuePointOrderLocBJ(udg_Unit_CinematicTurtleArr[1], "move", GetRectCenter(gg_rct_FinalTurtleA04))
    call TriggerSleepAction(( ( DistanceBetweenPoints(GetUnitLoc(udg_Unit_CinematicTurtleArr[1]), GetRectCenter(gg_rct_FinalTurtleA04)) / GetUnitMoveSpeed(udg_Unit_CinematicTurtleArr[1]) ) - 0.25 ))
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinematicTurtleArr[1], "move", GetRectCenter(gg_rct_FinalTurtleA05))
    call TriggerSleepAction(( ( DistanceBetweenPoints(GetUnitLoc(udg_Unit_CinematicTurtleArr[1]), GetRectCenter(gg_rct_FinalTurtleA05)) / GetUnitMoveSpeed(udg_Unit_CinematicTurtleArr[1]) ) - 0.25 ))
    if ( (udg_Bool_OutroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_CinematicTurtleArr[1], "move", GetRectCenter(gg_rct_FinalTurtleA06))
endfunction

