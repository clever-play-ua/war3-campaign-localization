endfunction

function Trig_TRReturnAndRecycle_Func002A takes nothing returns nothing
    if ( Trig_TRReturnAndRecycle_Func002Func001C() ) then
        call RecycleGuardPosition(GetEnumUnit())
        // Covering Repair case here
        if ( (true) ) then // INLINED!!
            // Covering Repair case here
