    // //
    call KillUnit(gg_unit_h60S_0151)
    call IssuePointOrderLocBJ(gg_unit_h60S_0152, "move", GetRectCenter(gg_rct_ArcherKill01))
    call IssuePointOrderLocBJ(gg_unit_h60S_0153, "move", GetRectCenter(gg_rct_ArcherKill02))
    // //
    call TriggerSleepAction(( DistanceBetweenPoints(GetUnitLoc(udg_Unit_BerserkerCinematic), GetRectCenter(gg_rct_BerserkCutThroats)) / GetUnitMoveSpeed(udg_Unit_BerserkerCinematic) ))
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PauseUnitBJ(true, gg_unit_h60S_0152)
    call PauseUnitBJ(true, gg_unit_h60S_0153)
    call PauseUnitBJ(true, udg_Unit_BerserkerCinematic)
    call SetUnitAnimation(udg_Unit_BerserkerCinematic, "spell slam")
    call QueueUnitAnimationBJ(udg_Unit_BerserkerCinematic, "stand")
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundOnUnitBJ(gg_snd_MetalHeavySliceFlesh1, 100, gg_unit_h60S_0152)
    call PlaySoundOnUnitBJ(gg_snd_MetalHeavySliceFlesh2, 100, gg_unit_h60S_0153)
    // //
    call TriggerSleepAction(0.30)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PauseUnitBJ(false, gg_unit_h60S_0152)
    call KillUnit(gg_unit_h60S_0152)
    call PauseUnitBJ(false, gg_unit_h60S_0153)
    call KillUnit(gg_unit_h60S_0153)
    call PauseUnitBJ(false, udg_Unit_BerserkerCinematic)
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_BerserkerSavedOrcs, udg_Player_Actual, 0)
    // //
    call SetUnitPositionLocFacingBJ(udg_Unit_BerserkerCinematic, GetRectCenter(gg_rct_BerserkerCinematic), 181.48)
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_RendAmbush), 300.55)
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_FakeRend)
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Unit_BerserkerCinematic)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
