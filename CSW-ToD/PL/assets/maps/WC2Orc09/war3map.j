    set gg_trg_Blizzard_Freeze_Simple=CreateTrigger()
    call TriggerAddAction(gg_trg_Blizzard_Freeze_Simple, function Trig_Blizzard_Freeze_Simple_Actions)
endfunction

//===========================================================================
// Trigger: Blizzard SetUnitAmphibious
//===========================================================================
function Trig_Blizzard_SetUnitAmphibious_Func044C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00F', udg_Player_Actual) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blizzard_SetUnitAmphibious_Func048C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00X', udg_Player_Actual) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blizzard_SetUnitAmphibious_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // ALLIANCE
    // //
    // //
    // NewUnitsAvailable
    // //
    call SetPlayerUnitAvailableBJ('h007', true, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('h00A', true, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('h008', true, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('e002', true, udg_Player18_Stromgarde_Ground)
    // //
    // NewUnitsAvailable
    // //
    call SetPlayerUnitAvailableBJ('h007', true, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('h00A', true, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('h008', true, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('e002', true, udg_Player03_Stromgarde_Keep)
    // //
    call SetPlayerTechResearchedSwap('RTI0', 1, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('RTI0', 1, udg_Player18_Stromgarde_Ground)
    call SetPlayerTechResearchedSwap('RTI0', 1, udg_Player03_Stromgarde_Keep)
    call SetPlayerTechResearchedSwap('RTI0', 1, udg_Player_Silverhand)
    // //
    // HORDE
    // //
    // OldUnitsNotAvailable
    // //
    call SetPlayerUnitAvailableBJ('o61Y', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60G', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60O', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60T', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('n001', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('n002', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60P', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('O617', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('N60K', false, udg_Player_Actual)
    // //
    // NewUnitsAvailable
    // //
    call SetPlayerUnitAvailableBJ('o002', true, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o001', true, udg_Player_Actual)
    // //
    if ( Trig_Blizzard_SetUnitAmphibious_Func044C() ) then
        call SetPlayerUnitAvailableBJ('oTA1', true, udg_Player_Actual)
        call SetPlayerUnitAvailableBJ('o007', false, udg_Player_Actual)
    else
        call SetPlayerUnitAvailableBJ('oTA1', false, udg_Player_Actual)
        call SetPlayerUnitAvailableBJ('o007', true, udg_Player_Actual)
    endif
    // //
    call SetPlayerUnitAvailableBJ('oTA0', true, udg_Player_Actual)
    // //
    if ( Trig_Blizzard_SetUnitAmphibious_Func048C() ) then
        call SetPlayerUnitAvailableBJ('n009', true, udg_Player_Actual)
        call SetPlayerUnitAvailableBJ('n00A', false, udg_Player_Actual)
    else
        call SetPlayerUnitAvailableBJ('n009', false, udg_Player_Actual)
        call SetPlayerUnitAvailableBJ('n00A', true, udg_Player_Actual)
    endif
    // //
    call SetPlayerUnitAvailableBJ('O008', true, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('N00B', true, udg_Player_Actual)
    // //
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Blizzard_SetUnitAmphibious takes nothing returns nothing
    set gg_trg_Blizzard_SetUnitAmphibious=CreateTrigger()
    call TriggerAddAction(gg_trg_Blizzard_SetUnitAmphibious, function Trig_Blizzard_SetUnitAmphibious_Actions)
endfunction

