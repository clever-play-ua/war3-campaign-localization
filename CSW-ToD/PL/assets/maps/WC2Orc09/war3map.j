//===========================================================================
// Trigger: AIP16 Start
//===========================================================================
function Trig_AIP16_Start_Func008Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIP16_Start_Func008C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_AIP16_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerStateBJ(udg_Player16_Stromgarde_Navy, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(udg_Player16_Stromgarde_Navy, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call SetPlayerStateBJ(udg_Player16_Stromgarde_Navy, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerStateBJ(udg_Player16_Stromgarde_Navy, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    // //
    if ( Trig_AIP16_Start_Func008C() ) then
        call playerAddOil(Player(15) , 15000)
    else
        if ( Trig_AIP16_Start_Func008Func003C() ) then
            call playerAddOil(Player(15) , 120000)
        else
            call playerAddOil(Player(15) , 100000)
        endif
    endif
    // //
    // //
    call EnableTrigger(gg_trg_AIP16_Gold)
    call EnableTrigger(gg_trg_AIP16_Lumber)
    // //
    // //
    call StartCampaignAI(udg_Player16_Stromgarde_Navy, "CSW\\Scripts\\ToDScripts\\WC2Orc09\\WC2Orc09P16AllianceNavalAI.ai")
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P16_Command_Start_Attack_User)
    // //
    call StartTimerBJ(udg_Timer_P16OilChecker, true, 1.00)
    // //
    // //
    call PauseUnitBJ(false, gg_unit_h600_0623)
    call PauseUnitBJ(false, gg_unit_h600_0622)
    // //
    call IssueTargetOrderBJ(gg_unit_h600_0622, "smart", gg_unit_u600_0099)
    call IssueTargetOrderBJ(gg_unit_h600_0623, "smart", gg_unit_u600_0099)
endfunction

//===========================================================================
function InitTrig_AIP16_Start takes nothing returns nothing
    set gg_trg_AIP16_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AIP16_Start, function Trig_AIP16_Start_Actions)
endfunction

