function InitTrig_OgreMagi_Cinematic_Q takes nothing returns nothing
    set gg_trg_OgreMagi_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_OgreMagi_Cinematic_Q, function Trig_OgreMagi_Cinematic_Q_Actions)
endfunction

