//===========================================================================
// Trigger: Glittering Prizes
//===========================================================================
function Trig_Glittering_Prizes_Actions takes nothing returns nothing
    call SetPlayerStateBJ(Player(0), PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(Player(0), PLAYER_STATE_RESOURCE_GOLD) + 5000 ))
    call SetPlayerStateBJ(Player(0), PLAYER_STATE_RESOURCE_LUMBER, ( GetPlayerState(Player(0), PLAYER_STATE_RESOURCE_LUMBER) + 5000 ))
    call playerAddOil(Player(0) , 5000)
    // ////
    call TriggerSleepAction(1.00)
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_020")
endfunction

//===========================================================================
function InitTrig_Glittering_Prizes takes nothing returns nothing
    set gg_trg_Glittering_Prizes=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_Glittering_Prizes, Player(0), "Glittering prizes", true)
    call TriggerAddAction(gg_trg_Glittering_Prizes, function Trig_Glittering_Prizes_Actions)
endfunction

//===========================================================================
// Trigger: On screen
//===========================================================================
function Trig_On_screen_Func002C takes nothing returns boolean
    if ( not ( udg_BoolCheat_VisibilityOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_On_screen_Actions takes nothing returns nothing
    if ( Trig_On_screen_Func002C() ) then
        set udg_BoolCheat_VisibilityOn=true
        call FogMaskEnableOff()
        call FogEnableOff()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_3506")
    else
        set udg_BoolCheat_VisibilityOn=false
        call FogMaskEnableOn()
        call FogEnableOn()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_3509")
    endif
endfunction

//===========================================================================
function InitTrig_On_screen takes nothing returns nothing
    set gg_trg_On_screen=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_On_screen, Player(0), "On screen", true)
    call TriggerAddAction(gg_trg_On_screen, function Trig_On_screen_Actions)
endfunction

//===========================================================================
// Trigger: Showpath
//===========================================================================
function Trig_Showpath_Func002C takes nothing returns boolean
    if ( not ( udg_BoolCheat_UnmaskedOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Showpath_Actions takes nothing returns nothing
    if ( Trig_Showpath_Func002C() ) then
        set udg_BoolCheat_UnmaskedOn=true
        call FogMaskEnableOff()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_3507")
    else
        set udg_BoolCheat_UnmaskedOn=false
        call FogMaskEnableOn()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_3508")
    endif
endfunction

//===========================================================================
function InitTrig_Showpath takes nothing returns nothing
    set gg_trg_Showpath=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_Showpath, Player(0), "Showpath", true)
    call TriggerAddAction(gg_trg_Showpath, function Trig_Showpath_Actions)
endfunction

//===========================================================================
// Trigger: Initialization
//
// Default melee game initialization for all players
//===========================================================================
function Trig_Initialization_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Oil_Locale_Setup)
    // **********
    call SetAllyColorFilterState(0)
    call EnableMinimapFilterButtons(false, false)
    call SetMaxCheckpointSaves(10)
    set udg_String_CheckpointChapter="WC2Orc09"
    // //
    set udg_Point_SpawnFakeMaim=GetRectCenter(gg_rct_FakeMaimCreate)
    set udg_Point_SpawnFakeRend=GetRectCenter(gg_rct_FakeRendCreate)
    set udg_Point_SpawnFakeUtok=GetRectCenter(gg_rct_FakeUtokCreate)
    set udg_Point_SpawnFakeSaidan=GetRectCenter(gg_rct_FakeSaidanCreate)
    set udg_Point_SpawnFakeWaldemar=GetRectCenter(gg_rct_FakeWaldemarCreate)
    set udg_Point_SpawnFakeArchmage=GetRectCenter(gg_rct_FakeArchmageCreate)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_01_Players)
    call ConditionalTriggerExecute(gg_trg_Init_03_Audio)
    call ConditionalTriggerExecute(gg_trg_Init_04_Environment)
    call ConditionalTriggerExecute(gg_trg_Init_05_Quests)
    // **********
    call ConditionalTriggerExecute(gg_trg_LoadFacialAnimations)
    // Start Intro
    call QueuedTriggerAddBJ(gg_trg_Intro_Cinematic_Q, true)
endfunction

//===========================================================================
function InitTrig_Initialization takes nothing returns nothing
    set gg_trg_Initialization=CreateTrigger()
    call TriggerAddAction(gg_trg_Initialization, function Trig_Initialization_Actions)
endfunction

//===========================================================================
// Trigger: Init 01 Players
//===========================================================================
function Trig_Init_01_Players_Actions takes nothing returns nothing
    // ----------
    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[0]
    // //
    // PlayerUser
    // //
    set udg_Player_Actual=Player(0)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 1000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 1000)
    call playerAddOil(Player(0) , 1000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o006', 0, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Player_Actual)
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_COAL, true)
    call SetPlayerTechMaxAllowedSwap('Robk', 0, udg_Player_Actual)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_3572")
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 10.00)
    // //
    // Player Alliance
    // //
    set udg_Player_Alliance=Player(1)
    // //
    // Player Stromgarde
    // //
    set udg_Player03_Stromgarde_Keep=Player(2)
    call SetPlayerColorBJ(udg_Player03_Stromgarde_Keep, PLAYER_COLOR_MAROON, true)
    call SetPlayerAbilityAvailableBJ(false, 'A65B', udg_Player03_Stromgarde_Keep)
    call SetPlayerTechResearchedSwap('R016', 1, udg_Player03_Stromgarde_Keep)
    // //
    call SetPlayerUnitAvailableBJ('hSjM', true, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('hSSt', true, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('hKsM', true, udg_Player03_Stromgarde_Keep)
    call SetPlayerUnitAvailableBJ('hKSt', true, udg_Player03_Stromgarde_Keep)
    // //
    set udg_Player16_Stromgarde_Navy=Player(15)
    call SetPlayerColorBJ(udg_Player16_Stromgarde_Navy, PLAYER_COLOR_MAROON, true)
    call SetPlayerAbilityAvailableBJ(false, 'A65B', udg_Player16_Stromgarde_Navy)
    call SetPlayerTechResearchedSwap('R016', 1, udg_Player16_Stromgarde_Navy)
    // //
    set udg_Player18_Stromgarde_Ground=Player(17)
    call SetPlayerColorBJ(udg_Player18_Stromgarde_Ground, PLAYER_COLOR_MAROON, true)
    call SetPlayerAbilityAvailableBJ(false, 'A65B', udg_Player18_Stromgarde_Ground)
    call SetPlayerTechResearchedSwap('R016', 1, udg_Player18_Stromgarde_Ground)
    // //
    call SetPlayerUnitAvailableBJ('hSSt', true, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('hSjM', true, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('hKSt', true, udg_Player18_Stromgarde_Ground)
    call SetPlayerUnitAvailableBJ('hKsM', true, udg_Player18_Stromgarde_Ground)
    // //
    set udg_Player_Caravan=Player(16)
    call SetPlayerColorBJ(udg_Player_Caravan, PLAYER_COLOR_MAROON, true)
    call SetPlayerAbilityAvailableBJ(false, 'A65B', udg_Player_Caravan)
    call SetPlayerName(udg_Player_Caravan, "TRIGSTR_3601")
    // //
    // Player Order of Silverhand
    // //
    set udg_Player_Silverhand=Player(9)
    // //
    // Player Black tooth grin
    // //
    set udg_Player_BTG=Player(5)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_BTG)
    call SetPlayerName(udg_Player_BTG, "TRIGSTR_3573")
    call SetPlayerColorBJ(udg_Player_BTG, PLAYER_COLOR_COAL, true)
    // //
    set udg_Player_BTGCinematic=Player(20)
    // //
    // Player Trolls
    // //
    set udg_Player_Trolls=Player(6)
    call SetPlayerColorBJ(udg_Player_Trolls, PLAYER_COLOR_COAL, true)
    call SetPlayerName(udg_Player_Trolls, "TRIGSTR_3574")
    // //
    // Cinematic Players
    // //
    set udg_Player_MaroonCinematic=Player(12)
    call SetPlayerColorBJ(udg_Player_MaroonCinematic, PLAYER_COLOR_RED, true)
    set udg_Player_CinematicDummy=Player(23)
    // //
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicDummy)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_BTGCinematic)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_MaroonCinematic)
    // //
    // Player Settings and Alliances
    // //
    call EnableCreepSleepBJ(false)
    // ----------
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player03_Stromgarde_Keep, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player18_Stromgarde_Ground, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player03_Stromgarde_Keep, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player18_Stromgarde_Ground, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // ----------
    // ----------
    // Player owners for Cinematics
    // ----------
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BTGCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_MaroonCinematic, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_MaroonCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_MaroonCinematic, udg_Player_BTGCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_MaroonCinematic, bj_ALLIANCE_NEUTRAL)
    // ----------
    // LockAmphibiousUnits
    // ----------
    call SetPlayerUnitAvailableBJ('o002', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o001', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oTA0', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('oTA1', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o007', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('n009', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('n00A', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('O008', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('N00B', false, udg_Player_Actual)
    // ----------
    // ----------
    call SetPlayerColorBJ(udg_Player_Alliance, PLAYER_COLOR_LIGHT_BLUE, true)
    call SetPlayerColorBJ(udg_Player03_Stromgarde_Keep, PLAYER_COLOR_MAROON, true)
    call SetPlayerColorBJ(udg_Player18_Stromgarde_Ground, PLAYER_COLOR_MAROON, true)
    // ----------
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player03_Stromgarde_Keep, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player18_Stromgarde_Ground, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player03_Stromgarde_Keep, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player18_Stromgarde_Ground, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player03_Stromgarde_Keep, Player(6), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player18_Stromgarde_Ground, Player(6), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Silverhand, udg_Player18_Stromgarde_Ground, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Trolls, udg_Player03_Stromgarde_Keep, bj_ALLIANCE_NEUTRAL)
    // ----------
    // LockAmphibiousUnits
    // //
    // //
    // //
    // Alliances
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BTG, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BTG, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player18_Stromgarde_Ground, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTG, udg_Player03_Stromgarde_Keep, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player18_Stromgarde_Ground, udg_Player_BTG, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player03_Stromgarde_Keep, udg_Player_BTG, bj_ALLIANCE_NEUTRAL)
    // //
    // ----------
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // ----------
    call ConditionalTriggerExecute(gg_trg_Init_06a_Easy)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Normal)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Hard)
    // ----------
    // ----------
    // ----------
    // ----------
endfunction

