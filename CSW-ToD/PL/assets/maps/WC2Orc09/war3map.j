    if ( not ( udg_Bool_BlizzardStarted == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Light_Snow_End_Func003001 takes nothing returns boolean
    return ( udg_Bool_BlizzardStarted == true )
endfunction

function Trig_Light_Snow_End_Actions takes nothing returns nothing
    if ( (udg_Bool_BlizzardStarted == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call EnableWeatherEffect(udg_Weather_SnowLight, false)
    call RemoveWeatherEffectBJ(udg_Weather_SnowLight)
    set udg_Bool_Snowing=false
    call StartTimerBJ(udg_Timer_SnowOut, true, 1.00)
    call StartTimerBJ(udg_Timer_HeavySnowFall, false, GetRandomReal(180.00, 840.00))
endfunction

//===========================================================================
function InitTrig_Light_Snow_End takes nothing returns nothing
    set gg_trg_Light_Snow_End=CreateTrigger()
