function InitTrig_Camp_Completed takes nothing returns nothing
    set gg_trg_Camp_Completed=CreateTrigger()
    call DisableTrigger(gg_trg_Camp_Completed)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Camp_Completed, 1.00)
    call TriggerAddCondition(gg_trg_Camp_Completed, Condition(function Trig_Camp_Completed_Conditions))
    call TriggerAddAction(gg_trg_Camp_Completed, function Trig_Camp_Completed_Actions)
endfunction

