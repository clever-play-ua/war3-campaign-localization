function Trig_TyrsKeep_Cinematic_Q_Actions takes nothing returns nothing
    loop
        exitwhen ( (IsTriggerQueuedBJ(gg_trg_Razing_Update_Destroy_BarracksQ) == false) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    loop
        exitwhen ( (IsTriggerQueuedBJ(gg_trg_Razing_Update_DestroyCitadel_Q2) == false) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    loop
        exitwhen ( (IsTriggerQueuedBJ(gg_trg_Razing_Completed_Q) == false) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetup)
    call DisableTrigger(gg_trg_PlayerUnitsDead)
    // //////
    // //////
    call ConditionalTriggerExecute(gg_trg_TyrsKeep_Cin_SetUp)
    // Ensure Setup completes
    call TriggerSleepAction(1.00)
    // //////
    call CameraSetupApplyForPlayer(true, gg_cam_Cathedral00, udg_Player_Actual, 0)
    // //////
    call CameraSetFocalDistance(900.00)
    call CameraSetDepthOfFieldScale(400.00)
    // //////
    // //////
