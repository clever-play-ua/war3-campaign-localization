//===========================================================================
// Trigger: SetUpOilPatchCapacity
//
// The oil patches need to replaced in this misison to avoid flying above estroyed walkable ice
//===========================================================================
function Trig_SetUpOilPatchCapacity_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ReplaceUnitBJ(gg_unit_n60P_0104, 'n60P', bj_UNIT_STATE_METHOD_RELATIVE)
    set udg_Unit_OilPatchCamp=GetLastReplacedUnitBJ()
    call s__OilPatch_setOilAmount(udg_Unit_OilPatchCamp , 6500)
    call SetUnitState(udg_Unit_OilPatchCamp, UNIT_STATE_MANA, 6500)
    // //
    call ReplaceUnitBJ(gg_unit_n60P_0103, 'n60P', bj_UNIT_STATE_METHOD_RELATIVE)
    set udg_OilPatchUnit=GetLastReplacedUnitBJ()
    call s__OilPatch_setOilAmount(udg_OilPatchUnit , 9500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MANA, 9500)
    // //
    call ReplaceUnitBJ(gg_unit_n60P_0100, 'n60P', bj_UNIT_STATE_METHOD_RELATIVE)
    set udg_OilPatchUnit=GetLastReplacedUnitBJ()
    call s__OilPatch_setOilAmount(udg_OilPatchUnit , 10500)
    call SetUnitState(udg_OilPatchUnit, UNIT_STATE_MANA, 10500)
    // //
    set udg_OilPatchUnit=gg_unit_n60P_0101
endfunction

//===========================================================================
function InitTrig_SetUpOilPatchCapacity takes nothing returns nothing
    set gg_trg_SetUpOilPatchCapacity=CreateTrigger()
    call TriggerAddAction(gg_trg_SetUpOilPatchCapacity, function Trig_SetUpOilPatchCapacity_Actions)
endfunction

