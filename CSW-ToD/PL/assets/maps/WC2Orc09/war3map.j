//===========================================================================
// Trigger: CreateFakeActors
//===========================================================================
function Trig_CreateFakeActors_Func089A takes nothing returns nothing
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", GetEnumUnit())
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.25)
    call SetUnitMoveSpeed(GetEnumUnit(), 100.00)
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_CreateFakeActors_Actions takes nothing returns nothing
    // CreateFakeActors
    // //
    // Saidan
    call CreateNUnitsAtLoc(1, 'HSCA', udg_Player_MaroonCinematic, udg_Point_SpawnFakeSaidan, bj_UNIT_FACING)
    set udg_Fake_Saidan=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_Fake_Saidan)
    call SetUnitBlendTimeBJ(udg_Fake_Saidan, 0.25)
    call SetUnitMoveSpeed(udg_Fake_Saidan, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Saidan, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call ShowUnitHide(udg_Fake_Saidan)
    // //
    // Waldemar
    call CreateNUnitsAtLoc(1, 'HWCN', udg_Player_MaroonCinematic, udg_Point_SpawnFakeWaldemar, bj_UNIT_FACING)
    set udg_Fake_Waldemar=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_Fake_Waldemar)
    call SetUnitBlendTimeBJ(udg_Fake_Waldemar, 0.25)
    call SetUnitMoveSpeed(udg_Fake_Waldemar, 150.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Waldemar, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    call ShowUnitHide(udg_Fake_Waldemar)
    // //
    // Archmage
    call CreateNUnitsAtLoc(1, 'H00D', udg_Player_MaroonCinematic, udg_Point_SpawnFakeArchmage, bj_UNIT_FACING)
    set udg_Fake_Archmage=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_Fake_Archmage)
    call SetUnitBlendTimeBJ(udg_Fake_Archmage, 0.25)
    call SetUnitMoveSpeed(udg_Fake_Archmage, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Archmage, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitColor(udg_Fake_Archmage, PLAYER_COLOR_VIOLET)
    call ShowUnitHide(udg_Fake_Archmage)
    // //
    // //
    // Utok
    // //
    call CreateNUnitsAtLoc(1, 'o605', udg_Player_MaroonCinematic, udg_Point_SpawnFakeUtok, bj_UNIT_FACING)
    set udg_FakeUtok=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeUtok)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call ShowUnitHide(udg_FakeUtok)
    // //
    // Maim
    // //
    call CreateNUnitsAtLoc(1, 'OMBc', udg_Player_BTGCinematic, udg_Point_SpawnFakeMaim, bj_UNIT_FACING)
    set udg_FakeMaim=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeMaim)
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.25)
    call SetUnitMoveSpeed(udg_FakeMaim, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call ShowUnitHide(udg_FakeMaim)
    // //
    // Rend
    // //
    call CreateNUnitsAtLoc(1, 'ORbC', udg_Player_BTGCinematic, udg_Point_SpawnFakeRend, bj_UNIT_FACING)
    set udg_FakeRend=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeRend)
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.25)
    call SetUnitMoveSpeed(udg_FakeRend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call ShowUnitHide(udg_FakeRend)
    // //
    // Grunts
    // //
    set udg_Point_GruntRandomTemp=GetRandomLocInRect(gg_rct_FakeUnitsParty)
    call CreateNUnitsAtLoc(1, 'o60G', udg_Player_BTGCinematic, udg_Point_GruntRandomTemp, bj_UNIT_FACING)
    set udg_FakeGruntArr[1]=GetLastCreatedUnit()
    // //
    set udg_Point_GruntRandomTemp=GetRandomLocInRect(gg_rct_FakeUnitsParty)
    call CreateNUnitsAtLoc(1, 'o60G', udg_Player_BTGCinematic, udg_Point_GruntRandomTemp, bj_UNIT_FACING)
    set udg_FakeGruntArr[2]=GetLastCreatedUnit()
    // //
    set udg_Point_GruntRandomTemp=GetRandomLocInRect(gg_rct_FakeUnitsParty)
    call CreateNUnitsAtLoc(1, 'o60G', udg_Player_BTGCinematic, udg_Point_GruntRandomTemp, bj_UNIT_FACING)
    set udg_FakeGruntArr[3]=GetLastCreatedUnit()
    // //
    set udg_Point_GruntRandomTemp=GetRandomLocInRect(gg_rct_FakeUnitsParty)
    call CreateNUnitsAtLoc(1, 'o60G', udg_Player_BTGCinematic, udg_Point_GruntRandomTemp, bj_UNIT_FACING)
    set udg_FakeGruntArr[4]=GetLastCreatedUnit()
    // //
    set udg_Point_GruntRandomTemp=GetRandomLocInRect(gg_rct_FakeUnitsParty)
    call CreateNUnitsAtLoc(1, 'o60G', udg_Player_BTGCinematic, udg_Point_GruntRandomTemp, bj_UNIT_FACING)
    set udg_FakeGruntArr[5]=GetLastCreatedUnit()
    // //
    call RemoveLocation(udg_Point_GruntRandomTemp)
    // ***
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call GroupAddUnitSimple(udg_FakeGruntArr[GetForLoopIndexA()], udg_Group_FakeGrunts)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call ForGroupBJ(udg_Group_FakeGrunts, function Trig_CreateFakeActors_Func089A)
    // //
endfunction

