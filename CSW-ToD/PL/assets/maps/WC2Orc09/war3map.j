endfunction

function Trig_TyrsKeep_Cin_SetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    // //////
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_TyrsKeepQuestUnitCheck, udg_Player03_Stromgarde_Keep), function Trig_TyrsKeep_Cin_SetUp_Func006002)
    // /////
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_TyrsKeepQuestUnitCheck, udg_Player18_Stromgarde_Ground), function Trig_TyrsKeep_Cin_SetUp_Func009002)
    // /////
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_TyrsKeepQuestUnitCheck, Condition(function Trig_TyrsKeep_Cin_SetUp_Func012001002)), function Trig_TyrsKeep_Cin_SetUp_Func012002)
    // /////
    call ForGroupBJ(udg_Group_TyrHand, function Trig_TyrsKeep_Cin_SetUp_Func014002)
    // /////
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player18_Stromgarde_Ground, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player18_Stromgarde_Ground, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player03_Stromgarde_Keep, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player03_Stromgarde_Keep, bj_ALLIANCE_NEUTRAL)
    // //////
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // /////
    // /////
    call ShowUnitHide(gg_unit_ndog_0219)
    // //////
    call SetUnitPositionLocFacingBJ(udg_Fake_Waldemar, GetRectCenter(gg_rct_Veldemar01), 317.82)
    call ShowUnitShow(udg_Fake_Waldemar)
    // //////
    call SetUnitPositionLocFacingBJ(udg_Fake_Saidan, GetRectCenter(gg_rct_SaidanVounded), 229.35)
    call ShowUnitShow(udg_Fake_Saidan)
    call SetUnitAnimation(udg_Fake_Saidan, "cinematic injured one")
    // //////
    call CreateNUnitsAtLoc(1, 'h006', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_CinematicGuard01), 306.70)
    set udg_Unit_CinGuardReinforcementArr[1]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h006', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_CinematicGuard02), 306.70)
    set udg_Unit_CinGuardReinforcementArr[2]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h006', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_CinematicGuard03), 306.70)
    set udg_Unit_CinGuardReinforcementArr[3]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h006', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_CinematicGuard04), 306.70)
    set udg_Unit_CinGuardReinforcementArr[4]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h006', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_CinematicGuard05), 306.70)
    set udg_Unit_CinGuardReinforcementArr[5]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h006', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_CinematicGuard06), 306.70)
    set udg_Unit_CinGuardReinforcementArr[6]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h006', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_CinematicGuard07), 306.70)
    set udg_Unit_CinGuardReinforcementArr[7]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'h006', udg_Player_MaroonCinematic, GetRectCenter(gg_rct_CinematicGuard08), 306.70)
    set udg_Unit_CinGuardReinforcementArr[8]=GetLastCreatedUnit()
    // //////
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitAnimation(udg_Unit_CinGuardReinforcementArr[GetForLoopIndexA()], "cinematic stand")
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //////
endfunction

//===========================================================================
function InitTrig_TyrsKeep_Cin_SetUp takes nothing returns nothing
    set gg_trg_TyrsKeep_Cin_SetUp=CreateTrigger()
    call TriggerAddAction(gg_trg_TyrsKeep_Cin_SetUp, function Trig_TyrsKeep_Cin_SetUp_Actions)
endfunction

