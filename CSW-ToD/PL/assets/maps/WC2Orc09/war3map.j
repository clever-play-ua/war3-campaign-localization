    set gg_trg_WallSegmentDeath01=CreateTrigger()
    call TriggerRegisterDeathEvent(gg_trg_WallSegmentDeath01, gg_dest_B60A_1037)
    call TriggerAddAction(gg_trg_WallSegmentDeath01, function Trig_WallSegmentDeath01_Actions)
endfunction

