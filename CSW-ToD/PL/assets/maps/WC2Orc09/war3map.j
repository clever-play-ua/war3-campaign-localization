//===========================================================================
// Trigger: DebugOn
//===========================================================================
function Trig_DebugOn_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DebugOn_Actions takes nothing returns nothing
    set udg_Bool_DebugOn=true
    call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3570")
endfunction

//===========================================================================
function InitTrig_DebugOn takes nothing returns nothing
    set gg_trg_DebugOn=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_DebugOn, Player(0), "DebugOn", true)
    call TriggerAddCondition(gg_trg_DebugOn, Condition(function Trig_DebugOn_Conditions))
    call TriggerAddAction(gg_trg_DebugOn, function Trig_DebugOn_Actions)
endfunction

