        return false
    endif
    return true
endfunction

function Trig_LoadUtok_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_LoadUtok_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Utok", "WC2Orc08", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_UtokStart), GetRectCenter(gg_rct_BlackhandStart))
        set udg_SemiHero_Utok=GetLastRestoredUnitBJ()
        call SetPlayerTechResearchedSwap('RUX2', GetStoredIntegerBJ("UtokLevel", "WC2Orc08", udg_Cache), udg_Player_Actual)
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_UtokStart), GetRectCenter(gg_rct_BlackhandStart))
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call SetPlayerTechResearchedSwap('RUX2', 8, udg_Player_Actual)
    endif
    call SetUnitColor(udg_SemiHero_Utok, PLAYER_COLOR_RED)
    call ConditionalTriggerExecute(gg_trg_UtokLevelChecker)
endfunction

