    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_WaterfallBig), "Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl")
    set udg_SE_BubbleExplosion=GetLastCreatedEffectBJ()
    call PolledWait(0.50)
    call ForGroupBJ(udg_Group_HiddenMurlocks, function Trig_Creeps_MurlocsDisturbed_Func005002)
    call ForGroupBJ(udg_Group_HiddenMurlocks, function Trig_Creeps_MurlocsDisturbed_Func006002)
    call PolledWait(4.00)
    call DestroyEffectBJ(udg_SE_BubbleExplosion)
endfunction

