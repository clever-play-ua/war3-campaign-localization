    set gg_trg_Intro_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Q, function Trig_Intro_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic SetUp
//===========================================================================
function Trig_Intro_Cinematic_SetUp_Func015002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenCreeps)
endfunction

function Trig_Intro_Cinematic_SetUp_Func016002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_SetUp_Func084002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_IntroOrcsSquad)
endfunction

function Trig_Intro_Cinematic_SetUp_Func087A takes nothing returns nothing
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", GetEnumUnit())
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.25)
    call SetUnitMoveSpeed(GetEnumUnit(), 100.00)
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_SetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    // SetDoodads
    // //
    call SetDoodadAnimationRectBJ("decay", 'NOfp', gg_rct_IntroFirePit)
    // //
    // SetActors
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    // Creeps
    // //
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_ArchwayVisibility01, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Intro_Cinematic_SetUp_Func015002)
    call ForGroupBJ(udg_Group_HiddenCreeps, function Trig_Intro_Cinematic_SetUp_Func016002)
    call ShowUnitHide(gg_unit_nsqe_0471)
    // //
    // Peasants
    // //
    call SetUnitPathing(gg_unit_hPSt_0377, false)
    call AddUnitAnimationPropertiesBJ(true, "gold", gg_unit_hPSt_0377)
    call SetUnitAnimation(gg_unit_nvil_0382, "cinematic standard one")
    // //
    // Footmans on the shore
    // //
    call SetUnitAnimation(gg_unit_hfSt_0383, "cinematic kneeling one")
    call SetUnitAnimation(gg_unit_hfSt_0384, "cinematic sitting one")
    call SetUnitAnimation(gg_unit_hfSt_0385, "cinematic sitting one")
    call SetUnitBlendTimeBJ(gg_unit_hfSt_0386, 0.25)
    call SetUnitBlendTimeBJ(gg_unit_hPSt_0377, 0.25)
    // //
    // Saidan
    call ShowUnitHide(udg_Hero_SaidanDathrohan)
    call PauseUnitBJ(true, udg_Hero_SaidanDathrohan)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Saidan, GetRectCenter(gg_rct_IntroSaidanStart), 286.51)
    call SetUnitOwner(udg_Fake_Saidan, udg_Player03_Stromgarde_Keep, true)
    call ShowUnitShow(udg_Fake_Saidan)
    // //
    // Footman
    // //
    set udg_Unit_CinematicCaptain=gg_unit_hCSt_0260
    call SetUnitBlendTimeBJ(udg_Unit_CinematicCaptain, 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_CinematicCaptain)
    call BlzSetUnitRealFieldBJ(udg_Unit_CinematicCaptain, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_Unit_CinematicCaptain, 100.00)
    call SetUnitLookAt(udg_Unit_CinematicCaptain, "bone_head", udg_Fake_Saidan, 0, 0, 90)
    // //
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_hfSt_0258)
    call BlzSetUnitRealFieldBJ(gg_unit_hfSt_0258, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(gg_unit_hfSt_0258, 100.00)
    // //
    // Ships
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h60P', udg_Player_Alliance, GetRectCenter(gg_rct_IntroHumanShip01), GetRectCenter(gg_rct_IntroHumanShip02))
    set udg_Unit_IntroTransportShip=GetLastCreatedUnit()
    // //
    call SetUnitScalePercent(gg_unit_o60Q_0388, 150.00, 150.00, 150.00)
    call SetUnitPathing(udg_Unit_IntroTransportShip, false)
    call SetUnitScalePercent(gg_unit_o60Q_0388, 170.00, 170.00, 170.00)
    // //
    // Mage
    // //
    call ShowUnitHide(udg_Hero_MageBoss)
    call PauseUnitBJ(true, udg_Hero_MageBoss)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Archmage, GetRectCenter(gg_rct_IntroMageArrival), 45.00)
    call SetUnitColor(udg_Fake_Archmage, PLAYER_COLOR_VIOLET)
    // //
    // Utok
    // //
    call ShowUnitHide(udg_SemiHero_Utok)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    // //
    // Rend
    // //
    call ShowUnitHide(udg_Hero_Rend)
    call PauseUnitBJ(true, udg_Hero_Rend)
    // //
    // Orcs
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_IntroOrcsSquad, udg_Player_Actual), function Trig_Intro_Cinematic_SetUp_Func084002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_IntroOrcsSquad), function Trig_Intro_Cinematic_SetUp_Func087A)
    // //
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_SetUp takes nothing returns nothing
    set gg_trg_Intro_Cinematic_SetUp=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_SetUp, function Trig_Intro_Cinematic_SetUp_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Skipped
//===========================================================================
function Trig_Intro_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_IntroCinOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_IntroCinSkipped=true
    set udg_Bool_CinematicSkipped=true
    call StopSoundBJ(gg_snd_Orc2, false)
    call StopSoundBJ(gg_snd_Human1, false)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Intro_Cinematic_Skipped, Condition(function Trig_Intro_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_Skipped, function Trig_Intro_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Cleanup
//===========================================================================
function Trig_Intro_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func050A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", GetEnumUnit())
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.15)
    call SetUnitMoveSpeed(GetEnumUnit(), 270.00)
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
endfunction

function Trig_Intro_Cinematic_Cleanup_Func060002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_Cleanup_Func087C takes nothing returns boolean
    if ( not ( udg_Bool_DoorGuardMove == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func117A takes nothing returns nothing
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", GetEnumUnit())
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.15)
    call SetUnitMoveSpeed(GetEnumUnit(), 270.00)
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
endfunction

function Trig_Intro_Cinematic_Cleanup_Func121Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func121A takes nothing returns nothing
    if ( Trig_Intro_Cinematic_Cleanup_Func121Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Intro_Cinematic_Cleanup_Func125A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_Cleanup_Func127A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_Cleanup_Func144002 takes nothing returns nothing
    call SetUnitAnimation(GetEnumUnit(), "Cinematic Guard One")
endfunction

function Trig_Intro_Cinematic_Cleanup_Func190C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func192002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P1InitialTroops)
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_IntroCinOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    // Cinematic Mode Off
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_GameStart), 0)
    call ConditionalTriggerExecute(gg_trg_Razing_Gate_Open)
    // //
    // SoundsOff
    // //
    call StopSoundBJ(gg_snd_WC2Orc09Rend1, false)
    call StopSoundBJ(gg_snd_WC2Orc09Rend2, false)
    call StopSoundBJ(gg_snd_WC2Orc09Utok1, false)
    call StopSoundBJ(gg_snd_WC2Orc09Utok2, false)
    call StopSoundBJ(gg_snd_WC2Orc09Saidan1, false)
    call StopSoundBJ(gg_snd_WC2Orc09Saidan2, false)
    call StopSoundBJ(gg_snd_WC2Orc09Saidan3, false)
    call StopSoundBJ(gg_snd_WC2Orc09Saidan4, false)
    call StopSoundBJ(gg_snd_WC2Orc09Saidan5, false)
    call StopSoundBJ(gg_snd_WC2Orc09Footman1, false)
    call StopSoundBJ(gg_snd_WC2Orc09Footman2, false)
    call StopSoundBJ(gg_snd_WC2Orc09Footman3, false)
    call StopSoundBJ(gg_snd_WC2Orc09Mage1, false)
    call StopSoundBJ(gg_snd_WC2Orc09Mage2, false)
    // //
    // Resetting actors
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call RemoveLocation(udg_Point_CinRendTempLoc)
    // //
    // Ship
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60Q_0388, GetRectCenter(gg_rct_IntroOrcShipArriva02), GetRectCenter(gg_rct_Rend01Cin))
    // //
    // Utok
    call ShowUnitShow(udg_SemiHero_Utok)
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    call SetUnitPositionLocFacingLocBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_UtokStart), GetRectCenter(gg_rct_BlackhandStart))
    call SetUnitOwner(udg_SemiHero_Utok, udg_Player_Actual, false)
    // Rend
    // //
    call ShowUnitShow(udg_Hero_Rend)
    call PauseUnitBJ(false, udg_Hero_Rend)
    call SetUnitPositionLocFacingLocBJ(udg_Hero_Rend, GetRectCenter(gg_rct_BlackhandStart), GetRectCenter(gg_rct_Grunt03Cin))
    call SetUnitOwner(udg_Hero_Rend, udg_Player_Actual, false)
    // //
    // Orcs
    call ForGroupBJ(udg_Group_IntroOrcsSquad, function Trig_Intro_Cinematic_Cleanup_Func050A)
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60G_0432, GetRectCenter(gg_rct_Grunt02Cin), GetRectCenter(gg_rct_BlackhandStart))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60G_0433, GetRectCenter(gg_rct_Grunt01Cin), GetRectCenter(gg_rct_BlackhandStart))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60G_0008, GetRectCenter(gg_rct_Grunt03Cin), GetRectCenter(gg_rct_BlackhandStart))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60G_0005, GetRectCenter(gg_rct_Grunt05Cin), GetRectCenter(gg_rct_BlackhandStart))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60G_0132, GetRectCenter(gg_rct_Grunt04Cin), GetRectCenter(gg_rct_BlackhandStart))
    // //
    // Resetting actors
    // //
    // Creeps
    call ForGroupBJ(udg_Group_HiddenCreeps, function Trig_Intro_Cinematic_Cleanup_Func060002)
    call ShowUnitShow(gg_unit_nsqe_0471)
    // //
    // Peasant
    // //
    call ResetUnitLookAt(udg_Hero_SaidanDathrohan)
    call ResetUnitLookAt(udg_Unit_CinematicCaptain)
    call ResetUnitLookAt(udg_Hero_MageBoss)
    call ResetUnitAnimation(gg_unit_nvil_0382)
    call ResetUnitAnimation(gg_unit_hfSt_0258)
    call RemoveUnit(gg_unit_hPSt_0377)
    // //
    // Ships
    // //
    call RemoveUnit(udg_Unit_IntroTransportShip)
    call RemoveUnit(gg_unit_h60P_0321)
    // //
    // Footman
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Unit_CinematicCaptain, GetRectCenter(gg_rct_IntroFootmanStartZone), GetRectCenter(gg_rct_IntroFirePit))
    call SetUnitBlendTimeBJ(udg_Unit_CinematicCaptain, 0.15)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Unit_CinematicCaptain)
    call BlzSetUnitRealFieldBJ(udg_Unit_CinematicCaptain, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call SetUnitMoveSpeed(udg_Unit_CinematicCaptain, GetUnitDefaultMoveSpeed(udg_Unit_CinematicCaptain))
    call BlzSetUnitRealFieldBJ(gg_unit_hfSt_0258, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call SetUnitMoveSpeed(gg_unit_hfSt_0258, GetUnitDefaultMoveSpeed(udg_Unit_CinematicCaptain))
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func087C() ) then
        set udg_Bool_DoorGuardMove=true
        call SetUnitPositionLocFacingBJ(gg_unit_hfSt_0258, GetRectCenter(gg_rct_IntroDoorGuardMove01), 207.80)
    else
    endif
    // //
    // Saidan
    // //
    call ShowUnitShow(udg_Hero_SaidanDathrohan)
    call PauseUnitBJ(false, udg_Hero_SaidanDathrohan)
    call SelectHeroSkill(udg_Hero_SaidanDathrohan, 'APRA')
    call SelectHeroSkill(udg_Hero_SaidanDathrohan, 'APRA')
    // //
    // Mage
    // //
    call RemoveUnit(gg_unit_e001_0443)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Hero_MageBoss, GetRectCenter(gg_rct_ArchMage), GetRectCenter(gg_rct_IntroMageTalks))
    call ShowUnitShow(udg_Hero_MageBoss)
    call PauseUnitBJ(false, udg_Hero_MageBoss)
    call SetUnitPathing(udg_Hero_MageBoss, true)
    call SetUnitInvulnerable(udg_Hero_MageBoss, true)
    // //
    call CreateDestructableLoc('YTpb', GetRectCenter(gg_rct_TowerPathBlock01), GetRandomDirectionDeg(), 1, 0)
    call CreateDestructableLoc('YTpb', GetRectCenter(gg_rct_TowerPathBlock02), GetRandomDirectionDeg(), 1, 0)
    // //
    // Orcs
    // //
    call SetUnitScalePercent(gg_unit_o60Q_0388, 120.00, 120.00, 120.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_o60G_0005)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_o60G_0008)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_o60G_0132)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_o60G_0432)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_o60G_0433)
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_IntroOrcsSquad), function Trig_Intro_Cinematic_Cleanup_Func117A)
    // //
    // Blockers
    // //
    call EnumDestructablesInRectAll(gg_rct_IntroBlockers, function Trig_Intro_Cinematic_Cleanup_Func121A)
    // //
    // Make Island Defenders Hidden
    // //
    call ForGroupBJ(udg_Group_TyrsBayBallistas, function Trig_Intro_Cinematic_Cleanup_Func125A)
    // //
    call ForGroupBJ(udg_Group_TyrsBayRangers, function Trig_Intro_Cinematic_Cleanup_Func127A)
    // //
    // Drunkard
    // //
    call SetUnitAnimation(gg_unit_nvil_0230, "death")
    call BlzSetUnitName(gg_unit_nvil_0230, GetItemName(gg_item_IQL3_0617))
    // //
    // Clerics
    // //
    call SetUnitAnimation(gg_unit_h627_0303, "cinematic pray one")
    call SetUnitAnimation(gg_unit_h627_0302, "cinematic pray one")
    call SetUnitAnimation(gg_unit_h627_0301, "cinematic pray two")
    call SetUnitAnimation(gg_unit_h627_0304, "cinematic pray two")
    // //
    // Defenders
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(9), 'h006'), function Trig_Intro_Cinematic_Cleanup_Func144002)
    call SetUnitAnimation(gg_unit_h623_0269, "Cinematic Sitting One")
    call SetUnitAnimation(gg_unit_h623_0143, "Cinematic Standard One")
    call SetUnitAnimation(gg_unit_h623_0144, "Cinematic Standard One")
    call SetUnitAnimation(gg_unit_h623_0171, "Cinematic Kneeling One")
    // //
    // Doodads
    // //
    call SetDoodadAnimationRectBJ("death", 'D003', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("death", 'D6D8', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("death", 'D6D9', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("death", 'D6DA', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("death", 'D6DB', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("death", 'D6DC', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("death", 'D6DD', gg_rct_ElvenAmbush)
    // //
    // OgreScene
    // //
    call SetUnitColor(gg_unit_n002_0131, PLAYER_COLOR_NAVY)
    call SetUnitAnimation(gg_unit_n002_0131, "stand ready")
    call SetUnitAnimation(gg_unit_hKSt_0488, "stand ready")
    call SetUnitAnimation(gg_unit_hfSt_0470, "stand ready")
    call SetUnitAnimation(gg_unit_hfSt_0225, "stand ready")
    call SetUnitAnimation(gg_unit_hKSt_0505, "stand ready")
    call SetUnitAnimation(gg_unit_hKSt_0504, "stand ready")
    call SetUnitAnimation(gg_unit_hSSt_0507, "stand ready")
    call SetUnitAnimation(gg_unit_hSSt_0510, "stand ready")
    call SetUnitAnimation(gg_unit_hSSt_0506, "stand ready")
    call SetUnitAnimation(gg_unit_hfSt_0502, "stand ready")
    call SetUnitAnimation(gg_unit_hfSt_0503, "stand ready")
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n001', Player(13), GetRectCenter(gg_rct_OgreCorpse01), 300.00)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'n001', Player(13), GetRectCenter(gg_rct_OgreCorpse02), 250.00)
    // //
    // Random
    // //
    call SetUnitAnimation(gg_unit_hfSt_0322, "cinematic sitting one")
    // //
    // Cinematic Mode Off
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call ConditionalTriggerExecute(gg_trg_Creating_and_Setting_Weather)
    call TriggerExecute(gg_trg_VisibilityCircleAOn)
    // //
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func190C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Intro_Cinematic_Cleanup_Func192002)
    call SelectGroupForPlayerBJ(udg_Group_P1InitialTroops, udg_Player_Actual)
    // //
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Camp_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

