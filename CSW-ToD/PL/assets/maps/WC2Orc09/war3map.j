    if ( not ( GetResearched() == 'RBOo' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('RBOo', udg_Player_Actual) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilReturnForResearchBO_Actions takes nothing returns nothing
    call playerAddOil(Player(0) , 1000)
endfunction

//===========================================================================
function InitTrig_OilReturnForResearchBO takes nothing returns nothing
    set gg_trg_OilReturnForResearchBO=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilReturnForResearchBO, Player(0), EVENT_PLAYER_UNIT_RESEARCH_CANCEL)
    call TriggerAddCondition(gg_trg_OilReturnForResearchBO, Condition(function Trig_OilReturnForResearchBO_Conditions))
    call TriggerAddAction(gg_trg_OilReturnForResearchBO, function Trig_OilReturnForResearchBO_Actions)
endfunction

//===========================================================================
// Trigger: OilSpentForResearchZR
//===========================================================================
function Trig_OilSpentForResearchZR_Conditions takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('RZeR', udg_Player_Actual) == 0 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetOrderedUnit()) == 'o000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForResearchZR_Actions takes nothing returns nothing
    local sound OrcUI_InsufficientOill
    local string Sound_Path= "Sound\\Interface\\Warning\\Orc\\GruntNoOil1.mp3"
    // -------------------------------------
    // Check the Order to research the cannons
    if ( ( GetIssuedOrderId() == 1381655890 ) ) then
    // Check the amount of Oil for Player
    if (OilHarvest__playerOil[GetPlayerId((Player(0)))]) < 2500 then // INLINED!!
    // // UI Warning
    set OrcUI_InsufficientOill=CreateSound(Sound_Path, false, false, false, 1, 1, "DefaultEAXON")
    call SetSoundParamsFromLabel(OrcUI_InsufficientOill, "User Interface")
    call SetSoundVolume(OrcUI_InsufficientOill, 127)
    call SetSoundPitch(OrcUI_InsufficientOill, 1.0)
    call StartSound(OrcUI_InsufficientOill)
    call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3568")
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(0) , - 2500)
    else
    // need to decrease the oil if there was enough of it and the train/upgrade started
    call playerAddOil(Player(0) , - 2500)
    endif
    endif
    // // leak cleaner
    call KillSoundWhenDone(OrcUI_InsufficientOill)
    set OrcUI_InsufficientOill=null
endfunction

//===========================================================================
function InitTrig_OilSpentForResearchZR takes nothing returns nothing
    set gg_trg_OilSpentForResearchZR=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilSpentForResearchZR, Player(0), EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerAddCondition(gg_trg_OilSpentForResearchZR, Condition(function Trig_OilSpentForResearchZR_Conditions))
