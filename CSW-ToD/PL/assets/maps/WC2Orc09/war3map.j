//===========================================================================
// Trigger: Razing Gate Open
//===========================================================================
function Trig_Razing_Gate_Open_Conditions takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(gg_dest_B61J_3805) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Razing_Gate_Open_Func018Func001Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Razing_Gate_Open_Func018Func001A takes nothing returns nothing
    if ( Trig_Razing_Gate_Open_Func018Func001Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Razing_Gate_Open_Actions takes nothing returns nothing
    set udg_Bool_IslandGateIsOpened=true
    // //
    call SetDestructableInvulnerableBJ(gg_dest_DTlv_5043, false)
    call KillDestructable(gg_dest_DTlv_5043)
    // //
    set udg_Point_GateRazing=GetRectCenter(gg_rct_TyrsGateDeathKillBlocker)
    call PlaySoundAtPointBJ(gg_snd_LargeCityGateOpen1, 50.00, udg_Point_GateRazing, 100.00)
    call RemoveLocation(udg_Point_GateRazing)
    // //
    call SetDestructableAnimationBJ(gg_dest_B61J_3805, "morph")
    set udg_Point_GateRazing=GetRectCenter(gg_rct_IntroMagePassesTheGate)
    call PlaySoundAtPointBJ(gg_snd_GateOpen, 50.00, udg_Point_GateRazing, 100.00)
    call RemoveLocation(udg_Point_GateRazing)
    // //
    call PolledWait(2)
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=9
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call EnumDestructablesInRectAll(udg_TyrsKeepGateBlockers[GetForLoopIndexB()], function Trig_Razing_Gate_Open_Func018Func001A)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    call SetDestructableAnimationBJ(gg_dest_B61J_3805, "stand alternate")
    // //
    call EnableTrigger(gg_trg_Razing_Gate_Attacked_By_Catapult)
    // //
endfunction

//===========================================================================
function InitTrig_Razing_Gate_Open takes nothing returns nothing
    set gg_trg_Razing_Gate_Open=CreateTrigger()
    call TriggerAddCondition(gg_trg_Razing_Gate_Open, Condition(function Trig_Razing_Gate_Open_Conditions))
    call TriggerAddAction(gg_trg_Razing_Gate_Open, function Trig_Razing_Gate_Open_Actions)
endfunction

//===========================================================================
// Trigger: Razing Gate Close
//===========================================================================
function Trig_Razing_Gate_Close_Conditions takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(gg_dest_B61J_3805) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Razing_Gate_Close_Actions takes nothing returns nothing
    set udg_Bool_IslandGateIsOpened=false
    // //
    call DestructableRestoreLife(gg_dest_DTlv_5043, 500.00, true)
    call SetDestructableInvulnerableBJ(gg_dest_DTlv_5043, true)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=9
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Point_GateRazing=GetRectCenter(udg_TyrsKeepGateBlockers[GetForLoopIndexA()])
        call CreateDestructableLoc('YTpb', udg_Point_GateRazing, bj_UNIT_FACING, 1, 0)
        call RemoveLocation(udg_Point_GateRazing)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call SetDestructableAnimationBJ(gg_dest_B61J_3805, "morph alternate")
    call PolledWait(2)
    call SetDestructableAnimationBJ(gg_dest_B61J_3805, "stand")
endfunction

