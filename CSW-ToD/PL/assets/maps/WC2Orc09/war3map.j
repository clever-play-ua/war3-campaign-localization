// Trigger: GenericCinematicSetup
//===========================================================================
function Trig_GenericCinematicSetup_Func011A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P01Selection)
endfunction

function Trig_GenericCinematicSetup_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // Save Current Camera and Current Selection
    set udg_VarCurrentCamera=GetCurrentCameraSetup()
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    // //
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, true)
    call BlzUnitDisableAbility(udg_Hero_SaidanDathrohan, 'APRA', true, true)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_GenericCinematicSetup_Func011A)
    // //
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
endfunction

