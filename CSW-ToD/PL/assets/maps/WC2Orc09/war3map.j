function Trig_Final_Cinematic_Q_Func212Func001Func002C takes nothing returns boolean
    if ( ( GetPlayerRace(GetOwningPlayer(GetEnumUnit())) == RACE_HUMAN ) ) then
        return true
    endif
    if ( ( GetPlayerRace(GetOwningPlayer(GetEnumUnit())) == RACE_NIGHTELF ) ) then
        return true
    endif
    return false
