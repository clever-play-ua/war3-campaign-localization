        return false
    endif
    return true
endfunction

function Trig_StanceAnimationOn_Actions takes nothing returns nothing
    set udg_ValdemarCastingUnit=GetSpellAbilityUnit()
    call SetUnitAnimation(udg_ValdemarCastingUnit, "stand defend")
    call TriggerSleepAction(61.00)
    if ( Trig_StanceAnimationOn_Func004C() ) then
        call SetUnitAnimation(udg_ValdemarCastingUnit, "stand victory")
        call TriggerSleepAction(2.90)
        call ResetUnitAnimation(udg_ValdemarCastingUnit)
    else
    endif
endfunction

