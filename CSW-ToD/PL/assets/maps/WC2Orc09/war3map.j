//===========================================================================
// Trigger: Navy Caravan Destroyed
//===========================================================================
function Trig_Navy_Caravan_Destroyed_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetDyingUnit(), udg_Group_Caravan) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_MQNavy) == false ) ) then
        return false
    endif
    if ( not ( IsQuestFailed(udg_MQNavy) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Caravan_Destroyed_Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'h60P' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Caravan_Destroyed_Actions takes nothing returns nothing
    call GroupRemoveUnitSimple(GetDyingUnit(), udg_Group_Caravan)
    // //
    if ( Trig_Navy_Caravan_Destroyed_Func003C() ) then
        call PlaySoundBJ(gg_snd_GoodJob)
        call DestroyMinimapIcon(udg_MinimapIcon_Caravan)
        // //
        call LeaderboardSetLabelBJ(udg_Leaderboard_Navy, ( BlzGetItemDescription(gg_item_IQL3_0617) + ( I2S(udg_Int_CaravansAllowedToFlee) + BlzGetItemDescription(gg_item_IQL1_0614) ) ))
        // //
        call TimerDialogDisplayForPlayerBJ(true, udg_TimerWindow_Caravan, udg_Player_Actual)
        call StartTimerBJ(udg_Timer_CaravanPause, false, udg_Real_CaravanPreparation)
        set udg_Bool_CaravanIsBeingSent=false
    else
    endif
    // //
endfunction

//===========================================================================
function InitTrig_Navy_Caravan_Destroyed takes nothing returns nothing
    set gg_trg_Navy_Caravan_Destroyed=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Navy_Caravan_Destroyed, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Navy_Caravan_Destroyed, Condition(function Trig_Navy_Caravan_Destroyed_Conditions))
    call TriggerAddAction(gg_trg_Navy_Caravan_Destroyed, function Trig_Navy_Caravan_Destroyed_Actions)
endfunction

//===========================================================================
// Trigger: Navy Caravan LeftBay
//===========================================================================
function Trig_Navy_Caravan_LeftBay_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnteringUnit(), udg_Group_Caravan) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Caravan_LeftBay_Func002Func012C takes nothing returns boolean
    if ( not ( udg_Int_CaravansFled > ( udg_Int_CaravansAllowedToFlee - 2 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Caravan_LeftBay_Func002C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnteringUnit(), udg_Group_Caravan) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) == 'h60P' ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_MQNavy) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Caravan_LeftBay_Actions takes nothing returns nothing
    // //
    if ( Trig_Navy_Caravan_LeftBay_Func002C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_WARNING, "TRIGSTR_2814")
        call DestroyMinimapIcon(udg_MinimapIcon_Caravan)
        // //
        call LeaderboardSetLabelBJ(udg_Leaderboard_Navy, ( BlzGetItemDescription(gg_item_IQL3_0617) + ( I2S(udg_Int_CaravansAllowedToFlee) + BlzGetItemDescription(gg_item_IQL1_0614) ) ))
        // //
        call TimerDialogDisplayForPlayerBJ(true, udg_TimerWindow_Caravan, udg_Player_Actual)
        call StartTimerBJ(udg_Timer_CaravanPause, false, udg_Real_CaravanPreparation)
        set udg_Int_CaravansFled=( udg_Int_CaravansFled + 1 )
        set udg_Bool_CaravanIsBeingSent=false
        call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_Navy, udg_Int_CaravansFled)
        if ( Trig_Navy_Caravan_LeftBay_Func002Func012C() ) then
            call LeaderboardSetPlayerItemValueColorBJ(Player(0), udg_Leaderboard_Navy, 100, 0.00, 0.00, 0)
        else
        endif
        call ConditionalTriggerExecute(gg_trg_Navy_CaravanFled_Defeat)
    else
    endif
    // //
    call GroupRemoveUnitSimple(GetEnteringUnit(), udg_Group_Caravan)
    call RemoveUnit(GetEnteringUnit())
    // //
endfunction

//===========================================================================
function InitTrig_Navy_Caravan_LeftBay takes nothing returns nothing
    set gg_trg_Navy_Caravan_LeftBay=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Navy_Caravan_LeftBay, gg_rct_CaravanOut)
    call TriggerAddCondition(gg_trg_Navy_Caravan_LeftBay, Condition(function Trig_Navy_Caravan_LeftBay_Conditions))
    call TriggerAddAction(gg_trg_Navy_Caravan_LeftBay, function Trig_Navy_Caravan_LeftBay_Actions)
endfunction

//===========================================================================
// Trigger: Navy Caravan1 Wave
//===========================================================================
function Trig_Navy_Caravan1_Wave_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQNavy) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Caravan1_Wave_Func007Func038002 takes nothing returns nothing
    call SetUnitMoveSpeed(GetEnumUnit(), udg_Real_CaravanSpeed)
endfunction

function Trig_Navy_Caravan1_Wave_Func007C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_h60X_0380) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(gg_unit_h60X_0379) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(gg_unit_h60X_0378) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Caravan1_Wave_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_WARNING, "TRIGSTR_3603")
    // //
    call TimerDialogDisplayForPlayerBJ(false, udg_TimerWindow_Caravan, Player(0))
    // //
    if ( Trig_Navy_Caravan1_Wave_Func007C() ) then
        call DoNothing()
    else
        call PlaySoundBJ(gg_snd_Warning)
        set udg_Bool_CaravanIsBeingSent=true
        // //
        call LeaderboardSetLabelBJ(udg_Leaderboard_Navy, "TRIGSTR_3526")
        call LeaderboardDisplayBJ(true, udg_Leaderboard_CaravanMessage)
        // //
        call ConditionalTriggerExecute(gg_trg_Navy_Caravan1_FarmA)
        call ConditionalTriggerExecute(gg_trg_Navy_Caravan1_FarmB)
        // //
        call CreateNUnitsAtLoc(1, 'e60C', udg_Player_Caravan, udg_Point_CaravanEscort[1], bj_UNIT_FACING)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_Caravan)
        call SetUnitMoveSpeed(GetLastCreatedUnit(), udg_Real_CaravanSpeed)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_CaravanExit)
        call UnitShareVisionBJ(true, GetLastCreatedUnit(), udg_Player_Actual)
        call PolledWait(2)
        // //
        call ConditionalTriggerExecute(gg_trg_Navy_Caravan1_Transport)
        call TriggerSleepAction(0.10)
        // //
        call GroupAddUnitSimple(udg_Unit_CaravanTransportArr[1], udg_Group_Caravan)
        call RemoveGuardPosition(udg_Unit_CaravanTransportArr[1])
        call SetUnitMoveSpeed(udg_Unit_CaravanTransportArr[1], udg_Real_CaravanSpeed)
        call IssuePointOrderLocBJ(udg_Unit_CaravanTransportArr[1], "move", udg_Point_CaravanExit)
        call UnitShareVisionBJ(true, udg_Unit_CaravanTransportArr[1], udg_Player_Actual)
        // //
        call CampaignMinimapIconUnitBJ(udg_Unit_CaravanTransportArr[1], bj_CAMPPINGSTYLE_BONUS)
        set udg_MinimapIcon_Caravan=GetLastCreatedMinimapIcon()
        call PolledWait(1.50)
        // //
        call CreateNUnitsAtLoc(1, 'e60C', udg_Player_Caravan, udg_Point_CaravanEscort[1], bj_UNIT_FACING)
        call RemoveGuardPosition(GetLastCreatedUnit())
        call SetUnitMoveSpeed(GetLastCreatedUnit(), udg_Real_CaravanSpeed)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_Caravan)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_CaravanExit)
        call UnitShareVisionBJ(true, GetLastCreatedUnit(), udg_Player_Actual)
        // //
        call ForGroupBJ(udg_Group_Caravan, function Trig_Navy_Caravan1_Wave_Func007Func038002)
        call SetUnitMoveSpeed(udg_Unit_CaravanTransportArr[1], udg_Real_CaravanSpeed)
        // //
        set udg_Point_CaravanPing=GetUnitLoc(udg_Unit_CaravanTransportArr[1])
        call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, udg_Point_CaravanPing, 2.00)
        call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, udg_Point_CaravanPing)
        call RemoveLocation(udg_Point_CaravanPing)
        // //
        call EnableTrigger(gg_trg_Navy_Caravan2_Wave)
        call EnableTrigger(gg_trg_Navy_Caravan1_Transport)
    endif
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Navy_Caravan1_Wave takes nothing returns nothing
    set gg_trg_Navy_Caravan1_Wave=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Navy_Caravan1_Wave, udg_Timer_CaravanPause)
    call TriggerAddCondition(gg_trg_Navy_Caravan1_Wave, Condition(function Trig_Navy_Caravan1_Wave_Conditions))
    call TriggerAddAction(gg_trg_Navy_Caravan1_Wave, function Trig_Navy_Caravan1_Wave_Actions)
endfunction

