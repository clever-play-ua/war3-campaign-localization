function Trig_Rend_I_Rend_Func006Func001C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    if ( not ( IsDestructableInvulnerableBJ(GetEnumDestructable()) == false ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'YTlb' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'Ytlc' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'YTab' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'YTac' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'YTfb' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'YTfc' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'BD07' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'YTpb' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'YTpc' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'OTip' ) ) then
        return false
    endif
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) != 'OTis' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rend_I_Rend_Func006A takes nothing returns nothing
    if ( Trig_Rend_I_Rend_Func006Func001C() ) then
        if ( Trig_Rend_I_Rend_Func006Func001Func014C() ) then
            call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 100.00 ))
        else
            if ( Trig_Rend_I_Rend_Func006Func001Func014Func002C() ) then
                call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 150.00 ))
            else
                if ( Trig_Rend_I_Rend_Func006Func001Func014Func002Func002C() ) then
                    call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 200.00 ))
                else
                endif
            endif
        endif
    else
    endif
endfunction

function Trig_Rend_I_Rend_Actions takes nothing returns nothing
    set udg_Rend_TempPoint_Q=GetSpellTargetLoc()
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(250.00, udg_Rend_TempPoint_Q, Condition(function Trig_Rend_I_Rend_Func004001003)), function Trig_Rend_I_Rend_Func004A)
    //  
    call EnumDestructablesInCircleBJ(250.00, udg_Rend_TempPoint_Q, function Trig_Rend_I_Rend_Func006A)
    //  
    call RemoveLocation(udg_Rend_TempPoint_Q)
endfunction

