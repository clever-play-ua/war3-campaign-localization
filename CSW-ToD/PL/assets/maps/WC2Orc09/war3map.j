    set gg_trg_RiverFreeze_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_RiverFreeze_Cinematic_Q, function Trig_RiverFreeze_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: RiverFreeze Cinematic SetUp
//===========================================================================
function Trig_RiverFreeze_Cinematic_SetUp_Func019A takes nothing returns nothing
    call UnitShareVisionBJ(true, GetEnumUnit(), udg_Player18_Stromgarde_Ground)
endfunction

function Trig_RiverFreeze_Cinematic_SetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    call ShowUnitHide(udg_Hero_MageBoss)
    call PauseUnitBJ(true, udg_Hero_MageBoss)
    // //
    call ShowUnitHide(udg_Hero_SaidanDathrohan)
    call PauseUnitBJ(true, udg_Hero_SaidanDathrohan)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_Fake_Saidan, GetRectCenter(gg_rct_Capitan), GetRectCenter(gg_rct_ArchMage))
    call ShowUnitShow(udg_Fake_Saidan)
    // ----------
    call SetUnitPositionLocFacingLocBJ(udg_Fake_Archmage, GetRectCenter(gg_rct_ArchMage), GetRectCenter(gg_rct_Capitan))
    call ShowUnitShow(udg_Fake_Archmage)
    // ----------
    call SetUnitPositionLocFacingBJ(gg_unit_hfSt_0258, GetRectCenter(gg_rct_IntroDoorGuardMove01_Copy), 294.18)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_TyrsKeepQuestUnitCheck, udg_Player18_Stromgarde_Ground), function Trig_RiverFreeze_Cinematic_SetUp_Func019A)
    // //
endfunction

