function Trig_RiverFreeze_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_SeaFrozenCinOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_RiverFreeze_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_SeaFrozenCinSkipped=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_RiverFreeze_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_RiverFreeze_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_RiverFreeze_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_RiverFreeze_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_RiverFreeze_Cinematic_Skipped, Condition(function Trig_RiverFreeze_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_RiverFreeze_Cinematic_Skipped, function Trig_RiverFreeze_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: RiverFreeze Cinematic Cleanup
//===========================================================================
function Trig_RiverFreeze_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_RiverFreeze_Cinematic_Cleanup_Func006A takes nothing returns nothing
    call UnitShareVisionBJ(false, GetEnumUnit(), udg_Player18_Stromgarde_Ground)
endfunction

function Trig_RiverFreeze_Cinematic_Cleanup_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_SeaFrozenCinSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_RiverFreeze_Cinematic_Cleanup_Func023C takes nothing returns boolean
    if ( not ( udg_Bool_SeaFrozenCinSkipped == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_BlizzardStarted == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_RiverFreeze_Cinematic_Cleanup_Func030C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_RiverFreeze_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_SeaFrozenCinOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_RiverFreeze_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_TyrsKeepQuestUnitCheck, udg_Player18_Stromgarde_Ground), function Trig_RiverFreeze_Cinematic_Cleanup_Func006A)
    if ( Trig_RiverFreeze_Cinematic_Cleanup_Func007C() ) then
        call SetUnitPositionLocFacingBJ(udg_Hero_MageBoss, GetRectCenter(gg_rct_CircleOfPower), bj_UNIT_FACING)
        call SetUnitAnimation(udg_Hero_MageBoss, "stand channel")
        call SetDoodadAnimationRectBJ("stand", 'D6CF', gg_rct_TyrsQuest)
        call AddSpecialEffectTargetUnitBJ("origin", udg_Hero_MageBoss, "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl")
        set udg_SE_MageFrostAura=GetLastCreatedEffectBJ()
        // SoundsOff
        call StopSoundBJ(gg_snd_HumanDefeat, false)
        call StopSoundBJ(gg_snd_WC2Orc09Saidan6, false)
        call StopSoundBJ(gg_snd_WC2Orc09Saidan7, false)
        call StopSoundBJ(gg_snd_WC2Orc09Mage3, false)
        call StopSoundBJ(gg_snd_WC2Orc09Mage4, false)
        // //
    else
    endif
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call ShowUnitShow(udg_Hero_MageBoss)
    call PauseUnitBJ(false, udg_Hero_MageBoss)
    call SetUnitInvulnerable(udg_Hero_MageBoss, false)
    call SetUnitPositionLoc(udg_Hero_MageBoss, GetRectCenter(gg_rct_CircleOfPower))
    // //
    call ShowUnitShow(udg_Hero_SaidanDathrohan)
    call PauseUnitBJ(false, udg_Hero_SaidanDathrohan)
    // //
    // Prepare units for first attack waves
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=2
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        // //
        set udg_Point_RazingTempCreateUnits=GetRandomLocInRect(gg_rct_RedirectionPoint)
        call CreateNUnitsAtLoc(1, 'h007', udg_Player18_Stromgarde_Ground, udg_Point_RazingTempCreateUnits, bj_UNIT_FACING)
        call RemoveLocation(udg_Point_RazingTempCreateUnits)
        // //
        set udg_Point_RazingTempCreateUnits=GetRandomLocInRect(gg_rct_RedirectionPoint)
        call CreateNUnitsAtLoc(1, 'h00A', udg_Player18_Stromgarde_Ground, udg_Point_RazingTempCreateUnits, bj_UNIT_FACING)
        call RemoveLocation(udg_Point_RazingTempCreateUnits)
        // //
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=2
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        // //
        set udg_Point_RazingTempCreateUnits=GetRandomLocInRect(gg_rct_RedirectionPoint)
        call CreateNUnitsAtLoc(1, 'h008', udg_Player18_Stromgarde_Ground, udg_Point_RazingTempCreateUnits, bj_UNIT_FACING)
        call RemoveLocation(udg_Point_RazingTempCreateUnits)
        // //
        set udg_Point_RazingTempCreateUnits=GetRandomLocInRect(gg_rct_RedirectionPoint)
        call CreateNUnitsAtLoc(1, 'e002', udg_Player18_Stromgarde_Ground, udg_Point_RazingTempCreateUnits, bj_UNIT_FACING)
        call RemoveLocation(udg_Point_RazingTempCreateUnits)
        // //
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    if ( Trig_RiverFreeze_Cinematic_Cleanup_Func023C() ) then
        call ConditionalTriggerExecute(gg_trg_Blizzard_Start)
    else
    endif
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_OrcCamp), 0)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call CinematicModeBJ(false, GetPlayersAll())
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_RiverFreeze_Cinematic_Cleanup_Func030C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_RiverFreeze_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Razing_Discover)
endfunction

//===========================================================================
function InitTrig_RiverFreeze_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_RiverFreeze_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_RiverFreeze_Cinematic_Cleanup, function Trig_RiverFreeze_Cinematic_Cleanup_Actions)
endfunction

