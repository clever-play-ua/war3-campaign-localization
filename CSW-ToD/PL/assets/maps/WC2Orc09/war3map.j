    if ( not Trig_WallSegmentDeath01_Func005Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_WallSegmentDeath01_Func005A takes nothing returns nothing
    if ( Trig_WallSegmentDeath01_Func005Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_WallSegmentDeath01_Func007C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(gg_dest_B60A_1038) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_WallSegmentDeath01_Func008C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(gg_dest_B60A_1069) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_WallSegmentDeath01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Point_DyingDestructableTemp=GetDestructableLoc(GetDyingDestructable())
    call EnumDestructablesInRectAll(RectFromCenterSizeBJ(udg_Point_DyingDestructableTemp, 350.00, 350.00), function Trig_WallSegmentDeath01_Func004A)
    call EnumDestructablesInRectAll(RectFromCenterSizeBJ(udg_Point_DyingDestructableTemp, 350.00, 350.00), function Trig_WallSegmentDeath01_Func005A)
    // CheckNeighborWall
    if ( Trig_WallSegmentDeath01_Func007C() ) then
        set bj_forLoopBIndex=1
        set bj_forLoopBIndexEnd=3
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call CreateDestructableLoc('YTpb', GetRectCenter(udg_TyrsKeepWallBlockers[GetForLoopIndexB()]), bj_UNIT_FACING, 1, 0)
            set bj_forLoopBIndex=bj_forLoopBIndex + 1
        endloop
    else
    endif
    if ( Trig_WallSegmentDeath01_Func008C() ) then
        set bj_forLoopBIndex=4
        set bj_forLoopBIndexEnd=6
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call CreateDestructableLoc('YTpb', GetRectCenter(udg_TyrsKeepWallBlockers[GetForLoopIndexB()]), bj_UNIT_FACING, 1, 0)
            set bj_forLoopBIndex=bj_forLoopBIndex + 1
        endloop
    else
    endif
    // //
    call RemoveLocation(udg_Point_DyingDestructableTemp)
    // //
endfunction

