function Trig_TyrsKeep_Cinematic_Cleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_TyrsHandCinOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_TyrsKeep_Cinematic_Cleanup_Func004C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // /////
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // /////
    call CreateNUnitsAtLoc(1, 'H00G', Player(12), GetRectCenter(gg_rct_Veldemar01), 317.82)
    set udg_Hero_Valdemar=GetLastCreatedUnit()
    call SetHeroLevelBJ(udg_Hero_Valdemar, 10, false)
    // ----------
    call SelectHeroSkill(udg_Hero_Valdemar, 'AEme')
    call SelectHeroSkill(udg_Hero_Valdemar, 'A62M')
    call SelectHeroSkill(udg_Hero_Valdemar, 'A62M')
    call SelectHeroSkill(udg_Hero_Valdemar, 'A62M')
    call SelectHeroSkill(udg_Hero_Valdemar, 'AOws')
    call SelectHeroSkill(udg_Hero_Valdemar, 'AOws')
    call SelectHeroSkill(udg_Hero_Valdemar, 'AOws')
    call SelectHeroSkill(udg_Hero_Valdemar, 'AHbh')
    call SelectHeroSkill(udg_Hero_Valdemar, 'AHbh')
    call SelectHeroSkill(udg_Hero_Valdemar, 'AHbh')
    // ----------
    call UnitAddItemByIdSwapped('shhn', udg_Hero_Valdemar)
    call UnitAddItemByIdSwapped('hbth', udg_Hero_Valdemar)
    // ----------
    call ShowUnitShow(gg_unit_ndog_0219)
    // /////
    // /////
    call SetUnitOwner(udg_Hero_Valdemar, udg_Player_Silverhand, false)
    // /////
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveUnit(udg_Unit_CinGuardReinforcementArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // /////
    call KillDestructable(gg_dest_B60A_1051)
    call KillDestructable(gg_dest_B60A_1052)
    call KillDestructable(gg_dest_B60A_1053)
    call KillDestructable(gg_dest_B60A_1055)
    call KillDestructable(gg_dest_B60A_1054)
    call KillDestructable(gg_dest_B60M_1079)
    call KillDestructable(gg_dest_B61J_3805)
    call RemoveDestructable(gg_dest_RW01_1074)
    // /////
    call RemoveUnit(udg_Unit_TyrsHandCinDefender)
    call RemoveUnit(udg_TyrUnit18)
    // /////
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player18_Stromgarde_Ground, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player18_Stromgarde_Ground, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Silverhand, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Silverhand, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Silverhand, udg_Player_BTGCinematic, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_Silverhand, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player18_Stromgarde_Ground, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player18_Stromgarde_Ground, udg_Player_BTGCinematic, bj_ALLIANCE_UNALLIED)
    call SetPlayerUnitAvailableBJ('h60M', false, udg_Player18_Stromgarde_Ground)
    // /////
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player03_Stromgarde_Keep, 'h60M'), function Trig_TyrsKeep_Cinematic_Cleanup_Func059002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player18_Stromgarde_Ground, 'h60M'), function Trig_TyrsKeep_Cinematic_Cleanup_Func061002)
    // /////
    // /////
    if ( Trig_TyrsKeep_Cinematic_Cleanup_Func064C() ) then
        call ConditionalTriggerExecute(gg_trg_Hold_Gate_Down)
        // SoundsOff
        call StopSoundBJ(gg_snd_HumanX1, false)
        call StopSoundBJ(gg_snd_WC2Orc09Valdelmar1, false)
        call StopSoundBJ(gg_snd_WC2Orc09Valdelmar2, false)
        call StopSoundBJ(gg_snd_WC2Orc09Valdelmar3, false)
        call StopSoundBJ(gg_snd_WC2Orc09Saidan9, false)
        call StopSoundBJ(gg_snd_WC2Orc09Saidan10, false)
        call StopSoundBJ(gg_snd_WC2Orc09Saidan11, false)
        // //
    else
    endif
    // /////
    // /////
    // manage the players units
    // /////
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func070001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func070A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func073001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func073A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func076001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func076A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func079001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func079A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func082001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func082A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func085001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func085A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func088001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func088A)
    // //
    // /////
    call ForGroupBJ(udg_Group_PlayerForcesTransfer, function Trig_TyrsKeep_Cinematic_Cleanup_Func091002)
    // /////
    // Give player units to neutral passive
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CleanUpPlayerUnits, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func095001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func095002)
    // /////
    if ( Trig_TyrsKeep_Cinematic_Cleanup_Func097C() ) then
        // Give more units for final fight
        call CreateNUnitsAtLoc(3, 'o007', udg_Player_Actual, GetRectCenter(gg_rct_OrcReinforcements01), GetRandomDirectionDeg())
        call CreateNUnitsAtLoc(2, 'oTA0', udg_Player_Actual, GetRectCenter(gg_rct_OrcReinforcements02), GetRandomDirectionDeg())
        call CreateNUnitsAtLoc(4, 'o001', udg_Player_Actual, GetRectCenter(gg_rct_OrcReinforcements03), GetRandomDirectionDeg())
        call CreateNUnitsAtLoc(2, 'n00A', udg_Player_Actual, GetRectCenter(gg_rct_OrcReinforcements04), GetRandomDirectionDeg())
        call CreateNUnitsAtLoc(3, 'h000', udg_Player_Actual, GetRectCenter(gg_rct_OrcReinforcements01), GetRandomDirectionDeg())
    else
    endif
    // /////
    // manage the players characters
    // /////
    if ( Trig_TyrsKeep_Cinematic_Cleanup_Func101C() ) then
        call SetUnitPositionLocFacingBJ(udg_Hero_Maim, GetRectCenter(gg_rct_HoldTheLineMaim), 54.25)
    else
        call ReviveHeroLoc(udg_Hero_Maim, GetRectCenter(gg_rct_HoldTheLineMaim), false)
        call SetUnitFacingTimed(udg_Hero_Maim, 54.25, 0)
    endif
    // /////
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Hero_Maim)
    call SetUnitLifePercentBJ(udg_Hero_Maim, 100)
    call SetUnitManaPercentBJ(udg_Hero_Maim, 100)
    // /////
    if ( Trig_TyrsKeep_Cinematic_Cleanup_Func107C() ) then
        call SetUnitPositionLocFacingBJ(udg_Hero_Rend, GetRectCenter(gg_rct_HoldTheLineRend), 41.49)
    else
        call ReviveHeroLoc(udg_Hero_Rend, GetRectCenter(gg_rct_HoldTheLineRend), false)
        call SetUnitFacingTimed(udg_Hero_Rend, 41.49, 0)
    endif
    // /////
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_Hero_Rend)
    call SetUnitLifePercentBJ(udg_Hero_Rend, 100)
    call SetUnitManaPercentBJ(udg_Hero_Rend, 100)
    // /////
    if ( Trig_TyrsKeep_Cinematic_Cleanup_Func113C() ) then
        call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_HoldTheLineUtok), 65.80)
    else
    endif
    call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_SemiHero_Utok)
    call SetUnitLifePercentBJ(udg_SemiHero_Utok, 100)
    call SetUnitManaPercentBJ(udg_SemiHero_Utok, 100)
    // /////
    // /////
    call SetPlayerStateBJ(udg_Player_BTGCinematic, PLAYER_STATE_RESOURCE_GOLD, 20000)
    call SetPlayerStateBJ(udg_Player_BTGCinematic, PLAYER_STATE_RESOURCE_LUMBER, 20000)
    call playerAddOil(Player(22) , 10000)
    // /////
    call CreateNUnitsAtLoc(1, 'o613', udg_Player_BTGCinematic, GetRectCenter(gg_rct_DummyOrcStrionghold), bj_UNIT_FACING)
    set udg_Unit_FakeStronghold=GetLastCreatedUnit()
    // /////
    // FakeBuildings for dependencies
    // /////
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_FakeStronghold2), function Trig_TyrsKeep_Cinematic_Cleanup_Func129002)
    call CreateNUnitsAtLoc(1, 'o613', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FakeStronghold2), bj_UNIT_FACING)
    call ShowUnitHide(GetLastCreatedUnit())
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_FakeBarracks), function Trig_TyrsKeep_Cinematic_Cleanup_Func134002)
    call CreateNUnitsAtLoc(1, 'o610', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FakeBarracks), bj_UNIT_FACING)
    call ShowUnitHide(GetLastCreatedUnit())
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_FakeOgreMound), function Trig_TyrsKeep_Cinematic_Cleanup_Func139002)
    call CreateNUnitsAtLoc(1, 'o60Y', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FakeOgreMound), bj_UNIT_FACING)
    call ShowUnitHide(GetLastCreatedUnit())
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_FakeBlacksmith), function Trig_TyrsKeep_Cinematic_Cleanup_Func144002)
    call CreateNUnitsAtLoc(1, 'o60L', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FakeBlacksmith), bj_UNIT_FACING)
    call ShowUnitHide(GetLastCreatedUnit())
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_FakeMill), function Trig_TyrsKeep_Cinematic_Cleanup_Func149002)
    call CreateNUnitsAtLoc(1, 'o60Z', udg_Player_BTGCinematic, GetRectCenter(gg_rct_FakeMill), bj_UNIT_FACING)
    call ShowUnitHide(GetLastCreatedUnit())
    // /////
    // Peons
    // /////
    call AdjustPlayerStateBJ(10000, udg_Player_BTGCinematic, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(10000, udg_Player_BTGCinematic, PLAYER_STATE_RESOURCE_LUMBER)
    // /////
    // /////
    call PolledWait(0.50)
    // //
    // /////
    call CreateNUnitsAtLoc(1, 'o002', udg_Player_BTGCinematic, GetRectCenter(gg_rct_BarracksBuild), bj_UNIT_FACING)
    set udg_Unit_PeonBuilderArr[1]=GetLastCreatedUnit()
    call IssueBuildOrderByIdLocBJ(udg_Unit_PeonBuilderArr[1], 'o610', GetRectCenter(gg_rct_BarracksBuild))
    // //
    // //
    call CreateNUnitsAtLoc(1, 'o002', udg_Player_BTGCinematic, GetRectCenter(gg_rct_THBuild), bj_UNIT_FACING)
    set udg_Unit_PeonBuilderArr[2]=GetLastCreatedUnit()
    call IssueBuildOrderByIdLocBJ(udg_Unit_PeonBuilderArr[2], 'o614', GetRectCenter(gg_rct_THBuild))
    // //
    call CreateNUnitsAtLoc(1, 'n008', udg_Player_BTGCinematic, GetRectCenter(gg_rct_OgreMoundBuild), bj_UNIT_FACING)
    set udg_Unit_PeonBuilderArr[3]=GetLastCreatedUnit()
    call IssueBuildOrderByIdLocBJ(udg_Unit_PeonBuilderArr[3], 'o60Y', GetRectCenter(gg_rct_OgreMoundBuild))
    // //
    call CreateNUnitsAtLoc(1, 'o002', udg_Player_BTGCinematic, GetRectCenter(gg_rct_BuildLumbermill), bj_UNIT_FACING)
    set udg_Unit_PeonBuilderArr[4]=GetLastCreatedUnit()
    call IssueBuildOrderByIdLocBJ(udg_Unit_PeonBuilderArr[4], 'o60Z', GetRectCenter(gg_rct_BuildLumbermill))
    // //
    call CreateNUnitsAtLoc(1, 'o002', udg_Player_BTGCinematic, GetRectCenter(gg_rct_BuildOrcBlacksmith), bj_UNIT_FACING)
    set udg_Unit_PeonBuilderArr[5]=GetLastCreatedUnit()
    call IssueBuildOrderByIdLocBJ(udg_Unit_PeonBuilderArr[5], 'o60L', GetRectCenter(gg_rct_BuildOrcBlacksmith))
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func184001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func184A)
    // /////
    // Move the player's army here
    // /////
    call PolledWait(0.50)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_THBuild, Condition(function Trig_TyrsKeep_Cinematic_Cleanup_Func191001002)), function Trig_TyrsKeep_Cinematic_Cleanup_Func191002)
    // //
    call ForGroupBJ(udg_Group_PlayerForcesTransfer, function Trig_TyrsKeep_Cinematic_Cleanup_Func193002)
    // //
    call SetUnitOwner(udg_Unit_FakeStronghold, udg_Player_Actual, false)
    call ShowUnitHide(udg_Unit_FakeStronghold)
    // /////
    call SetPlayerUnitAvailableBJ('o614', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60V', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60N', false, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('o60M', false, udg_Player_Actual)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_FOOD_CAP_CEILING, 100)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_FOOD_CAP, 100)
    // /////
    call VolumeGroupResetBJ()
    // /////
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_HoldTheLineMaim), 0)
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_CameraBoundsNew)
    call BlzChangeMinimapTerrainTex("Minimap.tga")
    // /////
    call ForGroupBJ(udg_Group_TyrHand, function Trig_TyrsKeep_Cinematic_Cleanup_Func212A)
    // /////
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // /////
    call CreateFogModifierRectBJ(false, udg_Player_Actual, FOG_OF_WAR_FOGGED, gg_rct_DisableP1VisibilityAfterTyrsCin)
    call CreateFogModifierRectBJ(false, udg_Player_Actual, FOG_OF_WAR_MASKED, gg_rct_DisableP1VisibilityAfterTyrsCin)
    // /////
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_TyrsKeep_Cinematic_Cleanup_Func222C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_TyrsKeep_Cinematic_Q)
    // /////
    call ConditionalTriggerExecute(gg_trg_Hold_Discover)
endfunction

//===========================================================================
function InitTrig_TyrsKeep_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_TyrsKeep_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_TyrsKeep_Cinematic_Cleanup, function Trig_TyrsKeep_Cinematic_Cleanup_Actions)
endfunction

