function Trig_Init_02_Units_Actions takes nothing returns nothing
    // Init Items
    // //
    set udg_Item_Bloodvine=gg_item_IBW0_0610
    call SetItemDroppableBJ(gg_item_I607_0130, false)
    // //
    // Set Up Enemy Heroes
    // //
    set udg_Hero_SaidanDathrohan=gg_unit_H00F_0267
    call SuspendHeroXPBJ(false, udg_Hero_SaidanDathrohan)
    // //
    set udg_Hero_MageBoss=gg_unit_H00D_0051
    call SuspendHeroXPBJ(false, udg_Hero_MageBoss)
    call RemoveGuardPosition(udg_Hero_MageBoss)
    call SetUnitColor(udg_Hero_MageBoss, PLAYER_COLOR_VIOLET)
    // //
    // Init Units
    // //
    call ShowUnitHide(gg_unit_hFSs_0620)
    call ShowUnitHide(gg_unit_hFSs_0618)
    call ShowUnitHide(gg_unit_hFSs_0619)
    call ShowUnitHide(gg_unit_hFSs_0624)
    // //
    // Turn off waygates
    call WaygateActivateBJ(false, gg_unit_nSW2_0608)
    call WaygateActivateBJ(false, gg_unit_nSW2_0609)
    // //
    // Stromgarde Tropps on Orc island
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_MainOrcBaseTargeting, udg_Player18_Stromgarde_Ground), function Trig_Init_02_Units_Func030A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_MainOrcBaseTargeting, udg_Player03_Stromgarde_Keep), function Trig_Init_02_Units_Func033A)
    // //
    // Stromgardians that attack Ogre
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_StromgardeFightOgre, udg_Player18_Stromgarde_Ground), function Trig_Init_02_Units_Func038002)
    // //
    call ForGroupBJ(udg_Group_StromgardeAttackOgre, function Trig_Init_02_Units_Func040002)
    call ForGroupBJ(udg_Group_StromgardeAttackOgre, function Trig_Init_02_Units_Func041002)
    // //
    // Creeps that should be hidden before player reaches them
    // //
    call ShowUnitHide(gg_unit_ngz2_0159)
    // //
    call ShowUnitHide(gg_unit_nsqe_0398)
    call ShowUnitHide(gg_unit_ngz3_0394)
    // //
    call ShowUnitHide(gg_unit_nsqe_0399)
    call ShowUnitHide(gg_unit_nsqo_0468)
    call ShowUnitHide(gg_unit_nsqa_0467)
    // //
    call ShowUnitHide(gg_unit_nkot_0172)
    call ShowUnitHide(gg_unit_nkol_0404)
    call ShowUnitHide(gg_unit_nkob_0002)
    call ShowUnitHide(gg_unit_nkog_0170)
    call ShowUnitHide(gg_unit_nsqe_0398)
    // //
    // Murlocks
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_WaterfallBig, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_Init_02_Units_Func063002)
    // //
    call ForGroupBJ(udg_Group_HiddenMurlocks, function Trig_Init_02_Units_Func065002)
    call ForGroupBJ(udg_Group_HiddenMurlocks, function Trig_Init_02_Units_Func066002)
    // //
    // Elven Ambush
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_ElvenAmbush, udg_Player_Alliance), function Trig_Init_02_Units_Func071002)
    // //
    call ForGroupBJ(udg_Group_Ambush, function Trig_Init_02_Units_Func073002)
    call ForGroupBJ(udg_Group_Ambush, function Trig_Init_02_Units_Func074002)
    call ForGroupBJ(udg_Group_Ambush, function Trig_Init_02_Units_Func075002)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_BlackToothCamp, udg_Player_Alliance), function Trig_Init_02_Units_Func079002)
    // //
    call ForGroupBJ(udg_Group_BTAtatck, function Trig_Init_02_Units_Func081002)
    call ForGroupBJ(udg_Group_BTAtatck, function Trig_Init_02_Units_Func082002)
    // //
    // //
    // RemoveDummy Actors
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_CinematicDummy), function Trig_Init_02_Units_Func088002)
    // //
    // Hide Tunnel
    // //
    call ShowUnitHide(gg_unit_nSW2_0609)
    // ----------
    call RemoveGuardPosition(gg_unit_hPSt_0377)
    // //
    // Stromgardians on Island
    // //
    // Ignore AI guard position for island starting units
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player03_Stromgarde_Keep, Condition(function Trig_Init_02_Units_Func100001002)), function Trig_Init_02_Units_Func100A)
    // //
    call RemoveGuardPosition(gg_unit_h60P_0429)
    call RemoveGuardPosition(gg_unit_h60P_0430)
    call RemoveGuardPosition(gg_unit_h60P_0431)
    // //
    // Creating Ballistas
    // //
    call CreateNUnitsAtLoc(1, 'e000', udg_Player_Silverhand, GetRectCenter(gg_rct_THBallistae01), bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e000', udg_Player_Silverhand, GetRectCenter(gg_rct_THBallistae02), bj_UNIT_FACING)
    // //
    // Set Up Regions
    // //
    set udg_BallistaSpot[1]=gg_rct_BallistaKeep01
    set udg_BallistaSpot[2]=gg_rct_BallistaKeep02
    set udg_BallistaSpot[3]=gg_rct_BallistaKeep03
    set udg_BallistaSpot[4]=gg_rct_BallistaKeep04
    set udg_BallistaSpot[5]=gg_rct_BallistaKeep05
    set udg_BallistaSpot[6]=gg_rct_BallistaKeep06
    set udg_BallistaSpot[7]=gg_rct_BallistaKeep07
    set udg_BallistaSpot[8]=gg_rct_BallistaKeep08
    set udg_BallistaSpot[9]=gg_rct_BallistaKeep09
    set udg_BallistaSpot[10]=gg_rct_BallistaKeep10
    // //
    // Create Ballisas
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=10
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call CreateNUnitsAtLoc(1, 'e000', udg_Player03_Stromgarde_Keep, GetRectCenter(udg_BallistaSpot[GetForLoopIndexB()]), GetRandomDirectionDeg())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_TyrsBayBallistas)
        set udg_Unit_Razing_BallistaArr[GetForLoopIndexB()]=GetLastCreatedUnit()
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    // Set Island Archers
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_TyrsKeepQuestUnitCheck, Condition(function Trig_Init_02_Units_Func131001002)), function Trig_Init_02_Units_Func131002)
    // //
    // Make Silverhand Invoulnerable
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Silverhand, 'h60B'), function Trig_Init_02_Units_Func136A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Silverhand, 'e000'), function Trig_Init_02_Units_Func138A)
    // //
    // //
    // SetUp Blacktoothgin camp
    // //
    call SetUnitLifePercentBJ(gg_unit_o614_0009, 50.00)
    call SetUnitLifePercentBJ(gg_unit_o610_0014, 50.00)
    call SetUnitLifePercentBJ(gg_unit_o60L_0015, 75.00)
    call SetUnitLifePercentBJ(gg_unit_ofor_0016, 75.00)
    call SetUnitLifePercentBJ(gg_unit_o60X_0012, 75.00)
    call SetUnitLifePercentBJ(gg_unit_o60X_0013, 60.00)
    call SetUnitLifePercentBJ(gg_unit_o60X_0010, 60.00)
    call SetUnitLifePercentBJ(gg_unit_o60X_0011, 60.00)
    // //
    call playerAddOil(Player(5) , 10000)
    // //
    call PauseUnitBJ(true, gg_unit_o60P_0018)
    call PauseUnitBJ(true, gg_unit_o60P_0019)
    call SetUnitLifePercentBJ(gg_unit_o60P_0018, 60.00)
    call SetUnitLifePercentBJ(gg_unit_o60P_0019, 60.00)
    // //
    call PauseUnitBJ(true, gg_unit_o61Y_0022)
    call PauseUnitBJ(true, gg_unit_o61Y_0021)
    // //
    call PauseUnitBJ(true, gg_unit_o60R_0017)
    call PauseUnitBJ(true, gg_unit_o60S_0003)
    // //
    // ?
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_BlackToohHide, udg_Player_BTG), function Trig_Init_02_Units_Func167002)
    // //
    // Set Up troll Village
    // //
    call MakeUnitRescuableToForceBJ(gg_unit_o60O_0441, true, udg_PlayerGroup_PlayerActual)
    call MakeUnitRescuableToForceBJ(gg_unit_o60O_0440, true, udg_PlayerGroup_PlayerActual)
    call MakeUnitRescuableToForceBJ(gg_unit_o60O_0439, true, udg_PlayerGroup_PlayerActual)
    // //
    // Alliance Navy Caravans
    // //
    set udg_Unit_CaravanTransportArr[1]=gg_unit_h60P_0431
    set udg_Unit_CaravanTransportArr[2]=gg_unit_h60P_0429
    set udg_Unit_CaravanTransportArr[3]=gg_unit_h60P_0430
    // //
    // Castle for Battleships
    // //
    call SetUnitInvulnerable(gg_unit_h61A_0611, true)
    call ShowUnitHide(gg_unit_h61A_0611)
    // //
    // Player 16 Naval Structures for Quest
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player16_Stromgarde_Navy, Condition(function Trig_Init_02_Units_Func189001002)), function Trig_Init_02_Units_Func189002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player16_Stromgarde_Navy, Condition(function Trig_Init_02_Units_Func192001002)), function Trig_Init_02_Units_Func192002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player16_Stromgarde_Navy, Condition(function Trig_Init_02_Units_Func195001002)), function Trig_Init_02_Units_Func195002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player18_Stromgarde_Ground, Condition(function Trig_Init_02_Units_Func198001002)), function Trig_Init_02_Units_Func198002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player18_Stromgarde_Ground, Condition(function Trig_Init_02_Units_Func201001002)), function Trig_Init_02_Units_Func201002)
    // //
    // Replace Oil Rigs that were affected by IceHovers
    call TriggerSleepAction(3.00)
    // //
    call ReplaceUnitBJ(gg_unit_u600_0099, 'u600', bj_UNIT_STATE_METHOD_RELATIVE)
    call ReplaceUnitBJ(gg_unit_u600_0381, 'u600', bj_UNIT_STATE_METHOD_RELATIVE)
    // //
    call ConditionalTriggerExecute(gg_trg_SetUpOilPatchCapacity)
    // //
endfunction

