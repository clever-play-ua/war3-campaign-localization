//===========================================================================
// Trigger: OilSpentForHumanTransport
//
// Transport Ship
//===========================================================================
function Trig_OilSpentForHumanTransport_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetTrainedUnitType() == 'h60P' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == udg_Player16_Stromgarde_Navy ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForHumanTransport_Func019C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForHumanTransport_Actions takes nothing returns nothing
    // -------------------------------------
    // Check the amount of Oil for Player
    if (OilHarvest__playerOil[GetPlayerId((Player(15)))]) < 500 then // INLINED!!
    // // UI Warning
    // No need for it for computer driven player
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(15) , - 500)
    else
    // need to decrease the oil if there was enough of it and ship started to build
    call playerAddOil(Player(15) , - 500)
    endif
    // //
    if ( Trig_OilSpentForHumanTransport_Func019C() ) then
        call DisplayTextToForce(udg_PlayerGroup_PlayerActual, ( "Marynarka Stromgardu ma obecnie: " + I2S((OilHarvest__playerOil[GetPlayerId((Player(15)))])) + " jednostek ropy" )) // INLINED!!
    else
    endif
endfunction

