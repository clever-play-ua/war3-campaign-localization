    // //
    call SetUnitAnimation(udg_FakeUtok, "spell channel")
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic injured one")
    // //
    call ForGroupBJ(udg_Group_FakeGrunts, function Trig_Ambush_Cinematic_Q_Func084A)
    // //
    call StopSoundBJ(gg_snd_Tension01, true)
    call PlaySoundBJ(gg_snd_ZulamanTheme01)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Trap05, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Trap00, udg_Player_Actual, 3.00, 0, 0.50, 100.00)
    // //
    call PauseUnitBJ(false, gg_unit_h60S_0151)
    call PauseUnitBJ(false, gg_unit_h60S_0153)
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ShowUnitShow(udg_Unit_CinTroll[1])
    call ShowUnitShow(udg_Unit_CinTroll[2])
    call ShowUnitShow(udg_Unit_CinTroll[3])
    call ShowUnitShow(udg_Unit_CinTroll[4])
    call ShowUnitShow(udg_Unit_CinTroll[5])
    call ShowUnitShow(udg_Unit_CinTroll[6])
    call ShowUnitShow(udg_Unit_CinTroll[7])
    call ShowUnitShow(udg_Unit_BerserkerCinematic)
    // //
    call BlzUnitDisableAbility(udg_Unit_BerserkerCinematic, 'A60C', true, false)
    call SetCineModeVolumeGroupsBJ()
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_CinTroll[1], 0, gg_snd_WC2Orc09TrollTaunt02, bj_TIMETYPE_ADD, 0, false)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Trap04, udg_Player_Actual, 0.00)
    // //
    call SetDoodadAnimationRectBJ("stand", 'D003', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("stand", 'D6D8', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("stand", 'D6D9', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("stand", 'D6DA', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("stand", 'D6DB', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("stand", 'D6DC', gg_rct_ElvenAmbush)
    call SetDoodadAnimationRectBJ("stand", 'D6DD', gg_rct_ElvenAmbush)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Trap06, udg_Player_Actual, 5.00, 0, 1.00, 100.00)
