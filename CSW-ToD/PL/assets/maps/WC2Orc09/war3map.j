//===========================================================================
function Trig_LevelCap_Func002C takes nothing returns boolean
    if ( not ( GetLevelingUnit() == udg_Hero_Rend ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero_Rend) == 8 ) ) then
        return false
    endif
    return true
