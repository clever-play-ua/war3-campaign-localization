// Trigger: Cliff01VisibilityOff
//===========================================================================
function Trig_Cliff01VisibilityOff_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_VisModCliff01On == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Cliff01VisibilityOff_Func002Func004001001002001 takes nothing returns boolean
