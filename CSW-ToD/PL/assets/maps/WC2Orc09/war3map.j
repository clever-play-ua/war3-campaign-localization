    return ( udg_Bool_SeaFrozenCinSkipped == true )
endfunction

function Trig_RiverFreeze_Cinematic_Q_Func078001 takes nothing returns boolean
    return ( udg_Bool_SeaFrozenCinSkipped == true )
endfunction

function Trig_RiverFreeze_Cinematic_Q_Func090001 takes nothing returns boolean
    return ( udg_Bool_SeaFrozenCinSkipped == true )
endfunction

function Trig_RiverFreeze_Cinematic_Q_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetup)
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    call ConditionalTriggerExecute(gg_trg_RiverFreeze_Cinematic_SetUp)
    // //
    // Ensure Setup completes
    call SetCineModeVolumeGroupsBJ()
    call CameraSetupApplyForPlayer(true, gg_cam_RiverFreeze01, udg_Player_Actual, 0)
    // //
    // Need to stop all researches and Upgrades
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_RiverFreeze_Cinematic_Q_Func015001002)), function Trig_RiverFreeze_Cinematic_Q_Func015002)
    // //
    // Transport Excluded
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    // Cinematic Started
    // //
    set udg_Bool_SeaFrozenCinOn=true
    set udg_Bool_CinematicSkipped=false
    call TriggerSleepAction(1.00)
    call PlaySoundBJ(gg_snd_HumanDefeat)
    if ( (udg_Bool_SeaFrozenCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Saidan, "cinematic frustrated one")
    call QueueUnitAnimationBJ(udg_Fake_Saidan, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Saidan, 0, gg_snd_WC2Orc09Saidan6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_SeaFrozenCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Saidan, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_RiverFreeze02, udg_Player_Actual, 0)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Archmage, 0, gg_snd_WC2Orc09Mage3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_SeaFrozenCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_RiverFreeze01, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_Fake_Archmage, "cinematic point two")
    call QueueUnitAnimationBJ(udg_Fake_Archmage, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Saidan, 0, gg_snd_WC2Orc09Saidan7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_SeaFrozenCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Saidan, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_RiverFreeze02, udg_Player_Actual, 0)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Archmage, 0, gg_snd_WC2Orc09Mage4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_SeaFrozenCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ***
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call PlaySoundAtPointBJ(gg_snd_DoorSlam1, 100, GetRectCenter(gg_rct_TyrsQuest), 0)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_RiverFreeze03, udg_Player_Actual, 0)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Archmage, GetRectCenter(gg_rct_CircleOfPower), bj_UNIT_FACING)
    call TriggerSleepAction(1.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call PlaySoundOnUnitBJ(gg_snd_FrostArmorTarget1, 100, gg_unit_H00D_0051)
    // //
    call SetUnitAnimation(udg_Fake_Archmage, "spell")
    call QueueUnitAnimationBJ(udg_Fake_Archmage, "cinematic stand")
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_RiverFreeze04, udg_Player_Actual, 9.00, 0, 2.00, 100.00)
    call AddSpecialEffectTargetUnitBJ("origin", udg_Fake_Archmage, "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualCaster.mdl")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_SeaFrozenCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetDoodadAnimationRectBJ("stand", 'D6CF', gg_rct_TyrsQuest)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_SeaFrozenCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Archmage, "stand channel")
    // //
    call AddSpecialEffectTargetUnitBJ("origin", udg_Fake_Archmage, "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl")
    set udg_SE_MageFrostAura=GetLastCreatedEffectBJ()
    // //
    call PlaySoundOnUnitBJ(gg_snd_FrostArmorTarget1, 100, gg_unit_H00D_0051)
    // //
    call ConditionalTriggerExecute(gg_trg_Blizzard_Start)
    // //
    call TriggerSleepAction(15.00)
    if ( (udg_Bool_SeaFrozenCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_HumanDefeat, true)
    // //
    call ConditionalTriggerExecute(gg_trg_RiverFreeze_Cinematic_Cleanup)
    // //
    // //
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

