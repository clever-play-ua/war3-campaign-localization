//===========================================================================
// Trigger: Camp Completed
//===========================================================================
function Trig_Camp_Completed_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Rend) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Completed_Func002Func003001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player03_Stromgarde_Keep )
endfunction

function Trig_Camp_Completed_Func002Func003001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Camp_Completed_Func002Func003001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player03_Stromgarde_Keep), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Camp_Completed_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_BlackToothCamp, Condition(function Trig_Camp_Completed_Func002Func003001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Camp_Completed_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Camp_Completed_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QueuedTriggerAddBJ(gg_trg_Camp_Completed_Q, true)
        call QueuedTriggerAddBJ(gg_trg_Camp_Cinematic_Q, true)
    else
    endif
endfunction

