function Trig_Init_05_Quests_Actions takes nothing returns nothing
    // //
    // MAIN QUEST: CAMP
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_3154", "TRIGSTR_3155", "ReplaceableTextures\\CommandButtons\\BTNOrcRallyPoint.blp")
    set udg_MQCamp=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQCamp, "TRIGSTR_3156")
    set udg_QReq_CampLocateClan=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQCamp, "TRIGSTR_3157")
    set udg_QReq_CampRendSurvive=GetLastCreatedQuestItemBJ()
    // //
    // MAIN QUEST: ALLIANCE NAVY
    // //
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3163", "TRIGSTR_3164", "ReplaceableTextures\\CommandButtons\\BTNHumanShipyard.blp")
    set udg_MQNavy=GetLastCreatedQuestBJ()
    // //
    call CreateQuestItemBJ(udg_MQNavy, "TRIGSTR_3168")
    set udg_QReq_DestroyCaravans=GetLastCreatedQuestItemBJ()
    // //
    call CreateQuestItemBJ(udg_MQNavy, "TRIGSTR_3165")
    set udg_QReq_DestroyShipyards=GetLastCreatedQuestItemBJ()
    // //
    call CreateQuestItemBJ(udg_MQNavy, "TRIGSTR_3166")
    set udg_QReq_DestroyFoundries=GetLastCreatedQuestItemBJ()
    // //
    call CreateQuestItemBJ(udg_MQNavy, "TRIGSTR_3167")
    set udg_QReq_DestroyRefineries=GetLastCreatedQuestItemBJ()
    // //
    // //
    // MAIN QUEST: THE RAZING OF TYR'S HAND
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3205", "TRIGSTR_3206", "ReplaceableTextures\\CommandButtons\\BTNKeep.blp")
    set udg_MQRazing=GetLastCreatedQuestBJ()
    // //
    call CreateQuestItemBJ(udg_MQRazing, "TRIGSTR_3207")
    set udg_QReq_DestroyStromgardeKeep=GetLastCreatedQuestItemBJ()
    // //
    call CreateQuestItemBJ(udg_MQRazing, "TRIGSTR_3599")
    set udg_QReq_DestroyBarracks=GetLastCreatedQuestItemBJ()
    // //
    call CreateQuestItemBJ(udg_MQRazing, "TRIGSTR_3208")
    set udg_QReq_KillMage=GetLastCreatedQuestItemBJ()
    // //
    set udg_Unit_BarracksToDestroyArr[1]=gg_unit_h616_0629
    set udg_Unit_BarracksToDestroyArr[2]=gg_unit_h616_0628
    set udg_Unit_BarracksToDestroyArr[3]=gg_unit_h616_0630
    set udg_Unit_BarracksToDestroyArr[4]=gg_unit_h616_0039
    // //
    // MAIN QUEST: HOLD THE LINE
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3228", "TRIGSTR_3229", "ReplaceableTextures/CommandButtons/BTNWC2Fortress.dds")
    set udg_MQHold=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQHold, "TRIGSTR_3231")
    set udg_QReq_HoldFortress=GetLastCreatedQuestItemBJ()
    // //
    // OPTIONAL QUEST: OGRE MAGI
    // //
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_3258", "TRIGSTR_3259", "ReplaceableTextures\\CommandButtons\\BTNWC2OgreMagi.dds")
    set udg_OQOgre=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQOgre, "TRIGSTR_3260")
    set udg_QReq_FindRunestoneShard=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_OQOgre, "TRIGSTR_3261")
    set udg_QReq_BuildAltarOfStorms=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_OQOgre, "TRIGSTR_3262")
    set udg_QReq_TransformOgres=GetLastCreatedQuestItemBJ()
    // //
    // OPTIONAL QUEST: BERSERKER POTION
    // //
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_3268", "TRIGSTR_3269", "ReplaceableTextures\\CommandButtons\\BTNPotionGreen.blp")
    set udg_OQBerserker=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQBerserker, "TRIGSTR_3270")
    set udg_QReq_FindBloodvine=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_OQBerserker, "TRIGSTR_3271")
    set udg_QReq_BringToGoblin=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_OQBerserker, "TRIGSTR_3272")
    set udg_QReq_TransformTrolls=GetLastCreatedQuestItemBJ()
    // //
    // //
    // //
    // //
endfunction

