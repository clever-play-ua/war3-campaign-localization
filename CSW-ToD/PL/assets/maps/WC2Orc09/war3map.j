function Trig_PlayerUnitsDead_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_PlayerUserDefeatCond)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_PlayerUnitsDead_Func006001002)), function Trig_PlayerUnitsDead_Func006A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_PlayerUnitsDead_Func009001002)), function Trig_PlayerUnitsDead_Func009A)
    // //
    if ( Trig_PlayerUnitsDead_Func011C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call PolledWait(2)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_MISSIONFAILED, "TRIGSTR_3280")
        call PolledWait(bj_QUEUE_DELAY_QUEST)
        call ConditionalTriggerExecute(gg_trg_Defeat)
    else
    endif
    // //
    call GroupClear(udg_Group_PlayerUserDefeatCond)
    // //
endfunction

//===========================================================================
function InitTrig_PlayerUnitsDead takes nothing returns nothing
    set gg_trg_PlayerUnitsDead=CreateTrigger()
    call DisableTrigger(gg_trg_PlayerUnitsDead)
    call TriggerRegisterTimerEventPeriodic(gg_trg_PlayerUnitsDead, 2)
    call TriggerAddCondition(gg_trg_PlayerUnitsDead, Condition(function Trig_PlayerUnitsDead_Conditions))
    call TriggerAddAction(gg_trg_PlayerUnitsDead, function Trig_PlayerUnitsDead_Actions)
endfunction

//===========================================================================
// Trigger: RendDies
//===========================================================================
function Trig_RendDies_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQCamp) == false ) ) then
        return false
    endif
    if ( not ( GetDyingUnit() == udg_Hero_Rend ) ) then
        return false
    endif
    return true
endfunction

function Trig_RendDies_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetFailedBJ(udg_MQCamp, true)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_2537")
    call PolledWait(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_Defeat)
endfunction

//===========================================================================
function InitTrig_RendDies takes nothing returns nothing
    set gg_trg_RendDies=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_RendDies, Player(0), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_RendDies, Condition(function Trig_RendDies_Conditions))
    call TriggerAddAction(gg_trg_RendDies, function Trig_RendDies_Actions)
endfunction

//===========================================================================
// Trigger: Defeat
//===========================================================================
function Trig_Defeat_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\HazeAndFogFilter_Mask.blp", 100.00, 0, 0, 25.00)
    call PolledWait(1.00)
    call CustomDefeatBJ(udg_Player_Actual, "TRIGSTR_3108")
endfunction

//===========================================================================
function InitTrig_Defeat takes nothing returns nothing
    set gg_trg_Defeat=CreateTrigger()
    call TriggerAddAction(gg_trg_Defeat, function Trig_Defeat_Actions)
endfunction

