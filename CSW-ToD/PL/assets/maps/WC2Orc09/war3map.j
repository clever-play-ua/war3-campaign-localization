    set udg_Point_LandingMainOrcBase02=GetRectCenter(gg_rct_UnloadMain02)
    // //
    // Stromgarde
    set udg_Point_LandingStromgarde01=GetRectCenter(gg_rct_UnloadHome01)
    set udg_Point_LandingStromgarde02=GetRectCenter(gg_rct_UnloadHome02)
    // //
    // Expansion Goldmine A
    set udg_Point_LandingExpansionA01=GetRectCenter(gg_rct_UnloadExp01)
    set udg_Point_LandingExpansionA02=GetRectCenter(gg_rct_UnloadExp02)
