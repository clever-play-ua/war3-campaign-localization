    set gg_trg_OgreMagi_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_OgreMagi_Cinematic_Cleanup, function Trig_OgreMagi_Cinematic_Cleanup_Actions)
endfunction

