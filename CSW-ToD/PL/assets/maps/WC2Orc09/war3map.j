//===========================================================================
// Trigger: Navy Update Completed
//===========================================================================
function Trig_Navy_Update_Completed_Func001C takes nothing returns boolean
    if ( not ( udg_Bool_ShipyardsDestroyed == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_RefineriesDestroyed == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_FoundriesDestroyed == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Update_Completed_Actions takes nothing returns nothing
    if ( Trig_Navy_Update_Completed_Func001C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_QuestAllianceNavyRemoveIcons)
        call QueuedTriggerAddBJ(gg_trg_Navy_Completed_Q, true)
        call ConditionalTriggerExecute(gg_trg_AI_P18_Command_Stop_Attack_User)
        call QueuedTriggerAddBJ(gg_trg_RiverFreeze_Cinematic_Q, true)
    else
        call QueuedTriggerAddBJ(gg_trg_Navy_Update_Q, true)
    endif
endfunction

