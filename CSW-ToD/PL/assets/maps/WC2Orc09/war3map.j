function Trig_Intro_Cinematic_RendRoute_Func024001 takes nothing returns boolean
    return ( udg_Bool_IntroCinSkipped == true )
endfunction

function Trig_Intro_Cinematic_RendRoute_Func027001 takes nothing returns boolean
    return ( udg_Bool_IntroCinSkipped == true )
endfunction

function Trig_Intro_Cinematic_RendRoute_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Rend02Cin))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, udg_Hero_Rend)
    // //
    set udg_Point_CinRendTempLoc=GetUnitLoc(udg_FakeRend)
    call TriggerSleepAction(( ( DistanceBetweenPoints(udg_Point_CinRendTempLoc, GetRectCenter(gg_rct_Rend02Cin)) / GetUnitDefaultMoveSpeed(udg_FakeRend) ) - 0.00 ))
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Rend03Cin))
    set udg_Point_CinRendTempLoc=GetUnitLoc(udg_FakeRend)
    call TriggerSleepAction(( ( DistanceBetweenPoints(udg_Point_CinRendTempLoc, GetRectCenter(gg_rct_Rend03Cin)) / GetUnitDefaultMoveSpeed(udg_FakeRend) ) - 0.00 ))
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_Rend04Cin))
    set udg_Point_CinRendTempLoc=GetUnitLoc(udg_FakeRend)
    call TriggerSleepAction(( ( DistanceBetweenPoints(udg_Point_CinRendTempLoc, GetRectCenter(gg_rct_Rend04Cin)) / GetUnitDefaultMoveSpeed(udg_FakeRend) ) - 0.00 ))
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_BlackhandStart))
    set udg_Point_CinRendTempLoc=GetUnitLoc(udg_FakeRend)
    call TriggerSleepAction(( ( DistanceBetweenPoints(udg_Point_CinRendTempLoc, GetRectCenter(gg_rct_BlackhandStart)) / GetUnitDefaultMoveSpeed(udg_FakeRend) ) + 1.00 ))
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.75)
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_FakeRend, 315.00, 0.50)
endfunction

