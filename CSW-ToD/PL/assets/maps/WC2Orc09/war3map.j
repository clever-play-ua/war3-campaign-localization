//===========================================================================
function Trig_RiverFreeze_Cinematic_Q_Func015001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_RiverFreeze_Cinematic_Q_Func015002 takes nothing returns nothing
    call IssueImmediateOrderBJ(GetEnumUnit(), "stop")
endfunction

function Trig_RiverFreeze_Cinematic_Q_Func027001 takes nothing returns boolean
    return ( udg_Bool_SeaFrozenCinSkipped == true )
endfunction

function Trig_RiverFreeze_Cinematic_Q_Func032001 takes nothing returns boolean
    return ( udg_Bool_SeaFrozenCinSkipped == true )
endfunction

