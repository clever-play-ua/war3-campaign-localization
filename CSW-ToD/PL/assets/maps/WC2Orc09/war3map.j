// Trigger: DebugOff
//===========================================================================
function Trig_DebugOff_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DebugOff_Actions takes nothing returns nothing
    set udg_Bool_DebugOn=false
    call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3571")
endfunction

//===========================================================================
function InitTrig_DebugOff takes nothing returns nothing
    set gg_trg_DebugOff=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_DebugOff, Player(0), "DebugOff", true)
    call TriggerAddCondition(gg_trg_DebugOff, Condition(function Trig_DebugOff_Conditions))
    call TriggerAddAction(gg_trg_DebugOff, function Trig_DebugOff_Actions)
endfunction

//===========================================================================
// Trigger: UniteTheClans
//===========================================================================
function Trig_UniteTheClans_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_3606")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_NextLevelPrep)
endfunction

