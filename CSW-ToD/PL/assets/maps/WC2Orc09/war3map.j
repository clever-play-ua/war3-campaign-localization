endfunction

function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Settings
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetup)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_SetUp)
    // SetCamera
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01Pan01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro02Pan02, udg_Player_Actual, 7.00, 0.00, 2.00, 100.00)
    call TriggerSleepAction(1.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    // Cinematic Starts and can be skipped now
    // The Human Intro Starts
    // //
    set udg_Bool_IntroCinOn=true
    set udg_Bool_CinematicSkipped=false
    call PlaySoundBJ(gg_snd_Human1)
    // //
    call IssuePointOrderLocBJ(udg_Unit_IntroTransportShip, "move", GetRectCenter(gg_rct_IntroHumanShip02))
    call TriggerSleepAction(( ( DistanceBetweenPoints(GetUnitLoc(udg_Unit_IntroTransportShip), GetRectCenter(gg_rct_IntroHumanShip02)) / GetUnitMoveSpeed(udg_Unit_IntroTransportShip) ) - 1.00 ))
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundAtPointBJ(gg_snd_Dock, 60.00, GetRectCenter(gg_rct_IntroHumanShip02), 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundAtPointBJ(gg_snd_Loading, 60.00, GetRectCenter(gg_rct_IntroMageArrival), 0)
    call ShowUnitShow(udg_Fake_Archmage)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Archmage, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_Fake_Archmage, "cinematic stand")
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_DelayGateOpen)
    // //
    call TriggerSleepAction(4.10)
    if ( (udg_Bool_IntroCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro03Pan03, udg_Player_Actual, 13.00, 0.00, 3.00, 100.00)
    // //
    call IssuePointOrderLocBJ(udg_Fake_Archmage, "move", GetRectCenter(gg_rct_IntroMagePassesTheGate))
    call PlaySoundOnUnitBJ(gg_snd_CS_BG_Camp, 100.00, udg_Fake_Archmage)
