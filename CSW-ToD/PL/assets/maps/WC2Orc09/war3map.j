//===========================================================================
// Trigger: AI P03 Defeated
//===========================================================================
function Trig_AI_P03_Defeated_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player03_Stromgarde_Keep ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P03_Defeated_Func009001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_AI_P03_Defeated_Func009001002002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) != 'hFSs' )
endfunction

function Trig_AI_P03_Defeated_Func009001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P03_Defeated_Func009001002002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) != 'hFSs'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P03_Defeated_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) != 'hFSs'), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_AI_P03_Defeated_Func009A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P18_DefeatCond)
endfunction

function Trig_AI_P03_Defeated_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P03_DefeatCond) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P03_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_P03_DefeatCond)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player03_Stromgarde_Keep, Condition(function Trig_AI_P03_Defeated_Func009001002)), function Trig_AI_P03_Defeated_Func009A)
    // //
    if ( Trig_AI_P03_Defeated_Func011C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        // //
        call DisableTrigger(gg_trg_AIP03_Gold)
        call DisableTrigger(gg_trg_AIP03_Lumber)
        // //
        call ConditionalTriggerExecute(gg_trg_AI_P03_Command_Stop_Attack_User)
        call ConditionalTriggerExecute(gg_trg_AI_P03_Command_Defeat)
        // //
    else
    endif
    // //
    call GroupClear(udg_Group_P03_DefeatCond)
    // //
endfunction

