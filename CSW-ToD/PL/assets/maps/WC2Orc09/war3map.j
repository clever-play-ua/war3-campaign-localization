//===========================================================================
// Trigger: AI P18 Defeated
//===========================================================================
function Trig_AI_P18_Defeated_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player18_Stromgarde_Ground ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P18_Defeated_Func009001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h616' )
endfunction

function Trig_AI_P18_Defeated_Func009001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P18_Defeated_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h616'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P18_Defeated_Func009A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P18_DefeatCond)
endfunction

function Trig_AI_P18_Defeated_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P18_DefeatCond) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P18_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_P18_DefeatCond)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player18_Stromgarde_Ground, Condition(function Trig_AI_P18_Defeated_Func009001002)), function Trig_AI_P18_Defeated_Func009A)
    // //
    if ( Trig_AI_P18_Defeated_Func011C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        // //
        call DisableTrigger(gg_trg_AIP18_Gold)
        call DisableTrigger(gg_trg_AIP18_Lumber)
        // //
        call ConditionalTriggerExecute(gg_trg_AI_P18_Command_Stop_Attack_User)
        call ConditionalTriggerExecute(gg_trg_AI_P18_Command_Stop_Attack_User_Amf)
        // //
        call ConditionalTriggerExecute(gg_trg_AI_P18_Command_Defeat)
        // //
    else
    endif
    // //
    call GroupClear(udg_Group_P18_DefeatCond)
    // //
endfunction

