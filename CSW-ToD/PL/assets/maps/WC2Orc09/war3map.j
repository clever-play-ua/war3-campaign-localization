    // //
    call KillUnit(gg_unit_h60S_0147)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_BerserkerTaunt, udg_Player_Actual, 0.00)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_BerserkerKill, udg_Player_Actual, 2.00, 0, 0.50, 100.00)
    // //
    call SetCineModeVolumeGroupsBJ()
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_BerserkerCinematic, 0, gg_snd_WC2Orc09TrollTaunt01, bj_TIMETYPE_ADD, 0, false)
    // //
    call IssueTargetOrderBJ(udg_Unit_BerserkerCinematic, "ensnare", gg_unit_h60S_0151)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(udg_Unit_BerserkerCinematic, "move", GetRectCenter(gg_rct_BerserkCutThroats))
    call IssueTargetOrderBJ(udg_Unit_CinTroll[7], "attack", gg_unit_h60S_0151)
    call IssueTargetOrderBJ(udg_Unit_CinTroll[5], "attack", gg_unit_h60S_0151)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_AmbushCinSkipped == true) ) then // INLINED!!
