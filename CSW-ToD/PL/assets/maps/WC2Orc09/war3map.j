//===========================================================================
function Trig_Intro_Cinematic_DoorGuard_Actions takes nothing returns nothing
    set udg_Bool_DoorGuardMove=true
    call IssuePointOrderLocBJ(gg_unit_hfSt_0258, "move", GetRectCenter(gg_rct_IntroDoorGuardMove01))
    call TriggerSleepAction(2.75)
    call SetUnitFacingTimed(gg_unit_hfSt_0258, 207.80, 0.40)
endfunction

