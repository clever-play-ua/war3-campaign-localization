//===========================================================================
// Trigger: LoadCache
//===========================================================================
function Trig_LoadCache_Actions takes nothing returns nothing
    call InitGameCacheBJ("WC2Horde.w3v")
    set udg_Cache=GetLastCreatedGameCacheBJ()
    call ConditionalTriggerExecute(gg_trg_LoadRend)
    call ConditionalTriggerExecute(gg_trg_LoadUtok)
    call ConditionalTriggerExecute(gg_trg_LoadMaim)
endfunction

//===========================================================================
function InitTrig_LoadCache takes nothing returns nothing
    set gg_trg_LoadCache=CreateTrigger()
    call TriggerAddAction(gg_trg_LoadCache, function Trig_LoadCache_Actions)
endfunction

//===========================================================================
// Trigger: LoadRend
//===========================================================================
function Trig_LoadRend_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc04", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_LoadRend_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_LoadRend_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Rend", "WC2Orc04", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_BlackhandStart), GetRectCenter(gg_rct_Grunt03Cin))
        set udg_Hero_Rend=GetLastRestoredUnitBJ()
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'O617', udg_Player_Actual, GetRectCenter(gg_rct_BlackhandStart), GetRectCenter(gg_rct_Grunt03Cin))
        set udg_Hero_Rend=GetLastCreatedUnit()
        call SetHeroLevelBJ(udg_Hero_Rend, 6, false)
        call SelectHeroSkill(udg_Hero_Rend, 'AR9Q')
        call SelectHeroSkill(udg_Hero_Rend, 'AR9Q')
        call SelectHeroSkill(udg_Hero_Rend, 'A00O')
        call SelectHeroSkill(udg_Hero_Rend, 'A00N')
        call SelectHeroSkill(udg_Hero_Rend, 'A00N')
        call SelectHeroSkill(udg_Hero_Rend, 'A00P')
        call UnitAddItemByIdSwapped('I60B', udg_Hero_Rend)
    endif
endfunction

//===========================================================================
function InitTrig_LoadRend takes nothing returns nothing
    set gg_trg_LoadRend=CreateTrigger()
    call TriggerAddAction(gg_trg_LoadRend, function Trig_LoadRend_Actions)
endfunction

