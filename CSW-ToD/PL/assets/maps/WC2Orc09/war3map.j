function Trig_Final_Cinematic_TurtleRouteA_Func003001 takes nothing returns boolean
    return ( udg_Bool_OutroCinSkipped == true )
endfunction

function Trig_Final_Cinematic_TurtleRouteA_Func006001 takes nothing returns boolean
    return ( udg_Bool_OutroCinSkipped == true )
