//===========================================================================
// Trigger: Navy Update Q
//===========================================================================
function Trig_Navy_Update_Q_Func005C takes nothing returns boolean
    if ( not ( udg_Bool_ShipyardsDestroyed == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Update_Q_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_FoundriesDestroyed == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Update_Q_Func009C takes nothing returns boolean
    if ( not ( udg_Bool_RefineriesDestroyed == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Navy_Update_Q_Actions takes nothing returns nothing
    // //
    set udg_String_CompletedQuests=( BlzGetItemDescription(gg_item_IQL2_0616) + ( "\n" + GetItemName(gg_item_IQL0_0615) ) )
    // //
    if ( Trig_Navy_Update_Q_Func005C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_DestroyShipyards, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + GetItemName(gg_item_IQL2_0616) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + BlzGetItemTooltip(gg_item_IQL0_0615) ) )
    endif
    // //
    if ( Trig_Navy_Update_Q_Func007C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_DestroyFoundries, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + BlzGetItemTooltip(gg_item_IQL2_0616) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + BlzGetItemExtendedTooltip(gg_item_IQL0_0615) ) )
    endif
    // //
    if ( Trig_Navy_Update_Q_Func009C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_DestroyRefineries, true)
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + BlzGetItemExtendedTooltip(gg_item_IQL2_0616) ) )
    else
        set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + BlzGetItemExtendedTooltip(gg_item_IQL1_0614) ) )
    endif
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + GetItemName(gg_item_IQL1_0614) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( "\n" + ( BlzGetItemTooltip(gg_item_IQL1_0614) + ( I2S(udg_Int_CaravansAllowedToFlee) + BlzGetItemDescription(gg_item_IQL1_0614) ) ) ) )
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // //
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
endfunction

