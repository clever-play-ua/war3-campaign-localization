//===========================================================================
// Trigger: AI P09 Oil
//
// If the enemy player doesnt have oil rigs and its oil reserves less than 700, no sense in continue attacking.
// Ship construction will be restricted by amount of oil to  prevent difficulty snowballing on later phase of the game
//===========================================================================
function Trig_AI_P09_Oil_Func007A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P16OilRigs)
endfunction

function Trig_AI_P09_Oil_Func020C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P09_Oil_Actions takes nothing returns nothing
    local integer p16OilRigs
    // //
    call GroupClear(udg_Group_P16OilRigs)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player16_Stromgarde_Navy, 'u600'), function Trig_AI_P09_Oil_Func007A)
    // //
    set p16OilRigs=CountUnitsInGroup(udg_Group_P16OilRigs)
    // //
    if (OilHarvest__playerOil[GetPlayerId((Player(15)))]) < 700 and p16OilRigs == 0 then // INLINED!!
    // //
    call PauseTimerBJ(true, udg_Timer_P16OilChecker)
    call ConditionalTriggerExecute(gg_trg_AI_P16_Command_Stop_Attack_User)
    call DisableTrigger(gg_trg_OilSpentForHumanTransport)
    call DisableTrigger(gg_trg_OilSpentForElvenDestroyer)
    call DisableTrigger(gg_trg_OilSpentForBattleship)
    call DisableTrigger(gg_trg_OilSpentForSubmarine)
    // //
    if ( Trig_AI_P09_Oil_Func020C() ) then
        call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3594")
    else
    endif
    // //
    endif
    // //
    call GroupClear(udg_Group_P16OilRigs)
endfunction

//===========================================================================
function InitTrig_AI_P09_Oil takes nothing returns nothing
    set gg_trg_AI_P09_Oil=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_AI_P09_Oil, udg_Timer_P16OilChecker)
    call TriggerAddAction(gg_trg_AI_P09_Oil, function Trig_AI_P09_Oil_Actions)
endfunction

//===========================================================================
// Trigger: AI P16 Defeated
//===========================================================================
function Trig_AI_P16_Defeated_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player16_Stromgarde_Navy ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P16_Defeated_Func009001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60X' )
endfunction

function Trig_AI_P16_Defeated_Func009001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P16_Defeated_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h60X'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P16_Defeated_Func009A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P16DefeatCond)
endfunction

function Trig_AI_P16_Defeated_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P16DefeatCond) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P16_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_P16DefeatCond)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player16_Stromgarde_Navy, Condition(function Trig_AI_P16_Defeated_Func009001002)), function Trig_AI_P16_Defeated_Func009A)
    // //
    if ( Trig_AI_P16_Defeated_Func011C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        // //
        call DisableTrigger(gg_trg_AIP16_Gold)
        call DisableTrigger(gg_trg_AIP16_Lumber)
        // //
        call ConditionalTriggerExecute(gg_trg_AI_P16_Command_Stop_Attack_User)
        call ConditionalTriggerExecute(gg_trg_AI_P16_Command_Defeat)
        // //
    else
    endif
    // //
    call GroupClear(udg_Group_P16DefeatCond)
    // //
endfunction

//===========================================================================
function InitTrig_AI_P16_Defeated takes nothing returns nothing
    set gg_trg_AI_P16_Defeated=CreateTrigger()
