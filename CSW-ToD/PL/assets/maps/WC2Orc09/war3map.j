    set gg_trg_Maim_I_Maim=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Maim_I_Maim, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Maim_I_Maim, Condition(function Trig_Maim_I_Maim_Conditions))
