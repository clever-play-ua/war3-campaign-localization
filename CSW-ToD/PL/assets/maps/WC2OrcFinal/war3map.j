//===========================================================================
function InitTrig_CreditsCinematic takes nothing returns nothing
    set gg_trg_CreditsCinematic=CreateTrigger()
    call TriggerAddAction(gg_trg_CreditsCinematic, function Trig_CreditsCinematic_Actions)
endfunction

//===========================================================================
// Trigger: CheeringUnitsAnimationLoop
//===========================================================================
function Trig_CheeringUnitsAnimationLoop_Conditions takes nothing returns boolean
    if ( not ( udg_CreditsCinematic == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_CheeringUnitsAnimationLoop_Func003002 takes nothing returns nothing
    call SetUnitAnimation(GetEnumUnit(), "stand victory")
endfunction

function Trig_CheeringUnitsAnimationLoop_Func006001 takes nothing returns boolean
    return ( udg_CreditsCinematicSkipped == true )
endfunction

function Trig_CheeringUnitsAnimationLoop_Func008002 takes nothing returns nothing
    call ResetUnitAnimation(GetEnumUnit())
endfunction

function Trig_CheeringUnitsAnimationLoop_Actions takes nothing returns nothing
    // //
    call ForGroupBJ(GetRandomSubGroup(50, udg_CheeringUnits), function Trig_CheeringUnitsAnimationLoop_Func003002)
    // //
    call TriggerSleepAction(GetRandomReal(3.00, 7.00))
    if ( (udg_CreditsCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ForGroupBJ(udg_CheeringUnits, function Trig_CheeringUnitsAnimationLoop_Func008002)
    // //
    // //
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_CheeringUnitsAnimationLoop takes nothing returns nothing
    set gg_trg_CheeringUnitsAnimationLoop=CreateTrigger()
