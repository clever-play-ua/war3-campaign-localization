function InitTrig_Initialization takes nothing returns nothing
    set gg_trg_Initialization=CreateTrigger()
    call TriggerAddAction(gg_trg_Initialization, function Trig_Initialization_Actions)
endfunction

//===========================================================================
// Trigger: FaceAnimLoader
//===========================================================================
function Trig_FaceAnimLoader_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // //
    call CreateItemLoc('I0L0', GetRectCenter(gg_rct_LocalizationItem))
    set udg_Locale_NameTerenas=BlzGetItemTooltip(GetLastCreatedItem())
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc14Terenas01, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc14Terenas01, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    // //
    call CreateItemLoc('I0L1', GetRectCenter(gg_rct_LocalizationItem))
    set udg_Locale_NameUtok=BlzGetItemTooltip(GetLastCreatedItem())
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc14Utok_Epilogue01, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc14Utok_Epilogue01, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L2', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc14Utok_Epilogue02, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc14Utok_Epilogue02, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L3', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc14Utok_Epilogue03, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc14Utok_Epilogue03, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call SetMapFacialAnimations()
    // //
endfunction

//===========================================================================
function InitTrig_FaceAnimLoader takes nothing returns nothing
    set gg_trg_FaceAnimLoader=CreateTrigger()
    call TriggerAddAction(gg_trg_FaceAnimLoader, function Trig_FaceAnimLoader_Actions)
endfunction

//===========================================================================
// Trigger: Setup Cinematic Frame
//
// Note: this must be called in each cinematic because it gets reset back when loading from a save
//===========================================================================
function Trig_Setup_Cinematic_Frame_Actions takes nothing returns nothing
    // Hide portrait during cinematic
    call BlzFrameSetVisible(BlzGetFrameByName("HDCinematicPortraitCover", 0), false)
    // Remove the background by moving it (hiding does not work)
    call BlzFrameClearAllPoints(BlzGetFrameByName("HDCinematicBackground", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.0)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("HDCinematicBackground", 0), FRAMEPOINT_TOPRIGHT, 0.0, 0.0)
    // Set the cinematic dialogue text rectangle to the bottom center portion of the screen
    call BlzFrameClearAllPoints(BlzGetFrameByName("CinematicDialogueText", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.035)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicDialogueText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.075)
    // Set the cinematic speaker text rectangle to the bottom center portion of the screen (above dialogue text)
    call BlzFrameClearAllPoints(BlzGetFrameByName("CinematicSpeakerText", 0))
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_BOTTOMLEFT, 0.0, 0.085)
    call BlzFrameSetAbsPoint(BlzGetFrameByName("CinematicSpeakerText", 0), FRAMEPOINT_TOPRIGHT, 0.8, 0.95)
    // Set both cinematic speaker and cinematic dialogue text alignment to center
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicDialogueText", 0), TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetTextAlignment(BlzGetFrameByName("CinematicSpeakerText", 0), TEXT_JUSTIFY_BOTTOM, TEXT_JUSTIFY_CENTER)
endfunction

//===========================================================================
function InitTrig_Setup_Cinematic_Frame takes nothing returns nothing
    set gg_trg_Setup_Cinematic_Frame=CreateTrigger()
    call TriggerAddAction(gg_trg_Setup_Cinematic_Frame, function Trig_Setup_Cinematic_Frame_Actions)
endfunction

