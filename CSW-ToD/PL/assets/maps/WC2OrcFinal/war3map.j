    call ForGroupBJ(udg_AssaultGroupLokTar, function Trig_Initialization_Func073002)
    // //
    call ShowUnitHide(gg_unit_h60L_0257)
    call ShowUnitHide(gg_unit_o61W_0266)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_BattlefieldActors), function Trig_Initialization_Func079A)
    // //
    call ForGroupBJ(udg_BattlefieldActors, function Trig_Initialization_Func081002)
    // //
    call ShowUnitHide(gg_unit_h623_0265)
    call ShowUnitHide(gg_unit_o60G_0264)
    // //
    call ShowUnitHide(gg_unit_oFCD_0258)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_CheeringCrowd), function Trig_Initialization_Func089002)
    call GroupRemoveUnitSimple(gg_unit_Ntin_0010, udg_CheeringUnits)
    // //
    // //
    call QueuedTriggerAddBJ(gg_trg_EpilogueCinematicSequence, true)
endfunction

