call ExecuteFunc("jasshelper__initstructs11865265")
call ExecuteFunc("TimerUtils__init")
call ExecuteFunc("IsUnitContructing__init")

    call InitGlobals()
    call InitCustomTriggers()
    call RunInitializationTriggers()

endfunction

