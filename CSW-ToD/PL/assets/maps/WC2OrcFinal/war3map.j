endfunction

//===========================================================================
// Trigger: EpilogueCinematicSkipped
//===========================================================================
function Trig_EpilogueCinematicSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_EpilogueCinematic == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_EpilogueCinematicSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_EpilogueCinematicSkipped=true
    call QueuedTriggerRemoveBJ(gg_trg_EpilogueCinematicSequence)
    call CameraClearNoiseForPlayer(Player(0))
    call StopSoundBJ(gg_snd_WC2Orc14Terenas01, false)
    call StopSoundBJ(gg_snd_WC2Orc14Utok_Epilogue01, false)
    call StopSoundBJ(gg_snd_WC2Orc14Utok_Epilogue02, false)
    call StopSoundBJ(gg_snd_WC2Orc14Utok_Epilogue03, false)
    call ConditionalTriggerExecute(gg_trg_EpilogueCleanUp)
endfunction

//===========================================================================
function InitTrig_EpilogueCinematicSkipped takes nothing returns nothing
    set gg_trg_EpilogueCinematicSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_EpilogueCinematicSkipped, Player(0))
    call TriggerAddCondition(gg_trg_EpilogueCinematicSkipped, Condition(function Trig_EpilogueCinematicSkipped_Conditions))
    call TriggerAddAction(gg_trg_EpilogueCinematicSkipped, function Trig_EpilogueCinematicSkipped_Actions)
endfunction

//===========================================================================
// Trigger: EpilogueCleanUp
//===========================================================================
function Trig_EpilogueCleanUp_Func017002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_EpilogueCleanUp_Func018002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_EpilogueCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_EpilogueCinematic=false
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    // //
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_BlackSky, Player(0), 0)
    // //
    call SetTerrainFogExBJ(0, 6000.00, 12000.00, 0, 0.00, 0.00, 0.00)
    call SetSkyModel(null)
    // //
    call StopSoundBJ(gg_snd_Warcraft_II_Menu_Theme, false)
    // //
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_EpilogueCity), function Trig_EpilogueCleanUp_Func017002)
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_ThroneRoom), function Trig_EpilogueCleanUp_Func018002)
    // //
    call QueuedTriggerAddBJ(gg_trg_CreditsCinematic, true)
    // //
endfunction

