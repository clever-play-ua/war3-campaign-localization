//===========================================================================
// Trigger: CreditsCameraLoop
//===========================================================================
function Trig_CreditsCameraLoop_Conditions takes nothing returns boolean
    if ( not ( udg_CreditsCinematic == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_CreditsCameraLoop_Func005001 takes nothing returns boolean
    return ( udg_CreditsCinematic == false )
endfunction

function Trig_CreditsCameraLoop_Func009001 takes nothing returns boolean
    return ( udg_CreditsCinematic == false )
endfunction

function Trig_CreditsCameraLoop_Func013001 takes nothing returns boolean
    return ( udg_CreditsCinematic == false )
endfunction

function Trig_CreditsCameraLoop_Func017001 takes nothing returns boolean
    return ( udg_CreditsCinematic == false )
endfunction

function Trig_CreditsCameraLoop_Func021001 takes nothing returns boolean
    return ( udg_CreditsCinematic == false )
endfunction

function Trig_CreditsCameraLoop_Func025001 takes nothing returns boolean
    return ( udg_CreditsCinematic == false )
endfunction

function Trig_CreditsCameraLoop_Actions takes nothing returns nothing
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Credits02, Player(0), 0)
    call TriggerSleepAction(GetRandomReal(5.00, 15.00))
    if ( (udg_CreditsCinematic == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Credits03, Player(0), 0)
    call TriggerSleepAction(GetRandomReal(5.00, 15.00))
    if ( (udg_CreditsCinematic == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Credits04, Player(0), 0)
    call TriggerSleepAction(GetRandomReal(5.00, 15.00))
    if ( (udg_CreditsCinematic == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Credits05, Player(0), 0)
    call TriggerSleepAction(GetRandomReal(5.00, 15.00))
    if ( (udg_CreditsCinematic == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Credits07, Player(0), 0)
    call TriggerSleepAction(GetRandomReal(5.00, 15.00))
    if ( (udg_CreditsCinematic == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Credits01, Player(0), 0)
    call TriggerSleepAction(GetRandomReal(5.00, 15.00))
    if ( (udg_CreditsCinematic == false) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_CreditsCameraLoop takes nothing returns nothing
    set gg_trg_CreditsCameraLoop=CreateTrigger()
    call TriggerAddCondition(gg_trg_CreditsCameraLoop, Condition(function Trig_CreditsCameraLoop_Conditions))
    call TriggerAddAction(gg_trg_CreditsCameraLoop, function Trig_CreditsCameraLoop_Actions)
endfunction

//===========================================================================
// Trigger: CreditsSkipped
//===========================================================================
function Trig_CreditsSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_CreditsCinematic == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_CreditsSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_CreditsCinematicSkipped=true
    call QueuedTriggerRemoveBJ(gg_trg_CreditsCinematic)
    call ConditionalTriggerExecute(gg_trg_CreditsCleanUp)
endfunction

//===========================================================================
function InitTrig_CreditsSkipped takes nothing returns nothing
    set gg_trg_CreditsSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_CreditsSkipped, Player(0))
    call TriggerAddCondition(gg_trg_CreditsSkipped, Condition(function Trig_CreditsSkipped_Conditions))
    call TriggerAddAction(gg_trg_CreditsSkipped, function Trig_CreditsSkipped_Actions)
endfunction

//===========================================================================
// Trigger: CreditsCleanUp
//===========================================================================
function Trig_CreditsCleanUp_Func006002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_CreditsCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_CreditsCinematic=false
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_CreditsCleanUp_Func006002)
    call TriggerSleepAction(3.00)
    call CustomVictoryBJ(Player(0), false, true)
endfunction

//===========================================================================
function InitTrig_CreditsCleanUp takes nothing returns nothing
    set gg_trg_CreditsCleanUp=CreateTrigger()
    call TriggerAddAction(gg_trg_CreditsCleanUp, function Trig_CreditsCleanUp_Actions)
endfunction

//===========================================================================
function InitCustomTriggers takes nothing returns nothing
    call InitTrig_Unit_Event_Config()
    call InitTrig_Unit_Event()
    call InitTrig_Initialization()
    call InitTrig_FaceAnimLoader()
    call InitTrig_Setup_Cinematic_Frame()
    call InitTrig_MusicList()
    call InitTrig_EpilogueCinematicSequence()
    call InitTrig_EpilogueCinematicSkipped()
    call InitTrig_EpilogueCleanUp()
    call InitTrig_AssaultDirectrionTroops01()
    call InitTrig_KillKnight()
    call InitTrig_GruntAttackanim()
    call InitTrig_SliceFootman()
    call InitTrig_CreditsCinematic()
    call InitTrig_CheeringUnitsAnimationLoop()
    call InitTrig_CreditsCameraLoop()
    call InitTrig_CreditsSkipped()
    call InitTrig_CreditsCleanUp()
endfunction

//===========================================================================
function RunInitializationTriggers takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Unit_Event_Config)
    call ConditionalTriggerExecute(gg_trg_Initialization)
endfunction

