function Trig_CreditsCinematic_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetDayNightModels("environment\\dnc\\dnclordaeron\\dnclordaeronterrain\\dnclordaeronterrain.mdx", "environment\\dnc\\dnclordaeron\\dnclordaeronterrain\\dnclordaeronterrain.mdx")
    // //
    call SetTimeOfDay(0.00)
    call UseTimeOfDayBJ(false)
    // //
    call SetSkyModel("CSW\\Environment\\Sky\\BlackRockSky\\BlackRockSkybox.mdx")
    // //
    // //
    call AddWeatherEffectSaveLast(gg_rct_AshWeather, 'SNls')
    call EnableWeatherEffect(GetLastCreatedWeatherEffect(), true)
    // //
    call ConditionalTriggerExecute(gg_trg_MusicList)
    call SetMusicVolumeBJ(100.00)
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_MUSIC, 100.00)
    call ResumeMusicBJ()
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1, "ReplaceableTextures\\CameraMasks\\CreditsLogo.dds", 100.00, 100.00, 100.00, 0.00)
    call TriggerSleepAction(4.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1, "ReplaceableTextures\\CameraMasks\\CreditsLogo.dds", 100.00, 100.00, 100.00, 0.00)
    call TriggerSleepAction(2.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Credits01, Player(0), 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    // //
    set udg_CreditsCinematic=true
    // //
    call ConditionalTriggerExecute(gg_trg_CheeringUnitsAnimationLoop)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1, "ReplaceableTextures\\CameraMasks\\credits_mask.dds", 100.00, 100.00, 100.00, 0.00)
    // //
    call TriggerSleepAction(2)
    if ( (udg_CreditsCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    // LoreCraftDesigns (team)
    // //
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Maim, Player(0), 0)
    // //
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "TRIGSTR_3790", null, "TRIGSTR_3791", bj_TIMETYPE_SET, 7.00, true)
    if ( (udg_CreditsCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Orgrim, Player(0), 0)
    // //
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "TRIGSTR_3792", null, "TRIGSTR_3793", bj_TIMETYPE_SET, 7.00, true)
    if ( (udg_CreditsCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Eitrigg, Player(0), 0)
    call TransmissionFromUnitWithNameBJ(GetPlayersAll(), null, "TRIGSTR_3794", null, "TRIGSTR_3795", bj_TIMETYPE_SET, 7.00, true)
    if ( (udg_CreditsCinematicSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Utok, Player(0), 0)
