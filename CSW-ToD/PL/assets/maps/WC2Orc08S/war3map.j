    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Completed_Q_Actions takes nothing returns nothing
    call ShowDestructableBJ(true, gg_dest_B00C_0304)
    call ShowDestructableBJ(true, gg_dest_B00C_5899)
    call ShowDestructableBJ(true, gg_dest_B00C_5922)
    call ShowDestructableBJ(true, gg_dest_B00C_6025)
    call ShowDestructableBJ(true, gg_dest_B00C_6124)
    call ShowDestructableBJ(true, gg_dest_B00C_6122)
    call ShowDestructableBJ(true, gg_dest_B00C_6125)
    // //
    call ShowUnitShow(gg_unit_nglm_0278)
    call ShowUnitShow(gg_unit_nglm_0242)
    call ShowUnitShow(gg_unit_nglm_0279)
    call ShowUnitShow(gg_unit_nglm_0285)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_ngsp_0232, 'n000', gg_snd_WC2Orc08SGoblinSappers2, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    // Update the quest
    // //
    call QuestSetDiscoveredBJ(udg_Iron_Quest, true)
    call QuestItemSetCompletedBJ(udg_Iron_QR_HaltAlliance10Minutes, true)
    call QuestItemSetCompletedBJ(udg_Iron_QR_MainCampSurvive, true)
    call QuestSetCompletedBJ(udg_Iron_Quest, true)
    // //
    // Display a quest message.
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2612")
    // //
    call QueuedTriggerAddBJ(gg_trg_Scorched_Completed_TimerExpires, true)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

