function Trig_Outro_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call SetSkyModel("Environment\\Sky\\LordaeronWinterSky\\LordaeronWinterSky.mdl")
    // //
    // Show Cinematic Mountians
    // //
    call RemoveUnit(gg_unit_hrdh_0031)
    call RemoveUnit(gg_unit_hrdh_0254)
    call RemoveUnit(gg_unit_hrdh_0032)
    call RemoveUnit(gg_unit_hbot_0114)
    call RemoveUnit(gg_unit_hbot_0115)
    // //
    call SetDoodadAnimationRectBJ("stand", 'D614', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("stand", 'D618', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("stand", 'D619', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("stand", 'D61A', GetPlayableMapRect())
    // //
    call EnumDestructablesInRectAll(gg_rct_BarrelsWIthExposives, function Trig_Outro_Cinematic_Setup_Func017A)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_OutroPlayerClear, udg_Player_Actual), function Trig_Outro_Cinematic_Setup_Func021A)
    // //
    if ( Trig_Outro_Cinematic_Setup_Func023C() ) then
        call ShowUnitHide(udg_Hero_Eitrigg)
    else
    endif
    if ( Trig_Outro_Cinematic_Setup_Func024C() ) then
        call ShowUnitHide(udg_Hero_Garona)
    else
    endif
    if ( Trig_Outro_Cinematic_Setup_Func025C() ) then
        call ShowUnitHide(udg_Hero_Kurdran)
    else
    endif
    if ( Trig_Outro_Cinematic_Setup_Func026C() ) then
        call ShowUnitHide(udg_Hero_Anduin)
    else
    endif
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    call SetUnitInvulnerable(udg_Fake_Lothar, true)
    call SetUnitInvulnerable(udg_Fake_Kurdran, true)
    call SetUnitInvulnerable(udg_Fake_Eitrigg, true)
    call SetUnitInvulnerable(udg_Fake_Garona, true)
    // //
    call GroupAddUnitSimple(udg_Fake_Lothar, udg_Group_OutroHeroesHuman)
    call GroupAddUnitSimple(udg_Fake_Kurdran, udg_Group_OutroHeroesHuman)
    call GroupAddUnitSimple(udg_Fake_Eitrigg, udg_Group_OutroHeroesOrc)
    call GroupAddUnitSimple(udg_Fake_Garona, udg_Group_OutroHeroesOrc)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Elves), function Trig_Outro_Cinematic_Setup_Func043A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_NoL), function Trig_Outro_Cinematic_Setup_Func046A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_WildBlue), function Trig_Outro_Cinematic_Setup_Func049A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_WildEmerald), function Trig_Outro_Cinematic_Setup_Func052A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_WildMaroon), function Trig_Outro_Cinematic_Setup_Func055A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_WildSnow), function Trig_Outro_Cinematic_Setup_Func058A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_WildYellow), function Trig_Outro_Cinematic_Setup_Func061A)
    // //
    call ForGroupBJ(udg_Group_OutroForce, function Trig_Outro_Cinematic_Setup_Func063A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Outro_Cinematic_Setup_Func066A)
    // //
    call ForGroupBJ(udg_Group_OutroHeroesOrc, function Trig_Outro_Cinematic_Setup_Func068A)
    // //
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Eitrigg, GetRectCenter(gg_rct_OutroEitrigg01), 280.10)
    call PauseUnitBJ(true, udg_Hero_Eitrigg)
    call SetUnitOwner(udg_Fake_Eitrigg, udg_Player_CinematicBlackRock, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Garona, GetRectCenter(gg_rct_OutroGarona00), 235.88)
    call PauseUnitBJ(true, udg_Fake_Garona)
    call ShowUnitHide(udg_Fake_Garona)
    call SetUnitOwner(udg_Fake_Garona, udg_Player_CinematicBlackRock, true)
    // //
    call CreateNUnitsAtLoc(1, 'ngsp', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_OutroSappers01), 73.98)
    set udg_Unit_OutroSapper01=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_OutroSapper01, GetPlayerColor(udg_Player_Actual))
    // //
    call CreateNUnitsAtLoc(1, 'ngsp', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_OutroSappers02), 110.69)
    set udg_Unit_OutroSapper02=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_OutroSapper02, GetPlayerColor(udg_Player_Actual))
    // //
    // LastStandGrunts
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', Player(0), GetRectCenter(gg_rct_FinalStandGrunt01), GetRectCenter(gg_rct_BarrelsWIthExposives))
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_LastStandGrunts)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', Player(0), GetRectCenter(gg_rct_FinalStandGrunt02), GetRectCenter(gg_rct_BarrelsWIthExposives))
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_LastStandGrunts)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', Player(0), GetRectCenter(gg_rct_FinalStandGrunt03), GetRectCenter(gg_rct_BarrelsWIthExposives))
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_LastStandGrunts)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', Player(0), GetRectCenter(gg_rct_FinalStandGrunt04), GetRectCenter(gg_rct_BarrelsWIthExposives))
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_LastStandGrunts)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', Player(0), GetRectCenter(gg_rct_FinalStandGrunt05), GetRectCenter(gg_rct_BarrelsWIthExposives))
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_LastStandGrunts)
    // //
    call ForGroupBJ(udg_Group_LastStandGrunts, function Trig_Outro_Cinematic_Setup_Func101A)
    // //
    // Explosives
    // //
    call ShowDestructableBJ(true, gg_dest_B00C_0304)
    call ShowDestructableBJ(true, gg_dest_B00C_5899)
    call ShowDestructableBJ(true, gg_dest_B00C_5922)
    call ShowDestructableBJ(true, gg_dest_B00C_6025)
    call ShowDestructableBJ(true, gg_dest_B00C_6124)
    call ShowDestructableBJ(true, gg_dest_B00C_6122)
    call ShowDestructableBJ(true, gg_dest_B00C_6125)
    // //
    call ShowUnitShow(gg_unit_nglm_0278)
    call ShowUnitShow(gg_unit_nglm_0242)
    call ShowUnitShow(gg_unit_nglm_0279)
    call ShowUnitShow(gg_unit_nglm_0285)
    // //
    call ShowDestructableBJ(true, gg_dest_B00C_6024)
    call ShowDestructableBJ(true, gg_dest_B00C_6047)
    call ShowDestructableBJ(true, gg_dest_B00C_0342)
    call ShowDestructableBJ(true, gg_dest_B00C_5900)
    call ShowDestructableBJ(true, gg_dest_B00C_6113)
    call ShowDestructableBJ(true, gg_dest_B00C_6116)
    call ShowDestructableBJ(true, gg_dest_B00C_6121)
    // //
    call ShowUnitShow(gg_unit_nglm_0276)
    call ShowUnitShow(gg_unit_nglm_0277)
    call ShowUnitShow(gg_unit_nglm_0275)
    call ShowUnitShow(gg_unit_nglm_0255)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_BarrelsWIthExposives, Condition(function Trig_Outro_Cinematic_Setup_Func132001002)), function Trig_Outro_Cinematic_Setup_Func132A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_BarrelsWIthExposives, Condition(function Trig_Outro_Cinematic_Setup_Func135001002)), function Trig_Outro_Cinematic_Setup_Func135A)
    // //
    // //
    // //
    // //
endfunction

