function InitTrig_Intro_Cinematic_Q takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Q, function Trig_Intro_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic SetUp
//===========================================================================
function Trig_Intro_Cinematic_SetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.20)
    // //
    call ShowUnitHide(udg_Hero_Garona)
    call ShowUnitHide(udg_Hero_Eitrigg)
    call ShowUnitHide(udg_Hero_Zuljin)
    call ShowUnitHide(udg_Hero_Doomhammer)
    call ShowUnitHide(udg_SemiHero_Tharbek)
    // //
    // add a Peon For Cage
    // //
    call CreateNUnitsAtLoc(1, 'o60D', udg_Player_Actual, GetRectCenter(gg_rct_PeonBuildingCage), 163.96)
    set udg_Unit_IntroPeonWorking=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_IntroPeonWorking, "stand work")
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Doomhammer, GetRectCenter(gg_rct_IntroDH01), 295.82)
    call ShowUnitHide(udg_Fake_Doomhammer)
    call GroupAddUnitSimple(udg_Fake_Doomhammer, udg_Group_IntroUnits)
    call SetUnitOwner(udg_Fake_Doomhammer, udg_Player_CinematicBlackRock, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Tharbek, GetRectCenter(gg_rct_IntroTharbek00), 148.06)
    call SetUnitOwner(udg_Fake_Tharbek, udg_Player_CinematicBlackRock, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Eitrigg, GetRectCenter(gg_rct_IntroEitrigg01), 269.99)
    call SetUnitOwner(udg_Fake_Eitrigg, udg_Player_CinematicBlackRock, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Garona, GetRectCenter(gg_rct_GaronIntro), 261.11)
    call SetUnitOwner(udg_Fake_Garona, udg_Player_CinematicBlackRock, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Rend, GetRectCenter(gg_rct_IntroDR01), 303.62)
    call ShowUnitHide(udg_Fake_Rend)
    call GroupAddUnitSimple(udg_Fake_Rend, udg_Group_IntroUnits)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Utok, GetRectCenter(gg_rct_IntroUtok01), 314.16)
    call ShowUnitHide(udg_Fake_Utok)
    call GroupAddUnitSimple(udg_Fake_Utok, udg_Group_IntroUnits)
    call SetUnitOwner(udg_Fake_Utok, udg_Player_CinematicBlackRock, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Zuljin, GetRectCenter(gg_rct_IntroZuljin01), 298.91)
    call ShowUnitHide(udg_Fake_Zuljin)
    call GroupAddUnitSimple(udg_Fake_Zuljin, udg_Group_IntroUnits)
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_SetUp takes nothing returns nothing
    set gg_trg_Intro_Cinematic_SetUp=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_SetUp, function Trig_Intro_Cinematic_SetUp_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Skipped
//===========================================================================
function Trig_Intro_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    set udg_Bool_CinematicSkipped=true
    call StopSoundBJ(gg_snd_DarkAgents01, false)
    call StopSoundBJ(gg_snd_WC2Orc08SRend1, false)
    call StopSoundBJ(gg_snd_WC2Orc08SRend2, false)
    call StopSoundBJ(gg_snd_WC2Orc08SRend3, false)
    call StopSoundBJ(gg_snd_WC2Orc08SRend4, false)
    call StopSoundBJ(gg_snd_WC2Orc08SRend5, false)
    call StopSoundBJ(gg_snd_WC2Orc08STharbek1, false)
    call StopSoundBJ(gg_snd_WC2Orc08STharbek2, false)
    call StopSoundBJ(gg_snd_WC2Orc08SDoomhammer1, false)
    call StopSoundBJ(gg_snd_WC2Orc08SDoomhammer2, false)
    call StopSoundBJ(gg_snd_WC2Orc08SDoomhammer3, false)
    call StopSoundBJ(gg_snd_WC2Orc08SDoomhammer4, false)
    call StopSoundBJ(gg_snd_WC2Orc08SDoomhammer5, false)
    call StopSoundBJ(gg_snd_WC2Orc08SDoomhammer6, false)
    call StopSoundBJ(gg_snd_WC2Orc08SDoomhammer7, false)
    call StopSoundBJ(gg_snd_WC2Orc08SEitrigg1, false)
    call StopSoundBJ(gg_snd_WC2Orc08SEitrigg2, false)
    call StopSoundBJ(gg_snd_WC2Orc08SZuljin1, false)
    call StopSoundBJ(gg_snd_WC2Orc08SZuljin2, false)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Intro_Cinematic_Skipped, Condition(function Trig_Intro_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_Skipped, function Trig_Intro_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Cleanup
//===========================================================================
function Trig_Intro_Cinematic_Cleanup_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func052C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_IntroDH03B, udg_Hero_Doomhammer) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func054C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_IntroZuljin04, udg_Hero_Zuljin) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func056C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_IntroTharbek03, udg_SemiHero_Tharbek) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func058C takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_IntroEitrigg03, udg_Hero_Eitrigg) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func062A takes nothing returns nothing
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.15)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_Cleanup_Func071C takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func080Func013Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func080Func013A takes nothing returns nothing
    if ( Trig_Intro_Cinematic_Cleanup_Func080Func013Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_Intro_Cinematic_Cleanup_Func080C takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func094C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    // Game Settings
    // //
    set udg_Bool_CinIntroOn=false
    call SetSkyModel(null)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call TriggerSleepAction(0.10)
    // //
    // //
    call EnableTrigger(gg_trg_Eitrigg_Patrol_A)
    call EnableTrigger(gg_trg_Eitrigg_Patrol_B)
    call EnableTrigger(gg_trg_Eitrigg_Patrol_C)
    call EnableTrigger(gg_trg_Eitrigg_Patrol_D)
    // //
    call SetPlayerColorBJ(udg_Player_CinematicBlackRock, PLAYER_COLOR_RED, false)
    call UseTimeOfDayBJ(true)
    // //
    // RemoveExits
    // //
    call RemoveUnit(udg_Unit_IntroPig)
    call RemoveUnit(udg_Unit_IntroGrunt01)
    call RemoveUnit(udg_Unit_IntroGrunt02)
    call RemoveUnit(udg_Unit_IntroTroll01)
    call RemoveUnit(udg_Unit_IntroTroll02)
    // //
    // Unit Settings
    // //
    call ShowUnitShow(udg_SemiHero_Tharbek)
    // //
    call ShowUnitShow(udg_Hero_Eitrigg)
    call SetUnitOwner(udg_Hero_Eitrigg, udg_Player_CinematicBlackRock, false)
    call UnitShareVisionBJ(true, udg_Hero_Eitrigg, udg_Player_Actual)
    // //
    call UnitShareVisionBJ(true, udg_Hero_Garona, udg_Player_Actual)
    call ShowUnitShow(udg_Hero_Garona)
    // //
    call SetUnitOwner(udg_Hero_Garona, Player(3), false)
    call PauseUnitBJ(true, udg_Hero_Garona)
    call SetUnitAnimation(udg_Hero_Garona, "cinematic trapped")
    call SetUnitScalePercent(udg_Hero_Garona, 120.00, 120.00, 120.00)
    // //
    call ShowUnitShow(udg_Hero_Doomhammer)
    // //
    call ShowUnitShow(udg_Hero_Zuljin)
    call SetUnitOwner(udg_Hero_Zuljin, udg_Player_Actual, false)
    call IssuePointOrderLocBJ(udg_Hero_Zuljin, "move", GetRectCenter(gg_rct_IntroZuljin04))
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func052C() ) then
        call SetUnitPositionLocFacingBJ(udg_Hero_Doomhammer, GetRectCenter(gg_rct_IntroDH03B), 241.39)
    else
    endif
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func054C() ) then
        call SetUnitPositionLocFacingBJ(udg_Hero_Zuljin, GetRectCenter(gg_rct_IntroZuljin04), 328.92)
    else
    endif
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func056C() ) then
        call SetUnitPositionLocFacingBJ(udg_SemiHero_Tharbek, GetRectCenter(gg_rct_IntroTharbek03), 236.20)
    else
    endif
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func058C() ) then
        call SetUnitPositionLocFacingBJ(udg_Hero_Eitrigg, GetRectCenter(gg_rct_IntroEitrigg03), 212.08)
    else
    endif
    // //
    call IssuePointOrderLocBJ(udg_Hero_Eitrigg, "attack", GetRectCenter(gg_rct_BasePatrol01))
    // //
    call ForGroupBJ(udg_Group_IntroUnits, function Trig_Intro_Cinematic_Cleanup_Func062A)
    // //
    call SetUnitMoveSpeed(udg_SemiHero_Tharbek, 270.00)
    call BlzSetUnitRealFieldBJ(udg_SemiHero_Tharbek, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_SemiHero_Tharbek)
    // //
    // ResetDoomhammer
    call RemoveUnit(udg_Unit_DoomhammersWolf)
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func071C() ) then
        call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_AnimReset)
    else
    endif
    // Hide Cinematic Mountains
    call SetDoodadAnimationRectBJ("death", 'D614', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'D618', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'D619', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'D61A', GetPlayableMapRect())
    // //
    // Skipped
    // //
    if ( Trig_Intro_Cinematic_Cleanup_Func080C() ) then
        call CameraSetFocalDistance(0.00)
        call CameraSetDepthOfFieldScale(0.00)
        // //
        call IssueTargetOrderBJ(udg_Unit_IntroPeon01, "harvest", gg_unit_ngol_0122)
        call IssueTargetDestructableOrder(udg_Unit_IntroPeon02, "harvest", gg_dest_VTlt_0194)
        // //
        call RemoveUnit(udg_Unit_IntroPeonWorking)
        call ShowUnitShow(udg_Hero_Garona)
        call SetUnitAnimation(udg_Hero_Garona, "cinematic stand alternate")
        call ShowUnitShow(udg_Hero_Eitrigg)
        call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_AnimReset)
        // RemoveBlockers
        call EnumDestructablesInRectAll(gg_rct_IntroBlockers, function Trig_Intro_Cinematic_Cleanup_Func080Func013A)
        call IssuePointOrderLocBJ(udg_Hero_Eitrigg, "attack", GetRectCenter(gg_rct_BasePatrol01))
    else
    endif
    // Player Selection
    call SelectUnitAddForPlayer(udg_Hero_Doomhammer, udg_Player_Actual)
    call SelectUnitAddForPlayer(udg_SemiHero_Tharbek, udg_Player_Actual)
    call SelectUnitAddForPlayer(udg_Hero_Zuljin, udg_Player_Actual)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_Intro11), 0)
    call TriggerSleepAction(0.01)
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // ----------------------------------------
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func094C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    // Quests
    call ConditionalTriggerExecute(gg_trg_Scorched_Discover)
    call QueuedTriggerAddBJ(gg_trg_Third_Discover_Q, true)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Intro_Cinematic_Cleanup, function Trig_Intro_Cinematic_Cleanup_Actions)
endfunction

