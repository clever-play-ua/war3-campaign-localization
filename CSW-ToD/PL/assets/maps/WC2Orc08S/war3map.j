    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_More_Failed_Q_Func020C takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_More_Quest) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_More_Failed_Q_Actions takes nothing returns nothing
    // //
    // Update the quest
    // //
    call QuestItemSetCompletedBJ(udg_More_QR_Rally, false)
    call QuestSetFailedBJ(udg_More_Quest, true)
    // //
    call DestroyMinimapIcon(udg_TrollMarker01)
    call DestroyMinimapIcon(udg_TrollMarker02)
    call DestroyMinimapIcon(udg_TrollMarker03)
    call DestroyMinimapIcon(udg_TrollMarker04)
    call DestroyMinimapIcon(udg_TrollMarker05)
    // //
    call UnitAddAbility(udg_Unit_TrollCircle01, 'Aloc')
    call UnitAddAbility(udg_Unit_TrollCircle02, 'Aloc')
    call UnitAddAbility(udg_Unit_TrollCircle03, 'Aloc')
    call UnitAddAbility(udg_Unit_TrollCircle04, 'Aloc')
    call UnitAddAbility(udg_Unit_TrollCircle05, 'Aloc')
    // //
    if ( Trig_More_Failed_Q_Func020C() ) then
        // Display a quest message.
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_2637")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    else
    endif
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

