        return false
    endif
    return true
endfunction

function Trig_More_Discover_Q_Func019C takes nothing returns boolean
    if ( not ( udg_Bool_TrollCap05 == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_More_Discover_Q_Actions takes nothing returns nothing
    // //
    // Update the quest
    // //
    call QuestSetDiscoveredBJ(udg_More_Quest, true)
    // //
    // Display a quest message.
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2552")
    // //
    if ( Trig_More_Discover_Q_Func011C() ) then
        call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase01), 5.00)
        call DestroyMinimapIcon(udg_TrollMarker01)
        call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase01), bj_CAMPPINGSTYLE_BONUS)
        set udg_TrollMarker01=GetLastCreatedMinimapIcon()
    else
    endif
    // //
    if ( Trig_More_Discover_Q_Func013C() ) then
        call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase02), 5.00)
        call DestroyMinimapIcon(udg_TrollMarker02)
        call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase02), bj_CAMPPINGSTYLE_BONUS)
        set udg_TrollMarker02=GetLastCreatedMinimapIcon()
    else
    endif
    // //
    if ( Trig_More_Discover_Q_Func015C() ) then
        call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase03), 5.00)
        call DestroyMinimapIcon(udg_TrollMarker03)
        call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase03), bj_CAMPPINGSTYLE_BONUS)
        set udg_TrollMarker03=GetLastCreatedMinimapIcon()
    else
    endif
    // //
    if ( Trig_More_Discover_Q_Func017C() ) then
        call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase04), 5.00)
        call DestroyMinimapIcon(udg_TrollMarker04)
        call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase04), bj_CAMPPINGSTYLE_BONUS)
        set udg_TrollMarker04=GetLastCreatedMinimapIcon()
    else
    endif
    // //
    if ( Trig_More_Discover_Q_Func019C() ) then
        call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase05), 5.00)
        call DestroyMinimapIcon(udg_TrollMarker05)
        call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase05), bj_CAMPPINGSTYLE_BONUS)
        set udg_TrollMarker05=GetLastCreatedMinimapIcon()
    else
    endif
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // //
    // //
    // //
    // //
endfunction

