function Trig_Eradication_Discover_Func006C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetAttacker()) == udg_Player_WildEmerald ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetAttacker()) == udg_Player_Actual ) ) then
        return true
    endif
    return false
endfunction

