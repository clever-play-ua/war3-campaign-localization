    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mid_Cinematic_Cleanup_Actions takes nothing returns nothing
    // Fade Faster If Cinematic Skipped
    if ( Trig_Mid_Cinematic_Cleanup_Func002C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    set udg_Bool_CinMidOn=false
    // //
    // Game Settings
    // //
    call SetSkyModel(null)
    // //
    // Unit Settings
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call ConditionalTriggerExecute(gg_trg_Mid_Cinematic_AnimReset)
    call EnableTrigger(gg_trg_IronChase_HeroLife)
    // //
    call ShowUnitShow(udg_Hero_Anduin)
    call ShowUnitShow(udg_Hero_Doomhammer)
    call ShowUnitShow(udg_Hero_Kurdran)
    call ShowUnitShow(udg_Hero_Zuljin)
    // //
    if ( Trig_Mid_Cinematic_Cleanup_Func021C() ) then
        call SetUnitPositionLocFacingBJ(udg_Hero_Doomhammer, GetRectCenter(gg_rct_MidDH01), 180.00)
    else
        call ReviveHeroLoc(udg_Hero_Doomhammer, GetRectCenter(gg_rct_MidDH01), false)
        call SetUnitFacingTimed(udg_Hero_Doomhammer, 180.00, 0)
    endif
    // //
    if ( Trig_Mid_Cinematic_Cleanup_Func023C() ) then
        call SetUnitPositionLocFacingBJ(udg_Hero_Zuljin, GetRectCenter(gg_rct_MidZuljin01), 180.00)
    else
        call ReviveHeroLoc(udg_Hero_Zuljin, GetRectCenter(gg_rct_MidZuljin01), false)
        call SetUnitFacingTimed(udg_Hero_Zuljin, 180.00, 0)
    endif
    // //
    call PauseAllUnitsBJ(false)
    // //
    call SuspendHeroXPBJ(false, udg_Hero_Doomhammer)
    call SuspendHeroXPBJ(false, udg_Hero_Zuljin)
    call SuspendHeroXPBJ(true, udg_Hero_Eitrigg)
    // //
    call PauseUnitBJ(true, gg_unit_hbot_0115)
    call PauseUnitBJ(true, gg_unit_hbot_0114)
    // //
    call PauseUnitBJ(true, udg_Hero_Garona)
    // //
    call SetUnitInvulnerable(udg_Hero_Anduin, false)
    call SetUnitInvulnerable(udg_Hero_Doomhammer, false)
    call SetUnitInvulnerable(udg_Hero_Kurdran, false)
    call SetUnitInvulnerable(udg_Hero_Zuljin, false)
    call SetUnitInvulnerable(udg_Hero_Eitrigg, false)
    // //
    call SetUnitInvulnerable(gg_unit_wToW_0248, false)
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_Anduin, GetRectCenter(gg_rct_MidAnduin04), 92.04)
    call SetUnitPositionLocFacingBJ(udg_Hero_Doomhammer, GetRectCenter(gg_rct_MidDH03), 266.34)
    call SetUnitPositionLocFacingBJ(udg_Hero_Kurdran, GetRectCenter(gg_rct_KurdranMidOut), 76.51)
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuljin, GetRectCenter(gg_rct_MidZuljin03), 275.51)
    // //
    call UnitRemoveAbilityBJ('A60C', udg_Hero_Zuljin)
    // //
    call SetUnitOwner(udg_Hero_Anduin, udg_Player_MidHeroesAlliance, false)
    call SetUnitOwner(udg_Hero_Doomhammer, udg_Player_MidHeroesOrc, false)
    call SetUnitOwner(udg_Hero_Kurdran, udg_Player_MidKurdran, false)
    call SetUnitOwner(udg_Hero_Zuljin, udg_Player_MidHeroesOrc, false)
    call SetUnitOwner(udg_Hero_Eitrigg, udg_Player_Actual, false)
    // //
    call SetPlayerUnitAvailableBJ('O61P', false, udg_Player_Actual)
    // //
    call IssueTargetOrderBJ(udg_Hero_Anduin, "attack", udg_Hero_Doomhammer)
    call IssueTargetOrderBJ(udg_Hero_Kurdran, "attack", udg_Hero_Zuljin)
    call IssueTargetOrderBJ(udg_Hero_Doomhammer, "attack", udg_Hero_Anduin)
    call IssueTargetOrderBJ(udg_Hero_Zuljin, "attack", udg_Hero_Kurdran)
    // //
    call EnableTrigger(gg_trg_IronChase_HeroesAttack)
    call DisableTrigger(gg_trg_Eitrigg_Patrol_A)
    call DisableTrigger(gg_trg_Eitrigg_Patrol_B)
    call DisableTrigger(gg_trg_Eitrigg_Patrol_C)
    call DisableTrigger(gg_trg_Eitrigg_Patrol_D)
    // //
    call CreateNUnitsAtLoc(1, 'h60B', udg_Player_NoL, GetRectCenter(gg_rct_MidAnduinGuard02), 115.83)
    call CreateNUnitsAtLoc(1, 'h60B', udg_Player_NoL, GetRectCenter(gg_rct_MidAnduinGuard03), 115.83)
    call CreateNUnitsAtLoc(1, 'h60K', udg_Player_NoL, GetRectCenter(gg_rct_MidAnduinGuard04), 115.15)
    // //
    call UnitShareVisionBJ(true, udg_Hero_Doomhammer, udg_Player_Actual)
    call UnitShareVisionBJ(true, udg_Hero_Zuljin, udg_Player_Actual)
    // //
    call SetUnitPositionLocFacingBJ(udg_Unit_AllianceGuard03, GetRectCenter(gg_rct_AllianceGuard03), 256.62)
    call SetUnitPositionLocFacingBJ(udg_Unit_AllianceGuard04, GetRectCenter(gg_rct_AllianceGuard04), 37.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_AllianceGuard05, GetRectCenter(gg_rct_AllianceGuard05), 320.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_AllianceGuard06, GetRectCenter(gg_rct_AllianceGuard06), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_AllianceGuard07, GetRectCenter(gg_rct_AllianceGuard07), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Unit_AllianceGuard08, GetRectCenter(gg_rct_AllianceGuard08), 230.60)
    call SetUnitPositionLocFacingBJ(udg_Unit_AllianceGuard09, GetRectCenter(gg_rct_AllianceGuard09), 265.09)
    // //
    call EnableTrigger(gg_trg_IronChase_Army_Exit)
    call EnableTrigger(gg_trg_MidHeroesExitOriginalOrgrim)
    call EnableTrigger(gg_trg_MidHeroesExitOriginalZuljin)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_MidAlliance, Condition(function Trig_Mid_Cinematic_Cleanup_Func091001002)), function Trig_Mid_Cinematic_Cleanup_Func091A)
    // //
    // //
    call EnumDestructablesInRectAll(gg_rct_MidPlatforms, function Trig_Mid_Cinematic_Cleanup_Func094A)
    // //
    call DisableTrigger(gg_trg_Eitrigg_Life)
    call ConditionalTriggerExecute(gg_trg_IronChase_Start)
    call ConditionalTriggerExecute(gg_trg_Invasion_SpawnControl)
    call EnableTrigger(gg_trg_Invasion_SpawnOrder)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_MidOutro), 0)
    // //
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // ----------------------------------------
    call ForGroupBJ(udg_Group_PlayerSelection, function Trig_Mid_Cinematic_Cleanup_Func109A)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Mid_Cinematic_Cleanup_Func112C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    call QueuedTriggerRemoveBJ(gg_trg_Mid_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Iron_Discover)
endfunction

//===========================================================================
function InitTrig_Mid_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Mid_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Mid_Cinematic_Cleanup, function Trig_Mid_Cinematic_Cleanup_Actions)
endfunction

