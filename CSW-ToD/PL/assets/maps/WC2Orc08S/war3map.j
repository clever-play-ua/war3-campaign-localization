    endif
    return true
endfunction

function Trig_Mid_Cinematic_Setup_Func045A takes nothing returns nothing
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.25)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", GetEnumUnit())
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(GetEnumUnit(), 100.00)
    if ( Trig_Mid_Cinematic_Setup_Func045Func005C() ) then
        call SetUnitAnimationWithRarity(GetEnumUnit(), "stand", RARITY_FREQUENT)
    else
        if ( Trig_Mid_Cinematic_Setup_Func045Func005Func001C() ) then
            call SetUnitAnimation(GetEnumUnit(), "cinematic listening one")
        else
        endif
    endif
endfunction

function Trig_Mid_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call SetSkyModel("Environment\\Sky\\LordaeronWinterSky\\LordaeronWinterSky.mdl")
    // //
    call ShowUnitHide(udg_Hero_Zuljin)
    call ShowUnitHide(udg_Hero_Doomhammer)
    // //
    call PauseAllUnitsBJ(true)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    // //
    call SetStackedSoundBJ(true, gg_snd_ConstructionLoop1, gg_rct_MidAlliance)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_MidPlayerClear, udg_Player_Actual), function Trig_Mid_Cinematic_Setup_Func017A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_MidPlayerClear, udg_Player_Actual), function Trig_Mid_Cinematic_Setup_Func020A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Mid_Cinematic_Setup_Func023A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_TribeWarriors), function Trig_Mid_Cinematic_Setup_Func026A)
    // //
    call ForGroupBJ(udg_Group_MidUnits, function Trig_Mid_Cinematic_Setup_Func028A)
    // //
    call ShowUnitHide(udg_Hero_Anduin)
    call ShowUnitHide(udg_Hero_Kurdran)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Zuljin, GetRectCenter(gg_rct_MidZuljin01), 180.00)
    call SetUnitOwner(udg_Fake_Zuljin, udg_Player_CinematicZuljin, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Doomhammer, GetRectCenter(gg_rct_MidDH01), 180.00)
    call SetUnitOwner(udg_Fake_Doomhammer, udg_Player_CinematicBlackRock, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Lothar, GetRectCenter(gg_rct_MidAnduin01), 290.30)
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic listening one")
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Kurdran, GetRectCenter(gg_rct_MidKurdran01), 210.19)
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic listening one")
    // //
    call ForGroupBJ(udg_Group_MidUnits, function Trig_Mid_Cinematic_Setup_Func045A)
    // //
    call SetDoodadAnimationRectBJ("stand", 'NOfp', gg_rct_CampfireControl)
    call SetUnitAnimation(gg_unit_h005_0027, "birth")
    call SetUnitAnimation(gg_unit_h005_0108, "birth")
    call SetUnitAnimation(gg_unit_h005_0034, "birth")
    call SetUnitAnimation(gg_unit_h004_0111, "birth upgrade first")
    call SetUnitAnimation(gg_unit_h60Z_0240, "birth upgrade first")
    call SetUnitAnimation(gg_unit_h60Z_0241, "birth upgrade first")
    // //
    call SetUnitInvulnerable(udg_Fake_Lothar, true)
    call SetUnitInvulnerable(udg_Fake_Doomhammer, true)
    call SetUnitInvulnerable(udg_Fake_Kurdran, true)
    call SetUnitInvulnerable(udg_Fake_Zuljin, true)
    call SetUnitInvulnerable(gg_unit_wToW_0248, true)
    // //
    // //
    // //
    // //
endfunction

