//===========================================================================
// Trigger: Iron Failed NoBuildings
//===========================================================================
function Trig_Iron_Failed_NoBuildings_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Failed_NoBuildings_Func002Func001C takes nothing returns boolean
    if ( not ( GetPlayerState(udg_Player_Actual, PLAYER_STATE_RESOURCE_FOOD_USED) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Failed_NoBuildings_Func002Func006001001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_Iron_Failed_NoBuildings_Func002Func006001001002002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Iron_Failed_NoBuildings_Func002Func006001001002002002 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_PlayerBase, GetFilterUnit()) == true )
endfunction

function Trig_Iron_Failed_NoBuildings_Func002Func006001001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (RectContainsUnit(gg_rct_PlayerBase, GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Iron_Failed_NoBuildings_Func002Func006001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (RectContainsUnit(gg_rct_PlayerBase, GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_Iron_Failed_NoBuildings_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(GetOwningPlayer(GetTriggerUnit()), Condition(function Trig_Iron_Failed_NoBuildings_Func002Func006001001002))) == 0 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Failed_NoBuildings_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Iron_Failed_NoBuildings_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Int_FailReason=2
        call QueuedTriggerClearBJ()
        call QueuedTriggerAddBJ(gg_trg_Iron_Failed_Q, true)
    else
        if ( Trig_Iron_Failed_NoBuildings_Func002Func001C() ) then
            call DisableTrigger(GetTriggeringTrigger())
            set udg_Int_FailReason=1
            call QueuedTriggerClearBJ()
            call QueuedTriggerAddBJ(gg_trg_Iron_Failed_Q, true)
        else
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Iron_Failed_NoBuildings takes nothing returns nothing
    set gg_trg_Iron_Failed_NoBuildings=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Iron_Failed_NoBuildings, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Iron_Failed_NoBuildings, Condition(function Trig_Iron_Failed_NoBuildings_Conditions))
    call TriggerAddAction(gg_trg_Iron_Failed_NoBuildings, function Trig_Iron_Failed_NoBuildings_Actions)
endfunction

//===========================================================================
// Trigger: Iron Failed Q
//===========================================================================
function Trig_Iron_Failed_Q_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Failed_Q_Func008C takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_Iron_Quest) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Failed_Q_Func012Func001C takes nothing returns boolean
    if ( not ( udg_Int_FailReason == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Failed_Q_Func012C takes nothing returns boolean
    if ( not ( udg_Int_FailReason == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Failed_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_Failed=true
    // //
    // Update the quest
    // //
    if ( Trig_Iron_Failed_Q_Func008C() ) then
        call QuestItemSetCompletedBJ(udg_Iron_QR_HaltAlliance10Minutes, false)
        call QuestItemSetCompletedBJ(udg_Iron_QR_MainCampSurvive, false)
        call QuestSetFailedBJ(udg_Iron_Quest, true)
    else
    endif
    // //
    // Display a quest message.
    // //
    if ( Trig_Iron_Failed_Q_Func012C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_2680")
    else
        if ( Trig_Iron_Failed_Q_Func012Func001C() ) then
            call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_2761")
        else
        endif
    endif
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_Failure_Cinematic_Q, true)
endfunction

//===========================================================================
function InitTrig_Iron_Failed_Q takes nothing returns nothing
    set gg_trg_Iron_Failed_Q=CreateTrigger()
    call TriggerAddCondition(gg_trg_Iron_Failed_Q, Condition(function Trig_Iron_Failed_Q_Conditions))
    call TriggerAddAction(gg_trg_Iron_Failed_Q, function Trig_Iron_Failed_Q_Actions)
endfunction

//===========================================================================
// Trigger: Iron TimerCreate
//===========================================================================
function Trig_Iron_TimerCreate_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_TimerCreate_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call StartTimerBJ(udg_Timer_IronOrc, false, 600.00)
    // //
    call CreateTimerDialogBJ(udg_Timer_IronOrc, "TRIGSTR_2993")
    set udg_TimerWindow_IronOrc=GetLastCreatedTimerDialogBJ()
    // //
    call TimerDialogDisplayForPlayerBJ(true, udg_TimerWindow_IronOrc, udg_Player_Actual)
    // //
    call StartTimerBJ(udg_Eradication_HiddenUnitTimer, false, 480.00)
    // //
    call SetUnitAnimation(gg_unit_ngsp_0232, "stand work")
    call SetUnitAnimation(gg_unit_ngsp_0234, "stand work")
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroSappers02), "sharedfx\\scarabburrow\\scarabburrow.mdl")
    set udg_SE_GoblinWorkDust[1]=GetLastCreatedEffectBJ()
    // //
    call SetStackedSoundBJ(true, gg_snd_ConstructionLoop101, gg_rct_OutroSappers01)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroSappers01), "sharedfx\\scarabburrow\\scarabburrow.mdl")
    set udg_SE_GoblinWorkDust[2]=GetLastCreatedEffectBJ()
    call SetStackedSoundBJ(true, gg_snd_ConstructionLoop102, gg_rct_OutroSappers02)
    // //
    // change color for player for landmines
    // //
    call SetPlayerColorBJ(udg_Player_CinematicBlackRock, PLAYER_COLOR_RED, true)
    // //
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    set udg_Music_CurrentName=""
    call ClearMapMusicBJ()
    // //
    set udg_Music_CurrentName="Warcraft2\\Music\\OrcCinematicThemeTension,mp3"
    call TriggerSleepAction(0.00)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    call PlayThematicMusicBJ("Warcraft2\\Music\\OrcCinematicThemeTension.mp3")
    // //
    call StartTimerBJ(udg_Timer_GoblinsSetUpBombs01, false, 120.00)
endfunction

