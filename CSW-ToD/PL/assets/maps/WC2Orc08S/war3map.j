//===========================================================================
// Trigger: Scorched Update1 Q
//===========================================================================
function Trig_Scorched_Update1_Q_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_Update1_Q_Actions takes nothing returns nothing
    call QuestItemSetDescriptionBJ(udg_Scorched_QR_DestroySettlements, ( BlzGetItemDescription(gg_item_IQL2_0409) + ( I2S(udg_Int_ScorchedSettlementsCount) + BlzGetItemTooltip(gg_item_IQL0_0401) ) ))
    set udg_newLine="\n"
    // //
    set udg_String_CompletedQuests=( GetItemName(gg_item_IQL0_0401) + ( udg_newLine + BlzGetItemDescription(gg_item_IQL0_0401) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemExtendedTooltip(gg_item_IQL0_0401) + ( I2S(udg_Int_ScorchedSettlementsCount) + BlzGetItemTooltip(gg_item_IQL0_0401) ) ) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL1_0403) ) )
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Scorched_Update1_Q takes nothing returns nothing
    set gg_trg_Scorched_Update1_Q=CreateTrigger()
    call TriggerAddCondition(gg_trg_Scorched_Update1_Q, Condition(function Trig_Scorched_Update1_Q_Conditions))
    call TriggerAddAction(gg_trg_Scorched_Update1_Q, function Trig_Scorched_Update1_Q_Actions)
