    call SetDestructableInvulnerableBJ(udg_Cage_Garona, true)
    call SetUnitInvulnerable(udg_Hero_Garona, true)
    call PauseUnitBJ(true, gg_unit_hbot_0115)
    call PauseUnitBJ(true, gg_unit_hbot_0114)
