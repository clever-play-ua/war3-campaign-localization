function Trig_Eradication_HddenPing2_Q_Func002Func001Func003Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Eradication_HddenPing2_Q_Func002Func001Func003A takes nothing returns nothing
    if ( Trig_Eradication_HddenPing2_Q_Func002Func001Func003Func001C() ) then
        call GroupAddUnitSimple(GetEnumUnit(), udg_Group_AllianceForces)
    else
    endif
endfunction

function Trig_Eradication_HddenPing2_Q_Func002Func001Func004A takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_Eradication_HddenPing2_Q_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Eradication_HiddenUnitsStart == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Eradication_HddenPing2_Q_Func002Func004A takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_Eradication_HddenPing2_Q_Func002C takes nothing returns boolean
    if ( not ( udg_Eradication_HiddenUnitsStart == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Eradication_HddenPing2_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_Eradication_HddenPing2_Q_Func002C() ) then
        call DisableTrigger(gg_trg_Eradication_HiddenPing2B_Timer)
        call SetDoodadAnimationRectBJ("death", 'XOmr', gg_rct_WildhammerBase04GreenOpen)
        call EnumDestructablesInRectAll(gg_rct_WildhammerBaseDruids, function Trig_Eradication_HddenPing2_Q_Func002Func004A)
        call PlaySoundBJ(gg_snd_SecretFound)
        call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_WildhammerBaseDruids), 5.00)
        call PolledWait(5.00)
        call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    else
        if ( Trig_Eradication_HddenPing2_Q_Func002Func001C() ) then
            call DisableTrigger(gg_trg_Eradication_HiddenPing2A_Destructible)
            set bj_wantDestroyGroup=true
            call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_WildSnow), function Trig_Eradication_HddenPing2_Q_Func002Func001Func003A)
            call EnumDestructablesInRectAll(gg_rct_WildhammerBaseDruids, function Trig_Eradication_HddenPing2_Q_Func002Func001Func004A)
        else
        endif
    endif
endfunction

