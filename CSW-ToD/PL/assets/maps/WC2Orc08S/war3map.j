//===========================================================================
function Trig_IronChase_Start_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_IronChase_Start_Func035001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_IronChase_Start_Func037A takes nothing returns nothing
    call SetUnitMoveSpeed(GetEnumUnit(), 200.00)
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, 200.00)
endfunction

function Trig_IronChase_Start_Func041001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_MidCombat01, udg_Hero_Doomhammer) == true )
endfunction

function Trig_IronChase_Start_Func042001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_IronChase_Start_Func044001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_MidCombat01, udg_Hero_Zuljin) == true )
endfunction

function Trig_IronChase_Start_Func045001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_IronChase_Start_Func051001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_IronChase_Start_Func056001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_MidCombat02, udg_Hero_Doomhammer) == true )
endfunction

function Trig_IronChase_Start_Func057001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_IronChase_Start_Func059001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_MidCombat02, udg_Hero_Zuljin) == true )
endfunction

function Trig_IronChase_Start_Func060001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_IronChase_Start_Func065001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_IronChase_Start_Func080001 takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_MidDHFinalLines, udg_Hero_Doomhammer) == true )
endfunction

function Trig_IronChase_Start_Func081001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_IronChase_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // //
    call GroupAddUnitSimple(udg_Hero_Anduin, udg_Group_MidChase)
    call GroupAddUnitSimple(udg_Hero_Doomhammer, udg_Group_MidChase)
    call GroupAddUnitSimple(udg_Hero_Kurdran, udg_Group_MidChase)
    call GroupAddUnitSimple(udg_Hero_Zuljin, udg_Group_MidChase)
    // //
    set udg_Point_MidDH04=GetRectCenter(gg_rct_MidDH04)
    set udg_Point_MidDH05=GetRectCenter(gg_rct_MidDH05)
    set udg_Point_MidDH06=GetRectCenter(gg_rct_MidDH06)
    set udg_Point_MidDH07=GetRectCenter(gg_rct_MidDH07)
    // //
    set udg_Point_MidAnduin05=GetRectCenter(gg_rct_MidAnduin05)
    set udg_Point_MidAnduin06=GetRectCenter(gg_rct_MidAnduin06)
    set udg_Point_MidAnduin07=GetRectCenter(gg_rct_MidAnduin07)
    // //
    set udg_Point_MidZuljin04=GetRectCenter(gg_rct_MidZuljin04)
    set udg_Point_MidZuljin05=GetRectCenter(gg_rct_MidZuljin05)
    set udg_Point_MidZuljin06=GetRectCenter(gg_rct_MidZuljin06)
    set udg_Point_MidZuljin07=GetRectCenter(gg_rct_MidZuljin07)
    // //
    set udg_Point_MidKurdran04=GetRectCenter(gg_rct_MidKurdran04)
    set udg_Point_MidKurdran05=GetRectCenter(gg_rct_MidKurdran05)
    set udg_Point_MidKurdran06=GetRectCenter(gg_rct_MidKurdran06)
    // //
    // //
    // //
    // This prevents the player cheesing
    // //
    call StartTimerBJ(udg_Timer_MidHeroesInsurance, false, 210.00)
    call EnableTrigger(gg_trg_IronChase_HeroesAttack)
    // //
    call PolledWait(20.00)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ForGroupBJ(udg_Group_MidChase, function Trig_IronChase_Start_Func037A)
    // //
    call DisableTrigger(gg_trg_IronChase_HeroesAttack)
    call EnableTrigger(gg_trg_IronChase_HeroesMove01)
    loop
        exitwhen ( (RectContainsUnit(gg_rct_MidCombat01, udg_Hero_Doomhammer) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_MidCombat01, udg_Hero_Zuljin) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call DisableTrigger(gg_trg_IronChase_HeroesMove01)
    call EnableTrigger(gg_trg_IronChase_HeroesAttack)
    // //
    call PolledWait(30.00)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call DisableTrigger(gg_trg_IronChase_HeroesAttack)
    call EnableTrigger(gg_trg_IronChase_HeroesMove02)
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_MidCombat02, udg_Hero_Doomhammer) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_MidCombat02, udg_Hero_Zuljin) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call DisableTrigger(gg_trg_IronChase_HeroesMove02)
    call EnableTrigger(gg_trg_IronChase_HeroesAttack)
    call PolledWait(30.00)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitMoveSpeed(udg_Hero_Doomhammer, GetUnitDefaultMoveSpeed(udg_Hero_Doomhammer))
    call SetUnitMoveSpeed(udg_Hero_Zuljin, GetUnitDefaultMoveSpeed(udg_Hero_Zuljin))
    call SetUnitMoveSpeed(udg_Hero_Anduin, GetUnitDefaultMoveSpeed(udg_Hero_Anduin))
    call SetUnitMoveSpeed(udg_Hero_Kurdran, GetUnitDefaultMoveSpeed(udg_Hero_Kurdran))
    call BlzSetUnitRealFieldBJ(udg_Hero_Doomhammer, UNIT_RF_ANIMATION_WALK_SPEED, 300.00)
    call BlzSetUnitRealFieldBJ(udg_Hero_Zuljin, UNIT_RF_ANIMATION_WALK_SPEED, 320.00)
    call BlzSetUnitRealFieldBJ(udg_Hero_Anduin, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call BlzSetUnitRealFieldBJ(udg_Hero_Kurdran, UNIT_RF_ANIMATION_WALK_SPEED, 290.00)
    // //
    call DisableTrigger(gg_trg_IronChase_HeroesAttack)
    call EnableTrigger(gg_trg_IronChase_HeroesMove03Alliance)
    call EnableTrigger(gg_trg_IronChase_HeroesMove03Hoard)
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_MidDHFinalLines, udg_Hero_Doomhammer) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call DisableTrigger(gg_trg_IronChase_Insurance)
    // //
    call DestroyMinimapIcon(udg_SurviveMarkerB)
    // //
    call QueuedTriggerAddBJ(gg_trg_Iron_Update_Q, true)
    // //
    // //
    // //
    // //
    // //
endfunction

