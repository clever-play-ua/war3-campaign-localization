//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func018C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Tharbek) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    // Store hero data for the next level(s)
    // //
    call ShowUnitShow(udg_Hero_Doomhammer)
    call PauseUnitBJ(false, udg_Hero_Doomhammer)
    call SetUnitVertexColorBJ(udg_Hero_Doomhammer, 100, 100, 100, 0)
    call StoreUnitBJ(udg_Hero_Doomhammer, "Doomhammer", "WC2Orc08S", udg_Cache)
    // //
    call ShowUnitShow(udg_Hero_Zuljin)
    call PauseUnitBJ(false, udg_Hero_Zuljin)
    call SetUnitVertexColorBJ(udg_Hero_Zuljin, 100, 100, 100, 0)
    call StoreUnitBJ(udg_Hero_Zuljin, "Zuljin", "WC2Orc08S", udg_Cache)
    // //
    call PolledWait(0.25)
    if ( Trig_Next_Level_Prep_Func018C() ) then
        call ShowUnitShow(udg_SemiHero_Tharbek)
        call PauseUnitBJ(false, udg_SemiHero_Tharbek)
        call SetUnitInvulnerable(udg_SemiHero_Tharbek, false)
        call SetUnitOwner(udg_SemiHero_Tharbek, udg_Player_Actual, false)
        call SetUnitVertexColorBJ(udg_SemiHero_Tharbek, 100, 100, 100, 0)
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'o608', udg_Player_Actual, GetRectCenter(gg_rct_SaveRealTharbek), GetRectCenter(gg_rct_IntroTharbek02))
        set udg_SemiHero_Tharbek=GetLastCreatedUnit()
    endif
    // //
    call PolledWait(0.25)
    // //
    call StoreUnitBJ(udg_SemiHero_Tharbek, "Tharbek", "WC2Orc08S", udg_Cache)
    call StoreIntegerBJ(GetPlayerTechCountSimple('RTX2', udg_Player_Actual), "TharbekLevel", "WC2Orc08S", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc08S", udg_Cache)
    call PolledWait(0.25)
    // //
    call SaveGameCacheBJ(udg_Cache)
    // //
    // Enable the next level in the glue screens
    // //
    call ShowCustomCampaignButton(true, 14)
    call SetNextLevelBJ("WC2Orc09.w3x")
    call ConditionalTriggerExecute(gg_trg_Victory)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

