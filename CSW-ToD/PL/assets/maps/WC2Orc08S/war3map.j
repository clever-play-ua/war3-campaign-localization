    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_WildEmerald ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_Actual ) ) then
        return true
    endif
    return false
endfunction

