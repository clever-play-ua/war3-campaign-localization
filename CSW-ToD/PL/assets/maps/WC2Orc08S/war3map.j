//===========================================================================
// Trigger: Third Discover Q
//===========================================================================
function Trig_Third_Discover_Q_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Third_Discover_Q_Actions takes nothing returns nothing
    // //
    // Update the quest
    // //
    call QuestSetDiscoveredBJ(udg_Third_Quest, true)
    // //
    // Display a quest message.
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2981")
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase01), bj_CAMPPINGSTYLE_CONTROL_ALLY)
    set udg_TrollMarker01=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase02), bj_CAMPPINGSTYLE_CONTROL_ALLY)
    set udg_TrollMarker02=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase03), bj_CAMPPINGSTYLE_CONTROL_ALLY)
    set udg_TrollMarker03=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase04), bj_CAMPPINGSTYLE_CONTROL_ALLY)
    set udg_TrollMarker04=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_TrollBase05), bj_CAMPPINGSTYLE_CONTROL_ALLY)
    set udg_TrollMarker05=GetLastCreatedMinimapIcon()
    // //
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase01), 5.00)
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase02), 5.00)
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase03), 5.00)
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase04), 5.00)
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase05), 5.00)
    // //
    call PolledWait(5.00)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

