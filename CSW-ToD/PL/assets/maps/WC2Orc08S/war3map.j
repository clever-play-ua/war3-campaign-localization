//===========================================================================
function Trig_Scorched_Discover_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_Discover_Actions takes nothing returns nothing
    call StartTimerBJ(udg_Timer_ScorchedEarth, false, udg_Real_SettlementTimerDifficulty)
    call CreateTimerDialogBJ(udg_Timer_ScorchedEarth, "TRIGSTR_2975")
    set udg_TimerWindow_ScorchedEarth=GetLastCreatedTimerDialogBJ()
    call TimerDialogDisplayForPlayerBJ(true, udg_TimerWindow_ScorchedEarth, udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_AI_Settlements_Start)
    call ConditionalTriggerExecute(gg_trg_AI_P15_Start)
    call QueuedTriggerAddBJ(gg_trg_Scorched_Discover_Q, true)
endfunction

