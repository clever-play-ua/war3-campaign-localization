//===========================================================================
// Trigger: IronChase OrcsLeave
//===========================================================================
function Trig_IronChase_OrcsLeave_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IronChase_OrcsLeave_Func004C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Tharbek) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IronChase_OrcsLeave_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_IronChase_OrcsLeave_Func004C() ) then
        call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, udg_SemiHero_Tharbek)
        call ShowUnitHide(udg_SemiHero_Tharbek)
        call PauseUnitBJ(true, udg_SemiHero_Tharbek)
        call SetUnitInvulnerable(udg_SemiHero_Tharbek, true)
        call SetUnitPositionLoc(udg_SemiHero_Tharbek, GetRectCenter(gg_rct_SaveRealTharbek))
    else
    endif
    // //
    set udg_Point_LeaveFacing=GetRectCenter(gg_rct_IntroTharbek02)
    set udg_Point_LeaveSpawn=GetRectCenter(gg_rct_OrcsLeaving)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o608', Player(2), udg_Point_LeaveSpawn, udg_Point_LeaveFacing)
    set udg_Fake_Tharbek=GetLastCreatedUnit()
    call GroupAddUnitSimple(udg_Fake_Tharbek, udg_Group_DoomhammersEscort)
    call IssuePointOrderLocBJ(udg_Fake_Tharbek, "move", udg_Point_MidDH07)
    // //
    call PolledWait(1.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60G', Player(0), udg_Point_LeaveSpawn, udg_Point_LeaveFacing)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_DoomhammersEscort)
    call SetUnitOwner(GetLastCreatedUnit(), Player(2), false)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_MidDH07)
    // //
    call PolledWait(1.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60G', Player(0), udg_Point_LeaveSpawn, udg_Point_LeaveFacing)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_DoomhammersEscort)
    call SetUnitOwner(GetLastCreatedUnit(), Player(2), false)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_MidDH07)
    // //
    call PolledWait(1.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60G', Player(0), udg_Point_LeaveSpawn, udg_Point_LeaveFacing)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_DoomhammersEscort)
    call SetUnitOwner(GetLastCreatedUnit(), Player(2), false)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_MidDH07)
    // //
    call PolledWait(1.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60G', Player(0), udg_Point_LeaveSpawn, udg_Point_LeaveFacing)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_DoomhammersEscort)
    call SetUnitOwner(GetLastCreatedUnit(), Player(2), false)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_MidDH07)
endfunction

