//===========================================================================
// Trigger: Outro Cinematic Skipped
//===========================================================================
function Trig_Outro_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Outro_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call StopSoundBJ(gg_snd_DarkVictory, false)
    call StopSoundBJ(gg_snd_Comradeship, false)
    call StopSoundBJ(gg_snd_WC2Orc08SLothar5, false)
    call StopSoundBJ(gg_snd_WC2Orc08SKurdran3, false)
    call StopSoundBJ(gg_snd_WC2Orc08SKurdran4, false)
    call StopSoundBJ(gg_snd_WC2Orc08SEitrigg7, false)
    call StopSoundBJ(gg_snd_WC2Orc08SGarona3, false)
    set udg_Bool_CinOutroSkipped=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
    call ConditionalTriggerExecute(gg_trg_Victory)
endfunction

//===========================================================================
function InitTrig_Outro_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Outro_Cinematic_Skipped=CreateTrigger()
    call DisableTrigger(gg_trg_Outro_Cinematic_Skipped)
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Outro_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Outro_Cinematic_Skipped, Condition(function Trig_Outro_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Outro_Cinematic_Skipped, function Trig_Outro_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Outro Cinematic Sway
//===========================================================================
function Trig_Outro_Cinematic_Sway_Func003001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_Sway_Func006001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_Sway_Func008001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_Sway_Func011001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_Sway_Func014001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_Sway_Actions takes nothing returns nothing
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 0.50)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 0.10)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetSourceNoiseForPlayer(udg_Player_Actual, 0.00, 0.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 0.05)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 0.02)
endfunction

//===========================================================================
function InitTrig_Outro_Cinematic_Sway takes nothing returns nothing
    set gg_trg_Outro_Cinematic_Sway=CreateTrigger()
    call DisableTrigger(gg_trg_Outro_Cinematic_Sway)
    call TriggerAddAction(gg_trg_Outro_Cinematic_Sway, function Trig_Outro_Cinematic_Sway_Actions)
endfunction

//===========================================================================
// Trigger: Outro Cinematic EitriggDeath
//
// First two waits must equal 3
// First three waits must equal 11
//===========================================================================
function Trig_Outro_Cinematic_EitriggDeath_Func013001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_Outro_Cinematic_EitriggDeath_Func015A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Outro_Cinematic_EitriggDeath_Actions takes nothing returns nothing
    call SetUnitAnimation(udg_Fake_Eitrigg, "Stand Victory")
    call QueueUnitAnimationBJ(udg_Fake_Eitrigg, "cinematic listening one")
    call TriggerSleepAction(0.50)
    // //
    call SetUnitFacingTimed(udg_Unit_OutroSapper01, 221.12, 0.50)
    call SetUnitFacingTimed(udg_Unit_OutroSapper02, 29.71, 0.40)
    // //
    call SetUnitTimeScalePercent(udg_Fake_Eitrigg, 15.00)
    call TriggerSleepAction(2.50)
    // //
    call SetUnitTimeScalePercent(udg_Fake_Eitrigg, 50.00)
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ForGroupBJ(udg_Group_LastStandGrunts, function Trig_Outro_Cinematic_EitriggDeath_Func015A)
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_SPELLS, 0.00)
    // //
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60G', udg_Player_Actual, GetRectCenter(gg_rct_FinalStandGrunt01), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60G', udg_Player_Actual, GetRectCenter(gg_rct_FinalStandGrunt02), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60G', udg_Player_Actual, GetRectCenter(gg_rct_FinalStandGrunt03), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60G', udg_Player_Actual, GetRectCenter(gg_rct_FinalStandGrunt04), GetRandomDirectionDeg())
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60G', udg_Player_Actual, GetRectCenter(gg_rct_FinalStandGrunt05), GetRandomDirectionDeg())
    // //
    call VolumeGroupSetVolumeBJ(SOUND_VOLUMEGROUP_SPELLS, 0.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Fake_Eitrigg)
    // //
    call RemoveUnit(udg_Fake_Eitrigg)
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'OEIC', udg_Player_Actual, GetRectCenter(gg_rct_OutroEitrigg03), 222.11)
    set udg_Fake_Eitrigg=GetLastCreatedUnit()
    // //
    call SetUnitTimeScalePercent(udg_Fake_Eitrigg, 1.00)
    // //
endfunction

//===========================================================================
function InitTrig_Outro_Cinematic_EitriggDeath takes nothing returns nothing
    set gg_trg_Outro_Cinematic_EitriggDeath=CreateTrigger()
    call DisableTrigger(gg_trg_Outro_Cinematic_EitriggDeath)
    call TriggerAddAction(gg_trg_Outro_Cinematic_EitriggDeath, function Trig_Outro_Cinematic_EitriggDeath_Actions)
endfunction

//===========================================================================
// Trigger: Failure Cinematic Q
//===========================================================================
function Trig_Failure_Cinematic_Q_Func019001 takes nothing returns boolean
    return ( udg_Bool_CinFailureSkipped == true )
endfunction

function Trig_Failure_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_GameOver=true
    // Settings
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    // Setup
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call TimerDialogDisplayBJ(false, udg_TimerWindow_IronOrc)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CameraSetupApplyForPlayer(true, gg_cam_Failure, udg_Player_Actual, 0)
    call ConditionalTriggerExecute(gg_trg_Failure_Cinematic_Setup)
    call TriggerSleepAction(0.25)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call PlaySoundBJ(gg_snd_WC3OrcDefeat)
    set udg_Bool_CinFailureOn=true
    // Skippable
    call EnableTrigger(gg_trg_Failure_Cinematic_Skipped)
    call TriggerSleepAction(10.00)
    if ( (udg_Bool_CinFailureSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call DisableTrigger(gg_trg_Failure_Cinematic_Skipped)
    call StopSoundBJ(gg_snd_WC3OrcDefeat, true)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    call ConditionalTriggerExecute(gg_trg_Defeat)
endfunction

//===========================================================================
function InitTrig_Failure_Cinematic_Q takes nothing returns nothing
    set gg_trg_Failure_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Failure_Cinematic_Q, function Trig_Failure_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Failure Cinematic Setup
//===========================================================================
function Trig_Failure_Cinematic_Setup_Func020A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Failure_Cinematic_Setup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call SetSkyModel("Environment\\Sky\\LordaeronWinterSky\\LordaeronWinterSky.mdl")
    // //
    // Show Cinematic Mountians
    // //
    call RemoveUnit(gg_unit_hrdh_0031)
    call RemoveUnit(gg_unit_hrdh_0254)
    call RemoveUnit(gg_unit_hrdh_0032)
    call RemoveUnit(gg_unit_hbot_0114)
    call RemoveUnit(gg_unit_hbot_0115)
    // //
    call SetDoodadAnimationRectBJ("stand", 'D614', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("stand", 'D618', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("stand", 'D619', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("stand", 'D61A', GetPlayableMapRect())
    // //
    call PauseAllUnitsBJ(true)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_OutroPlayerClear), function Trig_Failure_Cinematic_Setup_Func020A)
    // //
    call CreateNUnitsAtLoc(1, 'HLFC', udg_Player_NoL, GetRectCenter(gg_rct_FailureAnduin), 307.93)
    set udg_Unit_CinFailureAnduin=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_Unit_CinFailureAnduin, 0.35)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_CinFailureAnduin)
    call SetUnitAnimation(udg_Unit_CinFailureAnduin, "cinematic listening one")
    call SetUnitTimeScalePercent(udg_Unit_CinFailureAnduin, 50.00)
    // //
    call DestructableRestoreLife(gg_dest_OTip_3845, GetDestructableMaxLife(gg_dest_OTip_3845), false)
    call DestructableRestoreLife(gg_dest_OTip_3853, GetDestructableMaxLife(gg_dest_OTip_3845), false)
    call DestructableRestoreLife(gg_dest_OTip_3854, GetDestructableMaxLife(gg_dest_OTip_3845), false)
    // //
    call EnableTrigger(gg_trg_Failure_Cinematic_ArmyCreate)
    call TriggerSleepAction(2.00)
    call SetUnitAnimation(udg_Unit_CinFailureAnduin, "stand victory")
    call QueueUnitAnimationBJ(udg_Unit_CinFailureAnduin, "cinematic listening one")
endfunction

