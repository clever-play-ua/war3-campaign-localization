//===========================================================================
// Trigger: PeonSwap
//===========================================================================
function Trig_PeonSwap_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A610' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PeonSwap_Func003Func001001 takes nothing returns boolean
    return ( GetUnitTypeId(GetSpellAbilityUnit()) == 'n61U' )
endfunction

function Trig_PeonSwap_Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellAbilityUnit()) == 'o61X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PeonSwap_Actions takes nothing returns nothing
    if ( Trig_PeonSwap_Func003C() ) then
        call ReplaceUnitBJ(GetSpellAbilityUnit(), 'n61U', bj_UNIT_STATE_METHOD_RELATIVE)
        call SelectUnitForPlayerSingle(GetLastReplacedUnitBJ(), udg_Player_Actual)
    else
        if ( (GetUnitTypeId(GetSpellAbilityUnit()) == 'n61U') ) then // INLINED!!
            call ReplaceUnitBJ(GetSpellAbilityUnit(), 'o61X', bj_UNIT_STATE_METHOD_RELATIVE)
        else
            call DoNothing()
        endif
        call SelectUnitForPlayerSingle(GetLastReplacedUnitBJ(), udg_Player_Actual)
    endif
endfunction

