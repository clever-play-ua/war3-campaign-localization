    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Eradication_Completed_Q_Func015C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('RTX2', Player(0)) < 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Eradication_Completed_Q_Actions takes nothing returns nothing
    // //
    // Update the quest
    // //
    call QuestItemSetCompletedBJ(udg_Eradication_QR_DestroyLoreOutp, true)
    call QuestSetCompletedBJ(udg_Eradication_Quest, true)
    // //
    // Display a quest message.
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2544")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // //
    if ( Trig_Eradication_Completed_Q_Func015C() ) then
        call QueuedTriggerAddBJ(gg_trg_TharbekLevelUp, true)
