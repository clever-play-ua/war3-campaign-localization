//===========================================================================
// Trigger: Iron Update Q
//===========================================================================
function Trig_Iron_Update_Q_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Update_Q_Func005Func002001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Iron_Update_Q_Func005C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Eitrigg) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_Update_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Doomhammer, 'O602', gg_snd_WC2Orc08SDoomhammer12, bj_TIMETYPE_ADD, 0, true)
    // //
    if ( Trig_Iron_Update_Q_Func005C() ) then
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Eitrigg, 'O61P', gg_snd_WC2Orc08SEitrigg4, bj_TIMETYPE_ADD, 0, true)
        if ( (udg_Bool_GameOver == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
    else
    endif
    // //
    call VolumeGroupResetBJ()
    // //
    set udg_Bool_WaveStart=true
    // //
    call DisableTrigger(gg_trg_IronChase_HeroesMove03Hoard)
    call EnableTrigger(gg_trg_IronChase_HeroesMove04)
    call ConditionalTriggerExecute(gg_trg_IronChase_OrcsLeave)
    // //
    // Create quest part II
    // //
    call QuestItemSetCompletedBJ(udg_Iron_QR_HaltAllianceHeroes, true)
    call QuestSetDescriptionBJ(udg_Iron_Quest, "TRIGSTR_2659")
    // //
    call CreateQuestItemBJ(udg_Iron_Quest, "TRIGSTR_2658")
    set udg_Iron_QR_HaltAlliance10Minutes=GetLastCreatedQuestItemBJ()
    // //
    // Display a quest update.
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_2653")
    // //
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_SurviveMarker), 5.00)
    // //
    call ConditionalTriggerExecute(gg_trg_Iron_TimerCreate)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    // Unhide Goblins
    // //
    call ShowUnitShow(gg_unit_ngsp_0232)
    call SetUnitInvulnerable(gg_unit_ngsp_0232, true)
    call UnitShareVisionBJ(true, gg_unit_ngsp_0232, Player(0))
    call ShowUnitShow(gg_unit_ngsp_0234)
    call SetUnitInvulnerable(gg_unit_ngsp_0234, true)
    call UnitShareVisionBJ(true, gg_unit_ngsp_0234, Player(0))
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Iron_Update_Q takes nothing returns nothing
    set gg_trg_Iron_Update_Q=CreateTrigger()
    call TriggerAddCondition(gg_trg_Iron_Update_Q, Condition(function Trig_Iron_Update_Q_Conditions))
    call TriggerAddAction(gg_trg_Iron_Update_Q, function Trig_Iron_Update_Q_Actions)
endfunction

