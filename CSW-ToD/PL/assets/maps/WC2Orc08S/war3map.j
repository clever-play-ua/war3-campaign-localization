    set udg_Unit_TrollCircle02=gg_unit_ncop_0487
    set udg_Unit_TrollCircle03=gg_unit_ncop_0486
    set udg_Unit_TrollCircle04=gg_unit_ncop_0272
    set udg_Unit_TrollCircle05=gg_unit_ncop_0489
    call BlzSetUnitName(gg_unit_wStm_0107, GetItemName(gg_item_IQL2_0409))
    call UnitAddAbilityBJ('Awan', gg_unit_nspr_0105)
    // Wait till herous will be loaded from cache
    call TriggerSleepAction(0.01)
    // //
    // Groups
    call GroupAddUnitSimple(gg_unit_o619_0424, udg_Group_IntroUnits)
    call GroupAddUnitSimple(gg_unit_o619_0425, udg_Group_IntroUnits)
    // //
    set udg_Group_MidUnits=GetUnitsInRectAll(gg_rct_MidAlliance)
    call GroupAddUnitSimple(udg_SemiHero_Tharbek, udg_Group_IntroUnits)
