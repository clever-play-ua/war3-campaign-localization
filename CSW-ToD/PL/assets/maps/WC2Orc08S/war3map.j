    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Elven_Discover_Q_Actions takes nothing returns nothing
    call SetSpeechVolumeGroupsBJ()
    // //
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_Elves, 'h60S', GetCameraTargetPositionLoc(), gg_snd_WC2Orc08SElvenRanger1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Eitrigg, 'O61P', gg_snd_WC2Orc08SEitrigg3, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Doomhammer, 'O602', gg_snd_WC2Orc08SDoomhammer8, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicZuljin, 'O60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc08SZuljin6, bj_TIMETYPE_ADD, 0, true)
    // //
    call VolumeGroupResetBJ()
    // //
    // Update the quest
    // //
    call QuestSetDiscoveredBJ(udg_Elven_Quest, true)
    // //
    // Display a quest message.
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2534")
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_edob_0039), bj_CAMPPINGSTYLE_CONTROL_ENEMY)
    set udg_Elven_MinimapIcon=GetLastCreatedMinimapIcon()
    // //
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetUnitLoc(gg_unit_edob_0039), 5.00)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

