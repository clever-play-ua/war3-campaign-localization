    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( IsQuestFailed(udg_Third_Quest) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollCamps_RescueAny_Func002Func001Func002Func001C takes nothing returns boolean
    if ( not ( udg_Int_ThirdTrollCount >= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollCamps_RescueAny_Func002Func001Func002C takes nothing returns boolean
    if ( not ( udg_Int_ThirdTrollCount == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollCamps_RescueAny_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Int_ThirdTrollCount == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollCamps_RescueAny_Func002C takes nothing returns boolean
    if ( not ( udg_Int_ThirdTrollCount <= 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollCamps_RescueAny_Actions takes nothing returns nothing
    set udg_Int_ThirdTrollCount=( udg_Int_ThirdTrollCount + 1 )
    if ( Trig_TrollCamps_RescueAny_Func002C() ) then
        call QueuedTriggerAddBJ(gg_trg_Third_Update_Q, true)
    else
        if ( Trig_TrollCamps_RescueAny_Func002Func001C() ) then
            call QueuedTriggerAddBJ(gg_trg_Third_Completed_Q, true)
        else
            if ( Trig_TrollCamps_RescueAny_Func002Func001Func002C() ) then
                call QueuedTriggerAddBJ(gg_trg_More_Update_Q, true)
            else
                if ( Trig_TrollCamps_RescueAny_Func002Func001Func002Func001C() ) then
                    call DisableTrigger(GetTriggeringTrigger())
                    call QueuedTriggerAddBJ(gg_trg_More_Completed_Q, true)
                else
                endif
            endif
        endif
    endif
endfunction

