function Trig_Elven_Discover_Func001C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_Actual ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_CinematicBlackRock ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_TribeCoal ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_TribeBrown ) ) then
        return true
    endif
    return false
endfunction

