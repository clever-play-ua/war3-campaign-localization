    if ( not ( udg_Int_TrollDeadCount <= 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollCamps_Death01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_TrollCamps_Rescue1)
    // //
    set udg_Int_TrollDeadCount=( udg_Int_TrollDeadCount + 1 )
    call DestroyMinimapIcon(udg_TrollMarker01)
    // //
    call SetPlayerAllianceBJ(udg_Player_Elves, ALLIANCE_PASSIVE, true, udg_Player_TribeCoal)
    // //
    if ( Trig_TrollCamps_Death01_Func009C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_WARNING, "TRIGSTR_2988")
        call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_TrollBase01), 3.00)
    else
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_TrollCamps_DeathTooMany)
endfunction

