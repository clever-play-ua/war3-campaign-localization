//===========================================================================
function Trig_Scorched_Update_Blue_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_WildBlue ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_Update_Blue_Func002Func007001001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_Scorched_Update_Blue_Func002Func007001001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Scorched_Update_Blue_Func002Func007001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Scorched_Update_Blue_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(udg_Player_WildBlue, Condition(function Trig_Scorched_Update_Blue_Func002Func007001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_Update_Blue_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Scorched_Update_Blue_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Int_ScorchedSettlementsCount=( udg_Int_ScorchedSettlementsCount + 1 )
        call DestroyMinimapIcon(udg_SettlementMarker01Blue)
        set udg_Bool_SettlementDead01Blue=true
        call ConditionalTriggerExecute(gg_trg_AI_P02_Defeated)
        call ConditionalTriggerExecute(gg_trg_Scorched_Update1or2)
    else
    endif
endfunction

