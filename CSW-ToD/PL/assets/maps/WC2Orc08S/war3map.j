    call IssueTargetOrderBJ(gg_unit_o61X_0181, "harvest", gg_unit_ngol_0122)
    call IssueTargetOrderBJ(gg_unit_o61X_0422, "harvest", gg_unit_ngol_0122)
    call IssueTargetDestructableOrder(gg_unit_o61X_0180, "harvest", gg_dest_VTlt_0196)
    // //
