    set udg_Point_HeroPatrol[4]=GetRectCenter(gg_rct_BasePatrol04)
    set udg_Point_InvasionSpawn=GetRectCenter(gg_rct_MidAllianceSpawnGuard)
    // //
    // VisibilityControllers
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfTypeIdAll('h006'), function Trig_Init_02_Units_Func140A)
    // //
    // //
endfunction

