//===========================================================================
// Trigger: Iron TimerCreate Q2 Garona
//===========================================================================
function Trig_Iron_TimerCreate_Q2_Garona_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_TimerCreate_Q2_Garona_Func010C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Eitrigg) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Iron_TimerCreate_Q2_Garona_Func023A takes nothing returns nothing
    call KillDestructable(GetEnumDestructable())
endfunction

function Trig_Iron_TimerCreate_Q2_Garona_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call StartTimerBJ(udg_Timer_GoblinsSetUpBombs03, false, 120.00)
    call EnableTrigger(gg_trg_Iron_TimerCreate_Q3_GaronaLeaves)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Garona, 'E602', gg_snd_WC2Orc08SGarona1, bj_TIMETYPE_ADD, 0, true)
    // //
    if ( Trig_Iron_TimerCreate_Q2_Garona_Func010C() ) then
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Eitrigg, 'O61P', gg_snd_WC2Orc08SEitrigg5, bj_TIMETYPE_ADD, 0, true)
    else
    endif
    call VolumeGroupResetBJ()
    // //
    call SmartCameraPanBJ(udg_Player_Actual, CameraSetupGetDestPositionLoc(gg_cam_GaronaCam), 1.00)
    // //
    call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Hero_Garona)
    call ResetUnitLookAt(udg_Hero_Garona)
    call ResetUnitAnimation(udg_Hero_Garona)
    call SetUnitBlendTimeBJ(udg_Hero_Garona, 0.15)
    // //
    call SetUnitMoveSpeed(udg_Hero_Garona, GetUnitDefaultMoveSpeed(udg_Hero_Garona))
    call BlzSetUnitRealFieldBJ(udg_Hero_Garona, UNIT_RF_ANIMATION_WALK_SPEED, 320.00)
    // //
    call EnumDestructablesInRectAll(gg_rct_GaronaCage, function Trig_Iron_TimerCreate_Q2_Garona_Func023A)
    call PolledWait(2)
    // //
    call SetUnitOwner(udg_Hero_Garona, udg_Player_MidHeroesOrc, false)
    call PauseUnitBJ(false, udg_Hero_Garona)
    call SetUnitInvulnerable(udg_Hero_Garona, false)
    call IssuePointOrderLocBJ(udg_Hero_Garona, "attack", GetRectCenter(gg_rct_BasePatrol01))
    // //
    call PlayThematicMusicBJ("Warcraft2\\Music\\OrcCinematicThemeTension.mp3")
    // //
    call EnableTrigger(gg_trg_Garona_Patrol_A)
    call EnableTrigger(gg_trg_Garona_Patrol_B)
    call EnableTrigger(gg_trg_Garona_Patrol_C)
    call EnableTrigger(gg_trg_Garona_Patrol_D)
endfunction

//===========================================================================
function InitTrig_Iron_TimerCreate_Q2_Garona takes nothing returns nothing
    set gg_trg_Iron_TimerCreate_Q2_Garona=CreateTrigger()
    call DisableTrigger(gg_trg_Iron_TimerCreate_Q2_Garona)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Iron_TimerCreate_Q2_Garona, udg_Timer_GoblinsSetUpBombs02)
    call TriggerAddCondition(gg_trg_Iron_TimerCreate_Q2_Garona, Condition(function Trig_Iron_TimerCreate_Q2_Garona_Conditions))
    call TriggerAddAction(gg_trg_Iron_TimerCreate_Q2_Garona, function Trig_Iron_TimerCreate_Q2_Garona_Actions)
endfunction

