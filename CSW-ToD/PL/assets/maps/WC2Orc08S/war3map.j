//===========================================================================
// Trigger: Intro Cinematic AnimReset
//===========================================================================
function Trig_Intro_Cinematic_AnimReset_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_AnimReset_Func004A takes nothing returns nothing
    call SetUnitBlendTimeBJ(GetEnumUnit(), 0.15)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", GetEnumUnit())
    call SetUnitMoveSpeed(GetEnumUnit(), GetUnitDefaultMoveSpeed(GetEnumUnit()))
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_AnimReset_Func007A takes nothing returns nothing
    call ResetUnitAnimation(GetEnumUnit())
endfunction

function Trig_Intro_Cinematic_AnimReset_Func012C takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_AnimReset_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ForGroupBJ(udg_Group_IntroUnits, function Trig_Intro_Cinematic_AnimReset_Func004A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Intro_Cinematic_AnimReset_Func007A)
    // //
    call IssuePointOrderLocBJ(udg_Hero_Zuljin, "move", GetRectCenter(gg_rct_IntroZuljin04))
    call IssuePointOrderLocBJ(udg_Hero_Eitrigg, "attack", GetRectCenter(gg_rct_BasePatrol01))
    // //
    if ( Trig_Intro_Cinematic_AnimReset_Func012C() ) then
        call SetUnitScalePercent(udg_Hero_Garona, 120.00, 120.00, 120.00)
    else
        call SetUnitScalePercent(udg_Hero_Garona, 105.00, 105.00, 105.00)
        call TriggerSleepAction(0.25)
        call SetUnitScalePercent(udg_Hero_Garona, 110.00, 110.00, 110.00)
        call TriggerSleepAction(0.25)
        call SetUnitScalePercent(udg_Hero_Garona, 115.00, 115.00, 115.00)
        call TriggerSleepAction(0.25)
        call SetUnitScalePercent(udg_Hero_Garona, 120.00, 120.00, 120.00)
    endif
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_AnimReset takes nothing returns nothing
    set gg_trg_Intro_Cinematic_AnimReset=CreateTrigger()
    call TriggerAddCondition(gg_trg_Intro_Cinematic_AnimReset, Condition(function Trig_Intro_Cinematic_AnimReset_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_AnimReset, function Trig_Intro_Cinematic_AnimReset_Actions)
endfunction

