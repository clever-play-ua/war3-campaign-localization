    // Resources
    call SetResourceAmount(gg_unit_ngol_0122, 39000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 1500)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 750)
    // Upgrades
    // NoL
    call SetPlayerTechResearchedSwap('R013', 1, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R014', 3, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R01A', 3, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R00J', 3, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R00E', 1, udg_Player_NoL)
    // WHRed
    // WHYellow
endfunction

