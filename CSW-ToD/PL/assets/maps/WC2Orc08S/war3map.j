//===========================================================================
// Trigger: AI Settlements Start
//===========================================================================
function Trig_AI_Settlements_Start_Actions takes nothing returns nothing
    // //
    call SetPlayerStateBJ(udg_Player_WildBlue, PLAYER_STATE_RESOURCE_GOLD, 2000)
    call SetPlayerStateBJ(udg_Player_WildBlue, PLAYER_STATE_RESOURCE_LUMBER, 2000)
    call EnableTrigger(gg_trg_AI_P02_Gold)
    call EnableTrigger(gg_trg_AI_P02_Lumber)
    // //
    call SetPlayerStateBJ(udg_Player_WildYellow, PLAYER_STATE_RESOURCE_GOLD, 2000)
    call SetPlayerStateBJ(udg_Player_WildYellow, PLAYER_STATE_RESOURCE_LUMBER, 2000)
    call EnableTrigger(gg_trg_AI_P05_Gold)
    call EnableTrigger(gg_trg_AI_P05_Lumber)
    // //
    call SetPlayerStateBJ(udg_Player_WildMaroon, PLAYER_STATE_RESOURCE_GOLD, 2000)
    call SetPlayerStateBJ(udg_Player_WildMaroon, PLAYER_STATE_RESOURCE_LUMBER, 2000)
    call EnableTrigger(gg_trg_AI_P13_Gold)
    call EnableTrigger(gg_trg_AI_P13_Lumber)
    // //
    call StartCampaignAI(udg_Player_WildBlue, "CSW\\Scripts\\ToDScripts\\WC2Orc08S\\WC2Orc08SP02WHBlueAI.ai")
    // //
    call StartCampaignAI(udg_Player_WildYellow, "CSW\\Scripts\\ToDScripts\\WC2Orc08S\\WC2Orc08SP05WHYellowAI.ai")
    // //
    call StartCampaignAI(udg_Player_WildMaroon, "CSW\\Scripts\\ToDScripts\\WC2Orc08S\\WC2Orc08SP13WHMaroonAI.ai")
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_AI_Settlements__Gryphon_Train)
endfunction

//===========================================================================
function InitTrig_AI_Settlements_Start takes nothing returns nothing
    set gg_trg_AI_Settlements_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_Settlements_Start, function Trig_AI_Settlements_Start_Actions)
endfunction

//===========================================================================
// Trigger: AI Settlements  Gryphon Train
//===========================================================================
function Trig_AI_Settlements__Gryphon_Train_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_Settlements__Gryphon_Train_Func004A takes nothing returns nothing
    call IssueTrainOrderByIdBJ(GetEnumUnit(), 'h60N')
endfunction

function Trig_AI_Settlements__Gryphon_Train_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfTypeIdAll('h611'), function Trig_AI_Settlements__Gryphon_Train_Func004A)
    // //
    call StartTimerBJ(udg_Timer_GryphonTrainPause, false, GetRandomReal(60.00, 180.00))
endfunction

//===========================================================================
function InitTrig_AI_Settlements__Gryphon_Train takes nothing returns nothing
    set gg_trg_AI_Settlements__Gryphon_Train=CreateTrigger()
    call TriggerAddCondition(gg_trg_AI_Settlements__Gryphon_Train, Condition(function Trig_AI_Settlements__Gryphon_Train_Conditions))
    call TriggerAddAction(gg_trg_AI_Settlements__Gryphon_Train, function Trig_AI_Settlements__Gryphon_Train_Actions)
endfunction

//===========================================================================
// Trigger: AI Settlements  Gryphon Train Resume
//===========================================================================
function Trig_AI_Settlements__Gryphon_Train_Resume_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_AI_Settlements__Gryphon_Train)
endfunction

//===========================================================================
function InitTrig_AI_Settlements__Gryphon_Train_Resume takes nothing returns nothing
    set gg_trg_AI_Settlements__Gryphon_Train_Resume=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_AI_Settlements__Gryphon_Train_Resume, udg_Timer_GryphonTrainPause)
    call TriggerAddAction(gg_trg_AI_Settlements__Gryphon_Train_Resume, function Trig_AI_Settlements__Gryphon_Train_Resume_Actions)
endfunction

//===========================================================================
// Trigger: AI Settlements  Gryphon Trained
//===========================================================================
function Trig_AI_Settlements__Gryphon_Trained_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTrainedUnit()) == 'h60N' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_Settlements__Gryphon_Trained_Actions takes nothing returns nothing
    call GroupAddUnitSimple(GetTrainedUnit(), udg_Group_GryphonAttack)
    call ConditionalTriggerExecute(gg_trg_AI_Settlements__Gryphon_Attack)
endfunction

//===========================================================================
function InitTrig_AI_Settlements__Gryphon_Trained takes nothing returns nothing
    set gg_trg_AI_Settlements__Gryphon_Trained=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AI_Settlements__Gryphon_Trained, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_AI_Settlements__Gryphon_Trained, Condition(function Trig_AI_Settlements__Gryphon_Trained_Conditions))
    call TriggerAddAction(gg_trg_AI_Settlements__Gryphon_Trained, function Trig_AI_Settlements__Gryphon_Trained_Actions)
endfunction

//===========================================================================
// Trigger: AI Settlements  Gryphon Dies
//===========================================================================
function Trig_AI_Settlements__Gryphon_Dies_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetDyingUnit(), udg_Group_GryphonAttack) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_Settlements__Gryphon_Dies_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_GryphonAttack) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_Settlements__Gryphon_Dies_Actions takes nothing returns nothing
    call GroupRemoveUnitSimple(GetDyingUnit(), udg_Group_GryphonAttack)
    if ( Trig_AI_Settlements__Gryphon_Dies_Func002C() ) then
        set udg_Bool_GryphonsAttacking=false
    else
    endif
endfunction

//===========================================================================
function InitTrig_AI_Settlements__Gryphon_Dies takes nothing returns nothing
    set gg_trg_AI_Settlements__Gryphon_Dies=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AI_Settlements__Gryphon_Dies, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AI_Settlements__Gryphon_Dies, Condition(function Trig_AI_Settlements__Gryphon_Dies_Conditions))
    call TriggerAddAction(gg_trg_AI_Settlements__Gryphon_Dies, function Trig_AI_Settlements__Gryphon_Dies_Actions)
endfunction

//===========================================================================
// Trigger: AI Settlements  Gryphon Attack
//===========================================================================
function Trig_AI_Settlements__Gryphon_Attack_Conditions takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_GryphonAttack) >= udg_Int_GryphonWaveSize ) ) then
        return false
    endif
    if ( not ( udg_Bool_GryphonsAttacking == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_Settlements__Gryphon_Attack_Func007002 takes nothing returns nothing
    call IssuePointOrderLocBJ(GetEnumUnit(), "attack", udg_Point_AISettlementsAttack)
endfunction

function Trig_AI_Settlements__Gryphon_Attack_Actions takes nothing returns nothing
    // //
    set udg_Bool_GryphonsAttacking=true
    set udg_Point_AISettlementsAttack=GetRectCenter(gg_rct_PlayerRelocate)
    // //
    call ForGroupBJ(udg_Group_GryphonAttack, function Trig_AI_Settlements__Gryphon_Attack_Func007002)
    call RemoveLocation(udg_Point_AISettlementsAttack)
    // //
endfunction

//===========================================================================
function InitTrig_AI_Settlements__Gryphon_Attack takes nothing returns nothing
    set gg_trg_AI_Settlements__Gryphon_Attack=CreateTrigger()
    call TriggerAddCondition(gg_trg_AI_Settlements__Gryphon_Attack, Condition(function Trig_AI_Settlements__Gryphon_Attack_Conditions))
    call TriggerAddAction(gg_trg_AI_Settlements__Gryphon_Attack, function Trig_AI_Settlements__Gryphon_Attack_Actions)
endfunction

