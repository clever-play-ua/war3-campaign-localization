function Trig_Init_04_Environment_Actions takes nothing returns nothing
    call SetTimeOfDay(12.00)
    call UseTimeOfDayBJ(false)
    // //
    call SetSkyModel("Environment\\Sky\\LordaeronSummerSky\\LordaeronSummerSky.mdl")
    // //
    call SetDoodadAnimationRectBJ("decay", 'NOfp', gg_rct_CampfireControl)
    call EnumDestructablesInRectAll(GetPlayableMapRect(), function Trig_Init_04_Environment_Func007A)
    call EnumDestructablesInRectAll(gg_rct_OutroRocksHidden, function Trig_Init_04_Environment_Func008A)
    // HideSnow
    call EnumDestructablesInRectAll(gg_rct_PlayerBase, function Trig_Init_04_Environment_Func010A)
    call EnumDestructablesInRectAll(gg_rct_SnowedTrees05, function Trig_Init_04_Environment_Func011A)
    call EnumDestructablesInRectAll(gg_rct_SnowedTrees03, function Trig_Init_04_Environment_Func012A)
    // FailurePath
    call KillDestructable(gg_dest_OTip_3845)
    call KillDestructable(gg_dest_OTip_3853)
    call KillDestructable(gg_dest_OTip_3854)
    // Hide Barrels
    call EnumDestructablesInRectAll(gg_rct_BarrelsWIthExposives, function Trig_Init_04_Environment_Func018A)
    call ShowDestructableBJ(false, gg_dest_B00C_6024)
    call ShowDestructableBJ(false, gg_dest_B00C_6025)
    call ShowDestructableBJ(false, gg_dest_B00C_6047)
    call ShowDestructableBJ(false, gg_dest_B00C_5922)
    call ShowDestructableBJ(false, gg_dest_B00C_5899)
    call ShowDestructableBJ(false, gg_dest_B00C_0304)
    call ShowDestructableBJ(false, gg_dest_B00C_0342)
    call ShowDestructableBJ(false, gg_dest_B00C_5900)
    // ///
    call ShowDestructableBJ(false, gg_dest_B00C_6113)
    call ShowDestructableBJ(false, gg_dest_B00C_6116)
    call ShowDestructableBJ(false, gg_dest_B00C_6121)
    call ShowDestructableBJ(false, gg_dest_B00C_6124)
    call ShowDestructableBJ(false, gg_dest_B00C_6122)
    call ShowDestructableBJ(false, gg_dest_B00C_6125)
    // ///
    call SetDoodadAnimationRectBJ("stand", 'XOmr', gg_rct_WildhammerBase04GreenOpen)
    // ///
    call SetItemVisibleBJ(false, gg_item_I0LB_0388)
    call SetItemVisibleBJ(false, gg_item_I0LC_0390)
    call SetItemVisibleBJ(false, gg_item_I0LD_0400)
    call SetItemVisibleBJ(false, gg_item_IQL0_0401)
    call SetItemVisibleBJ(false, gg_item_IQL1_0403)
    call SetItemVisibleBJ(false, gg_item_IQL2_0409)
