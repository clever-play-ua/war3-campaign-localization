function Trig_Mid_Cinematic_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Settings
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    // Setup
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    if ( Trig_Mid_Cinematic_Q_Func009C() ) then
        call CameraSetupApplyForPlayer(true, gg_cam_Mid01Oversee, udg_Player_Actual, 0)
    else
        call CameraSetupApplyForPlayer(true, gg_cam_Mid01OverseeB, udg_Player_Actual, 0)
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Mid_Cinematic_Setup)
    // //
    call TriggerSleepAction(0.25)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // //
    set udg_Bool_CinMidOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call TriggerSleepAction(2.00)
    // //
    call PlaySoundBJ(gg_snd_OrcCinematicThemeA)
    // //
    // Skippable
    // //
    call EnableTrigger(gg_trg_Mid_Cinematic_Skipped)
    // //
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_Fake_Kurdran, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Kurdran, 0, gg_snd_WC2Orc08SKurdran1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SKurdran1, 0)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Lothar, 0, gg_snd_WC2Orc08SLothar1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SLothar1, 0)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Mid02, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Kurdran, 0, gg_snd_WC2Orc08SKurdran2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SKurdran2, 0)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Mid03, udg_Player_Actual, 5.00, 1.00, 1.00, 100.00)
    // //
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Mid04A, udg_Player_Actual, 0)
    // //
    call SetStackedSoundBJ(false, gg_snd_ConstructionLoop1, gg_rct_MidAlliance)
    call SetUnitPositionLocFacingBJ(udg_Fake_Lothar, GetRectCenter(gg_rct_MidAnduin02), 0.00)
    call SetUnitPositionLocFacingBJ(udg_Fake_Kurdran, GetRectCenter(gg_rct_MidKurdran02), 21.96)
    // //
    // //
    call ForGroupBJ(udg_Group_MidUnits, function Trig_Mid_Cinematic_Q_Func064A)
    // //
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic listening one")
    call SetUnitAnimation(udg_Fake_Zuljin, "cinematic listening one")
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Mid04B, udg_Player_Actual, 5.00, 0, 1.00, 100.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // //
    call IssuePointOrderLocBJ(udg_Fake_Lothar, "move", GetRectCenter(gg_rct_MidAnduin03))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley2, 80.00, udg_Hero_Doomhammer)
    // //
    call IssuePointOrderLocBJ(udg_Fake_Doomhammer, "move", GetRectCenter(gg_rct_MidDH02))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley201, 80.00, udg_Hero_Zuljin)
    call IssuePointOrderLocBJ(udg_Fake_Zuljin, "move", GetRectCenter(gg_rct_MidZuljin02))
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_MidAnduin03, udg_Fake_Lothar) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic listening one")
    loop
        exitwhen ( (RectContainsUnit(gg_rct_MidDH02, udg_Fake_Doomhammer) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic listening one")
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Doomhammer, 0, gg_snd_WC2Orc08SDoomhammer10, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SDoomhammer10, 0)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_Fake_Lothar, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Lothar, 0, gg_snd_WC2Orc08SLothar2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SLothar2, 0)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic point one")
    call QueueUnitAnimationBJ(udg_Fake_Lothar, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Lothar, 0, gg_snd_WC2Orc08SLothar3, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SLothar3, 0)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Doomhammer, 0, gg_snd_WC2Orc08SDoomhammer11, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SDoomhammer11, 0)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic point two")
    call QueueUnitAnimationBJ(udg_Fake_Lothar, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Lothar, 0, gg_snd_WC2Orc08SLothar4, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SLothar4, 2.00)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Mid05, udg_Player_Actual, 3.00, 0, 0.50, 100.00)
    // //
    call SetUnitAnimation(udg_Fake_Lothar, "spell")
    call TriggerSleepAction(1.50)
    if ( (udg_Bool_CinMidSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Not Skippable
    call StopSoundBJ(gg_snd_OrcCinematicThemeA, true)
    call DisableTrigger(gg_trg_Mid_Cinematic_Skipped)
    // End
    call ConditionalTriggerExecute(gg_trg_Mid_Cinematic_Cleanup)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

