        return false
    endif
    return true
endfunction

function Trig_More_Completed_Q_Actions takes nothing returns nothing
    // //
    // Update the quest
    // //
    call QuestSetDiscoveredBJ(udg_More_Quest, true)
    call QuestItemSetDescriptionBJ(udg_More_QR_Rally, "TRIGSTR_2814")
    call QuestItemSetCompletedBJ(udg_More_QR_Rally, true)
    call QuestSetCompletedBJ(udg_More_Quest, true)
    // //
    // Display a quest message.
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2557")
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    set udg_String_CheckpointPhase="MoreTrollsAquired"
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    if ( Trig_More_Completed_Q_Func021C() ) then
        call QueuedTriggerAddBJ(gg_trg_TharbekLevelUp, true)
    else
    endif
endfunction

