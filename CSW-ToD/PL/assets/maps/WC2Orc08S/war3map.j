//===========================================================================
// Trigger: Scorched Completed TimerExpires
//===========================================================================
function Trig_Scorched_Completed_TimerExpires_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_Completed_TimerExpires_Func005Func002C takes nothing returns boolean
    if ( not ( udg_Int_ThirdTrollCount < 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_Completed_TimerExpires_Func005C takes nothing returns boolean
    if ( not ( udg_Int_ThirdTrollCount < 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_Completed_TimerExpires_Func006C takes nothing returns boolean
    if ( not ( udg_Int_ScorchedSettlementsCount < 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_Completed_TimerExpires_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DestroyTimerDialogBJ(udg_TimerWindow_ScorchedEarth)
    if ( Trig_Scorched_Completed_TimerExpires_Func005C() ) then
        call QueuedTriggerAddBJ(gg_trg_Third_Defeat_Q, true)
        call QueuedTriggerAddBJ(gg_trg_More_Failed_Q, true)
        return
    else
        if ( Trig_Scorched_Completed_TimerExpires_Func005Func002C() ) then
            call QueuedTriggerAddBJ(gg_trg_More_Failed_Q, true)
        else
        endif
    endif
    if ( Trig_Scorched_Completed_TimerExpires_Func006C() ) then
        call QueuedTriggerAddBJ(gg_trg_Scorched_Defeat_Q, true)
        return
    else
    endif
    call SetPlayerAllianceBJ(udg_Player_Elves, ALLIANCE_PASSIVE, true, udg_Player_TribeCoal)
    call SetPlayerAllianceBJ(udg_Player_Elves, ALLIANCE_PASSIVE, true, udg_Player_TribeBrown)
    call SetPlayerAllianceBJ(udg_Player_Elves, ALLIANCE_PASSIVE, true, udg_Player_TribeMint)
    call SetPlayerAllianceBJ(udg_Player_Elves, ALLIANCE_PASSIVE, true, udg_Player_TribeLavender)
    call SetPlayerAllianceBJ(udg_Player_Elves, ALLIANCE_PASSIVE, true, udg_Player_TribePeach)
    call SetPlayerAllianceBJ(udg_Player_TribeCoal, ALLIANCE_PASSIVE, true, udg_Player_Elves)
    call SetPlayerAllianceBJ(udg_Player_TribeBrown, ALLIANCE_PASSIVE, true, udg_Player_Elves)
    call SetPlayerAllianceBJ(udg_Player_TribeMint, ALLIANCE_PASSIVE, true, udg_Player_Elves)
    call SetPlayerAllianceBJ(udg_Player_TribeLavender, ALLIANCE_PASSIVE, true, udg_Player_Elves)
    call SetPlayerAllianceBJ(udg_Player_TribePeach, ALLIANCE_PASSIVE, true, udg_Player_Elves)
    call QueuedTriggerAddBJ(gg_trg_Scorched_Completed_Q, true)
endfunction

