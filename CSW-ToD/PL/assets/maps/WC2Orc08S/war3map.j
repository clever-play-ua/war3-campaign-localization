    return true
endfunction

function Trig_TrollCamps_Rescue_Q_Func007C takes nothing returns boolean
    if ( not ( udg_VOChance == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollCamps_Rescue_Q_Actions takes nothing returns nothing
    // //
    call SetSpeechVolumeGroupsBJ()
    if ( Trig_TrollCamps_Rescue_Q_Func003C() ) then
        set udg_index=GetRandomInt(0, udg_maxIndex)
        call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_TribeWarriors, 'nfsp', GetCameraTargetPositionLoc(), udg_sampleSound[udg_index], bj_TIMETYPE_ADD, 0, false)
        if ( Trig_TrollCamps_Rescue_Q_Func003Func003C() ) then
            loop
            set udg_sampleSound[udg_index]=udg_sampleSound[( udg_index + 1 )]
            set udg_sampleText[udg_index]=udg_sampleText[( udg_index + 1 )]
            set udg_index=udg_index + 1
            exitwhen udg_index > udg_maxIndex
            endloop
        else
        endif
        set udg_maxIndex=( udg_maxIndex - 1 )
        call WaitForSoundBJ(GetLastPlayedSound(), 0)
    else
    endif
    // //
    set udg_VOChance=GetRandomInt(1, 3)
    // //
    if ( Trig_TrollCamps_Rescue_Q_Func007C() ) then
        call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicZuljin, 'O60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc08SZuljin3, bj_TIMETYPE_ADD, 0, true)
    else
        if ( Trig_TrollCamps_Rescue_Q_Func007Func001C() ) then
            call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicZuljin, 'O60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc08SZuljin4, bj_TIMETYPE_ADD, 0, true)
        else
            call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_CinematicZuljin, 'O60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc08SZuljin5, bj_TIMETYPE_ADD, 0, true)
        endif
    endif
    // //
    call VolumeGroupResetBJ()
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_TrollCamps_Rescue_Q takes nothing returns nothing
    set gg_trg_TrollCamps_Rescue_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_TrollCamps_Rescue_Q, function Trig_TrollCamps_Rescue_Q_Actions)
endfunction

