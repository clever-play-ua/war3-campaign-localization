    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_Update2_Q_Actions takes nothing returns nothing
    // Update the quest
    call QuestSetDiscoveredBJ(udg_Scorched_Quest, true)
    call QuestItemSetCompletedBJ(udg_Scorched_QR_DestroySettlements, true)
    call QuestItemSetCompletedBJ(udg_Scorched_QR_FinishBeforeAllian, true)
    // Display a quest message.
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_2434")
    call QuestItemSetDescriptionBJ(udg_Scorched_QR_DestroySettlements, "TRIGSTR_2737")
    // //
    call CreateQuestItemBJ(udg_Scorched_Quest, "TRIGSTR_2999")
    set udg_Scorched_QR_PrepareDefenses=GetLastCreatedQuestItemBJ()
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

