    set gg_trg_Scorched_Completed_TimerExpires=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Scorched_Completed_TimerExpires, udg_Timer_ScorchedEarth)
    call TriggerAddCondition(gg_trg_Scorched_Completed_TimerExpires, Condition(function Trig_Scorched_Completed_TimerExpires_Conditions))
