//===========================================================================
// Trigger: AI P15 Start
//===========================================================================
function Trig_AI_P15_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call AdjustPlayerStateBJ(2000, udg_Player_Elves, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(2000, udg_Player_Elves, PLAYER_STATE_RESOURCE_LUMBER)
    // //
    call EnableTrigger(gg_trg_AI_P15_Gold)
    call EnableTrigger(gg_trg_AI_P15_Lumber)
    // //
    call StartCampaignAI(udg_Player_Elves, "CSW\\Scripts\\ToDScripts\\WC2Orc08S\\WC2Orc08SP15ElvesAI.ai")
    call StartTimerBJ(udg_Timer_Elven, false, 60.00)
endfunction

//===========================================================================
function InitTrig_AI_P15_Start takes nothing returns nothing
    set gg_trg_AI_P15_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_P15_Start, function Trig_AI_P15_Start_Actions)
endfunction

