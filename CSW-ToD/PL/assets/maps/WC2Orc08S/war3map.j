//===========================================================================
// Trigger: Scorched WildhammerAttacked
//===========================================================================
function Trig_Scorched_WildhammerAttacked_Func004C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_WildBlue ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_WildYellow ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Player_WildMaroon ) ) then
        return true
    endif
    return false
endfunction

function Trig_Scorched_WildhammerAttacked_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    if ( not Trig_Scorched_WildhammerAttacked_Func004C() ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetAttacker()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_WildhammerAttacked_Func002Func001C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Scorched_WildhammerAttacked_Q2) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != udg_Player_SettlementVictim ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_WildhammerAttacked_Func002C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Scorched_WildhammerAttacked_Q1) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Scorched_WildhammerAttacked_Actions takes nothing returns nothing
    // //
    if ( Trig_Scorched_WildhammerAttacked_Func002C() ) then
        call QueuedTriggerAddBJ(gg_trg_Scorched_WildhammerAttacked_Q1, true)
        set udg_Player_SettlementVictim=GetOwningPlayer(GetTriggerUnit())
    else
        if ( Trig_Scorched_WildhammerAttacked_Func002Func001C() ) then
            call DisableTrigger(GetTriggeringTrigger())
            call QueuedTriggerAddBJ(gg_trg_Scorched_WildhammerAttacked_Q2, true)
        else
        endif
    endif
endfunction

