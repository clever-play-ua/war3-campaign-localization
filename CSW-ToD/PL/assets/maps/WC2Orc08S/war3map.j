function Trig_Intro_Cinematic_GroupExit_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitAnimation(udg_Fake_Utok, "cinematic salute one")
    call QueueUnitAnimationBJ(udg_Fake_Utok, "cinematic listening one")
    call PlaySoundOnUnitBJ(gg_snd_CS_H01b_Orc_gesture_v2, 100, udg_Fake_Utok)
    call PlaySoundOnUnitBJ(gg_snd_CS_BG_Camp, 100, udg_Fake_Rend)
    call IssuePointOrderLocBJ(udg_Fake_Rend, "move", GetRectCenter(gg_rct_IntroDR03))
    call TriggerSleepAction(0.40)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_IntroTroll01, "move", GetRectCenter(gg_rct_IntroTrollA02))
    call TriggerSleepAction(0.15)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_IntroTroll02, "move", GetRectCenter(gg_rct_IntroTrollB02))
    call TriggerSleepAction(0.40)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_IntroGrunt02, "move", GetRectCenter(gg_rct_IntroDRGuardB03))
    call TriggerSleepAction(0.10)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_IntroGrunt01, "move", GetRectCenter(gg_rct_IntroDRGuardA03))
    call TriggerSleepAction(0.10)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Fake_Zuljin, "move", GetRectCenter(gg_rct_IntroZuljin03))
    call TriggerSleepAction(0.25)
    call TriggerSleepAction(0.45)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Fake_Utok, "move", GetRectCenter(gg_rct_IntroUtok03))
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_GroupExit takes nothing returns nothing
    set gg_trg_Intro_Cinematic_GroupExit=CreateTrigger()
