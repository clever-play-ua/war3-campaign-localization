    call SetUnitLookAt(udg_Fake_Zuljin, "bone_head", udg_Fake_Doomhammer, 0, 0, 90)
    call SetUnitAnimation(udg_Fake_Rend, "cinematic listening one")
    call SetUnitAnimation(udg_Fake_Zuljin, "cinematic standard one")
    call ShowUnitHide(udg_Fake_Eitrigg)
    // //
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Zuljin, 0, gg_snd_WC2Orc08SZuljin1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SZuljin1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Zuljin, 0, gg_snd_WC2Orc08SZuljin2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SZuljin2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Zuljin, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Rend, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Rend, 0, gg_snd_WC2Orc08SRend3, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SRend3, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro05Doomhammer, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro04ArrivalExit, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc08SDoomhammer4) + GetSoundDurationBJ(gg_snd_WC2Orc08SDoomhammer5) ), 0, 1.00, 100.00)
    // //
    call SetUnitLookAt(udg_Fake_Rend, "bone_head", udg_Fake_Doomhammer, 0, 0, 90)
    call SetUnitAnimation(udg_Fake_Rend, "cinematic listening one")
    // //
    // //
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Doomhammer, 0, gg_snd_WC2Orc08SDoomhammer4, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SDoomhammer4, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Doomhammer, 0, gg_snd_WC2Orc08SDoomhammer5, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SDoomhammer5, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic listening one")
    call SetUnitAnimation(udg_Fake_Rend, "cinematic standard one")
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley201, 100, udg_Unit_IntroTroll01)
    // //
    call IssuePointOrderLocBJ(udg_Unit_IntroTroll01, "move", GetRectCenter(gg_rct_IntroTrollA01))
    call IssuePointOrderLocBJ(udg_Unit_IntroTroll02, "move", GetRectCenter(gg_rct_IntroTrollB01))
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Rend, 0, gg_snd_WC2Orc08SRend4, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SRend4, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Rend, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Doomhammer, 0, gg_snd_WC2Orc08SDoomhammer6, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SDoomhammer6, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Rend, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Rend, 0, gg_snd_WC2Orc08SRend5, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SRend5, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Rend, "cinematic listening one")
    // //
    call TriggerSleepAction(0.40)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ResetUnitLookAt(udg_Fake_Rend)
    call ResetUnitLookAt(udg_Fake_Doomhammer)
    call ResetUnitLookAt(udg_Fake_Tharbek)
    call ResetUnitLookAt(udg_Fake_Zuljin)
    // //
    call SetUnitPathing(udg_Fake_Tharbek, false)
    call SetUnitPathing(udg_Fake_Rend, false)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_GroupExit)
    // //
    // Remove Peon That builds a cage
    // //
    call RemoveUnit(udg_Unit_IntroPeonWorking)
    call ShowUnitShow(udg_Fake_Garona)
    call SetUnitAnimation(udg_Fake_Garona, "cinematic stand alternate")
    call SetUnitScalePercent(udg_Fake_Garona, 100, 100, 100)
    call ShowUnitShow(udg_Fake_Eitrigg)
    // //
    // Remove Peon That builds a cage
    // //
    call TriggerSleepAction(4.80)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Doomhammer Dismounts
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetSkyModel("Environment\\Sky\\LordaeronWinterSky\\LordaeronWinterSky.mdl")
    // //
    call BlzSetUnitSkin(udg_Fake_Doomhammer, 'ODCN')
    call SetUnitMoveSpeed(udg_Fake_Doomhammer, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Doomhammer, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Doomhammer)
    call SetUnitBlendTimeBJ(udg_Fake_Doomhammer, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'n007', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DoomhammersWolf), 315.96)
    set udg_Unit_DoomhammersWolf=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_DoomhammersWolf, PLAYER_COLOR_RED)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro09CageApproach, Player(0), 0)
    // //
    // Blurr the distant view
    call CameraSetFocalDistance(500.00)
    call CameraSetDepthOfFieldScale(300.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, udg_Hero_Doomhammer)
    call IssuePointOrderLocBJ(udg_Fake_Doomhammer, "move", GetRectCenter(gg_rct_IntroDH03B))
    call TriggerSleepAction(0.20)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_ETMove)
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_IntroDH03B, udg_Fake_Doomhammer) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueImmediateOrderBJ(udg_Fake_Doomhammer, "stop")
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic listening one")
    loop
        exitwhen ( (RectContainsUnit(gg_rct_IntroEitrigg02Catch, udg_Fake_Eitrigg) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro10Cage01, udg_Player_Actual, 0)
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley201, 100, udg_Hero_Eitrigg)
    // Reset Lens
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Eitrigg, "cinematic listening one")
    call TriggerSleepAction(0.15)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Eitrigg, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Eitrigg, 0, gg_snd_WC2Orc08SEitrigg1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SEitrigg1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro10Cage02, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_Fake_Eitrigg, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Doomhammer, 0, gg_snd_WC2Orc08SDoomhammer7, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SDoomhammer7, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro10Cage01, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic listening one")
    call SetUnitAnimation(udg_Fake_Eitrigg, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Eitrigg, 0, gg_snd_WC2Orc08SEitrigg2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SEitrigg2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Eitrigg, "cinematic listening one")
    // //
    // No Longer Skippable
    call StopSoundBJ(gg_snd_DarkAgents01, true)
    // //
    call DisableTrigger(gg_trg_Intro_Cinematic_Skipped)
    // //
    call IssuePointOrderLocBJ(udg_Fake_Zuljin, "move", GetRectCenter(gg_rct_IntroZuljin04))
    call IssuePointOrderLocBJ(udg_Fake_Tharbek, "move", GetRectCenter(gg_rct_IntroTharbek03))
    call IssuePointOrderLocBJ(udg_Fake_Eitrigg, "move", GetRectCenter(gg_rct_BasePatrol01))
    // //
    call EnableTrigger(gg_trg_Eitrigg_Patrol_A)
    call EnableTrigger(gg_trg_Eitrigg_Patrol_B)
    call EnableTrigger(gg_trg_Eitrigg_Patrol_C)
    call EnableTrigger(gg_trg_Eitrigg_Patrol_D)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro11, udg_Player_Actual, 3.00, 1.00, 1.00, 100.00)
    call TriggerSleepAction(3.00)
    // //
    // End
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
    // //
    // //
    // //
    // //
    // //
endfunction

