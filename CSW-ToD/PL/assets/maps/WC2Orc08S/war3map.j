    // //
    call CreateNUnitsAtLoc(1, 'ODCN', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeDoomhammer, bj_UNIT_FACING)
    set udg_Fake_Doomhammer=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Doomhammer)
    call SetUnitBlendTimeBJ(udg_Fake_Doomhammer, 0.50)
    call SetUnitMoveSpeed(udg_Fake_Doomhammer, 108.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Doomhammer, UNIT_RF_ANIMATION_WALK_SPEED, 108.00)
    // //
    call CreateNUnitsAtLoc(1, 'OEIC', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeEitrig, bj_UNIT_FACING)
    set udg_Fake_Eitrigg=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Eitrigg)
    call SetUnitBlendTimeBJ(udg_Fake_Eitrigg, 0.50)
    call SetUnitMoveSpeed(udg_Fake_Eitrigg, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Eitrigg, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call CreateNUnitsAtLoc(1, 'OGAC', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeGarona, bj_UNIT_FACING)
    set udg_Fake_Garona=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Garona)
    call SetUnitBlendTimeBJ(udg_Fake_Garona, 0.50)
    call SetUnitMoveSpeed(udg_Fake_Garona, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Garona, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call CreateNUnitsAtLoc(1, 'HKLC', udg_Player_NoL, udg_Point_SpawnFakeKurdran, bj_UNIT_FACING)
    set udg_Fake_Kurdran=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Kurdran)
    call SetUnitBlendTimeBJ(udg_Fake_Kurdran, 0.50)
    call SetUnitMoveSpeed(udg_Fake_Kurdran, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Kurdran, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call CreateNUnitsAtLoc(1, 'HLFC', udg_Player_NoL, udg_Point_SpawnFakeLothar, bj_UNIT_FACING)
    set udg_Fake_Lothar=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Lothar)
    call SetUnitBlendTimeBJ(udg_Fake_Lothar, 0.50)
    call SetUnitMoveSpeed(udg_Fake_Lothar, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Lothar, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call CreateNUnitsAtLoc(1, 'ORbC', udg_Player_TribeCoal, udg_Point_SpawnFakeRend, bj_UNIT_FACING)
    set udg_Fake_Rend=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Rend)
    call SetUnitBlendTimeBJ(udg_Fake_Rend, 0.50)
    call SetUnitMoveSpeed(udg_Fake_Rend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Rend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call CreateNUnitsAtLoc(1, 'o608', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeTharbek, bj_UNIT_FACING)
    set udg_Fake_Tharbek=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Tharbek)
    call SetUnitBlendTimeBJ(udg_Fake_Tharbek, 0.50)
    call SetUnitMoveSpeed(udg_Fake_Tharbek, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Tharbek, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call CreateNUnitsAtLoc(1, 'o605', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeUtok, bj_UNIT_FACING)
    set udg_Fake_Utok=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Utok)
    call SetUnitBlendTimeBJ(udg_Fake_Utok, 0.50)
    call SetUnitMoveSpeed(udg_Fake_Utok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Utok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    // //
    call CreateNUnitsAtLoc(1, 'OZcN', udg_Player_CinematicZuljin, udg_Point_SpawnFakeZuljin, bj_UNIT_FACING)
    set udg_Fake_Zuljin=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Zuljin)
    call SetUnitBlendTimeBJ(udg_Fake_Zuljin, 0.50)
    call SetUnitMoveSpeed(udg_Fake_Zuljin, 100.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Zuljin, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitColor(udg_Fake_Zuljin, PLAYER_COLOR_CYAN)
    // //
endfunction

