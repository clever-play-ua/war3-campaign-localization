//===========================================================================
// Trigger: VisibilityMod01On
//===========================================================================
function Trig_VisibilityMod01On_Func001C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_TribeWarriors ) ) then
        return true
    endif
    return false
endfunction

function Trig_VisibilityMod01On_Conditions takes nothing returns boolean
    if ( not Trig_VisibilityMod01On_Func001C() ) then
        return false
    endif
    if ( not ( udg_Bool_VisibilityModArrayOn[1] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_VisibilityMod01On_Actions takes nothing returns nothing
    set udg_Bool_VisibilityModArrayOn[1]=true
    call UnitShareVisionBJ(true, gg_unit_h006_0288, udg_Player_Actual)
    call EnableTrigger(gg_trg_VisibilityMod01Off)
endfunction

//===========================================================================
function InitTrig_VisibilityMod01On takes nothing returns nothing
    set gg_trg_VisibilityMod01On=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_VisibilityMod01On, gg_rct_VisibilityMod01)
    call TriggerAddCondition(gg_trg_VisibilityMod01On, Condition(function Trig_VisibilityMod01On_Conditions))
    call TriggerAddAction(gg_trg_VisibilityMod01On, function Trig_VisibilityMod01On_Actions)
endfunction

//===========================================================================
// Trigger: VisibilityMod01Off
//===========================================================================
function Trig_VisibilityMod01Off_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_VisibilityModArrayOn[1] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_VisibilityMod01Off_Func002Func004001001002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_VisibilityMod01Off_Func002Func004001001002002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_VisibilityMod01Off_Func002Func004001001002002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_TribeWarriors )
endfunction

function Trig_VisibilityMod01Off_Func002Func004001001002002 takes nothing returns boolean
    return GetBooleanOr((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetOwningPlayer(GetFilterUnit()) == udg_Player_TribeWarriors)) // INLINED!!
endfunction

function Trig_VisibilityMod01Off_Func002Func004001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetBooleanOr((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetOwningPlayer(GetFilterUnit()) == udg_Player_TribeWarriors)))) // INLINED!!
endfunction

function Trig_VisibilityMod01Off_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_VisibilityMod01, Condition(function Trig_VisibilityMod01Off_Func002Func004001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VisibilityMod01Off_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_VisibilityMod01Off_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Bool_VisibilityModArrayOn[1]=false
        call UnitShareVisionBJ(false, gg_unit_h006_0288, udg_Player_Actual)
    else
    endif
endfunction

//===========================================================================
function InitTrig_VisibilityMod01Off takes nothing returns nothing
    set gg_trg_VisibilityMod01Off=CreateTrigger()
    call DisableTrigger(gg_trg_VisibilityMod01Off)
    call TriggerRegisterTimerEventPeriodic(gg_trg_VisibilityMod01Off, 2)
    call TriggerAddCondition(gg_trg_VisibilityMod01Off, Condition(function Trig_VisibilityMod01Off_Conditions))
    call TriggerAddAction(gg_trg_VisibilityMod01Off, function Trig_VisibilityMod01Off_Actions)
endfunction

