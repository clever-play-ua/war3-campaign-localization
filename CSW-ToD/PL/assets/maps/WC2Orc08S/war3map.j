    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != GetOwningPlayer(GetAttacker()) ) ) then
        return false
    endif
    if ( not Trig_Eradication_Discover_Func006C() ) then
        return false
    endif
    if ( not Trig_Eradication_Discover_Func007C() ) then
        return false
    endif
    return true
endfunction

