    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Eradication_Discove_Q_Actions takes nothing returns nothing
    // //
    // Update the quest
    // //
    call QuestSetDiscoveredBJ(udg_Eradication_Quest, true)
    // //
    // Display a quest message.
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2625")
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_WildhammerBase04Green), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_SettlementMarker04Green=GetLastCreatedMinimapIcon()
    // //
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_WildhammerBase04Green), 5.00)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

