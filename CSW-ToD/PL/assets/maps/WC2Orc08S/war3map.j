//===========================================================================
function Trig_FaceAnimLoader_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Doomhammer
    call CreateItemLoc('I0L0', GetRectCenter(gg_rct_LocalizationItem))
    set udg_Locale_NameOrgrim=BlzGetItemTooltip(GetLastCreatedItem())
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc08SDoomhammer1, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc08SDoomhammer1, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L1', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc08SDoomhammer2, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc08SDoomhammer2, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L2', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc08SDoomhammer3, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc08SDoomhammer3, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L3', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc08SDoomhammer4, BlzGetItemTooltip(GetLastCreatedItem()))
