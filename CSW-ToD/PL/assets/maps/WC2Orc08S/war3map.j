// Trigger: Third Update Q
//===========================================================================
function Trig_Third_Update_Q_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Third_Update_Q_Actions takes nothing returns nothing
    call QuestItemSetDescriptionBJ(udg_Third_QR_Rally, ( BlzGetItemTooltip(gg_item_IQL2_0409) + ( I2S(udg_Int_ThirdTrollCount) + BlzGetItemExtendedTooltip(gg_item_IQL1_0403) ) ))
    set udg_newLine="\n"
    // //
    set udg_String_CompletedQuests=( GetItemName(gg_item_IQL0_0401) + ( udg_newLine + BlzGetItemTooltip(gg_item_IQL1_0403) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + ( BlzGetItemDescription(gg_item_IQL1_0403) + ( I2S(udg_Int_ThirdTrollCount) + BlzGetItemExtendedTooltip(gg_item_IQL1_0403) ) ) ) )
    // //
    set udg_String_CompletedQuests=( udg_String_CompletedQuests + ( udg_newLine + GetItemName(gg_item_IQL1_0403) ) )
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, udg_String_CompletedQuests)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

