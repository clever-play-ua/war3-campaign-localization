    call TriggerAddCondition(gg_trg_TrollCamps_Rescue5, Condition(function Trig_TrollCamps_Rescue5_Conditions))
    call TriggerAddAction(gg_trg_TrollCamps_Rescue5, function Trig_TrollCamps_Rescue5_Actions)
endfunction

