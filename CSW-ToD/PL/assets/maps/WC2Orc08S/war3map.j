    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Rend, GetRectCenter(gg_rct_IntroDR01), 311.39)
    call SetUnitPositionLocFacingBJ(udg_Hero_Doomhammer, GetRectCenter(gg_rct_IntroDH01), 295.82)
    call SetUnitPositionLocFacingBJ(udg_Hero_Eitrigg, GetRectCenter(gg_rct_IntroEitrigg01), 269.99)
    call SetUnitPositionLocFacingBJ(udg_SemiHero_Tharbek, GetRectCenter(gg_rct_IntroTharbek00), 151.09)
    call SetUnitPositionLocFacingBJ(udg_Fake_Utok, GetRectCenter(gg_rct_IntroUtok01), 314.16)
    call SetUnitPositionLocFacingBJ(udg_Hero_Zuljin, GetRectCenter(gg_rct_IntroZuljin01), 313.75)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroGrunt01, GetRectCenter(gg_rct_IntroDRGuardA01), 298.60)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroGrunt02, GetRectCenter(gg_rct_IntroDRGuardB01), 297.34)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroPeon01, GetRectCenter(gg_rct_IntroPeon01), 216.82)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroPeon02, GetRectCenter(gg_rct_IntroPeon02), 130.68)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroPig, GetRectCenter(gg_rct_IntroPig01), 296.45)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroTroll01, GetRectCenter(gg_rct_IntroTrollA00), 76.55)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroTroll02, GetRectCenter(gg_rct_IntroTrollB00), 107.34)
    // //
    call ForGroupBJ(udg_Group_IntroUnits, function Trig_Init_02_Units_Func098A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_Init_02_Units_Func101A)
    // //
    call ShowUnitShow(udg_SemiHero_Tharbek)
    call ShowUnitShow(udg_Hero_Eitrigg)
    call ShowUnitShow(udg_Unit_IntroTroll01)
    call ShowUnitShow(udg_Unit_IntroTroll02)
    // //
    call ForGroupBJ(udg_Group_MidUnits, function Trig_Init_02_Units_Func108A)
