//===========================================================================
// Trigger: Knockback
//===========================================================================
function Trig_Knockback_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetSpellTargetUnit(), 'Beng') == false ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'XAE1' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Knockback_Func019001 takes nothing returns boolean
    return ( GetOwningPlayer(udg_Unit_Spell_Knockback[udg_Spell_Knockback_Loop]) == GetOwningPlayer(udg_Hero_Eitrigg) )
endfunction

function Trig_Knockback_Actions takes nothing returns nothing
    set udg_Spell_Knockback_Max=( udg_Spell_Knockback_Max + 1 )
    set udg_Spell_Knockback_Loop=udg_Spell_Knockback_Max
    set udg_Unit_Spell_Knockback[udg_Spell_Knockback_Loop]=GetSpellTargetUnit()
    set udg_Spell_Knockback_StartPoint=GetUnitLoc(GetTriggerUnit())
    set udg_Spell_Knockback_TargetPoint=GetUnitLoc(udg_Unit_Spell_Knockback[udg_Spell_Knockback_Loop])
    call AddSpecialEffectLocBJ(udg_Spell_Knockback_TargetPoint, "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    set udg_Spell_Knockback_Angle[udg_Spell_Knockback_Loop]=AngleBetweenPoints(udg_Spell_Knockback_StartPoint, udg_Spell_Knockback_TargetPoint)
    // lZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZl
    // CUSTOMIZE: change here to set the knockback range/speed
    set udg_Spell_Knockback_DistanceMax[udg_Spell_Knockback_Loop]=250.00
    set udg_Spell_Knockback_Speed[udg_Spell_Knockback_Loop]=15.00
    // lZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZl
    set udg_Spell_Knockback_Distance[udg_Spell_Knockback_Loop]=0.00
    call EnableTrigger(gg_trg_Knockback_Move)
    call RemoveLocation(udg_Spell_Knockback_StartPoint)
    call RemoveLocation(udg_Spell_Knockback_TargetPoint)
    // This last line is only needed if an AI uses this spell against a player units. It ensures the last command to this unit is interrupted.
    if ( (GetOwningPlayer(udg_Unit_Spell_Knockback[udg_Spell_Knockback_Loop]) == GetOwningPlayer(udg_Hero_Eitrigg)) ) then // INLINED!!
        call BlzUnitInterruptAttack(udg_Unit_Spell_Knockback[udg_Spell_Knockback_Loop])
    else
        call DoNothing()
    endif
endfunction

//===========================================================================
function InitTrig_Knockback takes nothing returns nothing
    set gg_trg_Knockback=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Knockback, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Knockback, Condition(function Trig_Knockback_Conditions))
    call TriggerAddAction(gg_trg_Knockback, function Trig_Knockback_Actions)
endfunction

//===========================================================================
// Trigger: Knockback Move
//===========================================================================
function Trig_Knockback_Move_Func002Func003Func001C takes nothing returns boolean
    if ( ( IsTerrainPathableBJ(udg_Spell_Knockback_TargetPoint, PATHING_TYPE_WALKABILITY) == true ) ) then
        return true
    endif
    if ( ( udg_Spell_Knockback_Distance[udg_Spell_Knockback_Loop] >= udg_Spell_Knockback_DistanceMax[udg_Spell_Knockback_Loop] ) ) then
        return true
    endif
    return false
endfunction

function Trig_Knockback_Move_Func002Func003Func002C takes nothing returns boolean
    if ( not ( udg_Spell_Knockback_Max == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Knockback_Move_Func002Func003C takes nothing returns boolean
    if ( not Trig_Knockback_Move_Func002Func003Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Knockback_Move_Actions takes nothing returns nothing
    set udg_Spell_Knockback_Loop=1
    loop
        exitwhen udg_Spell_Knockback_Loop > udg_Spell_Knockback_Max
        set udg_Spell_Knockback_StartPoint=GetUnitLoc(udg_Unit_Spell_Knockback[udg_Spell_Knockback_Loop])
        set udg_Spell_Knockback_TargetPoint=PolarProjectionBJ(udg_Spell_Knockback_StartPoint, udg_Spell_Knockback_Speed[udg_Spell_Knockback_Loop], udg_Spell_Knockback_Angle[udg_Spell_Knockback_Loop])
        if ( Trig_Knockback_Move_Func002Func003C() ) then
            if ( Trig_Knockback_Move_Func002Func003Func002C() ) then
                call DisableTrigger(GetTriggeringTrigger())
            else
                // Recycle index
                set udg_Spell_Knockback_Angle[udg_Spell_Knockback_Loop]=udg_Spell_Knockback_Angle[udg_Spell_Knockback_Max]
                set udg_Spell_Knockback_Distance[udg_Spell_Knockback_Loop]=udg_Spell_Knockback_Distance[udg_Spell_Knockback_Max]
                set udg_Spell_Knockback_DistanceMax[udg_Spell_Knockback_Loop]=udg_Spell_Knockback_DistanceMax[udg_Spell_Knockback_Max]
                set udg_Spell_Knockback_Speed[udg_Spell_Knockback_Loop]=udg_Spell_Knockback_Speed[udg_Spell_Knockback_Max]
                set udg_Unit_Spell_Knockback[udg_Spell_Knockback_Loop]=udg_Unit_Spell_Knockback[udg_Spell_Knockback_Max]
                set udg_Spell_Knockback_Loop=( udg_Spell_Knockback_Loop - 1 )
            endif
            set udg_Spell_Knockback_Max=( udg_Spell_Knockback_Max - 1 )
        else
            call SetUnitPositionLoc(udg_Unit_Spell_Knockback[udg_Spell_Knockback_Loop], udg_Spell_Knockback_TargetPoint)
            call AddSpecialEffectLocBJ(udg_Spell_Knockback_TargetPoint, "Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            set udg_Spell_Knockback_Distance[udg_Spell_Knockback_Loop]=( udg_Spell_Knockback_Distance[udg_Spell_Knockback_Loop] + udg_Spell_Knockback_Speed[udg_Spell_Knockback_Loop] )
        endif
        call RemoveLocation(udg_Spell_Knockback_StartPoint)
        call RemoveLocation(udg_Spell_Knockback_TargetPoint)
        set udg_Spell_Knockback_Loop=udg_Spell_Knockback_Loop + 1
    endloop
endfunction

//===========================================================================
