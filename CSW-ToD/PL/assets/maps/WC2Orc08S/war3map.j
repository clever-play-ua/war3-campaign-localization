//===========================================================================
// Trigger: Garona Select Q
//===========================================================================
function Trig_Garona_Select_Q_Func005Func003Func003Func003C takes nothing returns boolean
    if ( not ( udg_Int_GaronaClickChance == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Garona_Select_Q_Func005Func003Func003C takes nothing returns boolean
    if ( not ( udg_Int_GaronaClickChance == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Garona_Select_Q_Func005Func003C takes nothing returns boolean
    if ( not ( udg_Int_GaronaClickChance == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Garona_Select_Q_Func005C takes nothing returns boolean
    if ( not ( udg_Int_GaronaClickChance == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Garona_Select_Q_Actions takes nothing returns nothing
    // //
    set udg_Int_GaronaClickChance=GetRandomInt(1, 4)
    // //
    call SetSpeechVolumeGroupsBJ()
    if ( Trig_Garona_Select_Q_Func005C() ) then
        call TransmissionFromUnitWithNameBJ(udg_PlayerGroup_PlayerActual, udg_Hero_Garona, "TRIGSTR_2952", gg_snd_TyrandePissed1, "TRIGSTR_2953", bj_TIMETYPE_ADD, 0, true)
    else
        if ( Trig_Garona_Select_Q_Func005Func003C() ) then
            call TransmissionFromUnitWithNameBJ(udg_PlayerGroup_PlayerActual, udg_Hero_Garona, "TRIGSTR_2954", gg_snd_TyrandePissed3, "TRIGSTR_2955", bj_TIMETYPE_ADD, 0, true)
        else
            if ( Trig_Garona_Select_Q_Func005Func003Func003C() ) then
                call TransmissionFromUnitWithNameBJ(udg_PlayerGroup_PlayerActual, udg_Hero_Garona, "TRIGSTR_2956", gg_snd_TyrandePissed4, "TRIGSTR_2957", bj_TIMETYPE_ADD, 0, true)
            else
                if ( Trig_Garona_Select_Q_Func005Func003Func003Func003C() ) then
                    call TransmissionFromUnitWithNameBJ(udg_PlayerGroup_PlayerActual, udg_Hero_Garona, "TRIGSTR_2958", gg_snd_TyrandePissed5, "TRIGSTR_2959", bj_TIMETYPE_ADD, 0, true)
                else
                    call DoNothing()
                endif
            endif
        endif
    endif
    call VolumeGroupResetBJ()
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_Garona_Select)
endfunction

//===========================================================================
function InitTrig_Garona_Select_Q takes nothing returns nothing
    set gg_trg_Garona_Select_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Garona_Select_Q, function Trig_Garona_Select_Q_Actions)
endfunction

