//===========================================================================
function InitTrig_FaceAnimLoader takes nothing returns nothing
    set gg_trg_FaceAnimLoader=CreateTrigger()
    call TriggerAddAction(gg_trg_FaceAnimLoader, function Trig_FaceAnimLoader_Actions)
endfunction

//===========================================================================
// Trigger: Init Reload
//===========================================================================
function Trig_Init_Reload_Actions takes nothing returns nothing
    call SetMapFacialAnimations()
    // Clear any pending music list
    call ClearMapMusicBJ()
    // Play music
    call PolledWait(0.10)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

//===========================================================================
function InitTrig_Init_Reload takes nothing returns nothing
    set gg_trg_Init_Reload=CreateTrigger()
    call TriggerRegisterGameLoadedEventBJ(gg_trg_Init_Reload)
    call TriggerAddAction(gg_trg_Init_Reload, function Trig_Init_Reload_Actions)
endfunction

//===========================================================================
// Trigger: SaveCheckpoint
//===========================================================================
function Trig_SaveCheckpoint_Actions takes nothing returns nothing
    set udg_String_CheckpointName=( udg_String_CheckpointChapter + udg_String_CheckpointPhase )
    call SaveGameCheckPointBJ(udg_String_CheckpointName, true)
endfunction

//===========================================================================
function InitTrig_SaveCheckpoint takes nothing returns nothing
    set gg_trg_SaveCheckpoint=CreateTrigger()
    call TriggerAddAction(gg_trg_SaveCheckpoint, function Trig_SaveCheckpoint_Actions)
endfunction

//===========================================================================
// Trigger: Init 06c Easy
//===========================================================================
function Trig_Init_06c_Easy_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_06c_Easy_Actions takes nothing returns nothing
    set udg_Real_SettlementTimerDifficulty=1800.00
    set udg_Int_GryphonWaveSize=2
    // Resources
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 3000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 1500)
    // Upgrades
    // NoL
    call SetPlayerTechResearchedSwap('R013', 1, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R014', 1, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R01A', 1, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R00J', 1, udg_Player_NoL)
    // WHRed
    // WHYellow
    // WHBlue
endfunction

//===========================================================================
function InitTrig_Init_06c_Easy takes nothing returns nothing
    set gg_trg_Init_06c_Easy=CreateTrigger()
    call TriggerAddCondition(gg_trg_Init_06c_Easy, Condition(function Trig_Init_06c_Easy_Conditions))
    call TriggerAddAction(gg_trg_Init_06c_Easy, function Trig_Init_06c_Easy_Actions)
endfunction

//===========================================================================
// Trigger: Init 06b Medium
//===========================================================================
function Trig_Init_06b_Medium_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_Init_06b_Medium_Actions takes nothing returns nothing
    set udg_Real_SettlementTimerDifficulty=1800.00
    set udg_Int_GryphonWaveSize=4
    // Resources
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 1500)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 750)
    // Upgrades
    // NoL
    call SetPlayerTechResearchedSwap('R013', 2, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R014', 2, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R01A', 2, udg_Player_NoL)
    call SetPlayerTechResearchedSwap('R00J', 2, udg_Player_NoL)
    // WHRed
    // WHYellow
    // WHBlue
endfunction

