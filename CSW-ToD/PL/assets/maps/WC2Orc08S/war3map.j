    set udg_Unit_AllianceGuard04=gg_unit_h60B_0268
    set udg_Unit_AllianceGuard05=gg_unit_h60B_0270
    set udg_Unit_AllianceGuard06=gg_unit_h60K_0262
    set udg_Unit_AllianceGuard07=gg_unit_h60K_0269
    set udg_Unit_AllianceGuard08=gg_unit_h60K_0267
    set udg_Unit_AllianceGuard09=gg_unit_h60K_0029
