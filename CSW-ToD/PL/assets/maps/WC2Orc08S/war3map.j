    endif
endfunction

function Trig_TrollCamps_Rescue5_Func020C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Unit_TrollPriest05) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrollCamps_Rescue5_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_TrollCamps_Death05)
    // //
    call SetUnitColor(udg_Unit_TrollCircle05, GetPlayerColor(udg_Player_Actual))
    call UnitAddAbility(udg_Unit_TrollCircle05, 'Aloc')
    // //
    call DestroyMinimapIcon(udg_TrollMarker05)
    set udg_Bool_TrollCap05=true
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_TribePeach), function Trig_TrollCamps_Rescue5_Func015A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_TribePeach), function Trig_TrollCamps_Rescue5_Func018A)
    // //
    if ( Trig_TrollCamps_Rescue5_Func020C() ) then
        set udg_Int_TrollRandomVO=( udg_Int_TrollRandomVO + 1 )
        call QueuedTriggerAddBJ(gg_trg_TrollCamps_Rescue_Q, true)
    else
    endif
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_TrollCamps_RescueAny)
endfunction

