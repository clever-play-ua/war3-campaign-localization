//===========================================================================
function Trig_Eitrigg_Aquire_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Eitrigg_Aquire_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_Eitrigg_ReturnToCamp)
    // //
    set udg_Bool_EitrigPatrols=false
    // //
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetUnitLoc(udg_Hero_Eitrigg), 1.00)
    call PingMinimapLocForForce(udg_PlayerGroup_PlayerActual, GetRectCenter(gg_rct_IntroEitrigg03), 3.00)
    // //
    call SelectUnitForPlayerSingle(udg_Hero_Eitrigg, udg_Player_Actual)
    // //
    call QueuedTriggerAddBJ(gg_trg_Eitrigg_Aquire_Hint_Q, true)
endfunction

