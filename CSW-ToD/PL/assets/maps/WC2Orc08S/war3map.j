    endif
    return true
endfunction

function Trig_Invasion_Spawner_Func030001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Invasion_Spawner_Actions takes nothing returns nothing
    // //
    call CreateNUnitsAtLoc(1, 'h60B', udg_Player_NoL, udg_Point_AllianceSpawn01, bj_UNIT_FACING)
    // //
    set udg_Point_AllianceAttackTarget=GetRandomLocInRect(gg_rct_PlayerRelocate)
    // //
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_AllianceAttackTarget)
    // //
    if ( Trig_Invasion_Spawner_Func010C() ) then
        call CreateNUnitsAtLoc(1, 'h60L', udg_Player_NoL, udg_Point_AllianceSpawn02, bj_UNIT_FACING)
        set udg_Point_AllianceAttackTarget=GetRandomLocInRect(gg_rct_PlayerRelocate)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_AllianceAttackTarget)
    else
    endif
    // //
    if ( Trig_Invasion_Spawner_Func012C() ) then
        call CreateNUnitsAtLoc(1, 'hBaL', udg_Player_NoL, udg_Point_AllianceSpawn02, bj_UNIT_FACING)
        set udg_Point_AllianceAttackTarget=GetRandomLocInRect(gg_rct_PlayerRelocate)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_AllianceAttackTarget)
    else
    endif
    // //
    if ( Trig_Invasion_Spawner_Func014C() ) then
        call CreateNUnitsAtLoc(1, 'h60L', udg_Player_NoL, udg_Point_AllianceSpawn02, bj_UNIT_FACING)
        set udg_Point_AllianceAttackTarget=GetRandomLocInRect(gg_rct_PlayerRelocate)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_AllianceAttackTarget)
    else
    endif
    // //
    call CreateNUnitsAtLoc(1, 'h60B', udg_Player_NoL, udg_Point_AllianceSpawn03, bj_UNIT_FACING)
    set udg_Point_AllianceAttackTarget=GetRandomLocInRect(gg_rct_PlayerRelocate)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_AllianceAttackTarget)
    // //
    call CreateNUnitsAtLoc(1, 'h60K', udg_Player_NoL, udg_Point_AllianceSpawn04, bj_UNIT_FACING)
    set udg_Point_AllianceAttackTarget=GetRandomLocInRect(gg_rct_PlayerRelocate)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_Point_AllianceAttackTarget)
    // //
    call PolledWait(4.90)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    if ( Trig_Invasion_Spawner_Func027C() ) then
        set udg_Bool_MidKnightSkip=true
    else
        if ( Trig_Invasion_Spawner_Func027Func001C() ) then
            set udg_Bool_MidKnightSkip=false
        else
        endif
    endif
    // //
    call PolledWait(0.10)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(GetTriggeringTrigger())
    // //
    // //
    // //
endfunction

