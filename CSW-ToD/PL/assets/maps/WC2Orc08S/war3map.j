//===========================================================================
// Trigger: Invasion SpawnControl
//===========================================================================
function Trig_Invasion_SpawnControl_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Invasion_SpawnControl_Func010001 takes nothing returns boolean
    return ( udg_Bool_WaveStart == true )
endfunction

function Trig_Invasion_SpawnControl_Func011001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Invasion_SpawnControl_Func020001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Invasion_SpawnControl_Func029001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Invasion_SpawnControl_Func038001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Invasion_SpawnControl_Func047001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Invasion_SpawnControl_Func056001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Invasion_SpawnControl_Func065001 takes nothing returns boolean
    return ( udg_Bool_GameOver == true )
endfunction

function Trig_Invasion_SpawnControl_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // WAVE 1
    // //
    call EnableTrigger(gg_trg_Invasion_Spawner)
    call ConditionalTriggerExecute(gg_trg_Invasion_Spawner)
    call PolledWait(15.00)
    call DisableTrigger(gg_trg_Invasion_Spawner)
    loop
        exitwhen ( (udg_Bool_WaveStart == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 1))
    endloop
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // WAVE 2
    // //
    call EnableTrigger(gg_trg_Invasion_Spawner)
    call ConditionalTriggerExecute(gg_trg_Invasion_Spawner)
    call PolledWait(30.00)
    call DisableTrigger(gg_trg_Invasion_Spawner)
    call PolledWait(60.00)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // WAVE 3
    // //
    call EnableTrigger(gg_trg_Invasion_Spawner)
    call ConditionalTriggerExecute(gg_trg_Invasion_Spawner)
    call PolledWait(30.00)
    call DisableTrigger(gg_trg_Invasion_Spawner)
    call PolledWait(60.00)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // WAVE 4
    // //
    call EnableTrigger(gg_trg_Invasion_Spawner)
    call ConditionalTriggerExecute(gg_trg_Invasion_Spawner)
    call PolledWait(30.00)
    call DisableTrigger(gg_trg_Invasion_Spawner)
    call PolledWait(60.00)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // WAVE 5
    // //
    call EnableTrigger(gg_trg_Invasion_Spawner)
    call ConditionalTriggerExecute(gg_trg_Invasion_Spawner)
    call PolledWait(30.00)
    call DisableTrigger(gg_trg_Invasion_Spawner)
    call PolledWait(60.00)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // WAVE 6
    // //
    call EnableTrigger(gg_trg_Invasion_Spawner)
    call ConditionalTriggerExecute(gg_trg_Invasion_Spawner)
    call PolledWait(30.00)
    call DisableTrigger(gg_trg_Invasion_Spawner)
    call PolledWait(60.00)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // WAVE 7
    // //
    call EnableTrigger(gg_trg_Invasion_Spawner)
    call ConditionalTriggerExecute(gg_trg_Invasion_Spawner)
    call PolledWait(30.00)
    call DisableTrigger(gg_trg_Invasion_Spawner)
    call PolledWait(60.00)
    if ( (udg_Bool_GameOver == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // WAVE 8
    // //
    call EnableTrigger(gg_trg_Invasion_Spawner)
    call ConditionalTriggerExecute(gg_trg_Invasion_Spawner)
    // //
    call RemoveGuardPosition(udg_Hero_Anduin)
    call RemoveGuardPosition(udg_Hero_Kurdran)
    // //
    call PauseUnitBJ(false, udg_Hero_Anduin)
    call PauseUnitBJ(false, udg_Hero_Kurdran)
    call SetUnitOwner(udg_Hero_Anduin, Player(9), false)
    call SetUnitOwner(udg_Hero_Kurdran, Player(1), false)
    // //
    call PolledWait(0.50)
    // //
    call IssuePointOrderLocBJ(udg_Hero_Anduin, "attack", GetRectCenter(gg_rct_PlayerRelocate))
    call IssuePointOrderLocBJ(udg_Hero_Kurdran, "attack", GetRectCenter(gg_rct_PlayerRelocate))
    call PolledWait(30.00)
    // //
    call DisableTrigger(gg_trg_Invasion_Spawner)
endfunction

