function Trig_Outro_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Bool_GameOver=true
    // //
    // Settings
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    // //
    call EndThematicMusicBJ()
    // Setup
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, GetPlayersAll())
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro01, udg_Player_Actual, 0)
    call ConditionalTriggerExecute(gg_trg_Outro_Cinematic_Setup)
    // //
    call TriggerSleepAction(0.25)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Outro02, udg_Player_Actual, 11.00, 1.00, 3.00, 100.00)
    // //
    set udg_Bool_CinOutroOn=true
    set udg_Bool_CinematicSkipped=false
    call PlaySoundBJ(gg_snd_DarkVictory)
    // //
    // Skippable
    // //
    call EnableTrigger(gg_trg_Outro_Cinematic_Skipped)
    // //
    call ConditionalTriggerExecute(gg_trg_Outro_Cinematic_EitriggDeath)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundAtPointBJ(gg_snd_CS_H01a_soldiers_walk_RtoL_a, 100, GetRectCenter(gg_rct_BarrelsWIthExposives), 0)
    call TriggerSleepAction(5.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ForGroupBJ(udg_Group_LastStandGrunts, function Trig_Outro_Cinematic_Q_Func038A)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueTargetOrderBJ(udg_Unit_OutroSapper01, "selfdestruct", udg_Unit_OutroSapper01)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueTargetOrderBJ(udg_Unit_OutroSapper02, "selfdestruct", udg_Unit_OutroSapper02)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call EnumDestructablesInRectAll(gg_rct_BarrelsWIthExposives, function Trig_Outro_Cinematic_Q_Func050A)
    // //
    call ConditionalTriggerExecute(gg_trg_Outro_Cinematic_Sway)
    // //
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroVFX01), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdl")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 2100.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroVFX02), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdl")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 2100.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroVFX03), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdl")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 2100.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroVFX04), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdl")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 2100.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroVFX05), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdl")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 2100.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_OutroVFX06), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdl")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 2100.00)
    // //
    call PlaySoundBJ(gg_snd_CS_orc2_outro_stomp)
    // //
    call EnumDestructablesInRectAll(gg_rct_OutroRocksMountain, function Trig_Outro_Cinematic_Q_Func069A)
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_BarrelsWIthExposives, Condition(function Trig_Outro_Cinematic_Q_Func075001002)), function Trig_Outro_Cinematic_Q_Func075002)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_CS_orc2_outro_stomp, true)
    call PlaySoundBJ(gg_snd_CS_orc2_outro_rockfalls)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 100.00, 0.00, 0.00, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call AddWeatherEffectSaveLast(gg_rct_AvalanchFog, 'FDwh')
    call EnableWeatherEffect(GetLastCreatedWeatherEffect(), true)
    call SetTerrainFogExBJ(0, 1000, 5000.00, 0, 40.00, 30.00, 20.00)
    // //
    call ForGroupBJ(udg_Group_OutroForceB, function Trig_Outro_Cinematic_Q_Func091A)
    // //
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Lothar, GetRectCenter(gg_rct_OutroAnduin01), 326.55)
    call SetUnitOwner(udg_Fake_Lothar, udg_Player_MidHeroesAlliance, false)
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Kurdran, GetRectCenter(gg_rct_OutroKurdran01), 222.11)
    call SetUnitOwner(udg_Fake_Kurdran, udg_Player_MidHeroesAlliance, false)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Outro03, udg_Player_Actual, 0)
    // //
    call ForGroupBJ(udg_Group_OutroHeroesHuman, function Trig_Outro_Cinematic_Q_Func103A)
    // //
    call EnumDestructablesInRectAll(gg_rct_OutroRocksHidden, function Trig_Outro_Cinematic_Q_Func105A)
    call EnumDestructablesInRectAll(gg_rct_OutroRocksMountain, function Trig_Outro_Cinematic_Q_Func106A)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_CS_orc2_outro_rockfalls, true)
    call StopSoundBJ(gg_snd_DarkVictory, true)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 100.00, 0.00, 0.00, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundBJ(gg_snd_Comradeship)
    // //
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic point one")
    call QueueUnitAnimationBJ(udg_Fake_Kurdran, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Kurdran, 0, gg_snd_WC2Orc08SKurdran3, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SKurdran3, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Kurdran, 0, gg_snd_WC2Orc08SLothar5, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SLothar5, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Lothar, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic headnod one")
    call QueueUnitAnimationBJ(udg_Fake_Kurdran, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Kurdran, 0, gg_snd_WC2Orc08SKurdran4, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SKurdran4, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Kurdran, "cinematic listening one")
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley2, 100, udg_Hero_Anduin)
    call IssuePointOrderLocBJ(udg_Fake_Lothar, "move", GetRectCenter(gg_rct_OutroAnduin02))
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley201, 100, udg_Hero_Kurdran)
    call IssuePointOrderLocBJ(udg_Fake_Kurdran, "move", GetRectCenter(gg_rct_OutroKurdran02))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_EitrigWounded01, udg_Player_Actual, 0)
    // //
    call ShowUnitShow(udg_Fake_Garona)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Garona)
    call AddUnitAnimationPropertiesBJ(true, "alternate", udg_Fake_Garona)
    call SetUnitBlendTimeBJ(udg_Fake_Garona, 0.70)
    call BlzSetUnitRealFieldBJ(udg_Fake_Garona, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_Fake_Garona, 100.00)
    // //
    call SetPlayerColorBJ(GetOwningPlayer(udg_Hero_Garona), PLAYER_COLOR_RED, true)
    // //
    call PauseUnitBJ(false, udg_Fake_Garona)
    // //
    call TriggerSleepAction(5.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 4.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_EitrigWounded02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc08SEitrigg7))
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Eitrigg, 0, gg_snd_WC2Orc08SEitrigg7, bj_TIMETYPE_ADD, 0, false)
    call IssuePointOrderLocBJ(udg_Fake_Garona, "move", GetRectCenter(gg_rct_OutroGarona01))
    call WaitForSoundBJ(gg_snd_WC2Orc08SEitrigg7, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Garona, "cinematic kneeling one")
    call QueueUnitAnimationBJ(udg_Fake_Garona, "cinematic kneeling idle")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Garona, 0, gg_snd_WC2Orc08SGarona3, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SGarona3, 0)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_Comradeship, true)
    // //
    call DisableTrigger(gg_trg_Outro_Cinematic_Skipped)
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
    // //
    // //
endfunction

