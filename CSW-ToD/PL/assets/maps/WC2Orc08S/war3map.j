function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    // Settings
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01Pan01, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro02Pan02, udg_Player_Actual, 22.00, 1.00, 5.00, 100.00)
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_SetUp)
    call TriggerSleepAction(2.00)
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Pig)
    call TriggerSleepAction(0.50)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // //
    call SetUnitAnimationWithRarity(udg_Unit_IntroPeon01, "stand", RARITY_FREQUENT)
    call SetUnitAnimationWithRarity(udg_Unit_IntroPeon02, "stand", RARITY_FREQUENT)
    // //
    set udg_Bool_CinIntroOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call PlaySoundBJ(gg_snd_DarkAgents01)
    // //
    call TriggerSleepAction(2)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(16.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_IntroPeonWorking, "stand")
    // //
    call SetUnitPositionLocFacingBJ(udg_Fake_Tharbek, GetRectCenter(gg_rct_IntroTharbek01), 303.76)
    // //
    call EnumDestructablesInRectAll(gg_rct_IntroBlockers, function Trig_Intro_Cinematic_Q_Func036A)
    call TriggerSleepAction(0.20)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Cinematic Start
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.80, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro03TaskMaster, udg_Player_Actual, 0)
    call SetUnitAnimation(udg_Fake_Tharbek, "cinematic listening one")
    // //
    call TriggerSleepAction(1.80)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Tharbek, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Tharbek, 0, gg_snd_WC2Orc08STharbek1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08STharbek1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Fake_Tharbek, "cinematic listening one")
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_HU_2_Intro_Foley2, 100, udg_Unit_IntroPeon01)
    call IssueTargetOrderBJ(udg_Unit_IntroPeon01, "harvest", gg_unit_ngol_0122)
    call TriggerSleepAction(0.20)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueTargetDestructableOrder(udg_Unit_IntroPeon02, "harvest", gg_dest_VTlt_0194)
    call TriggerSleepAction(1.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley201, 100, udg_SemiHero_Tharbek)
    call IssuePointOrderLocBJ(udg_Fake_Tharbek, "move", GetRectCenter(gg_rct_IntroTharbek02))
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro04ArrivalExit, udg_Player_Actual, 10.00, 1.00, 2.00, 100.00)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Doomhammer and co
    // PlaceDoomhammerOnWolf
    call BlzSetUnitSkin(udg_Fake_Doomhammer, 'OMDC')
    // //
    call SetUnitMoveSpeed(udg_Fake_Doomhammer, 108.00)
    call BlzSetUnitRealFieldBJ(udg_Fake_Doomhammer, UNIT_RF_ANIMATION_WALK_SPEED, 108.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Fake_Doomhammer)
    call SetUnitBlendTimeBJ(udg_Fake_Doomhammer, 0.50)
    // //
    call ForGroupBJ(udg_Group_IntroUnits, function Trig_Intro_Cinematic_Q_Func084A)
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_H01b_group_walk_v2, 100, udg_Hero_Doomhammer)
    // //
    call IssuePointOrderLocBJ(udg_Fake_Rend, "move", GetRectCenter(gg_rct_IntroDR02))
    call IssuePointOrderLocBJ(udg_Fake_Doomhammer, "move", GetRectCenter(gg_rct_IntroDH02))
    call IssuePointOrderLocBJ(udg_Fake_Utok, "move", GetRectCenter(gg_rct_IntroUtok02))
    call IssuePointOrderLocBJ(udg_Fake_Zuljin, "move", GetRectCenter(gg_rct_IntroZuljin02))
    call IssuePointOrderLocBJ(udg_Unit_IntroGrunt01, "move", GetRectCenter(gg_rct_IntroDRGuardA02))
    call IssuePointOrderLocBJ(udg_Unit_IntroGrunt02, "move", GetRectCenter(gg_rct_IntroDRGuardB02))
    loop
        exitwhen ( (RectContainsUnit(gg_rct_IntroDH02Capture, udg_Fake_Doomhammer) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitLookAt(udg_Fake_Tharbek, "bone_head", udg_Fake_Doomhammer, 0, 0, 90)
    call SetUnitAnimation(udg_Fake_Tharbek, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Tharbek, 0, gg_snd_WC2Orc08STharbek2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08STharbek2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Fake_Tharbek, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Doomhammer, 0, gg_snd_WC2Orc08SDoomhammer1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SDoomhammer1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro06Rend, udg_Player_Actual, 0)
    // //
    call SetUnitFacingToFaceUnitTimed(udg_Fake_Rend, udg_Fake_Doomhammer, 1.00)
    call SetUnitFacingToFaceUnitTimed(udg_Fake_Doomhammer, udg_Fake_Zuljin, 1.00)
    call SetUnitLookAt(udg_Fake_Doomhammer, "bone_head", udg_Fake_Rend, 0, 0, 90)
    call SetUnitLookAt(udg_Fake_Rend, "bone_head", udg_Fake_Tharbek, 0, 0, 90)
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic listening one")
    call SetUnitAnimation(udg_Fake_Rend, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Rend, 0, gg_snd_WC2Orc08SRend1, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SRend1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroDialogue, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_Fake_Rend, "cinematic listening one")
    call SetUnitAnimation(udg_Fake_Doomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Doomhammer, 0, gg_snd_WC2Orc08SDoomhammer2, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SDoomhammer2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Fake_Doomhammer, 0, gg_snd_WC2Orc08SDoomhammer3, bj_TIMETYPE_ADD, 0, false)
    call WaitForSoundBJ(gg_snd_WC2Orc08SDoomhammer3, 0)
