    if ( not ( udg_Bool_TrollCap01 == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_More_Discover_Q_Func013C takes nothing returns boolean
    if ( not ( udg_Bool_TrollCap02 == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_More_Discover_Q_Func015C takes nothing returns boolean
