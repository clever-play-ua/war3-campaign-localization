//===========================================================================
// Trigger: OIlBarrelItemConsumed
//===========================================================================
function Trig_OIlBarrelItemConsumed_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'IBoO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OIlBarrelItemConsumed_Actions takes nothing returns nothing
    local unit u
    local texttag t= CreateTextTag()
    local real x
    local real y
    // //
    set u=GetManipulatingUnit()
    set x=GetUnitX(u)
    set y=GetUnitY(u)
    // //
    call SetTextTagText(t, ( "+" + I2S(100) ), 0.024)
    call SetTextTagPos(t, x, y, 75.00)
    call SetTextTagColor(t, 4, 19, 51, 255)
    call SetTextTagVelocity(t, 0.00, 0.04)
    call SetTextTagFadepoint(t, 1.50)
    call SetTextTagLifespan(t, 2.00)
    call SetTextTagPermanent(t, false)
    // //
    call playerAddOil(Player(0) , 100)
endfunction

//===========================================================================
function InitTrig_OIlBarrelItemConsumed takes nothing returns nothing
    set gg_trg_OIlBarrelItemConsumed=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OIlBarrelItemConsumed, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_OIlBarrelItemConsumed, Condition(function Trig_OIlBarrelItemConsumed_Conditions))
    call TriggerAddAction(gg_trg_OIlBarrelItemConsumed, function Trig_OIlBarrelItemConsumed_Actions)
endfunction

//===========================================================================
// Trigger: OilSpentForOrcTransport
//
// Transport Ship
//===========================================================================
function Trig_OilSpentForOrcTransport_Actions takes nothing returns nothing
    local sound OrcUI_InsufficientOill
    local string Sound_Path= "Sound\\Interface\\Warning\\Orc\\GruntNoOil1.mp3"
    // -------------------------------------
    // Check the Order to train the ship
    if ( ( GetIssuedOrderId() == 1865822289 ) ) then
    // Check the amount of Oil for Player
    if (OilHarvest___playerOil[GetPlayerId((Player(0)))]) < 500 then // INLINED!!
    // // UI Warning
    set OrcUI_InsufficientOill=CreateSound(Sound_Path, false, false, false, 1, 1, "DefaultEAXON")
    call SetSoundParamsFromLabel(OrcUI_InsufficientOill, "User Interface")
    call SetSoundVolume(OrcUI_InsufficientOill, 127)
    call SetSoundPitch(OrcUI_InsufficientOill, 1.0)
    call StartSound(OrcUI_InsufficientOill)
    call DisplayTextToForce(udg_PlayerGroup_ActualPlayer, "TRIGSTR_2751")
    call TriggerSleepAction(0.00)
    call IssueImmediateOrderById(GetTriggerUnit(), 0xD0008)
    // need to compensate return from valid canceling trigger
    call playerAddOil(Player(0) , - 500)
    else
    // need to decrease the oil if there was enough of it and ship started to build
    call playerAddOil(Player(0) , - 500)
    endif
    endif
    // // leak cleaner
    call KillSoundWhenDone(OrcUI_InsufficientOill)
    set OrcUI_InsufficientOill=null
endfunction

