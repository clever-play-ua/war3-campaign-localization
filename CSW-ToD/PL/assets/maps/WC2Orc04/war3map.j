//===========================================================================
function Trig_Init_03_Audio_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Music_DefaultNames[0]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    set udg_Music_DefaultNames[1]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[2]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3"
    set udg_Music_DefaultNames[3]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[4]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3"
    set udg_Music_DefaultNames[5]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    // //
    set udg_Music_DefaultNamesCount=6
    // //
    // SetMusicList with Randomizer
    set udg_Music_CurrentName=udg_Music_DefaultNames[GetRandomInt(0, 5)]
    set udg_Music_CurrentVolume=0.00
    // //
    call ClearMapMusicBJ()
endfunction

//===========================================================================
