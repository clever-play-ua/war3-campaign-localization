//===========================================================================
// Trigger: On screen
//===========================================================================
function Trig_On_screen_Func002C takes nothing returns boolean
    if ( not ( udg_BoolCheat_VisibilityOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_On_screen_Actions takes nothing returns nothing
    if ( Trig_On_screen_Func002C() ) then
        set udg_BoolCheat_VisibilityOn=true
        call FogMaskEnableOff()
        call FogEnableOff()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_2732")
    else
        set udg_BoolCheat_VisibilityOn=false
        call FogMaskEnableOn()
        call FogEnableOn()
        call TriggerSleepAction(1.00)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_SECRET, "TRIGSTR_2733")
    endif
endfunction

