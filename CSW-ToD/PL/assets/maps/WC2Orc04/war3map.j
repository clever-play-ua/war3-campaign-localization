    call QueueUnitAnimationBJ(udg_FakeMeryn, "Cinematic Stand")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_ActualPlayer, udg_FakeMeryn, 0, gg_snd_WC2Orc04Meryn1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
