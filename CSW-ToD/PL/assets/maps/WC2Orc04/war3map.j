//===========================================================================
// Trigger: CreateFakeActors
//===========================================================================
function Trig_CreateFakeActors_Actions takes nothing returns nothing
    // Rend
    call CreateNUnitsAtLocFacingLocBJ(1, 'ORbC', udg_Player_BTGCinematic, GetRectCenter(gg_rct_RendFakeActor), GetRectCenter(gg_rct_ZuljinFakeActor))
    set udg_FakeRend=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeRend)
    call SetUnitMoveSpeed(udg_FakeRend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.25)
    call RemoveGuardPosition(udg_FakeRend)
    // Zuljin
    call CreateNUnitsAtLocFacingLocBJ(1, 'OZcN', udg_Player_TrollsCinematic, GetRectCenter(gg_rct_ZuljinFakeActor), GetRectCenter(gg_rct_UtokFakeActor))
    set udg_FakeZuljin=GetLastCreatedUnit()
    call SelectHeroSkill(udg_FakeZuljin, 'XAZ2')
    call SetUnitManaPercentBJ(udg_FakeZuljin, 100)
    call SetUnitBlendTimeBJ(udg_FakeZuljin, 0.25)
    call RemoveGuardPosition(udg_FakeZuljin)
    // Utok
    call CreateNUnitsAtLocFacingLocBJ(1, 'o605', udg_Player_BTGCinematic, GetRectCenter(gg_rct_UtokFakeActor), GetRectCenter(gg_rct_ZuljinFakeActor))
    set udg_FakeUtok=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call RemoveGuardPosition(udg_FakeUtok)
    // Meryn
    call CreateNUnitsAtLoc(1, 'HMrc', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_MerynIntro05), 232.37)
    set udg_FakeMeryn=GetLastCreatedUnit()
    call RemoveGuardPosition(udg_FakeMeryn)
endfunction

