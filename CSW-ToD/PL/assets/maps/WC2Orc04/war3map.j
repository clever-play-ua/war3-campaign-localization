//===========================================================================
// Trigger: Hillsbrad Discover Q
//===========================================================================
function Trig_Hillsbrad_Discover_Q_Actions takes nothing returns nothing
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h61C_0001, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Hillsbrad[1]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h61C_0090, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Hillsbrad[2]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h616_0093, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Hillsbrad[3]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h616_0092, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Hillsbrad[4]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_h614_0091, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Hillsbrad[5]=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(gg_unit_hCBL_0089, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Hillsbrad[6]=GetLastCreatedMinimapIcon()
    // //
    call QuestMessageBJ(udg_PlayerGroup_ActualPlayer, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_244")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call EnableTrigger(gg_trg_Hillsbrad_Completed)
    call EnableTrigger(gg_trg_AllUnitsDead_Defeat)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

