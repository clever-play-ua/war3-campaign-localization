    return ( GetUnitTypeId(GetFilterUnit()) == 'o614' )
endfunction

function Trig_AllUnitsDead_Defeat_Func005001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

