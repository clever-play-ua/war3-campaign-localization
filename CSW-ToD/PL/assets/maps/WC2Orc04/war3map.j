function Trig_HIllsbradBuildingDestruction_Actions takes nothing returns nothing
    if ( Trig_HIllsbradBuildingDestruction_Func002C() ) then
        call DestroyMinimapIcon(udg_MinimapIcon_Hillsbrad[1])
        call GroupRemoveUnitSimple(GetDyingUnit(), udg_Group_HillsbradStructures)
    else
    endif
    if ( Trig_HIllsbradBuildingDestruction_Func003C() ) then
        call DestroyMinimapIcon(udg_MinimapIcon_Hillsbrad[2])
        call GroupRemoveUnitSimple(GetDyingUnit(), udg_Group_HillsbradStructures)
    else
    endif
    if ( Trig_HIllsbradBuildingDestruction_Func004C() ) then
        call DestroyMinimapIcon(udg_MinimapIcon_Hillsbrad[3])
        call GroupRemoveUnitSimple(GetDyingUnit(), udg_Group_HillsbradStructures)
    else
    endif
    if ( Trig_HIllsbradBuildingDestruction_Func005C() ) then
        call DestroyMinimapIcon(udg_MinimapIcon_Hillsbrad[4])
        call GroupRemoveUnitSimple(GetDyingUnit(), udg_Group_HillsbradStructures)
    else
    endif
    if ( Trig_HIllsbradBuildingDestruction_Func006C() ) then
        call DestroyMinimapIcon(udg_MinimapIcon_Hillsbrad[5])
        call GroupRemoveUnitSimple(GetDyingUnit(), udg_Group_HillsbradStructures)
    else
    endif
    if ( Trig_HIllsbradBuildingDestruction_Func007C() ) then
        call DestroyMinimapIcon(udg_MinimapIcon_Hillsbrad[6])
        call GroupRemoveUnitSimple(GetDyingUnit(), udg_Group_HillsbradStructures)
    else
    endif
endfunction

