    call TriggerAddAction(gg_trg_UtokRevive, function Trig_UtokRevive_Actions)
endfunction

//===========================================================================
// Trigger: Load Heroes
//===========================================================================
function Trig_Load_Heroes_Actions takes nothing returns nothing
    // //
    call InitGameCacheBJ("WC2Horde.w3v")
    set udg_Cache=GetLastCreatedGameCacheBJ()
    // //
    call ConditionalTriggerExecute(gg_trg_Load_Rend)
