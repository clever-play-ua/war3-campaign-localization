//===========================================================================
// Trigger: TransportationConfig
//===========================================================================
function Trig_TransportationConfig_Actions takes nothing returns nothing
    // //
    set udg_TempPlayer=udg_Player_Azerothiens
    set udg_TempInteger=GetConvertedPlayerId(udg_TempPlayer)
    // //
    set udg_IdleTransports[udg_TempInteger]=CreateGroup()
    set udg_IdleMarines[udg_TempInteger]=CreateGroup()
    set udg_QueuedTransports[udg_TempInteger]=CreateGroup()
    set udg_DepartedTransports[udg_TempInteger]=CreateGroup()
    set udg_QueuedMarines[udg_TempInteger]=CreateGroup()
    set udg_QueuedMarinesAdditional[udg_TempInteger]=CreateGroup()
    // //
    set udg_LandingWarfareManipulator[udg_TempInteger]=gg_trg_PlayerMarineLandingOrder
    // //
    set udg_BoardingOrderTimerPeriod=2.00
    set udg_BoardingOrderTimerInterval=8.00
    // //
    set udg_DepartureDetectionRange=512.00
    // //
    set udg_AttackPointDetectionRange=384.00
    set udg_AdditionalDetectionRange=896.00
    // //
    // //
    call StartTimerBJ(udg_BoardingOrderTimer, true, udg_BoardingOrderTimerPeriod)
    // //
    set udg_TransportationSystemsPrimed=true
    // //
    call ConditionalTriggerExecute(gg_trg_TransportationLandingZoneConfig)
endfunction

