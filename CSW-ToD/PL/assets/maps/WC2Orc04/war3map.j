//===========================================================================
// Trigger: AI P02 Start
//===========================================================================
function Trig_AI_P02_Start_Actions takes nothing returns nothing
    // //
    call SetPlayerStateBJ(udg_Player_Azerothiens, PLAYER_STATE_RESOURCE_GOLD, 5550)
    call SetPlayerStateBJ(udg_Player_Azerothiens, PLAYER_STATE_RESOURCE_LUMBER, 3550)
    call playerAddOil(Player(1) , 10000)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Azerothiens, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Azerothiens, bj_ALLIANCE_NEUTRAL)
    // //
    call ConditionalTriggerExecute(gg_trg_TransportationConfig)
    // //
    call EnableTrigger(gg_trg_AI_P02_Gold)
    call EnableTrigger(gg_trg_AI_P02_Lumber)
    // //
    // Units
    call IssueTargetOrderBJ(gg_unit_h600_0135, "smart", gg_unit_u600_0156)
    // Hero
    call SetPlayerHandicapXPBJ(udg_Player_Azerothiens, 55.00)
    // //
    call StartCampaignAI(udg_Player_Azerothiens, "CSW\\Scripts\\ToDScripts\\WC2Orc04\\WC2Orc04P02AllianceAI.ai")
    // //
    call StartTimerBJ(udg_Timer_P02AttackDelay, false, udg_Real_P02AttackDelay)
endfunction

//===========================================================================
function InitTrig_AI_P02_Start takes nothing returns nothing
    set gg_trg_AI_P02_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_P02_Start, function Trig_AI_P02_Start_Actions)
endfunction

