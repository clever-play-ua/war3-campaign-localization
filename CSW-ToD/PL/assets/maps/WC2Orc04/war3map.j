//===========================================================================
function Trig_ForceBoardingOrder_Conditions takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetOrderedUnit())) != MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_ForceBoardingOrder_Actions takes nothing returns nothing
    local integer fb
    if s__ForceBoarding_struct[GetUnitUserData(GetOrderedUnit())] != 0 then
    set fb=s__ForceBoarding_struct[GetUnitUserData(GetOrderedUnit())]
    if UnitAlive(s__ForceBoarding_marine[fb]) and UnitAlive(s__ForceBoarding_transport[fb]) then
    call IssueTargetOrderById(s__ForceBoarding_marine[fb], 851971, s__ForceBoarding_transport[fb])
    endif
    endif
endfunction

