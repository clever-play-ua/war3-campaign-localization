//===========================================================================
// Trigger: AI P04 Oil
//
// If the enemy player doesnt have oil rigs and its oil reserves less than 700, no sense in continue attacking.
// P04 Ship construction will be restricted by amount of oil to  prevent difficulty snowballing on later phase of the game
//===========================================================================
function Trig_AI_P04_Oil_Func007A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P04OilRigs)
endfunction

function Trig_AI_P04_Oil_Func015C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P04_Oil_Actions takes nothing returns nothing
    local integer p04OilRigs
    // //
    call GroupClear(udg_Group_P04OilRigs)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_LordaeronNavy, 'u600'), function Trig_AI_P04_Oil_Func007A)
    // //
    set p04OilRigs=CountUnitsInGroup(udg_Group_P04OilRigs)
    // //
    if (OilHarvest___playerOil[GetPlayerId((Player(3)))]) < 700 and p04OilRigs == 0 then // INLINED!!
    call PauseTimerBJ(true, udg_Timer_P04OilChecker)
    call ConditionalTriggerExecute(gg_trg_AI_P04_Stop_Attack_Command)
    call DisableTrigger(gg_trg_OilSpentForHumanDestroyer)
    if ( Trig_AI_P04_Oil_Func015C() ) then
        call DisplayTextToForce(udg_PlayerGroup_ActualPlayer, "TRIGSTR_2764")
    else
    endif
    endif
    // //
    call GroupClear(udg_Group_P04OilRigs)
endfunction

//===========================================================================
function InitTrig_AI_P04_Oil takes nothing returns nothing
    set gg_trg_AI_P04_Oil=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_AI_P04_Oil, udg_Timer_P04OilChecker)
    call TriggerAddAction(gg_trg_AI_P04_Oil, function Trig_AI_P04_Oil_Actions)
endfunction

