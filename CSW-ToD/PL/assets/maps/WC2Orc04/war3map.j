//===========================================================================
// Trigger: AI P03 Start
//===========================================================================
function Trig_AI_P03_Start_Actions takes nothing returns nothing
    // Resources
    call SetPlayerStateBJ(udg_Player_Lordaeron, PLAYER_STATE_RESOURCE_GOLD, 5550)
    call SetPlayerStateBJ(udg_Player_Lordaeron, PLAYER_STATE_RESOURCE_LUMBER, 3550)
    call playerAddOil(Player(2) , 10000)
    // //
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    // //
    call EnableTrigger(gg_trg_AI_P03_Gold)
    call EnableTrigger(gg_trg_AI_P03_Lumber)
    // Hero
    // AI
    // //
    call StartCampaignAI(udg_Player_Lordaeron, "CSW\\Scripts\\ToDScripts\\WC2Orc04\\WC2Orc04P03AllianceAI.ai")
    // //
endfunction

