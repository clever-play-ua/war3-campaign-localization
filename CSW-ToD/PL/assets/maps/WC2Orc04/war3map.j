    call SetPlayerTechResearchedSwap('RFcA', 1, udg_Player_Azerothiens)
    call SetPlayerTechResearchedSwap('RFcA', 1, udg_Player_LordaeronNavy)
    set udg_Real_P02AttackDelay=90.00
