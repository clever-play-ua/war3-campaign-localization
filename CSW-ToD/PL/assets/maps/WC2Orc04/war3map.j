function Trig_Initialization_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_LoadFacialAnimations)
    call ConditionalTriggerExecute(gg_trg_Oil_Locale_Setup)
    call SetAllyColorFilterState(0)
    call EnableMinimapFilterButtons(false, false)
    call SetMaxCheckpointSaves(10)
    // **********
    call ConditionalTriggerExecute(gg_trg_Init_01_Players)
    call ConditionalTriggerExecute(gg_trg_Init_03_Audio)
    call ConditionalTriggerExecute(gg_trg_Init_04_Environment)
    call ConditionalTriggerExecute(gg_trg_Init_05_Quests)
    // **********
    call QueuedTriggerAddBJ(gg_trg_Intro_Cinematic_Q, true)
endfunction

//===========================================================================
function InitTrig_Initialization takes nothing returns nothing
    set gg_trg_Initialization=CreateTrigger()
    call TriggerAddAction(gg_trg_Initialization, function Trig_Initialization_Actions)
endfunction

//===========================================================================
// Trigger: Init 01 Players
//===========================================================================
function Trig_Init_01_Players_Actions takes nothing returns nothing
    call EnableCreepSleepBJ(false)
    set udg_PlayerGroup_ActualPlayer=bj_FORCE_PLAYER[0]
    call EnableOcclusionBJ(true, udg_PlayerGroup_ActualPlayer)
    // //
    set udg_Player_Actual=Player(0)
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 40.00)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 1125)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 750)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_2531")
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Player_Actual)
    call SetPlayerAbilityAvailableBJ(false, 'AHfC', udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('RFcH', 0, udg_Player_Actual)
    // //
    set udg_Player_Azerothiens=Player(1)
    // //
    set udg_Player_Lordaeron=Player(2)
    call SetPlayerColorBJ(udg_Player_Lordaeron, PLAYER_COLOR_SNOW, true)
    // //
    set udg_Player_LordaeronNavy=Player(3)
    call SetPlayerColorBJ(udg_Player_LordaeronNavy, PLAYER_COLOR_SNOW, true)
    // //
    set udg_Player_Gilneas=Player(11)
    call SetPlayerColorBJ(udg_Player_Gilneas, ConvertPlayerColor(24), true)
    // //
    set udg_Player_BTGCinematic=Player(20)
    // //
    set udg_Player_TrollsCinematic=Player(10)
    call SetPlayerColorBJ(udg_Player_TrollsCinematic, PLAYER_COLOR_CYAN, true)
    call SetPlayerAbilityAvailableBJ(false, 'A60C', udg_Player_TrollsCinematic)
    // //
    // Alliances
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_TrollsCinematic, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_TrollsCinematic, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_TrollsCinematic, udg_Player_BTGCinematic, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_TrollsCinematic, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_Actual, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_BTGCinematic, bj_ALLIANCE_ALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_LordaeronNavy, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_LordaeronNavy, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_02_Units)
    // //
    call ConditionalTriggerExecute(gg_trg_Init_06a_Hard)
    call ConditionalTriggerExecute(gg_trg_Init_06b_Normal)
    call ConditionalTriggerExecute(gg_trg_Init_06c_Easy)
endfunction

//===========================================================================
function InitTrig_Init_01_Players takes nothing returns nothing
    set gg_trg_Init_01_Players=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_01_Players, function Trig_Init_01_Players_Actions)
endfunction

