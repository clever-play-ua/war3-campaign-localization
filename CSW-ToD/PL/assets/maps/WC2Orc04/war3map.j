//===========================================================================
// Trigger: Remnants Discover Q
//===========================================================================
function Trig_Remnants_Discover_Q_Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Rend) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Remnants_Discover_Q_Actions takes nothing returns nothing
    if ( Trig_Remnants_Discover_Q_Func001C() ) then
        call SetSpeechVolumeGroupsBJ()
        call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], Player(20), 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc04Rend4, bj_TIMETYPE_ADD, 0, true)
        call VolumeGroupResetBJ()
    else
    endif
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_Hero_Meryn, 'H62D', gg_snd_WC2Orc04Meryn17, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_LordaeronCamp), bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_Remnants=GetLastCreatedMinimapIcon()
    call CreateFogModifierRadiusLocBJ(true, Player(0), FOG_OF_WAR_FOGGED, GetRectCenter(gg_rct_LordaeronCamp), 600.00)
    call PingMinimapLocForForce(bj_FORCE_PLAYER[0], GetRectCenter(gg_rct_LordaeronCamp), 5.00)
    call ConditionalTriggerExecute(gg_trg_Remants_Ping)
    call QuestSetDiscoveredBJ(udg_OQ_Remnants, true)
    call QuestMessageBJ(udg_PlayerGroup_ActualPlayer, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2542")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

