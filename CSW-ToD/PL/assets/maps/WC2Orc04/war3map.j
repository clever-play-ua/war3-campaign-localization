    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_Azerothiens ) ) then
        return false
    endif
    if ( not Trig_DeindexPassengers_Func010C() ) then
        return false
    endif
    return true
endfunction

