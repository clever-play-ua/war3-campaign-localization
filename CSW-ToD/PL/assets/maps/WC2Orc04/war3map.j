    if ( not ( udg_Bool_P02IsAttacking == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_P02TransportsAvailable == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P02_Transports_Availiable_Checker_Func009Func002C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P02_Transports_Availiable_Checker_Func009C takes nothing returns boolean
    if ( not ( udg_Bool_P02IsAttacking == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_P02TransportsAvailable == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P02_Transports_Availiable_Checker_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    if ( Trig_AI_P02_Transports_Availiable_Checker_Func004C() ) then
        set udg_Bool_P02TransportsAvailable=false
        if ( Trig_AI_P02_Transports_Availiable_Checker_Func004Func003C() ) then
            call DisplayTextToForce(udg_PlayerGroup_ActualPlayer, "TRIGSTR_2765")
        else
        endif
    else
        set udg_Bool_P02TransportsAvailable=true
    endif
    // //
    // //
    if ( Trig_AI_P02_Transports_Availiable_Checker_Func007C() ) then
        call ConditionalTriggerExecute(gg_trg_AI_P02_Stop_Attack_Command)
        if ( Trig_AI_P02_Transports_Availiable_Checker_Func007Func002C() ) then
            call DisplayTextToForce(udg_PlayerGroup_ActualPlayer, "TRIGSTR_2766")
        else
        endif
    else
    endif
    // //
    if ( Trig_AI_P02_Transports_Availiable_Checker_Func009C() ) then
        call ConditionalTriggerExecute(gg_trg_AI_P02_Start_Attack_Command)
        if ( Trig_AI_P02_Transports_Availiable_Checker_Func009Func002C() ) then
            call DisplayTextToForce(udg_PlayerGroup_ActualPlayer, "TRIGSTR_2767")
        else
        endif
    else
    endif
    // //
endfunction

