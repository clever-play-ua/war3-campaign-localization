    return true
endfunction

function Trig_PlayerMarineAttackOrderPoint_Actions takes nothing returns nothing
    local integer landingrolldiceOrcBase
    local integer landingrolldiceHillsbrad
    local integer landingrolldiceExp
    local integer landingrolldiceStromwind
    // //
    set udg_BoardingTempUnit=GetOrderedUnit()
    set udg_TempPlayer=GetOwningPlayer(udg_BoardingTempUnit)
    set udg_TempInteger=GetConvertedPlayerId(udg_TempPlayer)
    set udg_TempIntegerId=GetIssuedOrderId()
    // //
    if ( Trig_PlayerMarineAttackOrderPoint_Func011C() ) then
        // //
        set udg_BoardingTempPoint=GetOrderPointLoc()
        // //
        // //
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func005C() ) then
            call PingMinimapLocForForceEx(udg_PlayerGroup_ActualPlayer, udg_BoardingTempPoint, 1, bj_MINIMAPPINGSTYLE_FLASHY, 100.00, 0.00, 0.00)
        else
        endif
        // //
        // We check of out Boarding Temp Point exists in the Particular Regions
        // And if the Unit is in the same region or it has to reach it first
        // //
        // First batch is for cases when our attackers are not yet in the area for landing
        // //
        // We start with the attacking player own base area
        // Azerothen Camp
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func014C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func011Func014Func001C() ) then
                set udg_AttackTempBoolean[udg_TempInteger]=true
            else
            endif
        else
        endif
        // //
        // Goldmine Expansion A
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func017C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func011Func017Func001C() ) then
                set udg_AttackTempBoolean[udg_TempInteger]=true
            else
            endif
        else
        endif
        // //
        // Hillsbrad
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func020C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func011Func020Func004C() ) then
                set udg_AttackTempBoolean[udg_TempInteger]=true
            else
            endif
        else
        endif
        // //
        // Orcs Main Base Area
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func023C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func011Func023Func004C() ) then
                set udg_AttackTempBoolean[udg_TempInteger]=true
            else
            endif
        else
        endif
        // //
        // Second Batch of checks is for cases when they are in the landing areas
        // //
        // Azerothen Camp
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func028C() ) then
            // //
            set landingrolldiceStromwind=GetRandomInt(1, 2)
            // //
            if landingrolldiceStromwind == 1 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingStromwind01)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingStromwind01)
            else
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingStromwind02)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingStromwind02)
            endif
            // //
        else
        endif
        // //
        // Exmapnsion Area 01
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func031C() ) then
            // //
            set landingrolldiceExp=GetRandomInt(1, 2)
            // //
            if landingrolldiceExp == 1 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingExpansionA01)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingExpansionA01)
            elseif landingrolldiceExp == 2 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingExpansionA02)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingExpansionA02)
            endif
            // //
        else
        endif
        // //
        // Hillsbrad
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func034C() ) then
            // //
            set landingrolldiceHillsbrad=GetRandomInt(1, 2)
            // //
            if landingrolldiceHillsbrad == 1 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingHillsbrad01)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingHillsbrad01)
            elseif landingrolldiceHillsbrad == 2 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingHillsbrad02)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingHillsbrad02)
            endif
            // //
        else
        endif
        // //
        // Orc Base
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func037C() ) then
            // //
            set landingrolldiceOrcBase=GetRandomInt(1, 2)
            // //
            if landingrolldiceOrcBase == 1 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingMainOrcBase01)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingMainOrcBase01)
            elseif landingrolldiceOrcBase == 2 then
            set udg_AttackOrderPointerX[udg_TempInteger]=GetLocationX(udg_Point_LandingMainOrcBase02)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetLocationY(udg_Point_LandingMainOrcBase02)
            endif
            // //
        else
        endif
        // //
        // Avoid Attacking Oil Rigs
        // //
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func041C() ) then
            if ( Trig_PlayerMarineAttackOrderPoint_Func011Func041Func001C() ) then
                set udg_Unit_PlayerSurfaceUnit=GroupPickRandomUnit(udg_Group_PlayerSurfaceStructures)
            else
            endif
            set udg_AttackOrderPointerX[udg_TempInteger]=GetUnitX(udg_Unit_PlayerSurfaceUnit)
            set udg_AttackOrderPointerY[udg_TempInteger]=GetUnitY(udg_Unit_PlayerSurfaceUnit)
            if not IsUnitInRangeXY(udg_BoardingTempUnit, udg_AttackOrderPointerX[udg_TempInteger], udg_AttackOrderPointerY[udg_TempInteger], 1024) then
            set udg_AttackTempBoolean[udg_TempInteger]=true
            endif
        else
        endif
        // //
        // //
        // //
        // safety measure
        if ( Trig_PlayerMarineAttackOrderPoint_Func011Func046C() ) then
            if s__ForceBoarding_struct[GetUnitUserData(udg_BoardingTempUnit)] == 0 then
            call GroupAddUnitSimple(udg_BoardingTempUnit, udg_IdleMarines[udg_TempInteger])
            endif
        else
        endif
        // //
        // Check Process Ended
        set udg_AttackTempBoolean[udg_TempInteger]=false
        call RemoveLocation(udg_BoardingTempPoint)
        // //
        // //
    else
    endif
    // //
    set udg_BoardingTempUnit=null
endfunction

