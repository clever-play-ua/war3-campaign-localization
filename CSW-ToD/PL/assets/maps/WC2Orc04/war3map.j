//***************************************************************************
//*  IndexedCargoSize
//***************************************************************************
//*  IndexShipCargo
//***************************************************************************
//*  BoardingFunc
function BoardingFunc takes integer pid returns nothing
  local integer idxsc
  local integer fbdata
  local integer fb
  local integer uty
  local integer localCargoUsage= 0
  local integer size0= 0
  local integer i0= 0
  local integer size1= 0
  local integer i1= 0
  local unit FoG
  local unit FoG2
  
  set size0=BlzGroupGetSize(udg_IdleTransports[pid])
  if size0 > 0 then
    loop
      exitwhen i0 >= size0
      set FoG=BlzGroupUnitAt(udg_IdleTransports[pid], i0)

      if UnitAlive(FoG) then
        call GroupAddUnit(udg_QueuedTransports[pid], FoG)
      endif

      set i0=i0 + 1
    endloop
  endif
  set size0=0
  set i0=0
  set FoG=null

  set size0=BlzGroupGetSize(udg_IdleMarines[pid])
  if size0 > 0 then
    loop
      exitwhen i0 >= size0
      set FoG=BlzGroupUnitAt(udg_IdleMarines[pid], i0)

      if UnitAlive(FoG) then
        call GroupAddUnit(udg_QueuedMarines[pid], FoG)
      endif

      set i0=i0 + 1
    endloop
  endif
  set size0=0
  set i0=0

  set size0=BlzGroupGetSize(udg_QueuedTransports[pid])
  if size0 > 0 then
    loop
      exitwhen i0 >= size0
      set FoG=BlzGroupUnitAt(udg_QueuedTransports[pid], i0)

      set idxsc=s__IndexShipCargo_struct[GetUnitUserData(FoG)]
      set size1=BlzGroupGetSize(udg_QueuedMarines[pid])
      if udg_CargoMaxSizeShip - s__IndexShipCargo_cargoUsed[idxsc] >= 1 then
        if size1 > 0 then
          loop
            exitwhen i1 >= size1
            set FoG2=BlzGroupUnitAt(udg_QueuedMarines[pid], i1)
          
            set uty=GetUnitTypeId(FoG2)
            set localCargoUsage=IndexedCargoSize(uty)
            set fbdata=GetUnitUserData(FoG2)
            set fb=s__ForceBoarding_struct[fbdata]

            if udg_CargoMaxSizeShip - s__IndexShipCargo_cargoUsed[idxsc] >= localCargoUsage and s__ForceBoarding_struct[fbdata] == 0 then
              call s__ForceBoarding_onIndex(FoG , FoG2)

              set s__IndexShipCargo_cargoUsed[idxsc]=s__IndexShipCargo_cargoUsed[idxsc] + localCargoUsage
              set s__IndexShipCargo_pendingPassengers[idxsc]=s__IndexShipCargo_pendingPassengers[idxsc] + 1
            endif

            set i1=i1 + 1
          endloop
        endif
      endif
      set size1=0
      set i1=0

      set i0=i0 + 1
    endloop
  endif

  set FoG=null
  set FoG2=null
endfunction
//***************************************************************************
//*  ForceBoarding
//***************************************************************************
//*  DeindexCargoFunc
function DeindexCargoFunc takes unit ship,unit pass returns nothing
        local integer idxsc
        local integer uty= GetUnitTypeId(pass)
        local integer localCargoUsage= IndexedCargoSize(uty)

        set idxsc=s__IndexShipCargo_struct[GetUnitUserData(ship)]
        if localCargoUsage > 1 then
            set s__IndexShipCargo_cargoUsed[idxsc]=s__IndexShipCargo_cargoUsed[idxsc] - localCargoUsage
        else
            set s__IndexShipCargo_cargoUsed[idxsc]=s__IndexShipCargo_cargoUsed[idxsc] - 1
        endif
endfunction

//***************************************************************************
//*
//*  Map Item Tables
//*
//***************************************************************************

function ItemTable000000_DropItems takes nothing returns nothing
    local widget trigWidget= null
    local unit trigUnit= null
    local integer itemID= 0
    local boolean canDrop= true

    set trigWidget=bj_lastDyingWidget
    if ( trigWidget == null ) then
        set trigUnit=GetTriggerUnit()
    endif

    if ( trigUnit != null ) then
        set canDrop=not IsUnitHidden(trigUnit)
        if ( canDrop and GetChangingUnit() != null ) then
            set canDrop=( GetChangingUnitPrevOwner() == Player(PLAYER_NEUTRAL_AGGRESSIVE) )
        endif
    endif

    if ( canDrop ) then
        // Item set 0
        call RandomDistReset()
        call RandomDistAddItem('lmbr', 34)
        call RandomDistAddItem('I603', 33)
        call RandomDistAddItem('IBoO', 33)
        set itemID=RandomDistChoose()
        if ( trigUnit != null ) then
            call UnitDropItem(trigUnit, itemID)
        else
            call WidgetDropItem(trigWidget, itemID)
        endif

    endif

    set bj_lastDyingWidget=null
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

