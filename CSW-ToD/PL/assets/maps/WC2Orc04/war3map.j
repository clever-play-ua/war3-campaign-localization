    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_Intro_Cinematic_VeteranAnimationSalute_Actions takes nothing returns nothing
    call SetUnitAnimation(udg_Unit_IntroVeteran[1], "Cinematic Salute One")
    call SetUnitAnimation(udg_Unit_IntroVeteran[2], "Cinematic Salute One")
    call TriggerSleepAction(0.80)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_IntroVeteran[1], "Cinematic SaluteExit One")
    call QueueUnitAnimationBJ(udg_Unit_IntroVeteran[1], "stand")
    call SetUnitAnimation(udg_Unit_IntroVeteran[2], "Cinematic SaluteExit One")
    call QueueUnitAnimationBJ(udg_Unit_IntroVeteran[2], "stand")
    call TriggerSleepAction(0.97)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimationWithRarity(udg_Unit_IntroVeteran[1], "stand", RARITY_FREQUENT)
    call SetUnitAnimationWithRarity(udg_Unit_IntroVeteran[2], "stand", RARITY_FREQUENT)
endfunction

