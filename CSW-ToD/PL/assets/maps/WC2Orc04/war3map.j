endfunction

//===========================================================================
// Trigger: VisModCampOn
//===========================================================================
function Trig_VisModCampOn_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(0) ) ) then
        return false
    endif
    if ( not ( udg_Bool_VisModCampOn[1] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_VisModCampOn_Actions takes nothing returns nothing
    set udg_Bool_VisModCampOn[1]=true
    call UnitShareVisionBJ(true, gg_unit_h004_0006, Player(0))
    call UnitShareVisionBJ(true, gg_unit_h004_0051, Player(0))
    call EnableTrigger(gg_trg_VisModCampOff)
endfunction

//===========================================================================
function InitTrig_VisModCampOn takes nothing returns nothing
    set gg_trg_VisModCampOn=CreateTrigger()
    call TriggerRegisterUnitInRangeSimple(gg_trg_VisModCampOn, 512.00, gg_unit_h004_0006)
    call TriggerRegisterUnitInRangeSimple(gg_trg_VisModCampOn, 512.00, gg_unit_h004_0051)
    call TriggerAddCondition(gg_trg_VisModCampOn, Condition(function Trig_VisModCampOn_Conditions))
    call TriggerAddAction(gg_trg_VisModCampOn, function Trig_VisModCampOn_Actions)
endfunction

//===========================================================================
// Trigger: VisModCampOff
//===========================================================================
function Trig_VisModCampOff_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_VisModCampOn[1] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_VisModCampOff_Func002Func001001001002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_VisModCampOff_Func002Func001001001002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == Player(0) )
endfunction

function Trig_VisModCampOff_Func002Func001001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetOwningPlayer(GetFilterUnit()) == Player(0))) // INLINED!!
endfunction

function Trig_VisModCampOff_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_RefugeeCamp, Condition(function Trig_VisModCampOff_Func002Func001001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_VisModCampOff_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_VisModCampOff_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        set udg_Bool_VisModCampOn[1]=false
        call UnitShareVisionBJ(false, gg_unit_h004_0006, Player(0))
        call UnitShareVisionBJ(false, gg_unit_h004_0051, Player(0))
    else
    endif
endfunction

//===========================================================================
function InitTrig_VisModCampOff takes nothing returns nothing
    set gg_trg_VisModCampOff=CreateTrigger()
    call DisableTrigger(gg_trg_VisModCampOff)
    call TriggerRegisterTimerEventPeriodic(gg_trg_VisModCampOff, 2)
    call TriggerAddCondition(gg_trg_VisModCampOff, Condition(function Trig_VisModCampOff_Conditions))
    call TriggerAddAction(gg_trg_VisModCampOff, function Trig_VisModCampOff_Actions)
endfunction

