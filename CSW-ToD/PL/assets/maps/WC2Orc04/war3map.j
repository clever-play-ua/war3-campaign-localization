//===========================================================================
// Trigger: SnowInFogLoop
//===========================================================================
function Trig_SnowInFogLoop_Func002001 takes nothing returns boolean
    return ( udg_Real_FogMax <= 9000.00 )
endfunction

function Trig_SnowInFogLoop_Actions takes nothing returns nothing
    if ( (udg_Real_FogMax <= 9000.00) ) then // INLINED!!
        call PauseTimerBJ(true, udg_SnowInTimer)
    else
        call DoNothing()
    endif
    set udg_Real_FogMax=( udg_Real_FogMax - 100.00 )
    set udg_Real_FogMin=( udg_Real_FogMin - 100.00 )
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, 39.00, 49.00, 78.00)
endfunction

