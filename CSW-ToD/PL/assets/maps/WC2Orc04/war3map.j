//===========================================================================
// Trigger: Light Snow Begin
//===========================================================================
function Trig_Light_Snow_Begin_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call AddWeatherEffectSaveLast(GetEntireMapRect(), 'SNls')
    set udg_Weather_SnowLight=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_SnowLight, true)
    set udg_Bool_SnowingOn=true
    call TriggerExecute(gg_trg_SnowIn)
    call StartTimerBJ(udg_Timer_HeavySnowOnDelay, false, GetRandomReal(udg_Real_DelayTimeSnowBot, udg_Real_DelayTimeSnowTop))
endfunction

//===========================================================================
function InitTrig_Light_Snow_Begin takes nothing returns nothing
    set gg_trg_Light_Snow_Begin=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Light_Snow_Begin, udg_Timer_LightSnowOnDelay)
    call TriggerAddAction(gg_trg_Light_Snow_Begin, function Trig_Light_Snow_Begin_Actions)
endfunction

//===========================================================================
// Trigger: Heavy Snow Begin
//===========================================================================
function Trig_Heavy_Snow_Begin_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call EnableWeatherEffect(udg_Weather_SnowLight, false)
    call RemoveWeatherEffectBJ(udg_Weather_SnowLight)
    call AddWeatherEffectSaveLast(GetEntireMapRect(), 'SNhs')
    set udg_Weather_SnowHeavy=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_SnowHeavy, true)
    call StartTimerBJ(udg_Timer_HeavySnowOFFDelay, false, GetRandomReal(( udg_Real_DelayTimeSnowBot + 120.00 ), ( udg_Real_DelayTimeSnowTop + 180.00 )))
endfunction

//===========================================================================
function InitTrig_Heavy_Snow_Begin takes nothing returns nothing
    set gg_trg_Heavy_Snow_Begin=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Heavy_Snow_Begin, udg_Timer_HeavySnowOnDelay)
    call TriggerAddAction(gg_trg_Heavy_Snow_Begin, function Trig_Heavy_Snow_Begin_Actions)
endfunction

//===========================================================================
// Trigger: Heavy Snow End
//===========================================================================
function Trig_Heavy_Snow_End_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call AddWeatherEffectSaveLast(GetEntireMapRect(), 'SNls')
    set udg_Weather_SnowLight=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_SnowLight, true)
    call EnableWeatherEffect(udg_Weather_SnowHeavy, false)
    call RemoveWeatherEffectBJ(udg_Weather_SnowHeavy)
    call StartTimerBJ(udg_Timer_LightSnowOFFDelay, false, GetRandomReal(( udg_Real_DelayTimeSnowBot + 0.00 ), ( udg_Real_DelayTimeSnowTop + 0.00 )))
endfunction

