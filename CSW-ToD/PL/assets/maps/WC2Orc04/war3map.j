    set gg_trg_Init_03_Audio=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_03_Audio, function Trig_Init_03_Audio_Actions)
endfunction

//===========================================================================
// Trigger: Init 04 Environment
//===========================================================================
function Trig_Init_04_Environment_Actions takes nothing returns nothing
    call SetTimeOfDay(12)
    call SetDoodadAnimationRectBJ("death", 'YOtf', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'YOf3', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'YOfs', GetPlayableMapRect())
    call SetDoodadAnimationRectBJ("death", 'D008', GetPlayableMapRect())
    set udg_Real_DelayTimeSnowBot=60.00
    set udg_Real_DelayTimeSnowTop=180.00
    set udg_Point_StormwindRefugeeFlee=GetRectCenter(gg_rct_CanyonExit)
    set udg_Point_HillsbradRefugeeFlee=GetRectCenter(gg_rct_Escape01)
    call ShowDestructableBJ(false, gg_dest_B61V_1374)
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, 39.00, 49.00, 78.00)
    call SetSkyModel("Environment\\Sky\\LordaeronWinterSky\\LordaeronWinterSky.mdl")
    call SetDayNightModels("csw\\environment\\dnc\\LordaeronWinter\\dnclordaeronwinterterrain.mdx", "csw\\environment\\dnc\\LordaeronWinter\\dnclordaeronwinterunit.mdx")
    call ConditionalTriggerExecute(gg_trg_Creating_and_Setting_Weather)
endfunction

//===========================================================================
function InitTrig_Init_04_Environment takes nothing returns nothing
    set gg_trg_Init_04_Environment=CreateTrigger()
    call TriggerAddAction(gg_trg_Init_04_Environment, function Trig_Init_04_Environment_Actions)
endfunction

//===========================================================================
// Trigger: Init 05 Quests
//===========================================================================
function Trig_Init_05_Quests_Actions takes nothing returns nothing
    // MAIN QUEST: THE FALL OF HILLSBRAD
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_2535", "TRIGSTR_2536", "ReplaceableTextures\\CommandButtons\\BTNCastle.blp")
    set udg_MQ_Hillsbrad=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQ_Hillsbrad, "TRIGSTR_2537")
    set udg_QReq_DestroyHillsbrad=GetLastCreatedQuestItemBJ()
    // OPTIONAL QUEST: LAMBS TO THE SLAUGHTER
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2532", "TRIGSTR_2533", "ReplaceableTextures\\CommandButtons\\BTNHumanBattleShip.blp")
    set udg_OQ_Lambs=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQ_Lambs, "TRIGSTR_2534")
    set udg_QReq_LambsShips=GetLastCreatedQuestItemBJ()
    // OPTIONAL QUEST: REMNANTS OF STORMWIND
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2539", "TRIGSTR_2540", "ReplaceableTextures\\CommandButtons\\BTNMilitia.blp")
    set udg_OQ_Remnants=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQ_Remnants, "TRIGSTR_2541")
    set udg_QReq_DestroyStormwindForces=GetLastCreatedQuestItemBJ()
endfunction

