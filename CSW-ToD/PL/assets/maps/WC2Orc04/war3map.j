//===========================================================================
// Trigger: Gilneas Cinematic Cleanup
//===========================================================================
function Trig_Gilneas_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gilneas_Cinematic_Cleanup_Func007002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Gilneas_Cinematic_Cleanup_Func014002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Gilneas_Cinematic_Cleanup_Func015002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_Gilneas_Cinematic_Cleanup_Func019C takes nothing returns boolean
    if ( not ( udg_Bool_CinGilneasSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gilneas_Cinematic_Cleanup_Func035C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gilneas_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinGilneasOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Gilneas_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // //
    call ForGroupBJ(udg_Group_CinematicGilneasShips, function Trig_Gilneas_Cinematic_Cleanup_Func007002)
    call RemoveUnit(gg_unit_odes_0250)
    call RemoveUnit(gg_unit_odes_0251)
    call RemoveUnit(gg_unit_odes_0252)
    call RemoveUnit(gg_unit_odes_0255)
    call RemoveUnit(gg_unit_odes_0256)
    // //
    call ForGroupBJ(udg_Group_GilneasShips, function Trig_Gilneas_Cinematic_Cleanup_Func014002)
    call ForGroupBJ(udg_Group_GilneasShips, function Trig_Gilneas_Cinematic_Cleanup_Func015002)
    // //
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, 39.00, 49.00, 78.00)
    // //
    if ( Trig_Gilneas_Cinematic_Cleanup_Func019C() ) then
        call StopSoundBJ(gg_snd_WC2Orc04Rend5, false)
        call StopSoundBJ(gg_snd_WC2Orc04Utok3, false)
        call StopSoundBJ(gg_snd_War2IntroMusic01, false)
    else
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call ConditionalTriggerExecute(gg_trg_CameraRestore)
    call TriggerSleepAction(0.25)
    call CameraSetupApplyForPlayer(true, udg_Var_CurrentCamera, udg_Player_Actual, 0)
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    // //
    call PauseAllUnitsBJ(false)
    // //
    call ConditionalTriggerExecute(gg_trg_SelectionRestore)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilTextShow)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Gilneas_Cinematic_Cleanup_Func035C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    call QueuedTriggerRemoveBJ(gg_trg_Gilneas_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Lambs_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Gilneas_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Gilneas_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Gilneas_Cinematic_Cleanup, function Trig_Gilneas_Cinematic_Cleanup_Actions)
endfunction

