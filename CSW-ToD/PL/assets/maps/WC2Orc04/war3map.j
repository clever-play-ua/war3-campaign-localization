//===========================================================================
// Trigger: Gilneas Cinematic FadeCameraFocus
//===========================================================================
function Trig_Gilneas_Cinematic_FadeCameraFocus_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinGilneasOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gilneas_Cinematic_FadeCameraFocus_Func001Func001C takes nothing returns boolean
    if ( not ( udg_Bool_CinGilneasOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gilneas_Cinematic_FadeCameraFocus_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=100
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Gilneas_Cinematic_FadeCameraFocus_Func001Func001C() ) then
            call CameraSetFocalDistance(udg_Real_FocalDistance)
            call CameraSetDepthOfFieldScale(udg_Real_DepthOfField)
            call TriggerSleepAction(0.05)
            set udg_Real_FocalDistance=( udg_Real_FocalDistance + 40.00 )
            set udg_Real_DepthOfField=( udg_Real_DepthOfField + 20.00 )
        else
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Gilneas_Cinematic_FadeCameraFocus takes nothing returns nothing
    set gg_trg_Gilneas_Cinematic_FadeCameraFocus=CreateTrigger()
