function Trig_Final_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call SuspendHeroXPBJ(false, udg_Hero_Rend)
    call SuspendHeroXPBJ(false, udg_Hero_ZulJeen)
    // //
    call ClearSelectionForPlayer(udg_Player_Actual)
    call CinematicModeBJ(true, udg_PlayerGroup_ActualPlayer)
    call ConditionalTriggerExecute(gg_trg_OilTextHide)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TrollsCinematic, udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, udg_Player_TrollsCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, udg_Player_BTGCinematic, bj_ALLIANCE_NEUTRAL)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Lordaeron, 'nvlk'), function Trig_Final_Cinematic_Q_Func023A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Lordaeron, 'nvk2'), function Trig_Final_Cinematic_Q_Func026A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Lordaeron, 'nvlw'), function Trig_Final_Cinematic_Q_Func029A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Lordaeron, 'nvl2'), function Trig_Final_Cinematic_Q_Func032A)
    // //
