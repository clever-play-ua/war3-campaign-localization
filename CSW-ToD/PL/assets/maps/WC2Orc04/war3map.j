    return ( udg_Bool_CinGilneasSkipped == true )
endfunction

function Trig_Gilneas_Cinematic_Q_Func072001 takes nothing returns boolean
    return ( udg_Bool_CinGilneasSkipped == true )
endfunction

function Trig_Gilneas_Cinematic_Q_Func090001 takes nothing returns boolean
    return ( udg_Bool_CinGilneasSkipped == true )
endfunction

function Trig_Gilneas_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    set udg_Var_CurrentCamera=GetCurrentCameraSetup()
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_CameraStore)
    call ConditionalTriggerExecute(gg_trg_SelectionStore)
    call ConditionalTriggerExecute(gg_trg_OilTextHide)
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call CinematicModeBJ(true, udg_PlayerGroup_ActualPlayer)
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetEntireMapRect())
    // //
    set udg_Real_CinFogZBottom=1000.00
    set udg_Real_CinFogZTop=6500.00
    set udg_Real_FocalDistance=400.00
    set udg_Real_DepthOfField=200.00
    // //
    call ForGroupBJ(udg_Group_CinematicArmada, function Trig_Gilneas_Cinematic_Q_Func021002)
    call ForGroupBJ(udg_Group_CinematicArmada, function Trig_Gilneas_Cinematic_Q_Func022002)
    call ForGroupBJ(udg_Group_CinematicGilneasShips, function Trig_Gilneas_Cinematic_Q_Func023002)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GilneasShips01, udg_Player_Actual, 0)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokObserveShips01), 280.00)
    call SetUnitColor(udg_FakeUtok, PLAYER_COLOR_RED)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_RendObserveShips), 280.00)
    call SetUnitAnimationWithRarity(udg_FakeRend, "stand", RARITY_FREQUENT)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuljin, GetRectCenter(gg_rct_ZuljinObserveShips), 280.00)
    call SetUnitAnimation(udg_FakeUtok, "Cinematic Scope One")
    // //
    call PauseAllUnitsBJ(true)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GilneasShips04, udg_Player_Actual, 5.00)
    // //
    call TriggerSleepAction(1.00)
    // //
    // Cinematic Started
    // //
    call PlaySoundBJ(gg_snd_War2IntroMusic01)
    // //
    set udg_Bool_CinGilneasOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinGilneasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGilneasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Gilneas_Cinematic_TelescopeEffect)
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_ActualPlayer, udg_FakeUtok, 0, gg_snd_WC2Orc04Utok3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGilneasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinGilneasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_ActualPlayer, udg_FakeZuljin, 0, gg_snd_WC2Orc04Zuljin2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGilneasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinGilneasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0.00, 0.00, 0.00, 0)
    // //
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CameraSetupApplyForPlayer(true, gg_cam_GilneasShips02, udg_Player_Actual, 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    // //
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_GilneasShips03, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc04Rend5), 0, 1.00, 100.00)
    // //
    call StopSoundBJ(gg_snd_War2IntroMusic01, true)
    // //
    call PlayDialogueFromSpeakerEx(bj_FORCE_PLAYER[0], udg_FakeRend, 0, gg_snd_WC2Orc04Rend5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinGilneasSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_Gilneas_Cinematic_Cleanup)
    // //
    // //
    // //
    // //
endfunction

