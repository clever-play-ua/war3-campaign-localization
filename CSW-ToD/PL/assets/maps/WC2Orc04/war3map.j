    // ---------------------
    call CreateItemLoc('I0L0', GetRectCenter(gg_rct_LocalizationItem))
    set udg_Locale_NameMagistrate=BlzGetItemTooltip(GetLastCreatedItem())
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc04Magistrate01, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc04Magistrate01, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L1', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc04Magistrate02, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc04Magistrate02, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
