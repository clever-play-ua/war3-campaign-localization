//===========================================================================
// Trigger: AI P03 Defeated
//===========================================================================
function Trig_AI_P03_Defeated_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Lordaeron ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P03_Defeated_Func005001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_AI_P03_Defeated_Func005001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P03_Defeated_Func005001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P03_Defeated_Func005A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P03DefeatCondition)
endfunction

function Trig_AI_P03_Defeated_Func008001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_AI_P03_Defeated_Func008001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P03_Defeated_Func008001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P03_Defeated_Func008A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P03DefeatCondition)
endfunction

function Trig_AI_P03_Defeated_Func010C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P03DefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P03_Defeated_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_P03DefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P03_Defeated_Func005001002)), function Trig_AI_P03_Defeated_Func005A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P03_Defeated_Func008001002)), function Trig_AI_P03_Defeated_Func008A)
    // //
    if ( Trig_AI_P03_Defeated_Func010C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_AI_P03_Gold)
        call DisableTrigger(gg_trg_AI_P03_Lumber)
        call ConditionalTriggerExecute(gg_trg_RemoveFoodStockSupplyP3)
        call ConditionalTriggerExecute(gg_trg_AI_P03_Defeat_Command)
    else
    endif
    // //
    call GroupClear(udg_Group_P03DefeatCondition)
    // //
endfunction

