    call CameraSetupSetField(gg_cam_Sky02B, CAMERA_FIELD_LOCAL_ROLL, 0.0, 0.0)
    call CameraSetupSetDestPosition(gg_cam_Sky02B, 2774.6, - 5421.2, 0.0)

    set gg_cam_Telescope01=CreateCameraSetup()
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_ZOFFSET, 50.0, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_ROTATION, 288.5, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_ANGLE_OF_ATTACK, 350.5, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_TARGET_DISTANCE, 1200.0, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_ROLL, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_FIELD_OF_VIEW, 90.0, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_FARZ, 8500.0, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_NEARZ, 16.0, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_LOCAL_PITCH, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_LOCAL_YAW, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Telescope01, CAMERA_FIELD_LOCAL_ROLL, 0.0, 0.0)
    call CameraSetupSetDestPosition(gg_cam_Telescope01, - 7187.5, - 3634.1, 0.0)

endfunction

