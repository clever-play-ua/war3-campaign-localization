//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func001C takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func008C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    if ( Trig_Next_Level_Prep_Func001C() ) then
        call StopSoundBJ(gg_snd_WC2Orc04Magistrate11, false)
        call StopSoundBJ(gg_snd_WC2Orc04Rend9, false)
        call StopSoundBJ(gg_snd_WC2Orc04Rend10, false)
        call StopSoundBJ(gg_snd_WC2Orc04Rend11, false)
        call StopSoundBJ(gg_snd_WC2Orc04Zuljin4, false)
        call StopSoundBJ(gg_snd_WC2Orc04Utok4, false)
    else
    endif
    call TriggerSleepAction(0.10)
    // //
    call StoreUnitBJ(udg_Hero_Rend, "Rend", "WC2Orc04", udg_Cache)
    // //
    call StoreUnitBJ(udg_Hero_ZulJeen, "ZulJeen", "WC2Orc04", udg_Cache)
    // //
    if ( Trig_Next_Level_Prep_Func008C() ) then
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc04", udg_Cache)
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_UtokCacheBackupIfDead), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
        call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc04", udg_Cache)
    endif
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', Player(0)), "UtokLevel", "WC2Orc04", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc04", udg_Cache)
    call TriggerSleepAction(0.10)
    call SaveGameCacheBJ(udg_Cache)
    // //
    call ShowCustomCampaignButton(true, 6)
    call ShowCustomCampaignButton(true, 7)
    // //
    call SetNextLevelBJ("WC2OrcAct2.w3x")
    call TriggerExecute(gg_trg_Finalization)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

//===========================================================================
// Trigger: Rend
//===========================================================================
function Trig_Rend_Conditions takes nothing returns boolean
    if ( not ( GetLevelingUnit() == udg_Hero_Rend ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(GetLevelingUnit()) >= 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rend_Actions takes nothing returns nothing
    call SuspendHeroXPBJ(false, udg_Hero_Rend)
endfunction

//===========================================================================
function InitTrig_Rend takes nothing returns nothing
    set gg_trg_Rend=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_Rend, Player(0), EVENT_PLAYER_HERO_LEVEL)
    call TriggerAddCondition(gg_trg_Rend, Condition(function Trig_Rend_Conditions))
    call TriggerAddAction(gg_trg_Rend, function Trig_Rend_Actions)
endfunction

