//===========================================================================
function InitTrig_Final_Cinematic_Q takes nothing returns nothing
    set gg_trg_Final_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Final_Cinematic_Q, function Trig_Final_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Final Cinematic Skipped
//===========================================================================
function Trig_Final_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinOutroSkipped=true
    set udg_Bool_CinematicSkipped=true
    call StopSoundBJ(gg_snd_DarkVictory, false)
    call StopSoundBJ(gg_snd_WC3OrcVictory, false)
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Final_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Final_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Final_Cinematic_Skipped, Condition(function Trig_Final_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Final_Cinematic_Skipped, function Trig_Final_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Final Cinematic ExecutorGruntEntersRegion
//===========================================================================
function Trig_Final_Cinematic_ExecutorGruntEntersRegion_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_Unit_GruntExecutor ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_ExecutorGruntEntersRegion_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(0.50)
    call SetUnitFacingToFaceLocTimed(udg_Unit_GruntExecutor, GetRectCenter(gg_rct_MagistrateFall), 0.50)
    call TriggerSleepAction(0.50)
    call SetUnitAnimationWithRarity(udg_Unit_GruntExecutor, "stand", RARITY_FREQUENT)
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_ExecutorGruntEntersRegion takes nothing returns nothing
    set gg_trg_Final_Cinematic_ExecutorGruntEntersRegion=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Final_Cinematic_ExecutorGruntEntersRegion, gg_rct_GruntKills)
    call TriggerAddCondition(gg_trg_Final_Cinematic_ExecutorGruntEntersRegion, Condition(function Trig_Final_Cinematic_ExecutorGruntEntersRegion_Conditions))
    call TriggerAddAction(gg_trg_Final_Cinematic_ExecutorGruntEntersRegion, function Trig_Final_Cinematic_ExecutorGruntEntersRegion_Actions)
endfunction

//===========================================================================
// Trigger: Final Cinematic UtokEntersRegion
//===========================================================================
function Trig_Final_Cinematic_UtokEntersRegion_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_FakeUtok ) ) then
        return false
    endif
    return true
endfunction

function Trig_Final_Cinematic_UtokEntersRegion_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(0.25)
    call SetUnitAnimationWithRarity(udg_FakeUtok, "stand", RARITY_FREQUENT)
endfunction

//===========================================================================
function InitTrig_Final_Cinematic_UtokEntersRegion takes nothing returns nothing
    set gg_trg_Final_Cinematic_UtokEntersRegion=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Final_Cinematic_UtokEntersRegion, gg_rct_UtokFinal)
    call TriggerAddCondition(gg_trg_Final_Cinematic_UtokEntersRegion, Condition(function Trig_Final_Cinematic_UtokEntersRegion_Conditions))
