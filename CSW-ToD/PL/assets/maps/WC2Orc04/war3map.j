    set gg_trg_AI_P03_Defeated=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AI_P03_Defeated, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AI_P03_Defeated, Condition(function Trig_AI_P03_Defeated_Conditions))
