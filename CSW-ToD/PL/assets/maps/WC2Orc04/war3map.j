    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_VeteranAnimationSalute_Func005001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

