        return false
    endif
    return true
endfunction

function Trig_Mid_Cinematic_RendAttackAnimation_Func007001 takes nothing returns boolean
    return ( udg_Bool_CinMerynSkpiied == true )
endfunction

function Trig_Mid_Cinematic_RendAttackAnimation_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitTimeScalePercent(udg_FakeRend, 50.00)
    call SetUnitAnimationByIndex(udg_FakeRend, 5)
    call QueueUnitAnimationBJ(udg_FakeRend, "attack")
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinMerynSkpiied == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ResetUnitAnimation(udg_FakeRend)
    call SetUnitTimeScalePercent(udg_FakeRend, 100.00)
    call SetUnitAnimationWithRarity(udg_FakeRend, "stand", RARITY_FREQUENT)
endfunction

