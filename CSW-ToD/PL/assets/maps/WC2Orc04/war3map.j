//===========================================================================
function Trig_Mid_Cinematic_Q_Func022002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Mid_Cinematic_Q_Func023C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Meryn) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mid_Cinematic_Q_Func028A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenTroops)
    call ShowUnitHide(GetEnumUnit())
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Mid_Cinematic_Q_Func079C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQ_Hillsbrad) == false ) ) then
        return false
    endif
    return true
endfunction

