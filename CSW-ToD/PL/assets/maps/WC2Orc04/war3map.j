function InitTrig_OilSpentForOrcTransport takes nothing returns nothing
    set gg_trg_OilSpentForOrcTransport=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_OilSpentForOrcTransport, Player(0), EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerAddAction(gg_trg_OilSpentForOrcTransport, function Trig_OilSpentForOrcTransport_Actions)
