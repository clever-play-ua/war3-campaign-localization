function InitTrig_AI_P02_Defeated takes nothing returns nothing
    set gg_trg_AI_P02_Defeated=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AI_P02_Defeated, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AI_P02_Defeated, Condition(function Trig_AI_P02_Defeated_Conditions))
