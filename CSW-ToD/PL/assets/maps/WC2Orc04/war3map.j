//library indexshipcargo:
  



    function s__IndexShipCargo_remove takes integer this,integer i returns integer
      set s__IndexShipCargo_array[i]=s__IndexShipCargo_array[s__IndexShipCargo_key]
      set s__IndexShipCargo_key=s__IndexShipCargo_key - 1
      call GroupRemoveUnit(udg_IdleTransports[s__IndexShipCargo_playerId[this]], s__IndexShipCargo_source[this])
      call GroupRemoveUnit(udg_QueuedTransports[s__IndexShipCargo_playerId[this]], s__IndexShipCargo_source[this])
      set s__IndexShipCargo_source[this]=null
      set s__IndexShipCargo_cargoUsed[this]=0
      set s__IndexShipCargo_playerId[this]=0
      set s__IndexShipCargo_isIdle[this]=false
      set s__IndexShipCargo_pendingPassengers[this]=0
      set s__IndexShipCargo_count[this]=0
      set s__IndexShipCargo_hasDeparted[this]=false
      
      if s__IndexShipCargo_key == - 1 then
        call PauseTimer(s__IndexShipCargo_timer)
      endif
      
      call s__IndexShipCargo_deallocate(this)
      
      return i - 1
    endfunction
    
    function s__IndexShipCargo_Loop takes nothing returns nothing
      local integer i= 0
      local integer this
      
      loop
        exitwhen i > s__IndexShipCargo_key
        
        set this=s__IndexShipCargo_array[i]
        if s__IndexShipCargo_struct[s__IndexShipCargo_id[this]] != 0 then
          if UnitAlive(s__IndexShipCargo_source[this]) then
            if udg_TransportationSystemsPrimed then
              if s__IndexShipCargo_cargoUsed[this] <= 0 then
                if not s__IndexShipCargo_isIdle[this] then
                  set s__IndexShipCargo_isIdle[this]=true
                  call GroupAddUnit(udg_IdleTransports[s__IndexShipCargo_playerId[this]], s__IndexShipCargo_source[this])
                  //call RecycleGuardPosition( source )
                  call IssuePointOrderById(s__IndexShipCargo_source[this], 851986, s__IndexShipCargo_xO[this], s__IndexShipCargo_yO[this])
                endif
                if s__IndexShipCargo_hasDeparted[this] then
                  set s__IndexShipCargo_hasDeparted[this]=false
                  set s__IndexShipCargo_pendingPassengers[this]=0
                  call GroupRemoveUnit(udg_DepartedTransports[s__IndexShipCargo_playerId[this]], s__IndexShipCargo_source[this])
                endif
              else
                set s__IndexShipCargo_isIdle[this]=false
                
                if s__IndexShipCargo_pendingPassengers[this] <= 0 then
                  if not s__IndexShipCargo_hasDeparted[this] then
                    set s__IndexShipCargo_hasDeparted[this]=true
                    call GroupAddUnit(udg_DepartedTransports[s__IndexShipCargo_playerId[this]], s__IndexShipCargo_source[this])
                    call GroupRemoveUnit(udg_QueuedTransports[s__IndexShipCargo_playerId[this]], s__IndexShipCargo_source[this])
                    call RemoveGuardPosition(s__IndexShipCargo_source[this])
                  endif
                  set s__IndexShipCargo_count[this]=s__IndexShipCargo_count[this] + indexshipcargo___PERIOD
                  if s__IndexShipCargo_count[this] >= indexshipcargo___FORM_INTERVAL then
                    set s__IndexShipCargo_count[this]=0
                    call ConditionalTriggerExecute(udg_LandingWarfareManipulator[s__IndexShipCargo_playerId[this]])
                  endif
                endif

              endif
            endif
          else
            set s__IndexShipCargo_struct[s__IndexShipCargo_id[this]]=0
            set i=s__IndexShipCargo_remove(this,i)
          endif
        else
          set i=s__IndexShipCargo_remove(this,i)
        endif
        set i=i + 1
      endloop
    endfunction

    function s__IndexShipCargo_onIndex takes unit src returns nothing
        local integer this
        local integer idsrc= GetUnitUserData(src)

        if s__IndexShipCargo_struct[idsrc] != 0 then
          set this=s__IndexShipCargo_struct[idsrc]
        else
          set this=s__IndexShipCargo__allocate()
          set s__IndexShipCargo_id[this]=idsrc
          set s__IndexShipCargo_source[this]=src
          set s__IndexShipCargo_cargoUsed[this]=0
          set s__IndexShipCargo_playerId[this]=GetPlayerId(GetOwningPlayer(src)) + 1
          set s__IndexShipCargo_isIdle[this]=false
          set s__IndexShipCargo_count[this]=0
          set s__IndexShipCargo_pendingPassengers[this]=0
          set s__IndexShipCargo_hasDeparted[this]=false
          set s__IndexShipCargo_key=s__IndexShipCargo_key + 1
          set s__IndexShipCargo_array[s__IndexShipCargo_key]=this
          set s__IndexShipCargo_struct[s__IndexShipCargo_id[this]]=this
          
          set s__IndexShipCargo_xC[this]=GetUnitX(s__IndexShipCargo_source[this])
          set s__IndexShipCargo_yC[this]=GetUnitY(s__IndexShipCargo_source[this])
          set s__IndexShipCargo_xO[this]=GetUnitX(s__IndexShipCargo_source[this])
          set s__IndexShipCargo_yO[this]=GetUnitY(s__IndexShipCargo_source[this])
        endif

        if s__IndexShipCargo_key == 0 then
          call TimerStart(s__IndexShipCargo_timer, indexshipcargo___PERIOD, true, function s__IndexShipCargo_Loop)
        endif
    endfunction

