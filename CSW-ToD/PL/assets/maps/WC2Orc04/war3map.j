function Trig_CrowdScreams_Func001Func001Func002C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CrowdScreams_Func001Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CrowdScreams_Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 2) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CrowdScreams_Actions takes nothing returns nothing
    if ( Trig_CrowdScreams_Func001C() ) then
        call PlaySoundBJ(gg_snd_ebonhold_crowdscream4)
