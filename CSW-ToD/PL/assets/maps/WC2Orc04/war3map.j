function Trig_Init_Reload_Actions takes nothing returns nothing
    call SetMapFacialAnimations()
    // Clear any pending music list
    call ClearMapMusicBJ()
    // Play music
    call PolledWait(0.10)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

