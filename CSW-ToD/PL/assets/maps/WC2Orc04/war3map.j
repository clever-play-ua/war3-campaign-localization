    call CameraSetupSetField(gg_cam_Sky02B, CAMERA_FIELD_ROLL, 0.0, 0.0)
    call CameraSetupSetField(gg_cam_Sky02B, CAMERA_FIELD_FIELD_OF_VIEW, 70.0, 0.0)
    call CameraSetupSetField(gg_cam_Sky02B, CAMERA_FIELD_FARZ, 6000.0, 0.0)
    call CameraSetupSetField(gg_cam_Sky02B, CAMERA_FIELD_NEARZ, 100.0, 0.0)
