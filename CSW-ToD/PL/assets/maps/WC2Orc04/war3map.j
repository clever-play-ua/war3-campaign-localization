function Trig_DeindexPassengers_Func010C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hfAM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hAaM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'H62D' ) ) then
        return true
    endif
    return false
endfunction

