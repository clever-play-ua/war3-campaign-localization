function Trig_Mid_Cinematic_Q_Actions takes nothing returns nothing
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    set udg_Var_CurrentCamera=GetCurrentCameraSetup()
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_CameraStore)
    call CinematicModeBJ(true, udg_PlayerGroup_ActualPlayer)
    call ConditionalTriggerExecute(gg_trg_OilTextHide)
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call ConditionalTriggerExecute(gg_trg_SelectionStore)
    call CameraSetupApplyForPlayer(true, gg_cam_RendKillsMeryn01, Player(0), 0)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Azerothiens, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Azerothiens, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Azerothiens, udg_Player_BTGCinematic, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BTGCinematic, udg_Player_Azerothiens, bj_ALLIANCE_NEUTRAL)
    // //
    call ForGroupBJ(udg_Group_RefugeesStormwind, function Trig_Mid_Cinematic_Q_Func022002)
    if ( Trig_Mid_Cinematic_Q_Func023C() ) then
        call ShowUnitHide(udg_Hero_Meryn)
    else
    endif
    // //
    call SetDoodadAnimationRectBJ("decay", 'NOfp', gg_rct_Pitfitre)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_RefugeeCamp, udg_Player_Actual), function Trig_Mid_Cinematic_Q_Func028A)
    // //
    call ShowUnitHide(udg_Hero_Rend)
    call PauseUnitBJ(true, udg_Hero_Rend)
    call ShowUnitHide(udg_Hero_ZulJeen)
    call PauseUnitBJ(true, udg_Hero_ZulJeen)
    call ShowUnitHide(udg_SemiHero_Utok)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.20)
    // //
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeMeryn)
    call PauseUnitBJ(true, udg_FakeMeryn)
    call SetUnitInvulnerable(udg_FakeMeryn, true)
    call SetUnitAnimation(udg_FakeMeryn, "Cinematic Injured One")
    call SetUnitOwner(udg_FakeMeryn, udg_Player_Azerothiens, true)
    // //
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, true)
    // //
    call AddSpecialEffectTargetUnitBJ("origin", udg_FakeMeryn, "Abilities\\Spells\\Orc\\Ensnare\\ensnareTarget.mdl")
    set udg_SE_Nets=GetLastCreatedEffectBJ()
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_RendApproachesMeryn), GetRectCenter(gg_rct_RendKillsMeryn))
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', udg_Player_Actual, GetRectCenter(gg_rct_Grunt01), GetRectCenter(gg_rct_MerynIntro05))
    set udg_Unit_CinGrunt[1]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', udg_Player_Actual, GetRectCenter(gg_rct_Grunt02), GetRectCenter(gg_rct_MerynIntro05))
    set udg_Unit_CinGrunt[2]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', udg_Player_Actual, GetRectCenter(gg_rct_Grunt03), GetRectCenter(gg_rct_MerynIntro05))
    set udg_Unit_CinGrunt[3]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', udg_Player_Actual, GetRectCenter(gg_rct_Grunt04), GetRectCenter(gg_rct_MerynIntro05))
    set udg_Unit_CinGrunt[4]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', udg_Player_Actual, GetRectCenter(gg_rct_Grunt05), GetRectCenter(gg_rct_MerynIntro05))
    set udg_Unit_CinGrunt[5]=GetLastCreatedUnit()
    // //
    // Start
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_HumanDefeat)
    // //
    set udg_Bool_CinMerynOn=true
    set udg_Bool_CinematicSkipped=false
    // //
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_RendKillsMeryn))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100.00, udg_FakeRend)
    // //
    if ( Trig_Mid_Cinematic_Q_Func079C() ) then
        set udg_Real_MidgameCameraWaitFork=GetSoundDurationBJ(gg_snd_WC2Orc04Meryn18)
    else
        set udg_Real_MidgameCameraWaitFork=0.00
    endif
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_RendKillsMeryn02, udg_Player_Actual, ( ( DistanceBetweenPoints(GetUnitLoc(udg_FakeRend), GetRectCenter(gg_rct_RendKillsMeryn)) / GetUnitMoveSpeed(udg_FakeRend) ) + ( GetSoundDurationBJ(gg_snd_WC2Orc04Rend7) + ( GetSoundDurationBJ(gg_snd_WC2Orc04Rend8) + ( udg_Real_MidgameCameraWaitFork + ( GetSoundDurationBJ(gg_snd_WC2Orc04Meryn19) + 1 ) ) ) ) ), 0.00, 10.00, 100.00)
    // //
    set udg_Point_RendTempCin=GetUnitLoc(udg_FakeRend)
    call TriggerSleepAction(( ( DistanceBetweenPoints(udg_Point_RendTempCin, GetRectCenter(gg_rct_RendKillsMeryn)) / GetUnitMoveSpeed(udg_FakeRend) ) - 1 ))
    if ( (udg_Bool_CinMerynSkpiied == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_ActualPlayer, udg_FakeRend, 0, gg_snd_WC2Orc04Rend7, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinMerynSkpiied == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimationWithRarity(udg_FakeRend, "stand", RARITY_FREQUENT)
    // //
    call SetUnitFacingToFaceLocTimed(udg_FakeRend, GetRectCenter(gg_rct_Grunt04), 0.50)
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc04Rend7) - 1 ))
    if ( (udg_Bool_CinMerynSkpiied == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call AddSpecialEffectTargetUnitBJ("origin", udg_FakeMeryn, "Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodSmall0.mdl")
    set udg_SE_Bloodsplats[1]=GetLastCreatedEffectBJ()
    // //
    if ( Trig_Mid_Cinematic_Q_Func099C() ) then
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_ActualPlayer, udg_FakeMeryn, 0, gg_snd_WC2Orc04Meryn18, bj_TIMETYPE_ADD, 0, true)
        if ( (udg_Bool_CinMerynSkpiied == true) ) then // INLINED!!
            return
        else
            call DoNothing()
        endif
    else
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_ActualPlayer, udg_FakeMeryn, 0, gg_snd_WC2Orc04Meryn19, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinMerynSkpiied == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call AddSpecialEffectTargetUnitBJ("origin", udg_FakeMeryn, "Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodSmall1.mdl")
    set udg_SE_Bloodsplats[2]=GetLastCreatedEffectBJ()
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_ActualPlayer, udg_FakeRend, 0, gg_snd_WC2Orc04Rend8, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinMerynSkpiied == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_Mid_Cinematic_RendAttackAnimation)
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinMerynSkpiied == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundOnUnitBJ(gg_snd_MetalHeavySliceFlesh2, 100, udg_FakeRend)
    call AddSpecialEffectTargetUnitBJ("origin", udg_FakeMeryn, "Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodLarge0.mdl")
    set udg_SE_Bloodsplats[3]=GetLastCreatedEffectBJ()
    // //
    call PlaySoundOnUnitBJ(gg_snd_FootmanDeath2, 100, udg_FakeMeryn)
    // //
    call SetUnitAnimation(udg_FakeMeryn, "Cinematic Die")
    call DestroyEffectBJ(udg_SE_Nets)
    // //
    call TriggerSleepAction(3.50)
    if ( (udg_Bool_CinMerynSkpiied == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call StopSoundBJ(gg_snd_HumanDefeat, true)
    // //
    call ConditionalTriggerExecute(gg_trg_Mid_Cinematic_Cleanup)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Mid_Cinematic_Q takes nothing returns nothing
    set gg_trg_Mid_Cinematic_Q=CreateTrigger()
    call TriggerAddAction(gg_trg_Mid_Cinematic_Q, function Trig_Mid_Cinematic_Q_Actions)
endfunction

//===========================================================================
// Trigger: Mid Cinematic Skipped
//===========================================================================
function Trig_Mid_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinMerynOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mid_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinMerynSkpiied=true
    set udg_Bool_CinematicSkipped=true
    call ConditionalTriggerExecute(gg_trg_Mid_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Mid_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Mid_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Mid_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Mid_Cinematic_Skipped, Condition(function Trig_Mid_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Mid_Cinematic_Skipped, function Trig_Mid_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Mid Cinematic Cleanup
//===========================================================================
function Trig_Mid_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mid_Cinematic_Cleanup_Func025C takes nothing returns boolean
    if ( not ( udg_Bool_CinMerynSkpiied == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mid_Cinematic_Cleanup_Func029002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_Mid_Cinematic_Cleanup_Func030A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
    call PauseUnitBJ(false, GetEnumUnit())
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_HiddenTroops)
endfunction

function Trig_Mid_Cinematic_Cleanup_Func048C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mid_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinMerynOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Mid_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call CreateNUnitsAtLoc(1, 'HMrc', udg_Player_Azerothiens, GetRectCenter(gg_rct_MerynIntro05), 232.37)
    set udg_Unit_MerynCorpse=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_MerynCorpse, "Cinematic Dead")
    call PauseUnitBJ(true, udg_Unit_MerynCorpse)
    call SetUnitInvulnerable(udg_Unit_MerynCorpse, true)
    call UnitAddAbility(udg_Unit_MerynCorpse, 'Aloc')
    // //
    call RemoveLocation(udg_Point_RendTempCin)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveUnit(udg_Unit_CinGrunt[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call DestroyEffectBJ(udg_SE_Nets)
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=3
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call DestroyEffectBJ(udg_SE_Bloodsplats[GetForLoopIndexB()])
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Azerothiens, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Azerothiens, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Lordaeron, bj_ALLIANCE_UNALLIED)
    // //
    if ( Trig_Mid_Cinematic_Cleanup_Func025C() ) then
        call StopSoundBJ(gg_snd_HumanDefeat, false)
        call StopSoundBJ(gg_snd_WC2Orc04Rend7, false)
        call StopSoundBJ(gg_snd_WC2Orc04Rend8, false)
        call StopSoundBJ(gg_snd_WC2Orc04Meryn18, false)
        call StopSoundBJ(gg_snd_WC2Orc04Meryn19, false)
    else
    endif
    // //
    call CreateItemLoc('mcou', GetRectCenter(gg_rct_MerynIntro05))
    // //
    call ForGroupBJ(udg_Group_RefugeesStormwind, function Trig_Mid_Cinematic_Cleanup_Func029002)
    call ForGroupBJ(udg_Group_HiddenTroops, function Trig_Mid_Cinematic_Cleanup_Func030A)
    // //
    call ShowUnitShow(udg_Hero_Rend)
    call PauseUnitBJ(false, udg_Hero_Rend)
    call ShowUnitShow(udg_Hero_ZulJeen)
    call PauseUnitBJ(false, udg_Hero_ZulJeen)
    call ShowUnitShow(udg_SemiHero_Utok)
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', false, false)
    // //
    call ConditionalTriggerExecute(gg_trg_CameraRestore)
    call TriggerSleepAction(0.25)
    call CameraSetupApplyForPlayer(true, udg_Var_CurrentCamera, udg_Player_Actual, 0)
    call ConditionalTriggerExecute(gg_trg_SelectionRestore)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_OilTextShow)
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Mid_Cinematic_Cleanup_Func048C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    call QueuedTriggerRemoveBJ(gg_trg_Mid_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    // //
endfunction

//===========================================================================
function InitTrig_Mid_Cinematic_Cleanup takes nothing returns nothing
    set gg_trg_Mid_Cinematic_Cleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_Mid_Cinematic_Cleanup, function Trig_Mid_Cinematic_Cleanup_Actions)
endfunction

