endfunction

function Trig_Init_02_Units_Func048002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Init_02_Units_Func049002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Init_02_Units_Func050002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_Init_02_Units_Func051002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_Init_02_Units_Actions takes nothing returns nothing
    // Remove Cinematic Dummies
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(23)), function Trig_Init_02_Units_Func003A)
    // //
    set udg_Hero_Meryn=gg_unit_H62D_0082
    set udg_Unit_Magistrate=gg_unit_nchp_0094
    set udg_Unit_IntroVeteran[1]=gg_unit_hfSw_0190
    set udg_Unit_IntroVeteran[2]=gg_unit_hfSw_0257
    // //
    // Removed it for AI behaviour reasons
    call UnitRemoveTypeBJ(UNIT_TYPE_TOWNHALL, gg_unit_h61C_0148)
    // ----------
    // Added invisible Elven Lumber Mill for Player 3 (also in victory requirement in trigger Hillsbrad Completed) so Player 3 can build Destroyers
    // //
    call SetUnitInvulnerable(gg_unit_h615_0069, true)
    call ShowUnitHide(gg_unit_h615_0069)
    // Units
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Gilneas, 'h60R'), function Trig_Init_02_Units_Func019002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Gilneas, 'hFrK'), function Trig_Init_02_Units_Func022002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(PLAYER_NEUTRAL_PASSIVE), 'oDSS'), function Trig_Init_02_Units_Func025002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(PLAYER_NEUTRAL_PASSIVE), 'o60R'), function Trig_Init_02_Units_Func028002)
    // //
    call ForGroupBJ(udg_Group_GilneasShips, function Trig_Init_02_Units_Func030002)
    call ForGroupBJ(udg_Group_GilneasShips, function Trig_Init_02_Units_Func031002)
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Init_02_Units_Func032002)
    call ForGroupBJ(udg_Group_OrcishArmada, function Trig_Init_02_Units_Func033002)
    // //
    // this one was bugged in 1.05 test
    call GroupAddUnitSimple(gg_unit_odes_0250, udg_Group_CinematicArmada)
    call GroupAddUnitSimple(gg_unit_odes_0251, udg_Group_CinematicArmada)
    call GroupAddUnitSimple(gg_unit_odes_0252, udg_Group_CinematicArmada)
    call GroupAddUnitSimple(gg_unit_odes_0255, udg_Group_CinematicArmada)
    call GroupAddUnitSimple(gg_unit_odes_0256, udg_Group_CinematicArmada)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Gilneas, 'hbsh'), function Trig_Init_02_Units_Func043002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Gilneas, 'hdes'), function Trig_Init_02_Units_Func046002)
    // //
    call ForGroupBJ(udg_Group_CinematicArmada, function Trig_Init_02_Units_Func048002)
    call ForGroupBJ(udg_Group_CinematicArmada, function Trig_Init_02_Units_Func049002)
    call ForGroupBJ(udg_Group_CinematicGilneasShips, function Trig_Init_02_Units_Func050002)
    call ForGroupBJ(udg_Group_CinematicGilneasShips, function Trig_Init_02_Units_Func051002)
    // ----------
    call GroupAddUnitSimple(gg_unit_h61C_0001, udg_Group_HillsbradStructures)
    call GroupAddUnitSimple(gg_unit_h61C_0090, udg_Group_HillsbradStructures)
    call GroupAddUnitSimple(gg_unit_h616_0093, udg_Group_HillsbradStructures)
    call GroupAddUnitSimple(gg_unit_h616_0092, udg_Group_HillsbradStructures)
    call GroupAddUnitSimple(gg_unit_h614_0091, udg_Group_HillsbradStructures)
    call GroupAddUnitSimple(gg_unit_hCBL_0089, udg_Group_HillsbradStructures)
    // ----------
    call ShowUnitHide(gg_unit_hFSs_0198)
    call ShowUnitHide(gg_unit_hFSs_0199)
    call ShowUnitHide(gg_unit_hFSs_0161)
    // ----------
    call TriggerExecute(gg_trg_Load_Heroes)
endfunction

