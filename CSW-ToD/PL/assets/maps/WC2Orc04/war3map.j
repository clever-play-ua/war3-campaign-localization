    if ( ( GetUnitTypeId(GetDyingUnit()) == 'ncbd' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'ncbe' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'ncbf' ) ) then
        return true
    endif
    return false
endfunction

function Trig_ProduceRefugees_Func009C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetDyingUnit()) == Player(2) ) ) then
        return false
    endif
    if ( not Trig_ProduceRefugees_Func009Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_ProduceRefugees_Actions takes nothing returns nothing
    set udg_Point_RefugeeSpawn=GetUnitLoc(GetDyingUnit())
    // Stromwind
    if ( Trig_ProduceRefugees_Func007C() ) then
        if ( Trig_ProduceRefugees_Func007Func001C() ) then
            call CreateNUnitsAtLoc(1, 'nvlk', Player(PLAYER_NEUTRAL_PASSIVE), GetUnitLoc(GetDyingUnit()), GetRandomReal(0, 359.00))
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesStormwind)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_StormwindRefugeeFlee)
            if ( Trig_ProduceRefugees_Func007Func001Func010C() ) then
                call PlaySoundAtPointBJ(gg_snd_H06VillagerF61, 80.00, GetUnitLoc(GetDyingUnit()), 0)
            else
            endif
        else
            call CreateNUnitsAtLoc(1, 'nvk2', Player(PLAYER_NEUTRAL_PASSIVE), GetUnitLoc(GetDyingUnit()), GetRandomReal(0, 359.00))
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesStormwind)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_StormwindRefugeeFlee)
            if ( Trig_ProduceRefugees_Func007Func001Func005C() ) then
                call PlaySoundAtPointBJ(gg_snd_H06VillagerF61, 80.00, GetUnitLoc(GetDyingUnit()), 0)
            else
            endif
        endif
        call CreateNUnitsAtLoc(1, 'nvlw', Player(1), GetUnitLoc(GetDyingUnit()), GetRandomReal(0, 359.00))
        call RemoveGuardPosition(GetLastCreatedUnit())
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesStormwind)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_StormwindRefugeeFlee)
        if ( Trig_ProduceRefugees_Func007Func006C() ) then
            call PlaySoundAtPointBJ(gg_snd_H06VillagerF57, 80.00, GetUnitLoc(GetDyingUnit()), 0)
        else
        endif
    else
    endif
    // Hillsbrad
    if ( Trig_ProduceRefugees_Func009C() ) then
        if ( Trig_ProduceRefugees_Func009Func001C() ) then
            call CreateNUnitsAtLoc(1, 'nvlk', Player(PLAYER_NEUTRAL_PASSIVE), GetUnitLoc(GetDyingUnit()), GetRandomReal(0, 359.00))
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesHillsbrad)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_HillsbradRefugeeFlee)
            if ( Trig_ProduceRefugees_Func009Func001Func010C() ) then
                call PlaySoundAtPointBJ(gg_snd_H06VillagerF61, 80.00, GetUnitLoc(GetDyingUnit()), 0)
            else
            endif
        else
            call CreateNUnitsAtLoc(1, 'nvk2', Player(PLAYER_NEUTRAL_PASSIVE), GetUnitLoc(GetDyingUnit()), GetRandomReal(0, 359.00))
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesHillsbrad)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_HillsbradRefugeeFlee)
            if ( Trig_ProduceRefugees_Func009Func001Func005C() ) then
                call PlaySoundAtPointBJ(gg_snd_H06VillagerF61, 80.00, GetUnitLoc(GetDyingUnit()), 0)
            else
            endif
        endif
        if ( Trig_ProduceRefugees_Func009Func002C() ) then
            call CreateNUnitsAtLoc(1, 'nvlw', Player(2), GetUnitLoc(GetDyingUnit()), GetRandomReal(0, 359.00))
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesHillsbrad)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_HillsbradRefugeeFlee)
            if ( Trig_ProduceRefugees_Func009Func002Func010C() ) then
                call PlaySoundAtPointBJ(gg_snd_H06VillagerF57, 80.00, GetUnitLoc(GetDyingUnit()), 0)
            else
            endif
        else
            call CreateNUnitsAtLoc(1, 'nvl2', Player(2), GetUnitLoc(GetDyingUnit()), GetRandomReal(0, 359.00))
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesHillsbrad)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_HillsbradRefugeeFlee)
            if ( Trig_ProduceRefugees_Func009Func002Func005C() ) then
                call PlaySoundAtPointBJ(gg_snd_H06VillagerM26, 80.00, GetUnitLoc(GetDyingUnit()), 0)
            else
            endif
        endif
        if ( Trig_ProduceRefugees_Func009Func003C() ) then
            call CreateNUnitsAtLoc(1, 'nvil', Player(2), GetUnitLoc(GetDyingUnit()), GetRandomReal(0, 359.00))
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesHillsbrad)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_HillsbradRefugeeFlee)
            if ( Trig_ProduceRefugees_Func009Func003Func010C() ) then
                call PlaySoundAtPointBJ(gg_snd_H06VillagerM25, 80.00, GetUnitLoc(GetDyingUnit()), 0)
            else
            endif
        else
            call CreateNUnitsAtLoc(1, 'nhef', Player(2), GetUnitLoc(GetDyingUnit()), GetRandomReal(0, 359.00))
            call RemoveGuardPosition(GetLastCreatedUnit())
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesHillsbrad)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_HillsbradRefugeeFlee)
            if ( Trig_ProduceRefugees_Func009Func003Func005C() ) then
                call PlaySoundAtPointBJ(gg_snd_H06VillagerF24, 80.00, GetUnitLoc(GetDyingUnit()), 0)
            else
            endif
        endif
    else
    endif
    // //
    call RemoveLocation(udg_Point_RefugeeSpawn)
endfunction

