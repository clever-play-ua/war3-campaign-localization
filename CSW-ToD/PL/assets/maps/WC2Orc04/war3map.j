//library forceboarding:

    

    function s__ForceBoarding_remove takes integer this,integer i returns integer
      set s__ForceBoarding_array[i]=s__ForceBoarding_array[s__ForceBoarding_key]
      set s__ForceBoarding_key=s__ForceBoarding_key - 1
      set s__ForceBoarding_marine[this]=null
      set s__ForceBoarding_transport[this]=null
      set s__ForceBoarding_isLoaded[this]=false
      set s__ForceBoarding_playerId[this]=0
      
      if s__ForceBoarding_key == - 1 then
        call PauseTimer(s__ForceBoarding_timer)
      endif
      
      call s__ForceBoarding_deallocate(this)
      
      return i - 1
    endfunction

    function s__ForceBoarding_Loop takes nothing returns nothing
      local integer i= 0
      local integer this
      local integer idxsc
      local integer uty
      local integer localCargoUsage
      
      loop
        exitwhen i > s__ForceBoarding_key
        
        set this=s__ForceBoarding_array[i]
        if s__ForceBoarding_struct[s__ForceBoarding_id[this]] != 0 then
          set s__ForceBoarding_count[this]=s__ForceBoarding_count[this] + forceboarding___PERIOD
          set idxsc=s__IndexShipCargo_struct[GetUnitUserData(s__ForceBoarding_transport[this])]
          if UnitAlive(s__ForceBoarding_marine[this]) and UnitAlive(s__ForceBoarding_transport[this]) and not s__ForceBoarding_isLoaded[this] then
            if s__ForceBoarding_count[this] >= forceboarding___INTERVAL then
              set s__ForceBoarding_count[this]=0
              call IssueTargetOrderById(s__ForceBoarding_marine[this], 851971, s__ForceBoarding_transport[this])
            endif
          else
            if s__ForceBoarding_isLoaded[this] then
              set s__IndexShipCargo_pendingPassengers[idxsc]=s__IndexShipCargo_pendingPassengers[idxsc] - 1
            endif
            if not UnitAlive(s__ForceBoarding_marine[this]) then
              set s__IndexShipCargo_pendingPassengers[idxsc]=s__IndexShipCargo_pendingPassengers[idxsc] - 1
              set uty=GetUnitTypeId(s__ForceBoarding_marine[this])
              set localCargoUsage=IndexedCargoSize(uty)
              set s__IndexShipCargo_cargoUsed[idxsc]=s__IndexShipCargo_cargoUsed[idxsc] - localCargoUsage
            endif
            if not UnitAlive(s__ForceBoarding_transport[this]) then
              if UnitAlive(s__ForceBoarding_marine[this]) then
                call GroupAddUnit(udg_IdleMarines[s__ForceBoarding_playerId[this]], s__ForceBoarding_marine[this])
              endif
            endif
            set s__ForceBoarding_struct[s__ForceBoarding_id[this]]=0
            set i=s__ForceBoarding_remove(this,i)
          endif
        else
          set i=s__ForceBoarding_remove(this,i)
        endif
        set i=i + 1
      endloop
    endfunction

    function s__ForceBoarding_onIndex takes unit ship,unit pass returns nothing
      local integer this
      local integer idpass= GetUnitUserData(pass)
      
      if s__ForceBoarding_struct[idpass] != 0 then
        set this=s__ForceBoarding_struct[idpass]
      else
        set this=s__ForceBoarding__allocate()
        set s__ForceBoarding_id[this]=idpass
        set s__ForceBoarding_struct[s__ForceBoarding_id[this]]=this
        set s__ForceBoarding_transport[this]=ship
        set s__ForceBoarding_marine[this]=pass
        set s__ForceBoarding_isLoaded[this]=false
        set s__ForceBoarding_playerId[this]=GetPlayerId(GetOwningPlayer(s__ForceBoarding_marine[this])) + 1
        set s__ForceBoarding_count[this]=GetRandomReal(0, 1.4)
        set s__ForceBoarding_key=s__ForceBoarding_key + 1
        set s__ForceBoarding_array[s__ForceBoarding_key]=this
        set s__ForceBoarding_struct[s__ForceBoarding_id[this]]=this
      endif

      if s__ForceBoarding_key == 0 then
        call TimerStart(s__ForceBoarding_timer, forceboarding___PERIOD, true, function s__ForceBoarding_Loop)
      endif
    endfunction

