//===========================================================================
function Trig_PlayerMarineLandingOrder_Conditions takes nothing returns boolean
    if ( not ( udg_LandingWarfareHasRan[GetConvertedPlayerId(udg_Player_Azerothiens)] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_PlayerMarineLandingOrder_Func003Func002A takes nothing returns nothing
    local integer isc
    set isc=s__IndexShipCargo_struct[GetUnitUserData(GetEnumUnit())]
    if IsUnitInRangeXY(GetEnumUnit(), s__IndexShipCargo_xC[isc], s__IndexShipCargo_yC[isc], udg_DepartureDetectionRange) then
    call IssuePointOrderById(GetEnumUnit(), 851986, udg_AttackOrderPointerX[udg_TempInteger], udg_AttackOrderPointerY[udg_TempInteger])
    else
    call IssuePointOrderLocBJ(GetEnumUnit(), "unloadall", udg_TempPointM)
    endif
endfunction

function Trig_PlayerMarineLandingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_DepartedTransports[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PlayerMarineLandingOrder_Actions takes nothing returns nothing
    set udg_TempInteger=GetConvertedPlayerId(udg_Player_Azerothiens)
    set udg_LandingWarfareHasRan[udg_TempInteger]=true
    if ( Trig_PlayerMarineLandingOrder_Func003C() ) then
        set udg_TempPointM=Location(udg_AttackOrderPointerX[udg_TempInteger], udg_AttackOrderPointerY[udg_TempInteger])
        call ForGroupBJ(udg_DepartedTransports[udg_TempInteger], function Trig_PlayerMarineLandingOrder_Func003Func002A)
        call RemoveLocation(udg_TempPointM)
    else
    endif
    set udg_LandingWarfareHasRan[udg_TempInteger]=false
endfunction

