    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_IdleMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarinesAdditional[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_UnitsInCargo)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P02MarineBallistas)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P02MarineRanged)
endfunction

