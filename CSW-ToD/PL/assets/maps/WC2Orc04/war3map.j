//===========================================================================
function Trig_PlayerSurfaceUnitsIndex_Func003C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'o614' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'o613' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'o612' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'h608' ) ) then
        return true
    endif
