//===========================================================================
// Trigger: Lambs Completed
//===========================================================================
function Trig_Lambs_Completed_Conditions takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_OQ_Lambs) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lambs_Completed_Func005001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'e60C' )
endfunction

function Trig_Lambs_Completed_Func005001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Lambs_Completed_Func005001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'e60C'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Lambs_Completed_Func007001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60R' )
endfunction

function Trig_Lambs_Completed_Func007001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Lambs_Completed_Func007001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h60R'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_Lambs_Completed_Func008C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_LambsEnemyShips) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lambs_Completed_Actions takes nothing returns nothing
    call GroupClear(udg_Group_LambsEnemyShips)
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_Gilneas, Condition(function Trig_Lambs_Completed_Func005001002)), udg_Group_LambsEnemyShips)
    set bj_wantDestroyGroup=true
    call GroupAddGroup(GetUnitsOfPlayerMatching(udg_Player_Gilneas, Condition(function Trig_Lambs_Completed_Func007001002)), udg_Group_LambsEnemyShips)
    if ( Trig_Lambs_Completed_Func008C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QueuedTriggerAddBJ(gg_trg_Lambs_Completed_Q, true)
        call QueuedTriggerAddBJ(gg_trg_UtokLevelUpChecker_Q, true)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Lambs_Completed takes nothing returns nothing
    set gg_trg_Lambs_Completed=CreateTrigger()
    call DisableTrigger(gg_trg_Lambs_Completed)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Lambs_Completed, 2)
    call TriggerAddCondition(gg_trg_Lambs_Completed, Condition(function Trig_Lambs_Completed_Conditions))
    call TriggerAddAction(gg_trg_Lambs_Completed, function Trig_Lambs_Completed_Actions)
endfunction

//===========================================================================
// Trigger: Lambs Completed Q
//===========================================================================
function Trig_Lambs_Completed_Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestItemSetCompletedBJ(udg_QReq_LambsShips, true)
    call QuestSetCompletedBJ(udg_OQ_Lambs, true)
    call DestroyMinimapIcon(udg_MinimapIcon_Lambs)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_TrollsCinematic, 'O60B', GetCameraTargetPositionLoc(), gg_snd_WC2Orc04Zuljin3, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(bj_FORCE_PLAYER[0], udg_Player_BTGCinematic, 'O617', GetCameraTargetPositionLoc(), gg_snd_WC2Orc04Rend6, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call SetPlayerAbilityAvailableBJ(true, 'AHfC', udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('RFcH', 1, udg_Player_Actual)
    // //
    call QuestMessageBJ(udg_PlayerGroup_ActualPlayer, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_2546")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerAddBJ(gg_trg_FrontalCannonShot_Hint_Q, true)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

