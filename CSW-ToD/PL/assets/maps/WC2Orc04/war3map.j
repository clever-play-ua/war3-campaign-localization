function Trig_TRReturnAndRecycle_Func001Func001Func006C takes nothing returns boolean
    return true
endfunction

function Trig_TRReturnAndRecycle_Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_IdleTransports[GetConvertedPlayerId(udg_Player_Azerothiens)]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_QueuedTransports[GetConvertedPlayerId(udg_Player_Azerothiens)]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_DepartedTransports[GetConvertedPlayerId(udg_Player_Azerothiens)]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TRReturnAndRecycle_Func001Func002C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TRReturnAndRecycle_Func001A takes nothing returns nothing
    if ( Trig_TRReturnAndRecycle_Func001Func001C() ) then
        call RecycleGuardPosition(GetEnumUnit())
        // Covering Repair case here
        if ( (true) ) then // INLINED!!
            // Covering Repair case here
        else
        endif
    else
    endif
    if ( Trig_TRReturnAndRecycle_Func001Func002C() ) then
        call GroupRemoveUnitSimple(GetEnumUnit(), udg_Group_AITransShipReturnAwait)
    else
    endif
endfunction

function Trig_TRReturnAndRecycle_Actions takes nothing returns nothing
    call ForGroupBJ(udg_Group_AITransShipReturnAwait, function Trig_TRReturnAndRecycle_Func001A)
endfunction

