    call SetDialogueTextKey(gg_snd_WC2Orc04Magistrate04, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L4', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc04Magistrate05, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc04Magistrate05, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L5', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc04Magistrate06, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc04Magistrate06, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L6', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc04Magistrate07, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc04Magistrate07, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L7', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc04Magistrate08, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc04Magistrate08, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L8', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc04Magistrate9, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc04Magistrate9, BlzGetItemDescription(GetLastCreatedItem()))
    call RemoveItem(GetLastCreatedItem())
    // //
    call CreateItemLoc('I0L9', GetRectCenter(gg_rct_LocalizationItem))
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc04Magistrate10, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc04Magistrate10, BlzGetItemDescription(GetLastCreatedItem()))
