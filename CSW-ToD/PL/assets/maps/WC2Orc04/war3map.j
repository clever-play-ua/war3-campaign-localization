//===========================================================================
// Trigger: Intro Cinematic Skipped
//===========================================================================
function Trig_Intro_Cinematic_Skipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Skipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    set udg_Bool_CinematicSkipped=true
    call StopSoundBJ(gg_snd_Comradeship, false)
    call StopSoundBJ(gg_snd_TragicConfrontation, false)
    call StopSoundBJ(gg_snd_SadMystery, false)
    call StopSoundBJ(gg_snd_TheHorde, false)
    call TriggerExecute(gg_trg_Intro_Cinematic_Cleanup)
endfunction

//===========================================================================
function InitTrig_Intro_Cinematic_Skipped takes nothing returns nothing
    set gg_trg_Intro_Cinematic_Skipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_Intro_Cinematic_Skipped, Player(0))
    call TriggerAddCondition(gg_trg_Intro_Cinematic_Skipped, Condition(function Trig_Intro_Cinematic_Skipped_Conditions))
    call TriggerAddAction(gg_trg_Intro_Cinematic_Skipped, function Trig_Intro_Cinematic_Skipped_Actions)
endfunction

//===========================================================================
// Trigger: Intro Cinematic Cleanup
//===========================================================================
function Trig_Intro_Cinematic_Cleanup_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Func117C takes nothing returns boolean
    if ( not ( udg_Bool_CinematicSkipped == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Intro_Cinematic_Cleanup_Actions takes nothing returns nothing
    set udg_Bool_CinIntroOn=false
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func003C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // ----------------------------------------
    // //
    call StopSoundBJ(gg_snd_WC2Orc04Rend1, false)
    call StopSoundBJ(gg_snd_WC2Orc04Rend2, false)
    call StopSoundBJ(gg_snd_WC2Orc04Rend3, false)
    call StopSoundBJ(gg_snd_WC2Orc04Zuljin1, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn1, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn2, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn3, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn4, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn5, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn6, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn7, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn8, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn9, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn10, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn12, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn13, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn14, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn15, false)
    call StopSoundBJ(gg_snd_WC2Orc04Meryn16, false)
    call StopSoundBJ(gg_snd_WC2Orc04Magistrate01, false)
    call StopSoundBJ(gg_snd_WC2Orc04Magistrate02, false)
    call StopSoundBJ(gg_snd_WC2Orc04Magistrate03, false)
    call StopSoundBJ(gg_snd_WC2Orc04Magistrate04, false)
    call StopSoundBJ(gg_snd_WC2Orc04Magistrate05, false)
    call StopSoundBJ(gg_snd_WC2Orc04Magistrate06, false)
    call StopSoundBJ(gg_snd_WC2Orc04Magistrate07, false)
    call StopSoundBJ(gg_snd_WC2Orc04Magistrate08, false)
    call StopSoundBJ(gg_snd_WC2Orc04Magistrate9, false)
    call StopSoundBJ(gg_snd_WC2Orc04Patrick1, false)
    call StopSoundBJ(gg_snd_WC2Orc04Patrick2, false)
    call StopSoundBJ(gg_snd_WC2Orc04Utok1, false)
    call StopSoundBJ(gg_snd_WC2Orc04Utok2a, false)
    call StopSoundBJ(gg_snd_WC2Orc04Utok2b, false)
    // //
    // MnageActors
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call RemoveLocation(udg_Point_MerynTempCin)
    call RemoveLocation(udg_Point_MilitiaTempCin)
    // //
    call RemoveUnit(gg_unit_hrdh_0106)
    call RemoveUnit(gg_unit_hrdh_0084)
    call SetUnitPositionLocFacingBJ(gg_unit_hrdh_0158, GetRectCenter(gg_rct_Horse02Stand), bj_UNIT_FACING)
    call SetUnitPositionLocFacingBJ(gg_unit_hrdh_0157, GetRectCenter(gg_rct_Horse01Stand), 315.00)
    // //
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", gg_unit_h60K_0121)
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", gg_unit_h60K_0022)
    call SetUnitFacingToFaceLocTimed(gg_unit_h60K_0121, GetRectCenter(gg_rct_MerynIntro03), 0)
    call SetUnitFacingToFaceLocTimed(gg_unit_h60K_0022, GetRectCenter(gg_rct_MerynIntro03), 0)
    // //
    call RemoveUnit(udg_Unit_CinDummy[1])
    call RemoveUnit(udg_Unit_CinDummy[2])
    // //
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroVeteran[1], GetRectCenter(gg_rct_P02FarmsExp01), bj_UNIT_FACING)
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", udg_Unit_IntroVeteran[1])
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroVeteran[1], UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call SetUnitMoveSpeed(udg_Unit_IntroVeteran[1], GetUnitDefaultMoveSpeed(udg_Unit_IntroVeteran[1]))
    // //
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroVeteran[2], GetRectCenter(gg_rct_P02FarmsExp02), 225.00)
    call AddUnitAnimationPropertiesBJ(false, "Cinematic", udg_Unit_IntroVeteran[2])
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroVeteran[2], UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call SetUnitMoveSpeed(udg_Unit_IntroVeteran[2], GetUnitDefaultMoveSpeed(udg_Unit_IntroVeteran[1]))
    // //
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_Intro_PathBlocker1), 0.00, 1, 0)
    call CreateDestructableLoc('YTpc', GetRectCenter(gg_rct_Intro_PathBlocker2), 0.00, 1, 0)
    // //
    call SetUnitBlendTimeBJ(udg_Unit_IntroVeteran[1], 0.15)
    call SetUnitBlendTimeBJ(udg_Unit_IntroVeteran[2], 0.15)
    // //
    call RemoveUnit(udg_Unit_DummyForFaceLock)
    // //
    call ResetUnitLookAt(gg_unit_hmil_0192)
    call ResetUnitLookAt(gg_unit_hmil_0191)
    // //
    call ShowUnitHide(udg_Unit_Magistrate)
    // //
    call RemoveUnit(gg_unit_hmil_0191)
    call RemoveUnit(gg_unit_hmil_0192)
    // RestoringGameplayUnits
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_ZulJeen, GetRectCenter(gg_rct_ZulJeenDefault), 330.00)
    call SetUnitPositionLocFacingBJ(udg_SemiHero_Utok, GetRectCenter(gg_rct_UtokDefault), 330.00)
    call SetUnitPositionLocFacingBJ(udg_Hero_Meryn, GetRectCenter(gg_rct_MerynIntro05), 255.00)
    call SelectHeroSkill(udg_Hero_Meryn, 'A620')
    call BlzUnitDisableAbility(udg_Hero_Meryn, 'A620', false, false)
    call SetUnitPositionLocFacingBJ(udg_Hero_Rend, GetRectCenter(gg_rct_RendDefault), 330.00)
    // //
    call ShowUnitShow(udg_Hero_Rend)
    call ShowUnitShow(udg_Hero_Meryn)
    call ShowUnitShow(udg_Hero_ZulJeen)
    call ShowUnitShow(udg_SemiHero_Utok)
    // //
    call SelectUnitForPlayerSingle(udg_Hero_Rend, udg_Player_Actual)
    call SelectUnitAddForPlayer(udg_Hero_ZulJeen, udg_Player_Actual)
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', false, false)
    // //
    call CameraSetupApplyForPlayer(true, udg_Var_CurrentCamera, udg_Player_Actual, 0)
    // //
    call TriggerSleepAction(0.01)
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call ConditionalTriggerExecute(gg_trg_SetUpOilPatches)
    call SetDoodadAnimationRectBJ("death", 'D002', gg_rct_Wallpapers)
    // //
    call CinematicModeBJ(false, udg_PlayerGroup_ActualPlayer)
    call ConditionalTriggerExecute(gg_trg_OilTextShow)
    call UnitAddAbilityBJ('A60C', udg_Hero_ZulJeen)
    call SetSkyModel("Environment\\Sky\\LordaeronWinterSky\\LordaeronWinterSky.mdl")
    // ----------------------------------------
    // Fade Faster If Cinematic Skipped
    if ( Trig_Intro_Cinematic_Cleanup_Func117C() ) then
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(0.50)
    endif
    // //
    call QueuedTriggerRemoveBJ(gg_trg_Intro_Cinematic_Q)
    call ConditionalTriggerExecute(gg_trg_Hillsbrad_Discover)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    // //
    // //
endfunction

