    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o614'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AllUnitsDead_Defeat_Func005001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o614'), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

