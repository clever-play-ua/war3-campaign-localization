    call SetPlayerStateBJ(udg_Player_LordaeronNavy, PLAYER_STATE_RESOURCE_GOLD, 2500)
    call SetPlayerStateBJ(udg_Player_LordaeronNavy, PLAYER_STATE_RESOURCE_LUMBER, 2500)
    if ( Trig_AI_P04_Naval_Start_Func005C() ) then
        call playerAddOil(Player(3) , 100000)
    else
        if ( Trig_AI_P04_Naval_Start_Func005Func003C() ) then
            call playerAddOil(Player(3) , 75000)
        else
            call playerAddOil(Player(3) , 50000)
        endif
    endif
    call SetPlayerStateBJ(udg_Player_LordaeronNavy, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    call SetPlayerStateBJ(udg_Player_LordaeronNavy, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    // //
    call EnableTrigger(gg_trg_AI_P04_Gold)
    call EnableTrigger(gg_trg_AI_P04_Lumber)
    // //
    call StartCampaignAI(udg_Player_LordaeronNavy, "CSW\\Scripts\\ToDScripts\\WC2Orc04\\WC2Orc04P04AllianceNavalAI.ai")
    // //
endfunction

