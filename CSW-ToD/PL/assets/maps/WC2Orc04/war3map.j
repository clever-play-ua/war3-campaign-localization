    call DisableTrigger(GetTriggeringTrigger())
    call EnableWeatherEffect(udg_Weather_SnowLight, false)
    call RemoveWeatherEffectBJ(udg_Weather_SnowLight)
    set udg_Bool_SnowingOn=false
