//===========================================================================
// Trigger: UtokLevelUpChecker Q
//===========================================================================
function Trig_UtokLevelUpChecker_Q_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_OQ_Lambs) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_OQ_Remnants) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokLevelUpChecker_Q_Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokLevelUpChecker_Q_Func004C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_OQ_Lambs) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_OQ_Remnants) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_UtokLevelUpChecker_Q_Actions takes nothing returns nothing
    if ( Trig_UtokLevelUpChecker_Q_Func004C() ) then
        if ( Trig_UtokLevelUpChecker_Q_Func004Func001C() ) then
            call AddSpecialEffectTargetUnitBJ("origin", udg_SemiHero_Utok, "Abilities\\Spells\\Other\\Levelup\\Levelupcaster.mdx")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
        else
        endif
        call SetPlayerTechResearchedSwap('RUX2', ( GetPlayerTechCountSimple('RUX2', Player(0)) + 1 ), Player(0))
    else
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_UtokLevelUpChecker_Q takes nothing returns nothing
    set gg_trg_UtokLevelUpChecker_Q=CreateTrigger()
    call TriggerAddCondition(gg_trg_UtokLevelUpChecker_Q, Condition(function Trig_UtokLevelUpChecker_Q_Conditions))
    call TriggerAddAction(gg_trg_UtokLevelUpChecker_Q, function Trig_UtokLevelUpChecker_Q_Actions)
endfunction

