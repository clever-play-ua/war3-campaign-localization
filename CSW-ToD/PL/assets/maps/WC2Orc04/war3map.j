    call PlaySoundAtPointBJ(gg_snd_WaterWavesLoop1, 100, GetRectCenter(gg_rct_Waves02), 10.00)
    call TriggerSleepAction(3.00)
    call PlaySoundAtPointBJ(gg_snd_WaterWavesLoop1, 100, GetRectCenter(gg_rct_Waves03), 10.00)
    call TriggerSleepAction(3.00)
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

