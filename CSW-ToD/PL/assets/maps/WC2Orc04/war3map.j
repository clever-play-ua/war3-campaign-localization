    set gg_trg_Remants_Completed=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Remants_Completed, 1.00)
    call TriggerAddCondition(gg_trg_Remants_Completed, Condition(function Trig_Remants_Completed_Conditions))
    call TriggerAddAction(gg_trg_Remants_Completed, function Trig_Remants_Completed_Actions)
