function Trig_Gilneas_Cinematic_TelescopeEffect_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CameraSetupApplyForPlayer(true, gg_cam_Telescope01, Player(0), 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Scope_Mask.blp", 100.00, 100.00, 100.00, 0)
    call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_FIELD_OF_VIEW, 50.00, 4.00)
    call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_ANGLE_OF_ATTACK, 357.15, 4.00)
    call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_ZOFFSET, 150.00, 4.00)
    call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_TARGET_DISTANCE, 200.00, 4.00)
    call CameraSetSourceNoiseForPlayer(udg_Player_Actual, 10.00, 0.20)
    call ConditionalTriggerExecute(gg_trg_Gilneas_Cinematic_FadeCameraFocus)
    call ConditionalTriggerExecute(gg_trg_Gilneas_Cinematic_FadeCameraFog)
endfunction

