//library idxcargosize:
  function IndexedCargoSize takes integer uty returns integer
    if uty == 'e000' or uty == 'hBAM' or uty == 'hBaM' or uty == 'n60B' or uty == 'h60L' or uty == 'hKAM' or uty == 'hKsM' or uty == 'h002' then
      return 2
    else
      return 1
    endif
  endfunction

