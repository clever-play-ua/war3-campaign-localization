//===========================================================================
// Trigger: Load Rend
//===========================================================================
function Trig_Load_Rend_Func005C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc03", udg_Cache) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Rend_Actions takes nothing returns nothing
    call RestoreUnitLocFacingPointBJ("Rend", "WC2Orc03", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_RendCin01), GetRectCenter(gg_rct_ZulJeenCin01))
    set udg_Hero_Rend=GetLastRestoredUnitBJ()
    call SetUnitColor(udg_Hero_Rend, PLAYER_COLOR_COAL)
    // DefaultHero
    if ( Trig_Load_Rend_Func005C() ) then
        call CreateNUnitsAtLocFacingLocBJ(1, 'O617', udg_Player_Actual, GetRectCenter(gg_rct_RendCin01), GetRectCenter(gg_rct_ZulJeenCin01))
        set udg_Hero_Rend=GetLastCreatedUnit()
        call SetHeroLevelBJ(GetLastCreatedUnit(), 4, false)
        call SelectHeroSkill(udg_Hero_Rend, 'AR9Q')
        call SelectHeroSkill(udg_Hero_Rend, 'A00O')
        call SelectHeroSkill(udg_Hero_Rend, 'A00O')
        call SelectHeroSkill(udg_Hero_Rend, 'A00N')
        call UnitAddItemByIdSwapped('I60B', GetLastCreatedUnit())
        call SetUnitColor(udg_Hero_Rend, PLAYER_COLOR_COAL)
    else
    endif
    // //
    call BlzUnitDisableAbility(udg_Hero_Rend, 'A00N', true, false)
    // //
endfunction

