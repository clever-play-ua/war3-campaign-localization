    call CameraSetupSetField(gg_cam_Sky02, CAMERA_FIELD_LOCAL_ROLL, 0.0, 0.0)
    call CameraSetupSetDestPosition(gg_cam_Sky02, 2812.1, - 5382.9, 0.0)

    set gg_cam_Sky02B=CreateCameraSetup()
