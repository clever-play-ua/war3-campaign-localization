function InitTrig_CreateFakeActors takes nothing returns nothing
    set gg_trg_CreateFakeActors=CreateTrigger()
    call TriggerAddAction(gg_trg_CreateFakeActors, function Trig_CreateFakeActors_Actions)
endfunction

