//===========================================================================
function Trig_Remants_Completed_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_OQ_Remnants) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Remants_Completed_Func003C takes nothing returns boolean
    if ( not ( CountLivingPlayerUnitsOfTypeId('h60Z', udg_Player_Azerothiens) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Remants_Completed_Func006C takes nothing returns boolean
    if ( not ( CountLivingPlayerUnitsOfTypeId('h61C', udg_Player_Azerothiens) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Remants_Completed_Func009C takes nothing returns boolean
    if ( not ( CountLivingPlayerUnitsOfTypeId('h614', udg_Player_Azerothiens) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Remants_Completed_Func012C takes nothing returns boolean
    if ( not ( CountLivingPlayerUnitsOfTypeId('h616', udg_Player_Azerothiens) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Remants_Completed_Func014C takes nothing returns boolean
    if ( not ( udg_Bool_OQRBarracksDestroyed == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_OQRBlacksmithDestroyed == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_OQRTHDestroyed == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_OQRTowerDestroyed == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Remants_Completed_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_Remants_Completed_Func003C() ) then
        set udg_Bool_OQRTowerDestroyed=true
    else
    endif
    // //
    set bj_wantDestroyGroup=true
    if ( Trig_Remants_Completed_Func006C() ) then
        set udg_Bool_OQRTHDestroyed=true
    else
    endif
    // //
    set bj_wantDestroyGroup=true
    if ( Trig_Remants_Completed_Func009C() ) then
        set udg_Bool_OQRBlacksmithDestroyed=true
    else
    endif
    // //
    set bj_wantDestroyGroup=true
    if ( Trig_Remants_Completed_Func012C() ) then
        set udg_Bool_OQRBarracksDestroyed=true
    else
    endif
    // //
    if ( Trig_Remants_Completed_Func014C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_Remants_Ping)
        call QueuedTriggerAddBJ(gg_trg_Remants_Completed_Q, true)
        call QueuedTriggerAddBJ(gg_trg_UtokLevelUpChecker_Q, true)
        call QueuedTriggerAddBJ(gg_trg_Mid_Cinematic_Q, true)
    else
    endif
endfunction

