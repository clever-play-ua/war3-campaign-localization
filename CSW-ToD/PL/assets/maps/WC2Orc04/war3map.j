function SetAutoFacialAnimationsOrc takes sound soundHandle,string speakerName returns nothing
 local real soundDuration= GetSoundDurationBJ(soundHandle)
    call SetDialogueSpeakerNameKey(soundHandle, speakerName)

	if ( soundDuration >= 29.577 ) then
	call SetSoundFacialAnimationLabel(soundHandle, "DR01Morg05A")
	call SetSoundFacialAnimationGroupLabel(soundHandle, "Map-Shaman")
	call SetSoundFacialAnimationSetFilepath(soundHandle, "sound/dialogue/faceanimation/orcx01/facialanimation/shaman.animset_ingame")

			elseif ( soundDuration >= 24.469 ) then
	call SetSoundFacialAnimationLabel(soundHandle, "DR01Morg01A")
	call SetSoundFacialAnimationGroupLabel(soundHandle, "Map-Shaman")
	call SetSoundFacialAnimationSetFilepath(soundHandle, "sound/dialogue/faceanimation/orcx01/facialanimation/shaman.animset_ingame")

			elseif ( soundDuration >= 23.697 ) then
	call SetSoundFacialAnimationLabel(soundHandle, "D07AGarthok02")
	call SetSoundFacialAnimationGroupLabel(soundHandle, "Map-GarThok")
	call SetSoundFacialAnimationSetFilepath(soundHandle, "sound/dialogue/faceanimation/orcx01/facialanimation/garthok.animset_ingame")

			elseif ( soundDuration >= 18.217 ) then
	call SetSoundFacialAnimationLabel(soundHandle, "D06ADrekThar03")
