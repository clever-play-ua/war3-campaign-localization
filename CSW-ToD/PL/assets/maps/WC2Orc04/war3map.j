    set gg_trg_OilSpentForHumanDestroyer=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OilSpentForHumanDestroyer, EVENT_PLAYER_UNIT_TRAIN_START)
    call TriggerAddCondition(gg_trg_OilSpentForHumanDestroyer, Condition(function Trig_OilSpentForHumanDestroyer_Conditions))
