//===========================================================================
// Trigger: BoardingOrder
//===========================================================================
function Trig_BoardingOrder_Func003Func004C takes nothing returns boolean
    if ( not ( udg_BoardingOrderTimerCount[udg_TempInteger] >= udg_BoardingOrderTimerInterval ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Func003Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[udg_TempInteger]) <= 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Func003Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[udg_TempInteger]) <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_IdleMarines[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_IdleTransports[udg_TempInteger]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BoardingOrder_Actions takes nothing returns nothing
    set udg_TempPlayer=udg_Player_Azerothiens
    set udg_TempInteger=GetConvertedPlayerId(udg_Player_Azerothiens)
    if ( Trig_BoardingOrder_Func003C() ) then
        set udg_BoardingOrderTimerCount[udg_TempInteger]=( udg_BoardingOrderTimerCount[udg_TempInteger] + udg_BoardingOrderTimerPeriod )
        if ( Trig_BoardingOrder_Func003Func004C() ) then
            set udg_BoardingOrderTimerCount[udg_TempInteger]=0.00
            call BoardingFunc(udg_TempInteger)
        else
        endif
        if ( Trig_BoardingOrder_Func003Func005C() ) then
            call GroupClear(udg_QueuedMarines[udg_TempInteger])
        else
        endif
        if ( Trig_BoardingOrder_Func003Func006C() ) then
            call GroupClear(udg_QueuedTransports[udg_TempInteger])
        else
        endif
    else
        set udg_BoardingOrderTimerCount[udg_TempInteger]=0.00
    endif
endfunction

//===========================================================================
function InitTrig_BoardingOrder takes nothing returns nothing
    set gg_trg_BoardingOrder=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_BoardingOrder, udg_BoardingOrderTimer)
    call TriggerAddAction(gg_trg_BoardingOrder, function Trig_BoardingOrder_Actions)
endfunction

//===========================================================================
// Trigger: DetectSeaLoading
//===========================================================================
function Trig_DetectSeaLoading_Conditions takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[GetUnitUserData(udg_CargoTransportUnit[udg_UDex])] == 'h60P' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_Azerothiens ) ) then
        return false
    endif
    return true
endfunction

function Trig_DetectSeaLoading_Actions takes nothing returns nothing
    local integer i= 0
    local integer size= 0
    local unit FoG
    local integer fb= s__ForceBoarding_struct[GetUnitUserData(udg_UDexUnits[udg_UDex])]
    local integer isc= s__IndexShipCargo_struct[GetUnitUserData(udg_CargoTransportUnit[udg_UDex])]
    // //
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_IdleMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupAddUnitSimple(udg_UDexUnits[udg_UDex], udg_UnitsInCargo)
    // //
    set s__IndexShipCargo_xC[isc]=GetUnitX(udg_CargoTransportUnit[udg_UDex])
    set s__IndexShipCargo_yC[isc]=GetUnitY(udg_CargoTransportUnit[udg_UDex])
    // Commented out code might be needed if we will use some assault units with heal autocast
    // //
    // Safeguard against the units that are stuck in heal autocast
    // Add unit types in conditions for config
    // Temporary Off
    // //
    set s__ForceBoarding_isLoaded[fb]=true
    set FoG=null
endfunction

//===========================================================================
function InitTrig_DetectSeaLoading takes nothing returns nothing
    set gg_trg_DetectSeaLoading=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_DetectSeaLoading, "udg_CargoEvent", EQUAL, 1.00)
    call TriggerAddCondition(gg_trg_DetectSeaLoading, Condition(function Trig_DetectSeaLoading_Conditions))
    call TriggerAddAction(gg_trg_DetectSeaLoading, function Trig_DetectSeaLoading_Actions)
endfunction

