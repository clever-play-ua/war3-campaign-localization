//===========================================================================
// Trigger: Intro Cinematic Setup
//===========================================================================
function Trig_Intro_Cinematic_Setup_Actions takes nothing returns nothing
    set udg_Bool_CinematicSkipped=false
    call ConditionalTriggerExecute(gg_trg_OilTextHide)
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    call ShowUnitHide(udg_Hero_Meryn)
    call ShowUnitHide(udg_Hero_Rend)
    call ShowUnitHide(udg_Hero_ZulJeen)
    call ShowUnitHide(udg_SemiHero_Utok)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    call SetUnitPathing(udg_Unit_Magistrate, false)
    call SetUnitPositionLocFacingBJ(udg_Unit_Magistrate, GetRectCenter(gg_rct_MagistrateIntro01), bj_UNIT_FACING)
    call SetUnitBlendTimeBJ(udg_Unit_Magistrate, 0.25)
    // //
    call SetUnitOwner(udg_FakeMeryn, udg_Player_Azerothiens, true)
    call SetUnitPositionLocFacingBJ(udg_FakeMeryn, GetRectCenter(gg_rct_MerynIntro), 90.00)
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeMeryn)
    call BlzSetUnitRealFieldBJ(udg_FakeMeryn, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_FakeMeryn, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeMeryn, 0.25)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeZuljin, GetRectCenter(gg_rct_ZulJeenCin01), 39.15)
    call SetUnitOwner(udg_FakeZuljin, udg_Player_TrollsCinematic, true)
    call SetUnitBlendTimeBJ(udg_FakeZuljin, 0.25)
    call SetUnitAnimation(udg_FakeZuljin, "cinematic listening one")
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokLoad), 135.00)
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    call SetUnitAnimationWithRarity(udg_FakeUtok, "stand", RARITY_FREQUENT)
    call SetUnitOwner(udg_FakeUtok, udg_Player_Actual, true)
    // //
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_RendCin01), GetRectCenter(gg_rct_ZulJeenCin01))
    call BlzSetUnitFacingEx(udg_FakeRend, 299.57)
    call SetUnitLookAt(udg_FakeRend, "bone_head", udg_Hero_ZulJeen, 0, 0, 87.00)
    // //
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_Unit_IntroVeteran[1])
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroVeteran[1], UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_Unit_IntroVeteran[1], 100.00)
    call SetUnitBlendTimeBJ(udg_Unit_IntroVeteran[1], 0.25)
    // //
    call AddUnitAnimationPropertiesBJ(true, "Cinematic", udg_Unit_IntroVeteran[2])
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroVeteran[2], UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitMoveSpeed(udg_Unit_IntroVeteran[2], 100.00)
    call SetUnitBlendTimeBJ(udg_Unit_IntroVeteran[2], 0.25)
    // //
    call BlzUnitDisableAbility(udg_Hero_Meryn, 'A620', true, true)
    // //
    call CreateNUnitsAtLoc(1, 'u004', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DummyA), bj_UNIT_FACING)
    set udg_Unit_CinDummy[1]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'u004', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_DummyB), bj_UNIT_FACING)
    set udg_Unit_CinDummy[2]=GetLastCreatedUnit()
    // //
    set udg_Var_CurrentCamera=gg_cam_OutPost
    // //
    call TriggerSleepAction(0.01)
    call SetStackedSoundBJ(true, gg_snd_CS_H01a_village_004_LR_v3, gg_rct_Hillsbrad)
endfunction

