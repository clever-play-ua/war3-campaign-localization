function Trig_Intro_Cinematic_Q_Actions takes nothing returns nothing
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call CinematicModeBJ(true, udg_PlayerGroup_ActualPlayer)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // SetUp
    call CameraSetupApplyForPlayer(true, gg_cam_HillsbradIntro01, udg_Player_Actual, 0)
    // ------------------------------------------
    // Hillsbrad
    // ------------------------------------------
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_Setup)
    call TriggerSleepAction(0.50)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    set udg_Bool_CinIntroOn=true
    // //
    call PlaySoundBJ(gg_snd_Comradeship)
    // //
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_HillsbradIntro01B, udg_Player_Actual, 7.00, 0, 1.00, 100.00)
    // //
    call PlaySoundAtPointBJ(gg_snd_DoorSlam1, 100, GetRectCenter(gg_rct_MagistrateIntro02), 0)
    call IssuePointOrderLocBJ(udg_Unit_Magistrate, "move", GetRectCenter(gg_rct_MagistrateIntro02))
    loop
        exitwhen ( (RectContainsUnit(gg_rct_MagistrateIntro02, udg_Unit_Magistrate) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimationWithRarity(udg_Unit_Magistrate, "stand", RARITY_FREQUENT)
    call SetUnitAnimation(udg_FakeMeryn, "Cinematic Salute One")
    // //
    call ConditionalTriggerExecute(gg_trg_Intro_Cinematic_VeteranAnimationSalute)
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_H01a_soldiers_turn_a, 50.00, udg_Hero_Meryn)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeMeryn, "Cinematic Salute Exit One")
