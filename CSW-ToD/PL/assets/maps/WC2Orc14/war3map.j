function InitTrig_NextLevelPrep takes nothing returns nothing
    set gg_trg_NextLevelPrep=CreateTrigger()
    call TriggerAddAction(gg_trg_NextLevelPrep, function Trig_NextLevelPrep_Actions)
endfunction

//===========================================================================
