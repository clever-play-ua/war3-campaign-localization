    set gg_trg_CrossIslandOutroSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_CrossIslandOutroSkipped, Player(0))
    call TriggerAddCondition(gg_trg_CrossIslandOutroSkipped, Condition(function Trig_CrossIslandOutroSkipped_Conditions))
