// Trigger: UniteTheClans
//===========================================================================
function Trig_UniteTheClans_Func019A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_UniteTheClans_Func022A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_UniteTheClans_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_GameOver=true
    call DisableTrigger(gg_trg_BarracksDestroyed)
    call DisableTrigger(gg_trg_AviaryDestroyed)
    call DisableTrigger(gg_trg_StablesDestroyed)
    call DisableTrigger(gg_trg_TownHallDestroyed)
    call DisableTrigger(gg_trg_KeepDestroyed)
    call DisableTrigger(gg_trg_CastleDestroyed)
    call DisableTrigger(gg_trg_ChurchDestroyed)
    call DisableTrigger(gg_trg_MageTowerDestroyed)
    call DisableTrigger(gg_trg_QMLHCompletedQ)
    call DisableTrigger(gg_trg_QOTGCompleted)
    call DisableTrigger(gg_trg_QOTGDiscoveredQ)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_SECRET, "TRIGSTR_3983")
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_Player_Lordaeron), function Trig_UniteTheClans_Func019A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_Player_LordaeronNaval), function Trig_UniteTheClans_Func022A)
    // //
    call TriggerSleepAction(2.00)
    // //
    call ConditionalTriggerExecute(gg_trg_VictoryCinematicQ)
endfunction

//===========================================================================
function InitTrig_UniteTheClans takes nothing returns nothing
    set gg_trg_UniteTheClans=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_UniteTheClans, Player(0), "unitetheclans", true)
    call TriggerAddAction(gg_trg_UniteTheClans, function Trig_UniteTheClans_Actions)
endfunction

