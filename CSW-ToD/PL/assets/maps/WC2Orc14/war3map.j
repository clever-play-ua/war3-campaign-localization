function Trig_IntroSpawnCitizensHideout_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundAtPointBJ(gg_snd_CS_Prologue2_Foley1, 65.00, GetRectCenter(gg_rct_IntroChildTalks), 0)
    set udg_Int_IntroCitizenIndex=1
    // //Woman//
    call CreateNUnitsAtLoc(1, 'n00V', udg_Player_Citizens, udg_Point_IntroCitizensSpawn, 90.00)
    set udg_Unit_IntroCItizenHideoutArr[udg_Int_IntroCitizenIndex]=GetLastCreatedUnit()
    call SetUnitMoveSpeed(udg_Unit_IntroCItizenHideoutArr[udg_Int_IntroCitizenIndex], 50.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroCItizenHideoutArr[udg_Int_IntroCitizenIndex], UNIT_RF_ANIMATION_WALK_SPEED, 50.00)
    call SetUnitTimeScalePercent(udg_Unit_IntroCItizenHideoutArr[udg_Int_IntroCitizenIndex], 50.00)
    call IssuePointOrderLocBJ(udg_Unit_IntroCItizenHideoutArr[udg_Int_IntroCitizenIndex], "move", GetRectCenter(gg_rct_IntroHideout))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    set udg_Int_IntroCitizenIndex=( udg_Int_IntroCitizenIndex + 1 )
