function InitTrig_P10DetectSeaLoading takes nothing returns nothing
    set gg_trg_P10DetectSeaLoading=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_P10DetectSeaLoading, "udg_CargoEvent", EQUAL, 1.00)
    call TriggerAddCondition(gg_trg_P10DetectSeaLoading, Condition(function Trig_P10DetectSeaLoading_Conditions))
    call TriggerAddAction(gg_trg_P10DetectSeaLoading, function Trig_P10DetectSeaLoading_Actions)
endfunction

