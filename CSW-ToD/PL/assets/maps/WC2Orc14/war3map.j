//===========================================================================
// Trigger: WhirlwindChannelInterrupted
//
// Cases:
// + Caster Dies
// + Caster Stunned
// + Caster Silenced
// + Caster Polymorphed
// Caster Replaced
// Caster Removed
// + Caster Executes the order
//===========================================================================
function Trig_WhirlwindChannelInterrupted_Func011C takes nothing returns boolean
    if ( ( GetIssuedOrderIdBJ() == String2OrderIdBJ("stop") ) ) then
        return true
    endif
    if ( ( GetIssuedOrderIdBJ() == String2OrderIdBJ("move") ) ) then
        return true
    endif
    if ( ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
        return true
    endif
    if ( ( GetIssuedOrderIdBJ() == String2OrderIdBJ("attack") ) ) then
        return true
    endif
    if ( ( GetIssuedOrderIdBJ() == String2OrderIdBJ("holdposition") ) ) then
        return true
    endif
    return false
endfunction

function Trig_WhirlwindChannelInterrupted_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetOrderedUnit()) == 'u000' ) ) then
        return false
    endif
    if ( not Trig_WhirlwindChannelInterrupted_Func011C() ) then
        return false
    endif
    return true
endfunction

function Trig_WhirlwindChannelInterrupted_Actions takes nothing returns nothing
    local unit dk
    local unit w
    set dk=GetOrderedUnit()
    set w=LoadUnitHandle(udg_Hashtable_WhirlwindSpell, GetHandleId(dk), 0)
    if w != null then
    call KillUnit(w)
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, GetHandleId(w))
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, GetHandleId(dk))
    endif
endfunction

//===========================================================================
function InitTrig_WhirlwindChannelInterrupted takes nothing returns nothing
    set gg_trg_WhirlwindChannelInterrupted=CreateTrigger()
    call DisableTrigger(gg_trg_WhirlwindChannelInterrupted)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_WhirlwindChannelInterrupted, EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_WhirlwindChannelInterrupted, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_WhirlwindChannelInterrupted, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddCondition(gg_trg_WhirlwindChannelInterrupted, Condition(function Trig_WhirlwindChannelInterrupted_Conditions))
    call TriggerAddAction(gg_trg_WhirlwindChannelInterrupted, function Trig_WhirlwindChannelInterrupted_Actions)
endfunction

//===========================================================================
// Trigger: WhirlwindUnitPerishes
//===========================================================================
function Trig_WhirlwindUnitPerishes_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'nXD0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_WhirlwindUnitPerishes_Actions takes nothing returns nothing
    local unit w
    local unit dk
    local integer i
    // //
    set w=GetDyingUnit()
    // //
    set i=0
    loop
    exitwhen i >= 8192 // arbitrary search limit, safe for normal games
    set dk=LoadUnitHandle(udg_Hashtable_WhirlwindSpell, i, 0)
    if dk != null and dk == w then
    // // Found DK → Issue stop order to break channel
    set dk=LoadUnitHandle(udg_Hashtable_WhirlwindSpell, i, 1)
    if dk != null then
    call IssueImmediateOrder(dk, "stop")
    endif
    // // Clean both ways
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, i)
    call FlushChildHashtable(udg_Hashtable_WhirlwindSpell, GetHandleId(w))
    exitwhen true
    endif
    set i=i + 1
    endloop
endfunction

//===========================================================================
function InitTrig_WhirlwindUnitPerishes takes nothing returns nothing
    set gg_trg_WhirlwindUnitPerishes=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_WhirlwindUnitPerishes, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_WhirlwindUnitPerishes, Condition(function Trig_WhirlwindUnitPerishes_Conditions))
    call TriggerAddAction(gg_trg_WhirlwindUnitPerishes, function Trig_WhirlwindUnitPerishes_Actions)
endfunction

