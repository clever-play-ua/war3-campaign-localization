    call BlzSetUnitRealFieldBJ(gg_unit_h002_0926, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call IssuePointOrderLocBJ(gg_unit_h002_0926, "patrol", GetRectCenter(gg_rct_PaladinPatrol01))
    // ///
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_h002_0927)
    call SetUnitMoveSpeed(gg_unit_h002_0927, 100.00)
    call BlzSetUnitRealFieldBJ(gg_unit_h002_0927, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call IssuePointOrderLocBJ(gg_unit_h002_0927, "patrol", GetRectCenter(gg_rct_PaladinPatrol02))
    // ///
    call SetUnitAnimation(gg_unit_n01O_0492, "cinematic stand alternate listening one")
    call SetUnitFlyHeightBJ(gg_unit_n01O_0492, 40.00, 0.00)
    // ///
    // Retera Secret
    // ///
    call BlzSetUnitName(gg_unit_nshe_1135, BlzGetItemExtendedTooltip(gg_item_IQL0_0013))
    call SetUnitLifeBJ(gg_unit_nshe_1135, 500.00)
    // ///
    // Load Cross Island Troops
    // ///
    call TriggerSleepAction(1.00)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_DisableSupplyUsage), function Trig_InitUnits_Func096002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_CIPlayerStartLocation), function Trig_InitUnits_Func098002)
    // //
    call ForGroupBJ(udg_Group_Player_CrossIslandGround, function Trig_InitUnits_Func100002)
    call ForGroupBJ(udg_Group_Player_CrossIslandNaval, function Trig_InitUnits_Func101002)
    // //
    call IssueTargetOrderBJ(gg_unit_o60P_1303, "board", gg_unit_o60Q_0699)
    call IssueTargetOrderBJ(gg_unit_o60P_1302, "board", gg_unit_o60Q_0699)
