function Trig_AI_P15_Attacker_Index_Func004C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'h9ZZ' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'h9Zz' ) ) then
        return true
    endif
    return false
endfunction

function Trig_AI_P15_Attacker_Index_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_LordaeronNaval ) ) then
        return false
    endif
    if ( not Trig_AI_P15_Attacker_Index_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Attacker_Index_Func001C takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[udg_UDex] == 'h9ZZ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Attacker_Index_Func002C takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[udg_UDex] == 'h9Zz' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Attacker_Index_Actions takes nothing returns nothing
    if ( Trig_AI_P15_Attacker_Index_Func001C() ) then
        call GroupAddUnitSimple(udg_UDexUnits[udg_UDex], udg_G_P15_AttackerFrigate)
    else
    endif
    if ( Trig_AI_P15_Attacker_Index_Func002C() ) then
        call GroupAddUnitSimple(udg_UDexUnits[udg_UDex], udg_G_P15_AttackerBattleship)
    else
    endif
endfunction

