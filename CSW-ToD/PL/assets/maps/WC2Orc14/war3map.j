function Trig_VictoryTowerFalls_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call EnumDestructablesInRectAll(gg_rct_FinalCinDestruction05, function Trig_VictoryTowerFalls_Func008002)
    call SetDestructableInvulnerableBJ(gg_dest_B005_3578, false)
    call KillDestructable(gg_dest_B005_3578)
    call PlaySoundBJ(gg_snd_CS_orc2_outro_stomp)
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_FinalCinDestruction05), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 15.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call EnumDestructablesInRectAll(gg_rct_FinalCinDestruction04, function Trig_VictoryTowerFalls_Func020002)
    call PlaySoundBJ(gg_snd_BridgeDeath)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_FinalCinDestruction04), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 15.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call EnumDestructablesInRectAll(gg_rct_FinalCinDestruction01, function Trig_VictoryTowerFalls_Func029002)
    call PlaySoundBJ(gg_snd_CS_orc2_outro_rockfalls)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_FinalCinDestruction01), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 15.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call EnumDestructablesInRectAll(gg_rct_FinalCinDestruction03, function Trig_VictoryTowerFalls_Func038002)
    call PlaySoundBJ(gg_snd_CS_orc2_outro_stomp)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_FinalCinDestruction03), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 15.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call EnumDestructablesInRectAll(gg_rct_FinalCinDestruction02, function Trig_VictoryTowerFalls_Func047002)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_FinalCinDestruction02), "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    call BlzSetSpecialEffectZ(GetLastCreatedEffectBJ(), 15.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundBJ(gg_snd_BridgeDeath)
    // //
endfunction

