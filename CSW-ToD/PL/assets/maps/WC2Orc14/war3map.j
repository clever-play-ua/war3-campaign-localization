function Trig_AI_P15_Defeat_Condition_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_AIP15DefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_LordaeronNaval, Condition(function Trig_AI_P15_Defeat_Condition_Func008001002)), function Trig_AI_P15_Defeat_Condition_Func008A)
    // //
    if ( Trig_AI_P15_Defeat_Condition_Func010C() ) then
        // //
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_AI_P15_Gold)
        call DisableTrigger(gg_trg_AI_P15_Lumber)
        call DisableTrigger(gg_trg_AI_P15_Oil)
        // //
        call ConditionalTriggerExecute(gg_trg_AI_P15_Command_Stop_Attack_User)
        call ConditionalTriggerExecute(gg_trg_AI_P15_Command_Defeat)
        // //
    else
    endif
    // //
    call GroupClear(udg_Group_AIP15DefeatCondition)
    // //
endfunction

