    return ( udg_Bool_CinCrossIslandOUTSkipped == true )
endfunction

function Trig_CrossIslandOutroQ_Func034001 takes nothing returns boolean
    return ( udg_Bool_CinCrossIslandOUTSkipped == true )
endfunction

function Trig_CrossIslandOutroQ_Func043001 takes nothing returns boolean
    return ( udg_Bool_CinCrossIslandOUTSkipped == true )
endfunction

function Trig_CrossIslandOutroQ_Func047001 takes nothing returns boolean
    return ( udg_Bool_CinCrossIslandOUTSkipped == true )
endfunction

function Trig_CrossIslandOutroQ_Func056001 takes nothing returns boolean
    return ( udg_Bool_CinCrossIslandOUTSkipped == true )
endfunction

function Trig_CrossIslandOutroQ_Func067001 takes nothing returns boolean
    return ( udg_Bool_CinCrossIslandOUTSkipped == true )
endfunction

function Trig_CrossIslandOutroQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Generic Cinematic Setup is not used in order to not interfiere with saved data in lordaeron area (camera and selection)
    // //
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    // //
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_CrossIslandOutroSetup)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_CrossIslandOutroCin01, udg_Player_Actual, 0)
    call TriggerSleepAction(1.00)
    call CameraSetupApplyForPlayer(true, gg_cam_CrossIslandOutroCin02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc14Utok5) + 2.00 ))
    // //
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    set udg_Bool_CinCrossIslandOUTOn=true
    call PlaySoundBJ(gg_snd_DarkAgents)
    // ////
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc14Utok5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCrossIslandOUTSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // ////
    call CameraSetupApplyForPlayer(true, gg_cam_CrossIslandOutroCin03, udg_Player_Actual, 0)
    call SetUnitLookAt(udg_FakeMaim, "bone_head", udg_FakeGorefiend, 0, 0, 90)
    // ////
    call SetUnitAnimation(udg_FakeGorefiend, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_TeronGorefiend, 0, gg_snd_WC2Orc14Gorefiend2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCrossIslandOUTSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGorefiend, "cinematic listening one")
    // ////
    call ResetUnitLookAt(udg_FakeMaim)
    call CameraSetupApplyForPlayer(true, gg_cam_CrossIslandOutroCin01, udg_Player_Actual, 0)
    // ////
    call SetUnitAnimation(udg_FakeUtok, "cinematic salute one")
    call PlaySoundOnUnitBJ(gg_snd_CS_H01b_Orc_gesture_v2, 80.00, udg_FakeUtok)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinCrossIslandOUTSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call ConditionalTriggerExecute(gg_trg_CrossIslandOurtoFakeArmyMarch)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinCrossIslandOUTSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_CIOutroCinUtok02))
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_CIOutroCinMaim02))
    call IssuePointOrderLocBJ(udg_FakeRend, "move", GetRectCenter(gg_rct_CIOutroCinRend02))
    call IssuePointOrderLocBJ(udg_FakeZuluhed, "move", GetRectCenter(gg_rct_CIOutroCinZuluhed02))
    call IssuePointOrderLocBJ(udg_FakeGorefiend, "move", GetRectCenter(gg_rct_CIOutroCinGorefiend02))
    // ////
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinCrossIslandOUTSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // ////
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call CameraSetupApplyForPlayer(true, gg_cam_WayToDalaran, udg_Player_Actual, 0)
    call CameraSetFocalDistance(300.00)
    call CameraSetDepthOfFieldScale(150.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    // ////
    call TriggerSleepAction(10.00)
    if ( (udg_Bool_CinCrossIslandOUTSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_CrossIslandOutroCleanUp)
endfunction

//===========================================================================
function InitTrig_CrossIslandOutroQ takes nothing returns nothing
    set gg_trg_CrossIslandOutroQ=CreateTrigger()
    call TriggerAddAction(gg_trg_CrossIslandOutroQ, function Trig_CrossIslandOutroQ_Actions)
endfunction

//===========================================================================
// Trigger: CrossIslandOutroSetup
//===========================================================================
function Trig_CrossIslandOutroSetup_Func016002002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_CrossIslandOutroSetup_Func016002002002001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_CrossIslandOutroSetup_Func016002002002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o60Q' )
endfunction

function Trig_CrossIslandOutroSetup_Func016002002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetUnitTypeId(GetFilterUnit()) == 'o60Q')) // INLINED!!
endfunction

function Trig_CrossIslandOutroSetup_Func016002002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (GetUnitTypeId(GetFilterUnit()) == 'o60Q')))) // INLINED!!
endfunction

function Trig_CrossIslandOutroSetup_Func017Func001C takes nothing returns boolean
    if ( not ( GetEnumUnit() == udg_U_UtokShip ) ) then
        return false
    endif
    return true
endfunction

function Trig_CrossIslandOutroSetup_Func017A takes nothing returns nothing
    if ( Trig_CrossIslandOutroSetup_Func017Func001C() ) then
        call SetUnitPositionLoc(GetEnumUnit(), udg_TempPoint)
        call KillUnit(GetEnumUnit())
    else
        call RemoveUnit(GetEnumUnit())
    endif
endfunction

function Trig_CrossIslandOutroSetup_Func020Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'o605' ) ) then
        return false
    endif
    return true
endfunction

function Trig_CrossIslandOutroSetup_Func020A takes nothing returns nothing
    if ( Trig_CrossIslandOutroSetup_Func020Func001C() ) then
        call RemoveUnit(GetEnumUnit())
    else
        call SetUnitPositionLoc(GetEnumUnit(), udg_TempPoint)
    endif
endfunction

function Trig_CrossIslandOutroSetup_Func023A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_CrossIslandOutroSetup_Func025A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_CrossIslandOutroSetup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // ////
    // Environment
    // ////
    call SetSkyModel("Environment\\Sky\\DalaranSky\\DalaranSky.mdl")
    call SetTerrainFogExBJ(0, 1500.00, 8500.00, 0.50, 90.10, 36.86, 21.56)
    // ////
    // Units
    // ////
    call RemoveUnit(udg_Hero_Rend)
    call RemoveUnit(udg_Hero_Maim)
    call RemoveUnit(udg_Hero_Zuluhed)
    call RemoveUnit(udg_Hero_TeronGorefiend)
    set udg_TempPoint=GetRectCenter(gg_rct_CIDoneSafety)
    set udg_TempGroup=GetUnitsInRectMatching(gg_rct_CameraBounds03, Condition(function Trig_CrossIslandOutroSetup_Func016002002))
    call ForGroupBJ(udg_TempGroup, function Trig_CrossIslandOutroSetup_Func017A)
    call DestroyGroup(udg_TempGroup)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CameraBounds03_Copy, udg_Player_Actual), function Trig_CrossIslandOutroSetup_Func020A)
    call RemoveLocation(udg_TempPoint)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CameraBounds03, udg_Player_DeathKnights), function Trig_CrossIslandOutroSetup_Func023A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CameraBounds03, udg_Player_KirinTor), function Trig_CrossIslandOutroSetup_Func025A)
    // ////
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // ////
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_CIOutroCinUtok01), bj_UNIT_FACING)
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // ////
    call SetUnitPositionLocFacingBJ(udg_FakeRend, GetRectCenter(gg_rct_CIOutroCinRend01), 100.00)
    // ChangeSkinToMounted?
    call SetUnitTurnSpeedBJ(udg_FakeRend, 0.25)
    call SetUnitAnimation(udg_FakeRend, "cinematic listening one")
    // ////
    call SetUnitPositionLocFacingBJ(udg_FakeMaim, GetRectCenter(gg_rct_CIOutroCinMaim01), 85.00)
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // ////
    call SetUnitPositionLocFacingBJ(udg_FakeZuluhed, GetRectCenter(gg_rct_CIOutroCinZuluhed01), 190.00)
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // ////
    call SetUnitPositionLocFacingBJ(udg_FakeGorefiend, GetRectCenter(gg_rct_CIOutroCinGorefiend01), 0.00)
    call SetUnitAnimation(udg_FakeGorefiend, "cinematic listening one")
    // ////
endfunction

//===========================================================================
function InitTrig_CrossIslandOutroSetup takes nothing returns nothing
    set gg_trg_CrossIslandOutroSetup=CreateTrigger()
    call TriggerAddAction(gg_trg_CrossIslandOutroSetup, function Trig_CrossIslandOutroSetup_Actions)
endfunction

//===========================================================================
// Trigger: CrossIslandOutroCleanUp
//===========================================================================
function Trig_CrossIslandOutroCleanUp_Func013002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_CrossIslandOutroCleanUp_Func020Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'o605' ) ) then
        return false
    endif
    return true
endfunction

function Trig_CrossIslandOutroCleanUp_Func020A takes nothing returns nothing
    if ( Trig_CrossIslandOutroCleanUp_Func020Func001C() ) then
        call RemoveUnit(GetEnumUnit())
    else
    endif
endfunction

function Trig_CrossIslandOutroCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    // //
    call ResetUnitLookAt(udg_FakeMaim)
    call QueuedTriggerRemoveBJ(gg_trg_CrossIslandOutroQ)
    // //
    set udg_Bool_CinCrossIslandOUTOn=false
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call StopSoundBJ(gg_snd_OrcArmyMarchLoop, false)
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call ForGroupBJ(udg_Group_CIOutroCInArmy, function Trig_CrossIslandOutroCleanUp_Func013002)
    // TurnOffCrossIslandGameplayTriggers
    call DisableTrigger(gg_trg_SkeletonGroupCheckAttackState)
    // TurnOffCrossIslandGameplayTriggers
    call TriggerSleepAction(2.00)
    call ConditionalTriggerExecute(gg_trg_MidgameContinueLordaeronQ)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CameraBounds03_Copy, udg_Player_Actual), function Trig_CrossIslandOutroCleanUp_Func020A)
    call TriggerSleepAction(2.00)
endfunction

//===========================================================================
function InitTrig_CrossIslandOutroCleanUp takes nothing returns nothing
    set gg_trg_CrossIslandOutroCleanUp=CreateTrigger()
    call TriggerAddAction(gg_trg_CrossIslandOutroCleanUp, function Trig_CrossIslandOutroCleanUp_Actions)
endfunction

