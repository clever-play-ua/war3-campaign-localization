//library idxcargosize:
  function IndexedCargoSize takes integer uty returns integer
    if uty == 'e000' or uty == 'hBAM' or uty == 'hBaM' or uty == 'n60B' or uty == 'h60L' or uty == 'hKAM' or uty == 'hKsM' or uty == 'h002' or uty == 'hPaM' or uty == 'o60P' or uty == 'oCaM' or uty == 'n001' or uty == 'n002' or uty == 'n000' or uty == 'oOMa' or uty == 'oOmM' or uty == 'h9ZW' then
      return 2
    else
      return 1
    endif
  endfunction

