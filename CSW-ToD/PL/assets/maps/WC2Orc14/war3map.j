//===========================================================================
// Trigger: SpawnRetera
//===========================================================================
function Trig_SpawnRetera_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_ReteraSpawnPoint), 1.00)
    call TriggerSleepAction(1.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_ReteraSpawnPoint), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphTarget.mdl")
    set udg_SE_ReteraMorph=GetLastCreatedEffectBJ()
    call CreateNUnitsAtLoc(1, 'H00B', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_ReteraSpawnPoint), 45.00)
    set udg_Hero_Retera=GetLastCreatedUnit()
    call SetUnitInvulnerable(udg_Hero_Retera, true)
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Retera, 'H00B', gg_snd_WC2Orc14Retera1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Retera, 'H00B', gg_snd_WC2Orc14Retera2, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call DestroyEffectBJ(udg_SE_ReteraMorph)
    call TriggerSleepAction(1.00)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_ReteraSpawnPoint), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphTarget.mdl")
    set udg_SE_ReteraMorph=GetLastCreatedEffectBJ()
    call RemoveUnit(udg_Hero_Retera)
    call CreateNUnitsAtLoc(1, 'nshf', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_ReteraSpawnPoint), 45.00)
    set udg_Unit_FlyingSheep=GetLastCreatedUnit()
    call SetUnitInvulnerable(udg_Unit_FlyingSheep, true)
    call UnitShareVisionBJ(true, udg_Unit_FlyingSheep, Player(0))
    call IssuePointOrderLocBJ(udg_Unit_FlyingSheep, "move", GetRectCenter(gg_rct_ReteraFleePoint))
    // drop item
    call CreateItemLoc('IRWC', GetRectCenter(gg_rct_ReteraSpawnPoint))
    call TriggerSleepAction(0.50)
    call SetDestructableInvulnerableBJ(gg_dest_XTmp_10832, false)
    call KillDestructable(gg_dest_XTmp_10832)
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Rend, 'O617', gg_snd_WC2Orc14Rend5, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Zuluhed, 'O61F', gg_snd_WC2Orc14Zuluhed8, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call DestroyEffectBJ(udg_SE_ReteraMorph)
    // //////
    // //////
endfunction

//===========================================================================
function InitTrig_SpawnRetera takes nothing returns nothing
    set gg_trg_SpawnRetera=CreateTrigger()
    call TriggerRegisterUnitEvent(gg_trg_SpawnRetera, gg_unit_nshe_1135, EVENT_UNIT_DEATH)
    call TriggerAddAction(gg_trg_SpawnRetera, function Trig_SpawnRetera_Actions)
endfunction

//===========================================================================
// Trigger: RemoveRetera
//===========================================================================
function Trig_RemoveRetera_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Unit_FlyingSheep ) ) then
        return false
    endif
    return true
endfunction

function Trig_RemoveRetera_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call RemoveUnit(udg_Unit_FlyingSheep)
endfunction

//===========================================================================
function InitTrig_RemoveRetera takes nothing returns nothing
    set gg_trg_RemoveRetera=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_RemoveRetera, gg_rct_ReteraFleePoint)
    call TriggerAddCondition(gg_trg_RemoveRetera, Condition(function Trig_RemoveRetera_Conditions))
    call TriggerAddAction(gg_trg_RemoveRetera, function Trig_RemoveRetera_Actions)
endfunction

//===========================================================================
// Trigger: ReteraFadeAway
//===========================================================================
function Trig_ReteraFadeAway_Conditions takes nothing returns boolean
    if ( not ( GetEnteringUnit() == udg_Unit_FlyingSheep ) ) then
        return false
    endif
    return true
endfunction

function Trig_ReteraFadeAway_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 10.00)
    call TriggerSleepAction(0.25)
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 20.00)
    call TriggerSleepAction(0.25)
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 30.00)
    call TriggerSleepAction(0.25)
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 40.00)
    call TriggerSleepAction(0.25)
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 50.00)
    call TriggerSleepAction(0.25)
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 60.00)
    call TriggerSleepAction(0.25)
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 70.00)
    call TriggerSleepAction(0.25)
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 80.00)
    call TriggerSleepAction(0.25)
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 90.00)
    call TriggerSleepAction(0.25)
    call SetUnitVertexColorBJ(udg_Unit_FlyingSheep, 100, 100, 100, 100.00)
endfunction

//===========================================================================
function InitTrig_ReteraFadeAway takes nothing returns nothing
    set gg_trg_ReteraFadeAway=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_ReteraFadeAway, gg_rct_ReteraDissolvePoint)
    call TriggerAddCondition(gg_trg_ReteraFadeAway, Condition(function Trig_ReteraFadeAway_Conditions))
    call TriggerAddAction(gg_trg_ReteraFadeAway, function Trig_ReteraFadeAway_Actions)
endfunction

//===========================================================================
// Trigger: ResetFootmanAnim
//===========================================================================
function Trig_ResetFootmanAnim_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ResetFootmanAnim_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Footman
    call SetUnitMoveSpeed(gg_unit_hfSw_0090, GetUnitDefaultMoveSpeed(gg_unit_hfSw_0090))
    call BlzSetUnitRealFieldBJ(gg_unit_hfSw_0090, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_hfSw_0090)
endfunction

//===========================================================================
function InitTrig_ResetFootmanAnim takes nothing returns nothing
    set gg_trg_ResetFootmanAnim=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_ResetFootmanAnim, gg_rct_FootmanAnimationResetRange)
    call TriggerAddCondition(gg_trg_ResetFootmanAnim, Condition(function Trig_ResetFootmanAnim_Conditions))
    call TriggerAddAction(gg_trg_ResetFootmanAnim, function Trig_ResetFootmanAnim_Actions)
endfunction

