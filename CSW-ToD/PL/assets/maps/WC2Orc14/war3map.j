//===========================================================================
// Trigger: InitEnvironment
//===========================================================================
function Trig_InitEnvironment_Func048A takes nothing returns nothing
    call ShowDestructableBJ(false, GetEnumDestructable())
endfunction

function Trig_InitEnvironment_Func052A takes nothing returns nothing
    call ShowDestructableBJ(false, GetEnumDestructable())
endfunction

function Trig_InitEnvironment_Actions takes nothing returns nothing
    // Initial Time Of Day
    call SetTimeOfDay(12.00)
    // //
    // Fog
    // //
    set udg_Real_FogMin=3000.00
    set udg_Real_FogMax=12500.00
    set udg_Real_FogColorR=50.00
    set udg_Real_FogColorG=50.00
    set udg_Real_FogColorB=68.00
    // //
    // Bridges, Gates, etc.
    // //
    call SetDoodadAnimationRectBJ("death alternate", 'D00D', gg_rct_MagicalBridge)
    call SetDestructableInvulnerableBJ(gg_dest_XTmp_10832, true)
    call SetDoodadAnimationRectBJ("death", 'D008', gg_rct_GuldansHead)
    call SetDestructableAnimationBJ(gg_dest_B00C_0077, "stand alternate")
    call SetDestructableAnimationBJ(gg_dest_B00C_1843, "stand alternate")
    call SetDestructableInvulnerableBJ(gg_dest_B005_3578, true)
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_FinalCinWallpaperLake)
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_Wallpaper)
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_WallpaperDoodadLake)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_CinematicFire01)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_CinematicFire01)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_CinematicFire02)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_CinematicFire02)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_CinematicFire03)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_CinematicFire03)
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_CinematicFire04)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_CinematicFire04)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_Treasury01)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_Treasury02)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_Treasury03)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_Treasury04)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_Treasury05)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_Treasury06)
    // //
    // Cross Island Locked Destructables
    // //
    call SetDestructableInvulnerableBJ(gg_dest_Dofw_10848, true)
    call SetDestructableInvulnerableBJ(gg_dest_Dofw_10849, true)
    // //
    call SetItemVisibleBJ(false, gg_item_IQL0_0013)
    // //
    // Hide Ship
    // //
    call ShowUnitHide(gg_unit_o001_0790)
    call EnumDestructablesInRectAll(gg_rct_CIIntroShipScene, function Trig_InitEnvironment_Func048A)
    // //
    // Hide Final Cin Ship
    // //
    call EnumDestructablesInRectAll(gg_rct_FinalCinDoodadsShip, function Trig_InitEnvironment_Func052A)
    // //
    // Cinematic Lights
    // //
    call SetDoodadAnimationRectBJ("death", 'DLow', gg_rct_ArrivalCinLightControl)
    // //
    // //
endfunction

//===========================================================================
function InitTrig_InitEnvironment takes nothing returns nothing
    set gg_trg_InitEnvironment=CreateTrigger()
    call TriggerAddAction(gg_trg_InitEnvironment, function Trig_InitEnvironment_Actions)
endfunction

//===========================================================================
// Trigger: InitAudio
//===========================================================================
function Trig_InitAudio_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set udg_Music_DefaultNames[0]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    set udg_Music_DefaultNames[1]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[2]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3"
    set udg_Music_DefaultNames[3]="Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3"
    set udg_Music_DefaultNames[4]="Warcraft2\\Music\\OrcTheme5.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme4.mp3"
    set udg_Music_DefaultNames[5]="Warcraft2\\Music\\OrcTheme2.mp3;Warcraft2\\Music\\OrcTheme3.mp3;Warcraft2\\Music\\OrcTheme4.mp3;Warcraft2\\Music\\OrcTheme1.mp3;Warcraft2\\Music\\OrcTheme5.mp3"
    // //
    set udg_Music_DefaultNamesCount=6
    // //
    // SetMusicList with Randomizer
    set udg_Music_CurrentName=udg_Music_DefaultNames[GetRandomInt(0, 5)]
    set udg_Music_CurrentVolume=0.00
    // //
    call ClearMapMusicBJ()
endfunction

//===========================================================================
function InitTrig_InitAudio takes nothing returns nothing
    set gg_trg_InitAudio=CreateTrigger()
    call TriggerAddAction(gg_trg_InitAudio, function Trig_InitAudio_Actions)
endfunction

//===========================================================================
// Trigger: InitQuests
//===========================================================================
function Trig_InitQuests_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Fenris Island
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_2839", "TRIGSTR_2840", "ReplaceableTextures\\CommandButtons\\BTNKeep.blp")
    set udg_QMFenrisIsland=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_QMFenrisIsland, "TRIGSTR_2843")
    set udg_QMFIRequrement[1]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMFenrisIsland, "TRIGSTR_3202")
    set udg_QMFIRequrement[2]=GetLastCreatedQuestItemBJ()
    // Harbour
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_2844", "TRIGSTR_2845", "ReplaceableTextures\\CommandButtons\\BTNHumanShipyard.blp")
    set udg_QMLordaeronHarbour=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_QMLordaeronHarbour, "TRIGSTR_2846")
    set udg_QMLHRequrement[1]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMLordaeronHarbour, "TRIGSTR_2955")
    set udg_QMLHRequrement[2]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMLordaeronHarbour, "TRIGSTR_2954")
    set udg_QMLHRequrement[3]=GetLastCreatedQuestItemBJ()
    // Sack the Capital
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_2847", "TRIGSTR_2848", "ReplaceableTextures\\CommandButtons\\BTNCastle.blp")
    set udg_QMSackTheCity=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_QMSackTheCity, "TRIGSTR_2849")
    set udg_QMSCRequrement[1]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMSackTheCity, "TRIGSTR_2850")
    set udg_QMSCRequrement[2]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMSackTheCity, "TRIGSTR_2851")
    set udg_QMSCRequrement[3]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMSackTheCity, "TRIGSTR_2852")
    set udg_QMSCRequrement[4]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMSackTheCity, "TRIGSTR_2853")
    set udg_QMSCRequrement[5]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMSackTheCity, "TRIGSTR_2854")
    set udg_QMSCRequrement[6]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMSackTheCity, "TRIGSTR_2855")
    set udg_QMSCRequrement[7]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMSackTheCity, "TRIGSTR_3753")
    set udg_QMSCRequrement[8]=GetLastCreatedQuestItemBJ()
    // Tons Of Gold
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_2858", "TRIGSTR_2859", "ReplaceableTextures\\CommandButtons\\BTNChestOfGold.blp")
    set udg_QOTonsOfGold=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_QOTonsOfGold, "TRIGSTR_2860")
    set udg_QOTGRequrement=GetLastCreatedQuestItemBJ()
    // ***
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2856")
    // ***
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_FenrisIsleQuestMarker), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMFIPingIcon=GetLastCreatedMinimapIcon()
endfunction

//===========================================================================
function InitTrig_InitQuests takes nothing returns nothing
    set gg_trg_InitQuests=CreateTrigger()
    call TriggerAddAction(gg_trg_InitQuests, function Trig_InitQuests_Actions)
endfunction

//===========================================================================
// Trigger: InitReload
//===========================================================================
function Trig_InitReload_Actions takes nothing returns nothing
    call SetMapFacialAnimations()
    // Clear any pending music list
    call ClearMapMusicBJ()
    // Play music
    call PolledWait(0.10)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

//===========================================================================
function InitTrig_InitReload takes nothing returns nothing
    set gg_trg_InitReload=CreateTrigger()
    call TriggerRegisterGameLoadedEventBJ(gg_trg_InitReload)
    call TriggerAddAction(gg_trg_InitReload, function Trig_InitReload_Actions)
endfunction

//===========================================================================
// Trigger: LaunchInGameMusic
//===========================================================================
function Trig_LaunchInGameMusic_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Music_CurrentVolume < 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LaunchInGameMusic_Actions takes nothing returns nothing
    call PlayMusicBJ(udg_Music_CurrentName)
    set udg_Int_C=1
    loop
        exitwhen udg_Int_C > 100
        if ( Trig_LaunchInGameMusic_Func002Func001C() ) then
            set udg_Music_CurrentVolume=( udg_Music_CurrentVolume + 1 )
            call SetMusicVolumeBJ(udg_Music_CurrentVolume)
            call TriggerSleepAction(0.02)
        else
        endif
        set udg_Int_C=udg_Int_C + 1
    endloop
endfunction

//===========================================================================
function InitTrig_LaunchInGameMusic takes nothing returns nothing
    set gg_trg_LaunchInGameMusic=CreateTrigger()
    call TriggerAddAction(gg_trg_LaunchInGameMusic, function Trig_LaunchInGameMusic_Actions)
endfunction

//===========================================================================
// Trigger: Easy
//===========================================================================
function Trig_Easy_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Easy_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Upgrades
    // Nation Of Lordaeron
    // Nation Of Azeroth
    call SetPlayerTechResearchedSwap('R013', 1, udg_Player_Azerothiens)
    call SetPlayerTechResearchedSwap('R014', 1, udg_Player_Azerothiens)
    call SetPlayerTechResearchedSwap('R01A', 1, udg_Player_Azerothiens)
    // Ironforge Embassy
    call SetPlayerTechResearchedSwap('RUMI', 1, udg_Player_Ironforge)
    call SetPlayerTechResearchedSwap('RArI', 1, udg_Player_Ironforge)
    // Kirin Tor
    call SetPlayerTechResearchedSwap('R013', 1, udg_Player_KirinTor)
    call SetPlayerTechResearchedSwap('R014', 1, udg_Player_KirinTor)
    call SetPlayerTechResearchedSwap('R00A', 1, udg_Player_KirinTor)
    call SetPlayerTechResearchedSwap('R00H', 1, udg_Player_KirinTor)
    call SetPlayerTechResearchedSwap('R00J', 1, udg_Player_KirinTor)
    call SetPlayerTechResearchedSwap('R007', 1, udg_Player_KirinTor)
    call SetPlayerTechResearchedSwap('R600', 1, udg_Player_KirinTor)
    call SetPlayerTechResearchedSwap('RESU', 1, udg_Player_KirinTor)
    call SetPlayerTechResearchedSwap('REAU', 1, udg_Player_KirinTor)
    // //
    call RemoveUnit(gg_unit_hPSW_0500)
    call RemoveUnit(gg_unit_hPSW_0563)
endfunction

