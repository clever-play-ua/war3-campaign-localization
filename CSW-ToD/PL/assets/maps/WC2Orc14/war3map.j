    call CameraSetupApplyForPlayer(true, gg_cam_CrossIslandIntro02, udg_Player_Actual, 10.00)
    call TriggerSleepAction(10.00)
    if ( (udg_Bool_CinCrossIslandInSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
