    call SetUnitInvulnerable(gg_unit_haro_0517, true)
    // ////
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CISouthernEntrance, udg_Player_KirinTor), function Trig_CrossIslandIntroSetup_Func118A)
    call GroupAddUnitSimple(gg_unit_ndgt_0571, udg_Group_CISouthernGuardGroup)
