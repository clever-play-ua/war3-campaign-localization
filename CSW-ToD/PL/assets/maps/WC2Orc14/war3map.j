//===========================================================================
// Trigger: AI P15 Start
//===========================================================================
function Trig_AI_P15_Start_Func008Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Start_Func008C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call AdjustPlayerStateBJ(20000, udg_Player_LordaeronNaval, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(20000, udg_Player_LordaeronNaval, PLAYER_STATE_RESOURCE_LUMBER)
    call SetPlayerStateBJ(udg_Player_LordaeronNaval, PLAYER_STATE_FOOD_CAP_CEILING, 150)
    call SetPlayerStateBJ(udg_Player_LordaeronNaval, PLAYER_STATE_RESOURCE_FOOD_CAP, 150)
    // //
    if ( Trig_AI_P15_Start_Func008C() ) then
        call playerAddOil(Player(14) , 200000)
    else
        if ( Trig_AI_P15_Start_Func008Func003C() ) then
            call playerAddOil(Player(14) , 180000)
        else
            call playerAddOil(Player(14) , 160000)
        endif
    endif
    // //
    call EnableTrigger(gg_trg_AI_P15_Gold)
    call EnableTrigger(gg_trg_AI_P15_Lumber)
    call EnableTrigger(gg_trg_AI_P15_Oil)
    // //
    call ShowUnitHide(gg_unit_h61A_0026)
    // //
    call StartCampaignAI(udg_Player_LordaeronNaval, "CSW\\Scripts\\ToDScripts\\WC2Orc14\\WC2Orc14P15LordaeronNavalAI.ai")
    // //
    call IssueTargetOrderBJ(gg_unit_h600_0329, "smart", gg_unit_u600_0124)
    call IssueTargetOrderBJ(gg_unit_h600_0330, "smart", gg_unit_u600_0124)
    // //
    call StartTimerBJ(udg_Timer_P15Oil, true, 1.00)
endfunction

//===========================================================================
function InitTrig_AI_P15_Start takes nothing returns nothing
    set gg_trg_AI_P15_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_P15_Start, function Trig_AI_P15_Start_Actions)
endfunction

