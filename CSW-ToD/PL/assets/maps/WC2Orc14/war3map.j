function ConstructEvent___OnIndex takes nothing returns nothing
    local unit u= udg_UDexUnits[udg_UDex]
    local integer id= GetUnitTypeId(u)
    local integer iter= s__IntegerList_first[ConstructEvent___ongoing]
    local integer obj
