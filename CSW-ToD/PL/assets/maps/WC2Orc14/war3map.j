function InitTrig_MidgameContinueLordaeronQ takes nothing returns nothing
    set gg_trg_MidgameContinueLordaeronQ=CreateTrigger()
    call TriggerAddAction(gg_trg_MidgameContinueLordaeronQ, function Trig_MidgameContinueLordaeronQ_Actions)
endfunction

