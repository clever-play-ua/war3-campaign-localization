    call TriggerAddCondition(gg_trg_QMSCDiscoveredQ, Condition(function Trig_QMSCDiscoveredQ_Conditions))
    call TriggerAddAction(gg_trg_QMSCDiscoveredQ, function Trig_QMSCDiscoveredQ_Actions)
