function InitTrig_CrossIslandIntroCleanUp takes nothing returns nothing
    set gg_trg_CrossIslandIntroCleanUp=CreateTrigger()
    call TriggerAddAction(gg_trg_CrossIslandIntroCleanUp, function Trig_CrossIslandIntroCleanUp_Actions)
endfunction

