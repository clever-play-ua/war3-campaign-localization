    if ( not Trig_AI_P15_Attacker_Being_Attacked_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Attacker_Being_Attacked_Func002Func001A takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(GetEnumUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)
endfunction

function Trig_AI_P15_Attacker_Being_Attacked_Func002Func003A takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(GetEnumUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
endfunction

function Trig_AI_P15_Attacker_Being_Attacked_Func002Func004Func001A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, 410)
endfunction

function Trig_AI_P15_Attacker_Being_Attacked_Func002Func004Func002A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, 474)
endfunction

function Trig_AI_P15_Attacker_Being_Attacked_Func002Func004Func004A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, - 2147483238)
endfunction

function Trig_AI_P15_Attacker_Being_Attacked_Func002Func004Func005A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, - 2147483174)
endfunction

function Trig_AI_P15_Attacker_Being_Attacked_Func002Func004C takes nothing returns boolean
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_ANCIENT) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Attacker_Being_Attacked_Func002C takes nothing returns boolean
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_FLYING) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Attacker_Being_Attacked_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_AI_P15_Attacker_Being_Attacked_Func002C() ) then
        call ForGroupBJ(udg_G_P15_AttackerFrigate, function Trig_AI_P15_Attacker_Being_Attacked_Func002Func001A)
        call PolledWait(6.00)
        call ForGroupBJ(udg_G_P15_AttackerFrigate, function Trig_AI_P15_Attacker_Being_Attacked_Func002Func003A)
    else
        if ( Trig_AI_P15_Attacker_Being_Attacked_Func002Func004C() ) then
            call ForGroupBJ(udg_G_P15_AttackerFrigate, function Trig_AI_P15_Attacker_Being_Attacked_Func002Func004Func001A)
            call ForGroupBJ(udg_G_P15_AttackerBattleship, function Trig_AI_P15_Attacker_Being_Attacked_Func002Func004Func002A)
            call PolledWait(6.00)
            call ForGroupBJ(udg_G_P15_AttackerFrigate, function Trig_AI_P15_Attacker_Being_Attacked_Func002Func004Func004A)
            call ForGroupBJ(udg_G_P15_AttackerBattleship, function Trig_AI_P15_Attacker_Being_Attacked_Func002Func004Func005A)
        else
        endif
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction

