function Trig_MidgameCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_MidgameSetup)
    call TriggerSleepAction(0.10)
    call CameraSetupApplyForPlayer(true, gg_cam_Mid01Shipyard, udg_Player_Actual, 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    set udg_Point_CinematicPeonTemp=GetUnitLoc(udg_Unit_PeonArr[4])
    call CameraSetupApplyForPlayer(true, gg_cam_Mid02PeonFalls, udg_Player_Actual, ( ( DistanceBetweenPoints(udg_Point_CinematicPeonTemp, GetRectCenter(gg_rct_Peon03)) / GetUnitMoveSpeed(udg_Unit_PeonArr[4]) ) + 2.00 ))
    // Cinematic started and can be skipped now
    set udg_Bool_CinMidgameOn=true
    // //
    // Scene 1
    // //
    call PlaySoundBJ(gg_snd_TheHorde)
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, udg_Unit_PeonArr[4])
    call IssuePointOrderLocBJ(udg_Unit_PeonArr[4], "move", GetRectCenter(gg_rct_Peon03))
    set udg_Point_CinematicPeonTemp=GetUnitLoc(udg_Unit_PeonArr[4])
    call TriggerSleepAction(( ( DistanceBetweenPoints(udg_Point_CinematicPeonTemp, GetRectCenter(gg_rct_Peon03)) / GetUnitMoveSpeed(udg_Unit_PeonArr[4]) ) - 0.50 ))
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_Unit_PeonArr[4], "cinematic injured one")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeTharbek, "move", GetRectCenter(gg_rct_TharbekKicksPeonsAss))
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley2, 100, udg_FakeTharbek)
    call SetUnitAnimation(udg_Unit_PeonArr[4], "cinematic injured two")
    set udg_Point_CinematicTharbekTemp=GetUnitLoc(udg_FakeTharbek)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_CinematicTharbekTemp, GetRectCenter(gg_rct_TharbekKicksPeonsAss)) / GetUnitMoveSpeed(udg_FakeTharbek) ))
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Poke
    call SetUnitAnimation(udg_FakeTharbek, "attack defend")
    call QueueUnitAnimationBJ(udg_FakeTharbek, "cinematic angry one")
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc14Tharbek2, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(0.40)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundOnUnitBJ(gg_snd_MetalMediumSliceFlesh1, 50.00, udg_FakeTharbek)
    call TriggerSleepAction(0.60)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_PeonArr[4], "move", GetRectCenter(gg_rct_Peon02))
    call AddUnitAnimationPropertiesBJ(true, "lumber", udg_Unit_PeonArr[4])
    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley1, 100, udg_Unit_PeonArr[4])
    set udg_Point_CinematicPeonTemp=GetUnitLoc(udg_Unit_PeonArr[4])
    call SetUnitFacingToFaceLocTimed(udg_FakeTharbek, GetRectCenter(gg_rct_Peon02), ( DistanceBetweenPoints(udg_Point_CinematicPeonTemp, GetRectCenter(gg_rct_Peon02)) / GetUnitMoveSpeed(udg_Unit_PeonArr[4]) ))
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraSetupApplyForPlayer(true, gg_cam_Mid03TharbekPokes, Player(0), 5.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeTharbek)
    call IssuePointOrderLocBJ(udg_FakeTharbek, "move", GetRectCenter(gg_rct_TharbekGoesAway))
    call PlaySoundOnUnitBJ(gg_snd_CS_HU_2_Intro_Foley2, 100, udg_FakeTharbek)
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
