//===========================================================================
function Trig_WheatFieldScorched_Func003C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetDyingUnit()) == udg_Player_LordaeronCityGuards ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Lordaeron ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == udg_Player_Citizens ) ) then
        return true
    endif
    return false
endfunction

function Trig_WheatFieldScorched_Conditions takes nothing returns boolean
    if ( not ( RectContainsUnit(gg_rct_ExpansionGoldmine, GetDyingUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    if ( not Trig_WheatFieldScorched_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_WheatFieldScorched_Actions takes nothing returns nothing
    set udg_Point_WheatScorchedTemp=GetUnitLoc(GetDyingUnit())
    call SetDoodadAnimationBJ("death", 'D6F9', 512.00, udg_Point_WheatScorchedTemp)
    call RemoveLocation(udg_Point_WheatScorchedTemp)
endfunction

