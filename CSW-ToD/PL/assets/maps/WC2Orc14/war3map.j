//===========================================================================
function InitTrig_FaceAnimLoader takes nothing returns nothing
    set gg_trg_FaceAnimLoader=CreateTrigger()
    call TriggerAddAction(gg_trg_FaceAnimLoader, function Trig_FaceAnimLoader_Actions)
endfunction

//===========================================================================
// Trigger: LoadCache
//===========================================================================
function Trig_LoadCache_Func005C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("M13StaffFound", "WC2Orc13", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_LoadCache_Actions takes nothing returns nothing
    // //
    call InitGameCacheBJ("WC2Horde.w3v")
    set udg_Cache=GetLastCreatedGameCacheBJ()
    // //
    if ( Trig_LoadCache_Func005C() ) then
        set udg_Bool_M13SecretFound=true
    else
        call DoNothing()
    endif
    // //
    // Debug
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_LoadDoomhammer)
    call ConditionalTriggerExecute(gg_trg_LoadTharbek)
    call ConditionalTriggerExecute(gg_trg_LoadUtok)
    call ConditionalTriggerExecute(gg_trg_LoadZuluhed)
    call ConditionalTriggerExecute(gg_trg_LoadRend)
    call ConditionalTriggerExecute(gg_trg_LoadMaim)
endfunction

//===========================================================================
function InitTrig_LoadCache takes nothing returns nothing
    set gg_trg_LoadCache=CreateTrigger()
    call TriggerAddAction(gg_trg_LoadCache, function Trig_LoadCache_Actions)
endfunction

//===========================================================================
// Trigger: LoadDoomhammer
//===========================================================================
function Trig_LoadDoomhammer_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc10", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_LoadDoomhammer_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_LoadDoomhammer_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Doomhammer", "WC2Orc10", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_IntroDoomhammer), GetRectCenter(gg_rct_IntroTharbek))
        set udg_Hero_Doomhammer=GetLastRestoredUnitBJ()
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'O602', Player(0), GetRectCenter(gg_rct_IntroDoomhammer), GetRectCenter(gg_rct_IntroTharbek))
        set udg_Hero_Doomhammer=GetLastCreatedUnit()
        call SetHeroLevelBJ(udg_Hero_Doomhammer, 8, false)
        call SelectHeroSkill(udg_Hero_Doomhammer, 'A00F')
        call SelectHeroSkill(udg_Hero_Doomhammer, 'A00F')
        call SelectHeroSkill(udg_Hero_Doomhammer, 'XDQ1')
        call SelectHeroSkill(udg_Hero_Doomhammer, 'XDQ1')
        call SelectHeroSkill(udg_Hero_Doomhammer, 'A008')
