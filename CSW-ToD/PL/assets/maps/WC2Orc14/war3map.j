function Trig_P10DeindexPassengers_Func011C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hFAM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hBoM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hBAM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hMaM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hKAM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'hPaM' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'n60B' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'h9ZW' ) ) then
        return true
    endif
    return false
endfunction

function Trig_P10DeindexPassengers_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_Lordaeron ) ) then
        return false
    endif
    if ( not Trig_P10DeindexPassengers_Func011C() ) then
        return false
    endif
    return true
endfunction

function Trig_P10DeindexPassengers_Actions takes nothing returns nothing
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_IdleMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarines[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_QueuedMarinesAdditional[GetConvertedPlayerId(GetOwningPlayer(udg_UDexUnits[udg_UDex]))])
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_UnitsInCargo)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P10MarineRanged)
    call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_Group_P10MarineCatapults)
endfunction

//===========================================================================
function InitTrig_P10DeindexPassengers takes nothing returns nothing
    set gg_trg_P10DeindexPassengers=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_P10DeindexPassengers, "udg_DeathEvent", EQUAL, 1.00)
    call TriggerRegisterVariableEvent(gg_trg_P10DeindexPassengers, "udg_UnitIndexEvent", EQUAL, 2.00)
    call TriggerAddCondition(gg_trg_P10DeindexPassengers, Condition(function Trig_P10DeindexPassengers_Conditions))
    call TriggerAddAction(gg_trg_P10DeindexPassengers, function Trig_P10DeindexPassengers_Actions)
endfunction

