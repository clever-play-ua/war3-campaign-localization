function Trig_QMSCDiscoveredQ_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_QMSCDiscoveredQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerAbilityAvailableBJ(false, 'Awrp', udg_Player_Lordaeron)
    call ConditionalTriggerExecute(gg_trg_AI_P10_Command_Stop_Attack_User)
    call ConditionalTriggerExecute(gg_trg_AI_P10_Command_Start_Attack_User_By_Air_Only)
    // //
    call QuestSetDiscoveredBJ(udg_QMSackTheCity, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2862")
    // //
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h616_0147), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMSCPingIcon[1]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h612_0149), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMSCPingIcon[2]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h611_0002), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMSCPingIcon[4]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h61A_0099), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMSCPingIcon[5]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h61B_0098), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMSCPingIcon[6]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h61C_0092), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMSCPingIcon[7]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h60I_0148), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMSCPingIcon[8]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h617_0065), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMSCPingIcon[9]=GetLastCreatedMinimapIcon()
    // //
    call QueuedTriggerAddBJ(gg_trg_PassengerTechtreeHintQ, true)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

