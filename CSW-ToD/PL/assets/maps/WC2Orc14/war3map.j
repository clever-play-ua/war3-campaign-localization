//===========================================================================
function Trig_CrossIslandOutroSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinCrossIslandOUTOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_CrossIslandOutroSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinCrossIslandOUTSkipped=true
    call ConditionalTriggerExecute(gg_trg_CrossIslandOutroCleanUp)
    call StopSoundBJ(gg_snd_WC2Orc14Gorefiend2, false)
    call StopSoundBJ(gg_snd_WC2Orc14Utok5, false)
endfunction

