//===========================================================================
function Trig_DebugOn_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_DebugOn_Actions takes nothing returns nothing
    set udg_Bool_DebugOn=true
    call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3990")
endfunction

//===========================================================================
