    if ( ( GetTrainedUnitType() == 'hFrK' ) ) then
        return true
    endif
    if ( ( GetTrainedUnitType() == 'h9ZZ' ) ) then
        return true
    endif
    return false
endfunction

function Trig_P15OilSpentForDestroyer_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not Trig_P15OilSpentForDestroyer_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_P15OilSpentForDestroyer_Func015C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P15OilSpentForDestroyer_Actions takes nothing returns nothing
    // Check the amount of Oil for Player
    if (OilHarvest___playerOil[GetPlayerId((Player(14)))]) < 700 then // INLINED!!
