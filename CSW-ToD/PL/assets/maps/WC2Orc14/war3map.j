function ConstructEvent___OnCallback takes nothing returns nothing
    local integer iter= s__IntegerList_first[ConstructEvent___ongoing]
    local integer obj
    local real dx
    local real dy

    loop
        exitwhen iter == 0
        set obj=(LoadInteger(Table___ht, (((((iter))))), (- 1))) // INLINED!!

