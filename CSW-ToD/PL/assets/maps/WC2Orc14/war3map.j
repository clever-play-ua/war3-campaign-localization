        return false
    endif
    return true
endfunction

function Trig_Maim_I_Maim_Func009Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Maim_I_Maim_Func009A takes nothing returns nothing
    if ( Trig_Maim_I_Maim_Func009Func001C() ) then
        // (Level of Maim (Maim) for (Triggering unit)) Equal to ...
        if ( Trig_Maim_I_Maim_Func009Func001Func002C() ) then
            call UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), ( 50.00 * udg_Maim_Recklessness_Bonus ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
        else
            if ( Trig_Maim_I_Maim_Func009Func001Func002Func001C() ) then
                call UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), ( 75.00 * udg_Maim_Recklessness_Bonus ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
            else
                if ( Trig_Maim_I_Maim_Func009Func001Func002Func001Func001C() ) then
                    call UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), ( 100.00 * udg_Maim_Recklessness_Bonus ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
                else
                endif
            endif
        endif
    else
    endif
endfunction

function Trig_Maim_I_Maim_Actions takes nothing returns nothing
    // Sound: Ability_Maim
    call PlaySoundOnUnitBJ(gg_snd_Ability_Maim, 75.00, GetSpellTargetUnit())
    //  
    set udg_Maim_TempPoint_E=GetUnitLoc(GetSpellTargetUnit())
    // Maim_Recklessness_Bonus
    if ( Trig_Maim_I_Maim_Func006C() ) then
        set udg_Maim_Recklessness_Bonus=1.50
    else
        set udg_Maim_Recklessness_Bonus=1.00
    endif
    //  
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(150.00, udg_Maim_TempPoint_E, Condition(function Trig_Maim_I_Maim_Func009001003)), function Trig_Maim_I_Maim_Func009A)
    //  
    call RemoveLocation(udg_Maim_TempPoint_E)
endfunction

