    call SetUnitPositionLocFacingBJ(udg_FakeGorefiend, GetRectCenter(gg_rct_GorefiendIntroStart), 90.00)
    // ////
    // Ships Patrolling
    // ////
    call IssuePointOrderLocBJ(gg_unit_e60C_0771, "patrol", GetRectCenter(gg_rct_ShipPatrol01))
    call IssuePointOrderLocBJ(gg_unit_e60C_0772, "patrol", GetRectCenter(gg_rct_ShipPatrol07))
    call TriggerSleepAction(1.00)
    call IssuePointOrderLocBJ(gg_unit_e60C_0769, "patrol", GetRectCenter(gg_rct_ShipPatrol02))
    call IssuePointOrderLocBJ(gg_unit_e60C_0781, "patrol", GetRectCenter(gg_rct_ShipPatrol08))
    call TriggerSleepAction(1.00)
    call IssuePointOrderLocBJ(gg_unit_e60C_0770, "patrol", GetRectCenter(gg_rct_ShipPatrol03))
    call IssuePointOrderLocBJ(gg_unit_e60C_0773, "patrol", GetRectCenter(gg_rct_ShipPatrol09))
    call TriggerSleepAction(1.00)
    call IssuePointOrderLocBJ(gg_unit_e60C_0778, "patrol", GetRectCenter(gg_rct_ShipPatrol04))
    call IssuePointOrderLocBJ(gg_unit_e60C_0775, "patrol", GetRectCenter(gg_rct_ShipPatrol10))
    call TriggerSleepAction(1.00)
    call IssuePointOrderLocBJ(gg_unit_e60C_0779, "patrol", GetRectCenter(gg_rct_ShipPatrol05))
    call IssuePointOrderLocBJ(gg_unit_e60C_0774, "patrol", GetRectCenter(gg_rct_ShipPatrol11))
    call TriggerSleepAction(1.00)
    call IssuePointOrderLocBJ(gg_unit_e60C_0780, "patrol", GetRectCenter(gg_rct_ShipPatrol06))
    // ////
endfunction

