//===========================================================================
// Trigger: QMLHDiscoveredQ
//===========================================================================
function Trig_QMLHDiscoveredQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 30.00)
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P10_Start)
    call ConditionalTriggerExecute(gg_trg_AI_P15_Start)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Doomhammer, 'O602', gg_snd_WC2Orc14Orgrim10, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_Blackrock, 'o605', GetCameraTargetPositionLoc(), gg_snd_WC2Orc14Utok1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QuestSetDiscoveredBJ(udg_QMLordaeronHarbour, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2861")
    // //
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h60X_0063), bj_CAMPPINGSTYLE_PRIMARY)
    set udg_QMLHPingIcon[1]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_o61C_0118), bj_CAMPPINGSTYLE_PRIMARY)
    set udg_QMLHPingIcon[2]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_h60X_0121), bj_CAMPPINGSTYLE_PRIMARY)
    set udg_QMLHPingIcon[3]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_o61A_0117), bj_CAMPPINGSTYLE_PRIMARY)
    set udg_QMLHPingIcon[4]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_o61A_0040), bj_CAMPPINGSTYLE_PRIMARY)
    set udg_QMLHPingIcon[5]=GetLastCreatedMinimapIcon()
    // //
    // //
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call QueuedTriggerAddBJ(gg_trg_HintReinforcementQ, true)
endfunction

//===========================================================================
function InitTrig_QMLHDiscoveredQ takes nothing returns nothing
    set gg_trg_QMLHDiscoveredQ=CreateTrigger()
    call TriggerAddAction(gg_trg_QMLHDiscoveredQ, function Trig_QMLHDiscoveredQ_Actions)
endfunction

