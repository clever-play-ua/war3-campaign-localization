//===========================================================================
// Trigger: IntroSetup
//===========================================================================
function Trig_IntroSetup_Func026001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_IntroSetup_Func026001002002001 takes nothing returns boolean
    return ( GetFilterUnit() != udg_Hero_Doomhammer )
endfunction

function Trig_IntroSetup_Func026001002002002 takes nothing returns boolean
    return ( GetFilterUnit() != udg_SemiHero_Tharbek )
endfunction

function Trig_IntroSetup_Func026001002002 takes nothing returns boolean
    return GetBooleanAnd((GetFilterUnit() != udg_Hero_Doomhammer), (GetFilterUnit() != udg_SemiHero_Tharbek)) // INLINED!!
endfunction

function Trig_IntroSetup_Func026001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetBooleanAnd((GetFilterUnit() != udg_Hero_Doomhammer), (GetFilterUnit() != udg_SemiHero_Tharbek)))) // INLINED!!
endfunction

function Trig_IntroSetup_Func026A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_IntroSetup_Func027002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_IntroSetup_Func067Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroSetup_Func067A takes nothing returns nothing
    if ( Trig_IntroSetup_Func067Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_IntroSetup_Func068Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroSetup_Func068A takes nothing returns nothing
    if ( Trig_IntroSetup_Func068Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_IntroSetup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    call SetTimeOfDay(5.00)
    // Set Sky
    call SetSkyModel("Environment\\Sky\\LordaeronSummerSky\\LordaeronSummerSky.mdl")
    // Set Fog
    call SetTerrainFogExBJ(0, 2500.00, 16500.00, 0.50, 50.00, 50.00, 68.00)
    // Animations
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.25)
    // Peons
    call SetUnitAnimation(gg_unit_o61X_0244, "stand work")
    call SetUnitAnimation(gg_unit_o61X_0243, "stand work")
    call SetUnitAnimation(gg_unit_o61X_0241, "stand work")
    call SetUnitAnimation(gg_unit_o61X_0242, "stand work")
    // ////
    call ShowUnitHide(udg_Hero_Uther)
    call SetUnitPositionLocFacingBJ(udg_FakeUther, GetRectCenter(gg_rct_UtherIntro), 232.05)
    // ////
    // Doomhammer
    call SetUnitPositionLocFacingBJ(udg_FakeDoomhammer, udg_Point_IntroDoomhammerLoc, 306.41)
    // Tharbek
    call SetUnitPositionLocFacingBJ(udg_FakeTharbek, GetRectCenter(gg_rct_IntroTharbek), 132.53)
    // Grunts
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_IntroTroopsHide, Condition(function Trig_IntroSetup_Func026001002)), function Trig_IntroSetup_Func026A)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_IntroSetup_Func027002)
    // Uther(Tiny)
    call CreateNUnitsAtLoc(1, 'H008', udg_Player_Lordaeron, GetRectCenter(gg_rct_IntroUtherSaviour01), 177.54)
    set udg_Unit_UtherTiny=GetLastCreatedUnit()
    call SetUnitColor(udg_Unit_UtherTiny, PLAYER_COLOR_BLUE)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_UtherTiny)
    call SetUnitAnimation(udg_Unit_UtherTiny, "Cinematic Kneeling One")
    call SetUnitBlendTimeBJ(udg_Unit_UtherTiny, 1.00)
    call SetUnitMoveSpeed(udg_Unit_UtherTiny, 70.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_UtherTiny, UNIT_RF_ANIMATION_WALK_SPEED, 70.00)
    // Family
    call CreateNUnitsAtLoc(1, 'n00U', Player(8), GetRectCenter(gg_rct_IntroMom), 128.55)
    set udg_Unit_IntroMom=GetLastCreatedUnit()
    call SetUnitMoveSpeed(udg_Unit_IntroMom, 70.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroMom, UNIT_RF_ANIMATION_WALK_SPEED, 70.00)
    call CreateNUnitsAtLoc(1, 'n00W', Player(8), GetRectCenter(gg_rct_IntroChildTalks), 340.88)
    set udg_Unit_IntroChild=GetLastCreatedUnit()
    call SetUnitBlendTimeBJ(udg_Unit_IntroChild, 0.50)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_IntroChild)
    call SetUnitMoveSpeed(udg_Unit_IntroChild, 70.00)
    call BlzSetUnitRealFieldBJ(udg_Unit_IntroChild, UNIT_RF_ANIMATION_WALK_SPEED, 70.00)
    call SetDoodadAnimationRectBJ("death alternate", 'D69S', gg_rct_HideoutDoor)
    // HideMedivh
    call ShowUnitHide(gg_unit_n60Y_0375)
    // ////
    call SetUnitAnimation(gg_unit_h623_1004, "cinematic listening one")
    call SetUnitAnimation(gg_unit_h623_1003, "cinematic listening one")
    // ////
    call SetUnitMoveSpeed(gg_unit_h60K_0482, 150.00)
    call BlzSetUnitRealFieldBJ(gg_unit_h60K_0482, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_h60K_0482)
    // ////
    call SetUnitMoveSpeed(gg_unit_h60K_0485, 150.00)
    call BlzSetUnitRealFieldBJ(gg_unit_h60K_0485, UNIT_RF_ANIMATION_WALK_SPEED, 150.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_h60K_0485)
    // ////
    call AddUnitAnimationPropertiesBJ(true, "gold", gg_unit_h60J_0102)
    call AddUnitAnimationPropertiesBJ(true, "gold", gg_unit_h60J_0480)
    call AddUnitAnimationPropertiesBJ(true, "gold", gg_unit_h60J_0478)
    // ////
    call EnumDestructablesInRectAll(gg_rct_CinematicPBKill01, function Trig_IntroSetup_Func067A)
    call EnumDestructablesInRectAll(gg_rct_CinematicPBKill02, function Trig_IntroSetup_Func068A)
    // ////
endfunction

//===========================================================================
function InitTrig_IntroSetup takes nothing returns nothing
    set gg_trg_IntroSetup=CreateTrigger()
    call TriggerAddAction(gg_trg_IntroSetup, function Trig_IntroSetup_Actions)
endfunction

//===========================================================================
// Trigger: IntroSkipped
//===========================================================================
function Trig_IntroSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinIntroSkipped=true
    // Fade Out
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    call DisableTrigger(gg_trg_IntroBellSound)
    // Cleanup
    call ConditionalTriggerExecute(gg_trg_IntroCleanup)
    call StopSoundBJ(gg_snd_WC2Orc14Orgrim1, false)
    call StopSoundBJ(gg_snd_WC2Orc14Tharbek1, false)
    call StopSoundBJ(gg_snd_WC2Orc14Captain1, false)
    call StopSoundBJ(gg_snd_WC2Orc14ChildTimmy1, false)
    call StopSoundBJ(gg_snd_WC2Orc14Uther1, false)
    call StopSoundBJ(gg_snd_WC2Orc14Uther2, false)
    call StopSoundBJ(gg_snd_CS_BG_CampLoop01, false)
    call StopSoundBJ(gg_snd_CS_H01a_soldiers_walk_RtoL_a, false)
    call StopSoundBJ(gg_snd_CS_H01a_soldiers_walk_RtoL_a01, false)
    call StopSoundBJ(gg_snd_CS_Prologue2_Foley1, false)
endfunction

//===========================================================================
function InitTrig_IntroSkipped takes nothing returns nothing
    set gg_trg_IntroSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_IntroSkipped, Player(0))
    call TriggerAddCondition(gg_trg_IntroSkipped, Condition(function Trig_IntroSkipped_Conditions))
    call TriggerAddAction(gg_trg_IntroSkipped, function Trig_IntroSkipped_Actions)
endfunction

//===========================================================================
// Trigger: IntroCleanup
//===========================================================================
function Trig_IntroCleanup_Func033Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return false
    endif
    if ( not ( IsDestructableDeadBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCleanup_Func033A takes nothing returns nothing
    if ( Trig_IntroCleanup_Func033Func001C() ) then
        call DestructableRestoreLife(GetEnumDestructable(), 9999.00, false)
    else
    endif
endfunction

function Trig_IntroCleanup_Func034Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' ) ) then
        return false
    endif
    if ( not ( IsDestructableDeadBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCleanup_Func034A takes nothing returns nothing
    if ( Trig_IntroCleanup_Func034Func001C() ) then
        call DestructableRestoreLife(GetEnumDestructable(), 9999.00, false)
    else
    endif
endfunction

function Trig_IntroCleanup_Func036002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_IntroCleanup_Func037002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_IntroCleanup_Func040002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_IntroCleanup_Func067C takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroCleanup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call TriggerSleepAction(1.00)
    set udg_Bool_CinIntroOn=false
    call CameraSetupApplyForPlayer(true, gg_cam_GameHasStarted, udg_Player_Actual, 0)
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_Wallpaper)
    call StopSoundBJ(gg_snd_WC3OrcVictory, false)
    call StopSoundBJ(gg_snd_Comradeship, false)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call SetUnitMoveSpeed(gg_unit_hcth_0706, 270.00)
    call BlzSetUnitRealFieldBJ(gg_unit_hcth_0706, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_hcth_0706)
    call ResetUnitAnimation(gg_unit_o61X_0241)
    call ResetUnitAnimation(gg_unit_o61X_0242)
    call ResetUnitAnimation(gg_unit_o61X_0243)
    call ResetUnitAnimation(gg_unit_o61X_0244)
    // //
    call SetDoodadAnimationRectBJ("stand", 'D69S', gg_rct_HideoutDoor)
    // ////
    call SetUnitMoveSpeed(gg_unit_h60K_0482, 270.00)
    call BlzSetUnitRealFieldBJ(gg_unit_h60K_0482, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_h60K_0482)
    // ////
    call SetUnitMoveSpeed(gg_unit_h60K_0485, 270.00)
    call BlzSetUnitRealFieldBJ(gg_unit_h60K_0485, UNIT_RF_ANIMATION_WALK_SPEED, 270.00)
    call AddUnitAnimationPropertiesBJ(false, "cinematic", gg_unit_h60K_0485)
    // ////
    call RemoveUnit(gg_unit_h60J_0478)
    call RemoveUnit(gg_unit_h60J_0480)
    call RemoveUnit(gg_unit_h60J_0102)
    // ////
    call EnumDestructablesInRectAll(gg_rct_CinematicPBKill01, function Trig_IntroCleanup_Func033A)
    call EnumDestructablesInRectAll(gg_rct_CinematicPBKill02, function Trig_IntroCleanup_Func034A)
    // ////
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_IntroCleanup_Func036002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_IntroCleanup_Func037002)
    call GroupClear(udg_Group_HiddenUnits)
    // //
    call ForGroupBJ(udg_Group_WallArchers, function Trig_IntroCleanup_Func040002)
    // //
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60G_0010, GetRectCenter(gg_rct_IntroBTGGrunt01), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60G_0009, GetRectCenter(gg_rct_IntroBTGGrunt02), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60G_0008, GetRectCenter(gg_rct_IntroBTGGrunt03), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60G_0007, GetRectCenter(gg_rct_IntroBTGGrunt04), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60O_0067, GetRectCenter(gg_rct_IntroTroll01), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60O_0070, GetRectCenter(gg_rct_IntroTroll02), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60O_0069, GetRectCenter(gg_rct_IntroTroll03), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o60O_0068, GetRectCenter(gg_rct_IntroTroll04), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61W_0062, GetRectCenter(gg_rct_IntroBRGrunt01), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61W_0011, GetRectCenter(gg_rct_IntroBRGrunt02), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61W_0066, GetRectCenter(gg_rct_IntroBRGrunt03), GetRectCenter(gg_rct_IntroDoomhammer))
    call SetUnitPositionLocFacingLocBJ(gg_unit_o61W_0064, GetRectCenter(gg_rct_IntroBRGrunt04), GetRectCenter(gg_rct_IntroDoomhammer))
    // //
    call RemoveUnit(gg_unit_n01O_0492)
    call SetUnitBlendTimeBJ(gg_unit_hcth_0706, 0.25)
    call StopSoundBJ(gg_snd_CS_HU_6_Intro_AmbBells, false)
    call DisableTrigger(gg_trg_IntroBellSound)
    // //
    call ShowUnitShow(udg_Hero_Doomhammer)
    call ShowUnitShow(udg_SemiHero_Tharbek)
    // //
    call SetUnitOwner(udg_Hero_Rend, udg_Player_BTG, false)
    call SetUnitOwner(udg_Hero_Zuluhed, udg_Player_DragonMaw, false)
    call SetUnitOwner(udg_Hero_Maim, udg_Player_BTG, false)
    // //
    if ( Trig_IntroCleanup_Func067C() ) then
        call RemoveUnit(udg_Unit_UtherTiny)
        call RemoveUnit(udg_Unit_IntroChild)
        call RemoveUnit(udg_Unit_IntroMom)
        call SetUnitPositionLoc(gg_unit_h60K_0482, GetRectCenter(gg_rct_IntroFootman01))
        call SetUnitPositionLoc(gg_unit_h60K_0485, GetRectCenter(gg_rct_IntroFootman02))
        call SetUnitPositionLoc(gg_unit_h60B_0466, GetRectCenter(gg_rct_IntroArcherOnWall04))
        call SetUnitPositionLoc(gg_unit_h60B_0468, GetRectCenter(gg_rct_IntroArcherOnWall01))
        call SetUnitPositionLoc(gg_unit_h60B_0464, GetRectCenter(gg_rct_IntroArcherOnWall03))
        call SetUnitPositionLoc(gg_unit_h60B_0462, GetRectCenter(gg_rct_IntroArcherOnWall02))
        call SetUnitPositionLoc(gg_unit_h60B_0470, GetRectCenter(gg_rct_IntroArcherOnWall05))
    else
    endif
    // //
    call RemoveLocation(udg_Point_IntroCitizensSpawn)
    call RemoveLocation(udg_Point_IntroDoomhammerLoc)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveLocation(udg_Point_IntroArchersTempArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    // UnhideMedivh
    // //
    call ShowUnitShow(gg_unit_n60Y_0375)
    // //
    set udg_Real_FogMin=3000.00
    set udg_Real_FogMax=12500.00
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, udg_Real_FogColorR, udg_Real_FogColorG, udg_Real_FogColorB)
    // //
    // Fade In
    // //
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_CameraBounds01)
    call BlzChangeMinimapTerrainTex("Mission14MapFenris.tga")
    // //
    call QueuedTriggerRemoveBJ(gg_trg_IntroCinematic_Q)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 0.50, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(0.50)
    // Start Game
    call SelectUnitForPlayerSingle(udg_Hero_Doomhammer, udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_InitQuests)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

//===========================================================================
function InitTrig_IntroCleanup takes nothing returns nothing
    set gg_trg_IntroCleanup=CreateTrigger()
    call TriggerAddAction(gg_trg_IntroCleanup, function Trig_IntroCleanup_Actions)
endfunction

