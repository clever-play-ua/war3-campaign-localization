function Trig_SpawnMilitia_Func007C takes nothing returns boolean
    if ( not ( udg_CitizenSpeechChance >= 7 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SpawnMilitia_Actions takes nothing returns nothing
    set udg_Point_SpawnMilitiaTemp=GetUnitLoc(GetDyingUnit())
    call CreateNUnitsAtLoc(GetRandomInt(1, 4), 'hmil', udg_Player_Lordaeron, udg_Point_SpawnMilitiaTemp, GetRandomDirectionDeg())
    call RemoveLocation(udg_Point_SpawnMilitiaTemp)
    set udg_CitizenSpeechChance=GetRandomInt(1, 10)
    if ( Trig_SpawnMilitia_Func007C() ) then
        call SetSpeechVolumeGroupsBJ()
        call TransmissionFromUnitTypeWithNameBJ(udg_PlayerGroup_PlayerActual, udg_Player_Lordaeron, 'hmil', "TRIGSTR_3141", GetCameraTargetPositionLoc(), gg_snd_H01VillagerM43, "TRIGSTR_3142", bj_TIMETYPE_ADD, 0, true)
        call VolumeGroupResetBJ()
    else
    endif
endfunction

