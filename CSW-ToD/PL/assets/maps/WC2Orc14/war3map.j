//===========================================================================
// Trigger: EnforceWithDeathKnights
//===========================================================================
function Trig_EnforceWithDeathKnights_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(0) ) ) then
        return false
    endif
    return true
endfunction

function Trig_EnforceWithDeathKnights_Func012A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_EnforceWithDeathKnights_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call GroupPointOrderLocBJ(udg_Group_IntroCIDeathKnights, "move", GetRandomLocInRect(gg_rct_DKSupportAttack))
    call DestroyEffectBJ(udg_SE_UndeadSpawnArr[1])
    call DestroyEffectBJ(udg_SE_UndeadSpawnArr[2])
    call DisableTrigger(gg_trg_SpawnUndead01)
    set udg_Bool_SkeletonProduceOn=false
    call ForGroupBJ(udg_Group_SpawnedSkeletons, function Trig_EnforceWithDeathKnights_Func012A)
    call ResetUnitAnimation(udg_Hero_TeronGorefiend)
    call EnableTrigger(gg_trg_DeathKnightsGroupIsKilled)
endfunction

//===========================================================================
function InitTrig_EnforceWithDeathKnights takes nothing returns nothing
    set gg_trg_EnforceWithDeathKnights=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_EnforceWithDeathKnights, gg_rct_DetectGroundUnitCrossIsland01)
    call TriggerRegisterEnterRectSimple(gg_trg_EnforceWithDeathKnights, gg_rct_DetectGroundUnitCrossIsland02)
    call TriggerRegisterEnterRectSimple(gg_trg_EnforceWithDeathKnights, gg_rct_DetectGroundUnitCrossIsland03)
    call TriggerAddCondition(gg_trg_EnforceWithDeathKnights, Condition(function Trig_EnforceWithDeathKnights_Conditions))
    call TriggerAddAction(gg_trg_EnforceWithDeathKnights, function Trig_EnforceWithDeathKnights_Actions)
endfunction

