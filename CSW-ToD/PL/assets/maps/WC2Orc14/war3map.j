    return ( udg_Bool_CinGoblinSkipped == true )
endfunction

function Trig_GoblinCinQ_Func045001 takes nothing returns boolean
    return ( udg_Bool_CinGoblinSkipped == true )
endfunction

function Trig_GoblinCinQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_GoblinCinSetUp)
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinArrives, udg_Player_Actual, 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call IssuePointOrderLocBJ(udg_Unit_GoblinCinTransport, "move", GetRectCenter(gg_rct_GoblinShipArrives))
    // Cinematic started and can be skipped now
    set udg_Bool_CinGoblinOn=true
    // //
    set udg_Point_GoblinCinTemp=GetUnitLoc(udg_Unit_GoblinCinTransport)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_GoblinCinTemp, GetRectCenter(gg_rct_GoblinShipArrives)) / GetUnitMoveSpeed(udg_Unit_GoblinCinTransport) ))
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundAtPointBJ(gg_snd_Dock, 100, GetRectCenter(gg_rct_GoblinShipArrives), 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Kaboom, udg_Player_Actual, ( ( DistanceBetweenPoints(GetRectCenter(gg_rct_GoblinIsDeployed), GetRectCenter(gg_rct_Kaboom)) / 270.00 ) + 1 ))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call PlaySoundAtPointBJ(gg_snd_Loading, 100, GetRectCenter(gg_rct_GoblinIsDeployed), 0)
    call CreateNUnitsAtLoc(1, 'n000', udg_Player_Actual, GetRectCenter(gg_rct_GoblinIsDeployed), 90.00)
    set udg_Unit_GoblinCinSappers=GetLastCreatedUnit()
    call SetUnitLifeBJ(udg_Unit_GoblinCinSappers, 3000.00)
    call SetUnitInvulnerable(udg_Unit_GoblinCinTransport, false)
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_GoblinCinematicUnpause, udg_Player_Lordaeron), function Trig_GoblinCinQ_Func025002)
    call IssueTargetOrderBJ(gg_unit_e000_0396, "attack", udg_Unit_GoblinCinTransport)
    call IssueTargetOrderBJ(gg_unit_e000_0395, "attack", udg_Unit_GoblinCinTransport)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_GoblinCinSappers, 0, gg_snd_GoblinSapperYes3, bj_TIMETYPE_ADD, 0, false)
    // //
    call IssuePointOrderLocBJ(udg_Unit_GoblinCinSappers, "move", GetRectCenter(gg_rct_Kaboom))
    set udg_Point_GoblinCinTemp=GetUnitLoc(udg_Unit_GoblinCinSappers)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_GoblinCinTemp, GetRectCenter(gg_rct_Kaboom)) / GetUnitMoveSpeed(udg_Unit_GoblinCinSappers) ))
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_Unit_GoblinCinSappers, "selfdestruct", GetRectCenter(gg_rct_Kaboom))
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // GatesDestroyed
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 2.00)
    call KillDestructable(gg_dest_B00C_1843)
    call EnumDestructablesInRectAll(gg_rct_GatePB01, function Trig_GoblinCinQ_Func040A)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinGoblinSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_GoblinCinCleanUp)
endfunction

