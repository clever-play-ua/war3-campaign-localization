    if ( not ( udg_Bool_CinGoblinSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_GoblinCinCleanUp_Func006002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_GoblinCinCleanUp_Func007002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_GoblinCinCleanUp_Func018Func004Func001001 takes nothing returns boolean
    return ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpb' )
endfunction

function Trig_GoblinCinCleanUp_Func018Func004A takes nothing returns nothing
    if ( (GetDestructableTypeId(GetEnumDestructable()) == 'YTpb') ) then // INLINED!!
        call RemoveDestructable(GetEnumDestructable())
    else
        call DoNothing()
    endif
endfunction

function Trig_GoblinCinCleanUp_Func018C takes nothing returns boolean
    if ( not ( udg_Bool_CinGoblinSkipped == true ) ) then
        return false
    endif
    if ( not ( IsDestructableAliveBJ(gg_dest_B00C_1843) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_GoblinCinCleanUp_Func024C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_QMSCDiscoveredQ) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerQueuedBJ(gg_trg_QMSCDiscoveredQ) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_GoblinCinCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QueuedTriggerRemoveBJ(gg_trg_GoblinCinQ)
    if ( Trig_GoblinCinCleanUp_Func003C() ) then
        call CameraClearNoiseForPlayer(udg_Player_Actual)
    else
    endif
    call RemoveUnit(udg_Unit_GoblinCinSappers)
    call RemoveUnit(udg_Unit_GoblinCinTransport)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_GoblinCinCleanUp_Func006002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_GoblinCinCleanUp_Func007002)
    call GroupClear(udg_Group_HiddenUnits)
    call PauseAllUnitsBJ(false)
    call RemoveLocation(udg_Point_GoblinCinTemp)
    call CameraSetupApplyForPlayer(true, udg_Var_CurrentCamera, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    if ( Trig_GoblinCinCleanUp_Func018C() ) then
        call CameraSetupApplyForPlayer(true, gg_cam_GateDestroyedPort, udg_Player_Actual, 1.00)
        call TriggerSleepAction(1.00)
        call KillDestructable(gg_dest_B00C_1843)
        call EnumDestructablesInRectAll(gg_rct_GatePB01, function Trig_GoblinCinCleanUp_Func018Func004A)
    else
    endif
    call QueuedTriggerRemoveBJ(gg_trg_GoblinCinQ)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    set udg_Sting_CheckpointPhase="PortDestroyed"
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    if ( Trig_GoblinCinCleanUp_Func024C() ) then
        call QueuedTriggerAddBJ(gg_trg_QMSCDiscoveredQ, true)
    else
    endif
endfunction

