//===========================================================================
function Trig_P10TransportationConfig_Actions takes nothing returns nothing
    // //
    // //
    set udg_IdleTransports[10]=CreateGroup()
    set udg_IdleMarines[10]=CreateGroup()
    set udg_QueuedTransports[10]=CreateGroup()
    set udg_DepartedTransports[10]=CreateGroup()
    set udg_QueuedMarines[10]=CreateGroup()
    set udg_QueuedMarinesAdditional[10]=CreateGroup()
    set udg_DestinationDetectionGroup[10]=CreateGroup()
    // //
    set udg_LandingWarfareManipulator[10]=gg_trg_P10PlayerMarineLandingOrder
    // //
    set udg_BoardingOrderTimerPeriod[10]=2.00
    set udg_BoardingOrderTimerInterval[10]=8.00
    // //
    set udg_DepartureDetectionRange=128.00
    // //
    set udg_AttackPointDetectionRange=384.00
    set udg_AdditionalDetectionRange=896.00
    set udg_DestinationDetectionRange=64.00
    // //
    // //
    call StartTimerBJ(udg_BoardingOrderTimer[10], true, udg_BoardingOrderTimerPeriod[10])
    // //
    set udg_TransportationSystemsPrimed=true
    // //
endfunction

