function Trig_IntroCinematic_Q_Actions takes nothing returns nothing
    // FadeOut
    // //
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // //
    call TriggerSleepAction(0.25)
    call ConditionalTriggerExecute(gg_trg_IntroSetup)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GrateClosed01, udg_Player_Actual, 0)
    // //
    call TriggerSleepAction(0.25)
    // //
    call PlaySoundBJ(gg_snd_Comradeship)
    call PlaySoundAtPointBJ(gg_snd_CS_H01a_soldiers_walk_RtoL_a, 100, GetRectCenter(gg_rct_CinematicPBKill01), 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 4.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_h60K_0482, "move", GetRectCenter(gg_rct_IntroFootman01))
    call IssuePointOrderLocBJ(gg_unit_h60K_0485, "move", GetRectCenter(gg_rct_IntroFootman02))
    // //
    set udg_Bool_CinIntroOn=true
    // //
    // Cinematic Started and can be skipped now
    // //
    // HumansIntro
    // //
    // Gates
    // //
    call PlaySoundBJ(gg_snd_HumanCallToArmsWhat1)
    call CameraSetupApplyForPlayer(true, gg_cam_GrateClosed02, udg_Player_Actual, 4.00)
    call PlaySoundAtPointBJ(gg_snd_GateOpen, 50.00, GetRectCenter(gg_rct_GatePB03), 0)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetDestructableAnimationBJ(gg_dest_B00C_0077, "morph alternate")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetDestructableAnimationBJ(gg_dest_B00C_0077, "stand")
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    // Port
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GoblinArrives, udg_Player_Actual, 0)
    call PlaySoundAtPointBJ(gg_snd_CS_Prologue2_Foley1, 100, GetRectCenter(gg_rct_CinematicPBKill02), 0)
    call IssuePointOrderLocBJ(gg_unit_h60J_0478, "move", GetRectCenter(gg_rct_PeasantsRun))
    call IssuePointOrderLocBJ(gg_unit_h60J_0480, "move", GetRectCenter(gg_rct_PeasantsRun))
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_IntroBellSound)
    // //
    call IssuePointOrderLocBJ(gg_unit_h60J_0102, "move", GetRectCenter(gg_rct_PeasantsRun))
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Kaboom, udg_Player_Actual, 5.00)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundAtPointBJ(gg_snd_GateOpen, 50.00, GetRectCenter(gg_rct_GatePB01), 0)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_IntroSpawnCitizensHideout)
    // //
    call SetDestructableAnimationBJ(gg_dest_B00C_1843, "morph alternate")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetDestructableAnimationBJ(gg_dest_B00C_1843, "stand")
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroUtherTalksToChild, udg_Player_Actual, 0)
    // //
    // Hideout
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroCitizensHide, udg_Player_Actual, 10.00)
    // //
    call SetUnitAnimation(udg_Unit_IntroChild, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_IntroChild, 0, gg_snd_WC2Orc14ChildTimmy1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Unit_IntroChild, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Unit_UtherTiny, 0, gg_snd_WC2Orc14Uther1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_H01c_Arthas_stands_v1, 100, udg_Unit_UtherTiny)
    call SetUnitAnimation(udg_Unit_UtherTiny, "cinematic standup one")
    call QueueUnitAnimationBJ(udg_Unit_UtherTiny, "cinematic listening one")
    call IssuePointOrderLocBJ(udg_Unit_IntroChild, "move", GetRectCenter(gg_rct_IntroHideout))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitTimeScalePercent(udg_Unit_IntroMom, 50.00)
    call IssuePointOrderLocBJ(udg_Unit_IntroMom, "move", GetRectCenter(gg_rct_IntroHideout))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlaySoundOnUnitBJ(gg_snd_CS_H01a_Uther_walks_003_LR_v3, 100, udg_Unit_UtherTiny)
    call IssuePointOrderLocBJ(udg_Unit_UtherTiny, "move", GetRectCenter(gg_rct_IntroUtherSaviourOut))
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call StopSoundBJ(gg_snd_CS_BG_CampLoop01, false)
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetDoodadAnimationRectBJ("stand", 'D69S', gg_rct_HideoutDoor)
    call PlaySoundAtPointBJ(gg_snd_DoorSlam1, 100, GetRectCenter(gg_rct_HideoutDoor), 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    // Captain
    // //
    call RemoveUnit(udg_Unit_UtherTiny)
    call SetDoodadAnimationRectBJ("stand", 'D64K', gg_rct_Wallpaper)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_CaptainTalks, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(gg_unit_hcth_0706, "cinematic stand")
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_hcth_0706, 0, gg_snd_WC2Orc14Captain1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_UtherTalks, udg_Player_Actual, 0)
    // //
    // Camera effects
    call CameraSetFocalDistance(300.00)
    call CameraSetDepthOfFieldScale(150.00)
    // //
    // //
    call SetUnitAnimation(udg_FakeUther, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUther, 0, gg_snd_WC2Orc14Uther2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUther, "cinematic listening one")
    call PlaySoundOnUnitBJ(gg_snd_CS_H01a_soldiers_turn_a, 100, gg_unit_hcth_0706)
    // //
    call SetUnitAnimation(gg_unit_hcth_0706, "cinematic salute one")
    call TriggerSleepAction(0.90)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(gg_unit_hcth_0706, "cinematic salute exit one")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingTimed(udg_FakeUther, bj_UNIT_FACING, 1.00)
    call SetUnitFacingTimed(gg_unit_hcth_0706, bj_UNIT_FACING, 1.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_hcth_0706, "move", GetRectCenter(gg_rct_IntroCaptain02))
    // //
    // Archers
    // //
    call ForGroupBJ(udg_Group_WallArchers, function Trig_IntroCinematic_Q_Func182002)
    call ConditionalTriggerExecute(gg_trg_IntroArchersClimbStart)
    call SetTerrainFogExBJ(0, 1000.00, 3000.00, 0.50, 50.00, 50.00, 68.00)
    // //
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ArchersStart, udg_Player_Actual, 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ArchersOnWalls, udg_Player_Actual, 10.00)
    call TriggerSleepAction(12.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call DisableTrigger(gg_trg_IntroBellSound)
    // //
    // HumansIntroEnded
    call StopSoundBJ(gg_snd_Comradeship, true)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    // OrcsIntro
    // //
    call StopSoundBJ(gg_snd_CS_HU_6_Intro_AmbBells, false)
    // //
    call SetTerrainFogExBJ(0, 1000.00, 3000.00, 0.50, 50.00, 50.00, 68.00)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01, udg_Player_Actual, 0)
    // //
    call PlaySoundBJ(gg_snd_WC3OrcVictory)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro02, udg_Player_Actual, 10.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_IntroSpawnGrunts01)
    call TriggerSleepAction(6.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro03, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro04, udg_Player_Actual, 10.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_IntroSpawnGrunts02)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_IntroSpawnTrolls)
    call TriggerSleepAction(4.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_IntroDialogue)
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc14Orgrim1) + GetSoundDurationBJ(gg_snd_WC2Orc14Tharbek1) ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
