    endif
    call SetUnitVertexColorBJ(udg_Hero_EnemyArchmage, 100, 100, 100, 25.00)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinCrossIslandInSkipped == true) ) then // INLINED!!
