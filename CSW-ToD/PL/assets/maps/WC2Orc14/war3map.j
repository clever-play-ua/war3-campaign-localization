endfunction

function Trig_QMCIObservatoriesDestroyedShieldOff_Func012A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
    call SetUnitInvulnerable(GetEnumUnit(), false)
endfunction

function Trig_QMCIObservatoriesDestroyedShieldOff_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call RemoveWeatherEffectBJ(udg_Weather_DalaranShield01)
    call QuestItemSetCompletedBJ(udg_QMCrossIslandReq[1], true)
    // //
    // Clearing the corridors
    // //
    if ( Trig_QMCIObservatoriesDestroyedShieldOff_Func010C() ) then
        if ( Trig_QMCIObservatoriesDestroyedShieldOff_Func010Func001C() ) then
            set udg_Bool_OuterCircleBreached=true
            call KillDestructable(gg_dest_Dofw_10735)
            call KillDestructable(gg_dest_Dofw_10734)
            call KillDestructable(gg_dest_Dofw_10727)
            call KillDestructable(gg_dest_Dofw_8422)
            call EnumDestructablesInRectAll(gg_rct_WestCorridor, function Trig_QMCIObservatoriesDestroyedShieldOff_Func010Func001Func007A)
            call EnumDestructablesInRectAll(gg_rct_NorthCorridor, function Trig_QMCIObservatoriesDestroyedShieldOff_Func010Func001Func008A)
            call EnumDestructablesInRectAll(gg_rct_EastCorridor, function Trig_QMCIObservatoriesDestroyedShieldOff_Func010Func001Func009A)
            call EnumDestructablesInRectAll(gg_rct_SouthCorridor, function Trig_QMCIObservatoriesDestroyedShieldOff_Func010Func001Func010A)
            // //
            // //
            call DisableTrigger(gg_trg_ECSquad01Killed)
            call DisableTrigger(gg_trg_ECSquad02Killed)
            call DisableTrigger(gg_trg_ECSquad03Killed)
            call DisableTrigger(gg_trg_ECSquad04Killed)
            call DisableTrigger(gg_trg_ECSquad05Killed)
            // //
            call DisableTrigger(gg_trg_WCSquad01Killed)
            call DisableTrigger(gg_trg_WCSquad02Killed)
            call DisableTrigger(gg_trg_WCSquad03Killed)
            call DisableTrigger(gg_trg_WCSquad04Killed)
            call DisableTrigger(gg_trg_WCSquad05Killed)
            call DisableTrigger(gg_trg_WCSquad06Killed)
            // //
            call DisableTrigger(gg_trg_SCSquad01Killed)
            call DisableTrigger(gg_trg_SCSquad02Killed)
            call DisableTrigger(gg_trg_SCSquad03Killed)
            call DisableTrigger(gg_trg_SCSquad04Killed)
            call DisableTrigger(gg_trg_SCSquad05Killed)
            call DisableTrigger(gg_trg_SCSquad06Killed)
            call DisableTrigger(gg_trg_SCSquad07Killed)
            // //
            call DisableTrigger(gg_trg_NCSquad01Killed)
            call DisableTrigger(gg_trg_NCSquad02Killed)
            call DisableTrigger(gg_trg_NCSquad03Killed)
            call DisableTrigger(gg_trg_NCSquad04Killed)
            call DisableTrigger(gg_trg_NCSquad05Killed)
            // //
            call DisableTrigger(gg_trg_WCBarricadeDestroyed)
            call DisableTrigger(gg_trg_ECBarricadeDestroyed)
            call DisableTrigger(gg_trg_NCBarricadeDestroyed)
            // //
        else
        endif
    else
    endif
    // //
    call ForGroupBJ(udg_Group_KirinTorEliteGuard, function Trig_QMCIObservatoriesDestroyedShieldOff_Func012A)
    // //
    call LeaderboardSetLabelBJ(udg_Leaderboard_Observatories, "TRIGSTR_3976")
    call LeaderboardRemovePlayerItemBJ(udg_Player_KirinTor, GetLastCreatedLeaderboard())
    call LeaderboardAddItemBJ(udg_Player_KirinTor, udg_Leaderboard_Observatories, "TRIGSTR_3978", CountUnitsInGroup(udg_Group_KirinTorEliteGuard))
    call LeaderboardSetPlayerItemLabelColorBJ(udg_Player_KirinTor, udg_Leaderboard_Observatories, 100, 80, 20, 0)
    call LeaderboardSetPlayerItemValueColorBJ(udg_Player_KirinTor, udg_Leaderboard_Observatories, 100, 80, 20, 0)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call SetPlayerTechResearchedSwap('RM61', 1, udg_Player_Actual)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_3404")
    // //
    // //
endfunction

