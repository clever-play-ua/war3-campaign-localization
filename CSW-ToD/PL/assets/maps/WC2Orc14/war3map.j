function Trig_CreateFakeActors_Actions takes nothing returns nothing
    // //
    call CreateNUnitsAtLoc(1, 'ODCN', udg_Player_Blackrock, udg_Point_SpawnFakeOrgrim, bj_UNIT_FACING)
    set udg_FakeDoomhammer=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeDoomhammer)
    call SetUnitBlendTimeBJ(udg_FakeDoomhammer, 0.50)
    call SetUnitMoveSpeed(udg_FakeDoomhammer, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeDoomhammer, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call CreateNUnitsAtLoc(1, 'o608', udg_Player_Blackrock, udg_Point_SpawnFakeTharbek, bj_UNIT_FACING)
    set udg_FakeTharbek=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeTharbek)
    call SetUnitBlendTimeBJ(udg_FakeTharbek, 0.50)
    call SetUnitMoveSpeed(udg_FakeTharbek, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeTharbek, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
