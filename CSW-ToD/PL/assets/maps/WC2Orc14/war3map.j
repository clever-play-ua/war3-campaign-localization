//===========================================================================
// Trigger: QOTGTriggered
//===========================================================================
function Trig_QOTGTriggered_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n000' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o60Q' ) ) then
        return false
    endif
    return true
endfunction

function Trig_QOTGTriggered_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_Blackrock, 'o605', GetCameraTargetPositionLoc(), gg_snd_WC2Orc14Utok2, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Doomhammer, 'O602', gg_snd_WC2Orc14Orgrim11, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    call QueuedTriggerAddBJ(gg_trg_QOTGDiscoveredQ, true)
endfunction

//===========================================================================
function InitTrig_QOTGTriggered takes nothing returns nothing
    set gg_trg_QOTGTriggered=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_QOTGTriggered, gg_rct_HumanCityArea)
    call TriggerAddCondition(gg_trg_QOTGTriggered, Condition(function Trig_QOTGTriggered_Conditions))
    call TriggerAddAction(gg_trg_QOTGTriggered, function Trig_QOTGTriggered_Actions)
endfunction

//===========================================================================
// Trigger: QOTGDiscoveredQ
//===========================================================================
function Trig_QOTGDiscoveredQ_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_QOTGDiscoveredQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetDiscoveredBJ(udg_QOTonsOfGold, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_2863")
    // minimap icons
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_n00Q_0362), bj_CAMPPINGSTYLE_BONUS)
    set udg_QOTGPingIcon[1]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_n00Q_0363), bj_CAMPPINGSTYLE_BONUS)
    set udg_QOTGPingIcon[2]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_n00Q_0364), bj_CAMPPINGSTYLE_BONUS)
    set udg_QOTGPingIcon[3]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_n00Q_0358), bj_CAMPPINGSTYLE_BONUS)
    set udg_QOTGPingIcon[4]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_n00Q_0369), bj_CAMPPINGSTYLE_BONUS)
    set udg_QOTGPingIcon[5]=GetLastCreatedMinimapIcon()
    call TriggerSleepAction(0.50)
    call CampaignMinimapIconLocBJ(GetUnitLoc(gg_unit_n00Q_0365), bj_CAMPPINGSTYLE_BONUS)
    set udg_QOTGPingIcon[6]=GetLastCreatedMinimapIcon()
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_QOTGDiscoveredQ takes nothing returns nothing
    set gg_trg_QOTGDiscoveredQ=CreateTrigger()
    call TriggerAddCondition(gg_trg_QOTGDiscoveredQ, Condition(function Trig_QOTGDiscoveredQ_Conditions))
    call TriggerAddAction(gg_trg_QOTGDiscoveredQ, function Trig_QOTGDiscoveredQ_Actions)
endfunction

