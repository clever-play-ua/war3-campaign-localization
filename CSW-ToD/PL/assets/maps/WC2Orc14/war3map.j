function Trig_AI_P10_Defeat_Condition_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_AIP10DefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P10_Defeat_Condition_Func008001002)), function Trig_AI_P10_Defeat_Condition_Func008A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P10_Defeat_Condition_Func011001002)), function Trig_AI_P10_Defeat_Condition_Func011A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P10_Defeat_Condition_Func014001002)), function Trig_AI_P10_Defeat_Condition_Func014A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P10_Defeat_Condition_Func017001002)), function Trig_AI_P10_Defeat_Condition_Func017A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P10_Defeat_Condition_Func020001002)), function Trig_AI_P10_Defeat_Condition_Func020A)
    // //
    if ( Trig_AI_P10_Defeat_Condition_Func022C() ) then
        // //
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_AI_P10_Gold)
        call DisableTrigger(gg_trg_AI_P10_Lumber)
        // //
        call ConditionalTriggerExecute(gg_trg_AI_P10_Command_Stop_Attack_User_By_Air_Only)
        call ConditionalTriggerExecute(gg_trg_AI_P10_Command_Stop_Attack_User)
        call ConditionalTriggerExecute(gg_trg_AI_P10_Command_Defeat)
        // //
    else
    endif
    // //
    call GroupClear(udg_Group_AIP10DefeatCondition)
    // //
endfunction

