    // //
    call CreateNUnitsAtLoc(1, 'OZaC', udg_Player_DragonMaw, udg_Point_SpawnFakeZuluhed, bj_UNIT_FACING)
    set udg_FakeZuluhed=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeZuluhed)
    call SetUnitMoveSpeed(udg_FakeZuluhed, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeZuluhed, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeZuluhed, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, udg_Point_SpawnFakeUtok, bj_UNIT_FACING)
    set udg_FakeUtok=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'OMBc', udg_Player_BTG, udg_Point_SpawnFakeMaim, bj_UNIT_FACING)
    set udg_FakeMaim=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMaim)
    call SetUnitMoveSpeed(udg_FakeMaim, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeMaim, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeMaim, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'ORFc', udg_Player_BTG, udg_Point_SpawnFakeRend, bj_UNIT_FACING)
    set udg_FakeRend=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeRend)
    call SetUnitMoveSpeed(udg_FakeRend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeRend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeRend, 0.25)
    // //
    call CreateNUnitsAtLoc(1, 'U608', udg_Player_DeathKnights, udg_Point_SpawnFakeTeronDK, bj_UNIT_FACING)
    set udg_FakeGorefiend=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeGorefiend)
    call SetUnitMoveSpeed(udg_FakeGorefiend, 100.00)
    call BlzSetUnitRealFieldBJ(udg_FakeGorefiend, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call SetUnitBlendTimeBJ(udg_FakeGorefiend, 0.65)
    call SetUnitTurnSpeedBJ(udg_FakeGorefiend, 0.25)
