// Trigger: MidgameCleanUp
//===========================================================================
function Trig_MidgameCleanUp_Func008Func001002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_MidgameCleanUp_Func008Func002002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_MidgameCleanUp_Func008C takes nothing returns boolean
    if ( not ( udg_Bool_M13SecretFound == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MidgameCleanUp_Func010002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_MidgameCleanUp_Func011002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_MidgameCleanUp_Func013002 takes nothing returns nothing
    call ResetUnitAnimation(GetEnumUnit())
endfunction

function Trig_MidgameCleanUp_Func039C takes nothing returns boolean
    if ( not ( udg_Bool_CinMidgameSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MidgameCleanUp_Func048C takes nothing returns boolean
    if ( not ( udg_Bool_M13SecretFound == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MidgameCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call StopSoundBJ(gg_snd_TheHorde, true)
    set udg_Bool_CinMidgameOn=false
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(2.00)
    call QueuedTriggerRemoveBJ(gg_trg_MidgameCinematicQ)
    // //
    if ( Trig_MidgameCleanUp_Func008C() ) then
        call DoNothing()
    else
        call ForGroupBJ(udg_Group_Player_CrossIslandGround, function Trig_MidgameCleanUp_Func008Func001002)
        call ForGroupBJ(udg_Group_Player_CrossIslandNaval, function Trig_MidgameCleanUp_Func008Func002002)
    endif
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_MidgameCleanUp_Func010002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_MidgameCleanUp_Func011002)
    call GroupClear(udg_Group_HiddenUnits)
    call ForGroupBJ(udg_Group_OrcBuildings, function Trig_MidgameCleanUp_Func013002)
    call GroupRemoveGroup(udg_Group_OrcBuildings, udg_Group_OrcBuildings)
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_WallpaperDoodadLake)
    call SetDoodadAnimationRectBJ("death", 'DLow', gg_rct_ArrivalCinLightControl)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call ResetUnitAnimation(udg_Unit_PeonArr[GetForLoopIndexA()])
        call AddUnitAnimationPropertiesBJ(false, "lumber", udg_Unit_PeonArr[GetForLoopIndexA()])
        call IssueTargetOrderBJ(udg_Unit_PeonArr[GetForLoopIndexA()], "harvest", gg_unit_n60M_0078)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call UnitRemoveAbilityBJ('A62Y', udg_Unit_PeonArr[4])
    call UnitRemoveBuffBJ('B611', udg_Unit_PeonArr[4])
    call CreateNUnitsAtLoc(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_AdditionalPeons), bj_UNIT_FACING)
    call IssueTargetDestructableOrder(GetLastCreatedUnit(), "harvest", gg_dest_VTlt_1176)
    call CreateNUnitsAtLoc(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_AdditionalPeons), bj_UNIT_FACING)
    call IssueTargetDestructableOrder(GetLastCreatedUnit(), "harvest", gg_dest_VTlt_1295)
    call CreateNUnitsAtLoc(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_AdditionalPeons), bj_UNIT_FACING)
    call IssueTargetDestructableOrder(GetLastCreatedUnit(), "harvest", gg_dest_VTlt_1268)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call RemoveUnit(udg_Unit_CinematicHeadPointer[1])
    call RemoveUnit(udg_Unit_OrcShipArr[1])
    call RemoveUnit(udg_Unit_OrcShipArr[4])
    call RemoveUnit(udg_Unit_OrcShipArr[5])
    // //
    call SetUnitPositionLoc(udg_SemiHero_Utok, GetRandomLocInRect(gg_rct_KnightResetRange01))
    call ShowUnitShow(udg_SemiHero_Utok)
    call SetUnitOwner(udg_SemiHero_Utok, udg_Player_Actual, true)
    call SetUnitBlendTimeBJ(udg_SemiHero_Utok, 0.25)
    // //
    if ( Trig_MidgameCleanUp_Func039C() ) then
        call SetUnitPositionLocFacingBJ(udg_Unit_OrcShipArr[2], GetRectCenter(gg_rct_MidgameShipArrive02), 81.16)
        call SetUnitPositionLocFacingBJ(udg_Unit_OrcShipArr[3], GetRectCenter(gg_rct_MidgameJuggernaurtArrive02), 70.24)
        call SetUnitPositionLocFacingBJ(udg_Unit_OrcShipArr[6], GetRectCenter(gg_rct_MidgameZeppelinArrive01), 62.70)
    else
    endif
    call SetUnitScalePercent(udg_Unit_OrcShipArr[2], 120.00, 120.00, 120.00)
    // //
    call UnitAddItemByIdSwapped('I600', udg_Hero_Doomhammer)
    // //
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    // //
    call QueuedTriggerRemoveBJ(gg_trg_MidgameCinematicQ)
    if ( Trig_MidgameCleanUp_Func048C() ) then
        call ConditionalTriggerExecute(gg_trg_CrossIslandIntroQ)
    else
        call ConditionalTriggerExecute(gg_trg_MidgameContinueLordaeronCleanUp)
    endif
    // //
    // //
endfunction

//===========================================================================
function InitTrig_MidgameCleanUp takes nothing returns nothing
    set gg_trg_MidgameCleanUp=CreateTrigger()
    call TriggerAddAction(gg_trg_MidgameCleanUp, function Trig_MidgameCleanUp_Actions)
endfunction

