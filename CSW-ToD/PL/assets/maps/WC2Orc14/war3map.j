function Trig_TreasureyDestroyed01_Func002C takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_QOTonsOfGold) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TreasureyDestroyed01_Func009Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'YTpc' ) ) then
        return false
    endif
    return true
endfunction

function Trig_TreasureyDestroyed01_Func009A takes nothing returns nothing
    if ( Trig_TreasureyDestroyed01_Func009Func001C() ) then
        call RemoveDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_TreasureyDestroyed01_Func010C takes nothing returns boolean
    if ( not ( IsUnitDeadBJ(gg_unit_n00Q_0362) == true ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(gg_unit_n00Q_0363) == true ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(gg_unit_n00Q_0364) == true ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(gg_unit_n00Q_0358) == true ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(gg_unit_n00Q_0365) == true ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(gg_unit_n00Q_0369) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_QOTGCompleted) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerQueuedBJ(gg_trg_QOTGCompleted) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TreasureyDestroyed01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_TreasureyDestroyed01_Func002C() ) then
        call TriggerExecute(gg_trg_QOTGTriggered)
        call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc14Utok2) + GetSoundDurationBJ(gg_snd_WC2Orc14Orgrim11) ))
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    else
    endif
    call PlaySoundBJ(gg_snd_GoodJob)
    call DestroyMinimapIcon(udg_QOTGPingIcon[1])
    call AddWeatherEffectSaveLast(gg_rct_FogArea05, 'FDwl')
    set udg_Weather_CityFog[5]=GetLastCreatedWeatherEffect()
    call SetDoodadAnimationRectBJ("stand", 'YOtf', gg_rct_Treasury01)
    call SetDoodadAnimationRectBJ("stand", 'YOf3', gg_rct_Treasury01)
    call EnumDestructablesInRectAll(gg_rct_Treasury01, function Trig_TreasureyDestroyed01_Func009A)
    if ( Trig_TreasureyDestroyed01_Func010C() ) then
        call QueuedTriggerAddBJ(gg_trg_QOTGCompleted, true)
    else
    endif
endfunction

