    else
    endif
    call SetPlayerTechResearchedSwap('RUX2', ( GetPlayerTechCountSimple('RUX2', udg_Player_Actual) + 1 ), udg_Player_Actual)
    call ConditionalTriggerExecute(gg_trg_UtokLevelChecker)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

