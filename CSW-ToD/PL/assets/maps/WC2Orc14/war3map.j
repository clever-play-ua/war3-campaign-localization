function Trig_CrossIslandIntroQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    call ConditionalTriggerExecute(gg_trg_CrossIslandIntroSetup)
    call CameraSetupApplyForPlayer(true, gg_cam_CrossIslandIntro01, udg_Player_Actual, 0)
    call TriggerSleepAction(2.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call PlaySoundBJ(gg_snd_CS_ROC_Undead_8_Outro_MX01)
    call TriggerSleepAction(1.00)
    call PlaySoundOnUnitBJ(gg_snd_CS_BG_Camp, 100, udg_Hero_TeronGorefiend)
    call IssuePointOrderLocBJ(udg_FakeGorefiend, "move", GetRectCenter(gg_rct_GorefiendIntroSpeak))
    call IssuePointOrderLocBJ(udg_Unit_IntroCIDK[1], "move", GetRectCenter(gg_rct_DK01))
    call IssuePointOrderLocBJ(udg_Unit_IntroCIDK[2], "move", GetRectCenter(gg_rct_DK02))
    call IssuePointOrderLocBJ(udg_Unit_IntroCIDK[3], "move", GetRectCenter(gg_rct_DK03))
