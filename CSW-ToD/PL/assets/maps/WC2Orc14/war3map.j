function Trig_SpawnUndead01_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(gg_unit_haro_0517) == true ) ) then
        return false
    endif
    if ( not ( IsQuestItemCompleted(udg_QMCrossIslandReq[3]) == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_SkeletonProduceOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SpawnUndead01_Actions takes nothing returns nothing
    local unit SpawnedSkeletonUnit
//
    call CreateNUnitsAtLoc(1, 'u60A', udg_Player_DeathKnights, udg_Point_UndeadSpawn01, GetRandomDirectionDeg())
    set SpawnedSkeletonUnit=GetLastCreatedUnit()
    call SetUnitAnimation(SpawnedSkeletonUnit, "birth")
    call QueueUnitAnimationBJ(SpawnedSkeletonUnit, "stand")
    call TriggerSleepAction(2.33)
    call GroupAddUnitSimple(SpawnedSkeletonUnit, udg_Group_SpawnedSkeletons)
    call IssuePointOrderLocBJ(SpawnedSkeletonUnit, "attack", udg_Point_TempleDKLeft)
//
    call CreateNUnitsAtLoc(1, 'u60A', udg_Player_DeathKnights, udg_Point_UndeadSpawn02, GetRandomDirectionDeg())
    set SpawnedSkeletonUnit=GetLastCreatedUnit()
    call SetUnitAnimation(SpawnedSkeletonUnit, "birth")
    call QueueUnitAnimationBJ(SpawnedSkeletonUnit, "stand")
    call TriggerSleepAction(2.33)
    call GroupAddUnitSimple(SpawnedSkeletonUnit, udg_Group_SpawnedSkeletons)
    call IssuePointOrderLocBJ(SpawnedSkeletonUnit, "attack", udg_Point_TempleDKLeft)
//
    call TriggerSleepAction(GetRandomReal(1.00, 3.00))
//
    call CreateNUnitsAtLoc(1, 'u60A', udg_Player_DeathKnights, udg_Point_UndeadSpawn01, GetRandomDirectionDeg())
    set SpawnedSkeletonUnit=GetLastCreatedUnit()
    call SetUnitAnimation(SpawnedSkeletonUnit, "birth")
    call QueueUnitAnimationBJ(SpawnedSkeletonUnit, "stand")
    call TriggerSleepAction(2.33)
    call GroupAddUnitSimple(SpawnedSkeletonUnit, udg_Group_SpawnedSkeletons)
    call IssuePointOrderLocBJ(SpawnedSkeletonUnit, "attack", udg_Point_TempleDKRight)
//
    call CreateNUnitsAtLoc(1, 'u60A', udg_Player_DeathKnights, udg_Point_UndeadSpawn02, GetRandomDirectionDeg())
    set SpawnedSkeletonUnit=GetLastCreatedUnit()
    call SetUnitAnimation(SpawnedSkeletonUnit, "birth")
    call QueueUnitAnimationBJ(SpawnedSkeletonUnit, "stand")
    call TriggerSleepAction(2.33)
    call GroupAddUnitSimple(SpawnedSkeletonUnit, udg_Group_SpawnedSkeletons)
    call IssuePointOrderLocBJ(SpawnedSkeletonUnit, "attack", udg_Point_TempleDKRight)
//
    call TriggerSleepAction(GetRandomReal(1.00, 3.00))
    call ConditionalTriggerExecute(GetTriggeringTrigger())
endfunction

