    set udg_Point_TempMarineTeleport=GetRandomLocInRect(gg_rct_P10PortalOutGate)
    call SetUnitPositionLoc(GetEnteringUnit(), udg_Point_TempMarineTeleport)
    call RemoveLocation(udg_Point_TempMarineTeleport)
endfunction

