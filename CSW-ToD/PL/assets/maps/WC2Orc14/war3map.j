        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_Unit_OrcShipArr[1], 53.50, 0.50)
    call SetUnitPositionLocFacingLocBJ(udg_FakeMaim, GetRectCenter(gg_rct_MidgameShipSpawn01), GetRectCenter(gg_rct_MidgameMaim02))
    call PlaySoundAtPointBJ(gg_snd_Loading, 50.00, GetRectCenter(gg_rct_MidgameShipSpawn01), 0)
    call IssuePointOrderLocBJ(udg_FakeMaim, "move", GetRectCenter(gg_rct_MidgameMaim02))
    call PlaySoundAtPointBJ(gg_snd_CS_BG_Camp, 100, GetRectCenter(gg_rct_MidgameShipSpawn01), 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitPositionLocFacingLocBJ(udg_FakeRend, GetRectCenter(gg_rct_MidgameShipSpawn01), GetRectCenter(gg_rct_MidgameMaim02))
    call PlaySoundAtPointBJ(gg_snd_Loading01, 50.00, GetRectCenter(gg_rct_MidgameShipSpawn01), 0)
