function Trig_CrossIslandIntroSetup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // ////
    // Environment
    call SetSkyModel("Environment\\Sky\\DalaranSky\\DalaranSky.mdl")
    call SetTerrainFogExBJ(0, 2000.00, 8000.00, 0.50, 90.10, 36.86, 21.56)
    // ////
    call EnumDestructablesInRectAll(gg_rct_CIIntroShipScene, function Trig_CrossIslandIntroSetup_Func008A)
    // SetUpUpgrades
    call SetPlayerTechResearchedSwap('R00T', 3, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R60K', 3, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R00S', 3, udg_Player_Actual)
