//===========================================================================
// Trigger: AI P10 Paladin Transform
//===========================================================================
function Trig_AI_P10_Paladin_Transform_Conditions takes nothing returns boolean
    if ( not ( GetResearched() == 'R015' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P10_Paladin_Transform_Func008001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60L' )
endfunction

function Trig_AI_P10_Paladin_Transform_Func008001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P10_Paladin_Transform_Func008001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h60L'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P10_Paladin_Transform_Func008A takes nothing returns nothing
    set udg_Point_PaladinMorphTemp=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_Point_PaladinMorphTemp, "abilities\\spells\\other\\levelup\\levelupcaster.mdx")
    call ReplaceUnitBJ(GetEnumUnit(), 'h002', bj_UNIT_STATE_METHOD_DEFAULTS)
    set udg_SE_PaladinMorph=GetLastCreatedEffectBJ()
    call DestroyEffectBJ(udg_SE_PaladinMorph)
    call RemoveLocation(udg_Point_PaladinMorphTemp)
endfunction

function Trig_AI_P10_Paladin_Transform_Func011001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'hKAM' )
endfunction

function Trig_AI_P10_Paladin_Transform_Func011001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P10_Paladin_Transform_Func011001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'hKAM'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P10_Paladin_Transform_Func011A takes nothing returns nothing
    set udg_Point_PaladinMorphTemp=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_Point_PaladinMorphTemp, "abilities\\spells\\other\\levelup\\levelupcaster.mdx")
    call ReplaceUnitBJ(GetEnumUnit(), 'hPaM', bj_UNIT_STATE_METHOD_DEFAULTS)
    set udg_SE_PaladinMorph=GetLastCreatedEffectBJ()
    call DestroyEffectBJ(udg_SE_PaladinMorph)
    call RemoveLocation(udg_Point_PaladinMorphTemp)
endfunction

function Trig_AI_P10_Paladin_Transform_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerTechResearchedSwap('RPaM', 1, udg_Player_Lordaeron)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P10_Paladin_Transform_Func008001002)), function Trig_AI_P10_Paladin_Transform_Func008A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Lordaeron, Condition(function Trig_AI_P10_Paladin_Transform_Func011001002)), function Trig_AI_P10_Paladin_Transform_Func011A)
    // //
    call CommandAI(udg_Player_Lordaeron, udg_P10_COMMAND_USE_PALADINS, udg_P10_DATA_USE_PALADINS_ENABLE)
endfunction

//===========================================================================
function InitTrig_AI_P10_Paladin_Transform takes nothing returns nothing
    set gg_trg_AI_P10_Paladin_Transform=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_AI_P10_Paladin_Transform, Player(9), EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_AI_P10_Paladin_Transform, Condition(function Trig_AI_P10_Paladin_Transform_Conditions))
    call TriggerAddAction(gg_trg_AI_P10_Paladin_Transform, function Trig_AI_P10_Paladin_Transform_Actions)
endfunction

