function InitTrig_AI_P15_Oil takes nothing returns nothing
    set gg_trg_AI_P15_Oil=CreateTrigger()
    call DisableTrigger(gg_trg_AI_P15_Oil)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_AI_P15_Oil, udg_Timer_P15Oil)
    call TriggerAddCondition(gg_trg_AI_P15_Oil, Condition(function Trig_AI_P15_Oil_Conditions))
    call TriggerAddAction(gg_trg_AI_P15_Oil, function Trig_AI_P15_Oil_Actions)
