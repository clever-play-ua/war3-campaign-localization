    set udg_FakeUther=GetLastCreatedUnit()
    call SetUnitColor(udg_FakeUther, PLAYER_COLOR_BLUE)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUther)
    call SetUnitBlendTimeBJ(udg_FakeUther, 0.50)
