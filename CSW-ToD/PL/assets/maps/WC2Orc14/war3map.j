function Trig_QMLHCompleted_Conditions takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_QMLordaeronHarbour) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_QMLHCompleted_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_AI_P10_Marines_Teleport_Manual)
    call SetPlayerAbilityAvailableBJ(false, 'Awrp', udg_Player_Lordaeron)
    call UnitRemoveAbilityBJ('Awrp', gg_unit_h613_0154)
    call UnitRemoveAbilityBJ('Awrp', gg_unit_h61C_0092)
    call UnitRemoveAbilityBJ('Awrp', gg_unit_h616_0147)
    call UnitRemoveAbilityBJ('Awrp', gg_unit_h61B_0098)
    call UnitRemoveAbilityBJ('Awrp', gg_unit_h61A_0099)
    call UnitRemoveAbilityBJ('Awrp', gg_unit_h612_0149)
    call QueuedTriggerAddBJ(gg_trg_QMLHCompletedQ, true)
endfunction

