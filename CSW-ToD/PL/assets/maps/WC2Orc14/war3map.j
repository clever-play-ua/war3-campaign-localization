//===========================================================================
// Trigger: NCBarricadeDestroyed
//===========================================================================
function Trig_NCBarricadeDestroyed_Func002C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetDyingDestructable()) == 'LTba' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetDyingDestructable()) == 'LTbs' ) ) then
        return true
    endif
    return false
endfunction

function Trig_NCBarricadeDestroyed_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not Trig_NCBarricadeDestroyed_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_NCBarricadeDestroyed_Func006Func001Func001C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'LTba' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'LTbs' ) ) then
        return true
    endif
    return false
endfunction

function Trig_NCBarricadeDestroyed_Func006Func001C takes nothing returns boolean
    if ( not Trig_NCBarricadeDestroyed_Func006Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_NCBarricadeDestroyed_Func006A takes nothing returns nothing
    if ( Trig_NCBarricadeDestroyed_Func006Func001C() ) then
        call KillDestructable(GetEnumDestructable())
    else
    endif
endfunction

function Trig_NCBarricadeDestroyed_Func007C takes nothing returns boolean
    if ( not ( udg_Bool_OuterCircleBreached == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_NCBarricadeDestroyed_Func012A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_NCBarricadeDestroyed_Actions takes nothing returns nothing
    local effect TeleportSourceEffect
    local effect array TeleportTargetEffect
    call DisableTrigger(GetTriggeringTrigger())
    call EnumDestructablesInRectAll(gg_rct_NCBarricade, function Trig_NCBarricadeDestroyed_Func006A)
    if ( Trig_NCBarricadeDestroyed_Func007C() ) then
        return
    else
        call DoNothing()
    endif
    call ShowDestructableBJ(true, gg_dest_Dofw_12334)
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_NCS01), udg_String_CustomTeleportTo)
    set TeleportSourceEffect=GetLastCreatedEffectBJ()
    call TriggerSleepAction(2.00)
    call ForGroupBJ(udg_Group_CrossIslandDefenders19, function Trig_NCBarricadeDestroyed_Func012A)
    // //
    call AddSpecialEffectTargetUnitBJ("origin", gg_unit_hfDa_1147, udg_String_CustomTeleportTarget)
     set TeleportTargetEffect[1]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectTargetUnitBJ("origin", gg_unit_hfDa_1145, udg_String_CustomTeleportTarget)
     set TeleportTargetEffect[2]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectTargetUnitBJ("origin", gg_unit_hfDa_1146, udg_String_CustomTeleportTarget)
     set TeleportTargetEffect[3]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectTargetUnitBJ("origin", gg_unit_hfDa_1141, udg_String_CustomTeleportTarget)
     set TeleportTargetEffect[4]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectTargetUnitBJ("origin", gg_unit_hfDa_1143, udg_String_CustomTeleportTarget)
     set TeleportTargetEffect[5]=GetLastCreatedEffectBJ()
    // //
    call AddSpecialEffectTargetUnitBJ("origin", gg_unit_hfDa_1142, udg_String_CustomTeleportTarget)
     set TeleportTargetEffect[6]=GetLastCreatedEffectBJ()
    // //
    call TriggerSleepAction(1.00)
    call DestroyEffectBJ(TeleportSourceEffect)
    // ///
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
    call DestroyEffectBJ(TeleportTargetEffect[GetForLoopIndexA()])
    set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // ///
    call EnableTrigger(gg_trg_NCSquad01Killed)
endfunction

//===========================================================================
function InitTrig_NCBarricadeDestroyed takes nothing returns nothing
    set gg_trg_NCBarricadeDestroyed=CreateTrigger()
    call TriggerRegisterDestDeathInRegionEvent(gg_trg_NCBarricadeDestroyed, gg_rct_NCBarricade)
    call TriggerAddCondition(gg_trg_NCBarricadeDestroyed, Condition(function Trig_NCBarricadeDestroyed_Conditions))
    call TriggerAddAction(gg_trg_NCBarricadeDestroyed, function Trig_NCBarricadeDestroyed_Actions)
endfunction

