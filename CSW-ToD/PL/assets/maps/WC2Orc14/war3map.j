    call SetPlayerTechResearchedSwap('R60K', 3, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R601', 3, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R008', 3, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R00V', 1, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R003', 2, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R001', 3, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R00M', 1, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('RBOo', 1, udg_Player_Actual)
    // SetUpForces
    call SetUnitPositionLoc(udg_SemiHero_Utok, GetRectCenter(gg_rct_CIUtokLoad))
