//===========================================================================
// Trigger: Tharbek I Whiplash
//===========================================================================
function Trig_Tharbek_I_Whiplash_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AT3O' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tharbek_I_Whiplash_Actions takes nothing returns nothing
    call PlaySoundAtPointBJ(gg_snd_Ability_Whiplash, 100, GetUnitLoc(GetSpellAbilityUnit()), 0)
    // //
    set udg_Tharbek_TempPoint_E=GetSpellTargetLoc()
    // Dummy (Spells)
    call CreateNUnitsAtLoc(1, 'u003', GetOwningPlayer(GetTriggerUnit()), udg_Tharbek_TempPoint_E, bj_UNIT_FACING)
    set udg_Tharbek_Dummy_E=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_Tharbek_Dummy_E)
    // //
    // Ability: Whiplash Buff
    // //
    call UnitAddAbilityBJ('AT4O', udg_Tharbek_Dummy_E)
    // //
    call IssueImmediateOrderById(udg_Tharbek_Dummy_E, 852285)
    // //
    call UnitRemoveAbilityBJ('AT4O', udg_Tharbek_Dummy_E)
    // //
    // Ability: Whiplash DeBuff
    // //
    call UnitAddAbilityBJ('AT5O', udg_Tharbek_Dummy_E)
    // //
    call IssueImmediateOrderById(udg_Tharbek_Dummy_E, 852285)
    // //
    call UnitRemoveAbilityBJ('AT5O', udg_Tharbek_Dummy_E)
    //  
    call RemoveLocation(udg_Tharbek_TempPoint_E)
endfunction

//===========================================================================
function InitTrig_Tharbek_I_Whiplash takes nothing returns nothing
    set gg_trg_Tharbek_I_Whiplash=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Tharbek_I_Whiplash, EVENT_PLAYER_UNIT_SPELL_EFFECT)
