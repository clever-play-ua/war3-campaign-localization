//===========================================================================
// Trigger: IntroDialogue
//===========================================================================
function Trig_IntroDialogue_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_IntroDialogue_Func008001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_IntroDialogue_Func016001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_IntroDialogue_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_IntroTharbekCloseUp, udg_Player_Actual, 0.00)
    // ///
    call SetUnitAnimation(udg_FakeTharbek, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc14Tharbek1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // ///
    call CameraSetupApplyForPlayer(true, gg_cam_Intro06, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro05, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc14Orgrim1))
    // ///
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc14Orgrim1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // ///
    // ///
endfunction

