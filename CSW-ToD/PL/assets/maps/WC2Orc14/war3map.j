//===========================================================================
// Trigger: QMCrossIslandDiscoveredQ
//===========================================================================
function Trig_QMCrossIslandDiscoveredQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call AddWeatherEffectSaveLast(gg_rct_CrossIslandInvoulnerableZone01, 'MEds')
    set udg_Weather_DalaranShield01=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_DalaranShield01, true)
    // //
    call AddWeatherEffectSaveLast(gg_rct_CrossIslandInvoulnerableZone02, 'MEds')
    set udg_Weather_DalaranShield02=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_DalaranShield02, true)
    // //
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_3995", "TRIGSTR_3996", "ReplaceableTextures\\CommandButtons\\BTNArcaneObservatory.blp")
    set udg_QMCrossIsland=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_QMCrossIsland, "TRIGSTR_3997")
    set udg_QMCrossIslandReq[1]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMCrossIsland, "TRIGSTR_3998")
    set udg_QMCrossIslandReq[2]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMCrossIsland, "TRIGSTR_3999")
    set udg_QMCrossIslandReq[3]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMCrossIsland, "TRIGSTR_4000")
    set udg_QMCrossIslandReq[4]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMCrossIsland, "TRIGSTR_4001")
    set udg_QMCrossIslandReq[5]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_QMCrossIsland, "TRIGSTR_4002")
    set udg_QMCrossIslandReq[6]=GetLastCreatedQuestItemBJ()
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_4003")
    // ***
    call CampaignMinimapIconUnitBJ(gg_unit_haro_0515, bj_CAMPPINGSTYLE_BONUS)
    set udg_QMCIObservatory[1]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(gg_unit_haro_0512, bj_CAMPPINGSTYLE_BONUS)
    set udg_QMCIObservatory[2]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(gg_unit_haro_0510, bj_CAMPPINGSTYLE_BONUS)
    set udg_QMCIObservatory[3]=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(gg_unit_h61P_0537, bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_QMCIVioletCitadel=GetLastCreatedMinimapIcon()
    call CampaignMinimapIconUnitBJ(gg_unit_Hamg_0508, bj_CAMPPINGSTYLE_BOSS)
    set udg_QMCIMage=GetLastCreatedMinimapIcon()
    call EnableTrigger(gg_trg_QMCIObservatoriesDestroyedShieldOff)
    // ***
    call CreateLeaderboardBJ(udg_PlayerGroup_PlayerActual, "TRIGSTR_4004")
    set udg_Leaderboard_Observatories=GetLastCreatedLeaderboard()
    call LeaderboardAddItemBJ(Player(15), udg_Leaderboard_Observatories, "TRIGSTR_4005", udg_Int_ObservatoriesDestroyed)
    call LeaderboardDisplayBJ(true, udg_Leaderboard_Observatories)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

