function InitSounds takes nothing returns nothing
    set gg_snd_Ability_Devastate=CreateSound("_HD.w3mod/Abilities/Spells/Orc/RendSpells/Ability_Devastate.mp3", false, true, true, 1, 1, "SpellsEAX")
    call SetSoundDuration(gg_snd_Ability_Devastate, 2011)
    call SetSoundChannel(gg_snd_Ability_Devastate, 0)
    call SetSoundVolume(gg_snd_Ability_Devastate, 127)
    call SetSoundPitch(gg_snd_Ability_Devastate, 1.0)
    call SetSoundDistances(gg_snd_Ability_Devastate, 600.0, 2600.0)
    call SetSoundDistanceCutoff(gg_snd_Ability_Devastate, 2100.0)
    call SetSoundConeAngles(gg_snd_Ability_Devastate, 0.0, 0.0, 127)
    call SetSoundConeOrientation(gg_snd_Ability_Devastate, 0.0, 0.0, 0.0)
    set gg_snd_Ability_EarthShield=CreateSound("_HD.w3mod/Abilities/Spells/Orc/ZuluhedSpells/Ability_EarthShield.mp3", false, true, false, 1, 1, "CombatSoundsEAX")
