//===========================================================================
function Trig_CrossIslandIntroCleanUp_Func019002 takes nothing returns nothing
    call RemoveDestructable(GetEnumDestructable())
endfunction

function Trig_CrossIslandIntroCleanUp_Func021002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_CrossIslandIntroCleanUp_Func041C takes nothing returns boolean
    if ( not ( udg_Bool_CinCrossIslandInSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_CrossIslandIntroCleanUp_Func045002 takes nothing returns nothing
    call IssueImmediateOrderBJ(GetEnumUnit(), "raisedeadon")
endfunction

function Trig_CrossIslandIntroCleanUp_Func062002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_CrossIslandIntroCleanUp_Func064002 takes nothing returns nothing
    call SetUnitOwner(GetEnumUnit(), Player(12), false)
endfunction

function Trig_CrossIslandIntroCleanUp_Func078001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_CrossIslandIntroCleanUp_Func078001002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) != 'n60H' )
endfunction

function Trig_CrossIslandIntroCleanUp_Func078001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetUnitTypeId(GetFilterUnit()) != 'n60H')) // INLINED!!
endfunction

function Trig_CrossIslandIntroCleanUp_Func078A takes nothing returns nothing
    call SelectUnitAdd(GetEnumUnit())
endfunction

function Trig_CrossIslandIntroCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    set udg_Bool_CinCrossIslandInOn=false
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call CameraSetupApplyForPlayer(true, gg_cam_CrossIslandStart, udg_Player_Actual, 0)
    call StopSoundBJ(gg_snd_CS_ROC_Undead_8_Outro_MX01, false)
    call StopSoundBJ(gg_snd_Doom, false)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0759, GetRectCenter(gg_rct_CITransport04), bj_UNIT_FACING)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0703, GetRectCenter(gg_rct_CITransport03), bj_UNIT_FACING)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0699, GetRectCenter(gg_rct_CITransport02), bj_UNIT_FACING)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_0698, GetRectCenter(gg_rct_CITransport01), bj_UNIT_FACING)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_1326, GetRectCenter(gg_rct_CITransport05), bj_UNIT_FACING)
    call SetUnitPositionLocFacingBJ(gg_unit_o60Q_1325, GetRectCenter(gg_rct_CITransport06), bj_UNIT_FACING)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    // RemoveShip
    call EnumDestructablesInRectAll(gg_rct_CIIntroShipScene, function Trig_CrossIslandIntroCleanUp_Func019002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_CIIntroShipScene), function Trig_CrossIslandIntroCleanUp_Func021002)
    // //
    call SetDoodadAnimationRectBJ("death", 'D64K', gg_rct_AnotherFakeMountain)
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_EnemyArchmage, GetRectCenter(gg_rct_CrossIslandArchmageDefault), 225.00)
    call SetUnitVertexColorBJ(udg_Hero_EnemyArchmage, 100, 100, 100, 0.00)
    call PauseUnitBJ(true, udg_Hero_EnemyArchmage)
    // //
    call ShowUnitShow(udg_Hero_TeronGorefiend)
    call PauseUnitBJ(false, udg_Hero_TeronGorefiend)
    call SetUnitPositionLoc(udg_Hero_TeronGorefiend, GetRectCenter(gg_rct_GorefiendIntroSpeak))
    call BlzSetUnitRealFieldBJ(udg_Hero_TeronGorefiend, UNIT_RF_ANIMATION_WALK_SPEED, 320.00)
    call SetHeroLevelBJ(udg_Hero_TeronGorefiend, 5, false)
    call SelectHeroSkill(udg_Hero_TeronGorefiend, 'AUdc')
    call SelectHeroSkill(udg_Hero_TeronGorefiend, 'AUdc')
    call SelectHeroSkill(udg_Hero_TeronGorefiend, 'A60U')
    call SelectHeroSkill(udg_Hero_TeronGorefiend, 'A60U')
    call SelectHeroSkill(udg_Hero_TeronGorefiend, 'AUau')
    call SetUnitAnimation(udg_Hero_TeronGorefiend, "Stand Channel")
    call SuspendHeroXPBJ(false, udg_Hero_TeronGorefiend)
    if ( Trig_CrossIslandIntroCleanUp_Func041C() ) then
        call KillDestructable(gg_dest_DTs0_14755)
        call SetDoodadAnimationRectBJ("stand", 'D00D', gg_rct_MagicalBridge)
        // //
        call DestroyEffectBJ(udg_SE_ZuluhedFarSeerEffect)
        call DestroyEffectBJ(udg_SE_ZuluhedFarSeerEffectTarget)
        call DestroyEffectBJ(udg_SE_BoneBridgeBirth)
        call DestroyEffectBJ(udg_SE_CiIntroMageTeleportArr[1])
        call DestroyEffectBJ(udg_SE_CiIntroMageTeleportArr[2])
        call DestroyEffectBJ(udg_SE_ForceBridgeDestroy)
        call DestroyEffectBJ(udg_SE_ZuluhedFarSeerEffect)
        call DestroyEffectBJ(udg_SE_ZuluhedFarSeerEffectTarget)
        // //
        call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_CorpseGenerator01), "Abilities\\Spells\\Undead\\Darksummoning\\DarkSummonTarget.mdl")
        set udg_SE_UndeadSpawnArr[1]=GetLastCreatedEffectBJ()
        call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_CorpseGenerator02), "Abilities\\Spells\\Undead\\Darksummoning\\DarkSummonTarget.mdl")
        set udg_SE_UndeadSpawnArr[2]=GetLastCreatedEffectBJ()
        // //
        call EnableTrigger(gg_trg_SkeletonGroupCheckAttackState)
        // //
        call SetUnitPositionLocFacingBJ(udg_Hero_TeronGorefiend, GetRectCenter(gg_rct_GorefiendIntroSpeak), 90.00)
        call SetUnitPositionLocFacingBJ(udg_Unit_IntroCIDK[1], GetRectCenter(gg_rct_DK01), 90.00)
        call SetUnitPositionLocFacingBJ(udg_Unit_IntroCIDK[2], GetRectCenter(gg_rct_DK02), 90.00)
        call SetUnitPositionLocFacingBJ(udg_Unit_IntroCIDK[3], GetRectCenter(gg_rct_DK03), 90.00)
        call SetUnitPositionLocFacingBJ(udg_Unit_IntroCIDK[4], GetRectCenter(gg_rct_DK04), 90.00)
        call SetUnitPositionLocFacingBJ(udg_Unit_IntroCIDK[5], GetRectCenter(gg_rct_DK05), 90.00)
        call SetUnitPositionLocFacingBJ(udg_Unit_IntroCIDK[6], GetRectCenter(gg_rct_DK06), 90.00)
        call SetUnitPositionLocFacingBJ(udg_Unit_IntroCIDK[7], GetRectCenter(gg_rct_DK07), 90.00)
        call SetUnitPositionLocFacingBJ(udg_Unit_IntroCIDK[8], GetRectCenter(gg_rct_DK08), 90.00)
    else
    endif
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=8
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call AddUnitAnimationPropertiesBJ(false, "cinematic", udg_Unit_IntroCIDK[GetForLoopIndexB()])
        call SetUnitMoveSpeed(udg_Unit_IntroCIDK[GetForLoopIndexB()], 320.00)
        call BlzSetUnitRealFieldBJ(udg_Unit_IntroCIDK[GetForLoopIndexB()], UNIT_RF_ANIMATION_WALK_SPEED, 380.00)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    call ForGroupBJ(udg_Group_IntroCIDeathKnights, function Trig_CrossIslandIntroCleanUp_Func045002)
    // //
    set udg_Real_FogMin=3000.00
    set udg_Real_FogMax=12500.00
    set udg_Real_FogColorR=90.10
    set udg_Real_FogColorG=36.86
    set udg_Real_FogColorB=21.56
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, udg_Real_FogColorR, udg_Real_FogColorG, udg_Real_FogColorB)
    // //
    call SetPlayerTechResearchedSwap('R00V', 1, udg_Player_DeathKnights)
    call SetPlayerTechResearchedSwap('R001', 3, udg_Player_DeathKnights)
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_CameraBounds03)
    call BlzChangeMinimapTerrainTex("Mission14MapCrossIsland.tga")
    call SetUnitOwner(udg_Hero_Doomhammer, udg_Player_Blackrock, true)
    call SuspendHeroXPBJ(false, udg_Hero_Doomhammer)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'o61X'), function Trig_CrossIslandIntroCleanUp_Func062002)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'o61X'), function Trig_CrossIslandIntroCleanUp_Func064002)
    call SetUnitOwner(udg_Hero_Rend, udg_Player_Actual, false)
    call SetUnitOwner(udg_Hero_Zuluhed, udg_Player_Actual, false)
    call SetUnitOwner(udg_Hero_Maim, udg_Player_Actual, false)
    call SetUnitOwner(udg_SemiHero_Utok, udg_Player_Actual, false)
    call TriggerSleepAction(0.50)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(false, GetPlayersAll())
    // Generic cinematic cleanup is not used in order to not mangle with selected groups in lordaeron area
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    call FogMaskEnableOff()
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CIPlayerStartLocation, Condition(function Trig_CrossIslandIntroCleanUp_Func078001002)), function Trig_CrossIslandIntroCleanUp_Func078A)
    call TriggerSleepAction(1.00)
    set udg_Sting_CheckpointPhase="CrossIslandIntermission"
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    call QueuedTriggerAddBJ(gg_trg_QMCrossIslandDiscoveredQ, true)
    call EnableTrigger(gg_trg_CISouthernGuardKilled)
endfunction

