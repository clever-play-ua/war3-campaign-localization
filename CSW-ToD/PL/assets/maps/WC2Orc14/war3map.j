//===========================================================================
function Trig_DebugUtokTransportSearch_Conditions takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[GetUnitUserData(udg_CargoTransportUnit[udg_UDex])] == 'o60Q' ) ) then
        return false
    endif
    if ( not ( udg_UnitTypeOf[udg_UDex] == 'o605' ) ) then
        return false
    endif
    return true
endfunction

function Trig_DebugUtokTransportSearch_Actions takes nothing returns nothing
    set udg_U_UtokShip=udg_CargoTransportUnit[udg_UDex]
endfunction

//===========================================================================
function InitTrig_DebugUtokTransportSearch takes nothing returns nothing
    set gg_trg_DebugUtokTransportSearch=CreateTrigger()
    call TriggerRegisterVariableEvent(gg_trg_DebugUtokTransportSearch, "udg_CargoEvent", EQUAL, 1.00)
    call TriggerAddCondition(gg_trg_DebugUtokTransportSearch, Condition(function Trig_DebugUtokTransportSearch_Conditions))
    call TriggerAddAction(gg_trg_DebugUtokTransportSearch, function Trig_DebugUtokTransportSearch_Actions)
endfunction

//===========================================================================
// Trigger: DebugUtokTransportNullify
//===========================================================================
function Trig_DebugUtokTransportNullify_Conditions takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[GetUnitUserData(udg_CargoTransportUnit[udg_UDex])] == 'o60Q' ) ) then
        return false
    endif
    if ( not ( udg_UnitTypeOf[udg_UDex] == 'o605' ) ) then
        return false
    endif
    if ( not ( udg_CargoTransportUnit[udg_UDex] == udg_U_UtokShip ) ) then
        return false
    endif
    return true
endfunction

