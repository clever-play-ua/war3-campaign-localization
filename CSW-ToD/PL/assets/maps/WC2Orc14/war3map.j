function Trig_MidgameContinueLordaeronQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetTerrainFogExBJ(0, 1500.00, 6500.00, 0.50, 32.90, 52.90, 73.72)
    call SetSkyModel("Environment\\Sky\\LordaeronSummerSky\\LordaeronSummerSky.mdl")
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, GetCameraBoundsMapRect())
    call CameraSetupApplyForPlayer(true, gg_cam_DoomhammerRecievesReports, udg_Player_Actual, 0)
    // //
    call CreateNUnitsAtLoc(1, 'n00L', udg_Player_Actual, GetRectCenter(gg_rct_OrgrimsHEadRotate02), 270.00)
    set udg_Unit_CinematicHeadPointer[2]=GetLastCreatedUnit()
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeDoomhammer, GetRectCenter(gg_rct_DoomhammerAlternateMidgame01), 235.00)
    call UnitAddItemByIdSwapped('ICBI', udg_FakeDoomhammer)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeTharbek, GetRectCenter(gg_rct_TharbekAlternateMidgame01), 45.00)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_UtokAlternateMidgame01), 90.00)
    // //
    call IssuePointOrderLocBJ(udg_FakeTharbek, "move", GetRectCenter(gg_rct_TharbekAlternateMidgame02))
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 4.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(4.00)
    call CameraSetupApplyForPlayer(true, gg_cam_DoomhammerRecievesReports02, udg_Player_Actual, 5.00)
    // //
    // CinematicStarted
    set udg_Bool_CinContinueToLordaeronOn=true
    // //
    call SetUnitLookAt(udg_FakeDoomhammer, "bone_head", udg_Unit_CinematicHeadPointer[2], 0, 0, 0.00)
    // //
    set udg_Point_CinematicTharbekTemp=GetUnitLoc(udg_FakeTharbek)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_CinematicTharbekTemp, GetRectCenter(gg_rct_TharbekAlternateMidgame02)) / GetUnitMoveSpeed(udg_FakeTharbek) ))
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeTharbek, udg_FakeDoomhammer, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeTharbek, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTharbek, 0, gg_snd_WC2Orc14Tharbek3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeTharbek, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc14Orgrim13, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitLookAt(udg_FakeDoomhammer, "bone_head", udg_FakeUtok, 0, 0, 90)
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_UtokAlternateMidgame02))
    call SetUnitFacingToFaceLocTimed(udg_FakeDoomhammer, GetRectCenter(gg_rct_UtokAlternateMidgame02), 1.50)
    call SetUnitFacingToFaceLocTimed(udg_FakeTharbek, GetRectCenter(gg_rct_UtokAlternateMidgame02), 1.50)
    set udg_Point_CinUtokTemp=GetUnitLoc(udg_FakeUtok)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_CinUtokTemp, GetRectCenter(gg_rct_UtokAlternateMidgame02)) / GetUnitMoveSpeed(udg_FakeUtok) ))
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeUtok, udg_FakeDoomhammer, 0.50)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc14Utok7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeUtok, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic proud one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc14Orgrim14, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic point two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc14Orgrim9, bj_TIMETYPE_ADD, 0, false)
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard one")
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitTimeScalePercent(udg_FakeDoomhammer, 50.00)
    call SetUnitAnimation(udg_FakeDoomhammer, "stand victory")
    // //
    call SetUnitAnimation(udg_FakeUtok, "cinematic salute one")
    call PlaySoundOnUnitBJ(gg_snd_CS_H01b_Orc_gesture_v2, 80.00, udg_SemiHero_Utok)
    call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    // //
    call TriggerSleepAction(4.00)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    if ( (udg_Bool_CinContinueSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_MidgameContinueLordaeronCleanUp)
endfunction

