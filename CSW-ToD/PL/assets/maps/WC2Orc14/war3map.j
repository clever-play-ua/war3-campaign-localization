//===========================================================================
function Trig_Glittering_Prizes_Actions takes nothing returns nothing
    call AdjustPlayerStateBJ(5000, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(5000, udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER)
    call playerAddOil(Player(0) , 5000)
    call TriggerSleepAction(1.00)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_SECRET, "TRIGSTR_2750")
endfunction

