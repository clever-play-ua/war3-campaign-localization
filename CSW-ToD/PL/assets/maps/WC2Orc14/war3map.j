    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_VictoryCinematicQ_Func080A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_VictoryCinematicQ_Func098001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_VictoryCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicSetUp)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_VictorySetup)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final01, udg_Player_Actual, 0)
    // //
    call CameraSetFocalDistance(450.00)
    call CameraSetDepthOfFieldScale(150.00)
    call CameraSetTargetNoiseForPlayer(udg_Player_Actual, 1.00, 0.25)
    call TriggerSleepAction(1.00)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    // Cinematic started and can be skipped now
    set udg_Bool_CinOutroOn=true
    // //
    // Ship
    // //
    call PlaySoundBJ(gg_snd_DarkVictory)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final02, udg_Player_Actual, 10.00)
    // //
    call IssuePointOrderLocBJ(udg_FakeDoomhammer, "move", GetRectCenter(gg_rct_DoomhammerFinal02))
    set udg_Point_OutroDoomhammerLoc=GetUnitLoc(udg_FakeDoomhammer)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_OutroDoomhammerLoc, GetRectCenter(gg_rct_DoomhammerFinal02)) / GetUnitMoveSpeed(udg_FakeDoomhammer) ))
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeDoomhammer, "move", GetRectCenter(gg_rct_DoomhammerFinal03))
    set udg_Point_OutroDoomhammerLoc=GetUnitLoc(udg_FakeDoomhammer)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_OutroDoomhammerLoc, GetRectCenter(gg_rct_DoomhammerFinal03)) / GetUnitMoveSpeed(udg_FakeDoomhammer) ))
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingTimed(udg_FakeDoomhammer, bj_UNIT_FACING, 0.25)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_FinalOrgrimCloseUp01, udg_Player_Actual, 0.00)
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_FinalOrgrimCloseUp02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc14Orgrim12))
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc14Orgrim12, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitTimeScalePercent(udg_FakeDoomhammer, 50.00)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic proud one")
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetFocalDistance(450.00)
    call CameraSetDepthOfFieldScale(150.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Final02, udg_Player_Actual, 0.00)
    // //
    call PlaySoundBJ(gg_snd_OrcVictoryShouting)
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[1], "stand victory")
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[2], "stand victory")
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[3], "stand victory")
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[4], "stand victory")
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[5], "stand victory")
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // City
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call SetTerrainFogExBJ(0, 4000.00, 12000.00, 0.50, 71.00, 56.00, 29.80)
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final03, udg_Player_Actual, 0)
    // //
    call CameraSetFocalDistance(0.00)
    call CameraSetDepthOfFieldScale(0.00)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_VictoryCinematicQ_Func080A)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    // //
    call IssuePointOrderLocBJ(udg_Unit_OutroProjectileShooterArr[1], "attackground", GetRectCenter(gg_rct_FinalCinDestruction05))
    call IssuePointOrderLocBJ(udg_Unit_OutroProjectileShooterArr[2], "attackground", GetRectCenter(gg_rct_FinalCinDestruction02))
    call IssuePointOrderLocBJ(udg_Unit_OutroProjectileShooterArr[3], "attackground", GetRectCenter(gg_rct_FinalCinDestruction05))
    call IssuePointOrderLocBJ(udg_Unit_OutroProjectileShooterArr[4], "attackground", GetRectCenter(gg_rct_FinalCinDestruction03))
    call IssuePointOrderLocBJ(udg_Unit_OutroProjectileShooterArr[5], "attackground", GetRectCenter(gg_rct_FinalCinDestruction04))
    call IssuePointOrderLocBJ(udg_Unit_OutroProjectileShooterArr[6], "attackground", GetRectCenter(gg_rct_FinalCinDestruction02))
    call IssuePointOrderLocBJ(udg_Unit_OutroProjectileShooterArr[7], "attackground", GetRectCenter(gg_rct_FinalCinDestruction05))
    call IssuePointOrderLocBJ(udg_Unit_OutroProjectileShooterArr[8], "attackground", GetRectCenter(gg_rct_FinalCinDestruction03))
    call IssuePointOrderLocBJ(udg_Unit_OutroProjectileShooterArr[9], "attackground", GetRectCenter(gg_rct_FinalCinDestruction01))
    // //
    call PlaySoundAtPointBJ(gg_snd_CityBattlegroundLoop, 80.00, GetRectCenter(gg_rct_HardourAreaCinematic), 0)
    call ConditionalTriggerExecute(gg_trg_VictoryTowerFalls)
    // //
    call TriggerSleepAction(20.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_NextLevelPrep)
endfunction

