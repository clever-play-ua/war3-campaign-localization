function Trig_VictorySetup_Func014A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_VictorySetup_Func016A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_VictorySetup_Func021A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_VictorySetup_Func023A takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_VictorySetup_Func027A takes nothing returns nothing
    call ShowDestructableBJ(true, GetEnumDestructable())
endfunction

function Trig_VictorySetup_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // Set Sky
    call SetSkyModel("Environment\\Sky\\LordaeronFallSky\\LordaeronFallSky.mdl")
    // Set Fog
    call SetTerrainFogExBJ(0, 2000.00, 6000.00, 0.50, 71.00, 56.00, 29.80)
    // Pause Time Of Day
    call SetTimeOfDay(19.00)
    call UseTimeOfDayBJ(false)
    call SetCameraBoundsToRectForPlayerBJ(Player(0), GetCameraBoundsMapRect())
    call SetDoodadAnimationRectBJ("stand", 'D64K', gg_rct_Wallpaper)
    call SetDoodadAnimationRectBJ("stand", 'D64K', gg_rct_FinalCinWallpaperLake)
    // Pause Units
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_VictorySetup_Func014A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Lordaeron), function Trig_VictorySetup_Func016A)
    // Set up Actors
    // //
    call GroupClear(udg_Group_HiddenUnits)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_PASSIVE)), function Trig_VictorySetup_Func021A)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_VictorySetup_Func023A)
    // //
    call ShowUnitShow(gg_unit_o001_0303)
    call SetUnitTimeScalePercent(gg_unit_o001_0303, 20.00)
    call EnumDestructablesInRectAll(gg_rct_FinalCinDoodadsShip, function Trig_VictorySetup_Func027A)
    // //
    call CreateNUnitsAtLoc(1, 'n02P', udg_Player_Actual, GetRectCenter(gg_rct_DoomhammerFinal01), 270.00)
    set udg_FakeDoomhammer=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeDoomhammer)
    call SetUnitMoveSpeed(udg_FakeDoomhammer, 40.00)
    call BlzSetUnitRealFieldBJ(udg_FakeDoomhammer, UNIT_RF_ANIMATION_WALK_SPEED, 80.00)
    call SetUnitBlendTimeBJ(udg_FakeDoomhammer, 0.50)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call CreateNUnitsAtLoc(1, 'n02J', udg_Player_Actual, GetRectCenter(gg_rct_UtokFinal02), 225.00)
    set udg_FakeUtok=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.50)
    call SetUnitAnimation(udg_FakeUtok, "cinematic writing one")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02M', udg_Player_Blackrock, GetRectCenter(gg_rct_Korkron04), GetRectCenter(gg_rct_DoomhammerFinal03))
    set udg_Unit_OutroGruntCinArr[1]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[1], "cinematic listening one")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02M', udg_Player_Blackrock, GetRectCenter(gg_rct_Korkron03), GetRectCenter(gg_rct_DoomhammerFinal03))
    set udg_Unit_OutroGruntCinArr[2]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[2], "cinematic listening one")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02M', udg_Player_Blackrock, GetRectCenter(gg_rct_Korkron02), GetRectCenter(gg_rct_DoomhammerFinal03))
    set udg_Unit_OutroGruntCinArr[3]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[3], "cinematic listening one")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02M', udg_Player_Blackrock, GetRectCenter(gg_rct_Korkron01), GetRectCenter(gg_rct_DoomhammerFinal03))
    set udg_Unit_OutroGruntCinArr[4]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[4], "cinematic listening one")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02O', udg_Player_Blackrock, GetRectCenter(gg_rct_OutroBlackrockGrunt01), GetRectCenter(gg_rct_DoomhammerFinal03))
    set udg_Unit_OutroGruntCinArr[5]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_OutroGruntCinArr[5], "cinematic listening one")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02K', udg_Player_Blackrock, GetRectCenter(gg_rct_SailorScrubs), GetRectCenter(gg_rct_Korkron04))
    set udg_Unit_OutroPirate=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_OutroPirate, "cinematic scrub one")
    // //
    call CreateNUnitsAtLoc(1, 'o60S', udg_Player_Blackrock, GetRectCenter(gg_rct_CinOutroJuggernaurt01), 90.00)
    set udg_Unit_OutroCinShipArr[1]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'uCDX', udg_Player_Blackrock, GetRectCenter(gg_rct_CinOutroJuggernaurt01), 90.00)
    set udg_Unit_OutroProjectileShooterArr[1]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'o60S', udg_Player_Blackrock, GetRectCenter(gg_rct_CinOutroJuggernaurt02), 90.00)
    set udg_Unit_OutroCinShipArr[2]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'uCDX', udg_Player_Blackrock, GetRectCenter(gg_rct_CinOutroJuggernaurt02), 90.00)
    set udg_Unit_OutroProjectileShooterArr[2]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'o60S', udg_Player_Blackrock, GetRectCenter(gg_rct_CinOutroJuggernaurt03), 90.00)
    set udg_Unit_OutroCinShipArr[3]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'uCDX', udg_Player_Blackrock, GetRectCenter(gg_rct_CinOutroJuggernaurt03), 90.00)
