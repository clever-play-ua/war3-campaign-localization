//===========================================================================
// Trigger: AI P10 Start
//===========================================================================
function Trig_AI_P10_Start_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call AdjustPlayerStateBJ(200000, udg_Player_Lordaeron, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(200000, udg_Player_Lordaeron, PLAYER_STATE_RESOURCE_LUMBER)
    call SetPlayerStateBJ(udg_Player_Lordaeron, PLAYER_STATE_FOOD_CAP_CEILING, 300)
    call SetPlayerStateBJ(udg_Player_LordaeronNaval, PLAYER_STATE_RESOURCE_FOOD_CAP, 300)
    // //
    call EnableTrigger(gg_trg_AI_P10_Gold)
    call EnableTrigger(gg_trg_AI_P10_Lumber)
    // //
    call SetUnitPositionLoc(udg_Hero_Uther, GetRectCenter(gg_rct_WaygateForUtherFromKeepToTownHall))
    call ShowUnitShow(udg_Hero_Uther)
    call PauseUnitBJ(false, udg_Hero_Uther)
    // //
    call ConditionalTriggerExecute(gg_trg_P10TransportationConfig)
    // //
    call StartCampaignAI(udg_Player_Lordaeron, "CSW\\Scripts\\ToDScripts\\WC2Orc14\\WC2Orc14P10LordaeronAI.ai")
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P10_Command_Start_Attack_User)
endfunction

//===========================================================================
function InitTrig_AI_P10_Start takes nothing returns nothing
    set gg_trg_AI_P10_Start=CreateTrigger()
    call TriggerAddAction(gg_trg_AI_P10_Start, function Trig_AI_P10_Start_Actions)
endfunction

