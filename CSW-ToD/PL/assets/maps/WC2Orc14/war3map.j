function Trig_MuradinTaunt_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_ChanceMuradinTaunt=GetRandomInt(1, 8)
    call SetSpeechVolumeGroupsBJ()
    if ( Trig_MuradinTaunt_Func004C() ) then
        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_Hmbr_0310, 'Hmbr', gg_snd_MuradinYesAttack1, bj_TIMETYPE_ADD, 0, true)
    else
        if ( Trig_MuradinTaunt_Func004Func003C() ) then
            call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_Hmbr_0310, 'Hmbr', gg_snd_MuradinYesAttack2, bj_TIMETYPE_ADD, 0, true)
        else
            if ( Trig_MuradinTaunt_Func004Func003Func003C() ) then
                call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_Hmbr_0310, 'Hmbr', gg_snd_MuradinYesAttack3, bj_TIMETYPE_ADD, 0, true)
            else
                if ( Trig_MuradinTaunt_Func004Func003Func003Func003C() ) then
                    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_Hmbr_0310, 'Hmbr', gg_snd_MuradinWarcry1, bj_TIMETYPE_ADD, 0, true)
                else
                    if ( Trig_MuradinTaunt_Func004Func003Func003Func003Func003C() ) then
                        call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_Hmbr_0310, 'Hmbr', gg_snd_MuradinTaunt1, bj_TIMETYPE_ADD, 0, true)
                    else
                        if ( Trig_MuradinTaunt_Func004Func003Func003Func003Func003Func001C() ) then
                            call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_Hmbr_0310, 'Hmbr', gg_snd_MuradinTaunt2, bj_TIMETYPE_ADD, 0, true)
                        else
                            call DoNothing()
                        endif
                    endif
                endif
            endif
        endif
    endif
    call VolumeGroupResetBJ()
    call StartTimerBJ(udg_Timer_MuradinTauntReset, false, GetRandomReal(7.00, 30.00))
endfunction

