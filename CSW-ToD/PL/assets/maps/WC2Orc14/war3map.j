function InitTrig_CrossIslandIntroQ takes nothing returns nothing
    set gg_trg_CrossIslandIntroQ=CreateTrigger()
    call TriggerAddAction(gg_trg_CrossIslandIntroQ, function Trig_CrossIslandIntroQ_Actions)
endfunction

