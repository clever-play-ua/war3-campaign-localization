// Trigger: QMCIMageKilled
//===========================================================================
function Trig_QMCIMageKilled_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Hero_EnemyArchmage ) ) then
        return false
    endif
    return true
endfunction

function Trig_QMCIMageKilled_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestItemSetCompletedBJ(udg_QMCrossIslandReq[2], true)
    call DestroyMinimapIcon(udg_QMCIMage)
    call DestroyLeaderboardBJ(udg_Leaderboard_Observatories)
    call SetUnitInvulnerable(gg_unit_h61P_0537, false)
    call SetDoodadAnimationRectBJ("death", 'D009', gg_rct_VioletCitadelShield)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_3405")
endfunction

//===========================================================================
function InitTrig_QMCIMageKilled takes nothing returns nothing
    set gg_trg_QMCIMageKilled=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_QMCIMageKilled, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_QMCIMageKilled, Condition(function Trig_QMCIMageKilled_Conditions))
    call TriggerAddAction(gg_trg_QMCIMageKilled, function Trig_QMCIMageKilled_Actions)
endfunction

//===========================================================================
// Trigger: QMCrossIslandCompleted
//===========================================================================
function Trig_QMCrossIslandCompleted_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Maim) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_Rend) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_Zuluhed) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_QMCrossIslandCompleted_Func008A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_QMCrossIslandCompleted_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CrossIslandInvoulnerableZone01, udg_Player_KirinTor), function Trig_QMCrossIslandCompleted_Func008A)
    call DestroyMinimapIcon(udg_QMCIVioletCitadel)
    call QuestItemSetCompletedBJ(udg_QMCrossIslandReq[3], true)
    call QuestItemSetCompletedBJ(udg_QMCrossIslandReq[4], true)
    call QuestItemSetCompletedBJ(udg_QMCrossIslandReq[5], true)
    call QuestItemSetCompletedBJ(udg_QMCrossIslandReq[6], true)
    call QuestSetCompletedBJ(udg_QMCrossIsland, true)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3403")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerAddBJ(gg_trg_CrossIslandOutroQ, true)
endfunction

//===========================================================================
function InitTrig_QMCrossIslandCompleted takes nothing returns nothing
    set gg_trg_QMCrossIslandCompleted=CreateTrigger()
    call TriggerRegisterUnitEvent(gg_trg_QMCrossIslandCompleted, gg_unit_h61P_0537, EVENT_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_QMCrossIslandCompleted, Condition(function Trig_QMCrossIslandCompleted_Conditions))
    call TriggerAddAction(gg_trg_QMCrossIslandCompleted, function Trig_QMCrossIslandCompleted_Actions)
endfunction

//===========================================================================
// Trigger: QMHeroKilled
//===========================================================================
function Trig_QMHeroKilled_Func001C takes nothing returns boolean
    if ( ( GetDyingUnit() == udg_Hero_Rend ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_Hero_Maim ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_Hero_Zuluhed ) ) then
        return true
    endif
    return false
endfunction

function Trig_QMHeroKilled_Conditions takes nothing returns boolean
    if ( not Trig_QMHeroKilled_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_QMHeroKilled_Func005C takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Hero_Rend ) ) then
        return false
    endif
    return true
endfunction

function Trig_QMHeroKilled_Func006C takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Hero_Maim ) ) then
        return false
    endif
    return true
endfunction

function Trig_QMHeroKilled_Func007C takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_Hero_Zuluhed ) ) then
        return false
    endif
    return true
endfunction

function Trig_QMHeroKilled_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetFailedBJ(udg_QMCrossIsland, true)
    if ( Trig_QMHeroKilled_Func005C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_3506")
    else
    endif
    if ( Trig_QMHeroKilled_Func006C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_3507")
    else
    endif
    if ( Trig_QMHeroKilled_Func007C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_3508")
    else
    endif
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_Defeat)
endfunction

//===========================================================================
function InitTrig_QMHeroKilled takes nothing returns nothing
    set gg_trg_QMHeroKilled=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_QMHeroKilled, Player(0), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_QMHeroKilled, Condition(function Trig_QMHeroKilled_Conditions))
    call TriggerAddAction(gg_trg_QMHeroKilled, function Trig_QMHeroKilled_Actions)
endfunction

