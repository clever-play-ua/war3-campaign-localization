    call SetUnitFacingToFaceUnitTimed(udg_FakeZuluhed, udg_FakeUtok, 1.00)
    call TriggerSleepAction(1.00)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeUtok, 0, gg_snd_WC2Orc14Utok4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCrossIslandInSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    if ( (udg_Bool_CinCrossIslandInSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeZuluhed, 0, gg_snd_WC2Orc14Zuluhed7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinCrossIslandInSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeZuluhed, "cinematic listening one")
    // Cinematic Ends
    call ConditionalTriggerExecute(gg_trg_CrossIslandIntroCleanUp)
endfunction

