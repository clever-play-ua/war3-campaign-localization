    else
        call DoNothing()
    endif
    call SetUnitVertexColorBJ(udg_Hero_EnemyArchmage, 100, 100, 100, 40.00)
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinCrossIslandInSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitVertexColorBJ(udg_Hero_EnemyArchmage, 100, 100, 100, 55.00)
