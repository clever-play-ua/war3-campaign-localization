function Trig_P10PlayerMarineAttackOrderPoint_Actions takes nothing returns nothing
    local integer locOrderID= GetIssuedOrderId()
    local real locOrderX
    local real locOrderY
    local unit locOrderedUnit
    local boolean accurateSignalIsDetected= false
    // //
    local integer landingrolldiceFenrisOrc
    local integer landingrolldiceExpGoldmine
    local integer landingrolldiceStartOrc
    local integer landingrolldiceCapital
    // //
    if locOrderID == 851988 or locOrderID == 851986 or locOrderID == 851983 then
    set locOrderedUnit=GetOrderedUnit()
    set locOrderX=GetOrderPointX()
    set locOrderY=GetOrderPointY()
    // //
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func018C() ) then
        set udg_MarineAttackPointIsSet[10]=true
        set udg_MarineAttackPoint[10]=Location(locOrderX, locOrderY)
    else
    endif
    // //
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func020C() ) then
        call PingMinimapLocForForceEx(udg_PlayerGroup_PlayerActual, udg_MarineAttackPoint[10], 1, bj_MINIMAPPINGSTYLE_FLASHY, 100.00, 0.00, 0.00)
    else
    endif
    // //
    // We check of out Boarding Temp Point exists in the Particular Regions
    // And if the Unit is in the same region or it has to reach it first
    // //
    // First batch is for cases when our attackers are not yet in the area for landing
    // //
    // We start with the attacking player own base area
    // //
    // Capital City
    // //
    if RectContainsUnit(gg_rct_HumanCityArea, locOrderedUnit) then
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func032C() ) then
        set accurateSignalIsDetected=true
    else
    endif
    endif
    // //
    // Orc Starting Island
    // //
    if RectContainsUnit(gg_rct_OrcStartingArea, locOrderedUnit) then
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func038C() ) then
        set accurateSignalIsDetected=true
    else
    endif
    endif
    // //
    // Goldmine Expansion
    // //
    if RectContainsUnit(gg_rct_ExpansionGoldmine, locOrderedUnit) then
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func044C() ) then
        set accurateSignalIsDetected=true
    else
    endif
    endif
    // //
    // Orcs Main Base Area
    // //
    if RectContainsUnit(gg_rct_OrcFenrisIsleArea, locOrderedUnit) then
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func050C() ) then
        set accurateSignalIsDetected=true
    else
    endif
    endif
    // //
    // Second Batch of checks is for cases when they are in the landing areas
    // //
    if accurateSignalIsDetected then
    // //
    // Capital City
    // //
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func059C() ) then
        // //
        set landingrolldiceCapital=GetRandomInt(1, 2)
        // //
        if landingrolldiceCapital == 1 then
        set udg_AttackOrderPointerX[10]=GetLocationX(udg_Point_LandingCapitalCity01)
        set udg_AttackOrderPointerY[10]=GetLocationY(udg_Point_LandingCapitalCity01)
        else
        set udg_AttackOrderPointerX[10]=GetLocationX(udg_Point_LandingCapitalCity02)
        set udg_AttackOrderPointerY[10]=GetLocationY(udg_Point_LandingCapitalCity02)
        endif
        // //
    else
    endif
    // //
    // Orc Starting Area
    // //
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func063C() ) then
        // //
        set landingrolldiceStartOrc=GetRandomInt(1, 2)
        // //
        if landingrolldiceStartOrc == 1 then
        set udg_AttackOrderPointerX[10]=GetLocationX(udg_Point_LandingOrcStartArea01)
        set udg_AttackOrderPointerY[10]=GetLocationY(udg_Point_LandingOrcStartArea01)
        else
        set udg_AttackOrderPointerX[10]=GetLocationX(udg_Point_LandingOrcStartArea02)
        set udg_AttackOrderPointerY[10]=GetLocationY(udg_Point_LandingOrcStartArea02)
        endif
        // //
    else
    endif
    // //
    // Goldmine Expansion
    // //
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func067C() ) then
        // //
        set landingrolldiceExpGoldmine=GetRandomInt(1, 2)
        // //
        if landingrolldiceExpGoldmine == 1 then
        set udg_AttackOrderPointerX[10]=GetLocationX(udg_Point_LandingExpansion01)
        set udg_AttackOrderPointerY[10]=GetLocationY(udg_Point_LandingExpansion01)
        elseif landingrolldiceExpGoldmine == 2 then
        set udg_AttackOrderPointerX[10]=GetLocationX(udg_Point_LandingExpansion02)
        set udg_AttackOrderPointerY[10]=GetLocationY(udg_Point_LandingExpansion02)
        endif
        // //
    else
    endif
    // //
    // Orc Base
    // //
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func071C() ) then
        // //
        set landingrolldiceFenrisOrc=GetRandomInt(1, 2)
        // //
        if landingrolldiceFenrisOrc == 1 then
        set udg_AttackOrderPointerX[10]=GetLocationX(udg_Point_LandingFenrisIsle01)
        set udg_AttackOrderPointerY[10]=GetLocationY(udg_Point_LandingFenrisIsle01)
        elseif landingrolldiceFenrisOrc == 2 then
        set udg_AttackOrderPointerX[10]=GetLocationX(udg_Point_LandingFenrisIsle02)
        set udg_AttackOrderPointerY[10]=GetLocationY(udg_Point_LandingFenrisIsle02)
        endif
        // //
    else
    endif
    // //
    // closing accurate signal is detected check
    endif
    // //
    // Avoid Attacking Oil Rigs
    // //
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func078C() ) then
        if ( Trig_P10PlayerMarineAttackOrderPoint_Func078Func001C() ) then
            set udg_Unit_PlayerSurfaceUnit=GroupPickRandomUnit(udg_Group_PlayerSurfaceStructures)
        else
        endif
        set udg_AttackOrderPointerX[10]=GetUnitX(udg_Unit_PlayerSurfaceUnit)
        set udg_AttackOrderPointerY[10]=GetUnitY(udg_Unit_PlayerSurfaceUnit)
        if not IsUnitInRangeXY(locOrderedUnit, udg_AttackOrderPointerX[10], udg_AttackOrderPointerY[10], 1024) then
        set accurateSignalIsDetected=true
        endif
    else
    endif
    // //
    if accurateSignalIsDetected and s__ForceBoarding_struct[GetUnitUserData(locOrderedUnit)] == 0 then
    call GroupAddUnit(udg_IdleMarines[10], locOrderedUnit)
    endif
    // //
    // closing if statement for attack order ID check
    endif
    // //
    set locOrderedUnit=null
    // //
    if ( Trig_P10PlayerMarineAttackOrderPoint_Func089C() ) then
        call RemoveLocation(udg_MarineAttackPoint[10])
        set udg_MarineAttackPointIsSet[10]=false
    else
    endif
    // //
    // //
    // //
    // //
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_P10PlayerMarineAttackOrderPoint takes nothing returns nothing
    set gg_trg_P10PlayerMarineAttackOrderPoint=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_P10PlayerMarineAttackOrderPoint, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddCondition(gg_trg_P10PlayerMarineAttackOrderPoint, Condition(function Trig_P10PlayerMarineAttackOrderPoint_Conditions))
    call TriggerAddAction(gg_trg_P10PlayerMarineAttackOrderPoint, function Trig_P10PlayerMarineAttackOrderPoint_Actions)
endfunction

