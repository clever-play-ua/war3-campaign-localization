//===========================================================================
// Trigger: Load
//===========================================================================
function Trig_Load_Func007C takes nothing returns boolean
    if ( ( GetEnteringUnit() == udg_FakeMaim ) ) then
        return true
    endif
    if ( ( GetEnteringUnit() == udg_FakeRend ) ) then
        return true
    endif
    if ( ( GetEnteringUnit() == udg_FakeZuluhed ) ) then
        return true
    endif
    if ( ( GetEnteringUnit() == udg_SemiHero_Utok ) ) then
        return true
    endif
    return false
endfunction

function Trig_Load_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinMidgameOn == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_OrcsSentToDalaran == true ) ) then
        return false
    endif
    if ( not Trig_Load_Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Func004Func001C takes nothing returns boolean
    if ( not ( udg_Int_MidgameCinSailOutCounter >= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Func004Func002C takes nothing returns boolean
    if ( not ( udg_Int_MidgameCinSailOutCounter >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Func004C takes nothing returns boolean
    if ( not ( udg_Bool_M13SecretFound == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Load_Actions takes nothing returns nothing
    call PlaySoundAtPointBJ(gg_snd_Loading, 50.00, GetRectCenter(gg_rct_MidgameShipSpawn01), 0)
    call ShowUnitHide(GetEnteringUnit())
    set udg_Int_MidgameCinSailOutCounter=( udg_Int_MidgameCinSailOutCounter + 1 )
    if ( Trig_Load_Func004C() ) then
        if ( Trig_Load_Func004Func002C() ) then
            call PlaySoundAtPointBJ(gg_snd_Dock, 50.00, GetRectCenter(gg_rct_MidgameShipArrive01), 0)
            call IssuePointOrderLocBJ(udg_Unit_OrcShipArr[1], "move", GetRectCenter(gg_rct_MidgameShipStart01))
            call IssuePointOrderLocBJ(udg_Unit_OrcShipArr[4], "move", GetRectCenter(gg_rct_MidgameDestroyerStart01))
            call IssuePointOrderLocBJ(udg_Unit_OrcShipArr[5], "move", GetRectCenter(gg_rct_MidgameDestroyerStart02))
        else
        endif
    else
        if ( Trig_Load_Func004Func001C() ) then
            call PlaySoundAtPointBJ(gg_snd_Dock, 50.00, GetRectCenter(gg_rct_MidgameShipArrive01), 0)
            call IssuePointOrderLocBJ(udg_Unit_OrcShipArr[1], "move", GetRectCenter(gg_rct_MidgameShipStart01))
            call IssuePointOrderLocBJ(udg_Unit_OrcShipArr[4], "move", GetRectCenter(gg_rct_MidgameDestroyerStart01))
            call IssuePointOrderLocBJ(udg_Unit_OrcShipArr[5], "move", GetRectCenter(gg_rct_MidgameDestroyerStart02))
        else
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Load takes nothing returns nothing
    set gg_trg_Load=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_Load, gg_rct_MidgameShipSpawn01)
    call TriggerAddCondition(gg_trg_Load, Condition(function Trig_Load_Conditions))
    call TriggerAddAction(gg_trg_Load, function Trig_Load_Actions)
endfunction

