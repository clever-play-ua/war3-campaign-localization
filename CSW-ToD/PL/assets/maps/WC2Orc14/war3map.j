function Trig_InitUnits_Actions takes nothing returns nothing
    // RemoveDummies
    call DestroyGroup(udg_TempGroup)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_CinematicDummy), function Trig_InitUnits_Func004002)
    // ///
    call ShowUnitHide(gg_unit_n60M_0408)
    // ///
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 20.00)
    call EnableCreepSleepBJ(false)
    // Tents
    set udg_Unit_TentArr[1]=gg_unit_nten_0236
    call UnitAddAbility(udg_Unit_TentArr[1], 'Aloc')
    set udg_Unit_TentArr[2]=gg_unit_nten_0239
    call UnitAddAbility(udg_Unit_TentArr[2], 'Aloc')
    set udg_Unit_TentArr[3]=gg_unit_nten_0240
    call UnitAddAbility(udg_Unit_TentArr[3], 'Aloc')
    set udg_Unit_TentArr[4]=gg_unit_ntn2_0237
    call UnitAddAbility(udg_Unit_TentArr[4], 'Aloc')
    set udg_Unit_TentArr[5]=gg_unit_n00K_0238
    call UnitAddAbility(udg_Unit_TentArr[5], 'Aloc')
    // Sheeps
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_Sheeps, Condition(function Trig_InitUnits_Func023001002)), function Trig_InitUnits_Func023A)
    // Human Camp Actors
    // Footman
    call SetUnitMoveSpeed(gg_unit_hfSw_0090, 120.00)
    call BlzSetUnitRealFieldBJ(gg_unit_hfSw_0090, UNIT_RF_ANIMATION_WALK_SPEED, 120.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_hfSw_0090)
    call IssuePointOrderLocBJ(gg_unit_hfSw_0090, "patrol", GetRectCenter(gg_rct_PatrolGuard01))
    // KnightA
    call SetUnitMoveSpeed(gg_unit_hPSW_0093, 120.00)
    call BlzSetUnitRealFieldBJ(gg_unit_hPSW_0093, UNIT_RF_ANIMATION_WALK_SPEED, 120.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_hPSW_0093)
    call IssuePointOrderLocBJ(gg_unit_hPSW_0093, "patrol", GetRectCenter(gg_rct_PatrolGuard02))
    // KnightB
    call SetUnitMoveSpeed(gg_unit_hPSW_0091, 100.00)
    call BlzSetUnitRealFieldBJ(gg_unit_hPSW_0091, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_hPSW_0091)
    call IssuePointOrderLocBJ(gg_unit_hPSW_0091, "patrol", GetRectCenter(gg_rct_PatrolGuard03))
    // KnightC
    call SetUnitMoveSpeed(gg_unit_hPSW_0094, 100.00)
    call BlzSetUnitRealFieldBJ(gg_unit_hPSW_0094, UNIT_RF_ANIMATION_WALK_SPEED, 100.00)
    call AddUnitAnimationPropertiesBJ(true, "cinematic", gg_unit_hPSW_0094)
    call IssuePointOrderLocBJ(gg_unit_hPSW_0094, "patrol", GetRectCenter(gg_rct_PatrolGuard04))
    // Footmen
    call SetUnitAnimation(gg_unit_hfSw_0097, "cinematic kneeling one")
    call SetUnitAnimation(gg_unit_hfSw_0096, "cinematic sitting one")
    // ///
    set udg_Unit_IntroTransportArr[1]=gg_unit_o60Q_0075
    set udg_Unit_IntroTransportArr[2]=gg_unit_o60Q_0076
    set udg_Unit_IntroTransportArr[3]=gg_unit_o60Q_0077
    // ///
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_LordaeronCityGuards, 'e000'), function Trig_InitUnits_Func054A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_LordaeronCityGuards, 'h60B'), function Trig_InitUnits_Func056A)
    // ///
    call ForGroupBJ(udg_Group_WallArchers, function Trig_InitUnits_Func058002)
    call ForGroupBJ(udg_Group_WallArchers, function Trig_InitUnits_Func059002)
    // ///
    call EnumDestructablesInRectAll(gg_rct_InvoulnerableDestructables, function Trig_InitUnits_Func061002)
    call EnumDestructablesInRectAll(gg_rct_LordaeronPalace, function Trig_InitUnits_Func062002)
    // ///
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_InvoulnerableUnits, udg_Player_Citizens), function Trig_InitUnits_Func064002)
