    call PlaySoundOnUnitBJ(gg_snd_CS_Prologue2_Foley101, 80.00, udg_SemiHero_Utok)
    call TriggerSleepAction(2)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ConditionalTriggerExecute(gg_trg_MidgameCleanUp)
endfunction

//===========================================================================
function InitTrig_MidgameCinematicQ takes nothing returns nothing
    set gg_trg_MidgameCinematicQ=CreateTrigger()
    call TriggerAddAction(gg_trg_MidgameCinematicQ, function Trig_MidgameCinematicQ_Actions)
endfunction

//===========================================================================
// Trigger: CinHeadPointerMoves01
//===========================================================================
function Trig_CinHeadPointerMoves01_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinMidgameOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_Unit_CinematicHeadPointer[1] ) ) then
        return false
    endif
    return true
endfunction

function Trig_CinHeadPointerMoves01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call IssuePointOrderLocBJ(udg_Unit_CinematicHeadPointer[1], "move", GetRectCenter(gg_rct_MidgameUtok02))
endfunction

//===========================================================================
function InitTrig_CinHeadPointerMoves01 takes nothing returns nothing
    set gg_trg_CinHeadPointerMoves01=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_CinHeadPointerMoves01, gg_rct_MidgameRend02)
    call TriggerAddCondition(gg_trg_CinHeadPointerMoves01, Condition(function Trig_CinHeadPointerMoves01_Conditions))
    call TriggerAddAction(gg_trg_CinHeadPointerMoves01, function Trig_CinHeadPointerMoves01_Actions)
endfunction

//===========================================================================
// Trigger: CinHeadPointerMoves02
//===========================================================================
function Trig_CinHeadPointerMoves02_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinMidgameOn == true ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() == udg_Unit_CinematicHeadPointer[1] ) ) then
        return false
    endif
    return true
