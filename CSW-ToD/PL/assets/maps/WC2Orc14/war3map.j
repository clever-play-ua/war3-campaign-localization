function Trig_RotateMaim_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitFacingToFaceLocTimed(udg_FakeDoomhammer, GetRectCenter(gg_rct_MidgameMaim02), 1.00)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingToFaceLocTimed(udg_FakeMaim, GetUnitLoc(udg_FakeDoomhammer), 1.00)
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMaim, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic salute one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic listening one")
    // //
endfunction

