function Trig_ECSquad05Killed_Func008C takes nothing returns boolean
    if ( not ( IsQuestItemCompleted(udg_QMCrossIslandReq[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ECSquad05Killed_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // All otherCorridorsAreOpeningIfObservatoriesDestroyed
    // ///
    if ( Trig_ECSquad05Killed_Func008C() ) then
        set udg_Bool_OuterCircleBreached=true
        call KillDestructable(gg_dest_Dofw_10735)
        call KillDestructable(gg_dest_Dofw_10734)
        call KillDestructable(gg_dest_Dofw_10727)
        call KillDestructable(gg_dest_Dofw_8422)
        call EnumDestructablesInRectAll(gg_rct_WestCorridor, function Trig_ECSquad05Killed_Func008Func006A)
        call EnumDestructablesInRectAll(gg_rct_SouthCorridor, function Trig_ECSquad05Killed_Func008Func007A)
        call EnumDestructablesInRectAll(gg_rct_NorthCorridor, function Trig_ECSquad05Killed_Func008Func008A)
        call ForGroupBJ(udg_Group_KirinTorEliteGuard, function Trig_ECSquad05Killed_Func008Func009A)
    else
    endif
    // ///
    call EnableTrigger(gg_trg_CIOuterCircleDestroyed)
endfunction

