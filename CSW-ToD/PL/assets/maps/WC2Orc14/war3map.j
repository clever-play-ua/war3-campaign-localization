    call IssuePointOrderLocBJ(gg_unit_h60B_0464, "move", GetRectCenter(gg_rct_IntroArcherClimb))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
