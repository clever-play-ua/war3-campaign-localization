function Trig_MidgameContinueLordaeronCleanUp_Func002C takes nothing returns boolean
    if ( not ( udg_Bool_M13SecretFound == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func034002 takes nothing returns nothing
    call SetUnitOwner(GetEnumUnit(), udg_Player_Actual, false)
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func037002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func040001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func040001002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o61X' )
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func040001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetUnitTypeId(GetFilterUnit()) == 'o61X')) // INLINED!!
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func040002 takes nothing returns nothing
    call IssueImmediateOrderBJ(GetEnumUnit(), "autoharvestgold")
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func043001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func043001002002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o61X' )
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func043001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (GetUnitTypeId(GetFilterUnit()) == 'o61X')) // INLINED!!
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func043002 takes nothing returns nothing
    call IssueImmediateOrderBJ(GetEnumUnit(), "autoharvestlumber")
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Func045C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MidgameContinueLordaeronCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_MidgameContinueLordaeronCleanUp_Func002C() ) then
        call DoNothing()
    else
        call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
        call TriggerSleepAction(1.00)
    endif
    set udg_Bool_CinContinueToLordaeronOn=false
    call StopSoundBJ(gg_snd_DarkAgents, false)
    // //
    call SetSkyModel("Environment\\Sky\\LordaeronSummerSky\\LordaeronSummerSky.mdl")
    set udg_Real_FogMin=3000.00
    set udg_Real_FogMax=12500.00
    set udg_Real_FogColorR=50.00
    set udg_Real_FogColorG=50.00
    set udg_Real_FogColorB=68.00
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, udg_Real_FogColorR, udg_Real_FogColorG, udg_Real_FogColorB)
    call CameraSetupApplyForPlayer(true, udg_Var_CurrentCamera, udg_Player_Actual, 0)
    // //
    call ShowUnitShow(gg_unit_n60M_0408)
    // //
    call SetCameraBoundsToRectForPlayerBJ(udg_Player_Actual, gg_rct_CameraBounds02)
    call BlzChangeMinimapTerrainTex("Mission14MapLordaeron.tga")
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call RemoveUnit(udg_Unit_CinematicHeadPointer[2])
    // //
    call RemoveLocation(udg_Point_CinUtokTemp)
    call RemoveLocation(udg_Point_CinZuluhedTemp)
    call RemoveLocation(udg_Point_CinHeadPointerTemp)
    call RemoveLocation(udg_Point_CinematicTharbekTemp)
    call RemoveLocation(udg_Point_CinematicPeonTemp)
    // //
    // //
    call SetUnitOwner(udg_Hero_Doomhammer, udg_Player_Actual, true)
    call SuspendHeroXPBJ(true, udg_Hero_Doomhammer)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Blackrock, 'o61X'), function Trig_MidgameContinueLordaeronCleanUp_Func034002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_Actual, 'o61X'), function Trig_MidgameContinueLordaeronCleanUp_Func037002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_OrcCampGoldmineMainArea, Condition(function Trig_MidgameContinueLordaeronCleanUp_Func040001002)), function Trig_MidgameContinueLordaeronCleanUp_Func040002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_LumberWorks, Condition(function Trig_MidgameContinueLordaeronCleanUp_Func043001002)), function Trig_MidgameContinueLordaeronCleanUp_Func043002)
    // //
    if ( Trig_MidgameContinueLordaeronCleanUp_Func045C() ) then
        call SetUnitPositionLoc(udg_SemiHero_Utok, GetRandomLocInRect(gg_rct_KnightResetRange01))
    else
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRandomLocInRect(gg_rct_KnightResetRange01), GetRandomDirectionDeg())
        set udg_SemiHero_Utok=GetLastCreatedUnit()
    endif
    // //
    call TriggerSleepAction(0.50)
    // SetUpUpgrades
    call SetPlayerTechResearchedSwap('R00T', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R60K', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R00S', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R00M', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('RBOo', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R60K', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R601', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R008', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R00V', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R003', 0, udg_Player_Actual)
    call SetPlayerTechResearchedSwap('R001', 0, udg_Player_Actual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 0, 0, 0, 0)
    call TriggerSleepAction(1.00)
    call CinematicModeBJ(false, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_GenericCinematicCleanUp)
    call FogMaskEnableOn()
    // //
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
    set udg_Sting_CheckpointPhase="LordaeronFall"
    call ConditionalTriggerExecute(gg_trg_SaveCheckpoint)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerAddBJ(gg_trg_QMLHDiscoveredQ, true)
    call EnableTrigger(gg_trg_PlayerLostTheCamp)
endfunction

//===========================================================================
function InitTrig_MidgameContinueLordaeronCleanUp takes nothing returns nothing
    set gg_trg_MidgameContinueLordaeronCleanUp=CreateTrigger()
    call TriggerAddAction(gg_trg_MidgameContinueLordaeronCleanUp, function Trig_MidgameContinueLordaeronCleanUp_Actions)
endfunction

//===========================================================================
// Trigger: MidgameCinLordaeronSkipped
//===========================================================================
function Trig_MidgameCinLordaeronSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinContinueToLordaeronOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MidgameCinLordaeronSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinContinueSkipped=true
    call ConditionalTriggerExecute(gg_trg_MidgameContinueLordaeronCleanUp)
    call StopSoundBJ(gg_snd_WC2Orc14Orgrim9, false)
    call StopSoundBJ(gg_snd_WC2Orc14Orgrim13, false)
    call StopSoundBJ(gg_snd_WC2Orc14Orgrim14, false)
    call StopSoundBJ(gg_snd_WC2Orc14Tharbek3, false)
    call StopSoundBJ(gg_snd_WC2Orc14Utok7, false)
endfunction

//===========================================================================
function InitTrig_MidgameCinLordaeronSkipped takes nothing returns nothing
    set gg_trg_MidgameCinLordaeronSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_MidgameCinLordaeronSkipped, Player(0))
    call TriggerAddCondition(gg_trg_MidgameCinLordaeronSkipped, Condition(function Trig_MidgameCinLordaeronSkipped_Conditions))
    call TriggerAddAction(gg_trg_MidgameCinLordaeronSkipped, function Trig_MidgameCinLordaeronSkipped_Actions)
endfunction

