//===========================================================================
// Trigger: FaceAnimLoader
//===========================================================================
function Trig_FaceAnimLoader_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Doomhammer
    // //
    call CreateItemLoc('I0LA', GetRectCenter(gg_rct_LocalizationItem))
    set udg_Locale_NameOrgrim=BlzGetItemTooltip(GetLastCreatedItem())
    call SetDialogueSpeakerNameKey(gg_snd_WC2Orc14Orgrim1, BlzGetItemTooltip(GetLastCreatedItem()))
    call SetDialogueTextKey(gg_snd_WC2Orc14Orgrim1, BlzGetItemDescription(GetLastCreatedItem()))
