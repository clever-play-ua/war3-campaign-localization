function Trig_CiIntroArchmageTrancparancyRun_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call SetUnitVertexColorBJ(udg_Hero_EnemyArchmage, 100, 100, 100, 10.00)
    call TriggerSleepAction(0.25)
