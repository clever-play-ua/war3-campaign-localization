function Trig_PlayerLostTheCamp_Func025001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n60L' )
endfunction

function Trig_PlayerLostTheCamp_Func025001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_PlayerLostTheCamp_Func025001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'n60L'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_PlayerLostTheCamp_Func025A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PUsrDefeatCondition)
endfunction

function Trig_PlayerLostTheCamp_Func027C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_PUsrDefeatCondition) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PlayerLostTheCamp_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_PUsrDefeatCondition)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_PlayerLostTheCamp_Func007001002)), function Trig_PlayerLostTheCamp_Func007A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_PlayerLostTheCamp_Func010001002)), function Trig_PlayerLostTheCamp_Func010A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_PlayerLostTheCamp_Func013001002)), function Trig_PlayerLostTheCamp_Func013A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_PlayerLostTheCamp_Func016001002)), function Trig_PlayerLostTheCamp_Func016A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_PlayerLostTheCamp_Func019001002)), function Trig_PlayerLostTheCamp_Func019A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_PlayerLostTheCamp_Func022001002)), function Trig_PlayerLostTheCamp_Func022A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_PlayerLostTheCamp_Func025001002)), function Trig_PlayerLostTheCamp_Func025A)
    // //
    if ( Trig_PlayerLostTheCamp_Func027C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QueuedTriggerAddBJ(gg_trg_Defeat, true)
    else
    endif
    // //
    call GroupClear(udg_Group_PUsrDefeatCondition)
    // //
endfunction

