function InitTrig_PlayerLostTheCamp takes nothing returns nothing
    set gg_trg_PlayerLostTheCamp=CreateTrigger()
    call DisableTrigger(gg_trg_PlayerLostTheCamp)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_PlayerLostTheCamp, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_PlayerLostTheCamp, Condition(function Trig_PlayerLostTheCamp_Conditions))
    call TriggerAddAction(gg_trg_PlayerLostTheCamp, function Trig_PlayerLostTheCamp_Actions)
