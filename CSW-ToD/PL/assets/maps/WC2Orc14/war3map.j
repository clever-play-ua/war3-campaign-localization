function Trig_CIOutroDebug_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_QMHeroKilled)
    call DestroyEffectBJ(udg_SE_UndeadSpawnArr[1])
    call DestroyEffectBJ(udg_SE_UndeadSpawnArr[2])
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(15), 'haro'), function Trig_CIOutroDebug_Func005A)
    call TriggerSleepAction(2)
    set udg_Bool_OuterCircleBreached=true
    call KillDestructable(gg_dest_Dofw_10735)
    call KillDestructable(gg_dest_Dofw_10734)
    call KillDestructable(gg_dest_Dofw_10727)
    call KillDestructable(gg_dest_Dofw_8422)
    call KillDestructable(gg_dest_Dofw_10852)
    call KillDestructable(gg_dest_Dofw_10851)
    call KillDestructable(gg_dest_Dofw_10850)
    call KillDestructable(gg_dest_Dofw_10853)
    call EnumDestructablesInRectAll(gg_rct_NorthCorridor, function Trig_CIOutroDebug_Func016A)
    call EnumDestructablesInRectAll(gg_rct_SouthCorridor, function Trig_CIOutroDebug_Func017A)
    call EnumDestructablesInRectAll(gg_rct_EastCorridor, function Trig_CIOutroDebug_Func018A)
    call EnumDestructablesInRectAll(gg_rct_WestCorridor, function Trig_CIOutroDebug_Func019A)
    call ForGroupBJ(udg_Group_KirinTorEliteGuard, function Trig_CIOutroDebug_Func020A)
    call TriggerSleepAction(2)
    call ForGroupBJ(udg_Group_KirinTorEliteGuard, function Trig_CIOutroDebug_Func022A)
    call TriggerSleepAction(2)
    call ForGroupBJ(udg_Group_KirinTorEliteGuard02, function Trig_CIOutroDebug_Func024A)
    call TriggerSleepAction(2)
    call KillUnit(gg_unit_h61P_0537)
endfunction

