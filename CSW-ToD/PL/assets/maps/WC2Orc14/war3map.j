    call TriggerAddAction(gg_trg_VictoryCinematicQ, function Trig_VictoryCinematicQ_Actions)
endfunction

//===========================================================================
// Trigger: VictorySkipped
//===========================================================================
function Trig_VictorySkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinOutroOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_VictorySkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinOutroSkipped=true
    call StopSoundBJ(gg_snd_WC2Orc14Orgrim12, false)
    call StopSoundBJ(gg_snd_DarkVictory, false)
    // Fade Out
