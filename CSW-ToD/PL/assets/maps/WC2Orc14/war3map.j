//===========================================================================
// Trigger: AI P15 Oil
//===========================================================================
function Trig_AI_P15_Oil_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Oil_Func006001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'u600' )
endfunction

function Trig_AI_P15_Oil_Func006001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_AI_P15_Oil_Func006001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'u600'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_AI_P15_Oil_Func006A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P15OilRigs)
endfunction

function Trig_AI_P15_Oil_Func020C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AI_P15_Oil_Actions takes nothing returns nothing
    local integer P15OilRigs
    // //
    call GroupClear(udg_Group_P15OilRigs)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_LordaeronNaval, Condition(function Trig_AI_P15_Oil_Func006001002)), function Trig_AI_P15_Oil_Func006A)
    // //
    set P15OilRigs=CountUnitsInGroup(udg_Group_P15OilRigs)
    // //
    if (OilHarvest___playerOil[GetPlayerId((Player(14)))]) < 700 and P15OilRigs == 0 then // INLINED!!
    // //
    call PauseTimerBJ(true, udg_Timer_P15Oil)
    // //
    call DisableTrigger(gg_trg_P15OilSpentForBattleship)
    call DisableTrigger(gg_trg_P15OilSpentForDestroyer)
    call DisableTrigger(gg_trg_P15OilSpentForSubmarine)
    // //
    call ConditionalTriggerExecute(gg_trg_AI_P15_Command_Stop_Attack_User)
    // //
    if ( Trig_AI_P15_Oil_Func020C() ) then
        call DisplayTextToForce(udg_PlayerGroup_PlayerActual, "TRIGSTR_3985")
    else
    endif
    // //
    endif
    // //
    // //
    call GroupClear(udg_Group_P15OilRigs)
    // //
endfunction

