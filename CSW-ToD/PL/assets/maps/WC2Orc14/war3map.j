//===========================================================================
// Trigger: OilSpentForResearchC01
//===========================================================================
function Trig_OilSpentForResearchC01_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetOrderedUnit()) == 'o60M' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R008', udg_Player_Actual) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilSpentForResearchC01_Actions takes nothing returns nothing
    local sound OrcUI_InsufficientOill
    local string Sound_Path= "Sound\\Interface\\Warning\\Orc\\GruntNoOil1.mp3"
    // -------------------------------------
    // Check the Order to train the ship
