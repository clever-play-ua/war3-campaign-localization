// Trigger: P10BoardingOrder
//===========================================================================
function Trig_P10BoardingOrder_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10BoardingOrder_Func003Func004C takes nothing returns boolean
    if ( not ( udg_BoardingOrderTimerCount[10] >= udg_BoardingOrderTimerInterval[10] ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10BoardingOrder_Func003Func005C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[10]) <= 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[10]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10BoardingOrder_Func003Func006C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_QueuedTransports[10]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_QueuedMarines[10]) <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10BoardingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_IdleMarines[10]) >= 1 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_IdleTransports[10]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10BoardingOrder_Actions takes nothing returns nothing
    // //
    if ( Trig_P10BoardingOrder_Func003C() ) then
        set udg_BoardingOrderTimerCount[10]=( udg_BoardingOrderTimerCount[10] + udg_BoardingOrderTimerPeriod[10] )
        if ( Trig_P10BoardingOrder_Func003Func004C() ) then
            set udg_BoardingOrderTimerCount[10]=0.00
            call BoardingFunc(10)
        else
        endif
        if ( Trig_P10BoardingOrder_Func003Func005C() ) then
            call GroupClear(udg_QueuedMarines[10])
        else
        endif
        if ( Trig_P10BoardingOrder_Func003Func006C() ) then
            call GroupClear(udg_QueuedTransports[10])
        else
        endif
    else
        set udg_BoardingOrderTimerCount[10]=0.00
    endif
endfunction

//===========================================================================
function InitTrig_P10BoardingOrder takes nothing returns nothing
    set gg_trg_P10BoardingOrder=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_P10BoardingOrder, udg_BoardingOrderTimer[10])
    call TriggerAddCondition(gg_trg_P10BoardingOrder, Condition(function Trig_P10BoardingOrder_Conditions))
    call TriggerAddAction(gg_trg_P10BoardingOrder, function Trig_P10BoardingOrder_Actions)
endfunction

