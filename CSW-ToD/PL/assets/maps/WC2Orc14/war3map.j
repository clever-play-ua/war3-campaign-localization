//===========================================================================
// Trigger: NextLevelPrep
//===========================================================================
function Trig_NextLevelPrep_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call StopSoundBJ(gg_snd_DarkVictory, true)
    set udg_Bool_CinOutroOn=false
    call ShowCustomCampaignButton(true, 22)
    call SetNextLevelBJ("WC2OrcFinal.w3x")
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    // //
    call QueuedTriggerRemoveBJ(gg_trg_VictoryCinematicQ)
    // //
    // Movie added in campaingpatch 2.0
    // //
    call PlayCinematic("ToDOutroMovie")
    // //
    call TriggerSleepAction(0.00)
    call CustomVictoryBJ(udg_Player_Actual, false, true)
    // //
endfunction

