function Trig_SpawnCitizens_Actions takes nothing returns nothing
    set udg_Point_SpawnCitizensTemp=GetUnitLoc(GetDyingUnit())
    // AmountPoll
    set udg_CitizenSpawnAmount=GetRandomInt(1, 4)
    // Spawn
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_CitizenSpawnAmount
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        // Color Poll
        set udg_CitizenSpawnColor=GetRandomInt(1, 12)
        if ( Trig_SpawnCitizens_Func007Func003C() ) then
            call CreateNUnitsAtLoc(1, 'n00Z', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
        else
            if ( Trig_SpawnCitizens_Func007Func003Func001C() ) then
                call CreateNUnitsAtLoc(1, 'n010', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
            else
                if ( Trig_SpawnCitizens_Func007Func003Func001Func001C() ) then
                    call CreateNUnitsAtLoc(1, 'n011', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                else
                    if ( Trig_SpawnCitizens_Func007Func003Func001Func001Func001C() ) then
                        call CreateNUnitsAtLoc(1, 'n012', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                    else
                        if ( Trig_SpawnCitizens_Func007Func003Func001Func001Func001Func001C() ) then
                            call CreateNUnitsAtLoc(1, 'n013', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                        else
                            if ( Trig_SpawnCitizens_Func007Func003Func001Func001Func001Func001Func001C() ) then
                                call CreateNUnitsAtLoc(1, 'n014', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                            else
                                if ( Trig_SpawnCitizens_Func007Func003Func001Func001Func001Func001Func001Func001C() ) then
                                    call CreateNUnitsAtLoc(1, 'n015', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                                else
                                    if ( Trig_SpawnCitizens_Func007Func003Func001Func001Func001Func001Func001Func001Func001C() ) then
                                        call CreateNUnitsAtLoc(1, 'n016', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                                    else
                                        if ( Trig_SpawnCitizens_Func007Func003Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                            call CreateNUnitsAtLoc(1, 'n017', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                                        else
                                            if ( Trig_SpawnCitizens_Func007Func003Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                call CreateNUnitsAtLoc(1, 'n018', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                                            else
                                                if ( Trig_SpawnCitizens_Func007Func003Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                    call CreateNUnitsAtLoc(1, 'n019', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                                                else
                                                    if ( Trig_SpawnCitizens_Func007Func003Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001Func001C() ) then
                                                        call CreateNUnitsAtLoc(1, 'n01M', udg_Player_Lordaeron, udg_Point_SpawnCitizensTemp, GetRandomDirectionDeg())
                                                    else
                                                    endif
                                                endif
                                            endif
                                        endif
                                    endif
                                endif
                            endif
                        endif
                    endif
                endif
            endif
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    // LeakCleaner
    call RemoveLocation(udg_Point_SpawnCitizensTemp)
    // //
    // //
    // //
endfunction

