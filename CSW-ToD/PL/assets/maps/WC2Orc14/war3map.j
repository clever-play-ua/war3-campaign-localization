    call SetPlayerTechResearched(Player(0), 'Ropm', 1)
    call SetPlayerTechMaxAllowed(Player(0), 'R603', 0)
    call SetPlayerTechMaxAllowed(Player(0), 'R60C', 0)
    call SetPlayerTechMaxAllowed(Player(0), 'R60D', 0)
