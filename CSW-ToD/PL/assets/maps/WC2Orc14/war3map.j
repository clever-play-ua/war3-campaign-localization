function Trig_Doomhammer_I_Doomstrike_Func012A takes nothing returns nothing
    if ( Trig_Doomhammer_I_Doomstrike_Func012Func001C() ) then
        if ( Trig_Doomhammer_I_Doomstrike_Func012Func001Func013C() ) then
            call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 100.00 ))
        else
            if ( Trig_Doomhammer_I_Doomstrike_Func012Func001Func013Func002C() ) then
                call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 175.00 ))
            else
                if ( Trig_Doomhammer_I_Doomstrike_Func012Func001Func013Func002Func002C() ) then
                    call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 250.00 ))
                else
                endif
