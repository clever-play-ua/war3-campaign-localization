// Trigger: P10TransportReactToDamage
//===========================================================================
function Trig_P10TransportReactToDamage_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(BlzGetEventDamageTarget()) == 'h60P' ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(BlzGetEventDamageTarget(), udg_DepartedTransports[10]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10TransportReactToDamage_Func003C takes nothing returns boolean
    if ( not ( udg_Bool_DebugOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10TransportReactToDamage_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    if ( Trig_P10TransportReactToDamage_Func003C() ) then
        call BJDebugMsg("Transportowiec Lordaeronu jest atakowany!")
    else
    endif
    // //
    set udg_MarineLandingPoint[4]=Location(udg_AttackOrderPointerX[10], udg_AttackOrderPointerY[10])
    call IssuePointOrderLocBJ(BlzGetEventDamageTarget(), "unloadall", udg_MarineLandingPoint[10])
    call RemoveLocation(udg_MarineLandingPoint[10])
    call PolledWait(1.00)
    // //
    call EnableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_P10TransportReactToDamage takes nothing returns nothing
    set gg_trg_P10TransportReactToDamage=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_P10TransportReactToDamage, Player(9), EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_P10TransportReactToDamage, Condition(function Trig_P10TransportReactToDamage_Conditions))
    call TriggerAddAction(gg_trg_P10TransportReactToDamage, function Trig_P10TransportReactToDamage_Actions)
