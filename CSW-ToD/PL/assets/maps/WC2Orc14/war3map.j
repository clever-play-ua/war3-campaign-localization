        return false
    endif
    return true
endfunction

function Trig_SkeletonGroupCheckAttackState_Actions takes nothing returns nothing
    if ( Trig_SkeletonGroupCheckAttackState_Func004C() ) then
        set udg_Bool_SkeletonProduceOn=false
    else
        set udg_Bool_SkeletonProduceOn=true
    endif
    if ( Trig_SkeletonGroupCheckAttackState_Func005C() ) then
        if ( Trig_SkeletonGroupCheckAttackState_Func005Func002C() ) then
            call ConditionalTriggerExecute(gg_trg_SpawnUndead01)
        else
            call ConditionalTriggerExecute(gg_trg_SpawnUndead02)
            if ( Trig_SkeletonGroupCheckAttackState_Func005Func002Func003C() ) then
                call ForGroupBJ(udg_Group_IntroCIDeathKnights, function Trig_SkeletonGroupCheckAttackState_Func005Func002Func003Func002A)
            else
            endif
        endif
    else
        if ( Trig_SkeletonGroupCheckAttackState_Func005Func001C() ) then
            call ForGroupBJ(udg_Group_SpawnedSkeletons, function Trig_SkeletonGroupCheckAttackState_Func005Func001Func001A)
        else
            if ( Trig_SkeletonGroupCheckAttackState_Func005Func001Func002C() ) then
                call IssueTargetOrderBJ(GetEnumUnit(), "attack", gg_unit_hars_1465)
            else
                call ForGroupBJ(udg_Group_SpawnedSkeletons, function Trig_SkeletonGroupCheckAttackState_Func005Func001Func002Func002A)
            endif
        endif
    endif
endfunction

