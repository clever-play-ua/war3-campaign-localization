//===========================================================================
// Trigger: MidgameSetup
//===========================================================================
function Trig_MidgameSetup_Func007A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_MidgameSetup_Func027001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true )
endfunction

function Trig_MidgameSetup_Func027A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_MidgameSetup_Func030002 takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_KnightResetRange01))
endfunction

function Trig_MidgameSetup_Func031002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_MidgameSetup_Func032002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_MidgameSetup_Func033002 takes nothing returns nothing
    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_Sheeps))
endfunction

function Trig_MidgameSetup_Func071002 takes nothing returns nothing
    call SetUnitAnimation(GetEnumUnit(), "birth")
endfunction

function Trig_MidgameSetup_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_Setup_Cinematic_Frame)
    // //
    // Clean Up remnants of Humans on the island
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_FenrisIsland, udg_Player_Azerothiens), function Trig_MidgameSetup_Func007A)
    // //
    // Fog
    // //
    call SetTerrainFogExBJ(0, 1500.00, 6500.00, 0.50, 32.90, 52.90, 73.72)
    call SetDoodadAnimationRectBJ("stand", 'D64K', gg_rct_WallpaperDoodadLake)
    call SetDoodadAnimationRectBJ("stand", 'DLow', gg_rct_ArrivalCinLightControl)
    // UnloadTransportsIfTheyAreLoaded
    // //
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroTransportArr[1], GetRectCenter(gg_rct_MidgameShipArrive06), 150.83)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroTransportArr[2], GetRectCenter(gg_rct_MidgameShipArrive05), 94.66)
    call SetUnitPositionLocFacingBJ(udg_Unit_IntroTransportArr[3], GetRectCenter(gg_rct_MidgameShipArrive07), 245.82)
    // //
    call IssuePointOrderLocBJ(udg_Unit_IntroTransportArr[1], "unloadall", GetRectCenter(gg_rct_Unload01))
    call IssuePointOrderLocBJ(udg_Unit_IntroTransportArr[2], "unloadall", GetRectCenter(gg_rct_Unload02))
    call IssuePointOrderLocBJ(udg_Unit_IntroTransportArr[3], "unloadall", GetRectCenter(gg_rct_Unload03))
    // //
    // Move units
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_MidgameSetup_Func027001002)), function Trig_MidgameSetup_Func027A)
    // //
    call GroupAddUnitSimple(udg_Hero_Doomhammer, udg_Group_HiddenUnits)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_MidgameSetup_Func030002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_MidgameSetup_Func031002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_MidgameSetup_Func032002)
    call ForGroupBJ(udg_Group_FenrisSheeps, function Trig_MidgameSetup_Func033002)
    // Construction SItes
    call CreateNUnitsAtLoc(1, 'o614', udg_Player_Actual, GetRectCenter(gg_rct_BuildGreatHall), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o610', udg_Player_Actual, GetRectCenter(gg_rct_BuildBarracks), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60L', udg_Player_Actual, GetRectCenter(gg_rct_BuildBlacksmith), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60Z', udg_Player_Actual, GetRectCenter(gg_rct_BuildMill), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BuildFarm06), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BuildFarm05), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BuildFarm04), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BuildFarm03), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BuildFarm02), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BuildFarm01), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60V', udg_Player_Actual, GetRectCenter(gg_rct_BuildShipyard01), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60V', udg_Player_Actual, GetRectCenter(gg_rct_BuildShipyard02), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60W', udg_Player_Actual, GetRectCenter(gg_rct_BuildTower03), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60W', udg_Player_Actual, GetRectCenter(gg_rct_BuildTower02), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60W', udg_Player_Actual, GetRectCenter(gg_rct_BuildTower01), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BuildFarm07), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BuildFarm08), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_BuildFarm09), bj_UNIT_FACING)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_OrcBuildings)
    call ForGroupBJ(udg_Group_OrcBuildings, function Trig_MidgameSetup_Func071002)
    // Peons
    // //
    call RemoveUnit(gg_unit_o61X_0241)
    call RemoveUnit(gg_unit_o61X_0242)
    call RemoveUnit(gg_unit_o61X_0243)
    call RemoveUnit(gg_unit_o61X_0244)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_PatrolGuard03), GetRectCenter(gg_rct_BuildBarracks))
    set udg_Unit_PeonArr[1]=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "lumber", udg_Unit_PeonArr[1])
    call SetUnitAnimation(udg_Unit_PeonArr[1], "stand work")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_Peon05), GetRectCenter(gg_rct_BuildFarm06))
    set udg_Unit_PeonArr[2]=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "lumber", udg_Unit_PeonArr[2])
    call SetUnitAnimation(udg_Unit_PeonArr[2], "stand work")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_Peon04), GetRectCenter(gg_rct_BuildFarm04))
    set udg_Unit_PeonArr[3]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_PeonArr[3], "stand work")
    call AddUnitAnimationPropertiesBJ(true, "lumber", udg_Unit_PeonArr[3])
    call SetUnitAnimation(udg_Unit_PeonArr[3], "stand work")
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61X', udg_Player_Actual, GetRectCenter(gg_rct_Peon01), GetRectCenter(gg_rct_Peon03))
    set udg_Unit_PeonArr[4]=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "lumber", udg_Unit_PeonArr[4])
    call UnitAddAbilityBJ('A62Y', udg_Unit_PeonArr[4])
    call SetUnitBlendTimeBJ(udg_Unit_PeonArr[4], 0.50)
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.01)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeTharbek, GetRectCenter(gg_rct_PatrolGuard01), 105.00)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeDoomhammer, GetRectCenter(gg_rct_MidgameOrgrim01), 225.00)
    // //
    // Ships
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60Q', udg_Player_Actual, GetRectCenter(gg_rct_MidgameShipStart01), GetRectCenter(gg_rct_MidgameShipArrive01))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    set udg_Unit_OrcShipArr[1]=GetLastCreatedUnit()
    call SetUnitScalePercent(udg_Unit_OrcShipArr[1], 150.00, 150.00, 150.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60Q', udg_Player_Actual, GetRectCenter(gg_rct_MidgameShipStart02), GetRectCenter(gg_rct_MidgameShipArrive02))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    set udg_Unit_OrcShipArr[2]=GetLastCreatedUnit()
    call SetUnitScalePercent(udg_Unit_OrcShipArr[2], 150.00, 150.00, 150.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60S', udg_Player_Actual, GetRectCenter(gg_rct_MidgameJuggernaurtStart01), GetRectCenter(gg_rct_MidgameJuggernaurtArrive02))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    set udg_Unit_OrcShipArr[3]=GetLastCreatedUnit()
    call SetUnitLifePercentBJ(udg_Unit_OrcShipArr[3], 50.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60R', udg_Player_Actual, GetRectCenter(gg_rct_MidgameDestroyerStart01), GetRectCenter(gg_rct_MidgameDestroyerArrive02))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    set udg_Unit_OrcShipArr[4]=GetLastCreatedUnit()
    call SetUnitLifePercentBJ(udg_Unit_OrcShipArr[4], 75.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60R', udg_Player_Actual, GetRectCenter(gg_rct_MidgameDestroyerStart02), GetRectCenter(gg_rct_MidgameDestroyerArrive03))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    set udg_Unit_OrcShipArr[5]=GetLastCreatedUnit()
    call SetUnitLifePercentBJ(udg_Unit_OrcShipArr[5], 60.00)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'h000', udg_Player_Actual, GetRectCenter(gg_rct_MidgameZeppelinStart01), GetRectCenter(gg_rct_MidgameZeppelinArrive01))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    set udg_Unit_OrcShipArr[6]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60Q', udg_Player_Actual, GetRectCenter(gg_rct_MidgameShipArrive04), GetRectCenter(gg_rct_ReinforcementGrunt01))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60Q', udg_Player_Actual, GetRectCenter(gg_rct_MidgameShipArrive03), GetRectCenter(gg_rct_ReinforcementGrunt04))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60S', udg_Player_Actual, GetRectCenter(gg_rct_MidgameJuggernaurtArrive01), GetRectCenter(gg_rct_ReinforcementGrunt02))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o60R', udg_Player_Actual, GetRectCenter(gg_rct_MidgameDestroyerArrive01), GetRectCenter(gg_rct_MidgameShipArrive03))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o604', udg_Player_Actual, GetRectCenter(gg_rct_MidgameTurtleArrive01), GetRectCenter(gg_rct_ReinforcementGrunt03))
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    // //
    call CreateNUnitsAtLoc(1, 'o61V', udg_Player_Actual, GetRectCenter(gg_rct_ReinforcementGrunt01), 315.00)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_SNOW)
    call CreateNUnitsAtLoc(1, 'o61V', udg_Player_Actual, GetRectCenter(gg_rct_ReinforcementGrunt02), 315.00)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_SNOW)
    call CreateNUnitsAtLoc(1, 'o61V', udg_Player_Actual, GetRectCenter(gg_rct_ReinforcementGrunt03), 315.00)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_SNOW)
    call CreateNUnitsAtLoc(1, 'o61V', udg_Player_Actual, GetRectCenter(gg_rct_ReinforcementGrunt04), 315.00)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_SNOW)
    // //
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_Actual, GetRectCenter(gg_rct_ReinforcementBrute01), 315.00)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_Actual, GetRectCenter(gg_rct_ReinforcementBrute02), 315.00)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_Actual, GetRectCenter(gg_rct_ReinforcementBrute03), 315.00)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    call CreateNUnitsAtLoc(1, 'o619', udg_Player_Actual, GetRectCenter(gg_rct_ReinforcementBrute04), 315.00)
    call SetUnitColor(GetLastCreatedUnit(), PLAYER_COLOR_COAL)
    // //
    call CreateNUnitsAtLoc(1, 'n00L', Player(PLAYER_NEUTRAL_PASSIVE), GetRectCenter(gg_rct_MidgameMaim02), bj_UNIT_FACING)
    set udg_Unit_CinematicHeadPointer[1]=GetLastCreatedUnit()
    // //
    // //
    // //
    // //
endfunction

//===========================================================================
function InitTrig_MidgameSetup takes nothing returns nothing
    set gg_trg_MidgameSetup=CreateTrigger()
    call TriggerAddAction(gg_trg_MidgameSetup, function Trig_MidgameSetup_Actions)
endfunction

