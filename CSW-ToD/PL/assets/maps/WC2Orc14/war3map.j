// Trigger: P10PlayerMarineLandingOrder
//===========================================================================
function Trig_P10PlayerMarineLandingOrder_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( udg_LandingWarfareHasRan[10] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10PlayerMarineLandingOrder_Func003Func003A takes nothing returns nothing
    local integer isc
    set isc=s__IndexShipCargo_struct[GetUnitUserData(GetEnumUnit())]
    if IsUnitInRangeXY(GetEnumUnit(), s__IndexShipCargo_xC[isc], s__IndexShipCargo_yC[isc], udg_DepartureDetectionRange) or not IsUnitInGroup(GetEnumUnit(), udg_DestinationDetectionGroup[10]) then
    call IssuePointOrderById(GetEnumUnit(), 851986, udg_AttackOrderPointerX[10], udg_AttackOrderPointerY[10])
    elseif IsUnitInGroup(GetEnumUnit(), udg_DestinationDetectionGroup[10]) then
    call IssuePointOrderLocBJ(GetEnumUnit(), "unloadall", udg_MarineLandingPoint[10])
    endif
endfunction

function Trig_P10PlayerMarineLandingOrder_Func003C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_DepartedTransports[10]) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P10PlayerMarineLandingOrder_Actions takes nothing returns nothing
    set udg_LandingWarfareHasRan[10]=true
    if ( Trig_P10PlayerMarineLandingOrder_Func003C() ) then
        set udg_MarineLandingPoint[10]=Location(udg_AttackOrderPointerX[10], udg_AttackOrderPointerY[10])
        call GroupEnumUnitsInRange(udg_DestinationDetectionGroup[10], udg_AttackOrderPointerX[10], udg_AttackOrderPointerY[10], udg_DestinationDetectionRange, null)
        call ForGroupBJ(udg_DepartedTransports[10], function Trig_P10PlayerMarineLandingOrder_Func003Func003A)
        call RemoveLocation(udg_MarineLandingPoint[10])
        call GroupClear(udg_DestinationDetectionGroup[10])
    else
    endif
    set udg_LandingWarfareHasRan[10]=false
endfunction

