function Trig_CinHeadPointerMoves02_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call IssuePointOrderLocBJ(udg_Unit_CinematicHeadPointer[1], "move", GetRectCenter(gg_rct_MidgameZuluhed02))
    set udg_Point_CinHeadPointerTemp=GetUnitLoc(udg_Unit_CinematicHeadPointer[1])
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_CinHeadPointerTemp, GetRectCenter(gg_rct_MidgameZuluhed02)) / GetUnitMoveSpeed(udg_Unit_CinematicHeadPointer[1]) ))
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ResetUnitLookAt(udg_FakeDoomhammer)
endfunction

