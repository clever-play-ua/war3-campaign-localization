function Trig_AI_P10_Marines_Teleport_Manual_Func006C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'hPaM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'hMaM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'hKAM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'hBoM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'hFAM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'hBAM' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'h9ZW' ) ) then
        return true
    endif
    return false
endfunction

function Trig_AI_P10_Marines_Teleport_Manual_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( IsQuestCompleted(udg_QMLordaeronHarbour) == false ) ) then
        return false
    endif
    if ( not Trig_AI_P10_Marines_Teleport_Manual_Func006C() ) then
        return false
    endif
    return true
endfunction

