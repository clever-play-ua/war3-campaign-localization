        call PlaySoundOnUnitBJ(gg_snd_CS_H01b_Orc_gesture_v2, 80.00, udg_SemiHero_Utok)
        call QueueUnitAnimationBJ(udg_FakeUtok, "cinematic listening one")
    else
        call DoNothing()
    endif
    // //
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinMidgameSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call ResetUnitLookAt(udg_FakeDoomhammer)
    call IssuePointOrderLocBJ(udg_FakeDoomhammer, "move", GetRectCenter(gg_rct_DoomhammerAndUtokWalkIn))
