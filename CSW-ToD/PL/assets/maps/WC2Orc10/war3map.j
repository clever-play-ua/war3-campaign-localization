//===========================================================================
// Trigger: MaraFordragonDies
//===========================================================================
function Trig_MaraFordragonDies_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetDyingUnit() == udg_Hero_MaraFordragon ) ) then
        return false
    endif
    if ( not ( IsQuestDiscovered(udg_MQLastStand) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MaraFordragonDies_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestItemSetCompletedBJ(udg_QReq_LastStandMara, true)
    call DestroyMinimapIcon(udg_MinimapIcon_Mara)
    // //
    call ReplaceUnitBJ(udg_Hero_MaraFordragon, 'HMFC', bj_UNIT_STATE_METHOD_DEFAULTS)
    set udg_Hero_MaraFordragon=GetLastReplacedUnitBJ()
    call UnitRemoveAbilityBJ('AHds', udg_Hero_MaraFordragon)
    // //
    call SetUnitTimeScalePercent(udg_Hero_MaraFordragon, 50.00)
    call SetUnitInvulnerable(udg_Hero_MaraFordragon, true)
    call PauseUnitBJ(true, udg_Hero_MaraFordragon)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_MaraFordragon, 'H008', gg_snd_WC2Orc10MaraFordragon_BossFight2, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call PauseUnitBJ(false, udg_Hero_MaraFordragon)
    call SetUnitInvulnerable(udg_Hero_MaraFordragon, false)
    set udg_TempPointA=GetUnitLoc(udg_Hero_MaraFordragon)
    call CreateItemLoc('schl', udg_TempPointA)
    call RemoveLocation(udg_TempPointA)
    call KillUnit(udg_Hero_MaraFordragon)
    // //
    call ConditionalTriggerExecute(gg_trg_MainQuestLastStandUpdated)
endfunction

//===========================================================================
function InitTrig_MaraFordragonDies takes nothing returns nothing
    set gg_trg_MaraFordragonDies=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MaraFordragonDies, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_MaraFordragonDies, Condition(function Trig_MaraFordragonDies_Conditions))
    call TriggerAddAction(gg_trg_MaraFordragonDies, function Trig_MaraFordragonDies_Actions)
endfunction

//===========================================================================
// Trigger: PaladinLastStandDies
//===========================================================================
function Trig_PaladinLastStandDies_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetDyingUnit(), udg_Group_SilverHandLastStand) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_PaladinLastStandDies_Func006C takes nothing returns boolean
    if ( not ( udg_Int_MQLastStandPaladinsCount == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PaladinLastStandDies_Actions takes nothing returns nothing
    // //
    call GroupRemoveUnitSimple(GetDyingUnit(), udg_Group_SilverHandLastStand)
    set udg_Int_MQLastStandPaladinsCount=CountUnitsInGroup(udg_Group_SilverHandLastStand)
    call LeaderboardSetPlayerItemValueBJ(Player(1), udg_Leaderboard_Quests, udg_Int_MQLastStandPaladinsCount)
    // //
    if ( Trig_PaladinLastStandDies_Func006C() ) then
        call QuestItemSetCompletedBJ(udg_QReq_LastStandPaladins, true)
        call ConditionalTriggerExecute(gg_trg_MainQuestLastStandUpdated)
    else
    endif
endfunction

//===========================================================================
function InitTrig_PaladinLastStandDies takes nothing returns nothing
    set gg_trg_PaladinLastStandDies=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_PaladinLastStandDies, Player(9), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_PaladinLastStandDies, Condition(function Trig_PaladinLastStandDies_Conditions))
    call TriggerAddAction(gg_trg_PaladinLastStandDies, function Trig_PaladinLastStandDies_Actions)
endfunction

//===========================================================================
// Trigger: MaraFordragonEncounterLastStand
//===========================================================================
function Trig_MaraFordragonEncounterLastStand_Func005A takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), false)
    call PauseUnitBJ(false, GetEnumUnit())
    call IssueImmediateOrderBJ(GetEnumUnit(), "holdposition")
endfunction

function Trig_MaraFordragonEncounterLastStand_Func017A takes nothing returns nothing
    call IssueImmediateOrderBJ(GetEnumUnit(), "stop")
endfunction

function Trig_MaraFordragonEncounterLastStand_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ForGroupBJ(udg_Group_SilverHandLastStand, function Trig_MaraFordragonEncounterLastStand_Func005A)
    // //
    call SetUnitInvulnerable(gg_unit_h617_0001, false)
    // //
    call SetUnitInvulnerable(udg_Hero_MaraFordragon, false)
    call PauseUnitBJ(false, udg_Hero_MaraFordragon)
    call IssueImmediateOrderBJ(udg_Hero_MaraFordragon, "holdposition")
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_MaraFordragon, 'H008', gg_snd_WC2Orc10MaraFordragon_BossFight1, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call ForGroupBJ(udg_Group_SilverHandLastStand, function Trig_MaraFordragonEncounterLastStand_Func017A)
endfunction

