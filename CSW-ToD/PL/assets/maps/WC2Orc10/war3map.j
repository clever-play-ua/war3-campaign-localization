//===========================================================================
// Trigger: MainQuestLastStandCompletedQ
//===========================================================================
function Trig_MainQuestLastStandCompletedQ_Func013C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQAllianceOil) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_FinalCinQ) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestLastStandCompletedQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetCompletedBJ(udg_MQLastStand, true)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3469")
    // //
    call DestroyFogModifier(udg_VisMod_LastStand)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    if ( Trig_MainQuestLastStandCompletedQ_Func013C() ) then
        call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
        call QueuedTriggerClearInactiveBJ()
        call QueuedTriggerAddBJ(gg_trg_FinalCinQ, true)
    else
        call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    endif
endfunction

