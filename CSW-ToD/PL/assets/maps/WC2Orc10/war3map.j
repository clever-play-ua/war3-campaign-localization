function Trig_MainQuestStratholmeUpdatedTH_Conditions takes nothing returns boolean
    if ( not ( IsUnitDeadBJ(udg_Unit_MQStratTHArr[1]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(udg_Unit_MQStratTHArr[2]) == true ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(udg_Unit_MQStratTHArr[3]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestStratholmeUpdatedTH_Func007C takes nothing returns boolean
    if ( not ( IsQuestItemCompleted(udg_QReq_StratholmeWatch[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestStratholmeUpdatedTH_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestItemSetCompletedBJ(udg_QReq_StratholmeTownHalls[1], true)
    // //
    if ( Trig_MainQuestStratholmeUpdatedTH_Func007C() ) then
        call QueuedTriggerAddBJ(gg_trg_MainQuestStratholmeCompletedQ, true)
    else
        call TriggerSleepAction(2.00)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_3968")
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    endif
    // //
endfunction

