    call SetUnitOwner(udg_FakeMograine, udg_Player_SilverHand, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeMara, GetRectCenter(gg_rct_SilverhandCinMara01), 127.71)
    call SetUnitOwner(udg_FakeMara, udg_Player_SilverHand, true)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeAlonso, GetRectCenter(gg_rct_SilverhandCinAlonso01), 290.05)
    call SetUnitOwner(udg_FakeAlonso, udg_Player_SilverHand, true)
    // //
    call CreateNUnitsAtLoc(1, 'h623', udg_Player_SilverHand, GetRectCenter(gg_rct_SilverhandCinematicGuard), bj_UNIT_FACING)
    set udg_Unit_SilverHandCinGuard=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_Unit_SilverHandCinGuard)
    call SetUnitAnimation(udg_Unit_SilverHandCinGuard, "cinematic stand")
    call SetUnitBlendTimeBJ(udg_Unit_SilverHandCinGuard, 0.75)
    // //
    // //
endfunction

