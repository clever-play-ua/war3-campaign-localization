    return ( udg_Bool_CinBuildCampSkipped == true )
endfunction

function Trig_BuildBaseCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_CinematicPrepIn)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    // SetUp
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call SetCineModeVolumeGroupsBJ()
    call CameraSetupApplyForPlayer(true, gg_cam_BuildCamp01, udg_Player_Actual, 0)
    call ConditionalTriggerExecute(gg_trg_BuildBaseCinematicSetUp)
    // //
    call TriggerSleepAction(1.00)
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_BuildCamp02, udg_Player_Actual, 15.00, 0, 3.00, 0)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // Cinematic started
    call PlaySoundBJ(gg_snd_mus_60_ogremines_b)
    // //
    set udg_Bool_CinBuildCampOn=true
    call TriggerSleepAction(2)
    if ( (udg_Bool_CinBuildCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc10ChoGall1, bj_TIMETYPE_ADD, 0, false)
    call TriggerSleepAction(12.00)
    if ( (udg_Bool_CinBuildCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // StratholmePort
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinBuildCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ShipPort02, udg_Player_Actual, 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinBuildCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_ShipPort01, udg_Player_Actual, 11.00)
    // //
    call StopSoundBJ(gg_snd_mus_60_ogremines_b, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc10ChoGall2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinBuildCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // //
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_BuildBaseCinematicCleanUp)
endfunction

