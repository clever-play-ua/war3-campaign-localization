//===========================================================================
// Trigger: CinematicPrepIn
//===========================================================================
function Trig_CinematicPrepIn_Func009002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_SelectedUnits)
endfunction

function Trig_CinematicPrepIn_Func013C takes nothing returns boolean
    if ( not ( udg_Bool_PlaceOfPowerHordeOwned == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_CinematicPrepIn_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Music_CurrentVolume=0.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    set udg_VarPlayerCamera=GetCurrentCameraSetup()
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIHide)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsSelectedAll(udg_Player_Actual), function Trig_CinematicPrepIn_Func009002)
    // //
    call ClearSelectionForPlayer(udg_Player_Actual)
    // //
    if ( Trig_CinematicPrepIn_Func013C() ) then
        call SetUnitOwner(udg_Unit_PlaceOfPower, Player(PLAYER_NEUTRAL_PASSIVE), false)
    else
    endif
    // //
    call TriggerSleepAction(2)
    // //
endfunction

//===========================================================================
function InitTrig_CinematicPrepIn takes nothing returns nothing
    set gg_trg_CinematicPrepIn=CreateTrigger()
    call TriggerAddAction(gg_trg_CinematicPrepIn, function Trig_CinematicPrepIn_Actions)
endfunction

//===========================================================================
// Trigger: CinematicPrepOut
//===========================================================================
function Trig_CinematicPrepOut_Func011C takes nothing returns boolean
    if ( not ( udg_Bool_PlaceOfPowerHordeOwned == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_CinematicPrepOut_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ConditionalTriggerExecute(gg_trg_OilUIShow)
    // //
    call SelectGroupForPlayerBJ(udg_Group_SelectedUnits, udg_Player_Actual)
    call GroupRemoveGroup(udg_Group_SelectedUnits, udg_Group_SelectedUnits)
    // //
    call ResetToGameCameraForPlayer(udg_Player_Actual, 0)
    // //
    if ( Trig_CinematicPrepOut_Func011C() ) then
        call SetUnitOwner(udg_Unit_PlaceOfPower, udg_Player_Actual, false)
    else
        call SetUnitOwner(udg_Unit_PlaceOfPower, udg_Player_Lordaeron, false)
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_LaunchInGameMusic)
endfunction

//===========================================================================
function InitTrig_CinematicPrepOut takes nothing returns nothing
    set gg_trg_CinematicPrepOut=CreateTrigger()
    call TriggerAddAction(gg_trg_CinematicPrepOut, function Trig_CinematicPrepOut_Actions)
endfunction

//===========================================================================
// Trigger: LaunchInGameMusic
//===========================================================================
function Trig_LaunchInGameMusic_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Music_CurrentVolume < 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LaunchInGameMusic_Actions takes nothing returns nothing
    call PlayMusicBJ(udg_Music_CurrentName)
    set udg_Int_C=1
    loop
        exitwhen udg_Int_C > 100
        if ( Trig_LaunchInGameMusic_Func002Func001C() ) then
            set udg_Music_CurrentVolume=( udg_Music_CurrentVolume + 1 )
            call SetMusicVolumeBJ(udg_Music_CurrentVolume)
            call TriggerSleepAction(0.02)
        else
        endif
        set udg_Int_C=udg_Int_C + 1
    endloop
endfunction

