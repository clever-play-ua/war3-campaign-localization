//===========================================================================
function Trig_P02_Attacker_Being_Attacked_Func005C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetAttacker()) == 'h9Zx' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetAttacker()) == 'h9Zy' ) ) then
        return true
    endif
    return false
endfunction

function Trig_P02_Attacker_Being_Attacked_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetAttacker()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not Trig_P02_Attacker_Being_Attacked_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_P02_Attacker_Being_Attacked_Func002Func001Func001A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, 410)
endfunction

function Trig_P02_Attacker_Being_Attacked_Func002Func001Func002A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, 474)
endfunction

function Trig_P02_Attacker_Being_Attacked_Func002Func001Func004A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, - 2147483238)
endfunction

function Trig_P02_Attacker_Being_Attacked_Func002Func001Func005A takes nothing returns nothing
    call BlzSetUnitWeaponIntegerField(GetEnumUnit(), UNIT_WEAPON_IF_ATTACK_TARGETS_ALLOWED, 0, - 2147483174)
endfunction

function Trig_P02_Attacker_Being_Attacked_Func002Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_ANCIENT) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_P02_Attacker_Being_Attacked_Func002Func002A takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(GetEnumUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
endfunction

function Trig_P02_Attacker_Being_Attacked_Func002Func004A takes nothing returns nothing
    call BlzSetUnitWeaponBooleanFieldBJ(GetEnumUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)
endfunction

function Trig_P02_Attacker_Being_Attacked_Func002C takes nothing returns boolean
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_FLYING) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P02_Attacker_Being_Attacked_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_P02_Attacker_Being_Attacked_Func002C() ) then
        call ForGroupBJ(udg_G_P02_AttackerFrg, function Trig_P02_Attacker_Being_Attacked_Func002Func002A)
        call PolledWait(6.00)
        call ForGroupBJ(udg_G_P02_AttackerFrg, function Trig_P02_Attacker_Being_Attacked_Func002Func004A)
    else
        if ( Trig_P02_Attacker_Being_Attacked_Func002Func001C() ) then
            call ForGroupBJ(udg_G_P02_AttackerFrg, function Trig_P02_Attacker_Being_Attacked_Func002Func001Func001A)
            call ForGroupBJ(udg_G_P02_AttackerBS, function Trig_P02_Attacker_Being_Attacked_Func002Func001Func002A)
            call PolledWait(6.00)
            call ForGroupBJ(udg_G_P02_AttackerFrg, function Trig_P02_Attacker_Being_Attacked_Func002Func001Func004A)
            call ForGroupBJ(udg_G_P02_AttackerBS, function Trig_P02_Attacker_Being_Attacked_Func002Func001Func005A)
        else
        endif
    endif
    call EnableTrigger(GetTriggeringTrigger())
endfunction

