function Trig_FinalCinSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_FinalCinRemoveUnits, udg_Player_StratholmeCityWatch), function Trig_FinalCinSetUp_Func006A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_FinalCinRemoveUnits, udg_Player_AllianceNavy), function Trig_FinalCinSetUp_Func008A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_FinalCinRemoveUnits, udg_Player_NavyDummy), function Trig_FinalCinSetUp_Func010A)
    // //
    call SetDoodadAnimationRectBJ("Stand", 'YOtf', gg_rct_GateFire01)
    call SetDoodadAnimationRectBJ("Stand", 'YOf3', gg_rct_GateFire01)
    call SetDoodadAnimationRectBJ("Stand", 'YOfs', gg_rct_GateFire01)
    // //
    call ShowUnitHide(udg_Hero_Chogall)
    call PauseUnitBJ(true, udg_Hero_Chogall)
    // //
    call ShowUnitHide(udg_Hero_DoomHammer)
    call PauseUnitBJ(true, udg_Hero_DoomHammer)
    // //
    call ShowUnitHide(udg_Hero_Guldan)
    call PauseUnitBJ(true, udg_Hero_Guldan)
    // //
    call ShowUnitHide(udg_SemiHero_TeronDK)
    call PauseUnitBJ(true, udg_SemiHero_TeronDK)
    // //
    call ShowUnitHide(udg_SemiHero_Utok)
    call PauseUnitBJ(true, udg_SemiHero_Utok)
    // //
    call TriggerSleepAction(0.10)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeDoomhammer, GetRectCenter(gg_rct_FinalOrgrim), 221.32)
    call BlzSetUnitSkin(udg_FakeDoomhammer, 'ODCN')
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeDoomhammer)
    call SetUnitMoveSpeed(udg_FakeDoomhammer, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeDoomhammer, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitBlendTimeBJ(udg_FakeDoomhammer, 0.50)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeGuldan, GetRectCenter(gg_rct_FinalGuldan), 102.26)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_FinalChogall), 39.68)
    // //
    call CreateNUnitsAtLoc(1, 'o60S', udg_Player_TwilightHammerClan, GetRectCenter(gg_rct_FinalCinJuggernaurt), 46.93)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeTeronDK, GetRectCenter(gg_rct_FinalTeron01), 15.84)
    call SetUnitAnimationWithRarity(GetLastCreatedUnit(), "stand", RARITY_FREQUENT)
    // //
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', udg_Player_BlackRockClan, GetRectCenter(gg_rct_FinalGrunt01), GetRectCenter(gg_rct_FinalOrgrim))
    call SetUnitAnimationWithRarity(GetLastCreatedUnit(), "stand", RARITY_FREQUENT)
    call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_FinalCinOrcs)
    call CreateNUnitsAtLocFacingLocBJ(1, 'o61W', udg_Player_BlackRockClan, GetRectCenter(gg_rct_FinalGrunt08), GetRectCenter(gg_rct_FinalOrgrim))
    call SetUnitAnimationWithRarity(GetLastCreatedUnit(), "stand", RARITY_FREQUENT)
