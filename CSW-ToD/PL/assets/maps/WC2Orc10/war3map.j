    call TriggerRegisterTimerExpireEventBJ(gg_trg_OptionalQuestWallsDiscovered, udg_Timer_KaboomDiscover)
    call TriggerAddAction(gg_trg_OptionalQuestWallsDiscovered, function Trig_OptionalQuestWallsDiscovered_Actions)
