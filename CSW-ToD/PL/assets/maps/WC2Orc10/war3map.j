//===========================================================================
// Trigger: P02StartAI
//===========================================================================
function Trig_P02StartAI_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetPlayerStateBJ(udg_Player_AllianceNavy, PLAYER_STATE_RESOURCE_GOLD, 10000)
    call SetPlayerStateBJ(udg_Player_AllianceNavy, PLAYER_STATE_RESOURCE_LUMBER, 10000)
    call SetPlayerStateBJ(udg_Player_AllianceNavy, PLAYER_STATE_RESOURCE_FOOD_CAP, 100)
    // //
    call EnableTrigger(gg_trg_P02Gold)
    call EnableTrigger(gg_trg_P02Lumber)
    // //
    call IssueTargetOrderBJ(gg_unit_h600_0449, "smart", gg_unit_u600_0005)
    call IssueTargetOrderBJ(gg_unit_h600_0427, "smart", gg_unit_u600_0004)
    call IssueTargetOrderBJ(gg_unit_h600_0426, "smart", gg_unit_u600_0006)
    call IssueTargetOrderBJ(gg_unit_h600_0425, "smart", gg_unit_u600_0073)
    // //
    call StartCampaignAI(udg_Player_AllianceNavy, "CSW/Scripts/ToDScripts/WC2Orc10/WC2Orc10P02AllianceNavalAI.ai")
    // //
    call StartTimerBJ(udg_Timer_P2DelayFirstAttack, false, GetRandomReal(udg_Real_P2DelayFirstAttackBot, udg_Real_P2DelayFirstAttackTop))
    // //
    call EnableTrigger(gg_trg_P02AliveBuildingChecker)
endfunction

//===========================================================================
function InitTrig_P02StartAI takes nothing returns nothing
    set gg_trg_P02StartAI=CreateTrigger()
    call TriggerAddAction(gg_trg_P02StartAI, function Trig_P02StartAI_Actions)
endfunction

