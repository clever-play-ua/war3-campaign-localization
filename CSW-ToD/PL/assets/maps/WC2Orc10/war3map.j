    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'o60V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BuildBaseCinematicSetUp_Func050Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'o60N' ) ) then
        return false
    endif
    return true
endfunction

