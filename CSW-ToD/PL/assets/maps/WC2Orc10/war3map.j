//===========================================================================
// Trigger: OptionalQuestAllianceBaseFailedQ
//===========================================================================
function Trig_OptionalQuestAllianceBaseFailedQ_Conditions takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_OQAllianceCamp) == true ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OptionalQuestAllianceBaseFailedQ_Func002Func007001001002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_OptionalQuestAllianceBaseFailedQ_Func002Func007001001002002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == Player(14) )
endfunction

function Trig_OptionalQuestAllianceBaseFailedQ_Func002Func007001001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_OptionalQuestAllianceBaseFailedQ_Func002Func007001001002002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == Player(14)), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_OptionalQuestAllianceBaseFailedQ_Func002Func007001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == Player(14)), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_OptionalQuestAllianceBaseFailedQ_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_P15BuildingChecker, Condition(function Trig_OptionalQuestAllianceBaseFailedQ_Func002Func007001001002))) != 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OptionalQuestAllianceBaseFailedQ_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_OptionalQuestAllianceBaseFailedQ_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QuestSetFailedBJ(udg_OQAllianceCamp, true)
        call DestroyMinimapIcon(udg_MinimapIcon_AllianceCamp)
        call DestroyFogModifier(udg_VisMod_AllianceCamp)
        call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_FAILED, "TRIGSTR_3713")
    else
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

