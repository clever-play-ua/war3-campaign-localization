    if ( not ( GetSpellAbilityId() == 'XDQ1' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_I_Doomstrike_Func012Func001Func003C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'LTcr' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'LTbx' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'LTbs' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'LTbr' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'LTba' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'LTex' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B615' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Doomhammer_I_Doomstrike_Func012Func001Func004Func002Func002C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('XDQ1', GetTriggerUnit()) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_I_Doomstrike_Func012Func001Func004Func002C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('XDQ1', GetTriggerUnit()) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_I_Doomstrike_Func012Func001Func004C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('XDQ1', GetTriggerUnit()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_I_Doomstrike_Func012Func001C takes nothing returns boolean
    if ( not ( IsDestructableAliveBJ(GetEnumDestructable()) == true ) ) then
        return false
    endif
    if ( not ( IsDestructableInvulnerableBJ(GetEnumDestructable()) == false ) ) then
        return false
    endif
    if ( not Trig_Doomhammer_I_Doomstrike_Func012Func001Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Doomhammer_I_Doomstrike_Func012A takes nothing returns nothing
    if ( Trig_Doomhammer_I_Doomstrike_Func012Func001C() ) then
        if ( Trig_Doomhammer_I_Doomstrike_Func012Func001Func004C() ) then
            call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 100.00 ))
        else
            if ( Trig_Doomhammer_I_Doomstrike_Func012Func001Func004Func002C() ) then
                call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 175.00 ))
            else
                if ( Trig_Doomhammer_I_Doomstrike_Func012Func001Func004Func002Func002C() ) then
                    call SetDestructableLife(GetEnumDestructable(), ( GetDestructableLife(GetEnumDestructable()) - 250.00 ))
                else
                endif
            endif
        endif
    else
    endif
endfunction

function Trig_Doomhammer_I_Doomstrike_Actions takes nothing returns nothing
    set udg_Doomhammer_TempPoint_Q=GetSpellTargetLoc()
    //  
    // Dummy (Spells)
    call CreateNUnitsAtLoc(1, 'u003', GetOwningPlayer(GetTriggerUnit()), udg_Doomhammer_TempPoint_Q, bj_UNIT_FACING)
    set udg_Doomhammer_Dummy_Q=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(2.00, 'BTLF', udg_Doomhammer_Dummy_Q)
    // Ability: Doomstrike (Doomhammer - Effect)
    call UnitAddAbilityBJ('X00E', udg_Doomhammer_Dummy_Q)
    call SetUnitAbilityLevelSwapped('X00E', udg_Doomhammer_Dummy_Q, GetUnitAbilityLevelSwapped('XDQ1', GetTriggerUnit()))
    call IssueImmediateOrderBJ(udg_Doomhammer_Dummy_Q, "thunderclap")
    //  
    call EnumDestructablesInCircleBJ(300.00, udg_Doomhammer_TempPoint_Q, function Trig_Doomhammer_I_Doomstrike_Func012A)
    //  
    call RemoveLocation(udg_Doomhammer_TempPoint_Q)
endfunction

