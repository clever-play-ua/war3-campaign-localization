function Trig_DeathKnightsCinematicSetUp_Func018A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_DeathKnightsCinematicSetUp_Func020A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

