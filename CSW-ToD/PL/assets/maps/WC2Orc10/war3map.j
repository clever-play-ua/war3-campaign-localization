    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_CityWallArchers)
endfunction

function Trig_InitPlayerAlliance_Func104Func004C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_InitPlayerAlliance_Func104C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_InitPlayerAlliance_Func108Func002C takes nothing returns boolean
    if ( not ( ModuloInteger(udg_Int_WallArchersCount, udg_Int_N) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_InitPlayerAlliance_Func108A takes nothing returns nothing
    set udg_Int_WallArchersCount=( udg_Int_WallArchersCount + 1 )
    if ( Trig_InitPlayerAlliance_Func108Func002C() ) then
        call RemoveUnit(GetEnumUnit())
    else
    endif
endfunction

function Trig_InitPlayerAlliance_Actions takes nothing returns nothing
    // Alliances
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_StratholmeCityWatch, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StratholmeCityWatch, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_SilverHand, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_SilverHand, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_AllianceNavy, Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Player_AllianceNavy, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_Lordaeron, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_SilverHand, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_SilverHand, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_StratholmeCityWatch, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StratholmeCityWatch, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_StratholmeWatchDummy, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_StratholmeWatchDummy, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_AllianceNavy, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_AllianceNavy, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    // //
    call SetPlayerColorBJ(udg_Player_AllianceNavy, PLAYER_COLOR_LIGHT_BLUE, true)
    call SetPlayerColorBJ(udg_Player_Lordaeron, PLAYER_COLOR_LIGHT_BLUE, true)
    call SetPlayerColorBJ(udg_Player_SilverHand, PLAYER_COLOR_SNOW, true)
    call SetPlayerColorBJ(udg_Player_StratholmeCityWatch, PLAYER_COLOR_BLUE, true)
    call SetPlayerColorBJ(udg_Player_NavyDummy, PLAYER_COLOR_LIGHT_BLUE, true)
    call SetPlayerStateBJ(udg_Player_AllianceNavy, PLAYER_STATE_RESOURCE_FOOD_CAP, 200)
    // //
    call SetPlayerOnScoreScreenBJ(false, udg_Player_NavyDummy)
    call SetPlayerOnScoreScreenBJ(false, udg_Player_CinematicDummy)
    // //
    // Heroes
    // //
    set udg_Hero_MaraFordragon=gg_unit_H008_0002
    set udg_Hero_AlonsusFaol=gg_unit_H628_0331
    // //
    call ConditionalTriggerExecute(gg_trg_InitAlexandros)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_CathedralDefenders, udg_Player_SilverHand), function Trig_InitPlayerAlliance_Func048A)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_LastStandEncounter, Condition(function Trig_InitPlayerAlliance_Func052001002)), function Trig_InitPlayerAlliance_Func052A)
    // //
    call ForGroupBJ(udg_Group_SilverHandLastStand, function Trig_InitPlayerAlliance_Func054002)
    call ForGroupBJ(udg_Group_SilverHandLastStand, function Trig_InitPlayerAlliance_Func055002)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CathedralDefenders, Condition(function Trig_InitPlayerAlliance_Func059001002)), function Trig_InitPlayerAlliance_Func059A)
    call ForGroupBJ(udg_Group_CathedralArchers, function Trig_InitPlayerAlliance_Func060002)
    call ForGroupBJ(udg_Group_CathedralArchers, function Trig_InitPlayerAlliance_Func061002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CathedralDefenders, Condition(function Trig_InitPlayerAlliance_Func064001002)), function Trig_InitPlayerAlliance_Func064A)
    call ForGroupBJ(udg_Group_CathedralBallistas, function Trig_InitPlayerAlliance_Func065002)
    call ForGroupBJ(udg_Group_CathedralBallistas, function Trig_InitPlayerAlliance_Func066002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GateFire01, Condition(function Trig_InitPlayerAlliance_Func069001002)), function Trig_InitPlayerAlliance_Func069A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GateFire02, Condition(function Trig_InitPlayerAlliance_Func071001002)), function Trig_InitPlayerAlliance_Func071A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GateFire03, Condition(function Trig_InitPlayerAlliance_Func073001002)), function Trig_InitPlayerAlliance_Func073A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_GateFire04, Condition(function Trig_InitPlayerAlliance_Func075001002)), function Trig_InitPlayerAlliance_Func075A)
    // //
    call ForGroupBJ(udg_Group_FireEmmitterUnits[1], function Trig_InitPlayerAlliance_Func077002)
    call ForGroupBJ(udg_Group_FireEmmitterUnits[2], function Trig_InitPlayerAlliance_Func078002)
    call ForGroupBJ(udg_Group_FireEmmitterUnits[3], function Trig_InitPlayerAlliance_Func079002)
    call ForGroupBJ(udg_Group_FireEmmitterUnits[4], function Trig_InitPlayerAlliance_Func080002)
    call ForGroupBJ(udg_Group_FireEmmitterUnits[5], function Trig_InitPlayerAlliance_Func081002)
    // //
    call ShowUnitHide(gg_unit_hASU_0936)
    call ShowUnitHide(gg_unit_hASU_0934)
    call ShowUnitHide(gg_unit_hASU_0933)
    call ShowUnitHide(gg_unit_hASU_0932)
    call ShowUnitHide(gg_unit_hASU_0935)
    // //
    call SetUnitAnimation(gg_unit_hDoF_0068, "cinematic guard one")
    call SetUnitAnimation(gg_unit_hDoF_0718, "cinematic guard one")
    call SetUnitAnimation(gg_unit_hDoF_0715, "cinematic guard one")
    // //
    // Misc
    call SetPlayerHandicapXPBJ(udg_Player_Lordaeron, 10.00)
    // Hide Keep For AI
    call ShowUnitHide(gg_unit_h61B_0930)
    // //
    // //
    // Lets remove some archers from the walls on the different difficulty
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_CityBoundaries, Condition(function Trig_InitPlayerAlliance_Func102001002)), function Trig_InitPlayerAlliance_Func102A)
    // //
    if ( Trig_InitPlayerAlliance_Func104C() ) then
        // Every second archer will be removed
        set udg_Int_N=2
    else
        if ( Trig_InitPlayerAlliance_Func104Func004C() ) then
            // Every third archer will be removed
            set udg_Int_N=3
        else
        endif
    endif
    // //
    set udg_Int_WallArchersCount=0
    // //
    call ForGroupBJ(udg_Group_CityWallArchers, function Trig_InitPlayerAlliance_Func108A)
    // //
    call DestroyGroup(udg_Group_CityWallArchers)
    // //
endfunction

//===========================================================================
function InitTrig_InitPlayerAlliance takes nothing returns nothing
    set gg_trg_InitPlayerAlliance=CreateTrigger()
    call TriggerAddAction(gg_trg_InitPlayerAlliance, function Trig_InitPlayerAlliance_Actions)
endfunction

