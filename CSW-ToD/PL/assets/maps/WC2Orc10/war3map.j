//===========================================================================
// Trigger: MainQuestStratholmeDiscoveredQ
//===========================================================================
function Trig_MainQuestStratholmeDiscoveredQ_Func041C takes nothing returns boolean
    if ( not ( IsQuestCompleted(udg_MQAllianceOil) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestStratholmeDiscoveredQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    // //
    call QuestSetDiscoveredBJ(udg_MQStratholme, true)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_329")
    // //
    call PingMinimapLocForForceEx(GetPlayersAll(), GetRectCenter(gg_rct_StratholmeQuest), 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_StratholmeQuest))
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_StratholmeQuest), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Stratholme=GetLastCreatedMinimapIcon()
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, GetRectCenter(gg_rct_StratholmeQuest), 1024.00)
    set udg_VisMod_StratholmeKeep=GetLastCreatedFogModifier()
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_CityTownHall01), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_TownHall01=GetLastCreatedMinimapIcon()
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, GetRectCenter(gg_rct_CityTownHall01), 256.00)
    set udg_VisMod_StratholmeTH01=GetLastCreatedFogModifier()
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_CityTownHall01))
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_CityTownHall02), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_TownHall02=GetLastCreatedMinimapIcon()
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, GetRectCenter(gg_rct_CityTownHall02), 256.00)
    set udg_VisMod_StratholmeTH02=GetLastCreatedFogModifier()
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_CityTownHall02))
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_CityTownHall03), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_TownHall03=GetLastCreatedMinimapIcon()
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, GetRectCenter(gg_rct_CityTownHall03), 256.00)
    set udg_VisMod_StratholmeTH03=GetLastCreatedFogModifier()
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_CityTownHall03))
    // //
    call SetUnitInvulnerable(udg_Unit_MQStratTHArr[1], false)
    call SetUnitInvulnerable(udg_Unit_MQStratTHArr[2], false)
    call SetUnitInvulnerable(udg_Unit_MQStratTHArr[3], false)
    // //
    call EnableTrigger(gg_trg_MainQuestStratholmeUpdatedCityWatch)
    if ( Trig_MainQuestStratholmeDiscoveredQ_Func041C() ) then
        call StartTimerBJ(udg_Timer_KaboomDiscover, false, 20.00)
    else
        call StartTimerBJ(udg_Timer_KaboomDiscover, false, GetRandomReal(30.00, 60.00))
    endif
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveOilPuddleFires)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

