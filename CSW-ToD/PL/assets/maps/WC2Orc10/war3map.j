//===========================================================================
// Trigger: SnowInFogLoop
//===========================================================================
function Trig_SnowInFogLoop_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinIntroOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinBuildCampOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinArrivalOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinDeathKnightsOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinSilverHandOn == false ) ) then
        return false
    endif
    if ( not ( udg_Bool_CinOutroOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SnowInFogLoop_Func008001 takes nothing returns boolean
    return ( udg_Real_FogMax <= 9000.00 )
endfunction

function Trig_SnowInFogLoop_Actions takes nothing returns nothing
    if ( (udg_Real_FogMax <= 9000.00) ) then // INLINED!!
        call PauseTimerBJ(true, udg_Timer_SnowIn)
    else
        call DoNothing()
    endif
    set udg_Real_FogMax=( udg_Real_FogMax - 100.00 )
    set udg_Real_FogMin=( udg_Real_FogMin - 100.00 )
    call SetTerrainFogExBJ(0, udg_Real_FogMin, udg_Real_FogMax, 0.20, 100.00, 100.00, 100.00)
endfunction

//===========================================================================
function InitTrig_SnowInFogLoop takes nothing returns nothing
    set gg_trg_SnowInFogLoop=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_SnowInFogLoop, udg_Timer_SnowIn)
    call TriggerAddCondition(gg_trg_SnowInFogLoop, Condition(function Trig_SnowInFogLoop_Conditions))
    call TriggerAddAction(gg_trg_SnowInFogLoop, function Trig_SnowInFogLoop_Actions)
endfunction

