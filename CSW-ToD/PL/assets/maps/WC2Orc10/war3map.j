    if ( (udg_Bool_CinBuildCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssueBuildOrderByIdLocBJ(gg_unit_o620_0489, 'o60X', GetRectCenter(gg_rct_TwilightHammersFarm))
