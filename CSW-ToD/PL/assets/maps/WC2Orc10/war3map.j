//===========================================================================
// Trigger: LoadChogall
//===========================================================================
function Trig_LoadChogall_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc08", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_LoadChogall_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_LoadChogall_Func002C() ) then
        call RestoreUnitLocFacingPointBJ("Chogall", "WC2Orc08", udg_Cache, udg_Player_Actual, GetRectCenter(gg_rct_ChogallLoad), GetUnitLoc(gg_unit_n001_0485))
        set udg_Hero_Chogall=GetLastRestoredUnitBJ()
    else
        call CreateNUnitsAtLocFacingLocBJ(1, 'O61R', udg_Player_Actual, GetRectCenter(gg_rct_ChogallLoad), GetUnitLoc(gg_unit_n001_0485))
        set udg_Hero_Chogall=GetLastCreatedUnit()
        call SetHeroLevelBJ(udg_Hero_Chogall, 7, false)
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC1')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC1')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC2')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC2')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC3')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC3')
        call SelectHeroSkill(udg_Hero_Chogall, 'XAC4')
        call CreateItemLoc('rst1', GetRectCenter(gg_rct_ChogallLoad))
        call UnitAddItemSwapped(GetLastCreatedItem(), udg_Hero_Chogall)
        call CreateItemLoc('brac', GetRectCenter(gg_rct_ChogallLoad))
        call UnitAddItemSwapped(GetLastCreatedItem(), udg_Hero_Chogall)
        call CreateItemLoc('I60D', GetRectCenter(gg_rct_ChogallLoad))
        call UnitAddItemSwapped(GetLastCreatedItem(), udg_Hero_Chogall)
    endif
    // //
    // //
    call SetUnitColor(udg_Hero_Chogall, PLAYER_COLOR_PURPLE)
    call ShowUnitHide(udg_Hero_Chogall)
    call PauseUnitBJ(true, udg_Hero_Chogall)
endfunction

//===========================================================================
function InitTrig_LoadChogall takes nothing returns nothing
    set gg_trg_LoadChogall=CreateTrigger()
    call TriggerAddAction(gg_trg_LoadChogall, function Trig_LoadChogall_Actions)
endfunction

//===========================================================================
// Trigger: LoadGuldan
//===========================================================================
function Trig_LoadGuldan_Func002C takes nothing returns boolean
    if ( not ( GetStoredBooleanBJ("Completed", "WC2Orc08", udg_Cache) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_LoadGuldan_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_LoadGuldan_Func002C() ) then
        call RestoreUnitLocFacingAngleBJ("Guldan", "WC2Orc08", udg_Cache, udg_Player_ShadowCouncil, GetRectCenter(gg_rct_ArmyGuldan), 180.00)
        set udg_Hero_Guldan=GetLastRestoredUnitBJ()
    else
        call CreateNUnitsAtLoc(1, 'U60B', udg_Player_ShadowCouncil, GetRectCenter(gg_rct_ArmyGuldan), 180.00)
        set udg_Hero_Guldan=GetLastCreatedUnit()
        call SetHeroLevelBJ(udg_Hero_Guldan, 3, false)
        call SelectHeroSkill(udg_Hero_Guldan, 'XAG1')
        call SelectHeroSkill(udg_Hero_Guldan, 'XAG2')
        call SelectHeroSkill(udg_Hero_Guldan, 'XAG3')
        call UnitAddItemByIdSwapped('IGSO', udg_Hero_Guldan)
    endif
    // //
    // Make him mounted
    call BlzSetUnitSkin(udg_Hero_Guldan, 'U006')
    // //
    call SetUnitOwner(udg_Hero_Guldan, udg_Player_BlackRockClan, false)
    call SuspendHeroXPBJ(false, udg_Hero_Guldan)
    call ShowUnitHide(udg_Hero_Guldan)
    call PauseUnitBJ(true, udg_Hero_Guldan)
endfunction

