        call RestoreUnitLocFacingAngleBJ("Doomhammer", "WC2Orc08S", udg_Cache, udg_Player_BlackRockClan, GetRectCenter(gg_rct_ArmyOrgrim), 180.00)
        set udg_Hero_DoomHammer=GetLastRestoredUnitBJ()
        // Make him mounted
        call BlzSetUnitSkin(udg_Hero_DoomHammer, 'O60F')
    else
        if ( Trig_LoadDoomhammer_Func002Func001C() ) then
            call RestoreUnitLocFacingAngleBJ("Doomhammer", "WC2Orc07", udg_Cache, udg_Player_BlackRockClan, GetRectCenter(gg_rct_ArmyOrgrim), 180.00)
            set udg_Hero_DoomHammer=GetLastRestoredUnitBJ()
            // Make him mounted
            call BlzSetUnitSkin(udg_Hero_DoomHammer, 'O60F')
        else
            call CreateNUnitsAtLoc(1, 'O60F', udg_Player_BlackRockClan, GetRectCenter(gg_rct_ArmyOrgrim), 180.00)
            set udg_Hero_DoomHammer=GetLastCreatedUnit()
            call SetHeroLevelBJ(udg_Hero_DoomHammer, 6, false)
            call SelectHeroSkill(udg_Hero_DoomHammer, 'A00F')
            call SelectHeroSkill(udg_Hero_DoomHammer, 'A00F')
            call SelectHeroSkill(udg_Hero_DoomHammer, 'A008')
            call SelectHeroSkill(udg_Hero_DoomHammer, 'A008')
            call SelectHeroSkill(udg_Hero_DoomHammer, 'XDQ1')
            call SelectHeroSkill(udg_Hero_DoomHammer, 'A00G')
            // //
            call UnitAddItemByIdSwapped('I002', udg_Hero_DoomHammer)
            call UnitAddItemByIdSwapped('I608', udg_Hero_DoomHammer)
        endif
    endif
    // //
    call SetUnitOwner(udg_Hero_DoomHammer, udg_Player_BlackRockClan, false)
    call SuspendHeroXPBJ(false, udg_Hero_DoomHammer)
    call ShowUnitHide(udg_Hero_DoomHammer)
