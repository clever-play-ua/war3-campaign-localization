endfunction

function Trig_SilverHandCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_CinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    // SetUp
    // //
    call ConditionalTriggerExecute(gg_trg_SilverHandCinematicSetUp)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Alonso01, udg_Player_Actual, 0)
    call SetUnitAnimation(udg_FakeAlonso, "cinematic listening one")
    call TriggerSleepAction(1.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    // Cinematic Started
    set udg_Bool_CinSilverHandOn=true
    call PlaySoundBJ(gg_snd_HumanX1)
    call CameraSetupApplyForPlayer(true, gg_cam_Alonso02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc10Alonsus_Interlude1))
    // //
    call SetUnitAnimation(udg_FakeAlonso, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeAlonso, 0, gg_snd_WC2Orc10Alonsus_Interlude1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinSilverHandSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeAlonso, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Mara01, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeMara, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeMara, "cinematic proud one")
    call QueueUnitAnimationBJ(udg_FakeMara, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeMara, 0, gg_snd_WC2Orc10MaraFordragon_Interlude1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinSilverHandSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeMara, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Alonso02, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeAlonso, "cinematic wave one")
    call QueueUnitAnimationBJ(udg_FakeAlonso, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeAlonso, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeAlonso, 0, gg_snd_WC2Orc10Alonsus_Interlude2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinSilverHandSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeAlonso, "cinematic listening one")
    // //
