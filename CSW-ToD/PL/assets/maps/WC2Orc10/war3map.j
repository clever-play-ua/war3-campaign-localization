    if ( (udg_Bool_CinBuildCampSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call IssuePointOrderLocBJ(gg_unit_o620_0489, "move", GetRectCenter(gg_rct_PeonBuild02))
    set udg_Point_CinBuildPeonTemp=GetUnitLoc(gg_unit_o620_0489)
