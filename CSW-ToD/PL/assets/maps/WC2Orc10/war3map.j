//===========================================================================
// Trigger: ArrivalSkipped
//===========================================================================
function Trig_ArrivalSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinArrivalOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ArrivalSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinArrivalSkipped=true
    // //
    // //
    call ConditionalTriggerExecute(gg_trg_ArrivalCleanUp)
    call StopSoundBJ(gg_snd_TheHorde, false)
    call StopSoundBJ(gg_snd_WC2Orc10ChoGall6, false)
    call StopSoundBJ(gg_snd_WC2Orc10Doomhammer1, false)
    call StopSoundBJ(gg_snd_WC2Orc10Doomhammer2, false)
    call StopSoundBJ(gg_snd_WC2Orc10Doomhammer3, false)
    call StopSoundBJ(gg_snd_WC2Orc10Doomhammer4, false)
    call StopSoundBJ(gg_snd_WC2Orc10Doomhammer5, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan1, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan2, false)
endfunction

//===========================================================================
function InitTrig_ArrivalSkipped takes nothing returns nothing
    set gg_trg_ArrivalSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_ArrivalSkipped, Player(0))
    call TriggerAddCondition(gg_trg_ArrivalSkipped, Condition(function Trig_ArrivalSkipped_Conditions))
    call TriggerAddAction(gg_trg_ArrivalSkipped, function Trig_ArrivalSkipped_Actions)
endfunction

//===========================================================================
// Trigger: ArrivalCleanUp
//===========================================================================
function Trig_ArrivalCleanUp_Func013C takes nothing returns boolean
    if ( not ( udg_Bool_CinArrivalSkipped == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ArrivalCleanUp_Func016002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_ArrivalCleanUp_Func017002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_ArrivalCleanUp_Func020002 takes nothing returns nothing
    call SetUnitMoveSpeed(GetEnumUnit(), GetUnitDefaultMoveSpeed(GetEnumUnit()))
endfunction

function Trig_ArrivalCleanUp_Func021002 takes nothing returns nothing
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, GetUnitDefaultMoveSpeed(GetEnumUnit()))
endfunction

function Trig_ArrivalCleanUp_Func022002 takes nothing returns nothing
    call AddUnitAnimationPropertiesBJ(false, "cinematic", GetEnumUnit())
endfunction

function Trig_ArrivalCleanUp_Func028A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_ArrivalCleanUp_Func030A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_ArrivalCleanUp_Func032A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_ArrivalCleanUp_Func034A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_ArrivalCleanUp_Func036A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_ArrivalCleanUp_Func038A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_ArrivalCleanUp_Func061Func003A takes nothing returns nothing
    call ReplaceUnitBJ(GetEnumUnit(), 'n002', bj_UNIT_STATE_METHOD_RELATIVE)
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HordeArmy)
endfunction

function Trig_ArrivalCleanUp_Func061C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00X', udg_Player_Actual) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ArrivalCleanUp_Func078A takes nothing returns nothing
    call RescueUnitBJ(GetEnumUnit(), udg_Player_Actual, false)
endfunction

function Trig_ArrivalCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinArrivalOn=false
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    // //
    call SetTerrainFogExBJ(0, 3000.00, 12500.00, 0, 75.30, 75.30, 75.33)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call SetStackedSoundBJ(false, gg_snd_OrcArmyMarchLoop, gg_rct_HideBlackRockArmy)
    // //
    if ( Trig_ArrivalCleanUp_Func013C() ) then
        // //
        call SetUnitPositionLoc(gg_unit_o61W_0179, GetRectCenter(gg_rct_ArmyGtunt01))
        call SetUnitPositionLoc(gg_unit_o61W_0210, GetRectCenter(gg_rct_ArmyGtunt02))
        call SetUnitPositionLoc(gg_unit_o61W_0171, GetRectCenter(gg_rct_ArmyGtunt03))
        call SetUnitPositionLoc(gg_unit_o61W_0170, GetRectCenter(gg_rct_ArmyGtunt07))
        call SetUnitPositionLoc(gg_unit_o61W_0209, GetRectCenter(gg_rct_ArmyGtunt08))
        call SetUnitPositionLoc(gg_unit_o61W_0208, GetRectCenter(gg_rct_ArmyGtunt09))
        // //
        call SetUnitPositionLoc(gg_unit_o61W_0195, GetRectCenter(gg_rct_ArmyGtunt04))
        call SetUnitPositionLoc(gg_unit_o61W_0172, GetRectCenter(gg_rct_ArmyGtunt05))
        call SetUnitPositionLoc(gg_unit_o61W_0211, GetRectCenter(gg_rct_ArmyGtunt06))
        call SetUnitPositionLoc(gg_unit_o61W_0207, GetRectCenter(gg_rct_ArmyGtunt12))
        call SetUnitPositionLoc(gg_unit_o61W_0206, GetRectCenter(gg_rct_ArmyGtunt11))
        call SetUnitPositionLoc(gg_unit_o61W_0205, GetRectCenter(gg_rct_ArmyGtunt10))
        // //
        call SetUnitPositionLoc(gg_unit_h625_0193, GetRectCenter(gg_rct_ArmyArcher09))
        call SetUnitPositionLoc(gg_unit_h625_0194, GetRectCenter(gg_rct_ArmyArcher08))
        call SetUnitPositionLoc(gg_unit_h625_0181, GetRectCenter(gg_rct_ArmyArcher07))
        call SetUnitPositionLoc(gg_unit_h625_0180, GetRectCenter(gg_rct_ArmyArcher01))
        call SetUnitPositionLoc(gg_unit_h625_0169, GetRectCenter(gg_rct_ArmyArcher02))
        call SetUnitPositionLoc(gg_unit_h625_0192, GetRectCenter(gg_rct_ArmyArcher03))
        // //
        call SetUnitPositionLoc(gg_unit_h625_0040, GetRectCenter(gg_rct_ArmyArcher12))
        call SetUnitPositionLoc(gg_unit_h625_0190, GetRectCenter(gg_rct_ArmyArcher11))
        call SetUnitPositionLoc(gg_unit_h625_0189, GetRectCenter(gg_rct_ArmyArcher10))
        call SetUnitPositionLoc(gg_unit_h625_0188, GetRectCenter(gg_rct_ArmyArcher04))
        call SetUnitPositionLoc(gg_unit_h625_0187, GetRectCenter(gg_rct_ArmyArcher05))
        call SetUnitPositionLoc(gg_unit_h625_0186, GetRectCenter(gg_rct_ArmyArcher06))
        // //
        call SetUnitPositionLoc(gg_unit_u005_0204, GetRectCenter(gg_rct_ArmyCorpseWagon03))
        call SetUnitPositionLoc(gg_unit_u005_0212, GetRectCenter(gg_rct_ArmyCorpseWagon02))
        call SetUnitPositionLoc(gg_unit_u005_0185, GetRectCenter(gg_rct_ArmyCorpseWagon01))
        // //
        call SetUnitPositionLoc(gg_unit_n001_0213, GetRectCenter(gg_rct_ArmyOgre06))
        call SetUnitPositionLoc(gg_unit_n001_0200, GetRectCenter(gg_rct_ArmyOgre05))
        call SetUnitPositionLoc(gg_unit_n001_0214, GetRectCenter(gg_rct_ArmyOgre04))
        call SetUnitPositionLoc(gg_unit_n001_0168, GetRectCenter(gg_rct_ArmyOgre01))
        call SetUnitPositionLoc(gg_unit_n001_0199, GetRectCenter(gg_rct_ArmyOgre02))
        call SetUnitPositionLoc(gg_unit_n001_0191, GetRectCenter(gg_rct_ArmyOgre03))
        // //
        call SetUnitPositionLoc(gg_unit_o60P_0177, GetRectCenter(gg_rct_ArmyCatapult01))
        call SetUnitPositionLoc(gg_unit_o60P_0174, GetRectCenter(gg_rct_ArmyCatapult02))
        call SetUnitPositionLoc(gg_unit_o60P_0720, GetRectCenter(gg_rct_ArmyCatapult03))
        call SetUnitPositionLoc(gg_unit_o60P_0721, GetRectCenter(gg_rct_ArmyCatapult04))
        call SetUnitPositionLoc(gg_unit_o60P_0173, GetRectCenter(gg_rct_ArmyCatapult05))
        call SetUnitPositionLoc(gg_unit_o60P_0176, GetRectCenter(gg_rct_ArmyCatapult06))
        // //
    else
    endif
    // //
    // Unhide units
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_ArrivalCleanUp_Func016002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_ArrivalCleanUp_Func017002)
    call GroupClear(udg_Group_HiddenUnits)
    // Reset Army units
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_ArrivalCleanUp_Func020002)
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_ArrivalCleanUp_Func021002)
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_ArrivalCleanUp_Func022002)
    // //
    call DestroyGroup(udg_Group_HordeArmy)
    // //
    // UNpause players
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_ArrivalCleanUp_Func028A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_AllianceNavy), function Trig_ArrivalCleanUp_Func030A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_StratholmeCityWatch), function Trig_ArrivalCleanUp_Func032A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_NavyDummy), function Trig_ArrivalCleanUp_Func034A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Lordaeron), function Trig_ArrivalCleanUp_Func036A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_SilverHand), function Trig_ArrivalCleanUp_Func038A)
    // //
    // Cirty Entrance
    call SetDestructableInvulnerableBJ(gg_dest_LTg2_0086, false)
    call SetDestructableInvulnerableBJ(gg_dest_LTg4_0087, false)
    // Gates
    // //
    // Actors
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveUnit(udg_FakeTHCinematicUnit[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    call ShowUnitShow(udg_Hero_Guldan)
    call PauseUnitBJ(false, udg_Hero_Guldan)
    call SuspendHeroXPBJ(true, udg_Hero_Guldan)
    // //
    call ShowUnitShow(udg_Hero_DoomHammer)
    call PauseUnitBJ(false, udg_Hero_DoomHammer)
    call SuspendHeroXPBJ(true, udg_Hero_DoomHammer)
    // //
    call ShowUnitShow(udg_SemiHero_Utok)
    call PauseUnitBJ(false, udg_SemiHero_Utok)
    // //
    // Apply Ogre Magi Upgrade
    if ( Trig_ArrivalCleanUp_Func061C() ) then
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsOfPlayerAndTypeId(udg_Player_BlackRockClan, 'n001'), function Trig_ArrivalCleanUp_Func061Func003A)
    else
    endif
    // //
    call VolumeGroupResetBJ()
    call CameraSetupApplyForPlayer(true, udg_VarPlayerCamera, udg_Player_Actual, 0)
    // //
    call ConditionalTriggerExecute(gg_trg_CinematicPrepOut)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call QueuedTriggerRemoveBJ(gg_trg_ArrivalCinQ)
    // //
    call SetPlayerTechMaxAllowedSwap('o605', 1, udg_Player_Actual)
    // NewQuest event -  reach the center of the city
    // //
    // Transfer arrived units except Corpse Wagons
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_HideBlackRockArmy, udg_Player_BlackRockClan), function Trig_ArrivalCleanUp_Func078A)
    // //
    call TriggerSleepAction(1.00)
    call RescueUnitBJ(udg_Hero_Guldan, udg_Player_Actual, false)
    // //
    call ConditionalTriggerExecute(gg_trg_P22StartAI)
    call QueuedTriggerAddBJ(gg_trg_MainQuestAssaultDiscovered, true)
endfunction

//===========================================================================
function InitTrig_ArrivalCleanUp takes nothing returns nothing
    set gg_trg_ArrivalCleanUp=CreateTrigger()
    call TriggerAddAction(gg_trg_ArrivalCleanUp, function Trig_ArrivalCleanUp_Actions)
endfunction

//===========================================================================
// Trigger: DeathKnightCinLaunch
//===========================================================================
function Trig_DeathKnightCinLaunch_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PolledWait(10.00)
    call QueuedTriggerAddBJ(gg_trg_DeathKnightsCinematicQ, true)
endfunction

//===========================================================================
function InitTrig_DeathKnightCinLaunch takes nothing returns nothing
    set gg_trg_DeathKnightCinLaunch=CreateTrigger()
    call TriggerAddAction(gg_trg_DeathKnightCinLaunch, function Trig_DeathKnightCinLaunch_Actions)
endfunction

