    call SetStartLocPrio(1, 2, 5, MAP_LOC_PRIO_HIGH)
    call SetStartLocPrio(1, 3, 6, MAP_LOC_PRIO_LOW)
    call SetStartLocPrio(1, 4, 7, MAP_LOC_PRIO_LOW)
    call SetStartLocPrio(1, 5, 11, MAP_LOC_PRIO_LOW)

