    if ( not ( IsTriggerEnabled(gg_trg_HumanArcherOilTaunt) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilPuddleFire01Q_Func004C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_HumanArcherOilTaunt) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilPuddleFire01Q_Func006Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'BS06' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilPuddleFire01Q_Func006A takes nothing returns nothing
    if ( Trig_OilPuddleFire01Q_Func006Func001C() ) then
        call ShowDestructableBJ(true, GetEnumDestructable())
    else
    endif
endfunction

function Trig_OilPuddleFire01Q_Func007Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'BS06' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilPuddleFire01Q_Func007A takes nothing returns nothing
    if ( Trig_OilPuddleFire01Q_Func007Func001C() ) then
        call SetDestructableAnimationBJ(GetEnumDestructable(), "birth")
        call QueueDestructableAnimationBJ(GetEnumDestructable(), "stand")
    else
    endif
endfunction

function Trig_OilPuddleFire01Q_Func012Func001C takes nothing returns boolean
    if ( not ( GetDestructableTypeId(GetEnumDestructable()) == 'LTex' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OilPuddleFire01Q_Func012A takes nothing returns nothing
    if ( Trig_OilPuddleFire01Q_Func012Func001C() ) then
        call SetDestructableInvulnerableBJ(GetEnumDestructable(), false)
    else
    endif
endfunction

function Trig_OilPuddleFire01Q_Func018002 takes nothing returns nothing
    call UnitAddAbilityBJ('ASBF', GetEnumUnit())
endfunction

function Trig_OilPuddleFire01Q_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    if ( Trig_OilPuddleFire01Q_Func002C() ) then
        call ConditionalTriggerExecute(gg_trg_HumanArcherOilTaunt)
    else
    endif
    // //
    if ( Trig_OilPuddleFire01Q_Func004C() ) then
        call ConditionalTriggerExecute(gg_trg_HumanArcherOilTaunt)
    else
    endif
    // //
    call EnumDestructablesInRectAll(gg_rct_GateFire01, function Trig_OilPuddleFire01Q_Func006A)
    call EnumDestructablesInRectAll(gg_rct_GateFire01, function Trig_OilPuddleFire01Q_Func007A)
    call TriggerSleepAction(4.33)
    // //
    // Throw Torch Here
    // //
    call EnumDestructablesInRectAll(gg_rct_GateFire01, function Trig_OilPuddleFire01Q_Func012A)
    // //
    call SetDoodadAnimationRectBJ("Stand", 'YOtf', gg_rct_GateFire01)
    call SetDoodadAnimationRectBJ("Stand", 'YOf3', gg_rct_GateFire01)
    call SetDoodadAnimationRectBJ("Stand", 'YOfs', gg_rct_GateFire01)
    // //
    call ForGroupBJ(udg_Group_FireEmmitterUnits[1], function Trig_OilPuddleFire01Q_Func018002)
    // //
    call TriggerSleepAction(2.00)
    call KillDestructable(gg_dest_LTex_6341)
    call TriggerSleepAction(0.50)
    call KillDestructable(gg_dest_LTex_4976)
    call TriggerSleepAction(0.50)
    call KillDestructable(gg_dest_LTex_6349)
    call TriggerSleepAction(0.50)
    call KillDestructable(gg_dest_LTex_6348)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

