    set gg_trg_OptionalQuestWallsDiscoveredQ=CreateTrigger()
    call TriggerAddAction(gg_trg_OptionalQuestWallsDiscoveredQ, function Trig_OptionalQuestWallsDiscoveredQ_Actions)
endfunction

//===========================================================================
// Trigger: OptionalQuestWallsUpdatedReq01
//
// don't forget about equal 0
//===========================================================================
function Trig_OptionalQuestWallsUpdatedReq01_Func006Func003Func001C takes nothing returns boolean
    if ( not ( udg_Int_ExplosionWallsCounter == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OptionalQuestWallsUpdatedReq01_Func006Func003C takes nothing returns boolean
    if ( not ( udg_Int_ExplosionWallsCounter == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OptionalQuestWallsUpdatedReq01_Func006C takes nothing returns boolean
    if ( not ( udg_Int_ExplosionWallsCounter == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OptionalQuestWallsUpdatedReq01_Func009Func002C takes nothing returns boolean
    if ( not ( udg_Int_ExplosionWallsCounter == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OptionalQuestWallsUpdatedReq01_Func009C takes nothing returns boolean
    if ( not ( udg_Int_ExplosionWallsCounter == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OptionalQuestWallsUpdatedReq01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call RemoveUnit(udg_Unit_ExplosionTargetArr[1])
    // //
    set udg_Int_ExplosionWallsCounter=( udg_Int_ExplosionWallsCounter + 1 )
    // //
    if ( Trig_OptionalQuestWallsUpdatedReq01_Func006C() ) then
        call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_Quests, udg_Int_ExplosionWallsCounter)
        call QuestItemSetDescriptionBJ(udg_QReq_Explosives[1], "TRIGSTR_4012")
    else
        if ( Trig_OptionalQuestWallsUpdatedReq01_Func006Func003C() ) then
            call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_Quests, udg_Int_ExplosionWallsCounter)
            call QuestItemSetDescriptionBJ(udg_QReq_Explosives[1], "TRIGSTR_4014")
        else
            if ( Trig_OptionalQuestWallsUpdatedReq01_Func006Func003Func001C() ) then
                call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_Quests, udg_Int_ExplosionWallsCounter)
                call QuestItemSetDescriptionBJ(udg_QReq_Explosives[1], "TRIGSTR_4013")
            else
            endif
        endif
    endif
    call TriggerSleepAction(2.00)
    // //
    if ( Trig_OptionalQuestWallsUpdatedReq01_Func009C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_4015")
    else
        if ( Trig_OptionalQuestWallsUpdatedReq01_Func009Func002C() ) then
            call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_4016")
        else
            call ConditionalTriggerExecute(gg_trg_OptionalQuestWallsCompleted)
        endif
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

