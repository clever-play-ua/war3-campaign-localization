    call CreateNUnitsAtLocFacingLocBJ(1, 'h625', udg_Player_BlackRockClan, GetRectCenter(gg_rct_FinalGrunt11), GetRectCenter(gg_rct_FinalOrgrim))
    call SetUnitAnimationWithRarity(GetLastCreatedUnit(), "stand", RARITY_FREQUENT)
