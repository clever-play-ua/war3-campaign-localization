    call SetUnitPositionLoc(GetEnumUnit(), GetRandomLocInRect(gg_rct_MoveTroopsHere))
endfunction

function Trig_BuildBaseCinematicSetUp_Func008001002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_BuildBaseCinematicSetUp_Func008002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

