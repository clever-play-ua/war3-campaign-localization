    set gg_trg_P02_Attacker_Being_Attacked=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_P02_Attacker_Being_Attacked, Player(1), EVENT_PLAYER_UNIT_ATTACKED)
