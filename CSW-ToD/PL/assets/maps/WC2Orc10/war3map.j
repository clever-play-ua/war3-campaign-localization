//===========================================================================
// Trigger: CreateFakeActors
//===========================================================================
function Trig_CreateFakeActors_Actions takes nothing returns nothing
    // Horde
    // //
    call CreateNUnitsAtLoc(1, 'OCHC', udg_Player_TwilightHammerClan, udg_Point_SpawnFakeChogall, 270.00)
    set udg_FakeChogall=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeChogall)
    call SetUnitMoveSpeed(udg_FakeChogall, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeChogall, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitBlendTimeBJ(udg_FakeChogall, 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'OWGC', udg_Player_ShadowCouncil, udg_Point_SpawnFakeGuldan, 270.00)
    set udg_FakeGuldan=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeGuldan)
    call SetUnitMoveSpeed(udg_FakeGuldan, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeGuldan, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitBlendTimeBJ(udg_FakeGuldan, 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'OMDC', udg_Player_BlackRockClan, udg_Point_SpawnFakeOrgrim, 270.00)
    set udg_FakeDoomhammer=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeDoomhammer)
    call SetUnitMoveSpeed(udg_FakeDoomhammer, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeDoomhammer, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitBlendTimeBJ(udg_FakeDoomhammer, 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'o605', udg_Player_BlackRockClan, udg_Point_SpawnFakeUtok, 270.00)
    set udg_FakeUtok=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeUtok)
    call SetUnitMoveSpeed(udg_FakeUtok, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeUtok, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitBlendTimeBJ(udg_FakeUtok, 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'o60E', udg_Player_ShadowCouncil, udg_Point_SpawnFakeTeronOrc, 270.00)
    set udg_FakeTeronOrc=GetLastCreatedUnit()
    call SetUnitMoveSpeed(udg_FakeTeronOrc, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeTeronOrc, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitBlendTimeBJ(udg_FakeTeronOrc, 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'u007', udg_Player_BlackRockClan, udg_Point_SpawnFakeTeronDK, 270.00)
    set udg_FakeTeronDK=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeTeronDK)
    // //
    // Alliance
    // //
    call CreateNUnitsAtLoc(1, 'HMFC', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeMara, 270.00)
    set udg_FakeMara=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMara)
    call SetUnitAnimation(udg_FakeMara, "cinematic listening one")
    call SetUnitBlendTimeBJ(udg_FakeMara, 0.50)
    call SetUnitMoveSpeed(udg_FakeMara, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeMara, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    // //
    call CreateNUnitsAtLoc(1, 'HAFC', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeAlonso, 270.00)
    set udg_FakeAlonso=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeAlonso)
    call SetUnitAnimation(udg_FakeAlonso, "cinematic listening one")
    call SetUnitBlendTimeBJ(udg_FakeAlonso, 0.50)
    call SetUnitMoveSpeed(udg_FakeAlonso, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeAlonso, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    // //
    call CreateNUnitsAtLoc(1, 'HAMC', Player(PLAYER_NEUTRAL_PASSIVE), udg_Point_SpawnFakeMograine, 270.00)
    set udg_FakeMograine=GetLastCreatedUnit()
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeMograine)
    call SetUnitAnimation(udg_FakeMograine, "cinematic listening one")
    call SetUnitBlendTimeBJ(udg_FakeMograine, 0.50)
    call SetUnitMoveSpeed(udg_FakeMograine, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeMograine, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    // //
endfunction

