    call TriggerSleepAction(0.50)
    // //
    call IssuePointOrderLocBJ(gg_unit_o60P_0177, "move", GetRectCenter(gg_rct_ArmyCatapult01))
    call IssuePointOrderLocBJ(gg_unit_o60P_0174, "move", GetRectCenter(gg_rct_ArmyCatapult02))
