    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Lordaeron )
endfunction

function Trig_OptionalQuestAllianceBaseCompleted_Func002Func001001001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_OptionalQuestAllianceBaseCompleted_Func002Func001001001002002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Lordaeron), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_OptionalQuestAllianceBaseCompleted_Func002Func001001001002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Lordaeron), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
