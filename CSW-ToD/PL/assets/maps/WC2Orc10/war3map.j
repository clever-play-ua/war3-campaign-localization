    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_OilRigArr[3], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_OilRigArr[4], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_OilRigArr[5], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_OilRigArr[6], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    // //
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_PortBuildingArr[1], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_PortBuildingArr[2], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_PortBuildingArr[3], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_PortBuildingArr[4], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_PortBuildingArr[5], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_PortBuildingArr[6], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_PortBuildingArr[7], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_PortBuildingArr[8], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call PingMinimapLocForForceEx(GetPlayersAll(), udg_Point_PortBuildingArr[9], 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // //
    call EnableTrigger(gg_trg_MainQuestAllianceOilUpdatedRigs)
    call EnableTrigger(gg_trg_MainQuestAllianceOilUpdatedFactories)
    // //
    set udg_String_CheckpointPhaseName="CampEstablished"
    call ConditionalTriggerExecute(gg_trg_SaveCheckPoint)
endfunction

