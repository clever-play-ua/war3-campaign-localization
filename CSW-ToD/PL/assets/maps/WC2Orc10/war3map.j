function Trig_ExplodeWallSection02_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Disable waygate that city watch uses
    call WaygateActivateBJ(false, gg_unit_h616_0118)
    // //
    call IssuePointOrderLocBJ(GetEnteringUnit(), "selfdestruct", GetUnitLoc(GetEnteringUnit()))
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, udg_Point_ExplodeWall02, 1.00)
    call TriggerSleepAction(1.00)
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 3)
    // //
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, udg_Point_ExplodeWall02, 1024.00)
    set udg_VisMod_Explode02=GetLastCreatedFogModifier()
    // //
    call QueuedTriggerAddBJ(gg_trg_OptionalQuestWallsUpdatedReq02, true)
    // //
    call AddSpecialEffectLocBJ(udg_Point_ExplodeWall02, "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    set udg_SE_WallExplosionArr[2]=GetLastCreatedEffectBJ()
    // //
    call PlaySoundBJ(gg_snd_CS_orc2_outro_stomp)
    call KillDestructable(gg_dest_BTsc_13059)
    call KillDestructable(gg_dest_BTsc_13060)
    call KillDestructable(gg_dest_B00R_0208)
    call KillDestructable(gg_dest_B620_0043)
    // //
    // //
    call TriggerSleepAction(0.50)
    // //
    call KillDestructable(gg_dest_BTsc_13087)
    call KillDestructable(gg_dest_B00Q_0042)
    // //
    call KillDestructable(gg_dest_BTsc_13084)
    call KillDestructable(gg_dest_B00Q_0041)
    // //
    call EnumDestructablesInRectAll(gg_rct_WallsExplosionRemovePB02, function Trig_ExplodeWallSection02_Func037A)
    // //
    call TriggerSleepAction(0.75)
    // //
    call KillDestructable(gg_dest_BTsc_13088)
    call KillDestructable(gg_dest_BTsc_13089)
    // //
    call KillDestructable(gg_dest_BTsc_13085)
    call KillDestructable(gg_dest_BTsc_13086)
    // //
    call KillDestructable(gg_dest_BTsc_13117)
    // //
    call KillDestructable(gg_dest_BTsc_13123)
    // //
    // //
    call TriggerSleepAction(0.75)
    // //
    call KillDestructable(gg_dest_B60M_0050)
    // //
    // //
    call EnumDestructablesInRectAll(gg_rct_WallsExplosionRemovePB02, function Trig_ExplodeWallSection02_Func057A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_WallsExplosionRemovePB02, Condition(function Trig_ExplodeWallSection02_Func059001002)), function Trig_ExplodeWallSection02_Func059A)
    // //
    call TriggerSleepAction(2.00)
    call KillUnit(gg_unit_n00D_0201)
    call DestroyFogModifier(udg_VisMod_Explode02)
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call DestroyEffectBJ(udg_SE_WallExplosionArr[2])
    // //
endfunction

