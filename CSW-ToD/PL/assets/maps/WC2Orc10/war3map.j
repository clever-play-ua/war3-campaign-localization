    call InitUpgrades_Player0()
    call InitUpgrades_Player1()
    call SetPlayerTechResearched(Player(9), 'Rhgb', 1) // INLINED!!
    call InitUpgrades_Player14()
    call SetPlayerTechResearched(Player(19), 'Rhgb', 1) // INLINED!!
    call SetPlayerTechResearched(Player(21), 'Rhac', 1) // INLINED!!
endfunction

