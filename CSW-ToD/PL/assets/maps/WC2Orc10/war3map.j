endfunction

function Trig_ExplodeWallSection01_Func088A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function Trig_ExplodeWallSection01_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // Disable waygate that city watch uses
    call WaygateActivateBJ(false, gg_unit_h61A_0378)
    // //
    call IssuePointOrderLocBJ(GetEnteringUnit(), "selfdestruct", GetUnitLoc(GetEnteringUnit()))
    call PanCameraToTimedLocForPlayer(udg_Player_Actual, udg_Point_ExplodeWall01, 1.00)
    call TriggerSleepAction(1.00)
    call CameraSetEQNoiseForPlayer(udg_Player_Actual, 3)
    // //
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, udg_Point_ExplodeWall01, 2048.00)
    set udg_VisMod_Explode01=GetLastCreatedFogModifier()
    // //
    call QueuedTriggerAddBJ(gg_trg_OptionalQuestWallsUpdatedReq01, true)
    // //
    call AddSpecialEffectLocBJ(udg_Point_ExplodeWall01, "CSW\\Doodads\\Cinematic\\Explosion\\NewDirtEXNofire.mdx")
    set udg_SE_WallExplosionArr[1]=GetLastCreatedEffectBJ()
    // //
    call PlaySoundBJ(gg_snd_CS_orc2_outro_stomp)
    call KillDestructable(gg_dest_BTsc_10122)
    call KillDestructable(gg_dest_BTsc_10121)
    call KillDestructable(gg_dest_B00R_0322)
    call KillDestructable(gg_dest_B00R_0321)
    call KillDestructable(gg_dest_B61T_0209)
    // //
    call EnumDestructablesInRectAll(gg_rct_WallsExplosionRemovePB01, function Trig_ExplodeWallSection01_Func029A)
    // //
    call TriggerSleepAction(0.50)
    // //
    call KillDestructable(gg_dest_BTsc_13115)
    call KillDestructable(gg_dest_B00R_0326)
    // //
    call KillDestructable(gg_dest_BTsc_13121)
    call KillDestructable(gg_dest_B00R_0349)
    // //
    // //
    call TriggerSleepAction(0.50)
    // //
    call KillDestructable(gg_dest_BTsc_13116)
    call KillDestructable(gg_dest_B00R_0331)
    // //
    call KillDestructable(gg_dest_BTsc_13122)
    call KillDestructable(gg_dest_B00R_0351)
    // //
    // //
    call TriggerSleepAction(0.50)
    // //
    call KillDestructable(gg_dest_BTsc_13117)
    call KillDestructable(gg_dest_B00R_0334)
    // //
    call KillDestructable(gg_dest_BTsc_13123)
    call KillDestructable(gg_dest_B00R_0353)
    // //
    // //
    call TriggerSleepAction(0.50)
    // //
    call KillDestructable(gg_dest_BTsc_13118)
    call KillDestructable(gg_dest_B00R_0343)
    // //
    call KillDestructable(gg_dest_BTsc_13124)
    call KillDestructable(gg_dest_B00R_0354)
    // //
    // //
    call TriggerSleepAction(0.50)
    // //
    call KillDestructable(gg_dest_BTsc_13119)
    call KillDestructable(gg_dest_B00R_0325)
    // //
    call KillDestructable(gg_dest_BTsc_13125)
    call KillDestructable(gg_dest_B00R_0073)
    // //
    // //
    call TriggerSleepAction(0.50)
    // //
    call KillDestructable(gg_dest_BTsc_13120)
    call KillDestructable(gg_dest_B00R_0328)
    call KillDestructable(gg_dest_B00R_0332)
    // //
    call KillDestructable(gg_dest_B00R_0324)
    call KillDestructable(gg_dest_B00R_0339)
    // //
    // //
    call EnumDestructablesInRectAll(gg_rct_WallsExplosionRemovePB01, function Trig_ExplodeWallSection01_Func086A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_WallsExplosionRemovePB01, Condition(function Trig_ExplodeWallSection01_Func088001002)), function Trig_ExplodeWallSection01_Func088A)
    // //
    call TriggerSleepAction(2.00)
    call DestroyFogModifier(udg_VisMod_Explode01)
    call CameraClearNoiseForPlayer(udg_Player_Actual)
    call DestroyEffectBJ(udg_SE_WallExplosionArr[1])
    // //
endfunction

