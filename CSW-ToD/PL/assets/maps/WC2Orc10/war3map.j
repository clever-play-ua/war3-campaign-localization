// Trigger: MainQuestAssaultCompleted
//===========================================================================
function Trig_MainQuestAssaultCompleted_Conditions takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_CathedralDefenders) == 0 ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestAssaultCompleted_Func022002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_MainQuestAssaultCompleted_Func023002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_MainQuestAssaultCompleted_Func024002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_MainQuestAssaultCompleted_Func025002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_MainQuestAssaultCompleted_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_CathedralDefendersKilled)
    call QuestSetCompletedBJ(udg_MQAssault, true)
    call QuestItemSetCompletedBJ(udg_QReqAssault[2], true)
    call DestroyMinimapIcon(udg_MinimapIcon_Cathedral)
    call DestroyFogModifier(udg_VisMod_Assault)
    // //
    call TriggerSleepAction(2.00)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3428")
    // //
    call TriggerSleepAction(2.00)
    call PlaySoundBJ(gg_snd_DoorSlam1)
    // //
    call SetUnitPositionLocFacingBJ(udg_Hero_AlonsusFaol, GetRectCenter(gg_rct_AlonsusSpawnCathedral), 314.82)
    call IssueImmediateOrderBJ(udg_Hero_AlonsusFaol, "resurrection")
    call SetUnitPositionLocFacingBJ(udg_Hero_MaraFordragon, GetRectCenter(gg_rct_MaraSpawnCathedral), 7.09)
    call IssuePointOrderLocBJ(udg_Hero_MaraFordragon, "attack", GetRectCenter(gg_rct_CathedralDefenders))
    // //
    call ForGroupBJ(udg_Group_CathedralArchers, function Trig_MainQuestAssaultCompleted_Func022002)
    call ForGroupBJ(udg_Group_CathedralArchers, function Trig_MainQuestAssaultCompleted_Func023002)
    call ForGroupBJ(udg_Group_CathedralBallistas, function Trig_MainQuestAssaultCompleted_Func024002)
    call ForGroupBJ(udg_Group_CathedralBallistas, function Trig_MainQuestAssaultCompleted_Func025002)
    // //
    call DestroyGroup(udg_Group_CathedralArchers)
    call DestroyGroup(udg_Group_CathedralBallistas)
    call DestroyGroup(udg_Group_CathedralDefenders)
    // //
    call ConditionalTriggerExecute(gg_trg_MaraFordragonEncounter)
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc10MaraFordragon_Encounter1) + GetSoundDurationBJ(gg_snd_WC2Orc10Guldan_MaraEncounter1) ))
    call PolledWait(bj_QUEUE_DELAY_QUEST)
    call ConditionalTriggerExecute(gg_trg_DeathKnightCinLaunch)
endfunction

