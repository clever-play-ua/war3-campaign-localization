    return ( udg_Bool_CinDeathKnightsSkipped == true )
endfunction

function Trig_DeathKnightsCinematicQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_CinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    // SetUp
    call PlaySoundBJ(gg_snd_DeathKnightCreation)
    call ConditionalTriggerExecute(gg_trg_DeathKnightsCinematicSetUp)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GraveyardStart, udg_Player_Actual, 0)
    call TriggerSleepAction(3.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    // Cinematic Started
    set udg_Bool_CinDeathKnightsOn=true
    // //
    // //
    // Opening the gate
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_DTg7_6462)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard02, udg_Player_Actual, 10.00)
    // Maybe better to move camera with speed that is the same as his walk to region?
    // //
    // As you can see Warchief, the defenses of Stratholme are quite formidable. It’s walls cannot be breached through brute strength alone.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan3, bj_TIMETYPE_ADD, 0, false)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_CinDeathKnigtGuldan01))
    call IssuePointOrderLocBJ(udg_FakeDoomhammer, "move", GetRectCenter(gg_rct_CinDeathKnigtDoomhammer01))
    // //
    set udg_Point_CinGuldanTemp=GetUnitLoc(udg_FakeGuldan)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_CinGuldanTemp, GetRectCenter(gg_rct_CinDeathKnigtGuldan01)) / GetUnitMoveSpeed(udg_FakeGuldan) ))
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard03, udg_Player_Actual, 0.00)
    set udg_Point_CinGuldanTemp=GetUnitLoc(udg_FakeGuldan)
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard04, udg_Player_Actual, ( DistanceBetweenPoints(udg_Point_CinGuldanTemp, GetRectCenter(gg_rct_CinDeathKnigtGuldan02)) / GetUnitMoveSpeed(udg_FakeGuldan) ))
    // //
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_CinDeathKnigtGuldan02))
    call IssuePointOrderLocBJ(udg_FakeDoomhammer, "move", GetRectCenter(gg_rct_CinDeathKnigtDoomhammer02))
    // //
    call SetUnitFacingToFaceLocTimed(udg_FakeTeronOrc, GetRectCenter(gg_rct_CinDeathKnigtGuldan02), ( DistanceBetweenPoints(GetUnitLoc(udg_FakeGuldan), GetRectCenter(gg_rct_CinDeathKnigtGuldan02)) / GetUnitMoveSpeed(udg_FakeGuldan) ))
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc10THGuldan3, 0)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Other means must be explored... if we are to taste victory today.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan4, bj_TIMETYPE_ADD, 0, false)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_DKStaves, Condition(function Trig_DeathKnightsCinematicQ_Func055001002)), function Trig_DeathKnightsCinematicQ_Func055002)
    call SetUnitTimeScalePercent(udg_FakeTeronDK, 2.00)
    // //
    set udg_Point_CinGuldanTemp=GetUnitLoc(udg_FakeGuldan)
    call TriggerSleepAction(( DistanceBetweenPoints(udg_Point_CinGuldanTemp, GetRectCenter(gg_rct_CinDeathKnigtGuldan02)) / GetUnitMoveSpeed(udg_FakeGuldan) ))
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    loop
        exitwhen ( (RectContainsUnit(gg_rct_CinDeathKnigtGuldan02, udg_FakeGuldan) == true) ) // INLINED!!
        call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL, 0.25))
    endloop
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(0.25)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitFacingToFaceLocTimed(udg_FakeDoomhammer, GetRectCenter(gg_rct_CinDeathKnigtGuldan02), 1.00)
    call SetUnitFacingToFaceLocTimed(udg_FakeGuldan, GetRectCenter(gg_rct_CinDeathKnigtDoomhammer02), 1.00)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc10THGuldan4, 0)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // They stand now in graveyard
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GraveyardOrgrim01, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_GraveyardOrgrim02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc10Doomhammer6))
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic listening one")
    // And just what are you suggesting, Warlock?
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard10, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic standard one")
    // Do you remember the promise I made at the start of your reign?
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard two")
    // I remember that you were on your knees and begging for your life… speak quickly Gul’dan, for my patience is nearly spent…
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_GraveyardGuldan01, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_GraveyardGuldan02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc10ChoGall6))
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic standard one")
    // I promised you riders of darkness, Warchief, undead wielders of powerful magic to bring ruin to your enemies.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan6, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard05, udg_Player_Actual, 0.00)
    call SetUnitFacingTimed(udg_FakeGuldan, 34.01, 5.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard01, udg_Player_Actual, ( 0.00 + GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan7) ))
    // After your warriors killed most of my Shadow Council, I sought ways to create these riders with the aid of my surviving Necrolytes… but they proved incapable of imbuing corpses with true consciousness…
    call SetUnitAnimation(udg_FakeGuldan, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard06A, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard07A, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan8) + ( GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan9) + GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan10) ) ))
    // //
    call SetUnitFacingToFaceLocTimed(udg_FakeGuldan, GetRectCenter(gg_rct_TeronGorefindAppears), 1.00)
    call SetUnitFacingToFaceLocTimed(udg_FakeDoomhammer, GetRectCenter(gg_rct_TeronGorefindAppears), 1.00)
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic standard one")
    // It was then that I realized… that there is another way…
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan8, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic standard one")
    // But the ritual cannot be done, without sacrifice…
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan9, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic standard one")
    // Teron’gor, my apprentice, it is time to leave that mortal vessel.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan10, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard07, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard08, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc10Terongor1))
    // //
    call SetUnitAnimation(udg_FakeTeronOrc, "stand ready")
    // What?! No! Gul’dan!
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTeronOrc, 0, gg_snd_WC2Orc10Terongor1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Ritual, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan11))
    // //
    // Fuldan syphons teron gors life
    call SetUnitLifeBJ(udg_FakeTeronOrc, 1000.00)
    call SetUnitLifePercentBJ(udg_FakeGuldan, 50.00)
    call IssueTargetOrderBJ(udg_FakeGuldan, "drain", udg_FakeTeronOrc)
    // //
    call UnitAddAbilityBJ('Aetl', udg_FakeTeronOrc)
    call SetUnitTimeScalePercent(udg_FakeTeronOrc, 5.00)
    call SetUnitAnimation(udg_FakeTeronOrc, "death")
    call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_TeronGorefindAppears), "Abilities\\Spells\\Undead\\Darksummoning\\DarkSummonTarget.mdl")
    set udg_SE_TeronTransformation=GetLastCreatedEffectBJ()
    // //
    call SetUnitAnimation(udg_FakeGuldan, "stand channel")
    // Every dog has its day, Teron, and this is yours… joined by the souls of my failed Necrolytes... now embrace this gift, and seize your destiny, Death Knight!
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan11, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    // Ritual
    // //
    call TriggerSleepAction(0.50)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitTimeScalePercent(udg_FakeTeronOrc, 100.00)
    call SetUnitAnimation(udg_FakeTeronOrc, "decay flesh")
    call UnitRemoveAbilityBJ('Aetl', udg_FakeTeronOrc)
    // //
    call ConditionalTriggerExecute(gg_trg_DeathKnightsRise)
    // //
    call DestroyEffectBJ(udg_SE_TeronTransformation)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_TeronGorefiend, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc10Gorefiend1))
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeTeronDK, "cinematic standard one")
    // I… I feel different… I can feel the power inside me! I am now eternal... I am now death incarnate… I am now… Teron Gorefiend!
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeTeronDK, 0, gg_snd_WC2Orc10Gorefiend1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeTeronDK, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard01, udg_Player_Actual, 0.00)
    call SetUnitFacingToFaceLocTimed(udg_FakeGuldan, GetRectCenter(gg_rct_CinDeathKnigtDoomhammer02), 1.00)
    call CameraSetupApplyForPlayer(true, gg_cam_Graveyard09, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc10Doomhammer8) + ( GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan12) + GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan13) ) ))
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic standard one")
    // Now, with the souls of the dead, we can turn the fallen knights of our enemies into our servants. The sight of them will tear at the hearts of their human brethren… and fill their souls with terror!
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan12, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard three")
    // You dabble in dangerous magic, Gul’dan… but if these “Death Knights” are as powerful as you say, and loyal to the Horde, you will have proven your usefulness to me. Now... let us put the power of these unliving knights to the test...
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer8, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic standard one")
    // Stratholme is said to be the holiest of cities to the humans. My Death Knights will desecrate it and bring true terror to the hearts of all humans. This entire city… will be purged.
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan13, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinDeathKnightsSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_DeathKnightCreation, true)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_DeathKnightsCinematicCleanUp)
endfunction

