        local integer this= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        call IssueTargetOrderById(s__DelayedOrderTarget_u[this], s__DelayedOrderTarget_o[this], s__DelayedOrderTarget_w[this])
