function Trig_DeathKnightsCinematicCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinDeathKnightsOn=false
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOcp', gg_rct_DKCinLightControl)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_DeathKnightsCinematicCleanUp_Func010A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_AllianceNavy), function Trig_DeathKnightsCinematicCleanUp_Func012A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_StratholmeCityWatch), function Trig_DeathKnightsCinematicCleanUp_Func014A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_NavyDummy), function Trig_DeathKnightsCinematicCleanUp_Func016A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Lordaeron), function Trig_DeathKnightsCinematicCleanUp_Func018A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_SilverHand), function Trig_DeathKnightsCinematicCleanUp_Func020A)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call RemoveLocation(udg_Point_CinGuldanTemp)
    // //
    call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH, 'o60E', udg_Player_ShadowCouncil, GetRectCenter(gg_rct_TeronGorefindAppears), 250.07)
    // //
    call CreateNUnitsAtLoc(1, 'u007', udg_Player_BlackRockClan, GetRectCenter(gg_rct_TeronGorefindAppears), 250.18)
    set udg_SemiHero_TeronDK=GetLastCreatedUnit()
    call IssueImmediateOrder(udg_SemiHero_TeronDK, "raisedeadoff")
    // //
    call SetUnitPositionLoc(udg_Hero_MaraFordragon, GetRectCenter(gg_rct_MaraLastStand))
    call GroupAddUnitSimple(udg_Hero_MaraFordragon, udg_Group_SilverHandLastStand)
    call UnitRemoveItemFromSlotSwapped(1, udg_Hero_MaraFordragon)
    call RemoveItem(GetLastRemovedItem())
    call ShowUnitHide(udg_Hero_MaraFordragon)
    call PauseUnitBJ(true, udg_Hero_MaraFordragon)
    // //
    // //
    call RemoveUnit(udg_Hero_AlonsusFaol)
    // //
    if ( Trig_DeathKnightsCinematicCleanUp_Func042C() ) then
        call RemoveUnit(udg_Hero_AlexandrosMograine)
    else
    endif
    // //
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    call SetTerrainFogExBJ(0, 3000.00, 12500.00, 0, 75.30, 75.30, 75.33)
    call UseTimeOfDayBJ(true)
    // //
    call SetDestAnimationSpeedPercent(gg_dest_DTg7_6462, 100.00)
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_DTg7_6462)
    // //
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_DKStaves, Condition(function Trig_DeathKnightsCinematicCleanUp_Func053001002)), function Trig_DeathKnightsCinematicCleanUp_Func053002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_DKStaves, Condition(function Trig_DeathKnightsCinematicCleanUp_Func056001002)), function Trig_DeathKnightsCinematicCleanUp_Func056002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_DKStaves, Condition(function Trig_DeathKnightsCinematicCleanUp_Func059001002)), function Trig_DeathKnightsCinematicCleanUp_Func059002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_DKStaves, Condition(function Trig_DeathKnightsCinematicCleanUp_Func062001002)), function Trig_DeathKnightsCinematicCleanUp_Func062A)
    // //
    // //
    // //
    call EnumDestructablesInRectAll(gg_rct_DKStaves, function Trig_DeathKnightsCinematicCleanUp_Func066A)
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=8
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call DestroyEffectBJ(udg_SE_DeathKnightRisesArr[GetForLoopIndexB()])
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    call CreateCorpseLocBJ('h60K', udg_Player_StratholmeCityWatch, GetRandomLocInRect(gg_rct_CorpseWagon03))
    call CreateCorpseLocBJ('h60K', udg_Player_StratholmeCityWatch, GetRandomLocInRect(gg_rct_CinDeathKnight03))
    call CreateCorpseLocBJ('h60K', udg_Player_StratholmeCityWatch, GetRandomLocInRect(gg_rct_CinDeathKnight02))
    call CreateCorpseLocBJ('h60K', udg_Player_StratholmeCityWatch, GetRandomLocInRect(gg_rct_CorpseWagon03))
    call CreateCorpseLocBJ('h60K', udg_Player_StratholmeCityWatch, GetRandomLocInRect(gg_rct_CorpseWagon02))
    call CreateCorpseLocBJ('h60K', udg_Player_StratholmeCityWatch, GetRandomLocInRect(gg_rct_CorpseWagon01))
    call CreateCorpseLocBJ('h60K', udg_Player_StratholmeCityWatch, GetRandomLocInRect(gg_rct_CinDeathKnight05))
    call CreateCorpseLocBJ('h60K', udg_Player_StratholmeCityWatch, GetRandomLocInRect(gg_rct_CinDeathKnight06))
    // //
    // //
    // Made Entrances voulnerable agian
    call SetDestructableInvulnerableBJ(gg_dest_LTg4_2351, false)
    call SetDestructableInvulnerableBJ(gg_dest_LTg4_0238, false)
    call SetDestructableInvulnerableBJ(gg_dest_LTg2_2078, false)
    call SetDestructableInvulnerableBJ(gg_dest_LTg4_1946, false)
    // //
    call SetPlayerTechMaxAllowedSwap('o60E', 0, udg_Player_Actual)
    call SetPlayerUnitAvailableBJ('u001', true, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('u007', 1, udg_Player_Actual)
    // //
    call ConditionalTriggerExecute(gg_trg_CinematicPrepOut)
    call CameraSetupApplyForPlayer(true, gg_cam_DeathKnightsAcquired, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    // //
    call RescueUnitBJ(udg_SemiHero_TeronDK, udg_Player_Actual, false)
    call RescueUnitBJ(gg_unit_u005_0185, udg_Player_Actual, false)
    call RescueUnitBJ(gg_unit_u005_0212, udg_Player_Actual, false)
    call RescueUnitBJ(gg_unit_u005_0204, udg_Player_Actual, false)
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=7
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RescueUnitBJ(udg_Unit_StormwindKnightCorpse[GetForLoopIndexA()], udg_Player_Actual, false)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    // //
    call QueuedTriggerRemoveBJ(gg_trg_DeathKnightsCinematicQ)
    // //
    set udg_String_CheckpointPhaseName="DeathKnights"
    call ConditionalTriggerExecute(gg_trg_SaveCheckPoint)
    // //
    call ConditionalTriggerExecute(gg_trg_P22SendFirstAttack)
    // //
    call QueuedTriggerAddBJ(gg_trg_HintTeronGorefiendQ, true)
    call QueuedTriggerAddBJ(gg_trg_HintDeathKnightsQ, true)
    call QueuedTriggerAddBJ(gg_trg_HintCorpseWagonQ, true)
    if ( Trig_DeathKnightsCinematicCleanUp_Func116C() ) then
        call QueuedTriggerAddBJ(gg_trg_MainQuestStratholmeDiscoveredQ, true)
    else
    endif
    // //
    // //
endfunction

//===========================================================================
function InitTrig_DeathKnightsCinematicCleanUp takes nothing returns nothing
    set gg_trg_DeathKnightsCinematicCleanUp=CreateTrigger()
    call TriggerAddAction(gg_trg_DeathKnightsCinematicCleanUp, function Trig_DeathKnightsCinematicCleanUp_Actions)
endfunction

