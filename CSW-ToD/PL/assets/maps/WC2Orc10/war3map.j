//===========================================================================
function Trig_MainQuestGoldmineCompleted_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( IsQuestDiscovered(udg_MQGoldmine) == true ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Group_Kobolds) == 0 ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_Chogall) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestGoldmineCompleted_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisableTrigger(gg_trg_KoboldDies)
    call DestroyGroup(udg_Group_Kobolds)
    call QuestItemSetCompletedBJ(udg_QReq_Goldmine[1], true)
    call QuestItemSetCompletedBJ(udg_QReq_Goldmine[2], true)
    call QuestSetCompletedBJ(udg_MQGoldmine, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3241")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerAddBJ(gg_trg_BuildBaseCinematicQ, true)
endfunction

