    call TriggerRegisterGameLoadedEventBJ(gg_trg_Init_Reload)
    call TriggerAddAction(gg_trg_Init_Reload, function Trig_Init_Reload_Actions)
endfunction

//===========================================================================
// Trigger: Easy
//===========================================================================
function Trig_Easy_Conditions takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_Easy_Actions takes nothing returns nothing
