    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'o60M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BuildBaseCinematicSetUp_Func050A takes nothing returns nothing
    if ( Trig_BuildBaseCinematicSetUp_Func050Func001C() ) then
        call UnitAddAbilityBJ('A634', GetEnumUnit())
    else
    endif
    // //
    if ( Trig_BuildBaseCinematicSetUp_Func050Func003C() ) then
        call UnitAddAbilityBJ('A636', GetEnumUnit())
    else
    endif
    // //
    if ( Trig_BuildBaseCinematicSetUp_Func050Func005C() ) then
        call UnitAddAbilityBJ('A635', GetEnumUnit())
    else
    endif
endfunction

function Trig_BuildBaseCinematicSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_BuildBaseCinematicSetUp_Func005001002)), function Trig_BuildBaseCinematicSetUp_Func005002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_Actual, Condition(function Trig_BuildBaseCinematicSetUp_Func008001002)), function Trig_BuildBaseCinematicSetUp_Func008002)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_BuildBaseCinematicSetUp_Func010002)
    // //
    call AdjustPlayerStateBJ(3200, udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(1450, udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_FOOD_CAP, 0)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    call ResetUnitAnimation(gg_unit_o620_0489)
    call SetUnitOwner(gg_unit_o620_0489, udg_Player_Actual, true)
    call ResetUnitAnimation(gg_unit_o620_0488)
    call SetUnitOwner(gg_unit_o620_0488, udg_Player_Actual, true)
    call ResetUnitAnimation(gg_unit_o620_0490)
    call SetUnitOwner(gg_unit_o620_0490, udg_Player_Actual, true)
    // //
    call SetUnitOwner(gg_unit_o60R_0007, udg_Player_Actual, true)
    call SetUnitOwner(gg_unit_o60R_0963, udg_Player_Actual, true)
    call SetUnitOwner(gg_unit_h000_0964, udg_Player_Actual, true)
    call SetUnitOwner(gg_unit_h001_0965, udg_Player_Actual, true)
    // //
    call ResetUnitAnimation(gg_unit_o60M_0466)
    call SetUnitOwner(gg_unit_o60M_0466, udg_Player_Actual, true)
    // //
    call ResetUnitAnimation(gg_unit_o60V_0465)
    call SetUnitOwner(gg_unit_o60V_0465, udg_Player_Actual, true)
    call ReplaceUnitBJ(gg_unit_o60V_0465, 'o60V', bj_UNIT_STATE_METHOD_RELATIVE)
    // //
    call ResetUnitAnimation(gg_unit_o60N_0467)
    call SetUnitOwner(gg_unit_o60N_0467, udg_Player_Actual, true)
    call ReplaceUnitBJ(gg_unit_o60N_0467, 'o60N', bj_UNIT_STATE_METHOD_RELATIVE)
    // //
    call ResetUnitAnimation(gg_unit_u002_0962)
    call SetUnitOwner(gg_unit_u002_0962, udg_Player_Actual, true)
    call ReplaceUnitBJ(gg_unit_u002_0962, 'u002', bj_UNIT_STATE_METHOD_RELATIVE)
    // //
    // //
    // //
    call TriggerSleepAction(0.50)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_BuildBaseCinematicSetUp_Func050001002)), function Trig_BuildBaseCinematicSetUp_Func050A)
    // //
    call SetUnitOwner(gg_unit_o60Q_0151, udg_Player_Actual, true)
    call SetUnitOwner(gg_unit_o60Q_0152, udg_Player_Actual, true)
    call SetUnitOwner(gg_unit_o60Q_0153, udg_Player_Actual, true)
    // //
    call CreateNUnitsAtLoc(1, 'o620', udg_Player_Actual, GetRectCenter(gg_rct_TwilightHammersBase), bj_UNIT_FACING)
    // Why it didnt work?
    call IssueBuildOrderByIdLocBJ(GetLastCreatedUnit(), 'o614', GetRectCenter(gg_rct_TwilightHammersBase))
    // //
    call SetUnitPositionLocFacingBJ(gg_unit_o620_0490, GetRectCenter(gg_rct_PeonBuild02), 90.00)
    call IssueBuildOrderByIdLocBJ(gg_unit_o620_0490, 'xW21', GetRectCenter(gg_rct_TwilightHammersWarmill))
    // //
    call SetUnitPositionLocFacingBJ(gg_unit_o620_0488, GetRectCenter(gg_rct_PeonBuild01), 90.00)
    call IssuePointOrderLocBJ(gg_unit_o620_0488, "move", GetRectCenter(gg_rct_PeonBuild02))
    // //
    call SetUnitPositionLocFacingBJ(gg_unit_o620_0489, GetRectCenter(gg_rct_SpawnPeonsBuild), 90.00)
    call IssuePointOrderLocBJ(gg_unit_o620_0489, "move", GetRectCenter(gg_rct_PeonBuild01))
    // //
endfunction

