//===========================================================================
// Trigger: SilverHandCinematicSkipped
//===========================================================================
function Trig_SilverHandCinematicSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinSilverHandOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SilverHandCinematicSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinSilverHandSkipped=true
    call QueuedTriggerRemoveBJ(gg_trg_SilverHandCinematicQ)
    call ConditionalTriggerExecute(gg_trg_SilverHandCinematicCleanUp)
    call StopSoundBJ(gg_snd_WC2Orc10Alonsus_Interlude1, false)
    call StopSoundBJ(gg_snd_WC2Orc10Alonsus_Interlude2, false)
    call StopSoundBJ(gg_snd_WC2Orc10Alonsus_Interlude3, false)
    call StopSoundBJ(gg_snd_WC2Orc10MaraFordragon_Interlude1, false)
    call StopSoundBJ(gg_snd_WC2Orc10MaraFordragon_Interlude2, false)
    call StopSoundBJ(gg_snd_WC2Orc10Mograine_Interlude1, false)
    call StopSoundBJ(gg_snd_HumanX1, false)
endfunction

//===========================================================================
function InitTrig_SilverHandCinematicSkipped takes nothing returns nothing
    set gg_trg_SilverHandCinematicSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_SilverHandCinematicSkipped, Player(0))
    call TriggerAddCondition(gg_trg_SilverHandCinematicSkipped, Condition(function Trig_SilverHandCinematicSkipped_Conditions))
    call TriggerAddAction(gg_trg_SilverHandCinematicSkipped, function Trig_SilverHandCinematicSkipped_Actions)
endfunction

//===========================================================================
// Trigger: SilverHandCinematicCleanUp
//===========================================================================
function Trig_SilverHandCinematicCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinSilverHandOn=false
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOcp', gg_rct_SilverhandCinLightControl)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_LTg1_0099, false)
    call SetDestructableInvulnerableBJ(gg_dest_LTg3_0476, false)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    call RemoveUnit(udg_Unit_SilverHandCinGuard)
    // //
    call RemoveLocation(udg_Point_CinMograineTemp)
    call RemoveLocation(udg_Point_CinAlonsoTemp)
    // //
    call SetDestructableAnimationBJ(gg_dest_B620_0165, "stand")
    call CreateDestructableLoc('YTpb', GetRectCenter(gg_rct_PathingBlocker01), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpb', GetRectCenter(gg_rct_PathingBlocker02), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpb', GetRectCenter(gg_rct_PathingBlocker03), bj_UNIT_FACING, 1, 0)
    call CreateDestructableLoc('YTpb', GetRectCenter(gg_rct_PathingBlocker04), bj_UNIT_FACING, 1, 0)
    // //
    // //
    call CameraSetupApplyForPlayer(true, udg_VarPlayerCamera, udg_Player_Actual, 0)
    call ConditionalTriggerExecute(gg_trg_CinematicPrepOut)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call CinematicModeBJ(false, GetPlayersAll())
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    // //
    call QueuedTriggerAddBJ(gg_trg_MainQuestLastStandDiscoveredQ, true)
endfunction

