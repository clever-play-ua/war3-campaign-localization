//===========================================================================
// Trigger: Next Level Prep
//===========================================================================
function Trig_Next_Level_Prep_Func007C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_DoomHammer) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func009C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Chogall) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func011C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_Utok) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func013C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Guldan) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Func025C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_TeronDK) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Prep_Actions takes nothing returns nothing
    call QueuedTriggerRemoveBJ(gg_trg_FinalCinQ)
    set udg_Bool_CinOutroOn=false
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 4.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(5.00)
    // Saving Heros
    // //
    if ( Trig_Next_Level_Prep_Func007C() ) then
        call ReviveHeroLoc(udg_Hero_DoomHammer, GetRectCenter(gg_rct_CacheDoomhammer), false)
    else
    endif
    // //
    if ( Trig_Next_Level_Prep_Func009C() ) then
        call ReviveHeroLoc(udg_Hero_Chogall, GetRectCenter(gg_rct_CacheChogall), false)
    else
    endif
    // //
    if ( Trig_Next_Level_Prep_Func011C() ) then
        call CreateNUnitsAtLoc(1, 'o605', udg_Player_Actual, GetRectCenter(gg_rct_CacheUtok), bj_UNIT_FACING)
        set udg_SemiHero_Utok=GetLastCreatedUnit()
    else
        call ShowUnitShow(udg_SemiHero_Utok)
        call PauseUnitBJ(false, udg_SemiHero_Utok)
    endif
    // //
    if ( Trig_Next_Level_Prep_Func013C() ) then
        call ReviveHeroLoc(udg_Hero_Guldan, GetRectCenter(gg_rct_CacheGuldan), false)
    else
    endif
    // //
    // //
    call ShowUnitShow(udg_Hero_Chogall)
    call PauseUnitBJ(false, udg_Hero_Chogall)
    // //
    call ShowUnitShow(udg_Hero_DoomHammer)
    call PauseUnitBJ(false, udg_Hero_DoomHammer)
    // //
    call ShowUnitShow(udg_Hero_Guldan)
    call PauseUnitBJ(false, udg_Hero_Guldan)
    // //
    if ( Trig_Next_Level_Prep_Func025C() ) then
        call ShowUnitShow(udg_SemiHero_TeronDK)
        call PauseUnitBJ(false, udg_SemiHero_TeronDK)
    else
    endif
    // //
    // //
    // Dismount Guldan
    call BlzSetUnitSkin(udg_Hero_Guldan, 'U60B')
    // //
    call TriggerSleepAction(0.01)
    call StoreUnitBJ(udg_Hero_Guldan, "Guldan", "WC2Orc10", udg_Cache)
    // //
    call StoreUnitBJ(udg_Hero_Chogall, "Chogall", "WC2Orc10", udg_Cache)
    // //
    // Dismount Doomhammer
    // //
    call BlzSetUnitSkin(udg_Hero_DoomHammer, 'O602')
    call TriggerSleepAction(0.01)
    // //
    call StoreUnitBJ(udg_Hero_DoomHammer, "Doomhammer", "WC2Orc10", udg_Cache)
    // //
    call StoreUnitBJ(udg_SemiHero_Utok, "Utok", "WC2Orc10", udg_Cache)
    // //
    call StoreIntegerBJ(GetPlayerTechCountSimple('RUX2', udg_Player_Actual), "UtokLevel", "WC2Orc10", udg_Cache)
    // //
    call StoreBooleanBJ(true, "Completed", "WC2Orc10", udg_Cache)
    // //
    call TriggerSleepAction(0.10)
    call SaveGameCacheBJ(udg_Cache)
    // //
    set udg_Music_CurrentVolume=100.00
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ShowCustomCampaignButton(true, 16)
    call SetNextLevelBJ("WC2Orc11.w3x")
    call CustomVictoryBJ(udg_Player_Actual, true, true)
endfunction

//===========================================================================
function InitTrig_Next_Level_Prep takes nothing returns nothing
    set gg_trg_Next_Level_Prep=CreateTrigger()
    call TriggerAddAction(gg_trg_Next_Level_Prep, function Trig_Next_Level_Prep_Actions)
endfunction

