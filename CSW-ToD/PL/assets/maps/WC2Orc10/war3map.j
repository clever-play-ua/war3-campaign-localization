function InitTrig_MainQuestStratholmeUpdatedCityWatch takes nothing returns nothing
    set gg_trg_MainQuestStratholmeUpdatedCityWatch=CreateTrigger()
    call DisableTrigger(gg_trg_MainQuestStratholmeUpdatedCityWatch)
    call TriggerRegisterTimerEventPeriodic(gg_trg_MainQuestStratholmeUpdatedCityWatch, 1.00)
    call TriggerAddCondition(gg_trg_MainQuestStratholmeUpdatedCityWatch, Condition(function Trig_MainQuestStratholmeUpdatedCityWatch_Conditions))
    call TriggerAddAction(gg_trg_MainQuestStratholmeUpdatedCityWatch, function Trig_MainQuestStratholmeUpdatedCityWatch_Actions)
endfunction

//===========================================================================
// Trigger: MainQuestLastStandDiscoveredQ
//===========================================================================
function Trig_MainQuestLastStandDiscoveredQ_Func003A takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_MainQuestLastStandDiscoveredQ_Func006A takes nothing returns nothing
    call SetUnitInvulnerable(GetEnumUnit(), true)
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_MainQuestLastStandDiscoveredQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call ForGroupBJ(udg_Group_SilverHandLastStand, function Trig_MainQuestLastStandDiscoveredQ_Func003A)
    // //
    // Lock them untill the gates are destroyed
    call ForGroupBJ(udg_Group_SilverHandLastStand, function Trig_MainQuestLastStandDiscoveredQ_Func006A)
    // //
    call GroupRemoveUnitSimple(gg_unit_h617_0001, udg_Group_SilverHandLastStand)
    call GroupRemoveUnitSimple(udg_Hero_MaraFordragon, udg_Group_SilverHandLastStand)
    // //
    set udg_Int_MQLastStandPaladinsCount=CountUnitsInGroup(udg_Group_SilverHandLastStand)
    // //
    call QuestSetDiscoveredBJ(udg_MQLastStand, true)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3468")
    // //
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_FOGGED, GetRectCenter(gg_rct_ChurchLastStand), 1024.00)
    set udg_VisMod_LastStand=GetLastCreatedFogModifier()
    // //
    call PingMinimapLocForForceEx(GetPlayersAll(), GetRectCenter(gg_rct_ChurchLastStand), 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_ChurchLastStand))
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_ChurchLastStand), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Church=GetLastCreatedMinimapIcon()
    // //
    call CampaignMinimapIconUnitBJ(udg_Hero_MaraFordragon, bj_CAMPPINGSTYLE_BOSS)
    set udg_MinimapIcon_Mara=GetLastCreatedMinimapIcon()
    // //
    call LeaderboardAddItemBJ(Player(1), udg_Leaderboard_Quests, "TRIGSTR_3974", udg_Int_MQLastStandPaladinsCount)
    call LeaderboardSetLabelColorBJ(udg_Leaderboard_Quests, 100, 80, 20, 0)
    call LeaderboardSetValueColorBJ(udg_Leaderboard_Quests, 100, 80, 20, 0)
    call LeaderboardSetStyleBJ(udg_Leaderboard_Quests, true, true, true, false)
    call ConditionalTriggerExecute(gg_trg_QuestBoardUpdate)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_MainQuestLastStandDiscoveredQ takes nothing returns nothing
    set gg_trg_MainQuestLastStandDiscoveredQ=CreateTrigger()
    call TriggerAddAction(gg_trg_MainQuestLastStandDiscoveredQ, function Trig_MainQuestLastStandDiscoveredQ_Actions)
endfunction

