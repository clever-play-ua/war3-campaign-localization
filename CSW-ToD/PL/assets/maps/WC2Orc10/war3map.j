    set gg_trg_Guldan_I_Chaos_Bolt_Start=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Guldan_I_Chaos_Bolt_Start, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_Guldan_I_Chaos_Bolt_Start, Condition(function Trig_Guldan_I_Chaos_Bolt_Start_Conditions))
    call TriggerAddAction(gg_trg_Guldan_I_Chaos_Bolt_Start, function Trig_Guldan_I_Chaos_Bolt_Start_Actions)
