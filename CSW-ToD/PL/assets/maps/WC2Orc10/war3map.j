    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B00P' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B00O' ) ) then
        return true
    endif
    return false
endfunction

