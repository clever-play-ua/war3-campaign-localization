    call ForGroupBJ(udg_Group_FireEmmitterUnits[2], function Trig_RemoveOilPuddleFires_Func025002)
    call ForGroupBJ(udg_Group_FireEmmitterUnits[3], function Trig_RemoveOilPuddleFires_Func026002)
