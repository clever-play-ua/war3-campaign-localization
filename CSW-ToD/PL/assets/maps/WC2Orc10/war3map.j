    call SetUnitPositionLoc(gg_unit_o60P_0720, GetRectCenter(gg_rct_ArmyCatapult03Start))
    // //
    // Row2
    // //
    call SetUnitPositionLoc(gg_unit_o61W_0170, GetRectCenter(gg_rct_ArmyGtunt07Start))
    call SetUnitPositionLoc(gg_unit_o61W_0209, GetRectCenter(gg_rct_ArmyGtunt08Start))
    call SetUnitPositionLoc(gg_unit_o61W_0208, GetRectCenter(gg_rct_ArmyGtunt09Start))
    // //
    call SetUnitPositionLoc(gg_unit_o61W_0207, GetRectCenter(gg_rct_ArmyGtunt12Start))
