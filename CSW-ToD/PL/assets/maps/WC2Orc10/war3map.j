    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_BuildBaseCinematicSetUp_Func050001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

