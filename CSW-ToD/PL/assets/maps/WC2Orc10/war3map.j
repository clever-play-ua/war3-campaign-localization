function Trig_OptionalQuestAllianceBaseCompleted_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_P15BuildingChecker, Condition(function Trig_OptionalQuestAllianceBaseCompleted_Func002Func001001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

