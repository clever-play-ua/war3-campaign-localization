endfunction

function Trig_P02AliveBuildingChecker_Func010001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_P02AliveBuildingChecker_Func010001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'o61C'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_P02AliveBuildingChecker_Func010002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P02BuildingsAlive)
endfunction

function Trig_P02AliveBuildingChecker_Func013001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'u600' )
endfunction

function Trig_P02AliveBuildingChecker_Func013001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_P02AliveBuildingChecker_Func013001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'u600'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_P02AliveBuildingChecker_Func013002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P02BuildingsAlive)
endfunction

function Trig_P02AliveBuildingChecker_Func015C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P02BuildingsAlive) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P02AliveBuildingChecker_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_AllianceNavy, Condition(function Trig_P02AliveBuildingChecker_Func004001002)), function Trig_P02AliveBuildingChecker_Func004002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_AllianceNavy, Condition(function Trig_P02AliveBuildingChecker_Func007001002)), function Trig_P02AliveBuildingChecker_Func007002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_AllianceNavy, Condition(function Trig_P02AliveBuildingChecker_Func010001002)), function Trig_P02AliveBuildingChecker_Func010002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(udg_Player_AllianceNavy, Condition(function Trig_P02AliveBuildingChecker_Func013001002)), function Trig_P02AliveBuildingChecker_Func013002)
    // //
    if ( Trig_P02AliveBuildingChecker_Func015C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_P02Gold)
        call DisableTrigger(gg_trg_P02Lumber)
        call ConditionalTriggerExecute(gg_trg_P02Defeated)
    else
    endif
    // //
    call GroupClear(udg_Group_P02BuildingsAlive)
    // //
endfunction

