    set gg_trg_GuardsAlerted03=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_GuardsAlerted03, gg_rct_GuardTripwire04)
    call TriggerAddCondition(gg_trg_GuardsAlerted03, Condition(function Trig_GuardsAlerted03_Conditions))
