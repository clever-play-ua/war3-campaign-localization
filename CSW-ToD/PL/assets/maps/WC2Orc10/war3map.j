    call SetUnitPositionLoc(gg_unit_h625_0189, GetRectCenter(gg_rct_ArmyArcher10Start))
    // //
    call SetUnitPositionLoc(gg_unit_n001_0213, GetRectCenter(gg_rct_ArmyOgre06Start))
    call SetUnitPositionLoc(gg_unit_n001_0200, GetRectCenter(gg_rct_ArmyOgre05Start))
    call SetUnitPositionLoc(gg_unit_n001_0214, GetRectCenter(gg_rct_ArmyOgre04Start))
    // //
    call SetUnitPositionLoc(gg_unit_o60P_0177, GetRectCenter(gg_rct_ArmyCatapult01Start))
