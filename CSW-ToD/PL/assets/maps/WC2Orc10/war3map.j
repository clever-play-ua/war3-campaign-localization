//===========================================================================
// Trigger: MainQuestAssaultDiscovered
//===========================================================================
function Trig_MainQuestAssaultDiscovered_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetDiscoveredBJ(udg_MQAssault, true)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_Assault), 768.00)
    set udg_VisMod_Assault=GetLastCreatedFogModifier()
    // //
    call PingMinimapLocForForceEx(GetPlayersAll(), GetRectCenter(gg_rct_Assault), 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_Assault))
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_Assault), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_Cathedral=GetLastCreatedMinimapIcon()
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3374")
    // //
    // //
    set udg_String_CheckpointPhaseName="WarchiefArrived"
    call ConditionalTriggerExecute(gg_trg_SaveCheckPoint)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_HINT)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

