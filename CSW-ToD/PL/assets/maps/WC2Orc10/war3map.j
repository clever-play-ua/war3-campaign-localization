    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_AllianceNavy ) ) then
        return false
    endif
    if ( not Trig_P02_Attacker_Index_Func004C() ) then
        return false
    endif
    return true
endfunction

