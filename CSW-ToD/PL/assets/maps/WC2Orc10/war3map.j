    call DestroyQuestBJ(udg_OQPlaceOfPower)
    // //
    call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_3899", "TRIGSTR_3900", "ReplaceableTextures\\CommandButtons\\BTNAltarOfKings.blp")
    set udg_OQPlaceOfPower=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQPlaceOfPower, "TRIGSTR_3901")
    set udg_QReq_PlaceOfPower=GetLastCreatedQuestItemBJ()
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_330")
    // //
    call CreateFogModifierRadiusLocBJ(true, Player(0), FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_PlaceOfPower), 512.00)
    set udg_VisMod_PlaceOfPower=GetLastCreatedFogModifier()
    // //
    call PingMinimapLocForForceEx(GetPlayersAll(), GetRectCenter(gg_rct_PlaceOfPower), 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_PlaceOfPower))
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_PlaceOfPower), bj_CAMPPINGSTYLE_BONUS)
    set udg_MinimapIcon_PlaceOfPower=GetLastCreatedMinimapIcon()
    call EnableTrigger(gg_trg_PingMapPlaceOfPower)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

