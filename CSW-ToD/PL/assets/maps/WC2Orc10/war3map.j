function Trig_OptionalQuestWallsUpdatedReq03_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call RemoveUnit(udg_Unit_ExplosionTargetArr[3])
    // //
    set udg_Int_ExplosionWallsCounter=( udg_Int_ExplosionWallsCounter + 1 )
    // //
    if ( Trig_OptionalQuestWallsUpdatedReq03_Func006C() ) then
        call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_Quests, udg_Int_ExplosionWallsCounter)
        call QuestItemSetDescriptionBJ(udg_QReq_Explosives[1], "TRIGSTR_3955")
    else
        if ( Trig_OptionalQuestWallsUpdatedReq03_Func006Func003C() ) then
            call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_Quests, udg_Int_ExplosionWallsCounter)
            call QuestItemSetDescriptionBJ(udg_QReq_Explosives[1], "TRIGSTR_3957")
        else
            if ( Trig_OptionalQuestWallsUpdatedReq03_Func006Func003Func001C() ) then
                call LeaderboardSetPlayerItemValueBJ(Player(0), udg_Leaderboard_Quests, udg_Int_ExplosionWallsCounter)
                call QuestItemSetDescriptionBJ(udg_QReq_Explosives[1], "TRIGSTR_3956")
            else
            endif
        endif
    endif
    call TriggerSleepAction(2.00)
    // //
    if ( Trig_OptionalQuestWallsUpdatedReq03_Func009C() ) then
        call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_3958")
    else
        if ( Trig_OptionalQuestWallsUpdatedReq03_Func009Func002C() ) then
            call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_3959")
        else
            call ConditionalTriggerExecute(gg_trg_OptionalQuestWallsCompleted)
        endif
    endif
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_OptionalQuestWallsUpdatedReq03 takes nothing returns nothing
    set gg_trg_OptionalQuestWallsUpdatedReq03=CreateTrigger()
    call TriggerAddAction(gg_trg_OptionalQuestWallsUpdatedReq03, function Trig_OptionalQuestWallsUpdatedReq03_Actions)
endfunction

//===========================================================================
// Trigger: OptionalQuestWallsCompleted
//===========================================================================
function Trig_OptionalQuestWallsCompleted_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestItemSetCompletedBJ(udg_QReq_Explosives[1], true)
    call QuestSetCompletedBJ(udg_OQExplosives, true)
    call LeaderboardRemovePlayerItemBJ(Player(0), udg_Leaderboard_Quests)
    call ConditionalTriggerExecute(gg_trg_QuestBoardUpdate)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_COMPLETED, "TRIGSTR_3495")
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    call QueuedTriggerAddBJ(gg_trg_UtokLevelUp, true)
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    set udg_String_CheckpointPhaseName="WallsBreached"
    call ConditionalTriggerExecute(gg_trg_SaveCheckPoint)
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

