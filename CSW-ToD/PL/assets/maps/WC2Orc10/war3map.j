function Trig_DeathKnightsCinematicSkipped_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_CinDeathKnightsOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DeathKnightsCinematicSkipped_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinDeathKnightsSkipped=true
    call ConditionalTriggerExecute(gg_trg_DeathKnightsCinematicCleanUp)
    call StopSoundBJ(gg_snd_DeathKnightCreation, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan3, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan4, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan5, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan6, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan7, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan8, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan9, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan10, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan11, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan12, false)
    call StopSoundBJ(gg_snd_WC2Orc10THGuldan13, false)
    call StopSoundBJ(gg_snd_WC2Orc10Doomhammer6, false)
    call StopSoundBJ(gg_snd_WC2Orc10Doomhammer7, false)
    call StopSoundBJ(gg_snd_WC2Orc10Doomhammer8, false)
    call StopSoundBJ(gg_snd_WC2Orc10Gorefiend1, false)
    call StopSoundBJ(gg_snd_WC2Orc10Terongor1, false)
endfunction

//===========================================================================
function InitTrig_DeathKnightsCinematicSkipped takes nothing returns nothing
    set gg_trg_DeathKnightsCinematicSkipped=CreateTrigger()
    call TriggerRegisterPlayerEventEndCinematic(gg_trg_DeathKnightsCinematicSkipped, Player(0))
    call TriggerAddCondition(gg_trg_DeathKnightsCinematicSkipped, Condition(function Trig_DeathKnightsCinematicSkipped_Conditions))
    call TriggerAddAction(gg_trg_DeathKnightsCinematicSkipped, function Trig_DeathKnightsCinematicSkipped_Actions)
endfunction

