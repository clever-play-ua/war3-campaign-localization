    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_DeathKnightsCinematicSetUp_Func081Func001Func001C takes nothing returns boolean
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B00P' ) ) then
        return true
    endif
    if ( ( GetDestructableTypeId(GetEnumDestructable()) == 'B00O' ) ) then
        return true
    endif
    return false
endfunction

function Trig_DeathKnightsCinematicSetUp_Func081Func001C takes nothing returns boolean
    if ( not Trig_DeathKnightsCinematicSetUp_Func081Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_DeathKnightsCinematicSetUp_Func081A takes nothing returns nothing
    if ( Trig_DeathKnightsCinematicSetUp_Func081Func001C() ) then
        call SetDestructableAnimationBJ(GetEnumDestructable(), "stand")
    else
    endif
endfunction

function Trig_DeathKnightsCinematicSetUp_Func096C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_SemiHero_TeronOrc) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DeathKnightsCinematicSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call SetTimeOfDay(0.00)
    call UseTimeOfDayBJ(false)
    call SetSkyModel("CSW\\Environment\\Sky\\SpaceSky\\ArathiSkyboxNight.mdx")
    call SetTerrainFogExBJ(0, 1000.00, 3000.00, 0, 10.00, 10.00, 10.00)
    // //
    call SetDoodadAnimationRectBJ("stand", 'YOcp', gg_rct_DKCinLightControl)
    // //
    // Move Units out of Cathedral
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_TavernDistrict, udg_Player_Actual), function Trig_DeathKnightsCinematicSetUp_Func012A)
    // //
    // Pause Players
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_DeathKnightsCinematicSetUp_Func016A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_AllianceNavy), function Trig_DeathKnightsCinematicSetUp_Func018A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_StratholmeCityWatch), function Trig_DeathKnightsCinematicSetUp_Func020A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_NavyDummy), function Trig_DeathKnightsCinematicSetUp_Func022A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Lordaeron), function Trig_DeathKnightsCinematicSetUp_Func024A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_SilverHand), function Trig_DeathKnightsCinematicSetUp_Func026A)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_DTg7_6462, false)
    call SetDestAnimationSpeedPercent(gg_dest_DTg7_6462, 10.00)
    // //
    call SetUnitPositionLocFacingBJ(gg_unit_u005_0185, GetRectCenter(gg_rct_CorpseWagon02), 208.32)
    call SetUnitInvulnerable(gg_unit_u005_0185, false)
    call SetUnitPositionLocFacingBJ(gg_unit_u005_0212, GetRectCenter(gg_rct_CorpseWagon03), 317.05)
    call SetUnitInvulnerable(gg_unit_u005_0212, false)
    call SetUnitPositionLocFacingBJ(gg_unit_u005_0204, GetRectCenter(gg_rct_CorpseWagon01), 30.54)
    call SetUnitInvulnerable(gg_unit_u005_0204, false)
    // //
    call CreateNUnitsAtLoc(1, 'u000', udg_Player_ShadowCouncil, GetRectCenter(gg_rct_CinDeathKnight01), 294.10)
    set udg_Unit_StormwindKnightCorpse[1]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_StormwindKnightCorpse[1], "decay bone")
    call SetUnitBlendTimeBJ(GetLastCreatedUnit(), 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'u000', udg_Player_ShadowCouncil, GetRectCenter(gg_rct_CinDeathKnight02), 266.44)
    set udg_Unit_StormwindKnightCorpse[2]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_StormwindKnightCorpse[2], "decay bone")
    call SetUnitBlendTimeBJ(GetLastCreatedUnit(), 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'u000', udg_Player_ShadowCouncil, GetRectCenter(gg_rct_CinDeathKnight03), 247.09)
    set udg_Unit_StormwindKnightCorpse[3]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_StormwindKnightCorpse[3], "decay bone")
    call SetUnitBlendTimeBJ(GetLastCreatedUnit(), 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'u000', udg_Player_ShadowCouncil, GetRectCenter(gg_rct_CinDeathKnight04), 228.41)
    set udg_Unit_StormwindKnightCorpse[4]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_StormwindKnightCorpse[4], "decay bone")
    call SetUnitBlendTimeBJ(GetLastCreatedUnit(), 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'u000', udg_Player_ShadowCouncil, GetRectCenter(gg_rct_CinDeathKnight05), 195.20)
    set udg_Unit_StormwindKnightCorpse[5]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_StormwindKnightCorpse[5], "decay bone")
    call SetUnitBlendTimeBJ(GetLastCreatedUnit(), 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'u000', udg_Player_ShadowCouncil, GetRectCenter(gg_rct_CinDeathKnight06), 181.80)
    set udg_Unit_StormwindKnightCorpse[6]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_StormwindKnightCorpse[6], "decay bone")
    call SetUnitBlendTimeBJ(GetLastCreatedUnit(), 0.50)
    // //
    call CreateNUnitsAtLoc(1, 'u000', udg_Player_ShadowCouncil, GetRectCenter(gg_rct_CinDeathKnight07), 202.51)
    set udg_Unit_StormwindKnightCorpse[7]=GetLastCreatedUnit()
    call SetUnitAnimation(udg_Unit_StormwindKnightCorpse[7], "decay bone")
    call SetUnitBlendTimeBJ(GetLastCreatedUnit(), 0.50)
    // //
    call SetUnitPathing(udg_FakeTeronDK, false)
    call SetUnitPositionLocFacingBJ(udg_FakeTeronDK, GetRectCenter(gg_rct_TeronGorefindAppears), 250.18)
    call SetUnitAnimation(udg_FakeTeronDK, "decay bone")
    call SetUnitBlendTimeBJ(udg_FakeTeronDK, 0.50)
    // //
    call EnumDestructablesInRectAll(gg_rct_DKStaves, function Trig_DeathKnightsCinematicSetUp_Func081A)
    // //
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeGuldan, GetRectCenter(gg_rct_CinDeathKnigtGuldan00), 180.00)
    call SetUnitPathing(udg_FakeGuldan, false)
    call SelectHeroSkill(udg_FakeGuldan, 'XAG3')
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeDoomhammer, GetRectCenter(gg_rct_CinDeathKnigtDoomhammer00), 180.00)
    call SetUnitPathing(udg_FakeDoomhammer, false)
    call BlzSetUnitSkin(udg_FakeDoomhammer, 'ODCN')
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeDoomhammer)
    call SetUnitMoveSpeed(udg_FakeDoomhammer, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeDoomhammer, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitBlendTimeBJ(udg_FakeDoomhammer, 0.50)
    // //
    if ( Trig_DeathKnightsCinematicSetUp_Func096C() ) then
        call RemoveUnit(udg_SemiHero_TeronOrc)
    else
    endif
    // //
    call SetPlayerTechMaxAllowedSwap('o60E', 0, udg_Player_Actual)
    // //
    call SetUnitPathing(udg_FakeTeronOrc, false)
    call SetUnitPositionLocFacingLocBJ(udg_FakeTeronOrc, GetRectCenter(gg_rct_TeronGorefindAppears), GetRectCenter(gg_rct_CinDeathKnigtGuldan01))
    call UnitShareVisionBJ(true, udg_FakeTeronOrc, udg_Player_Actual)
    // //
    // //
    // //
    // //
    // //
endfunction

