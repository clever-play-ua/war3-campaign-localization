function CreateUnitsForPlayer8 takes nothing returns nothing
    local player p= Player(8)
    local unit u
    local integer unitID
    local trigger t
    local real life

    set u=BlzCreateUnitWithSkin(p, 'nemi', - 3325.8, 9208.8, 264.550, 'nemi')
    call SetUnitColor(u, ConvertPlayerColor(22))
    set t=CreateTrigger()
    call TriggerRegisterUnitEvent(t, u, EVENT_UNIT_DEATH)
    call TriggerRegisterUnitEvent(t, u, EVENT_UNIT_CHANGE_OWNER)
    call TriggerAddAction(t, function Unit000254_DropItems)
    set gg_unit_hpea_0712=BlzCreateUnitWithSkin(p, 'hpea', 6285.1, - 2156.2, 29.401, 'hpea')
