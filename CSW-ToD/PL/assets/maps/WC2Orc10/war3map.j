//===========================================================================
function Trig_AllianceOilRigDies_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'u600' ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllianceOilRigDies_Func004Func002C takes nothing returns boolean
    if ( not ( RectContainsUnit(udg_Region_AllianceOilRigArr[GetForLoopIndexA()], GetDyingUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllianceOilRigDies_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_GoodJob)
    call GroupRemoveUnitSimple(GetDyingUnit(), udg_EnemyOilRigsGroup)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Region_AllianceOilRigArr[GetForLoopIndexA()]=RectFromCenterSizeBJ(udg_Point_OilRigArr[GetForLoopIndexA()], 256.00, 256.00)
        if ( Trig_AllianceOilRigDies_Func004Func002C() ) then
            call DestroyMinimapIcon(udg_MinimapIcon_OilRigsArr[GetForLoopIndexA()])
            call DestroyFogModifier(udg_VisMod_OilRigArr[GetForLoopIndexA()])
        else
        endif
        call RemoveRect(udg_Region_AllianceOilRigArr[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

