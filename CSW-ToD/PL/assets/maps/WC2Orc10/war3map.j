//===========================================================================
// Trigger: HeroLevelCap
//===========================================================================
function Trig_HeroLevelCap_Func002C takes nothing returns boolean
    if ( not ( GetLevelingUnit() == udg_Hero_Guldan ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero_Guldan) == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HeroLevelCap_Func003C takes nothing returns boolean
    if ( not ( GetLevelingUnit() == udg_Hero_Chogall ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero_Chogall) == 9 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HeroLevelCap_Func004C takes nothing returns boolean
    if ( not ( GetLevelingUnit() == udg_Hero_DoomHammer ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero_DoomHammer) == 8 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HeroLevelCap_Actions takes nothing returns nothing
    if ( Trig_HeroLevelCap_Func002C() ) then
        call SuspendHeroXPBJ(false, udg_Hero_Guldan)
    else
    endif
    if ( Trig_HeroLevelCap_Func003C() ) then
        call SuspendHeroXPBJ(false, udg_Hero_Chogall)
    else
    endif
    if ( Trig_HeroLevelCap_Func004C() ) then
        call SuspendHeroXPBJ(false, udg_Hero_DoomHammer)
    else
    endif
endfunction

//===========================================================================
function InitTrig_HeroLevelCap takes nothing returns nothing
    set gg_trg_HeroLevelCap=CreateTrigger()
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_HeroLevelCap, Player(0), EVENT_PLAYER_HERO_LEVEL)
    call TriggerAddAction(gg_trg_HeroLevelCap, function Trig_HeroLevelCap_Actions)
endfunction

