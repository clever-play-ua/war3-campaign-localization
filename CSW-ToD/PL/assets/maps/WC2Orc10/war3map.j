function Trig_InitQuests_Func010002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_Kobolds)
endfunction

function Trig_InitQuests_Func022002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_EnemyOilRigsGroup)
endfunction

function Trig_InitQuests_Func025002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_EnemyPortBuildings)
endfunction

function Trig_InitQuests_Func028002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_EnemyPortBuildings)
endfunction

function Trig_InitQuests_Func031002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_EnemyPortBuildings)
endfunction

function Trig_InitQuests_Actions takes nothing returns nothing
    // Foothold
    // /////
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_252", "TRIGSTR_253", "ReplaceableTextures\\CommandButtons\\BTNOrcBattleStandard.blp")
    set udg_MQGoldmine=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQGoldmine, "TRIGSTR_289")
    set udg_QReq_Goldmine[1]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQGoldmine, "TRIGSTR_3240")
    set udg_QReq_Goldmine[2]=GetLastCreatedQuestItemBJ()
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_GoldmineCobolds, Player(PLAYER_NEUTRAL_AGGRESSIVE)), function Trig_InitQuests_Func010002)
    // /////
    // Port
    // /////
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3356", "TRIGSTR_3357", "ReplaceableTextures\\CommandButtons\\BTNHumanShipyard.blp")
    set udg_MQAllianceOil=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQAllianceOil, "TRIGSTR_3358")
    set udg_QReq_PortBuildings[1]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQAllianceOil, "TRIGSTR_3359")
    set udg_QReq_PortBuildings[2]=GetLastCreatedQuestItemBJ()
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(1), 'u600'), function Trig_InitQuests_Func022002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(1), 'o61C'), function Trig_InitQuests_Func025002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(1), 'o61A'), function Trig_InitQuests_Func028002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAndTypeId(Player(1), 'h60X'), function Trig_InitQuests_Func031002)
    // /////
    // Assault
    // /////
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3369", "TRIGSTR_3370", "ReplaceableTextures\\CommandButtons\\BTNBattleStations.blp")
    set udg_MQAssault=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQAssault, "TRIGSTR_3371")
    set udg_QReqAssault[1]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQAssault, "TRIGSTR_3372")
    set udg_QReqAssault[2]=GetLastCreatedQuestItemBJ()
    // /////
    // Stratholme Keep
    // /////
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3360", "TRIGSTR_3361", "ReplaceableTextures\\CommandButtons\\BTNCastle.blp")
    set udg_MQStratholme=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQStratholme, "TRIGSTR_3362")
    set udg_QReq_StratholmeWatch[1]=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQStratholme, "TRIGSTR_3965")
    set udg_QReq_StratholmeTownHalls[1]=GetLastCreatedQuestItemBJ()
    // //
    set udg_Unit_MQStratTHArr[1]=gg_unit_h61C_0993
    call SetUnitInvulnerable(udg_Unit_MQStratTHArr[1], true)
    set udg_Unit_MQStratTHArr[2]=gg_unit_h61C_0995
    call SetUnitInvulnerable(udg_Unit_MQStratTHArr[2], true)
    set udg_Unit_MQStratTHArr[3]=gg_unit_h61C_0994
    call SetUnitInvulnerable(udg_Unit_MQStratTHArr[3], true)
    // //
    // /////
    // Last Stand
    // /////
    call CreateQuestBJ(bj_QUESTTYPE_REQ_UNDISCOVERED, "TRIGSTR_3460", "TRIGSTR_3461", "ReplaceableTextures\\CommandButtons\\BTNHolyBolt.blp")
    set udg_MQLastStand=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_MQLastStand, "TRIGSTR_3967")
    set udg_QReq_LastStandChurch=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQLastStand, "TRIGSTR_3462")
    set udg_QReq_LastStandPaladins=GetLastCreatedQuestItemBJ()
    call CreateQuestItemBJ(udg_MQLastStand, "TRIGSTR_3966")
    set udg_QReq_LastStandMara=GetLastCreatedQuestItemBJ()
    // /////
    // Place of Power
    // /////
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_3556", "TRIGSTR_3557", "ReplaceableTextures\\CommandButtons\\BTNAltarOfKings.blp")
    set udg_OQPlaceOfPower=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQPlaceOfPower, "TRIGSTR_3558")
    set udg_QReq_PlaceOfPower=GetLastCreatedQuestItemBJ()
    // /////
    // Alliance Camp
    // /////
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_3363", "TRIGSTR_3364", "ReplaceableTextures\\CommandButtons\\BTNHumanCaptureFlag.blp")
    set udg_OQAllianceCamp=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQAllianceCamp, "TRIGSTR_3365")
    set udg_QReq_DestroyAllianceCamp[1]=GetLastCreatedQuestItemBJ()
    // /////
    // Kaboom
    // /////
    call CreateQuestBJ(bj_QUESTTYPE_OPT_UNDISCOVERED, "TRIGSTR_3463", "TRIGSTR_3464", "ReplaceableTextures\\CommandButtons\\BTNSelfDestruct.blp")
    set udg_OQExplosives=GetLastCreatedQuestBJ()
    call CreateQuestItemBJ(udg_OQExplosives, "TRIGSTR_3465")
    set udg_QReq_Explosives[1]=GetLastCreatedQuestItemBJ()
    // /////
endfunction

