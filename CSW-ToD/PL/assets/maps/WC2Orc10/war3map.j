//===========================================================================
// Trigger: ArrivalCinSetUp
//===========================================================================
function Trig_ArrivalCinSetUp_Func010A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func012A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func014A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func016A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func018A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func020A takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func024A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_ArrivalCinSetUp_Func027A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_ArrivalCinSetUp_Func030A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HiddenUnits)
endfunction

function Trig_ArrivalCinSetUp_Func032C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Chogall) == true ) ) then
        return false
    endif
    if ( not ( IsUnitHiddenBJ(udg_Hero_Chogall) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ArrivalCinSetUp_Func035002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func036002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func039002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func040002 takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Func041002 takes nothing returns nothing
    call SetUnitMoveSpeed(GetEnumUnit(), udg_Real_CinWalkSpeed150)
endfunction

function Trig_ArrivalCinSetUp_Func042002 takes nothing returns nothing
    call BlzSetUnitRealFieldBJ(GetEnumUnit(), UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
endfunction

function Trig_ArrivalCinSetUp_Func043002 takes nothing returns nothing
    call AddUnitAnimationPropertiesBJ(true, "cinematic", GetEnumUnit())
endfunction

function Trig_ArrivalCinSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call SetTerrainFogExBJ(0, 2000.00, 6000.00, 0, 75.30, 75.30, 75.33)
    // //
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    call TriggerSleepAction(0.10)
    // //
    // Pause active players
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Actual), function Trig_ArrivalCinSetUp_Func010A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_AllianceNavy), function Trig_ArrivalCinSetUp_Func012A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_StratholmeCityWatch), function Trig_ArrivalCinSetUp_Func014A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_NavyDummy), function Trig_ArrivalCinSetUp_Func016A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_Lordaeron), function Trig_ArrivalCinSetUp_Func018A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_SilverHand), function Trig_ArrivalCinSetUp_Func020A)
    // //
    // Hide units in cinematic area
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_HidingUnitsForArrivalCin, udg_Player_Actual), function Trig_ArrivalCinSetUp_Func024A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_HidingUnitsForArrivalCin, udg_Player_SilverHand), function Trig_ArrivalCinSetUp_Func027A)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectOfPlayer(gg_rct_HidingUnitsForArrivalCin, udg_Player_Lordaeron), function Trig_ArrivalCinSetUp_Func030A)
    // //
    if ( Trig_ArrivalCinSetUp_Func032C() ) then
        call GroupAddUnitSimple(udg_Hero_Chogall, udg_Group_HiddenUnits)
    else
    endif
    // //
    // Hide Units
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_ArrivalCinSetUp_Func035002)
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_ArrivalCinSetUp_Func036002)
    // //
    // SetUpArmy
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_ArrivalCinSetUp_Func039002)
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_ArrivalCinSetUp_Func040002)
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_ArrivalCinSetUp_Func041002)
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_ArrivalCinSetUp_Func042002)
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_ArrivalCinSetUp_Func043002)
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_ArmyChogall), 0.00)
    // //
    call CreateNUnitsAtLoc(1, 'o621', udg_Player_TwilightHammerClan, GetRectCenter(gg_rct_ArmyTHArcher01), 0.00)
    set udg_FakeTHCinematicUnit[1]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'o621', udg_Player_TwilightHammerClan, GetRectCenter(gg_rct_ArmyTHArcher02), 0.00)
    set udg_FakeTHCinematicUnit[2]=GetLastCreatedUnit()
    // //
    call CreateNUnitsAtLoc(1, 'o621', udg_Player_TwilightHammerClan, GetRectCenter(gg_rct_ArmyTHGrunt01), 0.00)
    set udg_FakeTHCinematicUnit[3]=GetLastCreatedUnit()
    call SetUnitAnimation(GetLastCreatedUnit(), "Cinematic Listening one")
    // //
    call CreateNUnitsAtLoc(1, 'o621', udg_Player_TwilightHammerClan, GetRectCenter(gg_rct_ArmyTHGrunt02), 0.00)
    set udg_FakeTHCinematicUnit[4]=GetLastCreatedUnit()
    call SetUnitAnimation(GetLastCreatedUnit(), "Cinematic Listening one")
    // //
    // //
    // Row1
    // //
    call SetUnitPositionLoc(gg_unit_o61W_0179, GetRectCenter(gg_rct_ArmyGtunt01Start))
    call SetUnitPositionLoc(gg_unit_o61W_0210, GetRectCenter(gg_rct_ArmyGtunt02Start))
    call SetUnitPositionLoc(gg_unit_o61W_0171, GetRectCenter(gg_rct_ArmyGtunt03Start))
    // //
    call SetUnitPositionLoc(gg_unit_o61W_0195, GetRectCenter(gg_rct_ArmyGtunt04Start))
