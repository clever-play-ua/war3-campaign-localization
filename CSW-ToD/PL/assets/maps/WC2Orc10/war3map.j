function Trig_CityHouseDestroyed_Actions takes nothing returns nothing
    // Sceams
    if ( Trig_CityHouseDestroyed_Func002C() ) then
        call QueuedTriggerAddBJ(gg_trg_HintCorpsesSpawnQ, true)
    else
    endif
    // //
    set udg_Int_ScreamType=GetRandomInt(1, 4)
    // //
    if ( Trig_CityHouseDestroyed_Func006C() ) then
        call PlaySoundBJ(gg_snd_ebonhold_crowdscream1)
    else
        if ( Trig_CityHouseDestroyed_Func006Func003C() ) then
            call PlaySoundBJ(gg_snd_ebonhold_crowdscream2)
        else
            if ( Trig_CityHouseDestroyed_Func006Func003Func003C() ) then
                call PlaySoundBJ(gg_snd_ebonhold_crowdscream3)
            else
                call PlaySoundBJ(gg_snd_ebonhold_crowdscream4)
            endif
        endif
    endif
    // //
    // Effects
    // //
    // //
    set udg_Point_CityHouseDestroyedUnit=GetUnitLoc(GetDyingUnit())
    set udg_Region_TempCityHouseDestroyed=RectFromCenterSizeBJ(udg_Point_CityHouseDestroyedUnit, 128.00, 128.00)
    set udg_Point_CityHouseDestroyed=GetRandomLocInRect(udg_Region_TempCityHouseDestroyed)
    // //
    call AddSpecialEffectLocBJ(udg_Point_CityHouseDestroyed, "Environment\\LargeBuildingFire\\LargeBuildingFire0.mdl")
    // //
    call RemoveLocation(udg_Point_CityHouseDestroyed)
    // //
    set udg_Point_CityHouseDestroyed=GetRandomLocInRect(udg_Region_TempCityHouseDestroyed)
    // //
    call AddSpecialEffectLocBJ(udg_Point_CityHouseDestroyed, "Environment\\LargeBuildingFire\\LargeBuildingFire0.mdl")
    // //
    call CreateUbersplatBJ(udg_Point_CityHouseDestroyedUnit, "DHLB", 100, 100, 100, 0, true, false)
    set udg_Int_UberSplatIndex=( udg_Int_UberSplatIndex + 1 )
    set udg_UberSplatArr[udg_Int_UberSplatIndex]=GetLastCreatedUbersplat()
    call SetUbersplatRenderAlways(udg_UberSplatArr[udg_Int_UberSplatIndex], true)
    call ShowUbersplatBJ(true, udg_UberSplatArr[udg_Int_UberSplatIndex])
    // //
    // //
    // //
    // CitizenAmount Roll
    // //
    set udg_Int_CityzenSpawnAmount=GetRandomInt(1, 3)
    // //
    // Spawn
    // //
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=udg_Int_CityzenSpawnAmount
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        // CitizenType Roll
        // //
        set udg_Int_CityzenSpawnType=GetRandomInt(1, 13)
        // //
        // Create Corpses
        call CreateCorpseLocBJ(udg_UnitType_CitizenArr[udg_Int_CityzenSpawnType], udg_Player_Citizens, udg_Point_CityHouseDestroyedUnit)
        // //
        // Create Survivors
        call CreateNUnitsAtLoc(1, udg_UnitType_CitizenArr[udg_Int_CityzenSpawnType], udg_Player_Citizens, udg_Point_CityHouseDestroyedUnit, GetRandomDirectionDeg())
        // //
        call AddUnitAnimationPropertiesBJ(true, "alternate", GetLastCreatedUnit())
        call SetUnitMoveSpeed(GetLastCreatedUnit(), udg_Real_CinWalkSpeed150)
        call BlzSetUnitRealFieldBJ(GetLastCreatedUnit(), UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesGeneric)
        // //
        // Check District
        // //
        if ( Trig_CityHouseDestroyed_Func041Func018C() ) then
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[4])
        else
            if ( Trig_CityHouseDestroyed_Func041Func018Func002C() ) then
                call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[3])
            else
                if ( Trig_CityHouseDestroyed_Func041Func018Func002Func002C() ) then
                    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[6])
                else
                    if ( Trig_CityHouseDestroyed_Func041Func018Func002Func002Func002C() ) then
                        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[2])
                    else
                        if ( Trig_CityHouseDestroyed_Func041Func018Func002Func002Func002Func002C() ) then
                            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[5])
                        else
                            if ( Trig_CityHouseDestroyed_Func041Func018Func002Func002Func002Func002Func002C() ) then
                                call UnitAddAbilityBJ('Awan', GetLastCreatedUnit())
                            else
                                call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[1])
                            endif
                        endif
                    endif
                endif
            endif
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    // //
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=udg_Int_CityzenSpawnAmount
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        // CitizenType Roll
        // //
        set udg_Int_CityzenSpawnType=GetRandomInt(14, 26)
        // //
        // Create Corpses
        call CreateCorpseLocBJ(udg_UnitType_CitizenArr[udg_Int_CityzenSpawnType], udg_Player_Citizens, udg_Point_CityHouseDestroyedUnit)
        // //
        // Create Survivors
        call CreateNUnitsAtLoc(1, udg_UnitType_CitizenArr[udg_Int_CityzenSpawnType], udg_Player_Citizens, udg_Point_CityHouseDestroyedUnit, GetRandomDirectionDeg())
        // //
        call AddUnitAnimationPropertiesBJ(true, "alternate", GetLastCreatedUnit())
        call SetUnitMoveSpeed(GetLastCreatedUnit(), udg_Real_CinWalkSpeed150)
        call BlzSetUnitRealFieldBJ(GetLastCreatedUnit(), UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Group_RefugeesGeneric)
        // //
        // Check District
        // //
        if ( Trig_CityHouseDestroyed_Func043Func018C() ) then
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[4])
        else
            if ( Trig_CityHouseDestroyed_Func043Func018Func002C() ) then
                call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[3])
            else
                if ( Trig_CityHouseDestroyed_Func043Func018Func002Func002C() ) then
                    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[6])
                else
                    if ( Trig_CityHouseDestroyed_Func043Func018Func002Func002Func002C() ) then
                        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[2])
                    else
                        if ( Trig_CityHouseDestroyed_Func043Func018Func002Func002Func002Func002C() ) then
                            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[5])
                        else
                            if ( Trig_CityHouseDestroyed_Func043Func018Func002Func002Func002Func002Func002C() ) then
                                call UnitAddAbilityBJ('Awan', GetLastCreatedUnit())
                            else
                                call IssuePointOrderLocBJ(GetLastCreatedUnit(), "move", udg_Point_RefugeRunArr[1])
                            endif
                        endif
                    endif
                endif
            endif
        endif
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    // //
    // //
    // //
    call RemoveLocation(udg_Point_CityHouseDestroyedUnit)
    call RemoveLocation(udg_Point_CityHouseDestroyed)
    call RemoveRect(udg_Region_TempCityHouseDestroyed)
endfunction

