//===========================================================================
// Trigger: AllPlayerGroundUnitsAreDead
//===========================================================================
function Trig_AllPlayerGroundUnitsAreDead_Conditions takes nothing returns boolean
    if ( not ( udg_Bool_GameOver == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func006001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func006001002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func006001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) == true)) // INLINED!!
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func006002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DefeatConditionPeons)
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func009001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func009001002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true )
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func009001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Actual), (IsUnitType(GetFilterUnit(), UNIT_TYPE_TOWNHALL) == true)) // INLINED!!
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func009002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_DefeatConditionTownHall)
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func011Func002Func004C takes nothing returns boolean
    if ( not ( IsQuestDiscovered(udg_OQAllianceCamp) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func011Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_DefeatConditionTownHall) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Func011C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_DefeatConditionPeons) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_AllPlayerGroundUnitsAreDead_Actions takes nothing returns nothing
    call GroupClear(udg_Group_DefeatConditionPeons)
    call GroupClear(udg_Group_DefeatConditionTownHall)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_AllPlayerGroundUnitsAreDead_Func006001002)), function Trig_AllPlayerGroundUnitsAreDead_Func006002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_AllPlayerGroundUnitsAreDead_Func009001002)), function Trig_AllPlayerGroundUnitsAreDead_Func009002)
    // //
    if ( Trig_AllPlayerGroundUnitsAreDead_Func011C() ) then
        if ( Trig_AllPlayerGroundUnitsAreDead_Func011Func002C() ) then
            call DisableTrigger(GetTriggeringTrigger())
            set udg_Bool_GameOver=true
            // //
            if ( Trig_AllPlayerGroundUnitsAreDead_Func011Func002Func004C() ) then
                call QueuedTriggerAddBJ(gg_trg_OptionalQuestAllianceBaseFailedQ, true)
            else
            endif
            // //
            call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
            call QueuedTriggerAddBJ(gg_trg_MissionFailedTransitionQ, true)
        else
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_AllPlayerGroundUnitsAreDead takes nothing returns nothing
    set gg_trg_AllPlayerGroundUnitsAreDead=CreateTrigger()
    call DisableTrigger(gg_trg_AllPlayerGroundUnitsAreDead)
    call TriggerRegisterPlayerUnitEventSimple(gg_trg_AllPlayerGroundUnitsAreDead, Player(0), EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_AllPlayerGroundUnitsAreDead, Condition(function Trig_AllPlayerGroundUnitsAreDead_Conditions))
    call TriggerAddAction(gg_trg_AllPlayerGroundUnitsAreDead, function Trig_AllPlayerGroundUnitsAreDead_Actions)
endfunction

