    call SetUnitPositionLoc(gg_unit_h625_0186, GetRectCenter(gg_rct_ArmyArcher06Start))
    // //
    call SetUnitPositionLoc(gg_unit_n001_0168, GetRectCenter(gg_rct_ArmyOgre01Start))
    call SetUnitPositionLoc(gg_unit_n001_0199, GetRectCenter(gg_rct_ArmyOgre02Start))
    call SetUnitPositionLoc(gg_unit_n001_0191, GetRectCenter(gg_rct_ArmyOgre03Start))
    // //
    call SetUnitPositionLoc(gg_unit_o60P_0721, GetRectCenter(gg_rct_ArmyCatapult04Start))
    call SetUnitPositionLoc(gg_unit_o60P_0173, GetRectCenter(gg_rct_ArmyCatapult05Start))
    call SetUnitPositionLoc(gg_unit_o60P_0176, GetRectCenter(gg_rct_ArmyCatapult06Start))
    // //
    // Central Lane
    // //
    call SetUnitPositionLoc(gg_unit_u005_0204, GetRectCenter(gg_rct_ArmyCorpseWagon03Start))
    call SetUnitPositionLoc(gg_unit_u005_0212, GetRectCenter(gg_rct_ArmyCorpseWagon02Start))
    call SetUnitPositionLoc(gg_unit_u005_0185, GetRectCenter(gg_rct_ArmyCorpseWagon01Start))
    // //
    // //
    call SetUnitPositionLocFacingBJ(udg_FakeUtok, GetRectCenter(gg_rct_ArmyUtokStart), 180.00)
    // //
    call BlzSetUnitSkin(udg_FakeGuldan, 'OGMo')
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeGuldan)
    call SetUnitMoveSpeed(udg_FakeGuldan, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeGuldan, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitBlendTimeBJ(udg_FakeGuldan, 0.50)
    call SetUnitPositionLocFacingBJ(udg_FakeGuldan, GetRectCenter(gg_rct_ArmyGuldanStart), 180.00)
    call SetUnitPathing(udg_FakeGuldan, false)
    // //
    call BlzSetUnitSkin(udg_FakeDoomhammer, 'OMDC')
    call AddUnitAnimationPropertiesBJ(true, "cinematic", udg_FakeDoomhammer)
    call SetUnitMoveSpeed(udg_FakeDoomhammer, udg_Real_CinWalkSpeed150)
    call BlzSetUnitRealFieldBJ(udg_FakeDoomhammer, UNIT_RF_ANIMATION_WALK_SPEED, udg_Real_CinWalkSpeed150)
    call SetUnitBlendTimeBJ(udg_FakeDoomhammer, 0.50)
    call SetUnitPositionLocFacingBJ(udg_FakeDoomhammer, GetRectCenter(gg_rct_ArmyOrgrimStart), 180.00)
    call SetUnitPositionLoc(udg_FakeDoomhammer, GetRectCenter(gg_rct_ArmyOrgrimStart))
    call SetUnitPathing(udg_FakeDoomhammer, false)
    // //
    // Orer Army to Move
    // //
    call IssuePointOrderLocBJ(udg_FakeDoomhammer, "move", GetRectCenter(gg_rct_ArmyOrgrim))
    call IssuePointOrderLocBJ(udg_FakeGuldan, "move", GetRectCenter(gg_rct_ArmyGuldan))
    // //
    call IssuePointOrderLocBJ(gg_unit_o61W_0179, "move", GetRectCenter(gg_rct_ArmyGtunt01))
    call IssuePointOrderLocBJ(gg_unit_o61W_0210, "move", GetRectCenter(gg_rct_ArmyGtunt02))
    call IssuePointOrderLocBJ(gg_unit_o61W_0171, "move", GetRectCenter(gg_rct_ArmyGtunt03))
    call IssuePointOrderLocBJ(gg_unit_o61W_0170, "move", GetRectCenter(gg_rct_ArmyGtunt07))
    call IssuePointOrderLocBJ(gg_unit_o61W_0209, "move", GetRectCenter(gg_rct_ArmyGtunt08))
    call IssuePointOrderLocBJ(gg_unit_o61W_0208, "move", GetRectCenter(gg_rct_ArmyGtunt09))
    call TriggerSleepAction(0.50)
    // //
    call IssuePointOrderLocBJ(udg_FakeUtok, "move", GetRectCenter(gg_rct_ArmyUtok))
    // //
    call IssuePointOrderLocBJ(gg_unit_o61W_0195, "move", GetRectCenter(gg_rct_ArmyGtunt04))
    call IssuePointOrderLocBJ(gg_unit_o61W_0172, "move", GetRectCenter(gg_rct_ArmyGtunt05))
    call IssuePointOrderLocBJ(gg_unit_o61W_0211, "move", GetRectCenter(gg_rct_ArmyGtunt06))
