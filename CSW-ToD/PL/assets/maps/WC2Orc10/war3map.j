    call IssuePointOrderLocBJ(gg_unit_o61W_0205, "move", GetRectCenter(gg_rct_ArmyGtunt10))
    call TriggerSleepAction(0.50)
    // //
    call IssuePointOrderLocBJ(gg_unit_u005_0185, "move", GetRectCenter(gg_rct_ArmyCorpseWagon01))
    // //
    call IssuePointOrderLocBJ(gg_unit_h625_0193, "move", GetRectCenter(gg_rct_ArmyArcher09))
    call IssuePointOrderLocBJ(gg_unit_h625_0194, "move", GetRectCenter(gg_rct_ArmyArcher08))
