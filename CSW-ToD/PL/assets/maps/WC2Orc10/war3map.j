//===========================================================================
// Trigger: P15AliveBuildingChecker
//===========================================================================
function Trig_P15AliveBuildingChecker_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P15AliveBuildingChecker_Func006001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Lordaeron )
endfunction

function Trig_P15AliveBuildingChecker_Func006001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_P15AliveBuildingChecker_Func006001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_P15AliveBuildingChecker_Func006001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_P15AliveBuildingChecker_Func006001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Lordaeron), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_P15AliveBuildingChecker_Func006002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P15BuildingsAlive)
endfunction

function Trig_P15AliveBuildingChecker_Func008C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_P15BuildingsAlive) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_P15AliveBuildingChecker_Actions takes nothing returns nothing
    // //
    call GroupClear(udg_Group_P15BuildingsAlive)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_P15BuildingChecker, Condition(function Trig_P15AliveBuildingChecker_Func006001002)), function Trig_P15AliveBuildingChecker_Func006002)
    // //
    if ( Trig_P15AliveBuildingChecker_Func008C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_P15Gold)
        call DisableTrigger(gg_trg_P15Lumber)
        call ConditionalTriggerExecute(gg_trg_P15Defeated)
    else
    endif
    // //
    call GroupClear(udg_Group_P15BuildingsAlive)
    // //
endfunction

//===========================================================================
function InitTrig_P15AliveBuildingChecker takes nothing returns nothing
    set gg_trg_P15AliveBuildingChecker=CreateTrigger()
    call DisableTrigger(gg_trg_P15AliveBuildingChecker)
    call TriggerRegisterTimerEventPeriodic(gg_trg_P15AliveBuildingChecker, 2)
    call TriggerAddCondition(gg_trg_P15AliveBuildingChecker, Condition(function Trig_P15AliveBuildingChecker_Conditions))
