function Trig_IntroCinSetUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_SetUpCinematicFrame)
    call ConditionalTriggerExecute(gg_trg_CreateFakeActors)
    // //
    // //
    call TriggerSleepAction(0.25)
    call SetUnitPositionLocFacingBJ(udg_FakeChogall, GetRectCenter(gg_rct_ChogallLoad), 270.00)
    call SetUnitBlendTimeBJ(udg_FakeChogall, 0.50)
    // //
    // Peon01
    call SetUnitAnimation(gg_unit_o620_0490, "stand work lumber")
    call SetUnitAnimation(gg_unit_o60M_0466, "birth")
    // Peon02
    call SetUnitAnimation(gg_unit_o620_0488, "stand work lumber")
    call SetUnitAnimation(gg_unit_o60V_0465, "birth")
    // Peon03
    call SetUnitAnimation(gg_unit_o620_0489, "stand work lumber")
    call SetUnitAnimation(gg_unit_o60N_0467, "birth")
    // //
    // //
endfunction

