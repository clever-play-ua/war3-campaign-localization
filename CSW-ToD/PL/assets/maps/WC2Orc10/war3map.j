//===========================================================================
// Trigger: OptionalQuestWallsDiscoveredQ
//===========================================================================
function Trig_OptionalQuestWallsDiscoveredQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetDiscoveredBJ(udg_OQExplosives, true)
    // //
    call SetSpeechVolumeGroupsBJ()
    call PlayDialogueFromSpeakerTypeEx(udg_PlayerGroup_PlayerActual, udg_Player_TwilightHammerClan, 'o621', GetCameraTargetPositionLoc(), gg_snd_WC2Orc10THGrunt_Walls1, bj_TIMETYPE_ADD, 0, true)
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_Hero_Chogall, 'O61R', gg_snd_WC2Orc10ChoGall4, bj_TIMETYPE_ADD, 0, true)
    call VolumeGroupResetBJ()
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3720")
    // //
    call CreateLeaderboardBJ(GetPlayersAll(), "TRIGSTR_3721")
    set udg_Leaderboard_Quests=GetLastCreatedLeaderboard()
    // //
    call LeaderboardAddItemBJ(Player(0), udg_Leaderboard_Quests, "TRIGSTR_3949", udg_Int_ExplosionWallsCounter)
    call LeaderboardSetLabelColorBJ(udg_Leaderboard_Quests, 100, 80, 20, 0)
    call LeaderboardSetValueColorBJ(udg_Leaderboard_Quests, 100, 80, 20, 0)
    call LeaderboardSetStyleBJ(udg_Leaderboard_Quests, true, true, true, false)
    call ConditionalTriggerExecute(gg_trg_QuestBoardUpdate)
    // //
    call ShowUnitShow(udg_Unit_ExplosionTargetArr[1])
    call UnitAddAbility(udg_Unit_ExplosionTargetArr[1], 'Aloc')
    call ShowUnitShow(udg_Unit_ExplosionTargetArr[2])
    call UnitAddAbility(udg_Unit_ExplosionTargetArr[2], 'Aloc')
    call ShowUnitShow(udg_Unit_ExplosionTargetArr[3])
    call UnitAddAbility(udg_Unit_ExplosionTargetArr[3], 'Aloc')
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
endfunction

