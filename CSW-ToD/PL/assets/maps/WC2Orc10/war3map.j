    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_HARD ) ) then
        return false
    endif
    return true
endfunction

function Trig_GuardsAlerted03_Func003Func001C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_NORMAL ) ) then
        return false
    endif
    return true
endfunction

function Trig_GuardsAlerted03_Func003C takes nothing returns boolean
    if ( not ( GetGameDifficulty() == MAP_DIFFICULTY_EASY ) ) then
        return false
    endif
    return true
endfunction

function Trig_GuardsAlerted03_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundBJ(gg_snd_DoorSlam1)
    if ( Trig_GuardsAlerted03_Func003C() ) then
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=3
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call CreateNUnitsAtLoc(1, 'h623', udg_Player_StratholmeCityWatch, udg_Point_SpawnGuardArr[2], bj_UNIT_FACING)
            call IssueTargetOrderBJ(GetLastCreatedUnit(), "attack", GetEnteringUnit())
            call TriggerSleepAction(0.50)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    else
        if ( Trig_GuardsAlerted03_Func003Func001C() ) then
            set bj_forLoopAIndex=1
            set bj_forLoopAIndexEnd=5
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call CreateNUnitsAtLoc(1, 'h623', udg_Player_StratholmeCityWatch, udg_Point_SpawnGuardArr[2], bj_UNIT_FACING)
                call IssueTargetOrderBJ(GetLastCreatedUnit(), "attack", GetEnteringUnit())
                call TriggerSleepAction(0.50)
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
        else
            if ( Trig_GuardsAlerted03_Func003Func001Func001C() ) then
                if ( Trig_GuardsAlerted03_Func003Func001Func001Func001C() ) then
                    set bj_forLoopAIndex=1
                    set bj_forLoopAIndexEnd=7
                    loop
                        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                        call CreateNUnitsAtLoc(1, 'h623', udg_Player_StratholmeCityWatch, udg_Point_SpawnGuardArr[2], bj_UNIT_FACING)
                        call IssueTargetOrderBJ(GetLastCreatedUnit(), "attack", GetEnteringUnit())
                        call TriggerSleepAction(0.50)
                        set bj_forLoopAIndex=bj_forLoopAIndex + 1
                    endloop
                else
                endif
            else
            endif
        endif
    endif
endfunction

