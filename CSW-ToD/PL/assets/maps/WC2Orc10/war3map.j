//===========================================================================
// Trigger: MainQuestStratholmeUpdatedCityWatch
//===========================================================================
function Trig_MainQuestStratholmeUpdatedCityWatch_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( IsQuestDiscovered(udg_MQStratholme) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestStratholmeUpdatedCityWatch_Func002Func005C takes nothing returns boolean
    if ( not ( IsQuestItemCompleted(udg_QReq_StratholmeTownHalls[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestStratholmeUpdatedCityWatch_Func002Func006001001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_StratholmeCityWatch )
endfunction

function Trig_MainQuestStratholmeUpdatedCityWatch_Func002Func006001001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_MainQuestStratholmeUpdatedCityWatch_Func002Func006001001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_MainQuestStratholmeUpdatedCityWatch_Func002Func006001001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_MainQuestStratholmeUpdatedCityWatch_Func002Func006001001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_StratholmeCityWatch), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_MainQuestStratholmeUpdatedCityWatch_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectMatching(gg_rct_StratholmeQuestBuildings, Condition(function Trig_MainQuestStratholmeUpdatedCityWatch_Func002Func006001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestStratholmeUpdatedCityWatch_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    if ( Trig_MainQuestStratholmeUpdatedCityWatch_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DestroyMinimapIcon(udg_MinimapIcon_Stratholme)
        call DestroyFogModifier(udg_VisMod_StratholmeKeep)
        call QuestItemSetCompletedBJ(udg_QReq_StratholmeWatch[1], true)
        if ( Trig_MainQuestStratholmeUpdatedCityWatch_Func002Func005C() ) then
            call QueuedTriggerAddBJ(gg_trg_MainQuestStratholmeCompletedQ, true)
        else
            call TriggerSleepAction(2.00)
            call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_UPDATED, "TRIGSTR_3970")
            call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
        endif
    else
    endif
endfunction

