//===========================================================================
function Trig_HordeCapturingPP_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == udg_Player_Actual ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( udg_Bool_PlaceOfPowerHordeOwned == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_HordeCapturingPP_Func003001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_Lordaeron )
endfunction

function Trig_HordeCapturingPP_Func003001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true )
endfunction

function Trig_HordeCapturingPP_Func003001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_HordeCapturingPP_Func003001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_HordeCapturingPP_Func003001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_Lordaeron), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_HordeCapturingPP_Func003002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PPAllianceControlCheck)
endfunction

function Trig_HordeCapturingPP_Func006001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_SilverHand )
endfunction

function Trig_HordeCapturingPP_Func006001002002001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true )
endfunction

function Trig_HordeCapturingPP_Func006001002002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_HordeCapturingPP_Func006001002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_HordeCapturingPP_Func006001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_SilverHand), (GetBooleanAnd((IsUnitType(GetFilterUnit(), UNIT_TYPE_GROUND) == true), (IsUnitAliveBJ(GetFilterUnit()) == true)))) // INLINED!!
endfunction

function Trig_HordeCapturingPP_Func006002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_PPAllianceControlCheck)
endfunction

function Trig_HordeCapturingPP_Func008C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Group_PPAllianceControlCheck) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_HordeCapturingPP_Actions takes nothing returns nothing
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_ConqueringFountain, Condition(function Trig_HordeCapturingPP_Func003001002)), function Trig_HordeCapturingPP_Func003002)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_ConqueringFountain, Condition(function Trig_HordeCapturingPP_Func006001002)), function Trig_HordeCapturingPP_Func006002)
    // //
    if ( Trig_HordeCapturingPP_Func008C() ) then
        set udg_Bool_PlaceOfPowerHordeOwned=true
        call QueuedTriggerAddBJ(gg_trg_HordeCapturedQ, true)
    else
    endif
    // //
    call GroupClear(udg_Group_PPAllianceControlCheck)
    // //
endfunction

//===========================================================================
function InitTrig_HordeCapturingPP takes nothing returns nothing
    set gg_trg_HordeCapturingPP=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_HordeCapturingPP, gg_rct_ConqueringFountain)
    call TriggerRegisterEnterRectSimple(gg_trg_HordeCapturingPP, gg_rct_RaysOfLight)
    call TriggerAddCondition(gg_trg_HordeCapturingPP, Condition(function Trig_HordeCapturingPP_Conditions))
    call TriggerAddAction(gg_trg_HordeCapturingPP, function Trig_HordeCapturingPP_Actions)
endfunction

