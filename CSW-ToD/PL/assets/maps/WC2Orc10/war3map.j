//===========================================================================
function Trig_P02_Attacker_Deindex_Func004C takes nothing returns boolean
    if ( ( udg_UnitTypeOf[udg_UDex] == 'h9Zx' ) ) then
        return true
    endif
    if ( ( udg_UnitTypeOf[udg_UDex] == 'h9Zy' ) ) then
        return true
    endif
    return false
endfunction

function Trig_P02_Attacker_Deindex_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(udg_UDexUnits[udg_UDex]) == udg_Player_AllianceNavy ) ) then
        return false
    endif
    if ( not Trig_P02_Attacker_Deindex_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_P02_Attacker_Deindex_Func001C takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[udg_UDex] == 'h9Zx' ) ) then
        return false
    endif
    return true
endfunction

function Trig_P02_Attacker_Deindex_Func002C takes nothing returns boolean
    if ( not ( udg_UnitTypeOf[udg_UDex] == 'h9Zy' ) ) then
        return false
    endif
    return true
endfunction

function Trig_P02_Attacker_Deindex_Actions takes nothing returns nothing
    if ( Trig_P02_Attacker_Deindex_Func001C() ) then
        call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_G_P02_AttackerFrg)
    else
    endif
    if ( Trig_P02_Attacker_Deindex_Func002C() ) then
        call GroupRemoveUnitSimple(udg_UDexUnits[udg_UDex], udg_G_P02_AttackerBS)
    else
    endif
endfunction

