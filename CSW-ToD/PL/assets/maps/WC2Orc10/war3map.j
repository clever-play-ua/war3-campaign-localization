//===========================================================================
function Trig_IntroCinQ_Func018001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_IntroCinQ_Func026001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

