    if ( not ( GetSpellAbilityId() == 'A64C' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Life_Tap_Func001C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) >= 21.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Life_Tap_Actions takes nothing returns nothing
    if ( Trig_Life_Tap_Func001C() ) then
        set udg_Guldan_TempPoint_LT=GetUnitLoc(GetTriggerUnit())
        call PlaySoundAtPointBJ(gg_snd_AbilityLifeTap, 100, GetUnitLoc(GetSpellAbilityUnit()), 0)
        call UnitDamageTargetBJ(GetTriggerUnit(), GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) * 0.20 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL)
        call SetUnitManaBJ(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) * 0.20 ) ))
        call RemoveLocation(udg_Guldan_TempPoint_LT)
    else
    endif
endfunction

