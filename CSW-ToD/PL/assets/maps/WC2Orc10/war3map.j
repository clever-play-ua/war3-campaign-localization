    set gg_trg_OptionalQuestWallsUpdatedReq01=CreateTrigger()
    call TriggerAddAction(gg_trg_OptionalQuestWallsUpdatedReq01, function Trig_OptionalQuestWallsUpdatedReq01_Actions)
endfunction

