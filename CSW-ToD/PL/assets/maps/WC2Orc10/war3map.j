    set bj_wantDestroyGroup=true
    if ( Trig_OptionalQuestAllianceBaseCompleted_Func002C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QuestSetCompletedBJ(udg_OQAllianceCamp, true)
