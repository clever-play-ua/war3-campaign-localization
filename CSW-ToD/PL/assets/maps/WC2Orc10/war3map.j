    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_P02AliveBuildingChecker_Func004001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h60X' )
endfunction

function Trig_P02AliveBuildingChecker_Func004001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_P02AliveBuildingChecker_Func004001002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'h60X'), (IsUnitAliveBJ(GetFilterUnit()) == true)) // INLINED!!
endfunction

function Trig_P02AliveBuildingChecker_Func004002 takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_P02BuildingsAlive)
endfunction

function Trig_P02AliveBuildingChecker_Func007001002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'o61A' )
endfunction

function Trig_P02AliveBuildingChecker_Func007001002002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

