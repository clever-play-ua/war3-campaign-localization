function Trig_Initialization_Actions takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_Oil_Locale_Setup)
    call SetAllyColorFilterState(0)
    call EnableMinimapFilterButtons(false, false)
    call SetMaxCheckpointSaves(10)
    set udg_String_CheckpointChapterName="WC2Orc10"
    call EnableOcclusionBJ(true, GetPlayersAll())
    call ConditionalTriggerExecute(gg_trg_Init_03_Audio)
    // Environment
    call SetTimeOfDay(3.00)
    call SetSkyModel("Environment\\Sky\\FoggedSky\\FoggedSky.mdl")
    call SetTerrainFogExBJ(0, 3000.00, 12500.00, 0, 75.30, 75.30, 75.33)
    call SetDayNightModels("csw\\environment\\dnc\\lordaeronwinter\\dnclordaeronwinterterrain.mdx", "csw\\environment\\dnc\\lordaeronwinter\\dnclordaeronwinterunit.mdx")
    // //
    call ConditionalTriggerExecute(gg_trg_InitLocations)
    // //
    set udg_Real_ChangeWeatherBot=60.00
    set udg_Real_ChangeWeatherTop=180.00
    // //
    set udg_Real_LightSnowDurBot=60.00
    set udg_Real_LightSnowDurTop=120.00
    // //
    set udg_Real_HeavySnowDurBot=240.00
    set udg_Real_HeavySnowDurTop=360.00
    // //
    call SetDoodadAnimationRectBJ("death", 'YOcp', gg_rct_DKCinLightControl)
    call SetDoodadAnimationRectBJ("death", 'YOcp', gg_rct_SilverhandCinLightControl)
    // //
    // Fires from Oil
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_GateFire01)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_GateFire01)
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_GateFire01)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_GateFire02)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_GateFire02)
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_GateFire02)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_GateFire03)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_GateFire03)
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_GateFire03)
    // //
    call SetDoodadAnimationRectBJ("death", 'YOtf', gg_rct_GateFire04)
    call SetDoodadAnimationRectBJ("death", 'YOf3', gg_rct_GateFire04)
    call SetDoodadAnimationRectBJ("death", 'YOfs', gg_rct_GateFire04)
    // //
    call SetUnitAnimation(gg_unit_hpea_0712, "stand work lumber")
    call SetUnitAnimation(gg_unit_hpea_0713, "stand work lumber")
    call SetUnitAnimation(gg_unit_hpea_0714, "stand work lumber")
    // //
    // DeathKnightStaves
    call EnumDestructablesInRectAll(gg_rct_DKStaves, function Trig_Initialization_Func051A)
    // //
    // CathedralGate
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_LTg3_0161)
    // ChapelOfLightGate
    call SetDestructableInvulnerableBJ(gg_dest_LTg1_0099, true)
    call SetDestructableInvulnerableBJ(gg_dest_LTg3_0476, true)
    // CemeteryGate
    call SetDestructableInvulnerableBJ(gg_dest_DTg7_6462, true)
    // Cirty Entrance
    call SetDestructableInvulnerableBJ(gg_dest_LTg2_0086, true)
    call SetDestructableInvulnerableBJ(gg_dest_LTg4_0087, true)
    // Cirty Exit
    call ModifyGateBJ(bj_GATEOPERATION_OPEN, gg_dest_LTg1_0490)
    // Burning Gates
    call SetDestructableInvulnerableBJ(gg_dest_LTg4_2351, true)
    call SetDestructableInvulnerableBJ(gg_dest_LTg4_0238, true)
    call SetDestructableInvulnerableBJ(gg_dest_LTg4_1946, true)
    call SetDestructableInvulnerableBJ(gg_dest_LTg2_2078, true)
    // OilBarrels For the Fire
    call EnumDestructablesInRectAll(gg_rct_GateFire03, function Trig_Initialization_Func071A)
    call EnumDestructablesInRectAll(gg_rct_GateFire04, function Trig_Initialization_Func072A)
    call EnumDestructablesInRectAll(gg_rct_GateFire02, function Trig_Initialization_Func073A)
    call EnumDestructablesInRectAll(gg_rct_GateFire01, function Trig_Initialization_Func074A)
    // HideOilPuddles
    call EnumDestructablesInRectAll(gg_rct_GateFire01, function Trig_Initialization_Func076A)
    call EnumDestructablesInRectAll(gg_rct_GateFire02, function Trig_Initialization_Func077A)
    call EnumDestructablesInRectAll(gg_rct_GateFire03, function Trig_Initialization_Func078A)
    call EnumDestructablesInRectAll(gg_rct_GateFire04, function Trig_Initialization_Func079A)
    // Misc
    // //
    // hide castle that is used for battleship requirements
    call ShowUnitHide(gg_unit_h61A_0381)
    // //
    // Rays Of Light
    call AddWeatherEffectSaveLast(gg_rct_RaysOfLight, 'LRaa')
    set udg_Weather_SunRays=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Weather_SunRays, true)
    // StartGame
    call ConditionalTriggerExecute(gg_trg_InitPlayers)
    call ConditionalTriggerExecute(gg_trg_InitNeutrals)
    call ConditionalTriggerExecute(gg_trg_FaceAnimLoader)
    call ConditionalTriggerExecute(gg_trg_IntroCinQ)
    // //
    // //
endfunction

