//===========================================================================
// Trigger: InitPlayers
//===========================================================================
function Trig_InitPlayers_Func042002 takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_InitPlayers_Actions takes nothing returns nothing
    set udg_PlayerGroup_PlayerActual=bj_FORCE_PLAYER[0]
    // //
    set udg_Player_Actual=Player(0)
    call SetPlayerName(udg_Player_Actual, "TRIGSTR_3916")
    call SetPlayerColorBJ(udg_Player_Actual, PLAYER_COLOR_PURPLE, true)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_GOLD, 2500)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_LUMBER, 2000)
    call SetPlayerStateBJ(udg_Player_Actual, PLAYER_STATE_RESOURCE_FOOD_CAP, 30)
    call playerAddOil(Player(0) , 200)
    call SetPlayerHandicapXPBJ(udg_Player_Actual, 15.00)
    call SetPlayerTechMaxAllowedSwap('o605', 0, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('u007', 0, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o60E', 1, udg_Player_Actual)
    call SetPlayerTechMaxAllowedSwap('o608', 0, udg_Player_Actual)
    // //
    set udg_Player_AllianceNavy=Player(1)
    call SetPlayerAbilityAvailableBJ(false, 'A65B', udg_Player_AllianceNavy)
    // //
    set udg_Player_TwilightHammerClan=Player(3)
    // //
    set udg_Player_Citizens=Player(8)
    // //
    set udg_Player_SilverHand=Player(9)
    // //
    set udg_Player_BlackRockClan=Player(12)
    // //
    set udg_Player_ShadowCouncil=Player(13)
    // //
    set udg_Player_Lordaeron=Player(14)
    // //
    set udg_Player_NavyDummy=Player(19)
    call SetPlayerAbilityAvailableBJ(false, 'A65B', udg_Player_NavyDummy)
    // //
    set udg_Player_StratholmeCityWatch=Player(21)
    // //
    set udg_Player_StratholmeWatchDummy=Player(2)
    call SetPlayerColorBJ(udg_Player_StratholmeWatchDummy, PLAYER_COLOR_BLUE, true)
    // //
    set udg_Player_CinematicDummy=Player(23)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_Player_CinematicDummy), function Trig_InitPlayers_Func042002)
    // //
    call ConditionalTriggerExecute(gg_trg_InitPalyerHorde)
    // //
    call ConditionalTriggerExecute(gg_trg_InitPlayerAlliance)
    // //
    call ConditionalTriggerExecute(gg_trg_Easy)
    call ConditionalTriggerExecute(gg_trg_Normal)
    call ConditionalTriggerExecute(gg_trg_Hard)
endfunction

//===========================================================================
function InitTrig_InitPlayers takes nothing returns nothing
    set gg_trg_InitPlayers=CreateTrigger()
    call TriggerAddAction(gg_trg_InitPlayers, function Trig_InitPlayers_Actions)
endfunction

//===========================================================================
// Trigger: InitPalyerHorde
//===========================================================================
function Trig_InitPalyerHorde_Func026A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_HordeArmy)
endfunction

function Trig_InitPalyerHorde_Func028002 takes nothing returns nothing
    call ShowUnitHide(GetEnumUnit())
endfunction

function Trig_InitPalyerHorde_Func029002 takes nothing returns nothing
    call PauseUnitBJ(true, GetEnumUnit())
endfunction

function Trig_InitPalyerHorde_Actions takes nothing returns nothing
    // Alliances
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_Actual, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_TwilightHammerClan, bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammerClan, udg_Player_Actual, bj_ALLIANCE_ALLIED_VISION)
    // Relationship with enemy players
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_AllianceNavy, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_AllianceNavy, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_SilverHand, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_SilverHand, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_Lordaeron, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_Lordaeron, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_NavyDummy, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_NavyDummy, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StratholmeCityWatch, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_StratholmeCityWatch, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    call SetPlayerAllianceStateBJ(udg_Player_Actual, udg_Player_StratholmeWatchDummy, bj_ALLIANCE_UNALLIED)
    call SetPlayerAllianceStateBJ(udg_Player_StratholmeWatchDummy, udg_Player_Actual, bj_ALLIANCE_UNALLIED)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_HideBlackRockArmy), function Trig_InitPalyerHorde_Func026A)
    // //
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_InitPalyerHorde_Func028002)
    call ForGroupBJ(udg_Group_HordeArmy, function Trig_InitPalyerHorde_Func029002)
    // //
    call SetUnitInvulnerable(gg_unit_u005_0185, true)
    call SetUnitInvulnerable(gg_unit_u005_0212, true)
    call SetUnitInvulnerable(gg_unit_u005_0204, true)
    // //
    call SetUnitAnimation(gg_unit_u002_0962, "birth")
    // //
    call ConditionalTriggerExecute(gg_trg_Load_Heroes)
    // Misc
endfunction

//===========================================================================
function InitTrig_InitPalyerHorde takes nothing returns nothing
    set gg_trg_InitPalyerHorde=CreateTrigger()
    call TriggerAddAction(gg_trg_InitPalyerHorde, function Trig_InitPalyerHorde_Actions)
endfunction

//===========================================================================
// Trigger: InitPlayerAlliance
//===========================================================================
function Trig_InitPlayerAlliance_Func048A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Group_CathedralDefenders)
endfunction

function Trig_InitPlayerAlliance_Func052001002001 takes nothing returns boolean
    return ( GetOwningPlayer(GetFilterUnit()) == udg_Player_SilverHand )
endfunction

function Trig_InitPlayerAlliance_Func052001002002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) != true )
endfunction

function Trig_InitPlayerAlliance_Func052001002 takes nothing returns boolean
    return GetBooleanAnd((GetOwningPlayer(GetFilterUnit()) == udg_Player_SilverHand), (IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) != true)) // INLINED!!
endfunction

