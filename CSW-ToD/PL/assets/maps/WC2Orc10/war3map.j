function Trig_ArrivalCinQ_Func100001 takes nothing returns boolean
    return ( udg_Bool_CinArrivalSkipped == true )
endfunction

function Trig_ArrivalCinQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_CinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    // SetUp
    call PlaySoundBJ(gg_snd_TheHorde)
    call CameraSetupApplyForPlayer(true, gg_cam_HordeArrival01, udg_Player_Actual, 0)
    call TriggerSleepAction(1.00)
    call ConditionalTriggerExecute(gg_trg_ArrivalCinSetUp)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinArrivalOn=true
    // //
    call PlaySoundBJ(gg_snd_WarHorn3)
    call SetStackedSoundBJ(true, gg_snd_OrcArmyMarchLoop, gg_rct_HideBlackRockArmy)
    call CameraSetupApplyForPlayer(true, gg_cam_HordeArrival02, udg_Player_Actual, 6.00)
    call TriggerSleepAction(8.00)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_HordeArrivalChogallTalks, udg_Player_Actual, 0.00)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_HordeArrivalChogallTalks02, udg_Player_Actual, GetSoundDurationBJ(gg_snd_WC2Orc10ChoGall6))
    // //
    call SetStackedSoundBJ(false, gg_snd_OrcArmyMarchLoop, gg_rct_HideBlackRockArmy)
    call SetUnitAnimation(udg_FakeChogall, "cinematic standard two")
    call QueueUnitAnimationBJ(udg_FakeChogall, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc10ChoGall6, bj_TIMETYPE_ADD, 0, false)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_Hero_DoomHammer, "cinematic listening one")
    call TriggerSleepAction(3.00)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call TriggerSleepAction(( GetSoundDurationBJ(gg_snd_WC2Orc10ChoGall6) - 3.00 ))
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_HordeArrival04, udg_Player_Actual, 0.00)
    call CameraSetupApplyForPlayer(true, gg_cam_HordeArrival03, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc10Doomhammer1) + ( GetSoundDurationBJ(gg_snd_WC2Orc10Doomhammer2) + GetSoundDurationBJ(gg_snd_WC2Orc10Doomhammer3) ) ))
    // //
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic agree one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitLookAt(udg_FakeGuldan, "bone_head", udg_FakeDoomhammer, 0, 0, 180.00)
    call SetUnitLookAt(udg_FakeDoomhammer, "bone_head", udg_FakeGuldan, 0, 0, 160.00)
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic angry one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic headshake one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer4, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic headnod one")
    call QueueUnitAnimationBJ(udg_FakeGuldan, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan2, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call ResetUnitLookAt(udg_FakeDoomhammer)
    call ResetUnitLookAt(udg_FakeGuldan)
    // //
    call StopSoundBJ(gg_snd_TheHorde, true)
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic proud one")
    call QueueUnitAnimationBJ(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer5, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinArrivalSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_ArrivalCleanUp)
endfunction

