    call TriggerRegisterDeathEvent(gg_trg_MaraFordragonEncounterLastStand, gg_dest_LTg3_0476)
    call TriggerAddAction(gg_trg_MaraFordragonEncounterLastStand, function Trig_MaraFordragonEncounterLastStand_Actions)
endfunction

//===========================================================================
// Trigger: MainQuestLastStandUpdated
//===========================================================================
function Trig_MainQuestLastStandUpdated_Conditions takes nothing returns boolean
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    if ( not ( IsQuestDiscovered(udg_MQLastStand) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestLastStandUpdated_Func004Func005C takes nothing returns boolean
    if ( ( IsQuestItemCompleted(udg_QReq_LastStandPaladins) == false ) ) then
        return true
    endif
    if ( ( IsQuestItemCompleted(udg_QReq_LastStandMara) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_MainQuestLastStandUpdated_Func004C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_MainQuestLastStandUpdatedChurchQ) == true ) ) then
        return false
    endif
    if ( not ( IsQuestItemCompleted(udg_QReq_LastStandChurch) == true ) ) then
        return false
    endif
    if ( not Trig_MainQuestLastStandUpdated_Func004Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestLastStandUpdated_Func007Func005C takes nothing returns boolean
    if ( ( IsQuestItemCompleted(udg_QReq_LastStandChurch) == false ) ) then
        return true
    endif
    if ( ( IsQuestItemCompleted(udg_QReq_LastStandPaladins) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_MainQuestLastStandUpdated_Func007C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_MainQuestLastStandUpdatedMaraQ) == true ) ) then
        return false
    endif
    if ( not ( IsQuestItemCompleted(udg_QReq_LastStandMara) == true ) ) then
        return false
    endif
    if ( not Trig_MainQuestLastStandUpdated_Func007Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestLastStandUpdated_Func010Func005C takes nothing returns boolean
    if ( ( IsQuestItemCompleted(udg_QReq_LastStandMara) == false ) ) then
        return true
    endif
    if ( ( IsQuestItemCompleted(udg_QReq_LastStandChurch) == false ) ) then
        return true
    endif
    return false
endfunction

function Trig_MainQuestLastStandUpdated_Func010C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_MainQuestLastStandUpdatedPaladinsQ) == true ) ) then
        return false
    endif
    if ( not ( IsQuestItemCompleted(udg_QReq_LastStandPaladins) == true ) ) then
        return false
    endif
    if ( not Trig_MainQuestLastStandUpdated_Func010Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestLastStandUpdated_Func013C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_MainQuestLastStandCompletedQ) == true ) ) then
        return false
    endif
    if ( not ( IsQuestItemCompleted(udg_QReq_LastStandPaladins) == true ) ) then
        return false
    endif
    if ( not ( IsQuestItemCompleted(udg_QReq_LastStandMara) == true ) ) then
        return false
    endif
    if ( not ( IsQuestItemCompleted(udg_QReq_LastStandChurch) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MainQuestLastStandUpdated_Actions takes nothing returns nothing
    // Church
    if ( Trig_MainQuestLastStandUpdated_Func004C() ) then
        call QueuedTriggerAddBJ(gg_trg_MainQuestLastStandUpdatedChurchQ, true)
        return
    else
    endif
    // //
    // Mara Only
    if ( Trig_MainQuestLastStandUpdated_Func007C() ) then
        call QueuedTriggerAddBJ(gg_trg_MainQuestLastStandUpdatedMaraQ, true)
        return
    else
    endif
    // //
    // Paladins Only
    if ( Trig_MainQuestLastStandUpdated_Func010C() ) then
        call QueuedTriggerAddBJ(gg_trg_MainQuestLastStandUpdatedPaladinsQ, true)
        return
    else
    endif
    // //
    // All Done
    if ( Trig_MainQuestLastStandUpdated_Func013C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call QueuedTriggerAddBJ(gg_trg_MainQuestLastStandCompletedQ, true)
    else
    endif
    // //
endfunction

//===========================================================================
function InitTrig_MainQuestLastStandUpdated takes nothing returns nothing
    set gg_trg_MainQuestLastStandUpdated=CreateTrigger()
    call TriggerAddCondition(gg_trg_MainQuestLastStandUpdated, Condition(function Trig_MainQuestLastStandUpdated_Conditions))
    call TriggerAddAction(gg_trg_MainQuestLastStandUpdated, function Trig_MainQuestLastStandUpdated_Actions)
endfunction

