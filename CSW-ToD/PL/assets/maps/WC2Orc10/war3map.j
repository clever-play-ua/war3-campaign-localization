function Trig_IntroCinQ_Func072001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_IntroCinQ_Func080001 takes nothing returns boolean
    return ( udg_Bool_CinIntroSkipped == true )
endfunction

function Trig_IntroCinQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    // //
    call SetMusicVolumeBJ(udg_Music_CurrentVolume)
    call ConditionalTriggerExecute(gg_trg_CinematicPrepIn)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // SetUp
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    call TriggerSleepAction(0.25)
    call ConditionalTriggerExecute(gg_trg_IntroCinSetUp)
    call TriggerSleepAction(0.25)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro01, udg_Player_Actual, 0)
    call TriggerSleepAction(0.50)
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 2.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    // Cinematic started
    call PlaySoundBJ(gg_snd_DarkAgents)
    set udg_Bool_CinIntroOn=true
    call TriggerSleepAction(1.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // Cinematic Start
    // Ease Out
    call CameraSetupApplyForPlayerSmooth(true, gg_cam_Intro02, udg_Player_Actual, 5.00, 0, 3.00, 1.00)
    // //
    call SetUnitFacingToFaceUnitTimed(udg_FakeChogall, gg_unit_o621_0496, 2.00)
    call SetUnitFacingToFaceUnitTimed(gg_unit_o621_0496, udg_FakeChogall, 1.00)
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call SetUnitAnimation(udg_FakeChogall, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc10Chogall_intro1, bj_TIMETYPE_ADD, 0, false)
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc10Chogall_intro1, 6.00)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro02A, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro02B, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc10Chogall_intro1) - 6.00 ))
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Troops On Shore
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc10Chogall_intro1, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeChogall, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroGrunt, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(gg_unit_o621_0496, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_o621_0496, 0, gg_snd_WC2Orc10THGrunt_intro1, bj_TIMETYPE_SUB, 1.00, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_o621_0496, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Intro02C, udg_Player_Actual, 0)
    // //
    call SetUnitAnimation(udg_FakeChogall, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc10Chogall_intro2, bj_TIMETYPE_ADD, 0, false)
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc10Chogall_intro2, 8.14)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_IntroGrunt, udg_Player_Actual, 0)
    call CameraSetupApplyForPlayer(true, gg_cam_Intro04, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc10Chogall_intro3) + ( GetSoundDurationBJ(gg_snd_WC2Orc10THgrunt1) + 8.14 ) ))
    // //
    call WaitForSoundBJ(gg_snd_WC2Orc10Chogall_intro2, 0)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeChogall, "cinematic listening one")
    // //
    // Back to Chogall
    // //
    // //
    call SetUnitAnimation(udg_FakeChogall, "cinematic shrug one")
    call QueueUnitAnimationBJ(udg_FakeChogall, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc10Chogall_intro3, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeChogall, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_DarkAgents, true)
    // //
    call SetUnitAnimation(gg_unit_o621_0496, "cinematic salute one")
    call QueueUnitAnimationBJ(gg_unit_o621_0496, "cinematic listening one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, gg_unit_o621_0496, 0, gg_snd_WC2Orc10THgrunt1, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinIntroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(gg_unit_o621_0496, "cinematic listening one")
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call ConditionalTriggerExecute(gg_trg_IntroCleanUp)
endfunction

