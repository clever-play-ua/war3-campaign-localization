endfunction

function Trig_FinalCinQ_Func056001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_FinalCinQ_Func064001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_FinalCinQ_Func071001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_FinalCinQ_Func077001 takes nothing returns boolean
    return ( udg_Bool_CinOutroSkipped == true )
endfunction

function Trig_FinalCinQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_GameOver=true
    call ConditionalTriggerExecute(gg_trg_CinematicPrepIn)
    call CinematicModeBJ(true, udg_PlayerGroup_PlayerActual)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 2, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(2.00)
    // //
    call SetDestructableInvulnerableBJ(gg_dest_LTg4_0238, false)
    call KillDestructable(gg_dest_LTg4_0238)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_TwilightHammerClan, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_TwilightHammerClan, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_BlackRockClan, udg_Player_Citizens, bj_ALLIANCE_NEUTRAL)
    call SetPlayerAllianceStateBJ(udg_Player_Citizens, udg_Player_BlackRockClan, bj_ALLIANCE_NEUTRAL)
    // //
    call PlaySoundBJ(gg_snd_RaminDjawadi___Guldan)
    // //
    call SetSkyModel("Environment\\Sky\\DalaranRuinsSky\\DalaranRuinsSky.mdl")
    call SetTerrainFogExBJ(0, 2500.00, 7500.00, 0.50, 100, 25.00, 0.00)
    // //
    // Set Up Scene
    // //
    call ConditionalTriggerExecute(gg_trg_FinalCinSetUp)
    call TriggerSleepAction(0.25)
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final01, udg_Player_Actual, 0)
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    set udg_Bool_CinOutroOn=true
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final02, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc10Doomhammer9) + 3.00 ))
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer9, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final03, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan10) + ( GetSoundDurationBJ(gg_snd_WC2Orc10Doomhammer11) + 2.00 ) ))
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer10, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic standard three")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeDoomhammer, 0, gg_snd_WC2Orc10Doomhammer11, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeDoomhammer, "cinematic listening one")
    // //
    call ForGroupBJ(udg_Group_FinalCinOrcs, function Trig_FinalCinQ_Func052002)
    call PlaySoundAtPointBJ(gg_snd_TrollVictoryShouting, 90.00, GetRectCenter(gg_rct_FinalGrunt01), 0)
    // //
    call TriggerSleepAction(2.00)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    // //
    // Shadow Council Conspiracy
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final04, udg_Player_Actual, 0.00)
    // //
    call SetUnitAnimation(udg_FakeChogall, "cinematic standard two")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeChogall, 0, gg_snd_WC2Orc10ChoGall7, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeChogall, "cinematic listening one")
    // //
    call CameraSetupApplyForPlayer(true, gg_cam_Final05, udg_Player_Actual, ( GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan14) + GetSoundDurationBJ(gg_snd_WC2Orc10THGuldan15) ))
    // //
    call SetUnitAnimation(udg_FakeGuldan, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan14, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call StopSoundBJ(gg_snd_RaminDjawadi___Guldan, true)
    call SetUnitAnimation(udg_FakeGuldan, "cinematic standard one")
    call PlayDialogueFromSpeakerEx(udg_PlayerGroup_PlayerActual, udg_FakeGuldan, 0, gg_snd_WC2Orc10THGuldan15, bj_TIMETYPE_ADD, 0, true)
    if ( (udg_Bool_CinOutroSkipped == true) ) then // INLINED!!
        return
    else
        call DoNothing()
    endif
    call SetUnitAnimation(udg_FakeGuldan, "cinematic listening one")
    // //
    call ConditionalTriggerExecute(gg_trg_Next_Level_Prep)
endfunction

