//===========================================================================
function Trig_BuildBaseCinematicCleanUp_Func009002 takes nothing returns nothing
    call ShowUnitShow(GetEnumUnit())
endfunction

function Trig_BuildBaseCinematicCleanUp_Func013001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_BuildBaseCinematicCleanUp_Func013A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_BuildBaseCinematicCleanUp_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Bool_CinBuildCampOn=false
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUT, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call ConditionalTriggerExecute(gg_trg_RemoveFakeActors)
    // //
    call ForGroupBJ(udg_Group_HiddenUnits, function Trig_BuildBaseCinematicCleanUp_Func009002)
    call GroupClear(udg_Group_HiddenUnits)
    // //
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(gg_rct_THStartBuildings, Condition(function Trig_BuildBaseCinematicCleanUp_Func013001002)), function Trig_BuildBaseCinematicCleanUp_Func013A)
    // //
    call RemoveLocation(udg_Point_CinBuildPeonTemp)
    // //
    call RemoveUnit(gg_unit_o620_0489)
    call RemoveUnit(gg_unit_o620_0488)
    call RemoveUnit(gg_unit_o620_0490)
    // //
    call CreateNUnitsAtLoc(1, 'o614', udg_Player_Actual, GetRectCenter(gg_rct_TwilightHammersBase), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A61M', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'o610', udg_Player_Actual, GetRectCenter(gg_rct_TwilightHammersBarracks), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A630', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_TwilightHammersFarm), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A62Z', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'xW21', udg_Player_Actual, GetRectCenter(gg_rct_TwilightHammersWarmill), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A64F', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'o60L', udg_Player_Actual, GetRectCenter(gg_rct_TwilightHammersBlacksmith), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A632', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_TwilightHammersFarm2), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A62Z', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'o60X', udg_Player_Actual, GetRectCenter(gg_rct_TwilightHammersFarm3), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A62Z', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'o60W', udg_Player_Actual, GetRectCenter(gg_rct_TwilightHammersTower), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A633', GetLastCreatedUnit())
    // //
    call CreateNUnitsAtLoc(1, 'o620', udg_Player_Actual, GetRectCenter(gg_rct_THStartBuildings), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestgold")
    call CreateNUnitsAtLoc(1, 'o620', udg_Player_Actual, GetRectCenter(gg_rct_THStartBuildings), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestgold")
    call CreateNUnitsAtLoc(1, 'o620', udg_Player_Actual, GetRectCenter(gg_rct_THStartBuildings), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestlumber")
    call CreateNUnitsAtLoc(1, 'o620', udg_Player_Actual, GetRectCenter(gg_rct_THStartBuildings), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "autoharvestlumber")
    // //
    call IssueImmediateOrderBJ(gg_unit_h001_0965, "channel")
    // //
    call CameraSetupApplyForPlayer(true, udg_VarPlayerCamera, udg_Player_Actual, 0)
    call TriggerSleepAction(2.00)
    // //
    call ConditionalTriggerExecute(gg_trg_CinematicPrepOut)
    call CinematicModeBJ(false, GetPlayersAll())
    // //
    call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN, 1.00, "ReplaceableTextures\\CameraMasks\\Black_mask.blp", 100.00, 100.00, 100.00, 0)
    call TriggerSleepAction(1.00)
    // //
    call QueuedTriggerRemoveBJ(gg_trg_BuildBaseCinematicQ)
    // //
    call CreateTimerDialogBJ(udg_Timer_HordeArrival, "TRIGSTR_3945")
    set udg_TimerWindow_HordeArrival=GetLastCreatedTimerDialogBJ()
    call StartTimerBJ(udg_Timer_HordeArrival, false, 1200.00)
    // //
    call StartTimerBJ(udg_Timer_P15DelayFirstAttack, false, GetRandomReal(udg_Real_P15DelayFirstAttackBot, udg_Real_P15DelayFirstAttackTop))
    // //
    call QueuedTriggerAddBJ(gg_trg_MainQuestPortDiscovered, true)
    call ConditionalTriggerExecute(gg_trg_P02StartAI)
    call EnableTrigger(gg_trg_AllPlayerGroundUnitsAreDead)
endfunction

