//===========================================================================
// Trigger: OptionalQuestAllianceBaseDiscoveredQ
//===========================================================================
function Trig_OptionalQuestAllianceBaseDiscoveredQ_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call QuestSetDiscoveredBJ(udg_OQAllianceCamp, true)
    // //
    call TriggerSleepAction(bj_QUEUE_DELAY_QUEST)
    // //
    call CreateFogModifierRadiusLocBJ(true, udg_Player_Actual, FOG_OF_WAR_VISIBLE, GetRectCenter(gg_rct_AllianceCampQuest), 512)
    set udg_VisMod_AllianceCamp=GetLastCreatedFogModifier()
    // //
    call PingMinimapLocForForceEx(GetPlayersAll(), GetRectCenter(gg_rct_AllianceCampQuest), 2.00, bj_MINIMAPPINGSTYLE_SIMPLE, 100, 100, 0.00)
    call SetCameraQuickPositionLocForPlayer(udg_Player_Actual, GetRectCenter(gg_rct_AllianceCampQuest))
    // //
    call CampaignMinimapIconLocBJ(GetRectCenter(gg_rct_AllianceCampQuest), bj_CAMPPINGSTYLE_PRIMARY_RED)
    set udg_MinimapIcon_AllianceCamp=GetLastCreatedMinimapIcon()
    // //
    call QuestMessageBJ(udg_PlayerGroup_PlayerActual, bj_QUESTMESSAGE_DISCOVERED, "TRIGSTR_3719")
    // //
    call QueuedTriggerRemoveBJ(GetTriggeringTrigger())
    call EnableTrigger(gg_trg_OptionalQuestAllianceBaseCompleted)
endfunction

