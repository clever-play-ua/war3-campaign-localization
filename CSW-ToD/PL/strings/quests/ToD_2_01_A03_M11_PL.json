  "ToD_A03_M11_OBJE_025": {
    "hash": "e79773246f",
    "en": "Zul'jin and his trolls are attacking their hated enemies - the high elves of Quel'Thalas. Amani numbers are still limited in this region,, so your intervention may be required to turn the tide in Zul’jin’s favor. ",
    "tr": "Zul’jin i jego trolle atakują znienawidzonych wrogów — wysokie elfy Quel’Thalas. Wojownicy Amani mają w tej okolicy niewielkie siły, więc mogą potrzebować twojej pomocy, by przechylić szalę zwycięstwa na swoją stronę."
  },
  "ToD_A03_M11_OBJE_026": {
    "hash": "c139bdcf02",
    "en": "Help Zul'jin when he needs it.",
    "tr": "Pomóż Zul’jinowi, gdy będzie tego potrzebował."
