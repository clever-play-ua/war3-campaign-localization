  "ToD_A03_M11_MESS_003": {
    "hash": "87da38d07f",
    "en": "|cff00ff00ACID RAIN|r\nWith the power of the Water Runestone absorbed by Gul'dan,you can call an Acid Rain that posions your enemies.",
    "tr": "|cff00ff00KWAŚNY DESZCZ|r\nGul’dan wchłonął moc Kamienia Wody. Możesz teraz przywołać kwaśny deszcz, który zatruje twoich wrogów."
  },
  "ToD_A03_M11_MESS_004": {
    "hash": "3581f76ddb",
    "en": "|c00FF8040FIRE DAMAGE|r\nWith the power of the Fire Runestone absorbed by Gul'dan, you can cause flame strike upon your enemies.",
    "tr": "|c00FF8040OGNISTY ATAK|r\nGul’dan wchłonął moc Kamienia Ognia. Możesz teraz razić wrogów Słupem Ognia."
  },
  "ToD_A03_M11_MESS_005": {
    "hash": "9985e7863d",
    "en": "|c007EBFF1WHIRLWINDS|r\nWith the power of the Air Runestone absorbed by Gul'dan, you can summon the Whirlwind that will wipe out your enemies.",
    "tr": "|c007EBFF1WIRY|r\nGul’dan wchłonął moc Kamienia Powietrza. Możesz teraz przywołać Wir, który zmiecie twoich wrogów."
  },
  "ToD_A03_M11_MESS_007": {
    "hash": "e62ee189ee",
    "en": "|cff32cd32HINT|r\nElven forces will use Waygates to move around the map.",
    "tr": "|cff32cd32WSKAZÓWKA|r\nWojska elfów przemieszczają się po mapie przez bramy teleportacyjne."
  },
